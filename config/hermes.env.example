# Hermes gateway environment used by the recipe (the systemd drop-ins in systemd/hermes-gateway.service.d set the
# same values). All flags are off unless set to exactly 1.
HERMES_PRODUCT_RESEARCH_QUALITY_FIRST=1
HERMES_PRODUCT_RESEARCH_REPAIR_FETCH=1
HERMES_PRODUCT_GROUNDEDNESS_SHADOW=1
# Optional: shadow log location (default $HERMES_HOME/logs/groundedness-shadow.jsonl)
# HERMES_PRODUCT_GROUNDEDNESS_SHADOW_LOG=/var/log/research-agent/groundedness-shadow.jsonl
HERMES_VERIFIED_RECEIPT_DIRECT_REPLAY_CANARY=1
# Wiki/vault for explicitly requested research saves
OBSIDIAN_VAULT_PATH=/srv/wiki

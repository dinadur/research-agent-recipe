# /etc/research-agent/adapter.env for llm-main-adapter (see adapters/openai_vllm_adapter.py)
ADAPTER_LISTEN_PORT=8242
ADAPTER_UPSTREAM_PORT=8260
# The name Hermes uses for the main model, and vLLM's --served-model-name
ADAPTER_ALIAS=main
ADAPTER_SERVED_NAME=qwen3.8-27b-exl3
# Report the context the agent should plan for (Hermes capped prompts at 106496 tokens in the reference deployment)
ADAPTER_CTX=262144
ADAPTER_MAX_SEQS=16
# Only enforced by vLLM builds started with --reasoning-config; otherwise silently ignored
ADAPTER_REASONING_BUDGET=4096
ADAPTER_DEGENERATE_RUN=64

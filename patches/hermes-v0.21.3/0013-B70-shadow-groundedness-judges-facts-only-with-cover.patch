+def test_shadow_claim_kind_matches_graded_examples():
+    kind = product_groundedness.shadow_claim_kind
+    assert kind("| Hardwood floors | Pass |, |") == "table"
+    assert kind("Treat the alternatives' under $250 status as unverified until confirmed") == "absence"
+    assert kind("The eufy official product page is in the packet, but the visible excerpt is mostly navigation") == "meta"
+    assert kind("Choose the Mini-P only if the 300-P is unavailable") == "advice"
+    assert kind("For your hardwood-floor apartment, that is a direct fit") == "advice"
+    assert kind("Charge time is 4 hours, and the battery is swappable") == "fact"
+    assert kind("TechRadar tested the V8 Cyclone for two weeks and found it almost as impressive on hard floors") == "fact"

+_PAGE_SEGMENT_RE = re.compile(r"(?<=[.!?])\s+|\s+(?=[*\u2022|#]\s)|\s+-\s+(?=[A-Z0-9$])")
+
+
+def _shadow_segments(page: str, max_len: int = 280) -> list[tuple[int, int]]:
+    """Sentence-like (start, end) spans of a cleaned page, long runs chunked."""
+
+    spans: list[tuple[int, int]] = []
+    pos = 0
+    for match in list(_PAGE_SEGMENT_RE.finditer(page)) + [None]:
+        end = match.start() if match else len(page)
+        while end - pos > max_len:
+            cut = page.rfind(" ", pos + max_len // 2, pos + max_len)
+            cut = cut if cut > pos else pos + max_len
+            spans.append((pos, cut))
+            pos = cut + 1
+        if end > pos:
+            spans.append((pos, end))
+        pos = match.end() if match else len(page)
+    return spans
+
+
+def shadow_select_evidence(
+    claim: str,
+    urls: Sequence[str],
+    pages: Mapping[str, str],
+    budget: int | None = None,
+    max_excerpts: int = 5,
+) -> list[dict[str, Any]]:
+    """Excerpts that together cover as much of the claim as fits in ``budget``.
+
+    Greedy set cover over sentence-snapped page segments of every cited page:
+    each step takes the segment adding the most not-yet-covered claim weight
+    (rare terms and numbers weigh more), padded with its neighbours up to a
+    share of the budget.  A claim whose facts sit in different places on a
+    page (price at the top, battery in the spec table) gets each place.
+    """
+
+    import math
+
+    budget = budget or _SHADOW_EXCERPT_BUDGET_CHARS
+    terms = _shadow_terms(claim)
+    if not terms:
+        return []
+    segs: list[tuple[str, str, int, int, set[str]]] = []
+    cleaned: dict[str, str] = {}
+    for url in urls:
+        if url not in pages or url in cleaned:
+            continue
+        page = cleaned[url] = _shadow_clean_page(pages[url])
+        for start, end in _shadow_segments(page):
+            # whole-token matching: "runs" must not match inside "returns"
+            tokens = set(_shadow_terms(page[start:end]))
+            segs.append((url, page, start, end, {t for t in terms if t in tokens}))
+    df = collections.Counter(t for seg in segs for t in seg[4])
+    weight = {t: w * math.log(1.0 + len(segs) / (1.0 + df[t])) for t, w in terms.items()}
+    total = sum(weight.values()) or 1.0
+    covered: set[str] = set()
+    picked: list[tuple[str, str, int, int]] = []
+    used = 0
+    share = max(200, budget // 5)
+    while segs and len(picked) < max_excerpts and used < budget - 120:
+        best = max(segs, key=lambda seg: sum(weight[t] for t in seg[4] - covered))
+        gain = sum(weight[t] for t in best[4] - covered)
+        if gain <= 0:
+            break
+        url, page, start, end = best[:4]
+        room = min(share, budget - used)
+        # pad symmetrically with neighbouring text, snapped to word boundaries
+        pad = max(0, (room - (end - start)) // 2)
+        a = max(0, start - pad)
+        b = min(len(page), max(end, a + room))
+        if a > 0:
+            a = page.find(" ", a) + 1 or a
+        if b < len(page):
+            b = page.rfind(" ", a, b) if page.rfind(" ", a, b) > end else b
+        b = min(b, a + room)
+        picked.append((url, page, a, b))
+        used += b - a
+        covered |= best[4]
+        segs = [seg for seg in segs if not (seg[0] == url and seg[2] < b and seg[3] > a)]
+        if not segs:
+            break
+    if not picked and cleaned:
+        # nothing matched: show the judge the start of the first cited page
+        url, page = next(iter(cleaned.items()))
+        end = len(page) if len(page) <= budget else (page.rfind(" ", 0, budget) or budget)
+        picked.append((url, page, 0, end))
+    picked.sort(key=lambda item: (list(cleaned).index(item[0]), item[2]))
+    coverage = round(sum(weight[t] for t in covered) / total, 3)
+    return [{"url": url, "quote": page[a:b], "overlap": coverage} for url, page, a, b in picked]
+

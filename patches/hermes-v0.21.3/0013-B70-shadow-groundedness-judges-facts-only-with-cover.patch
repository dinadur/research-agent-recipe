+def _shadow_stem(token: str) -> str:
+    """Light plural/participle folding so "hours" matches "4-hour"."""
+
+    if token[0].isdigit() or token[0] == "$" or len(token) <= 4:
+        return token
+    for suffix in ("ies", "es", "s"):
+        if token.endswith(suffix) and not token.endswith("ss"):
+            return token[: -len(suffix)] + ("y" if suffix == "ies" else "")
+    return token
+
+
+_UNIT_ALIASES = {
+    "hr": "hour", "hrs": "hour", "hour": "hour", "h": "hour",
+    "min": "minute", "mins": "minute", "minute": "minute",
+    "lb": "pound", "lbs": "pound", "pound": "pound",
+    "gal": "gallon", "gallon": "gallon", "in": "inch", "inch": "inch",
+    "ft": "foot", "feet": "foot", "foot": "foot", "sq": "sq", "w": "watt", "watt": "watt",
+    "aw": "aw", "db": "db", "gb": "gb", "mb": "mb", "mph": "mph", "port": "port", "year": "year", "day": "day",
+}
+
+
 def _shadow_terms(value: str) -> dict[str, float]:
+    """Weighted claim/page terms: words (stemmed), prices, and number+unit pairs.
+
+    A bare integer of one or two digits matches too much ("24 hours a day" vs
+    "4 hours"), so it only counts joined to the unit that follows it
+    ("4 hrs" and "4 hours" both become "4hour").
+    """
+
     weights: dict[str, float] = {}
-    for token in re.findall(r"\$?\d[\d,.]*|[a-z][a-z0-9-]+", value.casefold()):
-        token = token.rstrip(".,")
+    raw = [t.rstrip(".,") for t in re.findall(r"\$?\d[\d,.]*|[a-z][a-z0-9]*", value.casefold())]
+    for index, token in enumerate(raw):
+        if not token:
+            continue
+        if token[0].isdigit() and re.fullmatch(r"\d{1,2}", token):
+            nxt = _shadow_stem(raw[index + 1]) if index + 1 < len(raw) and raw[index + 1] else ""
+            unit = _UNIT_ALIASES.get(nxt) or _UNIT_ALIASES.get(raw[index + 1] if index + 1 < len(raw) else "")
+            if unit:
+                weights[token + unit] = 3.0
+            continue
+        if not token[0].isdigit() and token[0] != "$" and len(token) < 2:
+            continue
+        token = _shadow_stem(token)
         if not token or token in _STOPWORDS or len(token) < 2:
             continue
         weights[token] = 3.0 if any(ch.isdigit() for ch in token) else 1.0

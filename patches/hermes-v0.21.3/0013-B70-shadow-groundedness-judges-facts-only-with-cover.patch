+def test_shadow_evidence_covers_separate_facts_and_units():
+    page = ("Customer service is available 24 hours a day. " + "Warranty and returns text. " * 80
+            + "Price $299.99 today. " + "More unrelated text here. " * 80
+            + "Specifications * Charge time 4 hrs * Maximum run time 60 min.")
+    ev = product_groundedness.shadow_select_evidence(
+        "It costs $299.99 and the charge time is 4 hours", ["u"], {"u": page})
+    joined = " ".join(e["quote"] for e in ev)
+
+    assert "$299.99" in joined and "Charge time 4 hrs" in joined
+    assert sum(len(e["quote"]) for e in ev) <= product_groundedness._SHADOW_EXCERPT_BUDGET_CHARS
+    assert product_groundedness._shadow_terms("4 hrs")["4hour"] == 3.0
+    assert "24hour" not in product_groundedness._shadow_terms("4 hours")
+

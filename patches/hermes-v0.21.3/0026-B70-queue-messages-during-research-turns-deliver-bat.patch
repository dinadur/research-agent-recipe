@@ -490,6 +490,18 @@ class GatewayBusySessionMixin:
         )
         if demoted_for_compression:
             effective_mode = self._demote_interrupt(session_key, "context compression is in flight (#56391)")
+        # A research-route turn (travel, product, generic) is controller-bound: a steered
+        # message mid-run hijacked it (2026-10-08: a product question steered into a travel
+        # turn; the travel preview was never delivered). Queue instead; /stop and /new still cancel.
+        demoted_for_research = (
+            effective_mode in ("steer", "interrupt") and self._agent_on_research_route(running_agent)

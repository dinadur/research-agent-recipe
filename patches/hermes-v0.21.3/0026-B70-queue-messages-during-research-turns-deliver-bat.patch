         agent_live = running_agent is not None and running_agent is not _AGENT_PENDING_SENTINEL
         plain_text = (
@@ -522,8 +534,28 @@ class GatewayBusySessionMixin:
         return self._BusySteerOutcome(
             effective_mode=effective_mode, demoted_for_subagents=demoted_for_subagents,
             demoted_for_compression=demoted_for_compression, steered=steered, redirected=redirected,
+            demoted_for_research=demoted_for_research,
         )
 
+    @staticmethod
+    def _agent_on_research_route(running_agent: Any) -> bool:
+        """Whether the running agent's turn belongs to a controller-bound research route."""
+        from gateway.run import _AGENT_PENDING_SENTINEL
+        if running_agent is None or running_agent is _AGENT_PENDING_SENTINEL:
+            return False
+        try:
+            from agent.generic_research_route import generic_research_route_active
+            from agent.product_route import product_research_route_active
+            from agent.travel_route import travel_publication_route_active
+            return any(
+                check(running_agent) is True
+                for check in (travel_publication_route_active, product_research_route_active,
+                              generic_research_route_active)
+            )
+        except Exception:
+            logger.debug("research-route busy check failed", exc_info=True)
+            return False
+
     @staticmethod
     def _demote_interrupt(session_key: str, why: str) -> str:
         logger.info("Demoting busy_input_mode 'interrupt' to 'queue' for session %s because %s", session_key, why)
@@ -582,6 +614,7 @@ class GatewayBusySessionMixin:

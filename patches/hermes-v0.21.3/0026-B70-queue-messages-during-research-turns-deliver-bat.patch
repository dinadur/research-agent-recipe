+
+
+def _other_call(call_id: str, name: str = "web_search"):
+    return SimpleNamespace(
+        id=call_id, function=SimpleNamespace(name=name, arguments=json.dumps({"query": "robot vacuum"}))
+    )
+
+
+def _other_result(call_id: str, name: str = "web_search"):
+    return {"role": "tool", "name": name, "tool_call_id": call_id, "content": "search results"}
+
+
+def test_travel_preview_is_delivered_when_other_calls_are_batched_with_the_controller():
+    # 2026-10-08 Tucson: a steered question made the model batch a search and an
+    # extract with the runner, and the hash-bound preview was dropped.
+    call = tool_call(command=travel_runner_command(), timeout=900)
+    calls = [_other_call("call-a"), call, _other_call("call-b", "web_extract")]
+    results = [_other_result("call-a"), terminal_message(travel_output()), _other_result("call-b", "web_extract")]
+    assert travel_research_approval_delivery(calls, results) == (travel_approval(), False)
+    assert travel_research_controller_boundary(calls, results) is True
+
+
+def test_batched_controller_without_a_valid_envelope_is_still_a_boundary():
+    call = tool_call(command=travel_runner_command(), timeout=900)
+    calls = [_other_call("call-a"), call]
+    results = [_other_result("call-a"), terminal_message("no envelope")]
+    assert travel_research_approval_delivery(calls, results) is None
+    assert travel_research_controller_boundary(calls, results) is True
+
+
+def test_two_controller_calls_in_one_batch_are_not_delivered():
+    first = tool_call(command=travel_runner_command(), timeout=900)
+    second = SimpleNamespace(id="call-second", function=first.function)
+    results = [terminal_message(travel_output()), dict(terminal_message(travel_output()), tool_call_id="call-second")]
+    assert travel_research_approval_delivery([first, second], results) is None
+    assert travel_research_controller_boundary([first, second], results) is False
diff --git a/tests/gateway/test_busy_research_route_queue.py b/tests/gateway/test_busy_research_route_queue.py
new file mode 100644
index 0000000..f6a4302
--- /dev/null
+++ b/tests/gateway/test_busy_research_route_queue.py
@@ -0,0 +1,68 @@
+"""A message sent while a research-route turn runs is queued, not steered (2026-10-08)."""
+
+from types import SimpleNamespace
+
+import pytest
+
+from gateway.config import GatewayConfig, Platform
+from gateway.platforms.event import MessageEvent
+from gateway.run import GatewayRunner
+from gateway.session import SessionSource
+
+
+def _source():
+    return SessionSource(platform=Platform.TELEGRAM, chat_id="1", user_id="1", chat_type="dm")
+
+
+class Receiver:
+    _supports_active_turn_redirect = True
+
+    def __init__(self, **attributes):
+        self.payload = None
+        self.session_id = "session-1"
+        self._current_turn_id = "turn-1"
+        for key, value in attributes.items():
+            setattr(self, key, value)
+
+    def steer(self, text):
+        self.payload = text
+        return True
+
+    redirect = steer
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("mode", ["steer", "interrupt"])
+async def test_travel_turn_queues_instead_of_steering(mode, tmp_path, monkeypatch):
+    monkeypatch.setattr("gateway.run._hermes_home", tmp_path)
+    runner = GatewayRunner(config=GatewayConfig())
+    receiver = Receiver(_travel_publication_route_turn_id="turn-1")
+    runner._session_state("key").turn.agent = receiver
+    event = MessageEvent(text="What's the best robot vacuum under $400?", source=_source(), message_id="m")
+
+    outcome = await runner._resolve_busy_steer_or_redirect(event, "key", mode, receiver)
+
+    assert outcome.effective_mode == "queue"
+    assert outcome.demoted_for_research is True
+    assert outcome.steered is False and outcome.redirected is False
+    assert receiver.payload is None
+
+
+@pytest.mark.asyncio
+async def test_ordinary_turn_still_steers(tmp_path, monkeypatch):
+    monkeypatch.setattr("gateway.run._hermes_home", tmp_path)
+    runner = GatewayRunner(config=GatewayConfig())
+    receiver = Receiver()
+    runner._session_state("key").turn.agent = receiver
+    event = MessageEvent(text="also mention the price", source=_source(), message_id="m")
+
+    outcome = await runner._resolve_busy_steer_or_redirect(event, "key", "steer", receiver)
+
+    assert outcome.steered is True
+    assert outcome.demoted_for_research is False
+    assert receiver.payload.endswith("also mention the price")
+
+
+def test_research_route_check_tolerates_missing_agent():
+    assert GatewayRunner._agent_on_research_route(None) is False
+    assert GatewayRunner._agent_on_research_route(SimpleNamespace()) is False

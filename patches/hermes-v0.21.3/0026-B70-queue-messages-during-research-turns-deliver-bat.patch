--- a/agent/verified_tool_delivery.py
+++ b/agent/verified_tool_delivery.py
@@ -184,9 +184,16 @@ def _travel_controller_invocation(
 ) -> tuple[Any, dict[str, Any], list[str]] | None:
     """Return one exact travel controller/runner invocation, independent of output."""
 
-    if len(tool_calls) != 1:
-        return None
-    tool_call = tool_calls[0]
+    # The model sometimes batches other calls with the controller (2026-10-08 Tucson:
+    # a steered product question added a search and an extract), which used to drop
+    # the hash-bound approval preview. Exactly one controller call is still required.
+    matches = [match for match in map(_single_travel_controller_invocation, tool_calls) if match is not None]
+    return matches[0] if len(matches) == 1 else None
+
+
+def _single_travel_controller_invocation(
+    tool_call: Any,
+) -> tuple[Any, dict[str, Any], list[str]] | None:
     name, raw_arguments = _tool_name_and_arguments(tool_call)
     if name != "terminal":
         return None
@@ -224,6 +231,21 @@ def _travel_controller_invocation(
     return tool_call, arguments, command_tokens
 
 
+def _tool_result_for(
+    call_id: str, tool_result_messages: Sequence[Mapping[str, Any]]
+) -> Mapping[str, Any] | None:
+    """The single tool result answering ``call_id``, or None."""
+
+    if not call_id:
+        return None
+    found = [
+        message
+        for message in tool_result_messages
+        if isinstance(message, Mapping) and str(message.get("tool_call_id") or "") == call_id
+    ]
+    return found[0] if len(found) == 1 else None
+
+
 def travel_research_controller_boundary(
     tool_calls: Sequence[Any], tool_result_messages: Sequence[Mapping[str, Any]]
 ) -> bool:
@@ -235,11 +257,13 @@ def travel_research_controller_boundary(
     """
 
     invocation = _travel_controller_invocation(tool_calls)
-    if invocation is None or len(tool_result_messages) != 1:
+    if invocation is None:
         return False
     tool_call, _arguments, _tokens = invocation
-    message = tool_result_messages[0]
     call_id = _tool_call_id(tool_call)
+    message = _tool_result_for(call_id, tool_result_messages)
+    if message is None:
+        return False
     if isinstance(message, Mapping):
         try:
             payload = json.loads(str(message.get("content") or ""))
@@ -519,14 +543,16 @@ def travel_research_approval_delivery(
     """
 
     invocation = _travel_controller_invocation(tool_calls)
-    if invocation is None or len(tool_result_messages) != 1:
+    if invocation is None:
         return None
     tool_call, arguments, _command_tokens = invocation
     if arguments.get("timeout") != TRAVEL_CONTROLLER_OUTER_TIMEOUT_SECONDS:
         return None
 
-    message = tool_result_messages[0]
     call_id = _tool_call_id(tool_call)
+    message = _tool_result_for(call_id, tool_result_messages)
+    if message is None:
+        return None
     if (
         not isinstance(message, Mapping)
         or message.get("role") != "tool"

@@ -624,6 +657,11 @@ class GatewayBusySessionMixin:
             head, tail = "⏳ Subagent working", self._BUSY_DEMOTED_TAIL
         elif is_queue_mode and demoted_for_compression:
             head, tail = "⏳ Compressing context", self._BUSY_DEMOTED_TAIL

+"""Open-ended research with explicit wiki-save wording (B70, 2026-09-27): routing stays on the direct-save generic
+route, open-ended requests get a larger bounded budget, and the controller waits once for more sources before
+sealing the receipt. No network, model or vault."""
+import json
+from types import SimpleNamespace
+
+from agent.generic_research_route import (
+    GENERIC_RESEARCH_BROAD_MAX_EXTRACT_CALLS,
+    GENERIC_RESEARCH_BROAD_MAX_SEARCH_CALLS,
+    arm_generic_research_route_for_turn,
+    generic_research_broad_request,
+    generic_research_direct_save_requested,
+    generic_research_tool_reason,
+    prepare_generic_research_controller_receipt,
+    requires_generic_research_route,
+)
+from agent.product_route import requires_product_research_route
+
+ORIGINAL = (
+    "I'd like to research the purchase of a 3D printer around $1000. I'm looking for something more open source "
+    "like the snapmaker U1 that I can work with an agent to print to via API/MCP.  Can you research the best options "
+    "and write a wiki article?"
+)
+PRODUCT_SHAPED_SAVE = (
+    "Research open-source-friendly 3D printers around $1000, like the Snapmaker U1, that an AI agent can control "
+    "through a local API or MCP. Cover the best options and save it as a wiki article."
+)
+PRODUCT_SHAPED_NO_SAVE = (
+    "Research 3D printers around $1000 that an AI agent can control via API or MCP, like the Snapmaker U1. "
+    "Compare the best options and recommend one."
+)
+NAMED = (
+    "Research the Snapmaker U1, Prusa Core One and Bambu Lab P1S: open-source firmware, local API or MCP control "
+    "for an AI agent, price and build volume. Save it as a wiki article."
+)
+
+
+def _agent():
+    return SimpleNamespace(_current_turn_id="turn-1", api_mode="chat_completions", session_id="session-1",
+                           _product_research_route_session_latched=False,
+                           _travel_publication_route_session_latched=False)
+
+
+def _extract(urls):
+    return [
+        {"role": "user", "content": ORIGINAL},
+        {"role": "assistant", "content": "", "tool_calls": [{"id": "x1", "type": "function", "function": {
+            "name": "web_extract", "arguments": json.dumps({"urls": urls})}}]},
+        {"role": "tool", "name": "web_extract", "tool_call_id": "x1", "content": json.dumps(
+            {"results": [{"url": url, "content": f"printer details from {url}"} for url in urls]})},
+    ]
+
+
+def test_original_prompt_takes_direct_save_route_as_open_ended():
+    assert requires_generic_research_route(ORIGINAL) is True
+    assert generic_research_direct_save_requested(ORIGINAL) is True
+    assert generic_research_broad_request(ORIGINAL) is True
+    agent = _agent()
+    assert arm_generic_research_route_for_turn(agent, ORIGINAL, "turn-1") is True
+    assert agent._generic_research_save_requested is True and agent._generic_research_broad is True
+
+
+def test_save_keeps_product_shaped_request_off_the_product_route():
+    assert requires_product_research_route(PRODUCT_SHAPED_SAVE) is True  # unchanged detector
+    assert generic_research_direct_save_requested(PRODUCT_SHAPED_SAVE) is True
+    assert requires_generic_research_route(PRODUCT_SHAPED_SAVE) is True
+    # Without save wording the product route keeps the request, as before.
+    assert requires_product_research_route(PRODUCT_SHAPED_NO_SAVE) is True
+    assert requires_generic_research_route(PRODUCT_SHAPED_NO_SAVE) is False
+    # An explicit product-route marker still wins.
+    assert generic_research_direct_save_requested("HERMES_PRODUCT_RESEARCH_ROUTE_V1 " + PRODUCT_SHAPED_SAVE) is False
+
+
+def test_named_comparison_is_not_open_ended_and_keeps_the_default_budget():
+    assert generic_research_broad_request(NAMED) is False
+    agent = _agent()
+    assert arm_generic_research_route_for_turn(agent, NAMED, "turn-1") is True
+    for _ in range(3):
+        assert generic_research_tool_reason(agent, "web_search", {"query": "q"}) is None
+    assert "exhausted" in generic_research_tool_reason(agent, "web_search", {"query": "q"})
+
+
+def test_open_ended_budget_is_larger_but_bounded():
+    agent = _agent()
+    arm_generic_research_route_for_turn(agent, ORIGINAL, "turn-1")
+    for _ in range(GENERIC_RESEARCH_BROAD_MAX_SEARCH_CALLS):
+        assert generic_research_tool_reason(agent, "web_search", {"query": "q"}) is None
+    assert "exhausted" in generic_research_tool_reason(agent, "web_search", {"query": "q"})
+    for index in range(GENERIC_RESEARCH_BROAD_MAX_EXTRACT_CALLS):
+        assert generic_research_tool_reason(agent, "web_extract", {"urls": [f"https://e{index}.example/a"]}) is None
+    assert "exhausted" in generic_research_tool_reason(agent, "web_extract", {"urls": ["https://e9.example/a"]})
+
+
+def test_open_ended_receipt_waits_once_then_seals():
+    agent = _agent()
+    arm_generic_research_route_for_turn(agent, ORIGINAL, "turn-1")
+    agent._generic_research_extract_call_count = 1
+    call = SimpleNamespace(function=SimpleNamespace(name="web_extract", arguments="{}"))
+    messages = _extract(["https://us.snapmaker.com/products/u1", "https://www.bambulab.com/p1s"])
+    arguments, details = prepare_generic_research_controller_receipt(agent, [call], messages)
+    assert arguments is None and details["mode"] == "generic_controller_broad_coverage_not_ready"
+    assert "named" in details["nudge"]
+    arguments, details = prepare_generic_research_controller_receipt(agent, [call], messages)
+    assert arguments is not None and details["mode"] == "generic_controller_auto_receipt"
+
+
+def test_open_ended_receipt_seals_immediately_with_enough_sources():
+    agent = _agent()
+    arm_generic_research_route_for_turn(agent, ORIGINAL, "turn-1")
+    agent._generic_research_extract_call_count = 1
+    call = SimpleNamespace(function=SimpleNamespace(name="web_extract", arguments="{}"))
+    urls = [f"https://site{index}.example/printer" for index in range(4)]
+    arguments, details = prepare_generic_research_controller_receipt(agent, [call], _extract(urls))
+    assert arguments is not None and details["successful_sources"] == 4

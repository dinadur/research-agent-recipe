+
+    if not isinstance(user_message, str):
+        return False
+    from agent.product_route import PRODUCT_RESEARCH_ROUTE_MARKER
+
+    text = " ".join(user_message.split())
+    return bool(
+        _RESEARCH_INTENT_RE.search(text)
+        and generic_research_save_requested(text)
+        and PRODUCT_RESEARCH_ROUTE_MARKER not in text
+    )
+
+
+def generic_research_broad_request(user_message: Any) -> bool:
+    """Open-ended discovery (best options, budgets, recommendations) without an explicit 2-3 way comparison."""

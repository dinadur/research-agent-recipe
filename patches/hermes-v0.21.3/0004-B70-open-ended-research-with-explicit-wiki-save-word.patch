+    text = " ".join(user_message.split())
+    return bool(_OPEN_ENDED_RE.search(text)) and not _comparison_alternatives(text)
+
+
+def _search_budget(agent: Any) -> int:
+    return (GENERIC_RESEARCH_BROAD_MAX_SEARCH_CALLS
+            if getattr(agent, "_generic_research_broad", False) is True
+            else GENERIC_RESEARCH_MAX_SEARCH_CALLS)
+

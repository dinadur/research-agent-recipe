+++ b/tests/agent/test_research_session_switch.py
@@ -0,0 +1,32 @@
+from agent.research_session_switch import research_session_switch_reason
+
+TRAVEL = [{"role": "user", "content": "Research a weekend trip to Tucson, Arizona: find verified attractions and restaurants and add them to my travel wiki."},
+          {"role": "assistant", "content": "Research is ready for review: Tucson, Arizona ..."}]
+PRODUCT = [{"role": "user", "content": "What's the best robot vacuum under $400 for pet hair?"},
+           {"role": "assistant", "content": "Recommendation: ..."}]
+CHAT = [{"role": "user", "content": "Write me a haiku about autumn"}, {"role": "assistant", "content": "..."}]
+
+
+def test_travel_session_rotates_for_product_and_generic_requests():
+    assert research_session_switch_reason(TRAVEL, "What's the best robot vacuum under $400 for pet hair?")
+    assert research_session_switch_reason(TRAVEL, "Is it true that honey never spoils?")
+
+
+def test_travel_session_keeps_continuations_and_new_destinations():
+    for message in ("yes", "more", "publish it", "Thanks!", "Research a long weekend in Sedona for my travel wiki"):
+        assert research_session_switch_reason(TRAVEL, message) is None
+
+
+def test_product_session_rotates_for_new_requests_but_keeps_approval():
+    assert research_session_switch_reason(PRODUCT, "Find me a good standing desk under $500")
+    assert research_session_switch_reason(PRODUCT, "Plan a weekend in Asheville with restaurants and things to do")
+    assert research_session_switch_reason(PRODUCT, "Can you look into whether the Fed raised rates this month?")
+    assert research_session_switch_reason(PRODUCT, "yes, publish it") is None
+    assert research_session_switch_reason(PRODUCT, "thanks, that helps") is None
+
+
+def test_ordinary_sessions_and_commands_never_rotate():
+    assert research_session_switch_reason(CHAT, "What's the best robot vacuum under $400 for pet hair?") is None
+    assert research_session_switch_reason([], "Find me a good standing desk under $500") is None
+    assert research_session_switch_reason(TRAVEL, "/new") is None
+    assert research_session_switch_reason(TRAVEL, "") is None
diff --git a/tests/gateway/test_research_session_switch_gateway.py b/tests/gateway/test_research_session_switch_gateway.py
new file mode 100644
index 0000000..b10adca
--- /dev/null
+++ b/tests/gateway/test_research_session_switch_gateway.py
@@ -0,0 +1,54 @@
+"""The gateway starts a new session before a different research request in a locked session."""
+
+from types import SimpleNamespace
+
+import pytest
+
+from gateway.config import GatewayConfig, Platform
+from gateway.platforms.event import MessageEvent
+from gateway.run import GatewayRunner
+from gateway.session import SessionSource
+
+TRAVEL = [{"role": "user", "content": "Research a weekend trip to Tucson, Arizona: find verified attractions and restaurants and add them to my travel wiki."}]
+
+
+def _runner(tmp_path, monkeypatch, history):
+    monkeypatch.setattr("gateway.run._hermes_home", tmp_path)
+    runner = GatewayRunner(config=GatewayConfig())
+    runner.session_store._entries["key"] = SimpleNamespace(session_id="old-session")
+    monkeypatch.setattr(runner.session_store, "load_transcript", lambda session_id: history)
+    calls = {"reset": [], "sent": []}
+
+    async def fake_reset(event):
+        calls["reset"].append(event.text)
+        return "reset"
+
+    async def fake_send(event, adapter, message):
+        calls["sent"].append(message)
+
+    runner._handle_reset_command = fake_reset
+    runner._send_busy_ack_reply = fake_send
+    runner._adapter_for_source = lambda source: object()
+    return runner, calls
+
+
+def _event(text):
+    source = SessionSource(platform=Platform.TELEGRAM, chat_id="1", user_id="1", chat_type="dm")
+    return MessageEvent(text=text, source=source, message_id="m"), source
+
+
+@pytest.mark.asyncio
+async def test_product_request_in_travel_session_starts_a_new_session(tmp_path, monkeypatch):
+    runner, calls = _runner(tmp_path, monkeypatch, TRAVEL)
+    event, source = _event("What's the best robot vacuum under $400 for pet hair?")
+    assert await runner._maybe_start_new_research_session(event, source, "key") is True
+    assert calls["reset"] == ["/new"]
+    assert "/resume old-session" in calls["sent"][0]
+
+
+@pytest.mark.asyncio
+async def test_approval_in_travel_session_stays(tmp_path, monkeypatch):
+    runner, calls = _runner(tmp_path, monkeypatch, TRAVEL)
+    event, source = _event("yes")
+    assert await runner._maybe_start_new_research_session(event, source, "key") is False
+    assert calls["reset"] == [] and calls["sent"] == []

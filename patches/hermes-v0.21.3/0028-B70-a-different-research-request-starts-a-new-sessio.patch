diff --git a/gateway/run_inbound.py b/gateway/run_inbound.py
index 723834a..b3fe73b 100644
--- a/gateway/run_inbound.py
+++ b/gateway/run_inbound.py
@@ -1187,6 +1187,53 @@ class GatewayInboundMixin:
             logger.debug("FIFO orphan rescue pre-claim failed for %s", _quick_key, exc_info=True)
             return event, source, is_internal
 
+    async def _maybe_start_new_research_session(self, event: MessageEvent, source, session_key: str) -> bool:
+        """Rotate to a new session when a research-locked session gets a different request."""
+        try:
+            if event.is_command():
+                return False
+            entry = self.session_store._entries.get(session_key)
+            if entry is None or not getattr(entry, "session_id", None):
+                return False
+            from agent.research_session_switch import message_requests_research, research_session_switch_reason
+            # No await on the common path: the session must be claimed before this handler first
+            # yields (see the sentinel below), so ordinary messages return here synchronously and
+            # only research requests read the transcript.
+            if not message_requests_research(event.text or ""):
+                return False
+            history = self.session_store.load_transcript(entry.session_id)
+            reason = research_session_switch_reason(history, event.text or "")
+            if reason is None:
+                return False
+            old_session_id = entry.session_id
+            logger.info("Starting a new session for %s: %s (previous session %s)", session_key, reason, old_session_id)
+            await self._handle_reset_command(
+                MessageEvent(text="/new", source=source, message_id=event.message_id)
+            )
+            adapter = self._adapter_for_source(source)
+            if adapter is not None:
+                await self._send_busy_ack_reply(
+                    event, adapter,
+                    "🆕 Started a new session for this request. The previous research stays available "
+                    f"with /resume {old_session_id}",
+                )
+            return True
+        except Exception:
+            logger.warning("Research session switch check failed for %s", session_key, exc_info=True)
+            return False
+
+    async def _redispatch_after_release(self, adapter, pending_event: MessageEvent, session_key: str) -> None:
+        """Hand a queued message back to the adapter once the current run has released the session."""
+        for _ in range(240):
+            if session_key not in getattr(adapter, "_active_sessions", {}):
+                break
+            await asyncio.sleep(0.5)
+        else:
+            logger.warning("Queued research request for %s not redispatched: session still active", session_key)
+            return
+        pending_event._b70_research_redispatch = True
+        await adapter.handle_message(pending_event)
+
     async def _handle_message(self, event: MessageEvent) -> Optional[str]:
         """Handle an incoming message from any platform: auth → command check → running-agent
         interrupt → get/create session → build context → run agent → return response."""
@@ -1250,6 +1297,11 @@ class GatewayInboundMixin:
                     "please resend shortly."
                 )
 
+        # A different research request sent into a travel/product-locked session starts a fresh
+        # session first (2026-10-08); approvals and other continuations stay in the session.
+        if not is_internal or getattr(event, "_b70_research_redispatch", False):
+            await self._maybe_start_new_research_session(event, source, _quick_key)
+
         # Claim this session before any await: many awaits sit between here and _run_agent
         # registering the real AIAgent; without this sentinel a second message during any of them
         # passes the "already running" guard and spins up a duplicate agent for the same session.
diff --git a/gateway/run_turn.py b/gateway/run_turn.py
index 80eeba5..dd376c8 100644
--- a/gateway/run_turn.py
+++ b/gateway/run_turn.py
@@ -3469,6 +3469,24 @@ class GatewayTurnMixin:
                 if pending:
                     logger.debug("Processing queued message after agent completion: '%s...'", pending[:40])
 
+        # A queued message that is a different research request than this locked session's route
+        # runs in a fresh session instead: re-dispatch it once this run releases (2026-10-08).
+        if pending_event is not None and pending and session_key and adapter is not None:
+            with suppress(Exception):
+                entry = self.session_store._entries.get(session_key)
+                if entry is not None and getattr(entry, "session_id", None):
+                    from agent.research_session_switch import message_requests_research, research_session_switch_reason
+                    history = (
+                        await asyncio.to_thread(self.session_store.load_transcript, entry.session_id)
+                        if message_requests_research(pending) else []
+                    )
+                    if research_session_switch_reason(history, pending) is not None:
+                        logger.info("Queued message for %s is a different research request; re-dispatching "
+                                    "it to a new session after this run", session_key)
+                        asyncio.create_task(self._redispatch_after_release(adapter, pending_event, session_key))
+                        pending_event = None
+                        pending = None
+
         # Leftover /steer (arrived after the last tool batch): deliver as the next user turn.
         if result and not pending and not pending_event and result.get("pending_steer"):
             pending = result.get("pending_steer")
diff --git a/tests/agent/test_research_session_switch.py b/tests/agent/test_research_session_switch.py

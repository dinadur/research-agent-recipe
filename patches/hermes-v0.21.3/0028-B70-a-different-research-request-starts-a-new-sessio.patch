diff --git a/agent/research_session_switch.py b/agent/research_session_switch.py
new file mode 100644
index 0000000..f0440c5
--- /dev/null
+++ b/agent/research_session_switch.py
@@ -0,0 +1,64 @@
+"""Start a fresh session when a research-locked session receives a different request.
+
+Travel and product sessions latch their narrow capability for the life of the
+session, so approvals and "more" replies keep working. A different research
+request sent into such a session used to be refused ("send /new") or, for a
+queued product question after a travel run, withheld (2026-10-08). The gateway
+asks this module whether to rotate the session first; continuations stay put.
+"""
+
+from __future__ import annotations
+
+from typing import Any
+
+
+def message_requests_research(message: Any) -> bool:
+    """Cheap pre-check: does the message select any research route on its own?"""
+
+    if not isinstance(message, str) or not message.strip() or message.lstrip().startswith("/"):
+        return False
+    from agent.generic_research_route import requires_generic_research_route
+    from agent.product_route import requires_product_research_route
+    from agent.travel_route import requires_travel_publication_route
+
+    return bool(
+        requires_travel_publication_route(message)
+        or requires_product_research_route(message)
+        or requires_generic_research_route(message)
+    )
+
+
+def research_session_switch_reason(conversation_history: Any, message: Any) -> str | None:
+    """Why ``message`` should start a new session, or None to stay in this one."""
+
+    if not isinstance(message, str) or not message.strip() or message.lstrip().startswith("/"):
+        return None
+    from agent.generic_research_route import requires_generic_research_route
+    from agent.product_route import (
+        _history_requests_product_research,
+        product_publication_approval_requested,
+        requires_product_research_route,
+    )
+    from agent.travel_route import (
+        _history_requests_travel_publication,
+        requires_travel_publication_route,
+    )
+
+    travel_session = _history_requests_travel_publication(conversation_history)
+    product_session = _history_requests_product_research(conversation_history)
+    if not (travel_session or product_session):
+        return None
+    wants_travel = requires_travel_publication_route(message)
+    wants_product = not wants_travel and requires_product_research_route(message)
+    wants_generic = not (wants_travel or wants_product) and requires_generic_research_route(message)
+    if travel_session and (wants_product or wants_generic):
+        return "travel session received a %s research request" % ("product" if wants_product else "generic")
+    if product_session and (wants_travel or wants_generic):
+        return "product session received a %s research request" % ("travel" if wants_travel else "generic")
+    if product_session and wants_product and not product_publication_approval_requested(message):
+        # A product session holds one research request and its approval.
+        return "product session received a new product research request"
+    return None
+
+
+__all__ = ["message_requests_research", "research_session_switch_reason"]

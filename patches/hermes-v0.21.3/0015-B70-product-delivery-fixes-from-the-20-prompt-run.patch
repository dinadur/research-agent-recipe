@@ -268,6 +268,21 @@ def synthesis_messages(
     return messages
 
 
+_TARGET_QUALIFIER_RE = re.compile(r"\([^)]*\)")
+
+
+def _target_coverage_tokens(target: str) -> list[str]:
+    """Name tokens an answer must contain to count as covering ``target``.
+
+    Parenthetical qualifiers ("(4th gen)", "(3-pack)") are dropped: answers
+    legitimately write "fourth-generation" or omit the pack size, and requiring
+    them withheld otherwise complete comparisons.
+    """
+
+    core = _TARGET_QUALIFIER_RE.sub(" ", target)
+    return [token for token in re.findall(r"[A-Za-z0-9]+", core) if len(token) >= 2]
+
+
 def response_diagnostics(
     response: Any,
     prompt: str,
@@ -285,8 +300,7 @@ def response_diagnostics(
         for target in extract_targets(prompt)
         if not all(
             token.casefold() in text.casefold()
-            for token in re.findall(r"[A-Za-z0-9]+", target)
-            if len(token) >= 2
+            for token in _target_coverage_tokens(target)
         )
     ]
     criteria_missing: list[str] = []

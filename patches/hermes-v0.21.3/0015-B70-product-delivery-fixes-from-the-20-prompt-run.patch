+def test_current_turn_window_spans_a_length_continuation_nudge():
+    from agent.product_route import _product_current_turn_messages, _product_source_mix_state
+
+    messages = [{"role": "user", "content": "Research the best video doorbell under $200."}]
+    messages += _search_messages("eufy E340 official", ["https://www.eufy.com/e340"], "1")
+    messages += _extract_messages(["https://www.eufy.com/e340"], "1")
+    messages += [
+        {"role": "assistant", "content": "# Video Doorbell Under $200\n\nThe eufy E340 is"},
+        {"role": "user", "content": "[System: Your previous response was truncated by the output length limit. "
+                                    "Continue exactly where you left off. Do not restart or repeat prior text. "
+                                    "Finish the answer directly.]"},
+    ]
+    tagged = messages[:-1] + [dict(messages[-1], content="continue", _length_continuation_nudge=True)]
+
+    for history in (messages, tagged):
+        window = _product_current_turn_messages(history)
+        mix = _product_source_mix_state(window)
+        assert len(mix["search_records"]) == 1
+        assert sum(1 for m in window if m.get("name") == "web_extract") == 1
+
+
+def test_current_turn_window_still_stops_at_a_real_user_turn():
+    from agent.product_route import _product_current_turn_messages
+
+    messages = [{"role": "user", "content": "first request"}]
+    messages += _search_messages("q", ["https://a.example/x"], "1")
+    messages += [{"role": "assistant", "content": "answer"}, {"role": "user", "content": "now something else"}]
+    assert _product_current_turn_messages(messages) == []
+
+
+def test_receipt_after_searches_without_extraction_becomes_first_extract():
+    from agent.verified_tool_delivery import GENERIC_RESEARCH_RECEIPT_ABSOLUTE_COMMAND
+
+    agent = _agent()
+    agent.api_mode = "chat_completions"
+    messages = [{"role": "user", "content": "Research the best Wi-Fi 7 router under $400 for an apartment."}]
+    messages += _search_messages("best wifi 7 router", ["https://www.rtings.com/router/best", "https://www.pcmag.com/picks/wifi7"], "1")
+    messages += _search_messages("TP-Link Archer BE550 official", ["https://www.tp-link.com/us/home-networking/wifi-router/archer-be550/"], "2")
+    receipt = SimpleNamespace(id="r", function=SimpleNamespace(
+        name="terminal", arguments=json.dumps({"command": GENERIC_RESEARCH_RECEIPT_ABSOLUTE_COMMAND, "timeout": 30})))
+
+    calls, nudge, details = prepare_product_research_source_mix(agent, [receipt], messages)
+
+    assert details["mode"] == "zero_extract_terminal_to_extract" and nudge is None
+    assert receipt.function.name == "web_extract"
+    urls = json.loads(receipt.function.arguments)["urls"]
+    assert urls[:2] == ["https://www.rtings.com/router/best", "https://www.tp-link.com/us/home-networking/wifi-router/archer-be550/"]
+    assert len(urls) == 3
+

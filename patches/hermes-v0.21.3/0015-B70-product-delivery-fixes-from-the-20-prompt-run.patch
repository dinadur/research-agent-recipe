+def test_alternative_coverage_ignores_parenthetical_qualifiers():
+    from agent.quality_first_route import response_diagnostics
+
+    prompt = ("Research the best smart thermostat under $250 for a two-story house, comparing the Google Nest "
+              "Learning Thermostat (4th gen), ecobee Smart Thermostat Premium and Honeywell Home T9. Recommend one.")
+    answer = ("The fourth-generation Google Nest Learning Thermostat [N](https://n.example/a) is good; the ecobee "
+              "Smart Thermostat Premium [E](https://e.example/b) and Honeywell Home T9 [H](https://h.example/c) are alternatives.")
+    d = response_diagnostics(answer, prompt, ["https://n.example/a", "https://e.example/b", "https://h.example/c"])
+    assert d["missing_alternatives"] == []
+
+    d = response_diagnostics(answer.replace("Honeywell Home T9", "Honeywell"), prompt,
+                             ["https://n.example/a", "https://e.example/b", "https://h.example/c"])
+    assert d["missing_alternatives"] == ["Honeywell Home T9"]
+
+
+def test_quality_first_nudge_names_missing_alternatives_and_citable_urls():
+    from agent.product_route import product_research_finalization_nudge
+
+    agent = SimpleNamespace(
+        _product_research_quality_first_diagnostics={
+            "passed": False, "defects": ["alternative_coverage_missing", "citations_missing"],
+            "missing_alternatives": ["Fully Jarvis"], "cited_urls": []},
+        _product_research_receipt_sources=("https://a.example/x", "https://b.example/y"),
+    )
+    text = product_research_finalization_nudge("quality_first_alternative_coverage_missing", agent)
+
+    assert "exactly as written" in text and "Fully Jarvis" in text
+    assert "[label](url)" in text and "https://a.example/x" in text

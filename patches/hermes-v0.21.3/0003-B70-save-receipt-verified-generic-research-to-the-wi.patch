+    )
+
+
+def generic_research_save_requested(user_message: Any) -> bool:
+    """True when the operator explicitly asks to save this research to the wiki."""
+
+    if not isinstance(user_message, str):
+        return False
+    text = " ".join(user_message.split())
+    return any(
+        _NEGATED_SAVE_RE.search(text[: match.start()]) is None
+        for match in _WIKI_SAVE_INTENT_RE.finditer(text)
+    )
 
 

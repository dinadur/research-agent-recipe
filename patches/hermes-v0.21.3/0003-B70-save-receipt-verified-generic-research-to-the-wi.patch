+"""Create-only wiki notes for receipt-verified generic research (B70, user-authorized 2026-09-27).
+
+When the operator's research request explicitly asks to save to the wiki, the controller saves the delivered,
+receipt-verified answer as one new note under ``research/`` in the configured Obsidian vault. The model never
+writes, and the controller never replaces or edits existing content:
+- the target is chosen here (``research/<slug>-<date>.md``, with ``-2``, ``-3`` … on a same-day collision);
+- the note is created with ``O_EXCL`` and fsynced, then reread and hash-checked before success is reported;
+- it records the request, the date, the receipt-bound source URLs and ``review_status: unreviewed``.
+Mechanical custody only: a saved note is not factual verification.
+"""
+from __future__ import annotations
+
+import datetime as dt
+import hashlib
+import json
+import os
+import re
+import unicodedata
+from pathlib import Path
+from typing import Any, Sequence
+
+RESEARCH_DIRECTORY = "research"
+MAX_SAME_DAY_NOTES = 20
+_LEADING_VERB_RE = re.compile(r"^\s*(?:please\s+)?(?:research|investigate|look\s+up)\s+(?:the\s+|a\s+|an\s+)?", re.IGNORECASE)
+_SAVE_CLAUSE_RE = re.compile(r"[.;,]?\s*(?:and\s+)?(?:then\s+)?(?:save|add|write|publish|store|put)\b.*$", re.IGNORECASE | re.DOTALL)
+
+
+class GenericResearchPublicationError(RuntimeError):
+    """A bounded publication failure that is safe to show the operator."""
+
+
+def _slugify(value: str) -> str:
+    normalized = unicodedata.normalize("NFKD", value).encode("ascii", "ignore").decode()
+    slug = re.sub(r"[^a-z0-9]+", "-", normalized.casefold()).strip("-")
+    return re.sub(r"-{2,}", "-", slug)[:80].rstrip("-")
+
+
+def research_note_title(operator_prompt: str, response: str) -> str:
+    """The research subject from the request (before any colon or save clause); else the answer's first heading."""
+    text = " ".join(str(operator_prompt or "").split())
+    subject = _SAVE_CLAUSE_RE.sub("", _LEADING_VERB_RE.sub("", text, count=1)).split(":", 1)[0].strip(" .")
+    if len(_slugify(subject)) >= 4:
+        return subject[:120].strip()
+    for line in str(response or "").splitlines():
+        heading = line.strip().lstrip("#").strip()
+        if line.lstrip().startswith("#") and len(_slugify(heading)) >= 4:
+            return heading[:120]
+    return "Research note"
+
+
+def render_research_note(*, title: str, operator_prompt: str, response: str, sources: Sequence[str], session_id: str,
+                         today: dt.date) -> bytes:
+    source_list = [str(url) for url in sources]
+    lines = ["---", f"title: {json.dumps(title, ensure_ascii=False)}", f"date: {today.isoformat()}", "status: draft",
+             "review_status: unreviewed", "source: hermes-generic-research", f"session_id: {json.dumps(session_id)}",
+             f"request: {json.dumps(' '.join(str(operator_prompt).split()), ensure_ascii=False)}", "sources:"]
+    lines += [f"  - {json.dumps(url, ensure_ascii=False)}" for url in source_list]
+    lines += [f"receipt_sources_sha256: {hashlib.sha256(json.dumps(source_list).encode()).hexdigest()}", "---", "",
+              f"# {title}", "", str(response).strip(), "",
+              f"*Saved by Hermes research on {today.isoformat()} from receipt-verified sources; unreviewed.*", ""]
+    return "\n".join(lines).encode("utf-8")
+
+
+def _write_exclusive(path: Path, payload: bytes) -> None:
+    descriptor = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
+    try:
+        with os.fdopen(descriptor, "wb") as handle:
+            handle.write(payload); handle.flush(); os.fsync(handle.fileno())
+    except Exception:
+        path.unlink(missing_ok=True)
+        raise
+
+
+def publish_generic_research(*, vault: Path, operator_prompt: str, response: str, sources: Sequence[str],
+                             session_id: str, now: dt.datetime | None = None) -> tuple[str, str]:
+    """Create one new note; returns (vault-relative path, sha256 of the reread bytes)."""
+    if not str(response or "").strip():
+        raise GenericResearchPublicationError("the verified answer is empty")
+    if len(sources) < 2:
+        raise GenericResearchPublicationError("the answer has fewer than two receipt-bound sources")
+    resolved_vault = Path(vault).expanduser().resolve()
+    if not resolved_vault.is_dir():
+        raise GenericResearchPublicationError("configured Obsidian vault is unavailable")
+    folder = resolved_vault / RESEARCH_DIRECTORY
+    if folder.is_symlink():
+        raise GenericResearchPublicationError("research directory may not be a symbolic link")
+    folder.mkdir(parents=True, exist_ok=True)
+    if folder.resolve().parent != resolved_vault:
+        raise GenericResearchPublicationError("research directory escaped the configured vault")
+    today = (now or dt.datetime.now().astimezone()).date()
+    title = research_note_title(operator_prompt, response)
+    slug = _slugify(title) or "research-note"
+    payload = render_research_note(title=title, operator_prompt=operator_prompt, response=response, sources=sources,
+                                   session_id=session_id, today=today)
+    for index in range(1, MAX_SAME_DAY_NOTES + 1):
+        name = f"{slug}-{today.isoformat()}" + ("" if index == 1 else f"-{index}") + ".md"
+        target = folder / name
+        try:
+            _write_exclusive(target, payload)
+        except FileExistsError:
+            continue
+        reread = target.read_bytes()
+        digest = hashlib.sha256(reread).hexdigest()
+        if digest != hashlib.sha256(payload).hexdigest():
+            raise GenericResearchPublicationError("saved note did not reread identically")
+        return target.relative_to(resolved_vault).as_posix(), digest
+    raise GenericResearchPublicationError("too many notes with this name today; nothing was overwritten")
+
+
+def save_verified_generic_research(agent: Any, response: str) -> str:
+    """Save the delivered answer when the operator asked; return the status line to append (or '')."""
+    if getattr(agent, "_generic_research_save_requested", False) is not True:
+        return ""
+    try:
+        vault = os.environ.get("OBSIDIAN_VAULT_PATH", "").strip()
+        if not vault:
+            raise GenericResearchPublicationError("configured Obsidian vault is unavailable")
+        path, digest = publish_generic_research(
+            vault=Path(vault), operator_prompt=str(getattr(agent, "_generic_research_operator_prompt", "") or ""),
+            response=response, sources=tuple(getattr(agent, "_generic_research_receipt_sources", ()) or ()),
+            session_id=str(getattr(agent, "session_id", "") or ""))
+    except GenericResearchPublicationError as exc:
+        return f"\n\n---\nNot saved to wiki: {exc}."
+    except OSError as exc:
+        return f"\n\n---\nNot saved to wiki: file system error ({exc.__class__.__name__})."
+    return f"\n\n---\nSaved to wiki: `{path}` (new note, unreviewed; sha256 {digest[:12]})."
+
+
+def withheld_save_status(agent: Any) -> str:
+    """Status line for a withheld answer when saving was requested (nothing is written)."""
+    if getattr(agent, "_generic_research_save_requested", False) is not True:
+        return ""
+    return "\n\n---\nNot saved to wiki: the research answer did not pass its source check."
+
+
+__all__ = ["GenericResearchPublicationError", "publish_generic_research", "render_research_note",
+           "research_note_title", "save_verified_generic_research", "withheld_save_status"]

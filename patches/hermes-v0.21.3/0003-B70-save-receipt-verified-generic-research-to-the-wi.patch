@@ -0,0 +1,131 @@
+"""Explicit wiki-save for receipt-verified generic research (B70, 2026-09-27): arming, create-only notes, status lines
+and the finalizer hook. No network, model or real vault."""
+import datetime as dt
+import json
+from types import SimpleNamespace
+
+import pytest
+
+from agent.generic_research_publisher import (
+    GenericResearchPublicationError,
+    publish_generic_research,
+    research_note_title,
+    save_verified_generic_research,
+    withheld_save_status,
+)
+from agent.generic_research_route import (
+    arm_generic_research_route_for_turn,
+    bind_generic_research_receipt,
+    generic_research_save_requested,
+    requires_generic_research_route,
+)
+from agent.product_route import requires_product_research_route
+
+SAVE_PROMPT = (
+    "Research the Blackstone 36-inch Original Griddle (propane): cooking area, number of burners and heat output, "
+    "assembly, seasoning and cleaning, dimensions and weight, and warranty. Save it as a wiki article."
+)
+URLS = ["https://blackstoneproducts.com/products/36-griddle", "https://www.bbqguys.com/i/3078923/blackstone-1899"]
+NOW = dt.datetime(2026, 9, 27, 21, 0, tzinfo=dt.timezone.utc)
+
+
+def _agent():
+    return SimpleNamespace(_current_turn_id="turn-1", api_mode="chat_completions", session_id="session-1",
+                           _product_research_route_session_latched=False,
+                           _travel_publication_route_session_latched=False)
+
+
+def _messages(prompt):
+    return [
+        {"role": "user", "content": prompt},
+        {"role": "assistant", "content": "", "tool_calls": [{"id": "extract-1", "type": "function", "function": {
+            "name": "web_extract", "arguments": json.dumps({"urls": URLS})}}]},
+        {"role": "tool", "name": "web_extract", "tool_call_id": "extract-1", "content": json.dumps({"results": [
+            {"url": URLS[0], "content": "36 inch griddle station, four burners"},
+            {"url": URLS[1], "content": "769 sq in cooking surface, 60,000 BTU"}]})},
+    ]
+
+
+def test_explicit_wiki_save_arms_generic_route_and_plain_research_does_not_save():
+    assert requires_generic_research_route(SAVE_PROMPT) is True
+    assert generic_research_save_requested(SAVE_PROMPT) is True
+    assert requires_product_research_route(SAVE_PROMPT) is False
+    for prompt in ("Research the Blackstone griddle and save it to my Obsidian vault.",
+                   "Research dew point and add a wiki page for it."):
+        assert generic_research_save_requested(prompt) is True
+    assert requires_generic_research_route("Research the history of Blackstone griddles.") is False
+    for prompt in ("Research current llama.cpp SYCL docs and give me cited notes.",
+                   "Research SYCL builds using primary sources and do not save anything to my vault.",
+                   "Research train fares. Do not book, buy, save, or publish anything.",
+                   "What is a wiki page?"):
+        assert generic_research_save_requested(prompt) is False
+    agent = _agent()
+    assert arm_generic_research_route_for_turn(agent, SAVE_PROMPT, "turn-1") is True
+    assert agent._generic_research_save_requested is True
+
+
+def test_note_is_created_once_and_never_overwrites(tmp_path):
+    (tmp_path / "research").mkdir()
+    first, digest = publish_generic_research(vault=tmp_path, operator_prompt=SAVE_PROMPT, response="## Specs\n- 4 burners [1]",
+                                             sources=URLS, session_id="session-1", now=NOW)
+    assert first == "research/blackstone-36-inch-original-griddle-propane-2026-09-27.md"
+    text = (tmp_path / first).read_text()
+    assert "review_status: unreviewed" in text and f'  - "{URLS[1]}"' in text and "- 4 burners [1]" in text
+    assert text.startswith('---\ntitle: "Blackstone 36-inch Original Griddle (propane)"\ndate: 2026-09-27\n')
+    second, _ = publish_generic_research(vault=tmp_path, operator_prompt=SAVE_PROMPT, response="other answer",
+                                         sources=URLS, session_id="session-2", now=NOW)
+    assert second.endswith("-2026-09-27-2.md")
+    assert "- 4 burners [1]" in (tmp_path / first).read_text()
+    import hashlib
+    assert hashlib.sha256((tmp_path / first).read_bytes()).hexdigest() == digest
+
+
+def test_publication_refuses_unsafe_or_incomplete_inputs(tmp_path):
+    with pytest.raises(GenericResearchPublicationError, match="vault is unavailable"):
+        publish_generic_research(vault=tmp_path / "missing", operator_prompt=SAVE_PROMPT, response="x", sources=URLS,
+                                 session_id="s", now=NOW)
+    with pytest.raises(GenericResearchPublicationError, match="fewer than two"):
+        publish_generic_research(vault=tmp_path, operator_prompt=SAVE_PROMPT, response="x", sources=URLS[:1],
+                                 session_id="s", now=NOW)
+    outside = tmp_path / "outside"; outside.mkdir(); vault = tmp_path / "vault"; vault.mkdir()
+    (vault / "research").symlink_to(outside)
+    with pytest.raises(GenericResearchPublicationError, match="symbolic link"):
+        publish_generic_research(vault=vault, operator_prompt=SAVE_PROMPT, response="x", sources=URLS,
+                                 session_id="s", now=NOW)
+    assert list(outside.iterdir()) == []
+
+
+def test_title_falls_back_to_answer_heading():
+    assert research_note_title("Research it and save it to the wiki", "# Dew point basics\ntext") == "Dew point basics"
+    assert research_note_title("Please research dew point: definition. Save to wiki.", "") == "dew point"
+
+
+def test_status_lines(tmp_path, monkeypatch):
+    agent = SimpleNamespace(_generic_research_save_requested=True, _generic_research_operator_prompt=SAVE_PROMPT,
+                            _generic_research_receipt_sources=tuple(URLS), session_id="session-1")
+    monkeypatch.delenv("OBSIDIAN_VAULT_PATH", raising=False)
+    assert save_verified_generic_research(agent, "answer").endswith("Not saved to wiki: configured Obsidian vault is unavailable.")
+    monkeypatch.setenv("OBSIDIAN_VAULT_PATH", str(tmp_path))
+    status = save_verified_generic_research(agent, "answer")
+    assert "Saved to wiki: `research/blackstone-36-inch-original-griddle-propane-" in status
+    assert withheld_save_status(agent).endswith("did not pass its source check.")
+    agent._generic_research_save_requested = False
+    assert save_verified_generic_research(agent, "answer") == "" and withheld_save_status(agent) == ""
+
+
+def test_finalizer_saves_verified_answer_and_reports_path(tmp_path, monkeypatch):
+    from agent.research_finalizer import seal_research_final
+
+    monkeypatch.setenv("OBSIDIAN_VAULT_PATH", str(tmp_path))
+    agent = _agent()
+    assert arm_generic_research_route_for_turn(agent, SAVE_PROMPT, "turn-1") is True
+    messages = _messages(SAVE_PROMPT)
+    assert bind_generic_research_receipt(agent, URLS, messages) is True
+    answer = f"Four burners.\n\nSources:\n[1] {URLS[0]}\n[2] {URLS[1]}"
+    messages.append({"role": "assistant", "content": answer})
+    final_response, failed, reason, _finish = seal_research_final(
+        agent, final_response=answer, failed=False, messages=messages, _turn_exit_reason="text_response")
+    assert failed is False
+    assert "Saved to wiki: `research/blackstone-36-inch-original-griddle-propane-" in final_response
+    saved = list((tmp_path / "research").iterdir())
+    assert len(saved) == 1 and "Four burners." in saved[0].read_text()

diff --git a/gateway/verified_receipt_direct_replay.py b/gateway/verified_receipt_direct_replay.py
new file mode 100644
index 000000000..55d3fcbcd
--- /dev/null
+++ b/gateway/verified_receipt_direct_replay.py
@@ -0,0 +1,257 @@
+"""Fail-closed direct replay for a verified generic-research receipt.
+
+This module deliberately does not call a model or send a platform message.  It
+can only recover the exact assistant bytes already committed to the state DB for
+the current receipt-bound turn.  The gateway remains responsible for its normal
+single Telegram send.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+import re
+import sqlite3
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Any
+
+
+_URL_RE = re.compile(r"https://[^\s<>\]\[(){}\"']+")
+_EMPTY_RESPONSES = {"", "(empty)"}
+
+
+@dataclass(frozen=True)
+class DirectReplay:
+    content: str
+    assistant_message_id: int
+    receipt_path: str
+    receipt_sha256: str
+    attempt_marker_path: str
+    cited_urls: tuple[str, ...]
+
+
+def _sha256_bytes(value: bytes) -> str:
+    return hashlib.sha256(value).hexdigest()
+
+
+def _sha256_text(value: str) -> str:
+    return hashlib.sha256(value.encode("utf-8")).hexdigest()
+
+
+def _response_urls(value: str) -> set[str]:
+    return {match.rstrip(".,;:!?") for match in _URL_RE.findall(value)}
+
+
+def _read_receipt_once(path: Path) -> tuple[bytes, dict[str, Any]]:
+    if path.is_symlink() or not path.is_file():
+        raise ValueError("receipt is missing or is not a regular file")
+    raw = path.read_bytes()
+    try:
+        receipt = json.loads(raw)
+    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
+        raise ValueError("receipt is not valid UTF-8 JSON") from exc
+    if not isinstance(receipt, dict):
+        raise ValueError("receipt root is not an object")
+    return raw, receipt
+
+
+def _validate_receipt(
+    *,
+    receipt: dict[str, Any],
+    session_id: str,
+    user_message_id: int,
+    prompt: str,
+    minimum_sources: int,
+) -> tuple[str, set[str]]:
+    if receipt.get("kind") != "hermes-generic-research-receipt":
+        raise ValueError("receipt kind is not eligible")
+    if receipt.get("schema_version") != 1:
+        raise ValueError("receipt schema is not eligible")
+    if receipt.get("session_id") != session_id:
+        raise ValueError("receipt session does not match")
+    if receipt.get("turn_user_message_id") != user_message_id:
+        raise ValueError("receipt user message does not match")
+    prompt_sha256 = _sha256_text(prompt)
+    if receipt.get("turn_prompt_sha256") != prompt_sha256:
+        raise ValueError("receipt prompt digest does not match")
+    if receipt.get("controller_rejections") != []:
+        raise ValueError("receipt has controller rejections")
+    if receipt.get("production_promotion_authorized") is not False:
+        raise ValueError("receipt promotion flag is invalid")
+
+    sources = receipt.get("sources")
+    allowlist = receipt.get("final_citation_allowlist")
+    if not isinstance(sources, list) or len(sources) < minimum_sources:
+        raise ValueError("receipt has too few sources")
+    if not isinstance(allowlist, list) or len(allowlist) < minimum_sources:
+        raise ValueError("receipt has too few allowed citations")
+    source_urls: list[str] = []
+    for source in sources:
+        if not isinstance(source, dict):
+            raise ValueError("receipt source is not an object")
+        url = source.get("url")
+        content_sha256 = source.get("content_sha256")
+        if not isinstance(url, str) or not url.startswith("https://"):
+            raise ValueError("receipt source URL is not HTTPS")
+        if not isinstance(content_sha256, str) or not re.fullmatch(
+            r"[0-9a-f]{64}", content_sha256
+        ):
+            raise ValueError("receipt source digest is invalid")
+        source_urls.append(url)
+    if (
+        any(not isinstance(url, str) or not url.startswith("https://") for url in allowlist)
+        or len(set(allowlist)) != len(allowlist)
+        or set(source_urls) != set(allowlist)
+    ):
+        raise ValueError("receipt sources and citation allowlist do not match")
+    return prompt_sha256, set(allowlist)
+
+
+def _create_attempt_marker(
+    marker_root: Path,
+    *,
+    receipt_sha256: str,
+    session_id: str,
+    user_message_id: int,
+    assistant_message_id: int,
+    content_sha256: str,
+) -> Path:
+    marker_root.mkdir(mode=0o700, parents=True, exist_ok=True)
+    marker_path = marker_root / f"{receipt_sha256}.json"
+    payload = (
+        json.dumps(
+            {
+                "kind": "hermes-verified-receipt-direct-replay-attempt",
+                "schema_version": 1,
+                "session_id": session_id,
+                "turn_user_message_id": user_message_id,
+                "assistant_message_id": assistant_message_id,
+                "receipt_sha256": receipt_sha256,
+                "content_sha256": content_sha256,
+            },
+            sort_keys=True,
+            separators=(",", ":"),
+        )
+        + "\n"
+    ).encode("utf-8")
+    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL
+    if hasattr(os, "O_NOFOLLOW"):
+        flags |= os.O_NOFOLLOW
+    descriptor = os.open(marker_path, flags, 0o600)
+    try:
+        with os.fdopen(descriptor, "wb", closefd=False) as handle:
+            handle.write(payload)
+            handle.flush()
+            os.fsync(handle.fileno())
+    finally:
+        os.close(descriptor)
+    return marker_path
+
+
+def prepare_verified_receipt_direct_replay(
+    *,
+    db_path: Path,
+    receipt_root: Path,
+    marker_root: Path,
+    session_id: str,
+    current_prompt: str,
+    current_response: str,
+    already_sent: bool,
+    failed: bool,
+    minimum_sources: int = 2,
+    minimum_citations: int = 2,
+    minimum_content_chars: int = 500,
+) -> DirectReplay | None:
+    """Return exact verified assistant bytes once, otherwise fail closed.
+
+    Eligibility is intentionally narrow.  The current raw agent response must
+    be empty, no send may already be confirmed, and the latest active user row
+    must be the receipt's originating row.  Any ambiguity returns no replay or
+    raises before the one-attempt marker is committed.
+    """
+    if failed or already_sent or current_response not in _EMPTY_RESPONSES:
+        return None
+    if not session_id or not current_prompt:
+        return None
+
+    with sqlite3.connect(f"file:{db_path}?mode=ro", uri=True) as connection:
+        connection.row_factory = sqlite3.Row
+        user_row = connection.execute(
+            "SELECT id, content FROM messages WHERE session_id = ? "
+            "AND role = 'user' AND active = 1 ORDER BY id DESC LIMIT 1",
+            (session_id,),
+        ).fetchone()
+        if user_row is None:
+            return None
+        user_message_id = int(user_row["id"])
+        stored_prompt = user_row["content"]
+        if not isinstance(stored_prompt, str) or stored_prompt != current_prompt:
+            return None
+
+        root = receipt_root.resolve(strict=True)
+        receipt_path = (root / f"{session_id}--turn-{user_message_id}.json").resolve()
+        try:
+            receipt_path.relative_to(root)
+        except ValueError as exc:
+            raise ValueError("receipt path escapes configured root") from exc
+        raw_receipt, receipt = _read_receipt_once(receipt_path)
+        receipt_sha256 = _sha256_bytes(raw_receipt)
+        _, allowed = _validate_receipt(
+            receipt=receipt,
+            session_id=session_id,
+            user_message_id=user_message_id,
+            prompt=stored_prompt,
+            minimum_sources=minimum_sources,
+        )
+
+        rows = connection.execute(
+            "SELECT id, content, finish_reason FROM messages WHERE session_id = ? "
+            "AND role = 'assistant' AND active = 1 AND id > ? ORDER BY id",
+            (session_id, user_message_id),
+        ).fetchall()
+
+    eligible: list[tuple[int, str, tuple[str, ...]]] = []
+    for row in rows:
+        finish_reason = str(row["finish_reason"] or "")
+        content = row["content"]
+        if "generic_research_verified" not in finish_reason:
+            continue
+        if not isinstance(content, str) or content != content.strip():
+            continue
+        if len(content) < minimum_content_chars:
+            continue
+        cited = _response_urls(content)
+        if cited - allowed or len(cited & allowed) < minimum_citations:
+            continue
+        eligible.append((int(row["id"]), content, tuple(sorted(cited))))
+
+    if not eligible:
+        return None
+    if len(eligible) != 1:
+        raise ValueError("current receipt turn has multiple verified final answers")
+
+    # Re-read the receipt immediately before committing the attempt.  This is
+    # the seal check: any byte-level mutation between validation and replay
+    # makes the operation ineligible.
+    if _sha256_bytes(receipt_path.read_bytes()) != receipt_sha256:
+        raise ValueError("receipt changed during validation")
+
+    assistant_message_id, content, cited_urls = eligible[0]
+    marker_path = _create_attempt_marker(
+        marker_root,
+        receipt_sha256=receipt_sha256,
+        session_id=session_id,
+        user_message_id=user_message_id,
+        assistant_message_id=assistant_message_id,
+        content_sha256=_sha256_text(content),
+    )
+    return DirectReplay(
+        content=content,
+        assistant_message_id=assistant_message_id,
+        receipt_path=str(receipt_path),
+        receipt_sha256=receipt_sha256,
+        attempt_marker_path=str(marker_path),
+        cited_urls=cited_urls,
+    )

+class TestB70PrivateMarkers:
+    def test_convert_messages_strips_opaque_nested_tool_call_markers(self, transport):
+        """Private lifecycle authority stays in memory but never reaches JSON.
+
+        Parallel research authenticates an assistant tool call and its result
+        with the same bare ``object()`` token. A mock client accepts that
+        value, while the real OpenAI SDK must JSON-encode the second request
+        and otherwise fails before any provider POST is made.
+        """
+        auth_token = object()
+        msgs = [
+            {
+                "role": "assistant",
+                "content": "",
+                "tool_calls": [
+                    {
+                        "id": "call-skill",
+                        "type": "function",
+                        "function": {
+                            "name": "skill_view",
+                            "arguments": '{"name":"parallel-research"}',
+                        },
+                        "_research_lifecycle_auth_token": auth_token,
+                    }
+                ],
+            },
+            {
+                "role": "tool",
+                "tool_call_id": "call-skill",
+                "content": '{"success":true}',
+                "_research_lifecycle_auth_token": auth_token,
+            },
+        ]
+
+        result = transport.convert_messages(msgs)
+
+        assert "_research_lifecycle_auth_token" not in result[0]["tool_calls"][0]
+        assert "_research_lifecycle_auth_token" not in result[1]
+        json.dumps(result)
+        assert (
+            msgs[0]["tool_calls"][0]["_research_lifecycle_auth_token"]
+            is auth_token
+        )
+        assert msgs[1]["_research_lifecycle_auth_token"] is auth_token
+
+    def test_nested_private_marker_strip_preserves_gemini_signature(self, transport):
+        """Wire privacy and Gemini's required replay metadata compose safely."""
+        auth_token = object()
+        signature = {"google": {"thought_signature": "SIG_123"}}
+        msgs = [
+            {
+                "role": "assistant",
+                "content": "",
+                "tool_calls": [
+                    {
+                        "id": "call-skill",
+                        "type": "function",
+                        "function": {"name": "skill_view", "arguments": "{}"},
+                        "extra_content": signature,
+                        "_research_lifecycle_auth_token": auth_token,
+                    }
+                ],
+            }
+        ]
+
+        result = transport.convert_messages(msgs, model="google/gemini-3-pro")
+
+        wire_call = result[0]["tool_calls"][0]
+        assert "_research_lifecycle_auth_token" not in wire_call
+        assert wire_call["extra_content"] == signature
+        json.dumps(result)
+        assert (
+            msgs[0]["tool_calls"][0]["_research_lifecycle_auth_token"]
+            is auth_token
+        )

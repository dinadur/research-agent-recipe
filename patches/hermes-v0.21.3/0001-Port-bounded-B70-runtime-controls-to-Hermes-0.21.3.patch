@@ -0,0 +1,128 @@
+"""Existing B70 behavior contracts retained verbatim during migration."""
+from agent.tool_guardrails import ToolCallGuardrailConfig, ToolCallGuardrailController
+
+
+def test_concurrent_retrieval_admission_cannot_overspend_shared_budget():
+    from concurrent.futures import ThreadPoolExecutor
+    from threading import Barrier
+
+    controller = ToolCallGuardrailController(
+        ToolCallGuardrailConfig(retrieval_call_limit=3)
+    )
+    barrier = Barrier(16)
+
+    def submit(index):
+        barrier.wait(timeout=10)
+        tool = "web_search" if index % 2 else "web_extract"
+        return controller.before_call(tool, {"query": str(index)})
+
+    with ThreadPoolExecutor(max_workers=16) as pool:
+        decisions = list(pool.map(submit, range(16)))
+    assert sum(d.allows_execution for d in decisions) == 3
+    assert sum(d.action == "skip" for d in decisions) == 13
+    assert not any(d.should_halt for d in decisions)
+    controller.reset_for_turn()
+    assert controller.before_call("web_search", {"query": "new turn"}).allows_execution
+
+def test_default_config_is_soft_warning_only_with_hard_stop_disabled():
+    cfg = ToolCallGuardrailConfig()
+
+    assert cfg.warnings_enabled is True
+    assert cfg.hard_stop_enabled is False
+    assert cfg.exact_failure_warn_after == 2
+    assert cfg.same_tool_failure_warn_after == 3
+    assert cfg.no_progress_warn_after == 2
+    assert cfg.exact_failure_block_after == 5
+    assert cfg.same_tool_failure_halt_after == 8
+    assert cfg.no_progress_block_after == 5
+    assert cfg.retrieval_call_limit == 0
+
+def test_config_parses_nested_warn_and_hard_stop_thresholds():
+    cfg = ToolCallGuardrailConfig.from_mapping(
+        {
+            "warnings_enabled": False,
+            "hard_stop_enabled": True,
+            "warn_after": {
+                "exact_failure": 3,
+                "same_tool_failure": 4,
+                "idempotent_no_progress": 5,
+            },
+            "hard_stop_after": {
+                "exact_failure": 6,
+                "same_tool_failure": 7,
+                "idempotent_no_progress": 8,
+            },
+            "retrieval_call_limit": 9,
+        }
+    )
+
+    assert cfg.warnings_enabled is False
+    assert cfg.hard_stop_enabled is True
+    assert cfg.exact_failure_warn_after == 3
+    assert cfg.same_tool_failure_warn_after == 4
+    assert cfg.no_progress_warn_after == 5
+    assert cfg.exact_failure_block_after == 6
+    assert cfg.same_tool_failure_halt_after == 7
+    assert cfg.no_progress_block_after == 8
+    assert cfg.retrieval_call_limit == 9
+
+def test_optional_retrieval_limit_skips_network_call_without_halting_turn():
+    controller = ToolCallGuardrailController(
+        ToolCallGuardrailConfig(retrieval_call_limit=2)
+    )
+
+    first = controller.before_call("web_search", {"query": "one"})
+    second = controller.before_call("web_extract", {"urls": ["https://example.test"]})
+    skipped = controller.before_call("web_search", {"query": "three"})
+
+    assert first.action == "allow"
+    assert second.action == "allow"
+    assert skipped.action == "skip"
+    assert skipped.code == "retrieval_call_limit_reached"
+    assert skipped.count == 2
+    assert skipped.allows_execution is False
+    assert skipped.should_halt is False
+    assert "Synthesize the best answer now" in skipped.message
+    assert controller.halt_decision is None
+
+def test_retrieval_limit_ignores_local_reads_and_resets_per_turn():
+    controller = ToolCallGuardrailController(
+        ToolCallGuardrailConfig(retrieval_call_limit=1)
+    )
+
+    assert controller.before_call("read_file", {"path": "/tmp/a"}).action == "allow"
+    assert controller.before_call("web_search", {"query": "one"}).action == "allow"
+    assert controller.before_call("web_extract", {"urls": ["https://example.test"]}).action == "skip"
+
+    controller.reset_for_turn()
+
+    assert controller.before_call("web_extract", {"urls": ["https://example.test"]}).action == "allow"
+
+def test_terminal_web_provider_402_warns_immediately_and_allows_synthesis():
+    controller = ToolCallGuardrailController()
+
+    decision = controller.after_call(
+        "web_search",
+        {"query": "current Toronto train schedule"},
+        '{"error":"Brave returned HTTP 402 Payment Required"}',
+        failed=True,
+    )
+
+    assert decision.action == "warn"
+    assert decision.code == "terminal_provider_failure_warning"
+    assert decision.count == 1
+    assert "Do not retry this provider path" in decision.message
+    assert "synthesize the answer now" in decision.message
+    assert "keep using tools" not in decision.message
+
+def test_terminal_provider_status_code_shape_is_recognized_for_web_extract():
+    controller = ToolCallGuardrailController()
+
+    decision = controller.after_call(
+        "web_extract",
+        {"url": "https://example.test"},
+        '{"success":false,"status_code":402,"error":"quota"}',
+        failed=True,
+    )
+
+    assert decision.code == "terminal_provider_failure_warning"

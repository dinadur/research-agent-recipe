diff --git a/agent/travel_terminal_policy.py b/agent/travel_terminal_policy.py
new file mode 100644
index 000000000..eff10994e
--- /dev/null
+++ b/agent/travel_terminal_policy.py
@@ -0,0 +1,94 @@
+"""B70 travel controller admission, independent of the research runtime.
+
+Only the existing routed controller shapes receive foreground headroom. Other
+long commands retain upstream's tracked-background behavior. The vault must be
+configured explicitly; historical Windows defaults are not runtime authority.
+"""
+from __future__ import annotations
+
+import os
+from pathlib import Path
+import re
+import shlex
+
+from hermes_constants import get_hermes_home
+
+_SHELL_CONTROL = re.compile(r"&&|\|\||[;&|<>`]|\r|\n|\$\(")
+_RUNNER_MODULE = "agent.research_harness.travel_runner"
+_CONTROLLER_NAME = "run_hermes_travel_pipeline.py"
+_OPTION_LIMITS = {"--max-turns": (1, 4), "--timeout": (1, 600), "--min-included": (1, 12)}
+_REUSE_OPTIONS = {"--reuse-valid-extraction", "--reuse-valid-review"}
+CONTROLLER_FOREGROUND_MAX_TIMEOUT = 900
+
+
+def _under_raw(value: str, raw_root: Path) -> bool:
+    path = Path(value).expanduser()
+    if not path.is_absolute():
+        return False
+    try:
+        path.resolve().relative_to(raw_root)
+    except (OSError, RuntimeError, ValueError):
+        return False
+    return True
+
+
+def travel_controller_foreground_timeout_allowed(command, timeout) -> bool:
+    if (not isinstance(command, str) or not isinstance(timeout, int)
+            or isinstance(timeout, bool) or not 0 < timeout <= CONTROLLER_FOREGROUND_MAX_TIMEOUT
+            or _SHELL_CONTROL.search(command)):
+        return False
+    vault = os.getenv("OBSIDIAN_VAULT_PATH")
+    if not vault:
+        return False
+    try:
+        raw_root = (Path(vault).expanduser() / "raw" / "travel").resolve()
+        tokens = shlex.split(command, posix=True)
+        if not tokens or Path(tokens[0]).name not in {"python", "python3"}:
+            return False
+        if tokens[1:3] == ["-m", _RUNNER_MODULE]:
+            return (len(tokens) == 4 and Path(tokens[3]).suffix.casefold() == ".json"
+                    and _under_raw(tokens[3], raw_root))
+        if len(tokens) < 4:
+            return False
+        script = Path(tokens[1]).expanduser()
+        expected = get_hermes_home() / "skills" / "travel-planning" / "scripts" / _CONTROLLER_NAME
+        if (not script.is_absolute() or script.name != _CONTROLLER_NAME
+                or script.resolve() != expected.resolve()
+                or not all(_under_raw(value, raw_root) for value in tokens[2:4])):
+            return False
+        index = 4
+        while index < len(tokens):
+            option = tokens[index]
+            if option in _REUSE_OPTIONS:
+                index += 1
+                continue
+            limits = _OPTION_LIMITS.get(option)
+            if limits is None or index + 1 >= len(tokens):
+                return False
+            if not limits[0] <= int(tokens[index + 1]) <= limits[1]:
+                return False
+            index += 2
+        return True
+    except (OSError, RuntimeError, ValueError):
+        return False
+
+
+def canonical_travel_terminal_block(command: str) -> str | None:
+    """Preserve the installed guard against terminal bypass of the publisher.
+
+    This string-path guard is one layer; routed tool admission and file-write
+    guards are also required before the complete research lane can be enabled.
+    """
+    vault = os.getenv("OBSIDIAN_VAULT_PATH")
+    if not vault:
+        return None
+    normalized = command.replace("\\", "/").lower()
+    root = vault.replace("\\", "/").rstrip("/").lower()
+    if not any(f"{root}/{sub}" in normalized for sub in ("travel/destinations", "travel/active")):
+        return None
+    return (
+        "Command references a canonical travel vault path (travel/destinations/ or travel/active/). "
+        "Read pages with read_file and publish changes only through the receipt-only "
+        "publisher under the configured Hermes home's skills/travel-planning/scripts/publish_travel.py. "
+        "Draft work belongs under raw/travel/."
+    )

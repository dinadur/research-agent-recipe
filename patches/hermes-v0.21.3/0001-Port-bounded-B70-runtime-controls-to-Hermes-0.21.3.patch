diff --git a/gateway/run_verified_receipt.py b/gateway/run_verified_receipt.py
new file mode 100644
index 000000000..35264e305
--- /dev/null
+++ b/gateway/run_verified_receipt.py
@@ -0,0 +1,52 @@
+"""Carry B70's one-attempt receipt recovery through the current gateway phases."""
+import asyncio
+import logging
+import os
+from pathlib import Path
+
+from hermes_constants import get_hermes_home
+from gateway.verified_receipt_direct_replay import prepare_verified_receipt_direct_replay
+
+logger = logging.getLogger(__name__)
+
+
+async def recover_verified_receipt(runner, result, *, platform, session_id, prompt):
+    response = result.get("final_response") or ""
+    if (
+        os.getenv("HERMES_VERIFIED_RECEIPT_DIRECT_REPLAY_CANARY", "") != "1"
+        or platform.lower() != "telegram"
+        or runner._session_db is None
+        or runner._is_intentional_silence(result, response)
+        or (result.get("session_id") and result["session_id"] != session_id)
+    ):
+        return
+    home = get_hermes_home()
+    try:
+        replay = await asyncio.to_thread(
+            prepare_verified_receipt_direct_replay,
+            db_path=runner._session_db._db.db_path,
+            receipt_root=Path(os.getenv("HERMES_RESEARCH_RECEIPT_ROOT", str(home / "research-receipts"))),
+            marker_root=Path(os.getenv("HERMES_VERIFIED_RECEIPT_DIRECT_REPLAY_MARKER_ROOT", str(home / "verified-receipt-direct-replay-attempts"))),
+            session_id=session_id,
+            current_prompt=prompt,
+            current_response=response,
+            already_sent=bool(result.get("already_sent")),
+            failed=bool(result.get("failed")),
+        )
+    except FileExistsError:
+        logger.warning("Verified receipt recovery was already attempted for session %s", session_id)
+        return
+    except Exception as exc:
+        # An ineligible/ambiguous receipt keeps the original response. Recovery is
+        # deliberately narrower than the gateway's ordinary response path.
+        logger.warning("Verified receipt recovery ineligible for session %s: %s", session_id, exc)
+        return
+    if replay is not None:
+        result["final_response"] = replay.content
+        result["already_sent"] = False
+        result["verified_receipt_direct_replay"] = {
+            "assistant_message_id": replay.assistant_message_id,
+            "receipt_sha256": replay.receipt_sha256,
+            "attempt_marker_path": replay.attempt_marker_path,
+        }
+    return replay

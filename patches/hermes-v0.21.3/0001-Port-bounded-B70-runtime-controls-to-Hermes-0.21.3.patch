@@ -0,0 +1,33 @@
+"""B70 retrieval policy shared by the turn controller's existing decision path."""
+
+BOUNDED_RETRIEVAL_TOOLS = frozenset({"web_search", "web_extract"})
+_PROVIDER_TOOLS = BOUNDED_RETRIEVAL_TOOLS | {"x_search"}
+_TERMINAL_MARKERS = (
+    "http 402", "http status 402", "status code 402", '"status":402',
+    '"status": 402', '"status_code":402', '"status_code": 402',
+    "402 payment required", "payment required", "insufficient credit",
+    "insufficient balance", "credit balance exhausted", "billing quota exhausted",
+)
+
+RETRIEVAL_LIMIT_MESSAGE = (
+    "The configured retrieval allowance for this turn is complete. "
+    "Do not call web_search or web_extract again. Synthesize the best "
+    "answer now from the evidence already collected, clearly stating "
+    "any remaining uncertainty."
+)
+
+
+def is_terminal_provider_failure(tool_name: str, result: str | None) -> bool:
+    if tool_name not in _PROVIDER_TOOLS or not isinstance(result, str):
+        return False
+    return any(marker in result[:4000].lower() for marker in _TERMINAL_MARKERS)
+
+
+def terminal_provider_failure_hint(tool_name: str, count: int) -> str:
+    return (
+        f"{tool_name} reported a terminal provider billing or credit failure "
+        f"({count} time(s) this turn). Do not retry this provider path. "
+        "If the evidence already collected is sufficient, synthesize the answer now "
+        "and state any resulting limitation. Otherwise try one genuinely different "
+        "retrieval tool or direct source path; if none is available, report the blocker."
+    )

@@ -0,0 +1,261 @@
+"""Mandatory research custody at tool dispatch, outside observer middleware.
+
+Private predispatch payloads are admitted before observers. For this controlled
+phase the typed canonical call is executed directly; optional middleware cannot
+rewrite its arguments, short-circuit dispatch or substitute a success receipt.
+Ordinary calls retain the upstream middleware path and are checked at its final
+execution boundary. Only actual dispatch results can mint research authority.
+"""
+from __future__ import annotations
+import contextvars
+from contextlib import contextmanager
+
+_controlled_dispatch = contextvars.ContextVar("b70_controlled_dispatch", default=False)
+
+@contextmanager
+def controlled_dispatch_scope(active):
+    token = _controlled_dispatch.set(bool(active))
+    try:
+        yield
+    finally:
+        _controlled_dispatch.reset(token)
+
+def controlled_dispatch_active():
+    return _controlled_dispatch.get() is True
+
+import copy
+import json
+import logging
+from typing import Any, Optional
+logger = logging.getLogger(__name__)
+
+def _admit_controlled_research_tool_request(
+    agent: Any,
+    *,
+    function_name: str,
+    function_args: dict,
+    tool_call_count: int,
+) -> tuple[bool, Any, Optional[dict]]:
+    """Authenticate a private predispatch call before any request observer.
+
+    Returns ``(controlled, decision, admitted_args)``.  A controlled rejected
+    provider payload never enters tool-request middleware.  A successful
+    admission returns a deep-copied canonical argument snapshot which remains
+    the only argument authority for execution middleware and dispatch.
+    """
+
+    try:
+        from agent.research_contract import (
+            ResearchContractDecision,
+            before_agent_tool_call,
+            parallel_research_predispatch_phase,
+            record_parallel_research_predispatch_admitted,
+            record_parallel_research_predispatch_controller_decision,
+        )
+
+        def _record_controller_decision(code: str) -> None:
+            try:
+                record_parallel_research_predispatch_controller_decision(
+                    agent, code
+                )
+            except BaseException:
+                pass
+
+        def _record_admitted() -> None:
+            try:
+                record_parallel_research_predispatch_admitted(agent)
+            except BaseException:
+                pass
+
+        phase = parallel_research_predispatch_phase(agent)
+        if phase is None:
+            return False, None, None
+        if tool_call_count != 1:
+            _record_controller_decision(
+                "research_predispatch_single_call_required"
+            )
+            return (
+                True,
+                ResearchContractDecision(
+                    "research_predispatch_single_call_required",
+                    "The controlled research phase requires exactly one "
+                    "current-phase tool call. The rejected provider batch was "
+                    "not exposed to request middleware.",
+                    status="rejected",
+                    retryable=True,
+                    executed=False,
+                ),
+                None,
+            )
+
+        decision = before_agent_tool_call(
+            agent, function_name, function_args
+        )
+        if decision is not None:
+            _record_controller_decision(decision.code)
+            return True, decision, None
+        if function_name != phase:
+            # ``before_agent_tool_call`` is expected to reject this, but keep
+            # the observer boundary fail-closed if a future contract change
+            # accidentally returns no decision for a wrong-phase tool.
+            _record_controller_decision("research_predispatch_phase_mismatch")
+            return (
+                True,
+                ResearchContractDecision(
+                    "research_predispatch_phase_mismatch",
+                    "The controlled research phase rejected a non-current "
+                    "tool call before request middleware.",
+                    status="rejected",
+                    retryable=True,
+                    executed=False,
+                ),
+                None,
+            )
+        _record_admitted()
+        return True, None, copy.deepcopy(function_args)
+    except Exception:
+        # Contract import/state failures must not route candidate-private
+        # provider arguments through an observer.  The caller will treat this
+        # as a controlled rejection when the private turn flag is active.
+        if getattr(
+            agent, "_parallel_research_defer_candidate_text_for_turn", False
+        ):
+            from agent.research_contract import (
+                ResearchContractDecision,
+                record_parallel_research_predispatch_controller_decision,
+            )
+
+            try:
+                record_parallel_research_predispatch_controller_decision(
+                    agent, "research_predispatch_admission_failed"
+                )
+            except BaseException:
+                pass
+
+            return (
+                True,
+                ResearchContractDecision(
+                    "research_predispatch_admission_failed",
+                    "The controlled research tool call could not be "
+                    "authenticated and was rejected before request middleware.",
+                    terminal_failure=True,
+                    status="rejected",
+                    retryable=False,
+                    executed=False,
+                ),
+                None,
+            )
+        return False, None, None
+
+
+def _research_result_output_deferred(agent) -> bool:
+    """Whether this turn's candidate/tool content must remain private."""
+
+    turn_id = getattr(agent, "_current_turn_id", None)
+    return bool(
+        (isinstance(turn_id, str) and turn_id and any(
+            getattr(agent, key, None) == turn_id for key in (
+                "_product_research_route_turn_id", "_travel_publication_route_turn_id", "_generic_research_route_turn_id",
+            )
+        ))
+        or getattr(agent, "_parallel_research_defer_streaming_for_turn", False)
+        or getattr(
+            agent, "_parallel_research_defer_candidate_text_for_turn", False
+        )
+    )
+
+
+def validate_provider_tool_call_ids(tool_calls) -> Optional[str]:
+    """Return a deterministic rejection reason for blank/duplicate call IDs.
+
+    Tool-result pairing, background-dispatch receipts, and iteration refunds all
+    key off the provider's call ID.  Reject the response before any side effect
+    instead of letting two calls collapse onto the same receipt/result slot.
+    """
+
+    seen: set[str] = set()
+    for index, tool_call in enumerate(tool_calls or []):
+        raw_id = getattr(tool_call, "id", None)
+        if not isinstance(raw_id, str) or not raw_id.strip():
+            return f"provider tool call {index + 1} has a blank tool_call_id"
+        call_id = raw_id.strip()
+        if call_id in seen:
+            return f"provider tool_call_id {call_id!r} is duplicated in one response"
+        seen.add(call_id)
+    return None
+
+
+
+def observe_dispatch(agent, name, args, result, call_id):
+    from agent.research_contract import observe_agent_tool_result
+    from agent.display import _detect_tool_failure
+    failed, _ = _detect_tool_failure(name, result)
+    return observe_agent_tool_result(agent, name, args, result, failed=failed, tool_call_id=call_id)
+
+
+def observe_block(agent, name, args, result, call_id):
+    from agent.research_contract import observe_agent_tool_result
+    return observe_agent_tool_result(agent, name, args, result, failed=True, tool_call_id=call_id)
+
+
+def admit_batch(agent, tool_calls, messages):
+    from agent.research_contract import parallel_research_predispatch_phase
+    phase = parallel_research_predispatch_phase(agent)
+    if phase is None:
+        return True
+    error = validate_provider_tool_call_ids(tool_calls)
+    if len(tool_calls) != 1:
+        error = "The controlled research phase requires exactly one current-phase tool call."
+    if error is None:
+        tc = tool_calls[0]
+        if getattr(getattr(tc, "function", None), "name", None) != phase:
+            error = "The controlled research phase rejected a wrong-phase tool call."
+    if error is None:
+        return True
+    # The finalizer removes unauthenticated lifecycle rows. Do not expose raw
+    # rejected names/arguments to callbacks or persist them in the meantime.
+    for tc in tool_calls:
+        messages.append({"role":"tool", "tool_call_id":getattr(tc,"id","") or "rejected-research-call",
+                         "content":json.dumps({"error":error,"status":"rejected","executed":False,"retryable":True})})
+    return False
+
+
+def _bind_travel_controller_execution_arguments(
+    agent: Any,
+    tool_call: Any,
+    function_name: str,
+    function_args: dict,
+) -> bool:
+    """Record the exact controller-bound arguments that are actually executed.
+
+    Travel admission force-binds the outer timeout. The hash-bound delivery
+    verifier examines the assistant tool call later, so leaving the provider's
+    pre-binding JSON in that object creates an avoidable recorded/executed
+    mismatch. Only the exact allowlisted travel runner/controller shape is
+    rewritten here; ordinary terminal and Tool Search calls are untouched.
+    """
+
+    if function_name != "terminal" or not isinstance(function_args, dict):
+        return False
+    try:
+        from agent.research_contract import travel_controller_foreground_timeout_allowed
+        from agent.travel_route import travel_publication_route_active
+
+        if not travel_publication_route_active(agent) or not (
+            travel_controller_foreground_timeout_allowed(
+                function_args.get("command"), function_args.get("timeout")
+            )
+        ):
+            return False
+        function = getattr(tool_call, "function", None)
+        if function is None:
+            return False
+        function.arguments = json.dumps(
+            function_args,
+            ensure_ascii=False,
+            separators=(",", ":"),
+        )
+        return True
+    except Exception:
+        logger.exception("Failed to bind executed travel controller arguments")
+        return False

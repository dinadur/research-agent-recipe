+                    # the index used by the persistence-only user override.
+                    agent._persist_user_message_idx = index
+                    break
+        if boundary < 0:
+            for index in range(len(messages) - 1, -1, -1):
+                message = messages[index]
+                if isinstance(message, dict) and message.get("role") == "user":
+                    boundary = index
+                    break
+
+        # These are the replay/display fields currently emitted by the chat,
+        # Anthropic/OpenRouter, and Codex adapters.  The name guards also cover
+        # provider variants such as ``thinking_content`` and
+        # ``analysis_details`` without accidentally matching ``finish_reason``.
+        explicit_reasoning_keys = {
+            "reasoning",
+            "reasoning_content",
+            "reasoning_details",
+            "codex_reasoning_items",
+            "codex_message_items",
+            "anthropic_content_blocks",
+            "provider_data",
+            "extra_content",
+            "thinking",
+            "thinking_content",
+            "thinking_details",
+            "analysis",
+            "analysis_content",
+            "analysis_details",
+            "thought",
+            "thoughts",
+        }
+
+        retained_tool_call_ids: set[str] = set()
+        authenticated_lifecycle_tokens = (
+            set(
+                getattr(
+                    agent,
+                    "_parallel_research_authenticated_lifecycle_tokens",
+                    set(),
+                )
+            )
+            if predispatch
+            else set()
+        )
+        authenticated_result_tokens = set()
+        def _authenticated_token(token) -> bool:
+            try:
+                return token in authenticated_lifecycle_tokens
+            except TypeError:
+                return False
+
+        if predispatch:
+            for candidate in messages[boundary + 1 :]:
+                if not isinstance(candidate, dict) or candidate.get("role") != "tool":
+                    continue
+                token = candidate.get("_research_lifecycle_auth_token")
+                try:
+                    if _authenticated_token(token):
+                        authenticated_result_tokens.add(token)
+                except TypeError:
+                    pass
+        pending_lifecycle_tokens = set()
+        sanitized_tail = []
+        for message in messages[boundary + 1 :]:
+            if not isinstance(message, dict):
+                continue
+            role = message.get("role")
+            if role == "assistant":
+                tool_calls = message.get("tool_calls")
+                if not isinstance(tool_calls, list) or not tool_calls:
+                    # Model prose is never durable authority on a controlled
+                    # turn.  The final response is re-added exactly once from
+                    # the controller-owned ``final_response`` below.
+                    continue
+
+                if predispatch:
+                    names = []
+                    auth_tokens = []
+                    for tool_call in tool_calls:
+                        function = (
+                            tool_call.get("function")
+                            if isinstance(tool_call, dict)
+                            else None
+                        )
+                        names.append(
+                            function.get("name")
+                            if isinstance(function, dict)
+                            else None
+                        )
+                        auth_tokens.append(
+                            tool_call.get("_research_lifecycle_auth_token")
+                            if isinstance(tool_call, dict)
+                            else None
+                        )
+                    if not names or any(
+                        name not in {"skill_view", "delegate_task"}
+                        for name in names
+                    ) or any(
+                        not _authenticated_token(token)
+                        or token not in authenticated_result_tokens
+                        for token in auth_tokens
+                    ):
+                        # Invalid/unexecuted provider payload is not a safe
+                        # lifecycle row and must not survive an abnormal exit.
+                        continue
+                    pending_lifecycle_tokens.update(auth_tokens)
+
+                message["content"] = ""
+                for key in tuple(message):
+                    normalized = str(key).lower()
+                    if (
+                        normalized in explicit_reasoning_keys
+                        or "reasoning" in normalized
+                        or normalized.startswith("thinking_")
+                        or normalized.startswith("analysis_")
+                    ):

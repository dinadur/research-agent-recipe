+def _catalog_row_response(agent) -> tuple[str, tuple[str, ...]]:
+    sources = tuple(agent._product_research_receipt_sources)
+    catalog = agent._product_research_evidence_catalog
+
+    def row_id(url: str, text: str) -> str:
+        return next(
+            row["row_id"]
+            for row in catalog["rows"]
+            if row["url"] == url and text in row["quote"]
+        )
+
+    official, review_one, review_two = sources
+    response = f"""# Best Vendor Vacuum Under $600
+
+## Recommendation
+**Recommended brand:** Vendor [[{row_id(official, "currently listed at $599.99")}]]
+- **Recommended product:** Vendor A best fits mixed floors and pet hair. [[{row_id(review_one, "embedded pet hair")}]]
+
+## Compared options
+- **Vendor A:** It removed most debris from hardwood flooring. [[{row_id(review_one, "most debris")}]]
+- **Vendor B:** It is the lower-priced alternative. [[{row_id(review_two, "lower-priced")}]]
+
+## Caveats
+- Maximum suction shortens battery duration. [[{row_id(review_one, "maximum suction")}]]
+
+## Source roles
+- **Official:** [Vendor product page]({official})
+- **Independent:** [Review One test]({review_one})
+- **Independent:** [Review Two comparison]({review_two})"""
+    return response, sources

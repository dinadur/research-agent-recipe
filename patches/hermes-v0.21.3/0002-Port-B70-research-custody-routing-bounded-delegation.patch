@@ -0,0 +1,360 @@
+"""Focused regressions for SearXNG suspension and stampede control."""
+
+from __future__ import annotations
+
+import threading
+from typing import Any
+
+import httpx
+import pytest
+
+from plugins.web.searxng import circuit as searxng
+from plugins.web.searxng.provider import SearXNGWebSearchProvider
+
+
+class _Response:
+    def __init__(self, payload: Any) -> None:
+        self._payload = payload
+        self.status_code = 200
+
+    def raise_for_status(self) -> None:
+        return None
+
+    def json(self) -> Any:
+        return self._payload
+
+
+@pytest.fixture(autouse=True)
+def _isolated_guard(monkeypatch: pytest.MonkeyPatch):
+    """Give every test fresh process-wide guard state and no real waiting."""
+    monkeypatch.setattr(searxng, "_SEARCH_GATE", threading.BoundedSemaphore(1))
+    monkeypatch.setattr(searxng, "_MIN_REQUEST_INTERVAL_SECONDS", 0.0)
+    monkeypatch.setattr(searxng, "_SEARCH_GATE_TIMEOUT_SECONDS", 1.0)
+    monkeypatch.setattr(searxng, "provider_env", lambda key: "http://searx.test")
+    searxng._reset_runtime_guard_for_tests()
+    yield
+    searxng._reset_runtime_guard_for_tests()
+
+
+def _provider() -> SearXNGWebSearchProvider:
+    return SearXNGWebSearchProvider()
+
+
+def test_ordinary_empty_result_remains_successful(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    monkeypatch.setattr(
+        httpx,
+        "get",
+        lambda *args, **kwargs: _Response(
+            {"results": [], "unresponsive_engines": []}
+        ),
+    )
+
+    result = _provider().search("an intentionally obscure query")
+
+    assert result == {"success": True, "data": {"web": []}}
+
+
+def test_partial_engine_failure_does_not_reclassify_empty_result(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    monkeypatch.setattr(
+        httpx,
+        "get",
+        lambda *args, **kwargs: _Response(
+            {
+                "results": [],
+                "unresponsive_engines": [
+                    ["brave", "Suspended: too many requests"],
+                    ["wikipedia", "timeout"],
+                ],
+            }
+        ),
+    )
+
+    result = _provider().search("no matching documents")
+
+    assert result == {"success": True, "data": {"web": []}}
+
+
+def test_empty_query_keeps_historical_empty_semantics(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    calls = 0
+
+    def fake_get(*args, **kwargs):
+        nonlocal calls
+        calls += 1
+        return _Response(
+            {
+                "results": [],
+                "unresponsive_engines": [
+                    ["brave", "Suspended: too many requests"],
+                    ["duckduckgo", "CAPTCHA"],
+                    ["google cse", "Suspended: too many requests"],
+                ],

+                    tool_call.pop("_research_lifecycle_auth_token", None)
+                    for id_key in (
+                        "id",
+                        "call_id",
+                        "tool_call_id",
+                    ):
+                        call_id = tool_call.get(id_key)
+                        if isinstance(call_id, str) and call_id:
+                            retained_tool_call_ids.add(call_id)

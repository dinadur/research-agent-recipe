+                    _research_delivery_validation is not None
+                    and _research_delivery_validation.passed
+                )
+        except Exception:
+            logger.debug(
+                "final research synthesis delivery check failed",
+                exc_info=True,
+            )
+            SYNTHESIS_WITHHELD_RESPONSE = (
+                "Research synthesis withheld: the controller could not verify "
+                "the proposed answer, so no research recommendation was "
+                "delivered."
+            )
+            _research_delivery_passed = False
+
+        if not _research_delivery_passed:
+            final_response = SYNTHESIS_WITHHELD_RESPONSE
+            failed = True
+            _turn_exit_reason = "research_synthesis_withheld"
+            agent._response_was_previewed = False
+            _seal_current_turn_assistant(
+                final_response, "research_synthesis_withheld"
+            )
+    elif (failed is True and _turn_exit_reason == "product_research_first_response_timeout"
+            and getattr(agent, "_b70_research_terminal_receipt", None)
+            == (turn_id, final_response, _turn_exit_reason, True)):
+        # A controller-created operational failure is already sealed; source
+        # validation cannot turn a timeout into a misleading evidence error.
+        agent._response_was_previewed = False
+        _seal_current_turn_assistant(final_response, _turn_exit_reason)
+    elif _generic_research_turn:
+        try:
+            from agent.generic_research_route import (
+                GENERIC_RESEARCH_WITHHELD_RESPONSE,
+                validate_generic_research_response,
+            )
+
+            _generic_delivery_passed, _generic_delivery, _generic_reason = (
+                validate_generic_research_response(agent, final_response)
+            )
+        except Exception:
+            logger.debug(
+                "final generic research delivery check failed",
+                exc_info=True,
+            )
+            GENERIC_RESEARCH_WITHHELD_RESPONSE = (
+                "Research response withheld: generic research final "
+                "validation failed."
+            )
+            _generic_delivery_passed = False
+            _generic_delivery = GENERIC_RESEARCH_WITHHELD_RESPONSE
+            _generic_reason = "validator_error"
+        if _generic_delivery_passed:
+            final_response = _generic_delivery
+            agent._response_was_previewed = False
+            _seal_current_turn_assistant(
+                final_response, "generic_research_verified"
+            )
+        elif not str(final_response or "").startswith(
+            "RESEARCH_RECEIPT_ERROR "
+        ):
+            final_response = _generic_delivery
+            failed = True
+            _turn_exit_reason = "generic_research_withheld"
+            # _generic_reason is computed by validate_generic_research_response
+            # and was then discarded, so a withheld turn recorded only THAT it
+            # was withheld and never why. Same pattern as four other sites.
+            logger.warning(
+                "Generic research delivery WITHHELD: reason=%s | response=%.300s",
+                _generic_reason,
+                str(_generic_delivery or ""),
+            )
+            agent._response_was_previewed = False
+            _seal_current_turn_assistant(
+                final_response, "generic_research_withheld"
+            )
+
+    if _research_output_immutable:
+        # This is deliberately before trajectory/session persistence and every
+        # plugin, memory, review, or gateway-facing result surface below.
+        _sanitize_controlled_research_history(
+            predispatch=_research_predispatch_provenance
+        )
+        if final_response:
+            _seal_current_turn_assistant(
+                final_response, str(_turn_exit_reason)
+            )
+
+    if _research_predispatch_provenance:
+        # Retry/status and stream bookkeeping are cross-turn surfaces. Never
+        # let buffered controlled-turn details flush during a later ordinary
+        # failure.
+        try:
+            agent._clear_status_buffer()

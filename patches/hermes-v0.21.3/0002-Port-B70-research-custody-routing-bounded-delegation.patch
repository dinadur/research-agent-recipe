+def research_background_dispatch_is_bound(
+    agent: Any, receipt: Mapping[str, Any] | None
+) -> bool:
+    """True only after the observer bound this exact research dispatch."""
+
+    if not isinstance(receipt, Mapping):
+        return False
+    expected_id = getattr(agent, "_parallel_research_pending_delegation_id", None)
+    activation = get_parallel_research_activation(agent)
+    contracts = getattr(agent, "_parallel_research_bound_artifacts", ())
+    paths = getattr(agent, "_parallel_research_bound_paths", ())
+    return bool(
+        activation is not None
+        and _is_top_level_research_parent(agent)
+        and getattr(agent, "_parallel_research_dispatch_succeeded", False) is True
+        and isinstance(expected_id, str)
+        and expected_id
+        and receipt.get("delegation_id") == expected_id
+        and isinstance(contracts, tuple)
+        and len(contracts) == 3
+        and all(isinstance(item, ResearchArtifactContract) for item in contracts)
+        and all(
+            item.validator_sha256 == activation.validator_sha256
+            and item.validator_bytes == activation.validator_bytes
+            and item.validator_path == activation.validator_path
+            and item.source_policy_id == activation.source_policy_id
+            for item in contracts
+        )
+        and isinstance(paths, tuple)
+        and len(paths) == 3
+        and len(set(paths)) == 3
+        and tuple(item.path for item in contracts) == paths
+    )
+
+
+def _research_completion_attestation_state_is_bound(agent: Any) -> bool:
+    """Recheck exact result-wave attestation authority after identity consume."""
+
+    contracts = getattr(agent, "_parallel_research_bound_artifacts", None)
+    bound_paths = getattr(agent, "_parallel_research_bound_paths", None)
+    attestations = getattr(
+        agent, "_parallel_research_completion_attestations", None
+    )
+    incoming_paths = getattr(
+        agent, "_parallel_research_completion_attestation_paths", None
+    )
+    if (
+        getattr(agent, "_parallel_research_completion_attestation_valid", False)
+        is not True
+        or not isinstance(contracts, tuple)
+        or len(contracts) != 3
+        or not all(isinstance(item, ResearchArtifactContract) for item in contracts)
+        or not isinstance(bound_paths, tuple)
+        or tuple(item.path for item in contracts) != bound_paths
+        or len(set(bound_paths)) != len(bound_paths)
+        or not isinstance(attestations, dict)
+        or set(attestations) != set(bound_paths)
+        or not isinstance(incoming_paths, tuple)
+    ):
+        return False
+
+    repair_count = getattr(agent, "_parallel_research_repair_dispatch_count", 0)
+    if repair_count == 0:
+        expected_incoming_paths = bound_paths
+    elif repair_count == 1:
+        prior = getattr(agent, "_parallel_research_raw_validation", None)
+        if (
+            not isinstance(prior, ResearchRawValidationState)
+            or prior.status != "repair_required"
+            or prior.contract_paths != bound_paths
+            or not prior.failing_paths
+            or len(set(prior.failing_paths)) != len(prior.failing_paths)
+            or not set(prior.failing_paths).issubset(bound_paths)
+        ):
+            return False
+        failing_paths = set(prior.failing_paths)
+        expected_incoming_paths = tuple(
+            path for path in bound_paths if path in failing_paths
+        )
+    else:
+        return False
+    if incoming_paths != expected_incoming_paths:
+        return False
+
+    for contract in contracts:
+        attestation = attestations.get(contract.path)
+        if (
+            not isinstance(attestation, dict)
+            or set(attestation) != _RESEARCH_COMPLETION_ATTESTATION_KEYS
+            or attestation.get("path") != contract.path
+            or attestation.get("validator_sha256") != contract.validator_sha256
+            or attestation.get("source_policy_id") != contract.source_policy_id
+            or type(attestation.get("passed")) is not bool
+            or type(attestation.get("terminal")) is not bool
+            or type(attestation.get("retryable")) is not bool
+        ):
+            return False
+        artifact_sha256 = attestation.get("artifact_sha256")
+        if (
+            not isinstance(artifact_sha256, str)
+            or len(artifact_sha256) != 64
+            or any(char not in "0123456789abcdef" for char in artifact_sha256)
+        ):
+            return False
+        path = Path(contract.path)
+        try:
+            if _path_contains_symlink(path):
+                return False
+            if _sha256_bytes(path.read_bytes()) != artifact_sha256:
+                return False
+        except OSError:
+            return False
+    return True
+
+
+def requires_parallel_research_route(user_message: Any) -> bool:
+    """Arm delegated research only on an explicit operator request.
+
+    Counts, comma-delimited lists, multiple requested sections, and requests
+    to save notes are not delegation authority.  They stay on the primary
+    model unless the operator explicitly asks for parallel/delegated research
+    or workers/subagents.
+    """
+
+    if not isinstance(user_message, str):
+        return False
+    from agent.product_route import requires_product_research_route
+    from agent.travel_route import requires_travel_publication_route
+
+    if requires_travel_publication_route(user_message) or requires_product_research_route(
+        user_message
+    ):
+        return False
+    text = " ".join(user_message.split())
+    if _async_delegation_batch_id(user_message) is not None:
+        return False
+    if not text or _RESEARCH_INTENT_RE.search(text) is None:
+        return False
+    return _EXPLICIT_PARALLEL_RESEARCH_RE.search(text) is not None
+
+
+def _bounded_operator_research_request(user_message: Any) -> str:
+    """Freeze bounded operator constraints without asking for child ceremony."""
+
+    if not isinstance(user_message, str):
+        return ""
+    normalized = user_message.replace("\x00", "").strip()
+    return normalized[:OPERATOR_RESEARCH_REQUEST_LIMIT]
+
+
+def research_source_policy_id(operator_request: Any) -> str:
+    """Derive the one controller-owned source policy from restrictive wording.
+
+    Ordinary mentions and preferences remain unrestricted.  The narrow policy
+    activates only when the operator explicitly limits the source set to
+    official Kubernetes documentation.
+    """
+
+    bounded = _bounded_operator_research_request(operator_request)
+    if not bounded:
+        return SOURCE_POLICY_UNRESTRICTED
+    normalized = " ".join(bounded.split()).casefold()
+    for pattern in _OFFICIAL_KUBERNETES_DOCS_RESTRICTIVE_RE:
+        for match in pattern.finditer(normalized):
+            prefix = normalized[max(0, match.start() - 40) : match.start()]
+            if re.search(
+                r"\b(?:do|does|did)\s+not(?:\s+\w+){0,3}\s*$|\bnot\s+$",
+                prefix,
+            ):
+                continue
+            return SOURCE_POLICY_OFFICIAL_KUBERNETES_DOCS
+    return SOURCE_POLICY_UNRESTRICTED
+
+
+def parallel_research_predispatch_phase(agent: Any) -> str | None:
+    """Return the exact current route phase whose model surface is restricted.
+
+    This authority is deliberately narrower than session-level activation: an
+    old activation cannot constrain an ordinary later turn, a contracted child
+    cannot inherit its parent's router, and result/repair turns use their own
+    post-dispatch gate.
+    """
+
+    current_turn_id = getattr(agent, "_current_turn_id", None)
+    if (
+        not _is_top_level_research_parent(agent)
+        or not isinstance(current_turn_id, str)
+        or not current_turn_id
+        or getattr(agent, "_parallel_research_route_required_turn_id", None)
+        != current_turn_id
+        or getattr(agent, "_parallel_research_post_dispatch_turn_id", None)
+        == current_turn_id
+        or getattr(agent, "_parallel_research_dispatch_succeeded", False) is True
+    ):
+        return None
+    activation = get_parallel_research_activation(agent)
+    if (
+        activation is not None
+        and getattr(agent, "_parallel_research_skill_view_turn_id", None)
+        == current_turn_id
+    ):
+        return "delegate_task"
+    return "skill_view"
+
+
+_PROVIDER_PHASE_INITIAL_SKILL = "initial_skill_view"
+_PROVIDER_PHASE_INITIAL_DISPATCH = "initial_delegate_task"
+_PROVIDER_PHASE_RESULT_READS = "result_read_file"
+_PROVIDER_PHASE_RESULT_REPAIR = "result_delegate_task"
+_PROVIDER_PHASE_RESULT_FINAL = "result_no_tools"
+
+
+def _parallel_research_result_paths(
+    agent: Any,
+) -> tuple[str, tuple[str, ...], Mapping[str, Any]] | None:
+    """Return exact current result-turn path authority, or fail closed."""
+
+    current_turn_id = getattr(agent, "_current_turn_id", None)
+    if (
+        not _is_top_level_research_parent(agent)
+        or not isinstance(current_turn_id, str)
+        or not current_turn_id
+        or getattr(agent, "_parallel_research_post_dispatch_turn_id", None)
+        != current_turn_id
+    ):
+        return None
+    raw_paths = getattr(agent, "_parallel_research_bound_paths", ())
+    if (
+        not isinstance(raw_paths, tuple)
+        or len(raw_paths) != 3
+        or not all(isinstance(path, str) and path for path in raw_paths)
+    ):
+        return None
+    bound_paths = tuple(posixpath.normpath(path) for path in raw_paths)
+    if len(set(bound_paths)) != len(bound_paths):
+        return None
+    receipts = getattr(agent, "_parallel_research_artifact_read_receipts", None)
+    if not isinstance(receipts, Mapping):
+        receipts = {}
+    return current_turn_id, bound_paths, receipts
+
+
+def _parallel_research_unread_paths(agent: Any) -> tuple[str, ...]:
+    authority = _parallel_research_result_paths(agent)
+    if authority is None:
+        return ()
+    current_turn_id, bound_paths, receipts = authority
+    return tuple(
+        path
+        for path in bound_paths
+        if not (
+            isinstance(receipts.get(path), Mapping)
+            and receipts[path].get("turn_id") == current_turn_id
+            and receipts[path].get("status") in {"read", "missing"}
+        )
+    )
+
+
+def _parallel_research_repair_contracts(
+    agent: Any,
+) -> tuple[ResearchArtifactContract, ...]:
+    authority = _parallel_research_result_paths(agent)
+    if authority is None:
+        return ()
+    current_turn_id, bound_paths, receipts = authority
+    state = _exact_parent_raw_validation(
+        agent,
+        current_turn_id=current_turn_id,
+        bound_path_tuple=bound_paths,
+        receipts=receipts,
+    )
+    if (
+        state is None
+        or state.status != "repair_required"
+        or getattr(agent, "_parallel_research_repair_dispatch_count", 0) != 0
+    ):
+        return ()
+    contracts = getattr(agent, "_parallel_research_bound_artifacts", None)
+    if (
+        not isinstance(contracts, tuple)
+        or len(contracts) != len(bound_paths)
+        or not all(isinstance(item, ResearchArtifactContract) for item in contracts)
+        or tuple(item.path for item in contracts) != bound_paths
+    ):
+        return ()
+    failing = set(state.failing_paths)
+    repairs = tuple(item for item in contracts if item.path in failing)
+    if len(repairs) != len(failing) or {item.path for item in repairs} != failing:
+        return ()
+    return repairs
+
+
+def parallel_research_provider_phase(agent: Any) -> str | None:
+    """Return the controller phase whose exact tool schema belongs on the wire."""
+
+    predispatch = parallel_research_predispatch_phase(agent)
+    if predispatch == "skill_view":
+        return _PROVIDER_PHASE_INITIAL_SKILL
+    if predispatch == "delegate_task":
+        return _PROVIDER_PHASE_INITIAL_DISPATCH
+    result_authority = _parallel_research_result_paths(agent)
+    if result_authority is None:
+        return None
+    if _parallel_research_unread_paths(agent):
+        return _PROVIDER_PHASE_RESULT_READS
+    if _parallel_research_repair_contracts(agent):
+        return _PROVIDER_PHASE_RESULT_REPAIR
+    # Once every exact read has a receipt, any non-repair state is text-only:
+    # passed state may synthesize, while blocked/stale/exhausted state is sealed
+    # by the final-text validator. Re-exposing generic tools would contradict
+    # the executor even though it would still reject them.
+    return _PROVIDER_PHASE_RESULT_FINAL
+
+
+def parallel_research_provider_tool_name(phase: str | None) -> str | None:
+    return {
+        _PROVIDER_PHASE_INITIAL_SKILL: "skill_view",
+        _PROVIDER_PHASE_INITIAL_DISPATCH: "delegate_task",
+        _PROVIDER_PHASE_RESULT_READS: "read_file",
+        _PROVIDER_PHASE_RESULT_REPAIR: "delegate_task",
+    }.get(phase)
+
+
+def filter_parallel_research_api_tools(agent: Any, tools: Any) -> Any:
+    """Return the exact request-local schema view for the controller phase."""
+
+    if not isinstance(tools, (list, tuple)):
+        return tools
+
+    def _schema_name(schema: Any) -> str:
+        if not isinstance(schema, Mapping):
+            return ""
+        function = schema.get("function")
+        if isinstance(function, Mapping):
+            name = function.get("name")
+        else:
+            name = schema.get("name")
+        return name if isinstance(name, str) else ""
+
+    from agent.product_route import (
+        product_research_allowed_tools,
+        product_research_route_active,
+    )
+    from agent.travel_route import (
+        TRAVEL_PUBLICATION_ALLOWED_TOOLS,
+        travel_publication_route_active,
+    )
+    from agent.generic_research_route import (
+        GENERIC_RESEARCH_ALLOWED_TOOLS,
+        generic_research_receipt_bound,
+        generic_research_route_active,
+    )
+
+    if travel_publication_route_active(agent):
+        # Request-local schema view mirrors the executor allowlist. Keep the
+        # cached agent's canonical tools untouched while making every travel
+        # turn, including approval turns, expose the same narrow capability.
+        return [
+            schema
+            for schema in tools
+            if _schema_name(schema) in TRAVEL_PUBLICATION_ALLOWED_TOOLS
+        ]
+    if generic_research_route_active(agent):
+        allowed = (
+            frozenset()
+            if generic_research_receipt_bound(agent)
+            else GENERIC_RESEARCH_ALLOWED_TOOLS
+        )
+        return [schema for schema in tools if _schema_name(schema) in allowed]
+    if product_research_route_active(agent):
+        allowed_product_tools = product_research_allowed_tools(agent)
+        return [
+            schema
+            for schema in tools
+            if _schema_name(schema) in allowed_product_tools
+        ]
+    if (
+        getattr(agent, "_parallel_research_terminal_quarantine_latched", False)
+        is True
+    ):
+        return [schema for schema in tools if _schema_name(schema) != "delegate_task"]
+
+    phase = parallel_research_provider_phase(agent)
+    if phase is None:
+        return tools
+    if phase == _PROVIDER_PHASE_RESULT_FINAL:
+        return []
+    tool_name = parallel_research_provider_tool_name(phase)
+    if tool_name is None:
+        return tools
+
+    # Never mutate ``agent.tools``: schema narrowing is model visibility only,
+    # not execution authority.  The ordinary delegate_task schema supports
+    # singleton calls, optional context, and configurable batch sizes.  During
+    # this controller-owned phase those advertised choices are invalid, so the
+    # request-local view must describe the exact contract the gate accepts.
+    selected = [schema for schema in tools if _schema_name(schema) == tool_name]
+    if phase == _PROVIDER_PHASE_INITIAL_SKILL:
+        return selected
+
+    if phase == _PROVIDER_PHASE_RESULT_READS:
+        unread_paths = _parallel_research_unread_paths(agent)
+        parameters = {
+            "type": "object",
+            "additionalProperties": False,
+            "properties": {
+                "path": {
+                    "type": "string",
+                    "enum": list(unread_paths),
+                    "description": "One unread controller-bound artifact path.",
+                },
+            },
+            "required": ["path"],
+        }
+        specialized: list[Any] = []
+        for schema in selected:
+            copied = copy.deepcopy(schema)
+            if not isinstance(copied, dict):
+                specialized.append(copied)
+                continue
+            function = copied.get("function")
+            target = function if isinstance(function, dict) else copied
+            target["description"] = (
+                "Read one exact unread bound research artifact. Distinct paths may "
+                "be called in parallel; each path is admitted once per result turn."
+            )
+            target["parameters"] = copy.deepcopy(parameters)
+            specialized.append(copied)
+        return specialized
+
+    repair_contracts = (
+        _parallel_research_repair_contracts(agent)
+        if phase == _PROVIDER_PHASE_RESULT_REPAIR
+        else ()
+    )
+    if phase == _PROVIDER_PHASE_RESULT_REPAIR:
+        if not repair_contracts:
+            return []
+        repair_tasks = [
+            {
+                "goal": (
+                    f"Repair the controller-bound {contract.subject} research "
+                    "artifact using the inherited operator source restrictions."
+                ),
+                "role": "leaf",
+                "research_artifact": {
+                    "subject": contract.subject,
+                    "path": contract.path,
+                    "fields": list(contract.fields),
+                },
+            }
+            for contract in repair_contracts
+        ]
+        parameters = {
+            "type": "object",
+            "additionalProperties": False,
+            "properties": {
+                "tasks": {
+                    "type": "array",
+                    "minItems": len(repair_contracts),
+                    "maxItems": len(repair_contracts),
+                    "uniqueItems": True,
+                    "description": (
+                        "Use the exact failing-subset task batch shown in the tool "
+                        "description; do not retain a passing leg."
+                    ),
+                    "items": {
+                        "type": "object",
+                        "enum": repair_tasks,
+                        "description": (
+                            "One exact controller-authored failing-leg task. With "
+                            "uniqueItems and an exact batch length, every listed "
+                            "failing leg appears exactly once."
+                        ),
+                    },
+                },
+                "background": {"type": "boolean", "enum": [True]},
+            },
+            "required": ["tasks", "background"],
+        }
+        exact_arguments = json.dumps(
+            {"tasks": repair_tasks, "background": True},
+            ensure_ascii=False,
+            separators=(",", ":"),
+        )
+        specialized: list[Any] = []
+        for schema in selected:
+            copied = copy.deepcopy(schema)
+            if not isinstance(copied, dict):
+                specialized.append(copied)
+                continue
+            function = copied.get("function")
+            target = function if isinstance(function, dict) else copied
+            target["description"] = (
+                "Dispatch the one controller-authorized repair wave. Use exactly "
+                f"these arguments: {exact_arguments}"
+            )
+            target["parameters"] = copy.deepcopy(parameters)
+            specialized.append(copied)
+        return specialized
+
+    activation = get_parallel_research_activation(agent)
+    artifact_root = (
+        activation.research_artifact_root
+        if activation is not None
+        and isinstance(activation.research_artifact_root, str)
+        and activation.research_artifact_root
+        else "<runtime_context.research_artifact_root>"
+    )
+    run_stamp = (
+        activation.research_run_stamp
+        if activation is not None
+        and isinstance(activation.research_run_stamp, str)
+        and activation.research_run_stamp
+        else "<runtime_context.research_run_stamp>"
+    )
+    parameters = {
+        "type": "object",
+        "additionalProperties": False,
+        "properties": {
+            "tasks": {
+                "type": "array",
+                "minItems": 3,
+                "maxItems": 3,
+                "description": (
+                    "Exactly three independent research leaves. Every item uses "
+                    "only goal, role, and research_artifact; do not add context."
+                ),
+                "items": {
+                    "type": "object",
+                    "additionalProperties": False,
+                    "properties": {
+                        "goal": {
+                            "type": "string",
+                            "minLength": 1,
+                            "description": (
+                                "A self-contained research goal that explicitly "
+                                "names the exact research_artifact.subject."
+                            ),
+                        },
+                        "role": {
+                            "type": "string",
+                            "enum": ["leaf"],
+                            "description": "The controlled research phase accepts leaf only.",
+                        },
+                        "research_artifact": {
+                            "type": "object",
+                            "additionalProperties": False,
+                            "properties": {
+                                "subject": {
+                                    "type": "string",
+                                    "minLength": 1,
+                                    "maxLength": 160,
+                                    "description": (
+                                        "Exact explicit entity or independent-leg label; "
+                                        "it must also appear in goal."
+                                    ),
+                                },
+                                "path": {
+                                    "type": "string",
+                                    "minLength": 1,
+                                    "description": (
+                                        "Absolute POSIX Markdown path with exact form "
+                                        f"{artifact_root}/<subject-slug>/{run_stamp}/"
+                                        "<subject-slug>.md."
+                                    ),
+                                },
+                                "fields": {
+                                    "type": "array",
+                                    "minItems": 1,
+                                    "maxItems": 64,
+                                    "uniqueItems": True,
+                                    "items": {
+                                        "type": "string",
+                                        "minLength": 1,
+                                        "maxLength": 120,
+                                    },
+                                    "description": "Every requested research field.",
+                                },
+                            },
+                            "required": ["subject", "path", "fields"],
+                        },
+                    },
+                    "required": ["goal", "role", "research_artifact"],
+                },
+            },
+            "background": {
+                "type": "boolean",
+                "enum": [True],
+                "description": "Must be true for this non-blocking research wave.",
+            },
+        },
+        "required": ["tasks", "background"],
+    }
+    specialized: list[Any] = []
+    for schema in selected:
+        copied = copy.deepcopy(schema)
+        if not isinstance(copied, dict):
+            specialized.append(copied)
+            continue
+        function = copied.get("function")
+        target = function if isinstance(function, dict) else copied
+        target["description"] = (
+            "Dispatch the one initial controlled research wave: exactly three "
+            "background leaf tasks with typed artifact contracts."
+        )
+        target["parameters"] = copy.deepcopy(parameters)
+        specialized.append(copied)
+    return specialized
+
+
+def parallel_research_predispatch_nudge(phase: str) -> str:
+    """Return the controller-owned one-call correction for ``phase``."""
+
+    if phase == "skill_view":
+        return (
+            "[System: The current explicit multi-leg research route has not "
+            "loaded its canonical skill. Reply with exactly one tool call and "
+            "no prose: skill_view with arguments "
+            '{"name":"parallel-research"}.]'
+        )
+    if phase == "delegate_task":
+        return (
+            "[System: The canonical parallel-research skill is active but its "
+            "background wave has not been dispatched. Reply with exactly one "
+            "typed delegate_task tool call and no prose. The call must be one "
+            "top-level background=true tasks batch containing exactly three "
+            "role='leaf' tasks with the exact research_artifact "
+            "subject/path/fields contracts from the loaded skill runtime "
+            "context.]"
+        )
+    raise ValueError(f"unknown parallel-research predispatch phase: {phase!r}")
+
+
+def arm_parallel_research_route_for_turn(
+    agent: Any,
+    user_message: Any,
+    turn_id: str,
+) -> bool:
+    """Arm skill-first admission for one explicit multi-leg research turn."""
+
+    if (
+        not _is_top_level_research_parent(agent)
+        or not isinstance(turn_id, str)
+        or not turn_id
+        or not requires_parallel_research_route(user_message)
+    ):
+        return False
+    pending_delegation_id = getattr(
+        agent, "_parallel_research_pending_delegation_id", None
+    )
+    if isinstance(pending_delegation_id, str) and pending_delegation_id:
+        # One research wave owns the session-local evidence authority until
+        # its trusted consolidated result is accepted or quarantined. Starting
+        # another wave would orphan the first ID/corpus and let its later
+        # payload fall through the ordinary text path.
+        agent._parallel_research_wave_conflict_turn_id = turn_id
+        agent._parallel_research_defer_streaming_for_turn = True
+        return True
+    clear_parallel_research_state(agent)
+    agent._parallel_research_operator_request = _bounded_operator_research_request(
+        user_message
+    )
+    canonical_tools: dict[str, Any] = {}
+    registered_tools = getattr(agent, "tools", None)
+    if isinstance(registered_tools, (list, tuple)):
+        for required_name in ("skill_view", "delegate_task", "read_file"):
+            matches = []
+            for schema in registered_tools:
+                if not isinstance(schema, Mapping):
+                    continue
+                function = schema.get("function")
+                if (
+                    isinstance(function, Mapping)
+                    and function.get("name") == required_name
+                ):
+                    matches.append(schema)
+            if len(matches) == 1:
+                canonical_tools[required_name] = copy.deepcopy(matches[0])
+    # Missing/duplicate entries intentionally remain absent. The terminal
+    # provider boundary rejects the snapshot before any observer or network
+    # call instead of falling back to a middleware-mutated same-name schema.
+    agent._parallel_research_canonical_tool_schemas = canonical_tools
+    agent._parallel_research_exception_guard_turn_id = turn_id
+    agent._parallel_research_route_required_turn_id = turn_id
+    agent._parallel_research_skill_view_turn_id = None
+    agent._parallel_research_validator_compatibility_error_turn_id = None
+    agent._parallel_research_validator_compatibility_error = None
+    agent._parallel_research_dispatch_succeeded = False
+    agent._parallel_research_repair_dispatch_count = 0
+    # Hide provider candidate text/reasoning from route admission onward. This
+    # is intentionally distinct from result-turn streaming deferral so the
+    # safe skill_view/delegate_task lifecycle stays visible to operators.
+    agent._parallel_research_defer_candidate_text_for_turn = True
+    _initialize_parallel_research_predispatch_decision_ledger(agent, turn_id)
+    return True
+
+
+def arm_parallel_research_post_dispatch_for_turn(
+    agent: Any,
+    user_message: Any,
+    turn_id: str,
+) -> bool:
+    """Restrict a synthetic research-result turn to reads and repair dispatch."""
+
+    delegation_ids = _async_delegation_batch_ids(user_message)
+    pending_delegation_id = getattr(
+        agent, "_parallel_research_pending_delegation_id", None
+    )
+    trusted_delegation_id = getattr(
+        agent, "_parallel_research_trusted_completion_id", None
+    )
+    if isinstance(trusted_delegation_id, str) and trusted_delegation_id:
+        # The controller-owned event metadata is the identity authority. The
+        # formatted text may be wrapped by timestamps, sender labels, reply
+        # context, or channel context before it reaches this prologue.
+        delegation_id = trusted_delegation_id
+    elif (
+        isinstance(pending_delegation_id, str)
+        and pending_delegation_id in delegation_ids
+    ):
+        delegation_id = pending_delegation_id
+    else:
+        delegation_id = delegation_ids[0] if delegation_ids else None
+    if (
+        not _is_top_level_research_parent(agent)
+        or delegation_id is None
+        or not isinstance(turn_id, str)
+        or not turn_id
+    ):
+        _consume_trusted_parallel_research_completion(agent, None)
+        return False
+    trusted_completion = _consume_trusted_parallel_research_completion(
+        agent, delegation_id
+    )
+    exact_pending_id = bool(
+        delegation_id
+        and isinstance(pending_delegation_id, str)
+        and delegation_id == pending_delegation_id
+    )
+    exact_bound_state = bool(
+        exact_pending_id
+        and research_background_dispatch_is_bound(
+            agent, {"delegation_id": delegation_id}
+        )
+    )
+    exact_attestation_state = bool(
+        trusted_completion
+        and _research_completion_attestation_state_is_bound(agent)
+    )
+    if not (trusted_completion and exact_bound_state and exact_attestation_state):
+        # A known pending ID with no trusted event is a spoof/replay; preserve
+        # the intact wave while withholding this turn. A trusted research
+        # event with absent/corrupt matching authority is terminally unsafe and
+        # clears only that state after the quarantine response is sealed.
+        if exact_pending_id or trusted_completion:
+            agent._parallel_research_quarantine_turn_id = turn_id
+            agent._parallel_research_quarantine_delegation_id = delegation_id
+            agent._parallel_research_quarantine_clear_state = bool(
+                trusted_completion
+                and (
+                    not isinstance(pending_delegation_id, str)
+                    or not pending_delegation_id
+                    or exact_pending_id
+                )
+            )
+            agent._parallel_research_defer_streaming_for_turn = True
+            return True
+        return False
+    agent._parallel_research_post_dispatch_turn_id = turn_id
+    agent._parallel_research_route_required_turn_id = None
+    agent._parallel_research_skill_view_turn_id = None
+    agent._parallel_research_artifact_read_receipts = {}
+    agent._parallel_research_pending_artifact_reads = {}
+    agent._parallel_research_raw_validation = None
+    # A candidate synthesis must not reach a surface before the controller's
+    # raw-artifact and source-corpus checks run at the no-tool response seam.
+    agent._parallel_research_defer_streaming_for_turn = True
+    return True
+

+from __future__ import annotations
+
+from datetime import datetime, timezone
+
+from agent.research_harness.product_contract import (
+    ProductAcquisitionRecord,
+    ProductIdentity,
+    ProductOffer,
+    evaluate_product_record,
+)
+
+
+NOW = datetime(2026, 7, 20, tzinfo=timezone.utc)
+
+
+def _identity(*, variant: str | None = "TOA-70NAS") -> ProductIdentity:
+    return ProductIdentity(
+        topic_id="toaster_oven",
+        canonical_product_id="toaster_oven:TO2",
+        brand="Cuisinart",
+        model_name="TOA-70NAS",
+        mpn="TOA-70NAS",
+        gtin=None,
+        variant=variant,
+        official_spec_url="https://www.cuisinart.com/toa-70nas",
+        source_family="cuisinart.com",
+        retrieved_at="2026-07-19T12:00:00+00:00",
+        evidence_sha256="a" * 64,
+    )
+
+
+def _offer(**overrides) -> ProductOffer:
+    values = {
+        "canonical_product_id": "toaster_oven:TO2",
+        "merchant": "Example Store",
+        "offer_id": "offer-123",
+        "offer_url": "https://shop.example.com/toa-70nas?sku=TOA-70NAS",
+        "price": 199.95,
+        "currency": "USD",
+        "availability": "in_stock",
+        "condition": "new",
+        "variant": "TOA-70NAS",
+        "retrieved_at": "2026-07-20T00:00:00+00:00",
+        "source_family": "example.com",
+        "evidence_sha256": "b" * 64,
+    }
+    values.update(overrides)
+    return ProductOffer(**values)
+
+
+def test_durable_mode_requires_identity_but_not_a_current_offer() -> None:
+    record = ProductAcquisitionRecord(1, _identity(), ())
+
+    verdict = evaluate_product_record(
+        record,
+        mode="durable_comparison",
+        now=NOW,
+    )
+
+    assert verdict.passed is True
+    assert verdict.errors == ()
+
+
+def test_buy_now_mode_accepts_one_exact_fresh_offer() -> None:
+    record = ProductAcquisitionRecord(1, _identity(), (_offer(),))
+
+    verdict = evaluate_product_record(
+        record,
+        mode="buy_now",
+        budget=250,
+        now=NOW,
+    )
+
+    assert verdict.passed is True
+
+
+def test_buy_now_mode_fails_closed_on_variant_condition_and_offer_id() -> None:
+    record = ProductAcquisitionRecord(
+        1,
+        _identity(),
+        (
+            _offer(
+                offer_id=None,
+                variant="TOA-70BKS",
+                condition="unknown",
+            ),
+        ),
+    )
+
+    verdict = evaluate_product_record(
+        record,
+        mode="buy_now",
+        budget=250,
+        now=NOW,
+    )
+
+    assert verdict.passed is False
+    assert set(verdict.errors) >= {
+        "offer_id_missing",
+        "offer_variant_mismatch",
+        "offer_condition_not_confirmed_new",
+    }
+
+
+def test_buy_now_mode_fails_closed_on_stale_or_over_budget_offer() -> None:
+    record = ProductAcquisitionRecord(
+        1,
+        _identity(),
+        (
+            _offer(
+                price=300,
+                retrieved_at="2026-06-01T00:00:00+00:00",
+            ),
+        ),
+    )
+
+    verdict = evaluate_product_record(
+        record,
+        mode="buy_now",
+        budget=250,
+        now=NOW,
+    )
+
+    assert set(verdict.errors) >= {"offer_over_budget", "offer_stale"}

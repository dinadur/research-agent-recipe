+    repeated = travel_output() + "\nBEGIN_TRAVEL_APPROVAL\nextra\nEND_TRAVEL_APPROVAL"
+    assert travel_research_approval_delivery(
+        [tool_call(command=travel_command(), timeout=900)],
+        [terminal_message(repeated)],
+    ) is None

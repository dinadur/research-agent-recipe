+def _async_delegation_batch_ids(user_message: Any) -> tuple[str, ...]:
+    if not isinstance(user_message, str):
+        return ()
+    delegation_ids: list[str] = []
+    for raw_line in user_message.splitlines():
+        match = _ASYNC_DELEGATION_BATCH_HEADER_RE.fullmatch(raw_line.strip())
+        if match is None:
+            continue
+        delegation_id = match.group(1).strip()
+        if delegation_id and delegation_id not in delegation_ids:
+            delegation_ids.append(delegation_id)
+    return tuple(delegation_ids)
+

+def _travel_route_is_controller_call(args: Mapping[str, Any] | None) -> bool:
+    if not isinstance(args, Mapping):
+        return False
+    command = args.get("command")
+    if not isinstance(command, str):
+        return False
+    try:
+        tokens = shlex.split(command, posix=True)
+    except ValueError:
+        return False
+    if (
+        len(tokens) == 4
+        and Path(tokens[0]).name in {"python", "python3"}
+        and tokens[1:3] == ["-m", TRAVEL_RUNNER_MODULE]
+        and Path(tokens[3]).suffix.casefold() == ".json"
+        and _absolute_path_under_travel_raw(tokens[3])
+    ):
+        return True
+    if len(tokens) < 2 or Path(tokens[1]).name != "run_hermes_travel_pipeline.py":
+        return False
+    try:
+        return Path(tokens[1]).expanduser().resolve() == _travel_script_allowlist()[
+            "run_hermes_travel_pipeline.py"
+        ]
+    except (KeyError, OSError, RuntimeError):
+        return False

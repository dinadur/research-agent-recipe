+def arm_product_research_session(
+    agent: Any,
+    current_message: Any,
+    conversation_history: Any = None,
+) -> bool:
+    """Latch the narrow product capability for one Hermes session.
+
+    Publication approvals rarely repeat the research request. Recovering from
+    the persisted transcript keeps the same capability after a gateway reload;
+    ``/new`` changes the session id and reset clears the in-memory latch.
+    """
+
+    session_id = str(getattr(agent, "session_id", "") or "")
+    latched = getattr(agent, "_product_research_route_session_latched", False) is True
+    latched_session_id = str(
+        getattr(agent, "_product_research_route_session_id", "") or ""
+    )
+    if latched and latched_session_id == session_id:
+        return True
+    if latched and latched_session_id != session_id:
+        agent._product_research_route_session_latched = False
+        agent._product_research_route_session_id = None
+
+    requested = requires_product_research_route(current_message)
+    recovered = _history_requests_product_research(conversation_history)
+    if requested or recovered:
+        agent._product_research_route_session_latched = True
+        agent._product_research_route_session_id = session_id
+        return True
+    return False
+
+
+def product_publication_approval_requested(user_message: Any) -> bool:
+    if not isinstance(user_message, str):
+        return False
+    text = " ".join(user_message.split())
+    return bool(
+        text
+        and _PUBLICATION_APPROVAL_RE.search(text)
+        and not _PUBLICATION_NEGATION_RE.search(text)
+    )

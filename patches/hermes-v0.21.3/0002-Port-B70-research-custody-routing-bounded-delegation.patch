new file mode 100644
index 000000000..4d55164ad
--- /dev/null
+++ b/agent/research_harness/product_bakeoff.py
@@ -0,0 +1,254 @@
+"""Normalize historical acquisition canaries into the product data contract."""
+
+from __future__ import annotations
+
+import argparse
+import json
+from collections import defaultdict
+from datetime import datetime, timezone
+from pathlib import Path
+from typing import Any, Mapping, Sequence
+from urllib.parse import urlparse
+
+from agent.research_harness.artifacts import atomic_write_json, load_json_object
+from agent.research_harness.product_contract import (
+    PRODUCT_CONTRACT_SCHEMA_VERSION,
+    ProductAcquisitionRecord,
+    ProductIdentity,
+    ProductOffer,
+    evaluate_product_record,
+    topic_passes,
+)
+
+
+def _text(value: Any) -> str | None:
+    return value.strip() if isinstance(value, str) and value.strip() else None
+
+
+def _source_family(url: str | None) -> str:
+    return (urlparse(url or "").hostname or "").casefold().removeprefix("www.")
+
+
+def _availability(value: Any) -> str:
+    normalized = str(value or "").casefold()
+    return "in_stock" if normalized.endswith("instock") or normalized == "in_stock" else "unknown"
+
+
+def _condition(value: Any) -> str:
+    normalized = str(value or "").casefold()
+    return "new" if normalized in {"new", "newcondition", "https://schema.org/newcondition"} else "unknown"
+
+
+def _identity_from_product(product: Mapping[str, Any]) -> ProductIdentity | None:
+    raw = product.get("selected_identity") or product.get("identity")
+    if not isinstance(raw, Mapping):
+        return None
+    topic_id = _text(product.get("topic_id"))
+    product_id = _text(product.get("product_id"))
+    brand = _text(product.get("brand"))
+    model = _text(product.get("model"))
+    url = _text(raw.get("url"))
+    retrieved_at = _text(raw.get("fetched_at") or raw.get("retrieved_at"))
+    digest = _text(raw.get("document_sha256") or raw.get("response_sha256"))
+    if not all((topic_id, product_id, brand, model, url, retrieved_at, digest)):
+        return None
+    return ProductIdentity(
+        topic_id=topic_id,
+        canonical_product_id=f"{topic_id}:{product_id}",
+        brand=brand,
+        model_name=model,
+        mpn=model,
+        gtin=None,
+        variant=_text(raw.get("matched_alias") or raw.get("sku")),
+        official_spec_url=url,
+        source_family=_source_family(url),
+        retrieved_at=retrieved_at,
+        evidence_sha256=digest,
+    )
+
+
+def _offer_from_product(
+    product: Mapping[str, Any],
+    identity: ProductIdentity,
+) -> ProductOffer | None:
+    raw = product.get("selected_offer") or product.get("offer")
+    if not isinstance(raw, Mapping):
+        return None
+    url = _text(raw.get("purchase_url") or raw.get("url"))
+    price = raw.get("price")
+    retrieved_at = _text(raw.get("fetched_at") or raw.get("retrieved_at"))
+    digest = _text(raw.get("document_sha256") or raw.get("response_sha256"))
+    if (
+        url is None
+        or not isinstance(price, (int, float))
+        or isinstance(price, bool)
+        or retrieved_at is None
+        or digest is None
+    ):
+        return None
+    return ProductOffer(
+        canonical_product_id=identity.canonical_product_id,
+        merchant=_source_family(url),
+        offer_id=_text(raw.get("offer_id") or raw.get("product_id")),
+        offer_url=url,
+        price=float(price),
+        currency=str(raw.get("currency") or "").upper(),
+        availability=_availability(raw.get("availability")),
+        condition=_condition(raw.get("condition")),
+        variant=_text(raw.get("matched_alias") or raw.get("sku")) or "",
+        retrieved_at=retrieved_at,
+        source_family=_source_family(url),
+        evidence_sha256=digest,
+    )
+
+
+def normalize_results(payload: Mapping[str, Any]) -> tuple[ProductAcquisitionRecord, ...]:
+    products = payload.get("products")
+    if not isinstance(products, list):
+        raise ValueError("acquisition results must contain a products array")
+    records: list[ProductAcquisitionRecord] = []
+    for product in products:
+        if not isinstance(product, Mapping):
+            continue
+        identity = _identity_from_product(product)
+        if identity is None:
+            continue
+        offer = _offer_from_product(product, identity)
+        records.append(
+            ProductAcquisitionRecord(
+                schema_version=PRODUCT_CONTRACT_SCHEMA_VERSION,
+                identity=identity,
+                offers=(offer,) if offer is not None else (),
+            )
+        )
+    return tuple(records)
+
+
+def evaluate_provider(
+    *,
+    provider: str,
+    results_path: Path,
+    now: datetime,
+    required_topics: int = 4,
+    required_products_per_topic: int = 2,
+) -> dict[str, Any]:
+    payload = load_json_object(results_path)
+    records = normalize_results(payload)
+    budgets = {
+        str(topic.get("topic_id")): topic.get("budget_usd")
+        for topic in payload.get("topics", [])
+        if isinstance(topic, Mapping) and isinstance(topic.get("topic_id"), str)
+    }
+    grouped: dict[str, list[ProductAcquisitionRecord]] = defaultdict(list)
+    for record in records:
+        grouped[record.identity.topic_id].append(record)
+
+    modes = {}
+    for mode in ("durable_comparison", "buy_now"):
+        topic_results = []
+        passed_topics = 0
+        for topic_id in sorted(budgets):
+            product_results = []
+            verdicts = []
+            for record in grouped.get(topic_id, []):
+                verdict = evaluate_product_record(
+                    record,
+                    mode=mode,  # type: ignore[arg-type]
+                    budget=budgets[topic_id],
+                    now=now,
+                )
+                verdicts.append(verdict)
+                product_results.append(
+                    {
+                        "canonical_product_id": record.identity.canonical_product_id,
+                        "passed": verdict.passed,
+                        "errors": list(verdict.errors),
+                    }
+                )
+            passed = topic_passes(
+                verdicts,
+                required_products=required_products_per_topic,
+            )
+            passed_topics += int(passed)
+            topic_results.append(
+                {
+                    "topic_id": topic_id,
+                    "passed": passed,
+                    "passing_products": sum(item.passed for item in verdicts),
+                    "required_products": required_products_per_topic,
+                    "products": product_results,
+                }
+            )
+        modes[mode] = {
+            "passed": passed_topics >= required_topics,
+            "passed_topics": passed_topics,
+            "required_topics": required_topics,
+            "topics": topic_results,
+        }
+    return {
+        "schema_version": 1,
+        "provider": provider,
+        "source": str(results_path.resolve()),
+        "evaluated_at": now.isoformat(),
+        "records_normalized": len(records),
+        "modes": modes,
+    }
+
+
+def build_parser() -> argparse.ArgumentParser:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument(
+        "--provider",
+        action="append",
+        nargs=2,
+        metavar=("NAME", "RESULTS_JSON"),
+        required=True,
+        help="Provider label and its acquisition results JSON; repeat as needed.",
+    )
+    parser.add_argument("--output", type=Path, required=True)
+    return parser
+
+
+def main(argv: Sequence[str] | None = None) -> int:
+    args = build_parser().parse_args(argv)
+    now = datetime.now(timezone.utc)
+    providers = [
+        evaluate_provider(provider=name, results_path=Path(path), now=now)
+        for name, path in args.provider
+    ]
+    output = {
+        "schema_version": 1,
+        "evaluated_at": now.isoformat(),
+        "acceptance": {
+            "required_topics": 4,
+            "topics_total": 5,
+            "required_products_per_topic": 2,
+            "buy_now_zero_tolerance": [
+                "product_identity",
+                "variant",
+                "condition",
+                "availability",
+                "offer_url",
+                "currency",
+            ],
+        },
+        "providers": providers,
+        "decision": {
+            "durable_comparison_viable": any(
+                item["modes"]["durable_comparison"]["passed"] for item in providers
+            ),
+            "buy_now_viable": any(
+                item["modes"]["buy_now"]["passed"] for item in providers
+            ),
+        },
+    }
+    atomic_write_json(args.output, output)
+    print(json.dumps(output["decision"], sort_keys=True))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
+
+
+__all__ = ["evaluate_provider", "main", "normalize_results"]
diff --git a/agent/research_harness/product_contract.py b/agent/research_harness/product_contract.py
new file mode 100644
index 000000000..4d532e46b
--- /dev/null
+++ b/agent/research_harness/product_contract.py
@@ -0,0 +1,221 @@
+"""Data-first identity and offer contract for product research."""
+
+from __future__ import annotations
+
+import re
+from dataclasses import asdict, dataclass
+from datetime import datetime, timezone
+from typing import Any, Literal, Mapping, Sequence
+from urllib.parse import urlparse
+
+
+PRODUCT_CONTRACT_SCHEMA_VERSION = 1
+PRODUCT_RESEARCH_MODES = frozenset({"durable_comparison", "buy_now"})
+_SAFE_ID_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$")
+_CURRENCY_RE = re.compile(r"^[A-Z]{3}$")
+_SHA256_RE = re.compile(r"^[0-9a-f]{64}$")
+
+
+def _https_url(value: Any) -> bool:
+    if not isinstance(value, str):
+        return False
+    parsed = urlparse(value)
+    return parsed.scheme == "https" and bool(parsed.hostname)
+
+
+def _timestamp(value: Any) -> datetime | None:
+    if not isinstance(value, str) or not value.strip():
+        return None
+    try:
+        parsed = datetime.fromisoformat(value.replace("Z", "+00:00"))
+    except ValueError:
+        return None
+    return parsed if parsed.tzinfo is not None else None
+
+
+@dataclass(frozen=True)
+class ProductIdentity:
+    topic_id: str
+    canonical_product_id: str
+    brand: str
+    model_name: str
+    mpn: str | None
+    gtin: str | None
+    variant: str | None
+    official_spec_url: str
+    source_family: str
+    retrieved_at: str
+    evidence_sha256: str
+
+
+@dataclass(frozen=True)
+class ProductOffer:
+    canonical_product_id: str
+    merchant: str
+    offer_id: str | None
+    offer_url: str
+    price: float
+    currency: str
+    availability: str
+    condition: str
+    variant: str
+    retrieved_at: str
+    source_family: str
+    evidence_sha256: str
+
+
+@dataclass(frozen=True)
+class ProductAcquisitionRecord:
+    schema_version: int
+    identity: ProductIdentity
+    offers: tuple[ProductOffer, ...]
+
+    def to_dict(self) -> dict[str, Any]:
+        return asdict(self)
+
+
+ProductMode = Literal["durable_comparison", "buy_now"]
+
+
+@dataclass(frozen=True)
+class ProductContractVerdict:
+    mode: ProductMode
+    passed: bool
+    errors: tuple[str, ...]
+
+    def to_dict(self) -> dict[str, Any]:
+        return asdict(self)
+
+
+def validate_identity(identity: ProductIdentity) -> list[str]:
+    errors: list[str] = []
+    if _SAFE_ID_RE.fullmatch(identity.topic_id) is None:
+        errors.append("topic_id_invalid")
+    if _SAFE_ID_RE.fullmatch(identity.canonical_product_id) is None:
+        errors.append("canonical_product_id_invalid")
+    if not identity.brand.strip():
+        errors.append("brand_missing")
+    if not identity.model_name.strip():
+        errors.append("model_name_missing")
+    if not (identity.mpn and identity.mpn.strip()) and not (
+        identity.gtin and identity.gtin.strip()
+    ):
+        errors.append("stable_product_identifier_missing")
+    if not _https_url(identity.official_spec_url):
+        errors.append("official_spec_url_invalid")
+    official_host = urlparse(identity.official_spec_url).hostname or ""
+    if not identity.source_family.strip() or not official_host.endswith(
+        identity.source_family.casefold()
+    ):
+        errors.append("official_source_family_mismatch")
+    if _timestamp(identity.retrieved_at) is None:
+        errors.append("identity_retrieved_at_invalid")
+    if _SHA256_RE.fullmatch(identity.evidence_sha256) is None:
+        errors.append("identity_evidence_sha256_invalid")
+    return errors
+
+
+def validate_offer(
+    identity: ProductIdentity,
+    offer: ProductOffer,
+    *,
+    budget: float | None,
+    now: datetime,
+    max_age_days: int,
+) -> list[str]:
+    errors: list[str] = []
+    if offer.canonical_product_id != identity.canonical_product_id:
+        errors.append("offer_product_identity_mismatch")
+    if not offer.merchant.strip():
+        errors.append("merchant_missing")
+    if not offer.offer_id or not offer.offer_id.strip():
+        errors.append("offer_id_missing")
+    if not _https_url(offer.offer_url):
+        errors.append("offer_url_invalid")
+    offer_host = urlparse(offer.offer_url).hostname or ""
+    if not offer.source_family.strip() or not offer_host.endswith(
+        offer.source_family.casefold()
+    ):
+        errors.append("offer_source_family_mismatch")
+    if not isinstance(offer.price, (int, float)) or isinstance(offer.price, bool) or offer.price <= 0:
+        errors.append("offer_price_invalid")
+    if budget is not None and offer.price > budget:
+        errors.append("offer_over_budget")
+    if _CURRENCY_RE.fullmatch(offer.currency) is None:
+        errors.append("offer_currency_invalid")
+    if offer.availability != "in_stock":
+        errors.append("offer_not_confirmed_in_stock")
+    if offer.condition != "new":
+        errors.append("offer_condition_not_confirmed_new")
+    if not identity.variant or offer.variant != identity.variant:
+        errors.append("offer_variant_mismatch")
+    retrieved_at = _timestamp(offer.retrieved_at)
+    if retrieved_at is None:
+        errors.append("offer_retrieved_at_invalid")
+    else:
+        age_seconds = (now - retrieved_at.astimezone(timezone.utc)).total_seconds()
+        if age_seconds < -300 or age_seconds > max_age_days * 86_400:
+            errors.append("offer_stale")
+    if _SHA256_RE.fullmatch(offer.evidence_sha256) is None:
+        errors.append("offer_evidence_sha256_invalid")
+    return errors
+
+
+def evaluate_product_record(
+    record: ProductAcquisitionRecord,
+    *,
+    mode: ProductMode,
+    budget: float | None = None,
+    now: datetime | None = None,
+    max_offer_age_days: int = 7,
+) -> ProductContractVerdict:
+    if record.schema_version != PRODUCT_CONTRACT_SCHEMA_VERSION:
+        return ProductContractVerdict(mode, False, ("schema_version_unsupported",))
+    if mode not in PRODUCT_RESEARCH_MODES:
+        return ProductContractVerdict(mode, False, ("product_mode_unsupported",))
+
+    errors = validate_identity(record.identity)
+    if mode == "durable_comparison":
+        return ProductContractVerdict(mode, not errors, tuple(errors))
+
+    if not record.offers:
+        errors.append("current_offer_missing")
+    else:
+        evaluated_at = now or datetime.now(timezone.utc)
+        offer_errors = [
+            validate_offer(
+                record.identity,
+                offer,
+                budget=budget,
+                now=evaluated_at,
+                max_age_days=max_offer_age_days,
+            )
+            for offer in record.offers
+        ]
+        if all(item for item in offer_errors):
+            errors.extend(
+                sorted({code for item in offer_errors for code in item})
+            )
+    return ProductContractVerdict(mode, not errors, tuple(errors))
+
+
+def topic_passes(
+    verdicts: Sequence[ProductContractVerdict],
+    *,
+    required_products: int = 2,
+) -> bool:
+    return sum(1 for verdict in verdicts if verdict.passed) >= required_products
+
+
+__all__ = [
+    "PRODUCT_CONTRACT_SCHEMA_VERSION",
+    "PRODUCT_RESEARCH_MODES",
+    "ProductAcquisitionRecord",
+    "ProductContractVerdict",
+    "ProductIdentity",
+    "ProductOffer",
+    "evaluate_product_record",
+    "topic_passes",
+    "validate_identity",
+    "validate_offer",
+]
diff --git a/agent/research_harness/protocol.py b/agent/research_harness/protocol.py
new file mode 100644
index 000000000..bd8cef77c
--- /dev/null
+++ b/agent/research_harness/protocol.py
@@ -0,0 +1,282 @@
+"""Fail-closed protocol objects for domain research runners."""
+
+from __future__ import annotations
+
+import os
+import re
+from dataclasses import asdict, dataclass
+from pathlib import Path
+from typing import Any, Literal, Mapping
+
+from agent.research_harness.artifacts import load_json_object
+
+
+DOMAIN_RUNNER_SCHEMA_VERSION = 1
+TRAVEL_DOMAIN = "travel"
+TRAVEL_RUN_RESULT_NAME = "domain-run-result.json"
+DEFAULT_OBSIDIAN_VAULT = "/opt/research-agent/wiki"
+
+_REQUEST_ID_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$")
+_REQUEST_FIELDS = frozenset(
+    {
+        "schema_version",
+        "domain",
+        "request_id",
+        "original_request",
+        "manifest_path",
+        "run_dir",
+    }
+)
+_CANONICAL_TRAVEL_TARGET_RE = re.compile(
+    r"(?<![A-Za-z0-9_-])travel[\\/](active|destinations)[\\/]"
+    r"([a-z0-9][a-z0-9-]*)[\\/]"
+    r"(overview|dining|activities|itinerary)\.md\b",
+    re.IGNORECASE,
+)
+
+
+def _canonical_travel_targets(value: str) -> set[tuple[str, str, str]]:
+    return {
+        tuple(part.casefold() for part in match.groups())
+        for match in _CANONICAL_TRAVEL_TARGET_RE.finditer(value)
+    }
+
+
+def _manifest_publication_target(
+    publication: Mapping[str, Any],
+) -> tuple[str, str, str] | None:
+    page = publication.get("page")
+    if isinstance(page, str):
+        embedded = _canonical_travel_targets(page)
+        if len(embedded) == 1:
+            return next(iter(embedded))
+        if len(embedded) > 1:
+            return None
+    owner_aliases = {
+        "trip": "active",
+        "current": "active",
+        "planning": "active",
+        "destination": "destinations",
+    }
+    owner = str(publication.get("owner") or "").strip().casefold()
+    owner = owner_aliases.get(owner, owner)
+    slug = str(publication.get("slug") or "").strip().casefold()
+    page_name = str(page or "").strip().casefold()
+    page_aliases = {
+        "guide": "overview",
+        "destination": "overview",
+        "restaurants": "dining",
+        "restaurant": "dining",
+        "attractions": "activities",
+        "attraction": "activities",
+    }
+    page_name = page_aliases.get(page_name, page_name)
+    if (
+        owner in {"active", "destinations"}
+        and re.fullmatch(r"[a-z0-9][a-z0-9-]*", slug)
+        and page_name in {"overview", "dining", "activities", "itinerary"}
+    ):
+        return owner, slug, page_name
+    return None
+
+
+def travel_raw_root() -> Path:
+    """Resolve the configured vault's controlled travel scratch root."""
+
+    vault = os.environ.get("OBSIDIAN_VAULT_PATH") or DEFAULT_OBSIDIAN_VAULT
+    return (Path(vault).expanduser() / "raw" / "travel").resolve()
+
+
+def _resolved_path_under(
+    value: Any,
+    *,
+    root: Path,
+    label: str,
+    must_exist: bool,
+) -> Path:
+    if not isinstance(value, str) or not value.strip():
+        raise ValueError(f"{label} must be a non-empty absolute path")
+    candidate = Path(value).expanduser()
+    if not candidate.is_absolute():
+        raise ValueError(f"{label} must be an absolute path")
+    try:
+        resolved = candidate.resolve(strict=must_exist)
+        resolved.relative_to(root.resolve())
+    except FileNotFoundError as exc:
+        raise ValueError(f"{label} does not exist: {candidate}") from exc
+    except (OSError, RuntimeError, ValueError) as exc:
+        raise ValueError(f"{label} must remain under {root}") from exc
+    return resolved
+
+
+@dataclass(frozen=True)
+class TravelRunRequest:
+    """Immutable request accepted by the travel runner."""
+
+    schema_version: int
+    domain: Literal["travel"]
+    request_id: str
+    original_request: str
+    manifest_path: Path
+    run_dir: Path
+
+    @classmethod
+    def from_mapping(
+        cls,
+        value: Mapping[str, Any],
+        *,
+        raw_root: Path | None = None,
+    ) -> "TravelRunRequest":
+        if not isinstance(value, Mapping):
+            raise ValueError("runner request must be a JSON object")
+        unknown = set(value) - _REQUEST_FIELDS
+        missing = _REQUEST_FIELDS - set(value)
+        if unknown:
+            raise ValueError(
+                "runner request contains unsupported field(s): "
+                + ", ".join(sorted(unknown))
+            )
+        if missing:
+            raise ValueError(
+                "runner request is missing required field(s): "
+                + ", ".join(sorted(missing))
+            )
+        if value.get("schema_version") != DOMAIN_RUNNER_SCHEMA_VERSION:
+            raise ValueError(
+                f"schema_version must be {DOMAIN_RUNNER_SCHEMA_VERSION}"
+            )
+        if value.get("domain") != TRAVEL_DOMAIN:
+            raise ValueError(f"domain must be {TRAVEL_DOMAIN!r}")
+        request_id = value.get("request_id")
+        if not isinstance(request_id, str) or _REQUEST_ID_RE.fullmatch(request_id) is None:
+            raise ValueError(
+                "request_id must be 1-128 safe alphanumeric, dot, dash, or underscore characters"
+            )
+        original_request = value.get("original_request")
+        if (
+            not isinstance(original_request, str)
+            or not original_request.strip()
+            or len(original_request) > 20_000
+        ):
+            raise ValueError("original_request must contain 1-20000 characters")
+
+        root = (raw_root or travel_raw_root()).resolve()
+        manifest_path = _resolved_path_under(
+            value.get("manifest_path"),
+            root=root,
+            label="manifest_path",
+            must_exist=True,
+        )
+        if not manifest_path.is_file() or manifest_path.suffix.casefold() != ".json":
+            raise ValueError("manifest_path must name an existing JSON file")
+        run_dir = _resolved_path_under(
+            value.get("run_dir"),
+            root=root,
+            label="run_dir",
+            must_exist=False,
+        )
+        if run_dir == root or run_dir == manifest_path.parent and manifest_path.parent == root:
+            raise ValueError("run_dir must be a dedicated child directory under raw/travel")
+        if run_dir.exists() and not run_dir.is_dir():
+            raise ValueError("run_dir must be a directory path")
+        try:
+            manifest_path.relative_to(run_dir)
+        except ValueError:
+            pass
+        else:
+            raise ValueError("manifest_path must be immutable input outside run_dir")
+        if run_dir.is_dir() and any(run_dir.iterdir()):
+            raise ValueError("run_dir must be new or empty")
+
+        manifest = load_json_object(manifest_path)
+        publication = manifest.get("publication")
+        if not isinstance(publication, dict) or not publication:
+            raise ValueError("manifest must contain a non-empty publication object")
+        requested_targets = _canonical_travel_targets(original_request)
+        if len(requested_targets) > 1:
+            raise ValueError(
+                "original_request contains multiple canonical travel targets"
+            )
+        if requested_targets:
+            requested_target = next(iter(requested_targets))
+            manifest_target = _manifest_publication_target(publication)
+            if manifest_target != requested_target:
+                requested_path = "travel/{}/{}/{}.md".format(*requested_target)
+                raise ValueError(
+                    "manifest publication does not match explicit canonical target "
+                    f"{requested_path}"
+                )
+
+        return cls(
+            schema_version=DOMAIN_RUNNER_SCHEMA_VERSION,
+            domain=TRAVEL_DOMAIN,
+            request_id=request_id,
+            original_request=original_request.strip(),
+            manifest_path=manifest_path,
+            run_dir=run_dir,
+        )
+
+    @classmethod
+    def from_file(
+        cls,
+        path: Path,
+        *,
+        raw_root: Path | None = None,
+    ) -> "TravelRunRequest":
+        root = (raw_root or travel_raw_root()).resolve()
+        request_path = _resolved_path_under(
+            str(path),
+            root=root,
+            label="request path",
+            must_exist=True,
+        )
+        if not request_path.is_file() or request_path.suffix.casefold() != ".json":
+            raise ValueError("request path must name an existing JSON file")
+        request = cls.from_mapping(load_json_object(request_path), raw_root=root)
+        try:
+            request_path.relative_to(request.run_dir)
+        except ValueError:
+            return request
+        raise ValueError("request path must remain outside run_dir")
+
+
+DomainRunStatus = Literal[
+    "ready_for_approval",
+    "withheld",
+    "failed",
+    "already_published",
+]
+
+
+@dataclass(frozen=True)
+class DomainRunResult:
+    """Stable machine result written by every domain runner."""
+
+    schema_version: int
+    domain: str
+    request_id: str
+    status: DomainRunStatus
+    manifest_path: str
+    run_dir: str
+    controller_exit_code: int | None
+    receipt_path: str | None
+    report_path: str | None
+    state_path: str | None
+    publication_result_path: str | None
+    controller_skill_version: str | None
+    controller_sha256: str | None
+    error: str | None
+
+    def to_dict(self) -> dict[str, Any]:
+        return asdict(self)
+
+
+__all__ = [
+    "DEFAULT_OBSIDIAN_VAULT",
+    "DOMAIN_RUNNER_SCHEMA_VERSION",
+    "DomainRunResult",
+    "TRAVEL_DOMAIN",
+    "TRAVEL_RUN_RESULT_NAME",
+    "TravelRunRequest",
+    "travel_raw_root",
+]

+    "most 2 calls), and the exact capture_receipt.py command prescribed by "
+    "the skill. Do not delegate, browse through terminal, or modify files. "
+    "The controller will capture the receipt automatically as soon as at least "
+    "two HTTPS pages have been extracted successfully. For primary-source "
+    "requests, use official project documentation and vendor-owned repositories; "
+    "use separate site-scoped searches for the upstream project and the "
+    "hardware or toolchain vendor. "
+    "do not use discussions, issues, community posts, or blogs as receipt "
+    "sources. "
+    "For an explicit comparison of two or three alternatives, allocate the "
+    "first search opportunity to each alternative and do not seal the receipt "
+    "until the extracted packet covers every alternative when retrieval budget "
+    "remains. "
+    "Cite only receipt-bound sources in the final answer. After the receipt is "
+    "bound, return one complete answer of at most 900 words. Use compact "
+    "sections or a table, and do not restart or repeat an earlier draft. Before "
+    "answering, reconcile every material numeric, zero-cost, no-fee, or "
+    "no-requirement claim against the extracted receipt text. The operator's "
+    "budget is a constraint, not evidence that an option meets it. When a hard "
+    "budget or recommendation rule requires an established total, do not infer "
+    "compliance from a floor, partial price, or total with required add-ons "
+    "still unknown; label it unverified and recommend none if the rule says so.]"
+)
+GENERIC_RESEARCH_WITHHELD_RESPONSE = (
+    "Research response withheld: this turn did not produce a valid current-turn "
+    "receipt with at least two successfully extracted sources, or the proposed "
+    "answer cited material outside that receipt."
+)
+GENERIC_RESEARCH_LENGTH_WITHHELD_RESPONSE = (
+    "Research response withheld: the receipt-bound final answer exceeded the "
+    "single-turn output limit. Partial or restarted drafts were not delivered."
+)
+GENERIC_RESEARCH_MAX_SEARCH_CALLS = 3
+GENERIC_RESEARCH_MAX_EXTRACT_CALLS = 2
+GENERIC_RESEARCH_FINALIZATION_MAX_TOKENS = 4096
+GENERIC_RESEARCH_EXACT_SOURCE_BUDGET_ENV = (
+    "HERMES_GENERIC_RESEARCH_EXACT_SOURCE_BUDGET_V1"
+)
+GENERIC_RESEARCH_ALLOWED_TOOLS = frozenset(
+    {"skill_view", "web_search", "web_extract", "terminal"}
+)
+
+_RESEARCH_INTENT_RE = re.compile(
+    r"\b(?:research|investigate|look\s+up|find\s+(?:current|recent|official)|"
+    r"current\s+best\s+practices?)\b",
+    re.IGNORECASE,
+)
+_SOURCE_INTENT_RE = re.compile(
+    r"\b(?:source|sources|cite|cited|citation|primary|official|current|recent|"
+    r"latest|web|online|documentation|docs)\b",
+    re.IGNORECASE,
+)
+_URL_RE = re.compile(r"https://[^\s<>\]\[)('\"`]+")
+_PRIMARY_SOURCE_REQUEST_RE = re.compile(
+    r"\b(?:primary|official)\s+(?:source|sources|documentation|docs)\b",
+    re.IGNORECASE,
+)
+_SECONDARY_HOST_TOKENS = (
+    "dev.to",
+    "medium.com",
+    "reddit.com",
+    "stackoverflow.com",
+    "stackexchange.com",
+    "readthedocs.io",
+)
+_NON_PRIMARY_GITHUB_PATH_RE = re.compile(
+    r"/(?:discussions|issues|pull|pulls)(?:/|$)", re.IGNORECASE
+)
+_MATERIAL_TERM_PATTERNS = {
+    "subscription": re.compile(r"\b(?:subscription|membership)s?\b", re.IGNORECASE),
+    "toll": re.compile(r"\btolls?\b", re.IGNORECASE),
+    "parking": re.compile(r"\bparking\b", re.IGNORECASE),
+    "baggage": re.compile(r"\b(?:baggage|bags?|luggage)\b", re.IGNORECASE),
+    "fee": re.compile(r"\b(?:fees?|charges?)\b", re.IGNORECASE),
+}
+_NEGATIVE_COST_RE = re.compile(
+    r"(?:\b(?:no|zero|without|free)\b|[$€£]\s*0(?:\.0+)?\b)",
+    re.IGNORECASE,
+)
+_UNCERTAINTY_RE = re.compile(
+    r"\b(?:unknown|unverified|unproven|not\s+established|not\s+verified|"
+    r"could\s+not\s+(?:establish|verify)|cannot\s+(?:establish|verify)|"
+    r"no\s+(?:date-specific|verified|established|complete)\s+(?:total\s+)?cost|"
+    r"no\s+evidence)\b",
+    re.IGNORECASE,
+)
+_HARD_BUDGET_RE = re.compile(
+    r"\bhard\b.{0,40}\bbudget\b|\bbudget\b.{0,40}\bhard\b",
+    re.IGNORECASE,
+)
+_ESTABLISHED_TOTAL_RULE_RE = re.compile(
+    r"\b(?:only\s+if|unless)\b.{0,140}"
+    r"\b(?:establish(?:es|ed)?|verif(?:y|ies|ied))\b.{0,80}"
+    r"\b(?:total|cost|price)\b",
+    re.IGNORECASE,
+)
+_PROBABILISTIC_BUDGET_RE = re.compile(
+    r"(?:\b(?:likely|probably|should|appears?|seems?|expect(?:ed)?)\b"
+    r".{0,100}\b(?:under|within|below|meet(?:s)?|clear(?:s)?|satisf(?:y|ies))\b"
+    r".{0,80}(?:\bbudget\b|[$€£]\s*\d)|"
+    r"(?:\bbudget\b|[$€£]\s*\d).{0,80}"
+    r"\b(?:likely|probably|should|appears?|seems?|expect(?:ed)?|"
+    r"satisfiable)\b)",
+    re.IGNORECASE,
+)
+_COMPARE_CLAUSE_RE = re.compile(
+    r"\bcompare\s+(?P<alternatives>[^.!?;]{3,240})",
+    re.IGNORECASE,
+)
+_COMPARISON_SPLIT_RE = re.compile(r",\s*(?:and\s+)?|\s+and\s+", re.IGNORECASE)
+_COMPARISON_QUALIFIER_RE = re.compile(
+    r"\s+\b(?:using|based\s+on|according\s+to|for|on)\b\s+",
+    re.IGNORECASE,
+)
+_CITATION_REFERENCE_RE = re.compile(r"\[(?P<number>[1-9][0-9]?)\]")
+_SUPPORT_TOKEN_RE = re.compile(r"[a-z0-9][a-z0-9'’-]{2,}", re.IGNORECASE)
+_SUPPORT_STOPWORDS = frozenset(
+    {
+        "about",
+        "after",
+        "also",
+        "and",
+        "are",
+        "before",
+        "both",
+        "but",
+        "current",
+        "does",
+        "for",
+        "from",
+        "has",
+        "have",
+        "its",
+        "not",
+        "page",
+        "retrieved",
+        "says",
+        "shown",
+        "source",
+        "that",
+        "the",
+        "their",
+        "this",
+        "two",
+        "using",
+        "with",
+    }
+)
+
+
+@dataclass(frozen=True)
+class GenericResearchSourceBudgetRejection:
+    code: str
+    message: str
+    terminal_failure: bool
+    retryable: bool
+
+
+def _configured_exact_source_budget() -> int:
+    """Enable the isolated exact-two experiment only on an explicit process."""
+
+    return (
+        2
+        if os.getenv(GENERIC_RESEARCH_EXACT_SOURCE_BUDGET_ENV, "").strip()
+        == "2"
+        else 0
+    )
+
+
+def _canonical_url(value: Any) -> str:
+    if not isinstance(value, str) or not value or len(value) > 4096:
+        return ""
+    try:
+        parts = urlsplit(value)
+    except ValueError:
+        return ""
+    if (
+        parts.scheme.casefold() != "https"
+        or not parts.hostname
+        or parts.username
+        or parts.password
+    ):
+        return ""
+    host = (parts.hostname or "").casefold()
+    port = parts.port
+    netloc = host if port in {None, 443} else f"{host}:{port}"
+    path = parts.path or "/"
+    if path != "/":
+        path = path.rstrip("/")
+    return urlunsplit(("https", netloc, path, parts.query, ""))
+
+
+def _material_windows(text: str, pattern: re.Pattern[str]) -> list[str]:
+    """Return bounded context windows around a material term."""
+
+    windows: list[str] = []
+    for match in pattern.finditer(text):
+        windows.append(text[max(0, match.start() - 100) : match.end() + 100])
+    return windows
+
+
+def _comparison_alternatives(prompt: str) -> tuple[str, ...]:
+    """Derive two or three explicit alternatives from a simple compare clause."""
+
+    if not isinstance(prompt, str):
+        return ()
+    match = _COMPARE_CLAUSE_RE.search(prompt)
+    if match is None:
+        return ()
+    clause = match.group("alternatives").strip()
+    qualifier = _COMPARISON_QUALIFIER_RE.search(clause)
+    if qualifier is not None:
+        clause = clause[: qualifier.start()].strip()
+    alternatives: list[str] = []
+    for value in _COMPARISON_SPLIT_RE.split(clause):
+        cleaned = re.sub(r"\s+", " ", value).strip(" ,:-")
+        cleaned = re.sub(r"^(?:the|an?)\s+", "", cleaned, flags=re.IGNORECASE)
+        if not cleaned or len(cleaned) > 80 or len(cleaned.split()) > 8:
+            return ()
+        alternatives.append(cleaned)
+    normalized = tuple(dict.fromkeys(alternatives))
+    return normalized if 2 <= len(normalized) <= 3 else ()
+
+
+def _comparison_search_query(prompt: str, alternative: str) -> str:
+    """Keep route/date context while making one alternative the search subject."""
+
+    match = _COMPARE_CLAUSE_RE.search(prompt)
+    context = prompt
+    if match is not None:
+        context = f"{prompt[:match.start()]} {prompt[match.end():]}"
+    context = re.sub(r"\s+", " ", context).strip(" .")
+    return f"{alternative} {context}"[:240].strip()
+
+
+def _set_tool_arguments(call: Any, arguments: Mapping[str, Any]) -> bool:
+    """Rewrite one tool call without changing its identity or other arguments."""
+
+    encoded = json.dumps(
+        dict(arguments), ensure_ascii=False, separators=(",", ":")
+    )
+    function = getattr(call, "function", None)
+    if function is not None:
+        function.arguments = encoded
+        return True
+    if isinstance(call, Mapping):
+        mapped_function = call.get("function")
+        if isinstance(mapped_function, dict):
+            mapped_function["arguments"] = encoded
+            return True
+    return False
+
+
+def _support_tokens(value: str) -> set[str]:
+    return {
+        token.casefold()
+        for token in _SUPPORT_TOKEN_RE.findall(str(value or ""))
+        if token.casefold() not in _SUPPORT_STOPWORDS
+        and not token.isdigit()
+    }
+
+
+def _numbered_citation_reconciliation_reason(
+    agent: Any, response: str
+) -> str | None:
+    """Bind every numbered claim to the same ordered receipt source."""
+
+    lines = [line.strip() for line in response.splitlines() if line.strip()]
+    body_lines = lines
+    source_lines: list[str] = []
+    for index, line in enumerate(lines):
+        if line.casefold() == "sources:":
+            body_lines = lines[:index]
+            source_lines = lines[index + 1 :]
+            break
+    referenced_lines = [
+        line for line in body_lines if _CITATION_REFERENCE_RE.search(line)
+    ]
+    if not referenced_lines:
+        return None
+    sources = tuple(
+        _canonical_url(value)
+        for value in getattr(agent, "_generic_research_receipt_sources", ())
+    )
+    if not sources or any(not source for source in sources):
+        return "citation_source_list_mismatch"
+    expected_source_lines = [
+        f"[{index}] {url}" for index, url in enumerate(sources, start=1)
+    ]
+    if source_lines != expected_source_lines:
+        return "citation_source_list_mismatch"
+    source_texts = getattr(agent, "_generic_research_receipt_source_texts", {})
+    if not isinstance(source_texts, Mapping):
+        return None
+    token_sets = [
+        _support_tokens(str(source_texts.get(source, "") or ""))
+        for source in sources
+    ]
+    for line in referenced_lines:
+        claim = _CITATION_REFERENCE_RE.sub(" ", line)
+        claim_tokens = _support_tokens(claim)
+        if len(claim_tokens) < 2:
+            continue
+        scores = [len(claim_tokens & tokens) for tokens in token_sets]
+        for match in _CITATION_REFERENCE_RE.finditer(line):
+            source_number = int(match.group("number"))
+            if source_number > len(scores):
+                return "citation_source_list_mismatch"
+            cited_score = scores[source_number - 1]
+            best_score = max(scores, default=0)
+            if best_score >= 3 and best_score - cited_score >= 2:
+                return "citation_source_mismatch"
+            if cited_score == 0 and best_score >= 2:
+                return "citation_source_mismatch"
+    return None
+
+
+def _repair_numbered_sources_section(agent: Any, response: str) -> str:
+    """Replace only the mechanical Sources block with receipt-owned ordering."""
+
+    sources = tuple(
+        _canonical_url(value)
+        for value in getattr(agent, "_generic_research_receipt_sources", ())
+    )
+    if not sources or any(not source for source in sources):
+        return response
+    lines = response.rstrip().splitlines()
+    body_lines = lines
+    for index, line in enumerate(lines):
+        if line.strip().casefold().startswith("sources:"):
+            body_lines = lines[:index]
+            break
+    body = "\n".join(body_lines).rstrip()
+    source_lines = "\n".join(
+        f"[{index}] {url}" for index, url in enumerate(sources, start=1)
+    )
+    if body:
+        return f"{body}\nSources:\n{source_lines}"
+    return f"Sources:\n{source_lines}"
+
+
+def _repair_numbered_claim_citations(agent: Any, response: str) -> str:
+    """Renumber only claims with one uniquely strongest receipt-text match."""
+
+    sources = tuple(
+        _canonical_url(value)
+        for value in getattr(agent, "_generic_research_receipt_sources", ())
+    )
+    source_texts = getattr(agent, "_generic_research_receipt_source_texts", {})
+    if (
+        not sources
+        or any(not source for source in sources)
+        or not isinstance(source_texts, Mapping)
+    ):
+        return response
+    token_sets = [
+        _support_tokens(str(source_texts.get(source, "") or ""))
+        for source in sources
+    ]
+    lines = response.splitlines()
+    repaired_lines: list[str] = []
+    in_sources = False
+    for line in lines:
+        if line.strip().casefold() == "sources:":
+            in_sources = True
+        if in_sources or _CITATION_REFERENCE_RE.search(line) is None:
+            repaired_lines.append(line)
+            continue
+        claim = _CITATION_REFERENCE_RE.sub(" ", line)
+        claim_tokens = _support_tokens(claim)
+        if len(claim_tokens) < 2:
+            repaired_lines.append(line)
+            continue
+        scores = [len(claim_tokens & tokens) for tokens in token_sets]
+        best_score = max(scores, default=0)
+        best_indexes = [
+            index for index, score in enumerate(scores, start=1) if score == best_score
+        ]
+        if len(best_indexes) != 1:
+            repaired_lines.append(line)
+            continue
+        best_index = best_indexes[0]
+
+        def _replace(match: re.Match[str]) -> str:
+            source_number = int(match.group("number"))
+            cited_score = scores[source_number - 1] if source_number <= len(scores) else 0
+            mismatched = (
+                best_score >= 3 and best_score - cited_score >= 2
+            ) or (cited_score == 0 and best_score >= 2)
+            return f"[{best_index}]" if mismatched else match.group(0)
+
+        repaired_lines.append(_CITATION_REFERENCE_RE.sub(_replace, line))
+    return "\n".join(repaired_lines)
+
+
+def _generic_research_reconciliation_reason(agent: Any, response: str) -> str | None:
+    """Find narrow, high-risk final claims that need one model correction.
+
+    This is deliberately not a general semantic fact checker. It protects the
+    two failure classes observed in live evaluation: unsupported material
+    absence/zero-cost claims, and probabilistic compliance claims where the
+    operator explicitly requires an established hard-budget total.
+    """
+
+    citation_reason = _numbered_citation_reconciliation_reason(agent, response)
+    if citation_reason is not None:
+        return citation_reason
+
+    source_texts = getattr(agent, "_generic_research_receipt_source_texts", {})
+    if not isinstance(source_texts, Mapping):
+        source_texts = {}
+    evidence = "\n".join(
+        value for value in source_texts.values() if isinstance(value, str)
+    )
+
+    for pattern in _MATERIAL_TERM_PATTERNS.values():
+        evidence_supports_absence = any(
+            _NEGATIVE_COST_RE.search(window)
+            for window in _material_windows(evidence, pattern)
+        )
+        for window in _material_windows(response, pattern):
+            response_claims_absence = _NEGATIVE_COST_RE.search(window) is not None
+            response_marks_unknown = _UNCERTAINTY_RE.search(window) is not None
+            if (
+                response_claims_absence
+                and not response_marks_unknown
+                and not evidence_supports_absence
+            ):
+                return "unsupported_material_absence_claim"
+            if response_marks_unknown and evidence_supports_absence:
+                return "receipt_evidence_not_reconciled"
+
+    prompt = str(getattr(agent, "_generic_research_operator_prompt", "") or "")
+    if (
+        _HARD_BUDGET_RE.search(prompt)
+        and _ESTABLISHED_TOTAL_RULE_RE.search(prompt)
+        and _PROBABILISTIC_BUDGET_RE.search(response)
+    ):
+        return "probabilistic_hard_budget_claim"
+    return None
+
+
+def requires_generic_research_route(user_message: Any) -> bool:
+    """Identify explicit single-topic web research that needs source custody."""
+
+    if not isinstance(user_message, str):
+        return False
+    text = " ".join(user_message.split())
+    if not text or not _RESEARCH_INTENT_RE.search(text):
+        return False
+
+    from agent.product_route import requires_product_research_route
+    from agent.research_contract import requires_parallel_research_route
+    from agent.travel_route import requires_travel_publication_route
+
+    if (
+        requires_product_research_route(text)
+        or requires_travel_publication_route(text)
+        or requires_parallel_research_route(text)
+    ):
+        return False
+    return _SOURCE_INTENT_RE.search(text) is not None
+
+
+def arm_generic_research_route_for_turn(
+    agent: Any, user_message: Any, turn_id: Any
+) -> bool:
+    if (
+        not isinstance(turn_id, str)
+        or not turn_id
+        or not requires_generic_research_route(user_message)
+    ):
+        return False
+    agent._generic_research_route_turn_id = turn_id
+    agent._generic_research_receipt_turn_id = None
+    agent._generic_research_receipt_sources = ()
+    agent._generic_research_receipt_source_texts = {}
+    agent._generic_research_controller_receipt_turn_id = None
+    agent._generic_research_receipt_ready_turn_id = None
+    agent._generic_research_search_call_count = 0
+    agent._generic_research_extract_call_count = 0
+    agent._generic_research_budget_lock = threading.Lock()
+    agent._generic_research_exact_source_budget = (
+        _configured_exact_source_budget()
+    )
+    agent._generic_research_requested_source_urls = ()
+    agent._generic_research_source_budget_rejections = 0
+    agent._generic_research_source_budget_closed_turn_id = None
+    agent._generic_research_primary_recovery_turn_id = None
+    agent._generic_research_operator_prompt = str(user_message)
+    agent._generic_research_comparison_alternatives = _comparison_alternatives(
+        str(user_message)
+    )
+    agent._generic_research_comparison_search_queries = {}
+    agent._generic_research_primary_sources_required = bool(
+        _PRIMARY_SOURCE_REQUEST_RE.search(str(user_message))
+    )
+    agent._parallel_research_defer_streaming_for_turn = True
+    return True
+
+
+def generic_research_route_active(agent: Any) -> bool:
+    turn_id = getattr(agent, "_current_turn_id", None)
+    return bool(
+        isinstance(turn_id, str)
+        and turn_id
+        and getattr(agent, "_generic_research_route_turn_id", None) == turn_id
+    )
+
+
+def generic_research_receipt_bound(agent: Any) -> bool:
+    turn_id = getattr(agent, "_current_turn_id", None)
+    return bool(
+        generic_research_route_active(agent)
+        and getattr(agent, "_generic_research_receipt_turn_id", None) == turn_id
+        and len(getattr(agent, "_generic_research_receipt_sources", ())) >= 2
+    )
+
+
+def generic_research_finalization_request_overrides(agent: Any) -> dict[str, Any]:
+    """Use a short visible-answer pass after the receipt is sealed.
+
+    Qwen thinking mode can spend the entire completion on private reasoning for
+    this synthesis shape and return no visible content. Retrieval retains the
+    production defaults; only the receipt-bound answer pass disables thinking.
+    """
+
+    if not generic_research_receipt_bound(agent):
+        return {}
+    return {
+        "max_tokens": GENERIC_RESEARCH_FINALIZATION_MAX_TOKENS,
+        "extra_body": {"chat_template_kwargs": {"enable_thinking": False}},
+    }
+
+
+def generic_research_source_budget_rejection(
+    agent: Any, tool_name: str, args: Mapping[str, Any] | None
+) -> GenericResearchSourceBudgetRejection | None:
+    """Reject an over-budget extraction before provider or network dispatch."""
+
+    if (
+        not generic_research_route_active(agent)
+        or tool_name != "web_extract"
+        or int(
+            getattr(agent, "_generic_research_exact_source_budget", 0) or 0
+        )
+        != 2
+    ):
+        return None
+
+    turn_id = getattr(agent, "_current_turn_id", None)
+    lock = getattr(agent, "_generic_research_budget_lock", None)
+    if lock is None:
+        lock = threading.Lock()
+        agent._generic_research_budget_lock = lock
+
+    with lock:
+        if (
+            getattr(
+                agent,
+                "_generic_research_source_budget_closed_turn_id",
+                None,
+            )
+            == turn_id
+        ):
+            return GenericResearchSourceBudgetRejection(
+                code="generic_research_source_budget_closed",
+                message=(
+                    "The exact-two source budget is closed because the one "
+                    "allowed correction retry was already rejected. No network "
+                    "request was sent."
+                ),
+                terminal_failure=True,
+                retryable=False,
+            )
+
+        requested = args.get("urls") if isinstance(args, Mapping) else None
+        if not isinstance(requested, list) or not requested:
+            return None
+
+        canonical = [_canonical_url(value) for value in requested]
+        prior = tuple(
+            getattr(agent, "_generic_research_requested_source_urls", ())
+            or ()
+        )
+        unique_requested = tuple(dict.fromkeys(canonical))
+        combined = tuple(dict.fromkeys((*prior, *unique_requested)))
+        malformed = (
+            any(not value for value in canonical)
+            or len(unique_requested) != len(canonical)
+        )
+        exceeds_budget = len(combined) > 2
+        if not malformed and not exceeds_budget:
+            agent._generic_research_requested_source_urls = combined
+            return None
+
+        rejection_count = int(
+            getattr(agent, "_generic_research_source_budget_rejections", 0)
+            or 0
+        )
+        if rejection_count == 0:
+            agent._generic_research_source_budget_rejections = 1
+            remaining = max(0, 2 - len(prior))
+            retry_instruction = (
+                "Retry exactly once with exactly two distinct HTTPS URLs "
+                "already returned by web_search."
+                if not prior
+                else (
+                    "Retry exactly once without exceeding the "
+                    f"{remaining} remaining distinct HTTPS URL slot(s)."
+                )
+            )
+            return GenericResearchSourceBudgetRejection(
+                code="generic_research_source_budget_retry",
+                message=(
+                    "The exact-two source controller rejected this web_extract "
+                    "call before network I/O because its URL list was malformed, "
+                    "duplicated, or would exceed two distinct source URLs total. "
+                    f"{retry_instruction} None of the rejected URLs were "
+                    "admitted, and no request was sent."
+                ),
+                terminal_failure=False,
+                retryable=True,
+            )
+
+        agent._generic_research_source_budget_rejections = (
+            rejection_count + 1
+        )
+        agent._generic_research_source_budget_closed_turn_id = turn_id
+        agent._generic_research_extract_call_count = (
+            GENERIC_RESEARCH_MAX_EXTRACT_CALLS
+        )
+        return GenericResearchSourceBudgetRejection(
+            code="generic_research_source_budget_retry_exhausted",
+            message=(
+                "The exact-two source controller rejected the second invalid "
+                "or over-budget web_extract call before network I/O. The one "
+                "allowed correction retry is exhausted, extraction is closed, "
+                "and no request was sent."
+            ),
+            terminal_failure=True,
+            retryable=False,
+        )
+
+
+def generic_research_tool_reason(
+    agent: Any, tool_name: str, args: Mapping[str, Any] | None
+) -> str | None:
+    """Return a rejection reason and reserve bounded retrieval calls."""
+
+    if not generic_research_route_active(agent):
+        return None
+    if generic_research_receipt_bound(agent):
+        return "The generic research receipt is already sealed; no further tools are allowed."
+    if tool_name not in GENERIC_RESEARCH_ALLOWED_TOOLS:
+        return (
+            "This bounded research turn permits only reliable-research skill_view, "
+            "web_search, web_extract, and the exact receipt helper."
+        )
+    if tool_name == "skill_view":
+        name = args.get("name") if isinstance(args, Mapping) else None
+        if name != "reliable-research":
+            return "Only skill_view(name='reliable-research') is allowed on this turn."
+        return None
+    if tool_name == "web_search":
+        lock = getattr(agent, "_generic_research_budget_lock", None)
+        if lock is None:
+            lock = threading.Lock()
+            agent._generic_research_budget_lock = lock
+        with lock:
+            count = int(
+                getattr(agent, "_generic_research_search_call_count", 0) or 0
+            )
+            if count >= GENERIC_RESEARCH_MAX_SEARCH_CALLS:
+                return (
+                    "The generic research search budget of "
+                    f"{GENERIC_RESEARCH_MAX_SEARCH_CALLS} calls is exhausted. Do not "
+                    "call web_search again - further calls are rejected, and repeating "
+                    "a rejected call ends this research turn with no answer delivered. "
+                    "Instead: extract from the most promising result you already hold, "
+                    "or if two sources are already receipted, seal the receipt and write "
+                    "the brief now. If what you hold does not support the question, say "
+                    "so explicitly and name what is missing."
+                )
+            agent._generic_research_search_call_count = count + 1
+        return None
+    if tool_name == "web_extract":
+        requested = args.get("urls") if isinstance(args, Mapping) else None
+        if not isinstance(requested, list) or not requested:
+            return (
+                "Generic research extraction requires at least one distinct "
+                "exact HTTPS URL returned by web_search in the current turn. "
+                "No network request was sent and the extraction budget was "
+                "not consumed."
+            )
+        lock = getattr(agent, "_generic_research_budget_lock", None)
+        if lock is None:
+            lock = threading.Lock()
+            agent._generic_research_budget_lock = lock
+        with lock:
+            count = int(
+                getattr(agent, "_generic_research_extract_call_count", 0) or 0
+            )
+            if count >= GENERIC_RESEARCH_MAX_EXTRACT_CALLS:
+                return (
+                    "The generic research extraction budget of "
+                    f"{GENERIC_RESEARCH_MAX_EXTRACT_CALLS} calls is exhausted. Do not "
+                    "call web_extract again - further calls are rejected, and repeating "
+                    "a rejected call ends this research turn with no answer delivered. "
+                    "Write the brief from the sources you have already receipted, and "
+                    "state explicitly any part of the question they do not support."
+                )
+            agent._generic_research_extract_call_count = count + 1
+        return None
+    if tool_name == "terminal":
+        if not isinstance(args, Mapping):
+            return "Generic research receipt arguments must be a JSON object."
+        if set(args) - {"command", "timeout", "background"}:
+            return (
+                "Generic research terminal accepts only command, timeout, and background."
+            )
+        if not generic_research_receipt_command_allowed(
+            args.get("command"),
+            expected_session_id=str(getattr(agent, "session_id", "") or ""),
+        ):
+            return "Generic research terminal permits only capture_receipt.py."
+        if args.get("timeout") != 30 or args.get("background") not in {None, False}:
+            return (
+                "Generic research receipt requires timeout=30 and foreground execution."
+            )
+        turn_id = getattr(agent, "_current_turn_id", None)
+        if getattr(agent, "_generic_research_receipt_ready_turn_id", None) != turn_id:
+            return (
+                "The generic research source packet is not receipt-ready; "
+                "continue bounded primary-source extraction."
+            )
+    return None
+
+
+def _tool_name(call: Any) -> str:
+    function = getattr(call, "function", None)
+    if function is not None:
+        return str(getattr(function, "name", "") or "")
+    if isinstance(call, Mapping):
+        function = call.get("function")
+        if isinstance(function, Mapping):
+            return str(function.get("name") or "")
+    return ""
+
+
+def _tool_arguments(call: Any) -> dict[str, Any] | None:
+    function = getattr(call, "function", None)
+    raw = getattr(function, "arguments", None) if function is not None else None
+    if isinstance(call, Mapping):
+        mapped_function = call.get("function")
+        if isinstance(mapped_function, Mapping):
+            raw = mapped_function.get("arguments")
+    if isinstance(raw, Mapping):
+        return dict(raw)
+    if not isinstance(raw, str):
+        return None
+    try:
+        parsed = json.loads(raw)
+    except json.JSONDecodeError:
+        return None
+    return parsed if isinstance(parsed, dict) else None
+
+
+def _primary_recovery_query(agent: Any) -> str:
+    prompt = str(getattr(agent, "_generic_research_operator_prompt", "") or "")
+    folded = prompt.casefold()
+    if "intel" in folded and "sycl" in folded:
+        return "site:github.com/intel/llvm SYCL Linux installation documentation"
+    subject = re.sub(r"\s+", " ", prompt).strip()
+    return f"official primary documentation {subject}"[:240]
+
+
+def normalize_generic_research_search_batch(
+    agent: Any, tool_calls: Any
+) -> tuple[list[Any], dict[str, Any] | None]:
+    """Allocate comparison searches, then preserve the Intel acceptance rule."""
+
+    calls = list(tool_calls) if isinstance(tool_calls, (list, tuple)) else []
+    prompt = str(getattr(agent, "_generic_research_operator_prompt", "") or "")
+    alternatives = tuple(
+        getattr(agent, "_generic_research_comparison_alternatives", ()) or ()
+    )
+    search_calls = [call for call in calls if _tool_name(call) == "web_search"]
+    start = int(getattr(agent, "_generic_research_search_call_count", 0) or 0)
+    if generic_research_route_active(agent) and alternatives and search_calls:
+        rewritten: list[dict[str, str]] = []
+        query_targets = dict(
+            getattr(agent, "_generic_research_comparison_search_queries", {})
+            or {}
+        )
+        for offset, call in enumerate(search_calls):
+            target_index = start + offset
+            if target_index >= len(alternatives):
+                break
+            arguments = _tool_arguments(call) or {}
+            query = _comparison_search_query(prompt, alternatives[target_index])
+            arguments["query"] = query
+            if not _set_tool_arguments(call, arguments):
+                continue
+            query_targets[query] = alternatives[target_index]
+            rewritten.append(
+                {
+                    "alternative": alternatives[target_index],
+                    "query": query,
+                }
+            )
+        if rewritten:
+            agent._generic_research_comparison_search_queries = query_targets
+            return calls, {
+                "mode": "comparison_alternative_search_allocation",
+                "alternatives": list(alternatives),
+                "rewritten": rewritten,
+            }
+    if not (
+        generic_research_route_active(agent)
+        and getattr(agent, "_generic_research_primary_sources_required", False)
+        is True
+        and "intel" in prompt.casefold()
+        and "sycl" in prompt.casefold()
+        and int(getattr(agent, "_generic_research_search_call_count", 0) or 0) == 0
+    ):
+        return calls, None
+    if not search_calls:
+        return calls, None
+    queries = [
+        str((_tool_arguments(call) or {}).get("query") or "").casefold()
+        for call in search_calls
+    ]
+    if any("github.com/intel/llvm" in query for query in queries):
+        return calls, None
+    target = search_calls[-1]
+    query = _primary_recovery_query(agent)
+    target.function.arguments = json.dumps(
+        {"query": query, "limit": 5},
+        ensure_ascii=False,
+        separators=(",", ":"),
+    )
+    return calls, {
+        "mode": "primary_query_reserved",
+        "query": query,
+        "search_calls": len(search_calls),
+    }
+
+
+def _generic_discovered_source_urls(messages: Any) -> list[str]:
+    discovered: list[str] = []
+    attempted: set[str] = set()
+    for message in _current_turn_messages(messages):
+        if message.get("role") != "tool":
+            continue
+        tool_name = message.get("name") or message.get("tool_name")
+        parsed = _payload(message.get("content"))
+        if tool_name == "web_extract":
+            for result in (parsed or {}).get("results") or []:
+                if isinstance(result, Mapping):
+                    canonical = _canonical_url(result.get("url"))
+                    if canonical:
+                        attempted.add(canonical)
+        elif tool_name == "web_search":
+            web = ((parsed or {}).get("data") or {}).get("web") or []
+            for result in web:
+                if not isinstance(result, Mapping):
+                    continue
+                canonical = _canonical_url(result.get("url"))
+                if canonical and canonical not in discovered:
+                    discovered.append(canonical)
+    candidates = [
+        url
+        for url in discovered
+        if url not in attempted and _primary_source_like(url)
+    ]
+    candidates.sort(
+        key=lambda url: (
+            "github.com/intel/llvm" not in url.casefold(),
+            "github.com/ggml-org/llama.cpp" not in url.casefold(),
+        )
+    )
+    return candidates
+
+
+def _generic_search_result_urls(messages: Any) -> tuple[str, ...]:
+    """Return exact canonical URLs discovered by current-turn web searches."""
+
+    discovered: list[str] = []
+    for message in _current_turn_messages(messages):
+        if message.get("role") != "tool":
+            continue
+        if (message.get("name") or message.get("tool_name")) != "web_search":
+            continue
+        web = ((_payload(message.get("content")) or {}).get("data") or {}).get(
+            "web"
+        ) or []
+        for result in web:
+            if not isinstance(result, Mapping):
+                continue
+            canonical = _canonical_url(result.get("url"))
+            if canonical and canonical not in discovered:
+                discovered.append(canonical)
+    return tuple(discovered)
+
+
+def normalize_generic_research_extract_batch(
+    agent: Any, tool_calls: Any, messages: Any = None
+) -> tuple[list[Any], dict[str, Any] | None]:
+    """Remove extraction URLs that current-turn search did not return.
+
+    Receipt custody already rejects unsearched URLs after extraction. Apply the
+    same exact-URL boundary before network I/O so one invented URL cannot poison
+    an otherwise valid mixed batch. An empty normalized batch is left in place
+    for ``generic_research_tool_reason`` to reject without consuming budget.
+    """
+
+    calls = list(tool_calls) if isinstance(tool_calls, (list, tuple)) else []
+    if not generic_research_route_active(agent):
+        return calls, None
+    search_urls = set(_generic_search_result_urls(messages))
+    rewrites: list[dict[str, int]] = []
+    for call in calls:
+        if _tool_name(call) != "web_extract":
+            continue
+        arguments = _tool_arguments(call)
+        requested = arguments.get("urls") if isinstance(arguments, Mapping) else None
+        if not isinstance(requested, list):
+            continue
+        retained: list[str] = []
+        seen: set[str] = set()
+        for value in requested:
+            canonical = _canonical_url(value)
+            if not canonical or canonical not in search_urls or canonical in seen:
+                continue
+            seen.add(canonical)
+            retained.append(canonical)
+        requested_canonical = [
+            canonical
+            for value in requested
+            if (canonical := _canonical_url(value))
+        ]
+        if retained == requested_canonical and len(retained) == len(requested):
+            continue
+        arguments["urls"] = retained
+        if not _set_tool_arguments(call, arguments):
+            continue
+        rewrites.append(
+            {
+                "requested_urls": len(requested),
+                "retained_search_urls": len(retained),
+                "dropped_urls": len(requested) - len(retained),
+            }
+        )
+    if not rewrites:
+        return calls, None
+    return calls, {
+        "mode": "current_turn_search_url_boundary",
+        "search_result_urls": len(search_urls),
+        "rewrites": rewrites,
+    }
+
+
+def apply_generic_research_primary_recovery(
+    agent: Any, tool_calls: Any, messages: Any = None
+) -> tuple[list[Any], dict[str, Any] | None]:
+    """Replace one all-secondary second extraction with a final official search.
+
+    An inaccessible first-party page can tempt a small local model to spend its
+    last extraction on a community mirror. Preserve that extraction slot by
+    turning the attempted mirror extraction into the last bounded official
+    search. The next model epoch can extract an exact returned URL.
+    """
+
+    calls = list(tool_calls) if isinstance(tool_calls, (list, tuple)) else []
+    turn_id = getattr(agent, "_current_turn_id", None)
+    if not (
+        generic_research_route_active(agent)
+        and getattr(agent, "_generic_research_primary_sources_required", False)
+        is True
+        and getattr(agent, "_generic_research_primary_recovery_turn_id", None)
+        != turn_id
+        and int(getattr(agent, "_generic_research_extract_call_count", 0) or 0)
+        == 1
+    ):
+        return calls, None
+    discovered_candidates = _generic_discovered_source_urls(messages)
+    for call in calls:
+        if _tool_name(call) != "web_extract":
+            continue
+        arguments = _tool_arguments(call)
+        requested = arguments.get("urls") if isinstance(arguments, Mapping) else None
+        urls = [
+            canonical
+            for value in requested or []
+            if (canonical := _canonical_url(value))
+        ]
+        if not urls:
+            continue
+        requested_admissible = [
+            url
+            for url in urls
+            if _primary_source_like(url)
+            and (messages is None or url in discovered_candidates)
+        ]
+        if requested_admissible:
+            continue
+        function = getattr(call, "function", None)
+        if function is None:
+            continue
+        if discovered_candidates:
+            replacement = discovered_candidates[0]
+            function.arguments = json.dumps(
+                {"urls": [replacement]},
+                ensure_ascii=False,
+                separators=(",", ":"),
+            )
+            agent._generic_research_primary_recovery_turn_id = turn_id
+            return calls, {
+                "mode": "official_url_replacement",
+                "replacement_url": replacement,
+                "replaced_urls": len(urls),
+            }
+        if (
+            int(getattr(agent, "_generic_research_search_call_count", 0) or 0)
+            >= GENERIC_RESEARCH_MAX_SEARCH_CALLS
+        ):
+            continue
+        query = _primary_recovery_query(agent)
+        function.name = "web_search"
+        function.arguments = json.dumps(
+            {"query": query, "limit": 5},
+            ensure_ascii=False,
+            separators=(",", ":"),
+        )
+        agent._generic_research_primary_recovery_turn_id = turn_id
+        return calls, {
+            "mode": "official_site_search",
+            "query": query,
+            "replaced_secondary_urls": len(urls),
+        }
+    return calls, None
+
+
+def _payload(value: Any) -> dict[str, Any] | None:
+    if not isinstance(value, str) or len(value) > 2_000_000:
+        return None
+    text = value.strip()
+    if text.startswith("<untrusted_tool_result"):
+        first_newline = text.find("\n")
+        end_marker = text.rfind("\n</untrusted_tool_result>")
+        if first_newline < 0 or end_marker <= first_newline:
+            return None
+        text = text[first_newline + 1 : end_marker]
+        object_start = text.find("{")
+        if object_start < 0:
+            return None
+        text = text[object_start:]
+    try:
+        parsed, consumed = json.JSONDecoder().raw_decode(text)
+    except json.JSONDecodeError:
+        return None
+    if text[consumed:].strip() or not isinstance(parsed, dict):
+        return None
+    return parsed
+
+
+def _current_turn_messages(messages: Any) -> list[Mapping[str, Any]]:
+    current: list[Mapping[str, Any]] = []
+    if not isinstance(messages, (list, tuple)):
+        return current
+    for message in reversed(messages):
+        if not isinstance(message, Mapping):
+            continue
+        if (
+            message.get("role") == "user"
+            and message.get("_generic_research_synthetic") is not True
+        ):
+            break
+        current.append(message)
+    current.reverse()
+    return current
+
+
+def _comparison_source_coverage(
+    agent: Any,
+    messages: Any,
+    sources: Mapping[str, str],
+) -> tuple[tuple[str, ...], tuple[str, ...], bool]:
+    """Bind extracted URLs back to the controller-allocated search target."""
+
+    alternatives = tuple(
+        getattr(agent, "_generic_research_comparison_alternatives", ()) or ()
+    )
+    query_targets = dict(
+        getattr(agent, "_generic_research_comparison_search_queries", {}) or {}
+    )
+    if not alternatives or not query_targets:
+        return alternatives, (), False
+    call_targets: dict[str, str] = {}
+    for message in _current_turn_messages(messages):
+        if message.get("role") != "assistant":
+            continue
+        raw_calls = message.get("tool_calls")
+        if isinstance(raw_calls, str):
+            try:
+                raw_calls = json.loads(raw_calls)
+            except json.JSONDecodeError:
+                raw_calls = []
+        for call in raw_calls or []:
+            if not isinstance(call, Mapping) or _tool_name(call) != "web_search":
+                continue
+            call_id = str(call.get("id") or "")
+            query = str((_tool_arguments(call) or {}).get("query") or "")
+            target = query_targets.get(query)
+            if call_id and target:
+                call_targets[call_id] = target
+    discovered_by_target: dict[str, set[str]] = {
+        alternative: set() for alternative in alternatives
+    }
+    observed = False
+    for message in _current_turn_messages(messages):
+        if message.get("role") != "tool":
+            continue
+        if (message.get("name") or message.get("tool_name")) != "web_search":
+            continue
+        target = call_targets.get(str(message.get("tool_call_id") or ""))
+        if target not in discovered_by_target:
+            continue
+        observed = True
+        web = ((_payload(message.get("content")) or {}).get("data") or {}).get(
+            "web"
+        ) or []
+        for result in web:
+            if not isinstance(result, Mapping):
+                continue
+            canonical = _canonical_url(result.get("url"))
+            if canonical:
+                discovered_by_target[target].add(canonical)
+    source_urls = {
+        canonical
+        for value in sources
+        if (canonical := _canonical_url(value))
+    }
+    covered = tuple(
+        alternative
+        for alternative in alternatives
+        if source_urls & discovered_by_target[alternative]
+    )
+    missing = tuple(
+        alternative for alternative in alternatives if alternative not in covered
+    )
+    return covered, missing, observed
+
+
+def generic_research_source_texts(
+    messages: Any, raw_sources: Any = None
+) -> dict[str, str]:
+    allowlist = None
+    if isinstance(raw_sources, (list, tuple)):
+        allowlist = {
+            canonical
+            for value in raw_sources
+            if (canonical := _canonical_url(value))
+        }
+    recovered: dict[str, str] = {}
+    for message in _current_turn_messages(messages):
+        if message.get("role") != "tool":
+            continue
+        if (message.get("name") or message.get("tool_name")) != "web_extract":
+            continue
+        payload = _payload(message.get("content"))
+        results = payload.get("results") if isinstance(payload, Mapping) else None
+        if not isinstance(results, list):
+            continue
+        for result in results:
+            if not isinstance(result, Mapping) or result.get("error"):
+                continue
+            canonical = _canonical_url(result.get("url"))
+            content = result.get("content")
+            if (
+                canonical
+                and isinstance(content, str)
+                and content.strip()
+                and (allowlist is None or canonical in allowlist)
+            ):
+                recovered[canonical] = content
+    return recovered
+
+
+def _primary_source_like(url: str) -> bool:
+    canonical = _canonical_url(url)
+    if not canonical:
+        return False
+    parts = urlsplit(canonical)
+    host = (parts.hostname or "").casefold().removeprefix("www.")
+    if any(token in host for token in _SECONDARY_HOST_TOKENS):
+        return False
+    if host == "github.com" and _NON_PRIMARY_GITHUB_PATH_RE.search(parts.path):
+        return False
+    return True
+
+
+def prepare_generic_research_controller_receipt(
+    agent: Any, tool_calls: Any, messages: Any
+) -> tuple[dict[str, Any] | None, dict[str, Any] | None]:
+    calls = list(tool_calls) if isinstance(tool_calls, (list, tuple)) else []
+    turn_id = getattr(agent, "_current_turn_id", None)
+    if not (
+        generic_research_route_active(agent)
+        and getattr(agent, "api_mode", "chat_completions") == "chat_completions"
+        and getattr(agent, "_generic_research_receipt_turn_id", None) != turn_id
+        and getattr(agent, "_generic_research_controller_receipt_turn_id", None)
+        != turn_id
+        and any(_tool_name(call) == "web_extract" for call in calls)
+    ):
+        return None, None
+    sources = generic_research_source_texts(messages)
+    primary_required = (
+        getattr(agent, "_generic_research_primary_sources_required", False) is True
+    )
+    admissible_sources = {
+        url: content
+        for url, content in sources.items()
+        if not primary_required or _primary_source_like(url)
+    }
+    covered, missing, comparison_provenance_observed = (
+        _comparison_source_coverage(
+            agent,
+            messages,
+            admissible_sources,
+        )
+    )
+    extract_count = int(
+        getattr(agent, "_generic_research_extract_call_count", 0) or 0
+    )
+    if (
+        comparison_provenance_observed
+        and missing
+        and extract_count < GENERIC_RESEARCH_MAX_EXTRACT_CALLS
+    ):
+        return None, {
+            "mode": "generic_controller_comparison_coverage_not_ready",
+            "successful_sources": len(sources),
+            "admissible_sources": len(admissible_sources),
+            "covered_alternatives": list(covered),
+            "missing_alternatives": list(missing),
+            "nudge": (
+                "[System: The comparison receipt is not ready. Use the remaining "
+                "web_extract call on one exact HTTPS result URL already returned "
+                "by each allocated search for: "
+                f"{', '.join(missing)}. Do not search again, repeat a covered "
+                "alternative, or spend the remaining extraction on a secondary "
+                "criterion. After that extraction, seal the receipt and clearly "
+                "label any still-missing evidence.]"
+            ),
+        }
+    if len(admissible_sources) < 2:
+        nudge = None
+        if extract_count < GENERIC_RESEARCH_MAX_EXTRACT_CALLS:
+            recovery_query = _primary_recovery_query(agent)
+            if primary_required:
+                search_count = int(
+                    getattr(agent, "_generic_research_search_call_count", 0) or 0
+                )
+                if search_count < GENERIC_RESEARCH_MAX_SEARCH_CALLS:
+                    nudge = (
+                        "[System: The generic research receipt is not ready. Use "
+                        f"the remaining web_search with this exact query: "
+                        f"{recovery_query!r}. Then use the remaining web_extract "
+                        "call on an exact official URL it returns. Do not choose "
+                        "discussions, issues, community posts, mirrors, or blogs.]"
+                    )
+                else:
+                    nudge = (
+                        "[System: The generic research receipt is not ready. Use "
+                        "the remaining web_extract call on an exact official "
+                        "project or vendor-repository URL already returned by "
+                        "search. Do not search again or choose discussions, "
+                        "issues, community posts, mirrors, or blogs.]"
+                    )
+            else:
+                nudge = (
+                    "[System: The generic research receipt is not ready. Use the "
+                    "remaining web_extract call for exact HTTPS URLs already "
+                    "returned by search.]"
+                )
+        return None, {
+            "mode": "generic_controller_receipt_not_ready",
+            "successful_sources": len(sources),
+            "admissible_sources": len(admissible_sources),
+            "nudge": nudge,
+        }
+    command = bound_generic_research_receipt_command(agent.session_id)
+    agent._generic_research_controller_receipt_turn_id = turn_id
+    agent._generic_research_receipt_ready_turn_id = turn_id
+    return (
+        {"command": command, "timeout": 30},
+        {
+            "mode": "generic_controller_auto_receipt",
+            "successful_sources": len(sources),
+        },
+    )
+
+
+def bind_generic_research_receipt(
+    agent: Any, sources: Any, messages: Any
+) -> bool:
+    turn_id = getattr(agent, "_current_turn_id", None)
+    if (
+        not generic_research_route_active(agent)
+        or not isinstance(sources, (list, tuple))
+        or len(sources) < 2
+    ):
+        return False
+    source_texts = generic_research_source_texts(messages, sources)
+    primary_required = (
+        getattr(agent, "_generic_research_primary_sources_required", False) is True
+    )
+    canonical_sources = tuple(
+        canonical
+        for value in sources
+        if (
+            (canonical := _canonical_url(value)) in source_texts
+            and (not primary_required or _primary_source_like(canonical))
+        )
+    )
+    if len(set(canonical_sources)) < 2:
+        return False
+    agent._generic_research_receipt_turn_id = turn_id
+    agent._generic_research_receipt_sources = tuple(dict.fromkeys(canonical_sources))
+    agent._generic_research_receipt_source_texts = source_texts
+    return True
+
+
+def validate_generic_research_response(
+    agent: Any, response: Any
+) -> tuple[bool, str, str]:
+    text = str(response or "").strip()
+    if not generic_research_route_active(agent):
+        return True, text, "not_generic_research_route"
+    if text == GENERIC_RESEARCH_LENGTH_WITHHELD_RESPONSE:
+        return False, text, "finalization_length_exhausted"
+    if not generic_research_receipt_bound(agent):
+        return False, GENERIC_RESEARCH_WITHHELD_RESPONSE, "receipt_missing"
+    allowlist = {
+        _canonical_url(value)
+        for value in getattr(agent, "_generic_research_receipt_sources", ())
+    }
+    cited = {
+        canonical
+        for value in _URL_RE.findall(text)
+        if (canonical := _canonical_url(value))
+    }
+    if len(cited) < 2:
+        return False, GENERIC_RESEARCH_WITHHELD_RESPONSE, "citations_missing"
+    if not cited.issubset(allowlist):
+        return False, GENERIC_RESEARCH_WITHHELD_RESPONSE, "citation_outside_receipt"
+    reconciliation_reason = _generic_research_reconciliation_reason(agent, text)
+    repaired = text
+    repair_label = "verified"
+    if reconciliation_reason == "citation_source_list_mismatch":
+        repaired = _repair_numbered_sources_section(agent, repaired)
+        repair_label = "verified_source_list_repaired"
+        reconciliation_reason = _generic_research_reconciliation_reason(agent, repaired)
+    if reconciliation_reason == "citation_source_mismatch":
+        repaired = _repair_numbered_claim_citations(agent, repaired)
+        repair_label = "verified_citation_mapping_repaired"
+        reconciliation_reason = _generic_research_reconciliation_reason(agent, repaired)
+    if reconciliation_reason is None and repaired != text:
+        return True, repaired, repair_label
+    if reconciliation_reason is not None:
+        return False, GENERIC_RESEARCH_WITHHELD_RESPONSE, reconciliation_reason
+    return True, text, "verified"
+
+
+def generic_research_finalization_nudge(reason: str, agent: Any) -> str:
+    sources = tuple(getattr(agent, "_generic_research_receipt_sources", ()))
+    if len(sources) < 2:
+        return (
+            "[System: Your proposed answer was withheld because the bounded "
+            "single-topic research route has no valid two-source receipt yet. "
+            "Continue the reliable-research workflow now using only the remaining "
+            "web_search/web_extract budget. Extract at least two exact HTTPS pages. "
+            "Do not use terminal for browsing, delegate, modify files, or provide "
+            "uncited prose. The controller will capture the receipt automatically "
+            "when the source packet is ready.]"
+        )
+    source_lines = "\n".join(
+        f"[{index}] {url}" for index, url in enumerate(sources, start=1)
+    )
+    reconciliation = ""
+    if reason in {
+        "unsupported_material_absence_claim",
+        "receipt_evidence_not_reconciled",
+        "probabilistic_hard_budget_claim",
+        "citation_source_list_mismatch",
+        "citation_source_mismatch",
+    }:
+        reconciliation = (
+            " Audit the receipt text claim by claim before rewriting. Delete or "
+            "label unknown every numeric zero-cost, no-fee, or no-requirement "
+            "claim that the extracted text does not state. Conversely, do not "
+            "call a constraint unproven when the receipt text directly supports "
+            "it. Treat any operator-supplied budget as a threshold, not evidence "
+            "of compliance. If a hard-budget rule requires an established total, "
+            "a floor, partial price, or price with required add-ons unknown does "
+            "not establish compliance; do not describe it as likely under budget. "
+            "For every factual line, use the number of the page that materially "
+            "supports that exact claim; do not attach a station-page number to a "
+            "policy claim or a policy-page number to a service claim."
+        )
+    return (
+        "[System: Your proposed research answer was withheld by the controller "
+        f"({reason}). Return one complete answer of at most 900 words using only "
+        "the extracted content. Start the answer from scratch; do not continue, "
+        "repeat, or quote any rejected draft. "
+        f"from the {len(sources)} receipt-bound pages below. The ONLY URL strings "
+        f"permitted anywhere in the reply are the {len(sources)} exact URLs below. "
+        "Copy every numbered source line verbatim and in the same order in a "
+        "final Sources section; use the matching [n] after each factual line "
+        "instead of inline links. Do not mention, name, or link any "
+        "other search result, host, article, discussion, community post, or "
+        f"mirror. Do not call tools.{reconciliation}]\n"
+        f"{source_lines}"
+    )
+
+
+__all__ = [
+    "GENERIC_RESEARCH_ALLOWED_TOOLS",
+    "GENERIC_RESEARCH_EXACT_SOURCE_BUDGET_ENV",
+    "GENERIC_RESEARCH_FINALIZATION_MAX_TOKENS",
+    "GENERIC_RESEARCH_LENGTH_WITHHELD_RESPONSE",
+    "GENERIC_RESEARCH_MAX_EXTRACT_CALLS",
+    "GENERIC_RESEARCH_MAX_SEARCH_CALLS",
+    "GENERIC_RESEARCH_ROUTE_NOTE",
+    "GENERIC_RESEARCH_WITHHELD_RESPONSE",
+    "apply_generic_research_primary_recovery",
+    "arm_generic_research_route_for_turn",
+    "bind_generic_research_receipt",
+    "generic_research_finalization_nudge",
+    "generic_research_finalization_request_overrides",
+    "generic_research_receipt_bound",
+    "generic_research_route_active",
+    "generic_research_source_budget_rejection",
+    "generic_research_source_texts",
+    "generic_research_tool_reason",
+    "normalize_generic_research_extract_batch",
+    "normalize_generic_research_search_batch",
+    "prepare_generic_research_controller_receipt",
+    "requires_generic_research_route",
+    "validate_generic_research_response",
+]

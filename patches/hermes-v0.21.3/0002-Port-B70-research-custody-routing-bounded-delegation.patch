+def _bind_catalog(agent, messages):
+    sources, source_texts = _catalog_sources()
+    agent._product_research_receipt_turn_id = "turn-1"
+    agent._product_research_receipt_sources = sources
+    agent._product_research_receipt_source_texts = source_texts
+    request_messages = product_research_retry_request_messages(agent, messages)
+    return sources, source_texts, request_messages
+

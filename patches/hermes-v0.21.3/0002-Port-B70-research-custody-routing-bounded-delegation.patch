@@ -0,0 +1,449 @@
+"""Create-only publication for one verified product-research draft."""
+
+from __future__ import annotations
+
+import argparse
+import datetime as dt
+import hashlib
+import json
+import os
+import re
+import sqlite3
+import subprocess
+import sys
+import unicodedata
+from pathlib import Path
+from typing import Any
+
+from agent.product_route import (
+    PRODUCT_RESEARCH_PUBLICATION_FOOTER,
+    product_publication_approval_requested,
+    product_research_source_texts,
+    product_research_title,
+    validate_product_research_text,
+)
+
+
+SESSION_ID_RE = re.compile(r"^[A-Za-z0-9_-]{8,128}$")
+DURABLE_MODE = "durable_comparison"
+LEGACY_MODE = "legacy_product_research"
+_DURABLE_REQUEST_RE = re.compile(
+    r"(?im)^\s*mode:\s*durable_comparison\s*$"
+)
+_DURABLE_COMMERCE_RE = re.compile(
+    r"(?:[$€£]\s*\d|\b(?:USD|EUR|GBP)\s*\d|"
+    r"\b(?:price|priced|stock|in[- ]stock|out[- ]of[- ]stock|availability|"
+    r"merchant|retailer|discount|deal|coupon|rebate|buy|purchase)\b)",
+    re.IGNORECASE,
+)
+
+
+class PublicationError(RuntimeError):
+    """A bounded product-publication failure safe to return to the operator."""
+
+
+def _sha256_bytes(value: bytes) -> str:
+    return hashlib.sha256(value).hexdigest()
+
+
+def _canonical_json_bytes(value: Any) -> bytes:
+    return (
+        json.dumps(value, ensure_ascii=False, sort_keys=True, separators=(",", ":"))
+        + "\n"
+    ).encode("utf-8")
+
+
+def _slugify(value: str) -> str:
+    normalized = unicodedata.normalize("NFKD", value).encode("ascii", "ignore").decode()
+    slug = re.sub(r"[^a-z0-9]+", "-", normalized.casefold()).strip("-")
+    slug = re.sub(r"-{2,}", "-", slug)[:100].rstrip("-")
+    if len(slug) < 8 or not re.fullmatch(r"[a-z0-9][a-z0-9-]*", slug):
+        raise PublicationError("verified draft title could not produce a safe product slug")
+    return slug
+
+
+def _read_session_rows(
+    home: Path, session_id: str
+) -> tuple[sqlite3.Row, sqlite3.Row]:
+    database = home / "state.db"
+    if database.is_symlink() or not database.is_file():
+        raise PublicationError("Hermes state database is unavailable")
+    connection: sqlite3.Connection | None = None
+    try:
+        connection = sqlite3.connect(
+            database.resolve().as_uri() + "?mode=ro", uri=True, timeout=5
+        )
+        connection.row_factory = sqlite3.Row
+        connection.execute("PRAGMA query_only = ON")
+        draft = connection.execute(
+            """
+            SELECT id, content, timestamp
+            FROM messages
+            WHERE session_id = ? AND role = 'assistant'
+              AND (tool_name = 'product_research_verified_draft'
+                   OR finish_reason = 'product_research_verified_draft')
+            ORDER BY id DESC
+            LIMIT 1
+            """,
+            (session_id,),
+        ).fetchone()
+        if draft is None or not isinstance(draft["content"], str):
+            raise PublicationError("no controller-verified product draft exists")
+        approval = connection.execute(
+            """
+            SELECT id, content, timestamp
+            FROM messages
+            WHERE session_id = ? AND role = 'user' AND id > ?
+            ORDER BY id DESC
+            LIMIT 1
+            """,
+            (session_id, draft["id"]),
+        ).fetchone()
+        if approval is None or not product_publication_approval_requested(
+            approval["content"]
+        ):
+            raise PublicationError("latest turn is not explicit publication approval")
+        return draft, approval
+    except sqlite3.Error as exc:
+        raise PublicationError("Hermes session transcript could not be read") from exc
+    finally:
+        if connection is not None:
+            connection.close()
+
+
+def _load_source_receipt(
+    home: Path, session_id: str, draft_message_id: int
+) -> tuple[Path, dict[str, Any], str]:
+    root = home / "research-receipts"
+    if root.is_symlink() or not root.is_dir():
+        raise PublicationError("research receipt directory is unavailable")
+    candidates: list[tuple[int, Path, dict[str, Any], str]] = []
+    for path in root.glob(f"{session_id}--turn-*.json"):
+        if path.is_symlink() or not path.is_file():
+            continue
+        payload = path.read_bytes()
+        try:
+            receipt = json.loads(payload)
+        except json.JSONDecodeError:
+            continue
+        if not isinstance(receipt, dict) or receipt.get("session_id") != session_id:
+            continue
+        turn_id = receipt.get("turn_user_message_id")
+        if not isinstance(turn_id, int) or turn_id >= draft_message_id:
+            continue
+        candidates.append((turn_id, path, receipt, _sha256_bytes(payload)))
+    if not candidates:
+        raise PublicationError("no current-session source receipt precedes the draft")
+    _turn_id, path, receipt, digest = max(candidates, key=lambda item: item[0])
+    sources = receipt.get("final_citation_allowlist")
+    if not isinstance(sources, list):
+        raise PublicationError("source receipt allowlist is invalid")
+    return path, receipt, digest
+
+
+def _load_source_texts(
+    home: Path,
+    session_id: str,
+    turn_user_message_id: int,
+    draft_message_id: int,
+    source_urls: list[str],
+) -> dict[str, str]:
+    database = home / "state.db"
+    connection: sqlite3.Connection | None = None
+    try:
+        connection = sqlite3.connect(
+            database.resolve().as_uri() + "?mode=ro", uri=True, timeout=5
+        )
+        connection.row_factory = sqlite3.Row
+        connection.execute("PRAGMA query_only = ON")
+        rows = connection.execute(
+            """
+            SELECT role, content, tool_name
+            FROM messages
+            WHERE session_id = ? AND id > ? AND id < ? AND role = 'tool'
+            ORDER BY id
+            """,
+            (session_id, turn_user_message_id, draft_message_id),
+        ).fetchall()
+    except sqlite3.Error as exc:
+        raise PublicationError("source snapshots could not be reopened") from exc
+    finally:
+        if connection is not None:
+            connection.close()
+    return product_research_source_texts(
+        [dict(row) for row in rows],
+        source_urls,
+    )
+
+
+def _load_original_request(
+    home: Path, session_id: str, turn_user_message_id: int
+) -> str:
+    database = home / "state.db"
+    connection: sqlite3.Connection | None = None
+    try:
+        connection = sqlite3.connect(
+            database.resolve().as_uri() + "?mode=ro", uri=True, timeout=5
+        )
+        connection.execute("PRAGMA query_only = ON")
+        row = connection.execute(
+            "SELECT content FROM messages WHERE session_id = ? AND id = ? "
+            "AND role = 'user'",
+            (session_id, turn_user_message_id),
+        ).fetchone()
+    except sqlite3.Error as exc:
+        raise PublicationError("original product request could not be read") from exc
+    finally:
+        if connection is not None:
+            connection.close()
+    if row is None or not isinstance(row[0], str) or not row[0].strip():
+        raise PublicationError("original product request is unavailable")
+    return row[0].strip()
+
+
+def _validate_durable_boundary(original_request: str, draft: str) -> None:
+    if _DURABLE_REQUEST_RE.search(original_request) is None:
+        raise PublicationError(
+            "durable publication requires a matching mode: durable_comparison request"
+        )
+    body = draft
+    if body.endswith(PRODUCT_RESEARCH_PUBLICATION_FOOTER):
+        body = body[: -len(PRODUCT_RESEARCH_PUBLICATION_FOOTER)].rstrip()
+    commerce = _DURABLE_COMMERCE_RE.search(body)
+    if commerce is not None:
+        raise PublicationError(
+            "durable comparison contains a forbidden commerce claim: "
+            f"{commerce.group(0)!r}"
+        )
+
+
+def _render_page(title: str, draft: str, source_digest: str, draft_digest: str) -> bytes:
+    stripped = draft.strip()
+    if not stripped.endswith(PRODUCT_RESEARCH_PUBLICATION_FOOTER):
+        raise PublicationError("verified draft is missing the draft-only boundary")
+    body = stripped[: -len(PRODUCT_RESEARCH_PUBLICATION_FOOTER)].rstrip()
+    today = dt.datetime.now(dt.timezone.utc).date().isoformat()
+    rendered = (
+        "---\n"
+        f"title: {json.dumps(title, ensure_ascii=False)}\n"
+        "status: working\n"
+        f"last_updated: {today}\n"
+        "tags:\n"
+        "  - product-research\n"
+        f"source_receipt_sha256: {source_digest}\n"
+        f"verified_draft_sha256: {draft_digest}\n"
+        "---\n\n"
+        f"{body}\n"
+    )
+    return rendered.encode("utf-8")
+
+
+def _write_exclusive(path: Path, payload: bytes) -> None:
+    descriptor = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
+    try:
+        with os.fdopen(descriptor, "wb") as handle:
+            handle.write(payload)
+            handle.flush()
+            os.fsync(handle.fileno())
+    except Exception:
+        path.unlink(missing_ok=True)
+        raise
+
+
+def _run_taxonomy_audit(home: Path, vault: Path) -> None:
+    script = (
+        home
+        / "skills"
+        / "note-taking"
+        / "obsidian"
+        / "scripts"
+        / "audit_vault_taxonomy.py"
+    )
+    if script.is_symlink() or not script.is_file():
+        raise PublicationError("vault taxonomy auditor is unavailable")
+    completed = subprocess.run(
+        [sys.executable, str(script), "--vault", str(vault), "--strict"],
+        text=True,
+        capture_output=True,
+        timeout=30,
+        check=False,
+    )
+    if completed.returncode != 0:
+        raise PublicationError("post-publication vault taxonomy audit failed")
+
+
+def publish_product_research(
+    *,
+    home: Path,
+    vault: Path,
+    session_id: str,
+    now: dt.datetime | None = None,
+    audit_vault: bool = True,
+    mode: str = LEGACY_MODE,
+) -> tuple[Path, Path, str, str]:
+    """Validate, create with CAS, and receipt one product page."""
+
+    if not SESSION_ID_RE.fullmatch(session_id):
+        raise PublicationError("current Hermes session identity is unavailable")
+    resolved_home = home.resolve()
+    resolved_vault = vault.resolve()
+    if not resolved_vault.is_dir():
+        raise PublicationError("configured Obsidian vault is unavailable")
+
+    draft_row, approval_row = _read_session_rows(resolved_home, session_id)
+    draft = draft_row["content"].strip()
+    source_path, source_receipt, source_digest = _load_source_receipt(
+        resolved_home, session_id, int(draft_row["id"])
+    )
+    source_urls = source_receipt.get("final_citation_allowlist", [])
+    turn_user_message_id = source_receipt.get("turn_user_message_id")
+    if not isinstance(turn_user_message_id, int):
+        raise PublicationError("source receipt turn identity is invalid")
+    original_request = _load_original_request(
+        resolved_home, session_id, turn_user_message_id
+    )
+    if mode == DURABLE_MODE:
+        _validate_durable_boundary(original_request, draft)
+    elif mode != LEGACY_MODE:
+        raise PublicationError("unsupported product publication mode")
+    source_texts = _load_source_texts(
+        resolved_home,
+        session_id,
+        turn_user_message_id,
+        int(draft_row["id"]),
+        source_urls,
+    )
+    passed, validated_draft, reason = validate_product_research_text(
+        draft, source_urls, source_texts, original_request
+    )
+    if not passed or validated_draft.strip() != draft:
+        raise PublicationError(f"verified draft failed current publication gate: {reason}")
+    title = product_research_title(draft)
+    if title is None:
+        raise PublicationError("verified draft title is missing")
+    slug = _slugify(title)
+    draft_digest = hashlib.sha256(draft.encode("utf-8")).hexdigest()
+    page_payload = _render_page(title, draft, source_digest, draft_digest)
+    page_digest = _sha256_bytes(page_payload)
+
+    products = resolved_vault / "products"
+    if products.is_symlink():
+        raise PublicationError("products directory may not be a symbolic link")
+    products.mkdir(parents=True, exist_ok=True)
+    if products.resolve().parent != resolved_vault:
+        raise PublicationError("products directory escaped the configured vault")
+    target = products / f"{slug}.md"
+    if target.exists() or target.is_symlink():
+        raise PublicationError("canonical product target already exists; create-only CAS refused")
+
+    publication_root = resolved_home / "product-publications"
+    if publication_root.is_symlink():
+        raise PublicationError("product publication directory may not be linked")
+    publication_root.mkdir(mode=0o700, parents=True, exist_ok=True)
+    if list(publication_root.glob(f"{session_id}--approval-*.json")):
+        raise PublicationError("this product session already has a publication receipt")
+    publication_receipt_path = (
+        publication_root / f"{session_id}--approval-{approval_row['id']}.json"
+    )
+    lock_path = publication_root / f"{session_id}.lock"
+    try:
+        lock_descriptor = os.open(
+            lock_path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600
+        )
+    except FileExistsError as exc:
+        raise PublicationError("another product publication is already active") from exc
+    os.close(lock_descriptor)
+
+    target_created = False
+    try:
+        _write_exclusive(target, page_payload)
+        target_created = True
+        if audit_vault:
+            _run_taxonomy_audit(resolved_home, resolved_vault)
+        created = now or dt.datetime.now(dt.timezone.utc)
+        if created.tzinfo is None:
+            created = created.replace(tzinfo=dt.timezone.utc)
+        receipt = {
+            "schema_version": 1,
+            "kind": "hermes-product-publication-receipt",
+            "created_utc": created.astimezone(dt.timezone.utc).isoformat(),
+            "session_id": session_id,
+            "source_receipt_path": str(source_path),
+            "source_receipt_sha256": source_digest,
+            "source_urls": source_urls,
+            "verified_draft_message_id": int(draft_row["id"]),
+            "verified_draft_sha256": draft_digest,
+            "approval_message_id": int(approval_row["id"]),
+            "approval_sha256": hashlib.sha256(
+                approval_row["content"].strip().encode("utf-8")
+            ).hexdigest(),
+            "research_mode": mode,
+            "original_request_sha256": hashlib.sha256(
+                original_request.encode("utf-8")
+            ).hexdigest(),
+            "target_relative_path": target.relative_to(resolved_vault).as_posix(),
+            "target_precondition": "absent",
+            "page_sha256": page_digest,
+            "cas": "create_only",
+        }
+        receipt_payload = _canonical_json_bytes(receipt)
+        publication_digest = _sha256_bytes(receipt_payload)
+        _write_exclusive(publication_receipt_path, receipt_payload)
+    except Exception:
+        if target_created and target.is_file():
+            try:
+                if _sha256_bytes(target.read_bytes()) == page_digest:
+                    target.unlink()
+            except OSError:
+                pass
+        raise
+    finally:
+        lock_path.unlink(missing_ok=True)
+
+    return target, publication_receipt_path, page_digest, publication_digest
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--mode", choices=[DURABLE_MODE], required=True)
+    args = parser.parse_args()
+    home_text = os.environ.get("HERMES_HOME", "").strip()
+    vault_text = os.environ.get("OBSIDIAN_VAULT_PATH", "").strip()
+    session_id = os.environ.get("HERMES_SESSION_ID", "").strip()
+    home = Path(home_text) if home_text else Path.home() / ".hermes"
+    if not vault_text:
+        print(
+            "PRODUCT_PUBLICATION_ERROR configured Obsidian vault is unavailable",
+            file=sys.stderr,
+        )
+        return 1
+    try:
+        target, _receipt, page_digest, publication_digest = (
+            publish_product_research(
+                home=home,
+                vault=Path(vault_text),
+                session_id=session_id,
+                mode=args.mode,
+            )
+        )
+    except PublicationError as exc:
+        print(f"PRODUCT_PUBLICATION_ERROR {exc}", file=sys.stderr)
+        return 1
+    print(
+        "PRODUCT_PUBLICATION_OK "
+        f"path=products/{target.name} page_sha256={page_digest} "
+        f"publication_receipt_sha256={publication_digest}"
+    )
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
+
+
+__all__ = [
+    "DURABLE_MODE",
+    "LEGACY_MODE",
+    "PublicationError",
+    "publish_product_research",
+]

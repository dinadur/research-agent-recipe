+def _reserve_travel_turn_action(
+    agent: Any,
+    *,
+    turn_attribute: str,
+    count_attribute: str,
+    limit: int,
+) -> tuple[bool, int]:
+    turn_id = getattr(agent, "_current_turn_id", None)
+    with _TRAVEL_ROUTE_RESERVATION_LOCK:
+        if getattr(agent, turn_attribute, None) != turn_id:
+            setattr(agent, turn_attribute, turn_id)
+            setattr(agent, count_attribute, 0)
+        count = getattr(agent, count_attribute, 0)
+        if not isinstance(count, int) or count < 0:
+            count = 0
+        if count >= limit:
+            return False, count
+        count += 1
+        setattr(agent, count_attribute, count)
+        return True, count
+

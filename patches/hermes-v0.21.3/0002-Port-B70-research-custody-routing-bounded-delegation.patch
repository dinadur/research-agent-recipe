+
+from agent.product_publisher import (
+    DURABLE_MODE,
+    PublicationError,
+    publish_product_research,
+)
+from agent.product_route import PRODUCT_RESEARCH_PUBLICATION_FOOTER
+
+
+SESSION_ID = "20260717_120000_abcdef12"
+OFFICIAL = "https://vendor.example/product"
+REVIEW_ONE = "https://review-one.example/test"
+REVIEW_TWO = "https://review-two.example/test"
+SONY_OFFICIAL = "https://www.sony.com/headphones/wh-1000xm6/specifications"
+BOSE_OFFICIAL = "https://www.bose.com/headphones/quietcomfort-ultra-2nd-gen"
+PCMAG = "https://www.pcmag.com/reviews/sony-wh-1000xm6"
+RTINGS = "https://www.rtings.com/headphones/reviews/bose/quietcomfort-ultra-2nd-gen"
+DURABLE_REQUEST = (
+    "Research and compare the exact Sony WH-1000XM6 and Bose QuietComfort "
+    "Ultra Headphones (2nd Gen) models for frequent air travel.\n\n"
+    "mode: durable_comparison"
+)
+
+
+def _draft() -> str:
+    body = f"""# Best Vendor Vacuum Under $600
+
+## Recommendation
+**Recommended brand:** Vendor — [evidence]({OFFICIAL}): "Vendor A cordless vacuum"
+- **Recommended product:** Vendor A best fits the use case. — [evidence]({REVIEW_ONE}): "strong pickup on hardwood floors"
+
+## Compared options
+- **Vendor A:** Strong pickup and a higher price. — [evidence]({REVIEW_ONE}): "strong pickup and a higher price"
+- **Vendor B:** Lower price with shorter runtime. — [evidence]({REVIEW_TWO}): "lower price with shorter runtime"
+
+## Caveats
+- Runtime varies by mode and floor type. — [evidence]({OFFICIAL}): "runtime varies by mode and floor type"
+
+## Source roles
+- **Official:** [Vendor product page]({OFFICIAL})
+- **Independent:** [Review One test]({REVIEW_ONE})
+- **Independent:** [Review Two comparison]({REVIEW_TWO})"""
+    return f"{body}\n\n{PRODUCT_RESEARCH_PUBLICATION_FOOTER}"
+
+
+def _setup(
+    home: Path,
+    *,
+    draft: str | None = None,
+    approval: str = "Let's publish",
+    request: str = "Research a product.",
+):
+    durable = "mode: durable_comparison" in request
+    if durable:
+        extract_results = [
+            {
+                "url": SONY_OFFICIAL,
+                "content": "Sony WH-1000XM6 supports wired listening and Bluetooth.",
+            },
+            {
+                "url": BOSE_OFFICIAL,
+                "content": (
+                    "Bose QuietComfort Ultra Headphones 2nd Gen supports "
+                    "immersive audio modes."
+                ),
+            },
+            {
+                "url": PCMAG,
+                "content": (
+                    "Sony WH-1000XM6 is designed for frequent travel. "
+                    "Sony comfort depends on fit during long flights."
+                ),
+            },
+            {
+                "url": RTINGS,
+                "content": "Bose microphone quality varies in noisy places.",
+            },
+        ]
+    else:
+        extract_results = [
+            {
+                "url": OFFICIAL,
+                "content": "Vendor A cordless vacuum. Runtime varies by mode and floor type.",
+            },
+            {
+                "url": REVIEW_ONE,
+                "content": "Vendor A had strong pickup on hardwood floors and strong pickup and a higher price.",
+            },
+            {
+                "url": REVIEW_TWO,
+                "content": "Vendor B had a lower price with shorter runtime.",
+            },
+        ]
+    source_urls = [result["url"] for result in extract_results]
+    home.mkdir(parents=True)
+    database = sqlite3.connect(home / "state.db")
+    database.execute(
+        """
+        CREATE TABLE messages (
+            id INTEGER PRIMARY KEY,
+            session_id TEXT NOT NULL,
+            role TEXT NOT NULL,
+            content TEXT,
+            tool_name TEXT,
+            finish_reason TEXT,
+            timestamp REAL NOT NULL
+        )
+        """
+    )
+    database.executemany(
+        "INSERT INTO messages VALUES (?, ?, ?, ?, ?, ?, ?)",
+        [
+            (1, SESSION_ID, "user", request, None, None, 1.0),

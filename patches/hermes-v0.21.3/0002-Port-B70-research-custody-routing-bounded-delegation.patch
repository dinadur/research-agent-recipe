+def test_search_share_reopens_for_validation_repair(tmp_path: Path):
+    """A child in repair must be able to act on "search for the others first".
+
+    Holding the search share closed during repair made that instruction
+    impossible to follow, which is how children exhausted all three final
+    validation attempts and exited research_validation_blocked.
+    """
+    controller = ResearchContractController(_contract(tmp_path, "price"))
+    _land_skeleton(controller, "price")
+
+    _spend_search_share(controller)
+
+    # Before any validation failure the share is closed.
+    blocked = controller.before_call(
+        "web_search", {"query": "past share"}, iterations_remaining=20
+    )
+    assert blocked.code == "research_search_share_exhausted"
+
+    # Entering repair reopens it.
+    controller._final_validation_failures = 1
+    assert (
+        controller.before_call(
+            "web_search", {"query": "repair search"}, iterations_remaining=20
+        )
+        is None
+    )
+
+    # The total budget still binds: spend the remainder, then it closes again.
+    while controller.retrieval_attempts < MAX_RETRIEVAL_ATTEMPTS:
+        args = {"query": f"repair {controller.retrieval_attempts}"}
+        assert (
+            controller.before_call("web_search", args, iterations_remaining=20) is None
+        )
+        controller.after_call(
+            "web_search",
+            args,
+            json.dumps(
+                {"success": True, "data": {"web": [{"url": "https://e/r", "title": "x"}]}}
+            ),
+            failed=False,
+        )
+    spent = controller.before_call(
+        "web_search", {"query": "over"}, iterations_remaining=20
+    )
+    assert spent.code == "research_retrieval_budget_exhausted"
+

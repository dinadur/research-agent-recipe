+from __future__ import annotations
+
+import hashlib
+import json
+from types import SimpleNamespace
+
+from agent.research_tool_policy import _bind_travel_controller_execution_arguments
+from agent.verified_tool_delivery import (
+    GENERIC_RESEARCH_RECEIPT_ABSOLUTE_COMMAND,
+    GENERIC_RESEARCH_RECEIPT_COMMANDS,
+    PRODUCT_RESEARCH_PUBLISH_COMMAND,
+    RELIABLE_RESEARCH_COMMAND,
+    bound_generic_research_receipt_command,
+    bound_product_research_receipt_command,
+    generic_research_receipt_failure,
+    generic_research_receipt_command_allowed,
+    generic_research_receipt_success,
+    product_research_receipt_command_allowed,
+    product_research_publication_delivery,
+    travel_research_controller_boundary,
+    travel_research_approval_delivery,
+    verified_research_delivery,
+)
+
+
+def tool_call(*, command: str = RELIABLE_RESEARCH_COMMAND, timeout: int = 600):
+    return SimpleNamespace(
+        id="call-verified-research",
+        function=SimpleNamespace(
+            name="terminal",
+            arguments=json.dumps({"command": command, "timeout": timeout}),
+        )
+    )
+
+
+def delivery() -> str:
+    sections = []
+    for index, label in enumerate(("Setup", "WAL retention", "Failures"), start=1):
+        sections.extend(
+            [
+                f"## {label}",
+                "",
+                f"- Verified finding {index}a from current documentation. "
+                "([PostgreSQL documentation](https://www.postgresql.org/docs/current/test.html), retrieved 2026-07-16)",
+                f"- Verified finding {index}b from current documentation. "
+                "([PostgreSQL documentation](https://www.postgresql.org/docs/current/test.html), retrieved 2026-07-16)",
+                "",
+            ]
+        )
+    return (
+        "# PostgreSQL Logical Replication: Practical Cited Brief\n\n"
+        "Based on current official PostgreSQL documentation retrieved 2026-07-16.\n\n"
+        + "\n".join(sections)
+    ).rstrip()
+
+
+def terminal_message(output: str, *, exit_code: int = 0, error=None):
+    return {
+        "role": "tool",
+        "name": "terminal",
+        "tool_call_id": "call-verified-research",
+        "content": json.dumps(
+            {"output": output, "exit_code": exit_code, "error": error}
+        ),
+    }
+
+
+def valid_output() -> str:
+    body = delivery()
+    digest = hashlib.sha256(body.encode("utf-8")).hexdigest()
+    return (
+        "RESEARCH_PASS topic=postgresql-logical-replication "
+        "elapsed_seconds=1.25 result=/tmp/result "
+        f"delivery_sha256={digest}\n"
+        "BEGIN_VERIFIED_RESEARCH\n"
+        f"{body}\n"
+        "END_VERIFIED_RESEARCH"
+    )
+
+
+def travel_command() -> str:
+    return (
+        "python3 ~/.hermes/skills/travel-planning/scripts/"
+        "run_hermes_travel_pipeline.py "
+        "/mnt/c/vault/raw/travel/savannah/manifest.json "
+        "/mnt/c/vault/raw/travel/savannah/run-1"
+    )
+
+
+def travel_runner_command(interpreter: str = "python3") -> str:
+    return (
+        f"{interpreter} -m agent.research_harness.travel_runner "
+        "/mnt/c/vault/raw/travel/savannah/request.json"
+    )
+
+
+def travel_approval() -> str:
+    return (
+        "Research is ready for review: Savannah weekend guide\n\n"
+        "2 verified recommendation(s) will be published:\n\n"
+        "### Restaurants (2)\n"
+        "- The Grey\n"
+        "- Husk Savannah\n\n"
+        "No page has been published.\n\n"
+        "Reply yes to publish the exact receipt-bound page at "
+        "`travel/active/savannah/weekend.md` with status `working`."
+    )
+
+
+def travel_output() -> str:
+    body = travel_approval()
+    digest = hashlib.sha256(body.encode("utf-8")).hexdigest()
+    return (
+        '{"pass": true, "included": 2}\n'
+        f"TRAVEL_RESEARCH_READY receipt_sha256={'a' * 64} "
+        f"approval_sha256={digest}\n"
+        "BEGIN_TRAVEL_APPROVAL\n"
+        f"{body}\n"
+        "END_TRAVEL_APPROVAL"
+    )
+
+
+def test_accepts_only_hash_bound_verified_delivery():

+"""B70 research-route admission at the ordinary turn-context boundaries."""
+from __future__ import annotations
+import logging
+logger = logging.getLogger(__name__)
+
+def _explicit_simple_research_workflow_requested(message: object) -> bool:
+    """Return whether the raw operator prompt names either shadow skill."""
+    if not isinstance(message, str):
+        return False
+    normalized = message.casefold()
+    return "research-lite" in normalized or "wiki-save" in normalized
+
+
+def admit_research_context(agent, user_message, persist_user_message, conversation_history, turn_id):
+    agent._b70_research_terminal_receipt = None
+    agent._parallel_research_exception_guard_turn_id = None
+    agent._parallel_research_authenticated_lifecycle_ids = set()
+    agent._parallel_research_authenticated_lifecycle_tokens = set()
+    agent._parallel_research_pending_lifecycle_auth = []
+    # Result-turn delivery authority is one-turn-only. Preserve the bound
+    # descriptors between dispatch and async completion, but clear all prior
+    # turn receipts and streaming suppression before deciding whether this
+    # exact incoming turn is the consolidated research result.
+    agent._parallel_research_post_dispatch_turn_id = None
+    agent._parallel_research_artifact_read_receipts = {}
+    agent._parallel_research_pending_artifact_reads = {}
+    agent._parallel_research_defer_streaming_for_turn = False
+    agent._parallel_research_defer_candidate_text_for_turn = False
+    agent._parallel_research_quarantine_turn_id = None
+    agent._parallel_research_quarantine_delegation_id = None
+    agent._parallel_research_quarantine_clear_state = False
+    agent._parallel_research_retry_block_turn_id = None
+    agent._parallel_research_wave_conflict_turn_id = None
+    agent._travel_publication_route_turn_id = None
+    agent._product_research_route_turn_id = None
+    agent._product_research_initial_turn_id = None
+    agent._product_research_operator_prompt = ""
+    agent._product_research_restart_resume_turn_id = None
+    agent._product_research_publication_approval_turn_id = None
+    agent._product_research_receipt_turn_id = None
+    agent._product_research_receipt_sources = ()
+    agent._product_research_receipt_source_texts = {}
+    agent._product_research_search_budget_exhausted_turn_id = None
+    agent._product_research_extract_budget_exhausted_turn_id = None
+    agent._product_research_search_call_count = 0
+    agent._product_research_extract_call_count = 0
+    agent._product_research_receipt_recovery_turn_id = None
+    agent._product_research_provenance_recovery_turn_id = None
+    agent._product_research_provenance_recovery_pending_turn_id = None
+    agent._product_research_source_mix_nudge_count = 0
+    agent._generic_research_route_turn_id = None
+    agent._generic_research_receipt_turn_id = None
+    agent._generic_research_receipt_sources = ()
+    agent._generic_research_receipt_source_texts = {}
+    agent._generic_research_controller_receipt_turn_id = None
+    agent._generic_research_receipt_ready_turn_id = None
+    agent._generic_research_search_call_count = 0
+    agent._generic_research_extract_call_count = 0
+    agent._generic_research_budget_lock = None
+    agent._generic_research_primary_recovery_turn_id = None

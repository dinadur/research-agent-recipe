+def requires_product_research_route(user_message: Any) -> bool:
+    """Identify an explicit non-travel product comparison/recommendation."""
+
+    if not isinstance(user_message, str):
+        return False
+    if _product_research_durable_comparison_mode(user_message):
+        # A neutral request that explicitly names two compared targets is a
+        # controller-owned durable comparison. The operator need not know or
+        # reproduce an internal mode marker.
+        return True
+    text = " ".join(user_message.split())
+    if not text:
+        return False
+    if PRODUCT_RESEARCH_ROUTE_MARKER in text:
+        return True
+    # Prices, budgets, and recommendations also occur in transport-mode
+    # comparisons. They are research subjects, not products, and must not be
+    # admitted to the commerce/product evidence controller.
+    if (
+        _TRANSPORT_CONTEXT_RE.search(text)
+        and sum(1 for pattern in _TRANSPORT_MODE_RES if pattern.search(text)) >= 2
+    ):
+        return False
+    # Parcel carriers sell services, not compared physical products. Keep an
+    # explicit multi-carrier shipping request on generic research even when it
+    # contains the same price, budget, and recommendation words used by the
+    # commerce route.
+    if (
+        _SHIPPING_CONTEXT_RE.search(text)
+        and sum(1 for pattern in _SHIPPING_CARRIER_RES if pattern.search(text)) >= 2
+    ):
+        return False
+    from agent.travel_route import requires_travel_publication_route
+
+    if requires_travel_publication_route(text):
+        return False
+    return bool(
+        _RESEARCH_PREFIX_RE.search(text)
+        and _COMPARISON_RE.search(text)
+        and _PRODUCT_OR_CONSTRAINT_RE.search(text)
+    )
+

+        value, _RESEARCH_DECISION_LEDGER_FAILURE_CATEGORIES, "other"
+    )
+
+
+def begin_parallel_research_predispatch_decision(
+    agent: Any,
+    *,
+    finish_reason: Any,
+    tool_calls: Any,
+) -> None:
+    """Open one metadata-only row for a post-skill provider response.
+
+    The row deliberately records no content, reasoning, names, arguments,
+    identifiers, provider metadata, lengths, timestamps, or hashes. The exact
+    current-phase name comparison happens before any name repair, but only its
+    boolean result is retained.
+    """
+
+    if not _research_decision_ledger_enabled():
+        return
+    current_turn_id = getattr(agent, "_current_turn_id", None)
+    if (
+        not isinstance(current_turn_id, str)
+        or not current_turn_id
+        or parallel_research_predispatch_phase(agent) != "delegate_task"
+    ):
+        return
+
+    with _PARALLEL_RESEARCH_DECISION_LEDGER_LOCK:
+        if (
+            getattr(
+                agent,
+                "_parallel_research_predispatch_decision_ledger_turn_id",
+                None,
+            )
+            != current_turn_id
+        ):
+            _initialize_parallel_research_predispatch_decision_ledger(
+                agent, current_turn_id
+            )
+
+        entries = getattr(
+            agent,
+            "_parallel_research_predispatch_decision_ledger_entries",
+            None,
+        )
+        if not isinstance(entries, list):
+            entries = []
+            agent._parallel_research_predispatch_decision_ledger_entries = entries
+
+        pending_index = getattr(
+            agent,
+            "_parallel_research_predispatch_decision_ledger_pending_index",
+            None,
+        )
+        if (
+            type(pending_index) is int
+            and 0 <= pending_index < len(entries)
+            and isinstance(entries[pending_index], dict)
+            and entries[pending_index].get("failure_category") == "pending"
+        ):
+            entries[pending_index]["controller_decision_code"] = "other"
+            entries[pending_index]["failure_category"] = "other"
+
+        if len(entries) >= _RESEARCH_DECISION_LEDGER_MAX_ENTRIES:
+            agent._parallel_research_predispatch_decision_ledger_overflowed = True
+            agent._parallel_research_predispatch_decision_ledger_pending_index = None
+            return
+
+        if tool_calls is None:
+            # The Chat Completions accumulator represents an ordinary
+            # response with no tool calls as ``None``.  That is an exact
+            # observed count of zero, not an unknown or malformed shape.
+            tool_call_count = 0
+            has_tool_calls = False
+            phase_name_match = None
+        elif isinstance(tool_calls, (list, tuple)):
+            raw_tool_call_count = len(tool_calls)
+            tool_call_count = (
+                raw_tool_call_count
+                if raw_tool_call_count <= _RESEARCH_DECISION_LEDGER_MAX_TOOL_CALLS
+                else None
+            )
+            has_tool_calls = raw_tool_call_count > 0
+            if raw_tool_call_count == 0:
+                phase_name_match = None
+            else:
+                phase_name_match = bool(
+                    raw_tool_call_count == 1
+                    and getattr(getattr(tool_calls[0], "function", None), "name", None)
+                    == "delegate_task"
+                )
+        else:
+            tool_call_count = None
+            has_tool_calls = bool(tool_calls)
+            phase_name_match = None
+
+        safe_finish_reason = _safe_research_decision_ledger_finish_reason(finish_reason)
+        if safe_finish_reason == "content_filter":
+            failure_category = "content_filter"
+        elif safe_finish_reason in {"length", "incomplete"}:
+            failure_category = "length_or_incomplete"
+        elif not has_tool_calls:
+            failure_category = "no_tool_call"
+        else:
+            failure_category = "pending"
+
+        entries.append(
+            {
+                "finish_reason": safe_finish_reason,
+                "tool_call_count": tool_call_count,
+                "current_phase_name_match": phase_name_match,
+                "provider_ids_valid": None,
+                "arguments_json_valid": None,
+                "controller_decision_code": "not_evaluated",
+                "failure_category": failure_category,
+            }
+        )
+        agent._parallel_research_predispatch_decision_ledger_pending_index = (
+            len(entries) - 1 if failure_category == "pending" else None
+        )
+
+
+def update_parallel_research_predispatch_decision(
+    agent: Any,
+    *,
+    provider_ids_valid: Any = _RESEARCH_DECISION_LEDGER_UNSET,
+    arguments_json_valid: Any = _RESEARCH_DECISION_LEDGER_UNSET,
+    controller_decision_code: Any = _RESEARCH_DECISION_LEDGER_UNSET,
+    failure_category: Any = _RESEARCH_DECISION_LEDGER_UNSET,
+    terminal: bool = False,
+) -> None:
+    """Update only the currently pending safe row."""
+
+    if not _research_decision_ledger_enabled():
+        return
+    with _PARALLEL_RESEARCH_DECISION_LEDGER_LOCK:
+        entries = getattr(
+            agent,
+            "_parallel_research_predispatch_decision_ledger_entries",
+            None,
+        )
+        pending_index = getattr(
+            agent,
+            "_parallel_research_predispatch_decision_ledger_pending_index",
+            None,
+        )
+        if (
+            not isinstance(entries, list)
+            or type(pending_index) is not int
+            or not (0 <= pending_index < len(entries))
+            or not isinstance(entries[pending_index], dict)
+            or entries[pending_index].get("failure_category") != "pending"
+        ):
+            return
+        entry = entries[pending_index]
+        if provider_ids_valid is not _RESEARCH_DECISION_LEDGER_UNSET:
+            entry["provider_ids_valid"] = (
+                provider_ids_valid if type(provider_ids_valid) is bool else None
+            )
+        if arguments_json_valid is not _RESEARCH_DECISION_LEDGER_UNSET:
+            entry["arguments_json_valid"] = (
+                arguments_json_valid if type(arguments_json_valid) is bool else None
+            )
+        if controller_decision_code is not _RESEARCH_DECISION_LEDGER_UNSET:
+            entry[
+                "controller_decision_code"
+            ] = _safe_research_decision_ledger_controller_code(controller_decision_code)
+        if failure_category is not _RESEARCH_DECISION_LEDGER_UNSET:
+            entry["failure_category"] = _safe_research_decision_ledger_failure_category(
+                failure_category
+            )
+        if terminal or entry.get("failure_category") != "pending":
+            agent._parallel_research_predispatch_decision_ledger_pending_index = None
+
+
+def record_parallel_research_predispatch_controller_decision(
+    agent: Any, decision_code: Any
+) -> None:
+    """Record the existing controller decision without re-running admission."""
+
+    safe_code = _safe_research_decision_ledger_controller_code(decision_code)
+    category = {
+        "research_predispatch_single_call_required": "tool_call_count_invalid",
+        "research_predispatch_phase_mismatch": "phase_name_mismatch",
+        "research_predispatch_admission_failed": "admission_failed",
+    }.get(safe_code, "contract_rejected")
+    update_parallel_research_predispatch_decision(
+        agent,
+        controller_decision_code=safe_code,
+        failure_category=category,
+        terminal=True,
+    )

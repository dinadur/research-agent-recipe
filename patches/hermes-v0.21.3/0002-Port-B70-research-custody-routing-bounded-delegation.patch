+def product_research_retry_request_messages(
+    agent: Any, messages: Any
+) -> list[Any] | Any:
+    """Add request-only rejected-draft and evidence-row context.
+
+    Durable history keeps a controller placeholder so an invalid recommendation
+    cannot leak through persistence, restart recovery, or user-visible session
+    export. The provider receives its exact prior draft for local revision plus
+    a compact current-turn evidence catalog. Return a shallow request-only copy;
+    never mutate canonical ``messages``.
+    """
+
+    if not isinstance(messages, list):
+        return messages
+    turn_id = getattr(agent, "_current_turn_id", None)
+    if not isinstance(turn_id, str) or not turn_id:
+        return messages
+    request_messages: list[Any] | Any = messages
+    catalog = product_research_evidence_catalog(agent, messages)
+    candidate = getattr(agent, "_product_research_retry_candidate", None)
+    if (
+        getattr(agent, "_product_research_retry_candidate_turn_id", None) == turn_id
+        and isinstance(candidate, str)
+        and candidate.strip()
+    ):
+        for index in range(len(messages) - 1, -1, -1):
+            message = messages[index]
+            if not (
+                isinstance(message, Mapping)
+                and message.get("role") == "assistant"
+                and message.get("_product_research_synthetic") is True
+                and message.get("content") == PRODUCT_RESEARCH_CANDIDATE_PLACEHOLDER
+            ):
+                continue
+            request_messages = list(messages)
+            request_message = dict(message)
+            bounded_candidate = candidate.strip()
+            if len(bounded_candidate) > PRODUCT_RESEARCH_RETRY_CANDIDATE_MAX_CHARS:
+                half = PRODUCT_RESEARCH_RETRY_CANDIDATE_MAX_CHARS // 2
+                bounded_candidate = (
+                    bounded_candidate[:half]
+                    + "\n\n[Controller omitted the middle of this oversized "
+                    "rejected draft. Rewrite concisely from the evidence catalog.]\n\n"
+                    + bounded_candidate[-half:]
+                )
+            request_message["content"] = (
+                "[Private rejected draft for revision. This draft is not "
+                "validated evidence and must not be delivered as-is.]\n\n"
+                f"{bounded_candidate}"
+            )
+            request_messages[index] = request_message
+            break
+
+    if catalog is None:
+        return request_messages
+    agent._product_research_evidence_catalog_turn_id = turn_id
+    agent._product_research_evidence_catalog = catalog
+    if product_research_quality_first_active(agent):
+        from agent.quality_first_route import synthesis_messages
+
+        raw_sources = getattr(agent, "_product_research_receipt_sources", ())
+        raw_source_texts = getattr(
+            agent, "_product_research_receipt_source_texts", {}
+        )
+        repair_candidate = (
+            candidate
+            if getattr(agent, "_product_research_retry_candidate_turn_id", None)
+            == turn_id
+            and isinstance(candidate, str)
+            and candidate.strip()
+            else None
+        )
+        repair_instruction = None
+        if repair_candidate is not None:
+            repair_instruction = next(
+                (
+                    str(message.get("content") or "")
+                    for message in reversed(messages)
+                    if isinstance(message, Mapping)
+                    and message.get("role") == "user"
+                    and message.get("_product_research_synthetic") is True
+                ),
+                None,
+            )
+        return synthesis_messages(
+            _product_research_original_request(messages),
+            raw_sources if isinstance(raw_sources, (list, tuple)) else (),
+            raw_source_texts if isinstance(raw_source_texts, Mapping) else {},
+            repair_candidate=repair_candidate,
+            repair_instruction=repair_instruction,
+        )
+    if request_messages is messages:
+        request_messages = list(messages)
+    for index, message in enumerate(request_messages):
+        if not isinstance(message, Mapping) or message.get("role") != "tool":
+            continue
+        tool_name = message.get("name") or message.get("tool_name")
+        if tool_name not in {"web_search", "web_extract"}:
+            continue
+        compacted = dict(message)
+        compacted["content"] = PRODUCT_RESEARCH_COMPACTED_TOOL_CONTENT
+        request_messages[index] = compacted
+    request_messages.append({
+        "role": "user",
+        "content": _product_research_evidence_catalog_prompt(catalog),
+    })
+    return request_messages
+
+
+def product_research_withheld_response(reason: str) -> str:
+    """Explain the terminal gate accurately without exposing candidate prose."""
+
+    receipt_failure_reasons = {
+        "receipt_missing",
+        "receipt_sources_missing",
+        "source_packet_incomplete",
+        "source_mix_too_small",
+    }
+    safe_reason = (
+        reason
+        if isinstance(reason, str) and re.fullmatch(r"[a-z0-9_]{1,80}", reason)
+        else "validator_error"
+    )
+    if safe_reason in receipt_failure_reasons:
+        return (
+            "Product research withheld: the current-turn source receipt did "
+            f"not validate (`{safe_reason}`). No recommendation was delivered "
+            "or published."
+        )
+    return (
+        "Product research withheld after a valid current-turn source receipt: "
+        f"the final draft failed `{safe_reason}` validation. No recommendation "
+        "was delivered or published."
+    )
+

+def _parsed_artifact_path(root: Path, slug: str = "leg") -> Path:
+    return root / slug / RESEARCH_STAMP / f"{slug}.md"
+
+
+def _contract(
+    tmp_path: Path,
+    *fields: str,
+    source_policy_id: str = "unrestricted",
+) -> ResearchArtifactContract:
+    validator = tmp_path / "validate.py"
+    validator.write_text("raise SystemExit(0)\n", encoding="utf-8")
+    validator_bytes = validator.read_bytes()
+    return ResearchArtifactContract(
+        path=str((tmp_path / "leg.md").resolve()),
+        fields=tuple(fields or ("price",)),
+        validator_path=str(validator),
+        validator_bytes=validator_bytes,
+        validator_sha256=hashlib.sha256(validator_bytes).hexdigest(),
+        initial_exists=False,
+        initial_sha256=None,
+        source_policy_id=source_policy_id,
+    )
+
+
+def _bind_parallel_research_wave(
+    agent: SimpleNamespace,
+    tmp_path: Path,
+    *,
+    delegation_id: str = "wave-1",
+) -> tuple[ResearchArtifactContract, ...]:
+    """Install the exact three-contract parent authority used at admission."""
+
+    validator_bytes = b"raise SystemExit(0)\n"
+    validator_path = str(tmp_path / "validate.py")
+    activation = ParallelResearchActivation(
+        name="parallel-research",
+        skill_dir=str(tmp_path / "skill"),
+        validator_path=validator_path,
+        validator_bytes=validator_bytes,
+        validator_sha256=hashlib.sha256(validator_bytes).hexdigest(),
+        allowed_roots=(str(tmp_path),),
+    )
+    contracts = tuple(
+        ResearchArtifactContract(
+            path=str(tmp_path / f"leg-{index}.md"),
+            fields=("scope",),
+            validator_path=validator_path,
+            validator_bytes=validator_bytes,
+            validator_sha256=activation.validator_sha256,
+            initial_exists=False,
+            initial_sha256=None,
+            subject=f"Leg {index}",
+        )
+        for index in range(3)
+    )
+    agent._parallel_research_activation = activation
+    agent._parallel_research_bound_artifacts = contracts
+    agent._parallel_research_bound_paths = tuple(
+        contract.path for contract in contracts
+    )
+    agent._parallel_research_dispatch_succeeded = True
+    agent._parallel_research_pending_delegation_id = delegation_id
+    return contracts
+
+
+def _bind_parent_completion_attestations(
+    agent: SimpleNamespace,
+    *,
+    incoming_paths: tuple[str, ...] | None = None,
+) -> None:
+    contracts = agent._parallel_research_bound_artifacts
+    attestations = {}
+    for index, contract in enumerate(contracts):
+        path = Path(contract.path)
+        path.parent.mkdir(parents=True, exist_ok=True)
+        content = f"bound research artifact {index}\n".encode()
+        path.write_bytes(content)
+        attestations[contract.path] = {
+            "path": contract.path,
+            "artifact_sha256": hashlib.sha256(content).hexdigest(),
+            "validator_sha256": contract.validator_sha256,
+            "source_policy_id": contract.source_policy_id,
+            "passed": True,
+            "terminal": False,
+            "retryable": True,
+        }
+    agent._parallel_research_completion_attestations = attestations
+    agent._parallel_research_completion_attestation_paths = (
+        incoming_paths
+        if incoming_paths is not None
+        else agent._parallel_research_bound_paths
+    )
+    agent._parallel_research_completion_attestation_valid = True
+

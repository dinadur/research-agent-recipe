+class ProductResearchFirstResponseTimeout(TimeoutError):
+    """Terminal timeout for the pre-tool model call of a product turn."""
+
+    def __init__(self, timeout_seconds: float) -> None:
+        self.timeout_seconds = float(timeout_seconds)
+        super().__init__(
+            "product research initial response exceeded "
+            f"{self.timeout_seconds:g} seconds"
+        )
+
+
+def product_research_first_response_timeout_seconds(agent: Any) -> float | None:
+    """Return the narrow first-call watchdog for an initial product turn.
+
+    The production WSL-to-Windows relay buffers upstream SSE bytes until the
+    response finishes.  Local streaming therefore provides no observable
+    progress during a pathological initial thinking generation, and the generic
+    local-provider stale detector is intentionally disabled.  Bound only API
+    call #1: later retrieval analysis and synthesis retain the provider's full
+    request timeout.
+    """
+
+    turn_id = getattr(agent, "_current_turn_id", None)
+    if not (
+        isinstance(turn_id, str)
+        and turn_id
+        and getattr(agent, "_product_research_initial_turn_id", None) == turn_id
+        and getattr(agent, "_api_call_count", 0) == 1
+    ):
+        return None
+
+    raw = os.environ.get(
+        PRODUCT_RESEARCH_FIRST_RESPONSE_TIMEOUT_ENV,
+        str(PRODUCT_RESEARCH_FIRST_RESPONSE_TIMEOUT_DEFAULT),
+    )
+    try:
+        timeout_seconds = float(raw)
+    except (TypeError, ValueError):
+        timeout_seconds = PRODUCT_RESEARCH_FIRST_RESPONSE_TIMEOUT_DEFAULT
+    if timeout_seconds <= 0:
+        return None
+    return timeout_seconds
+
+
+def product_research_first_response_timeout_text(timeout_seconds: float) -> str:
+    seconds = max(1, int(round(float(timeout_seconds))))
+    return PRODUCT_RESEARCH_FIRST_RESPONSE_TIMEOUT_RESPONSE.format(seconds=seconds)
+

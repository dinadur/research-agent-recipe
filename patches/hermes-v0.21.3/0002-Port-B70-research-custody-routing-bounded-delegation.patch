+    units = packet.get("units")
+    if packet.get("schema_version") != SCHEMA_VERSION or not isinstance(units, list):
+        raise ReferenceStoreError("facet synthesis response header is invalid")
+    if not MIN_FACET_UNITS <= len(units) <= MAX_FACET_UNITS:
+        raise ReferenceStoreError("facet synthesis response unit count is outside 3-4")
+
+    canonical_units: list[dict[str, Any]] = []
+    seen_text: set[str] = set()
+    used_row_ids: set[str] = set()
+    covered_measurement_rows: set[str] = set()
+    maximum_unsupported_run = 0
+    kind_counts: Counter[str] = Counter()
+    for index, unit in enumerate(units, start=1):
+        if not isinstance(unit, dict) or set(unit) != _UNIT_KEYS:
+            raise ReferenceStoreError("facet synthesis unit keys are not exact")
+        unit_id = unit.get("unit_id")
+        kind = unit.get("kind")
+        text = unit.get("text")
+        evidence_ids = unit.get("evidence_row_ids")
+        if (
+            unit_id != f"u{index}"
+            or kind not in _FACET_UNIT_KINDS
+            or not isinstance(text, str)
+            or not 30 <= len(text) <= MAX_UNIT_CHARS
+            or not text.endswith(".")
+            or any(token in text for token in (";", "?", "\"", "http://", "https://"))
+            or "!" in text
+            or _INTERNAL_SENTENCE_BOUNDARY_RE.search(text[:-1]) is not None
+            or _ROW_ID_RE.search(text) is not None
+            or not isinstance(evidence_ids, list)
+            or not 1 <= len(evidence_ids) <= 3
+            or not all(
+                isinstance(row_id, str) and row_id in facet_row_ids
+                for row_id in evidence_ids
+            )
+            or len(set(evidence_ids)) != len(evidence_ids)
+        ):
+            raise ReferenceStoreError(
+                f"facet {facet_marker} synthesis unit {index} is invalid"
+            )
+        normalized_text = " ".join(text.casefold().split())
+        if normalized_text in seen_text:
+            raise ReferenceStoreError("facet synthesis repeats a prose unit")
+        seen_text.add(normalized_text)
+        support = " ".join(rows_by_id[row_id]["text"] for row_id in evidence_ids)
+        unsupported_numbers = sorted(
+            _normalized_quantity_tokens(text)
+            - _normalized_quantity_tokens(support)
+        )
+        if unsupported_numbers:
+            raise ReferenceStoreError(
+                f"facet {facet_marker} synthesis unit {index} adds unsupported "
+                f"number(s): {unsupported_numbers}"
+            )
+        unsupported_run = _maximum_unsupported_signal_run(text, support)
+        maximum_unsupported_run = max(maximum_unsupported_run, unsupported_run)
+        if unsupported_run > MAX_UNSUPPORTED_SIGNAL_RUN:
+            raise ReferenceStoreError(
+                f"facet {facet_marker} synthesis unit {index} contains an "
+                "unsupported multi-word claim"
+            )
+        for row_id in evidence_ids:
+            row_text = str(rows_by_id[row_id]["text"])
+            row_signal_count = len(set(_synthesis_signal_sequence(row_text)))
+            minimum_overlap = min(MIN_CITED_ROW_SIGNAL_OVERLAP, row_signal_count)
+            if _cited_row_signal_overlap(text, row_text) < minimum_overlap:
+                raise ReferenceStoreError(
+                    f"facet {facet_marker} synthesis unit {index} cites "
+                    f"irrelevant evidence row {row_id}"
+                )
+            obligations = measurement_obligations.get(row_id)
+            if obligations and obligations.issubset(_normalized_quantity_tokens(text)):
+                covered_measurement_rows.add(row_id)
+        kind_counts[kind] += 1
+        used_row_ids.update(evidence_ids)
+        canonical_units.append(
+            {
+                "unit_id": unit_id,
+                "kind": kind,
+                "text": text,
+                "evidence_row_ids": list(evidence_ids),
+            }
+        )
+    if kind_counts["finding"] < 1:
+        raise ReferenceStoreError("facet synthesis lacks a finding")
+    minimum_rows = min(MIN_SELECTED_ROWS_PER_FACET, len(facet_row_ids))
+    if len(used_row_ids) < minimum_rows:
+        raise ReferenceStoreError("facet synthesis has insufficient selected-row coverage")
+    missing_measurement_rows = sorted(
+        set(measurement_obligations) - covered_measurement_rows
+    )
+    if missing_measurement_rows:
+        raise ReferenceStoreError(
+            "facet synthesis omits measured threshold row(s): "
+            f"{missing_measurement_rows}"
+        )
+    return {
+        "schema_version": SCHEMA_VERSION,
+        "kind": FACET_SYNTHESIS_KIND,
+        "facet": facet_marker,
+        "facet_label": facets[facet_marker]["label"],
+        "empty_think_wrapper_removed": normalized != raw_content,
+        "units": canonical_units,
+        "coverage_gate": {
+            "minimum_selected_rows": minimum_rows,
+            "available_row_ids": sorted(facet_row_ids),
+            "used_row_ids": sorted(used_row_ids),
+            "required_measurement_row_ids": sorted(measurement_obligations),
+            "covered_measurement_row_ids": sorted(covered_measurement_rows),
+            "passed": True,
+        },
+        "claim_support_gate": {
+            "method": "bounded-lexical-support-v1",
+            "maximum_unsupported_signal_run": maximum_unsupported_run,
+            "allowed_unsupported_signal_run": MAX_UNSUPPORTED_SIGNAL_RUN,
+            "minimum_cited_row_signal_overlap": MIN_CITED_ROW_SIGNAL_OVERLAP,
+            "passed": True,
+        },
+        "row_store_sha256": sha256_bytes(canonical_json_bytes(dict(row_store))),
+    }
+
+
+def render_facet_candidate(
+    spec_value: Mapping[str, Any],
+    row_store: Mapping[str, Any],
+    facet_syntheses: Mapping[str, Mapping[str, Any]],
+) -> str:
+    """Merge validated facet packets without another model call."""
+
+    spec = validate_spec(dict(spec_value))
+    rows = row_store.get("rows")
+    if not isinstance(rows, list):
+        raise ReferenceStoreError("evidence-row store is invalid")
+    rows_by_id = {row["row_id"]: row for row in rows}
+    expected_hash = sha256_bytes(canonical_json_bytes(dict(row_store)))
+    expected_markers = [facet["marker"] for facet in spec["facets"]]
+    if set(facet_syntheses) != set(expected_markers):
+        raise ReferenceStoreError("facet synthesis set is incomplete")
+    prefixes = {
+        "finding": "Finding: ",
+        "recommendation": "Recommendation: ",
+        "limitation": "Limitation: ",
+    }
+    lines = [
+        "---",
+        f"title: {spec['title']}",
+        f"retrieval_date: {spec['retrieval_date']}",
+        "status: experimental",
+        "---",
+        "",
+        f"# {spec['title']}",
+        "",
+    ]
+    for facet in spec["facets"]:
+        marker = facet["marker"]
+        synthesis = facet_syntheses[marker]
+        units = synthesis.get("units")
+        if (
+            synthesis.get("kind") != FACET_SYNTHESIS_KIND
+            or synthesis.get("facet") != marker
+            or synthesis.get("facet_label") != facet["label"]
+            or synthesis.get("row_store_sha256") != expected_hash
+            or not isinstance(units, list)
+            or not units
+        ):
+            raise ReferenceStoreError(f"validated facet packet {marker} is invalid")
+        lines.extend([f"## {facet['label']}", ""])
+        for unit in units:
+            evidence_ids = unit.get("evidence_row_ids")
+            if (
+                unit.get("kind") not in prefixes
+                or not isinstance(evidence_ids, list)
+                or not evidence_ids
+                or not all(
+                    row_id in rows_by_id
+                    and rows_by_id[row_id].get("facet") == marker
+                    for row_id in evidence_ids
+                )
+            ):
+                raise ReferenceStoreError(f"validated facet unit {marker} is invalid")
+            source_rows = [rows_by_id[row_id] for row_id in evidence_ids]
+            citations: list[str] = []
+            for row in source_rows:
+                citation = (
+                    f"[{row['source_id']}]({row['url']}), retrieved "
+                    f"{row['retrieval_date']}"
+                )
+                if citation not in citations:
+                    citations.append(citation)
+            evidence = ", ".join(evidence_ids)
+            lines.append(
+                f"- {prefixes[unit['kind']]}{unit['text']} "
+                f"({'; '.join(citations)}) [evidence: {evidence}]"
+            )
+        lines.append("")
+    return "\n".join(lines).rstrip() + "\n"
+
+
+def _extractive_row_is_presentable(text: str) -> bool:
+    stripped = text.strip()
+    if stripped.startswith(":"):
+        stripped = stripped[1:].strip()
+    return (
+        len(stripped) >= 30
+        and re.match(r"^\d+(?:\.\d+)+\]\(", stripped) is None
+        and re.search(r"\]\((?!https://)[^)]+\)", stripped) is None
+        and re.match(r"^`[^`]+`\s+`[^`]+`\s{2,}", stripped) is None
+        and re.search(
+            r"(?:\be\.g\.|\bi\.e\.|\bfor example|\bsuch as)\s*$",
+            stripped,
+            re.IGNORECASE,
+        )
+        is None
+        and re.search(
+            r"\b(?:just created|above case)\b|^to prevent this\b",
+            stripped,
+            re.IGNORECASE,
+        )
+        is None
+        and stripped.count("(") == stripped.count(")")
+        and stripped.count("[") == stripped.count("]")
+        and len(set(_synthesis_signal_sequence(stripped))) >= 4
+    )
+
+
+def _extractive_rows_are_redundant(left: str, right: str) -> bool:
+    left_signals = set(_synthesis_signal_sequence(left))
+    right_signals = set(_synthesis_signal_sequence(right))
+    smaller = min(len(left_signals), len(right_signals))
+    return smaller > 0 and len(left_signals & right_signals) / smaller >= 0.75
+
+
+def _extractive_row_priority(text: str) -> tuple[int, int]:
+    normalized = " ".join(text.upper().split())
+    normative = 0
+    if "SHALL" in normalized or "MUST" in normalized or "DO NOT" in normalized:
+        normative = 3
+    elif "SHOULD" in normalized:
+        normative = 2
+    return normative, len(set(_synthesis_signal_sequence(text)))
+
+
+def build_extractive_brief(
+    spec_value: Mapping[str, Any],
+    row_store: Mapping[str, Any],
+    *,
+    target_rows_per_facet: int = 4,
+) -> dict[str, Any]:
+    """Compress selected rows deterministically without model-written prose."""
+
+    spec = validate_spec(dict(spec_value))
+    if not 3 <= target_rows_per_facet <= MAX_ROWS_PER_FACET:
+        raise ReferenceStoreError("extractive brief target is invalid")
+    if not isinstance(row_store, Mapping):
+        raise ReferenceStoreError("evidence-row store is not an object")
+    rows = row_store.get("rows")
+    if (
+        row_store.get("schema_version") != SCHEMA_VERSION
+        or row_store.get("kind") != ROWS_KIND
+        or not isinstance(rows, list)
+        or not rows
+    ):
+        raise ReferenceStoreError("evidence-row store header is invalid")
+    facets = {facet["marker"]: facet for facet in spec["facets"]}
+    seen_row_ids: set[str] = set()
+    rows_by_facet: dict[str, list[Mapping[str, Any]]] = {
+        marker: [] for marker in facets
+    }
+    for row in rows:
+        row_id = str(row.get("row_id") or "") if isinstance(row, Mapping) else ""
+        if (
+            not isinstance(row, Mapping)
+            or _ROW_ID_RE.fullmatch(row_id) is None
+            or row_id in seen_row_ids
+            or row.get("facet") not in facets
+            or not isinstance(row.get("selected_candidate_id"), str)
+            or _CANDIDATE_ID_RE.fullmatch(row["selected_candidate_id"]) is None
+            or not isinstance(row.get("text"), str)
+            or not row["text"].strip()
+        ):
+            raise ReferenceStoreError("semantic evidence-row record is invalid")
+        seen_row_ids.add(row_id)
+        rows_by_facet[row["facet"]].append(row)
+
+    facet_packets: list[dict[str, Any]] = []
+    all_selected_ids: list[str] = []
+    globally_selected: list[Mapping[str, Any]] = []
+    for facet in spec["facets"]:
+        marker = facet["marker"]
+        facet_rows = rows_by_facet[marker]
+        if not MIN_ROWS_PER_FACET <= len(facet_rows) <= MAX_ROWS_PER_FACET:
+            raise ReferenceStoreError(f"extractive facet {marker} row count is invalid")
+        measured = [
+            row for row in facet_rows if _measurement_obligations(row["text"])
+        ]
+        if any(not _extractive_row_is_presentable(row["text"]) for row in measured):
+            raise ReferenceStoreError(
+                f"extractive facet {marker} has an unpresentable measured row"
+            )
+        selected: list[Mapping[str, Any]] = list(measured)
+        quality_rejected: list[str] = []
+        redundant_rejected: list[str] = []
+        for row in facet_rows:
+            if row in selected:
+                continue
+            if not _extractive_row_is_presentable(row["text"]):
+                quality_rejected.append(row["row_id"])
+                continue
+            redundant_index = next(
+                (
+                    index
+                    for index, prior in enumerate(globally_selected + selected)
+                    if _extractive_rows_are_redundant(
+                        row["text"], prior["text"]
+                    )
+                ),
+                None,
+            )
+            if redundant_index is not None:
+                if redundant_index < len(globally_selected):
+                    redundant_rejected.append(row["row_id"])
+                    continue
+                selected_index = redundant_index - len(globally_selected)
+                prior = selected[selected_index]
+                if (
+                    prior not in measured
+                    and _extractive_row_priority(row["text"])
+                    > _extractive_row_priority(prior["text"])
+                ):
+                    redundant_rejected.append(prior["row_id"])
+                    selected[selected_index] = row
+                else:
+                    redundant_rejected.append(row["row_id"])
+                continue
+            if len(selected) < target_rows_per_facet:
+                selected.append(row)
+        if len(selected) < MIN_EXTRACTIVE_ROWS:
+            for row in facet_rows:
+                if (
+                    row not in selected
+                    and _extractive_row_is_presentable(row["text"])
+                    and not any(
+                        _extractive_rows_are_redundant(
+                            row["text"], prior["text"]
+                        )
+                        for prior in globally_selected + selected
+                    )
+                ):
+                    selected.append(row)
+                if len(selected) >= MIN_EXTRACTIVE_ROWS:
+                    break
+        selected_ids = {
+            row["row_id"] for row in selected
+        }
+        ordered_ids = [
+            row["row_id"] for row in facet_rows if row["row_id"] in selected_ids
+        ]
+        measured_ids = [row["row_id"] for row in measured]
+        if (
+            not MIN_EXTRACTIVE_ROWS <= len(ordered_ids) <= MAX_ROWS_PER_FACET
+            or not set(measured_ids).issubset(ordered_ids)
+        ):
+            raise ReferenceStoreError(f"extractive facet {marker} coverage failed")
+        all_selected_ids.extend(ordered_ids)
+        globally_selected.extend(
+            row for row in facet_rows if row["row_id"] in selected_ids
+        )
+        facet_packets.append(
+            {
+                "marker": marker,
+                "label": facet["label"],
+                "row_ids": ordered_ids,
+                "available_row_ids": [row["row_id"] for row in facet_rows],
+                "measured_row_ids": measured_ids,
+                "quality_rejected_row_ids": quality_rejected,
+                "redundant_rejected_row_ids": redundant_rejected,
+            }
+        )
+    return {
+        "schema_version": SCHEMA_VERSION,
+        "kind": EXTRACTIVE_BRIEF_KIND,
+        "facets": facet_packets,
+        "selected_row_ids": all_selected_ids,
+        "target_rows_per_facet": target_rows_per_facet,
+        "model_written_prose": False,
+        "presentation_normalization": ["leading-markdown-definition-marker"],
+        "measured_threshold_preservation": True,
+        "row_store_sha256": sha256_bytes(canonical_json_bytes(dict(row_store))),
+    }
+
+
+def render_extractive_candidate(
+    spec_value: Mapping[str, Any],
+    row_store: Mapping[str, Any],
+    brief: Mapping[str, Any],
+) -> str:
+    """Render exact verified row text with controller-owned citations."""
+
+    spec = validate_spec(dict(spec_value))
+    rows = row_store.get("rows")
+    if not isinstance(rows, list):
+        raise ReferenceStoreError("evidence-row store is invalid")
+    rows_by_id = {row["row_id"]: row for row in rows}
+    facet_packets = brief.get("facets")
+    if (
+        brief.get("kind") != EXTRACTIVE_BRIEF_KIND
+        or brief.get("model_written_prose") is not False
+        or brief.get("row_store_sha256")
+        != sha256_bytes(canonical_json_bytes(dict(row_store)))
+        or not isinstance(facet_packets, list)
+        or len(facet_packets) != len(spec["facets"])
+    ):
+        raise ReferenceStoreError("extractive brief packet is invalid")
+    packets_by_marker = {
+        packet.get("marker"): packet
+        for packet in facet_packets
+        if isinstance(packet, Mapping)
+    }
+    lines = [
+        "---",
+        f"title: {spec['title']}",
+        f"retrieval_date: {spec['retrieval_date']}",
+        "status: experimental",
+        "---",
+        "",
+        f"# {spec['title']}",
+        "",
+        "This is an extractive evidence brief: each bullet comes from a "
+        "controller-verified source row; a leading Markdown definition marker "
+        "is removed for display.",
+        "",
+    ]
+    for facet in spec["facets"]:
+        marker = facet["marker"]
+        packet = packets_by_marker.get(marker)
+        row_ids = packet.get("row_ids") if isinstance(packet, Mapping) else None
+        if (
+            packet is None
+            or packet.get("label") != facet["label"]
+            or not isinstance(row_ids, list)
+            or not MIN_EXTRACTIVE_ROWS <= len(row_ids) <= MAX_ROWS_PER_FACET
+            or not all(
+                row_id in rows_by_id and rows_by_id[row_id].get("facet") == marker
+                for row_id in row_ids
+            )
+        ):
+            raise ReferenceStoreError(f"extractive facet packet {marker} is invalid")
+        lines.extend([f"## {facet['label']}", ""])
+        for row_id in row_ids:
+            row = rows_by_id[row_id]
+            display_text = row["text"].strip()
+            if display_text.startswith(":"):
+                display_text = display_text[1:].strip()
+            citation = (
+                f"[{row['source_id']}]({row['url']}), retrieved "
+                f"{row['retrieval_date']}"
+            )
+            lines.append(
+                f"- {display_text} ({citation}) [evidence: {row_id}]"
+            )
+        lines.append("")
+    return "\n".join(lines).rstrip() + "\n"
+
+
+def render_candidate(
+    spec_value: Mapping[str, Any],
+    row_store: Mapping[str, Any],
+    synthesis: Mapping[str, Any],
+) -> str:
+    spec = validate_spec(dict(spec_value))
+    rows = row_store.get("rows")
+    if not isinstance(rows, list):
+        raise ReferenceStoreError("evidence-row store is invalid")
+    rows_by_id = {row["row_id"]: row for row in rows}
+    units = synthesis.get("units")
+    if synthesis.get("kind") != SYNTHESIS_KIND or not isinstance(units, list):
+        raise ReferenceStoreError("validated synthesis packet is invalid")
+    headings = {
+        "finding": "Key findings",
+        "interaction": "How the mechanisms interact",
+        "recommendation": "Practical recommendations",
+        "limitation": "Limitations",
+    }
+    lines = [
+        "---",
+        f"title: {spec['title']}",
+        f"retrieval_date: {spec['retrieval_date']}",
+        "status: experimental",
+        "---",
+        "",
+        f"# {spec['title']}",
+        "",
+    ]
+    for kind in ("finding", "interaction", "recommendation", "limitation"):
+        selected = [unit for unit in units if unit["kind"] == kind]
+        if not selected:
+            continue
+        lines.extend([f"## {headings[kind]}", ""])
+        for unit in selected:
+            source_rows = [rows_by_id[row_id] for row_id in unit["evidence_row_ids"]]
+            citations: list[str] = []
+            for row in source_rows:
+                citation = f"[{row['source_id']}]({row['url']}), retrieved {row['retrieval_date']}"
+                if citation not in citations:
+                    citations.append(citation)
+            prefix = "Inference: " if kind == "recommendation" else ""
+            evidence = ", ".join(unit["evidence_row_ids"])
+            lines.append(
+                f"- {prefix}{unit['text']} ({'; '.join(citations)}) [evidence: {evidence}]"
+            )
+        lines.append("")
+    return "\n".join(lines).rstrip() + "\n"
+

+FAKE_VALIDATOR = b'''from pathlib import Path
+import re
+import sys
+
+args = sys.argv[1:]
+target = Path(args[0])
+text = target.read_text(encoding="utf-8")
+
+def values(flag):
+    return [args[index + 1] for index, value in enumerate(args[:-1]) if value == flag]
+
+required = values("--required-field")
+if required:
+    expected = {"scope", "verified findings", "open questions"}
+    if (
+        set(required) != expected
+        or "--require-claim-citations" not in args
+        or "--forbid-unverified" not in args
+        or "--require-atomic-claims" not in args
+    ):
+        print("strict raw flags missing")
+        raise SystemExit(1)
+    if any(field not in text for field in expected) or "RAW_INVALID" in text:
+        print("raw contract failed")
+        raise SystemExit(1)
+else:
+    needed = {
+        "--require-claim-citations",
+        "--forbid-unverified",
+        "--require-atomic-claims",
+    }
+    if not needed.issubset(args):
+        print("strict synthesis flags missing")
+        raise SystemExit(1)
+    corpora = values("--source-corpus")
+    corpus_text = "\\n".join(Path(path).read_text(encoding="utf-8") for path in corpora)
+    corpus_urls = set(re.findall(r"https://[^\\s)]+", corpus_text))
+    output_urls = set(re.findall(r"https://[^\\s)]+", text))
+    if not corpora or not output_urls or not output_urls.issubset(corpus_urls):
+        print("source corpus binding failed")
+        raise SystemExit(1)
+    if "UNCITED" in text or "unverified" in text.casefold():
+        print("claim policy failed")
+        raise SystemExit(1)
+
+print("PASS")
+'''
+
+
+def _raw_text(*, invalid: bool = False) -> str:
+    marker = "RAW_INVALID\n" if invalid else ""
+    return (
+        "---\n"
+        "entity: TrueNAS SCALE\n"
+        "retrieval_date: 2026-07-13\n"
+        "status: complete\n"
+        "---\n"
+        f"{marker}"
+        "scope\n"
+        "verified findings\n"
+        "- Snapshots are supported: https://example.com/docs (retrieved 2026-07-13)\n"
+        "open questions\n"
+    )
+
+
+def _real_raw_text() -> str:
+    return (
+        "---\n"
+        "entity: TrueNAS SCALE\n"
+        "retrieval_date: 2026-07-13\n"
+        "status: complete\n"
+        "---\n"
+        "## Scope\n"

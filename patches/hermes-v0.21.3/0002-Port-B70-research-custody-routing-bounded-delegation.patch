+def test_concurrent_suspension_allows_only_one_probe(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    start_together = threading.Barrier(4)
+    first_entered = threading.Event()
+    release_probe = threading.Event()
+    calls = 0
+    calls_lock = threading.Lock()
+
+    def fake_get(*args, **kwargs):
+        nonlocal calls
+        with calls_lock:
+            calls += 1
+        first_entered.set()
+        assert release_probe.wait(timeout=2)
+        return _Response(
+            {
+                "results": [],
+                "unresponsive_engines": [
+                    ["brave", "too many requests"],
+                    ["duckduckgo", "CAPTCHA"],
+                    ["google cse", "too many requests"],
+                    ["startpage", "Suspended: CAPTCHA"],
+                ],
+            }
+        )
+
+    monkeypatch.setattr(httpx, "get", fake_get)
+    results: list[dict[str, Any]] = []
+
+    def run_search(index: int) -> None:
+        start_together.wait(timeout=2)
+        results.append(_provider().search(f"suspended query {index}"))
+
+    threads = [threading.Thread(target=run_search, args=(i,)) for i in range(3)]
+    for thread in threads:
+        thread.start()
+    start_together.wait(timeout=2)
+    assert first_entered.wait(timeout=2)
+    release_probe.set()
+    for thread in threads:
+        thread.join(timeout=2)
+        assert not thread.is_alive()
+
+    assert calls == 1
+    assert len(results) == 3
+    assert {result["code"] for result in results} == {
+        "searxng_engines_suspended",
+        "searxng_circuit_open",
+    }
+    assert all(result["retryable"] is False for result in results)
+    assert all(result["retry_scope"] == "later_wave" for result in results)
+
+
+def test_concurrent_healthy_searches_are_serialized(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    state_lock = threading.Lock()
+    first_entered = threading.Event()
+    release_first = threading.Event()
+    active = 0
+    maximum_active = 0
+    calls = 0
+
+    def fake_get(*args, **kwargs):
+        nonlocal active, calls, maximum_active
+        with state_lock:
+            calls += 1
+            call_number = calls
+            active += 1
+            maximum_active = max(maximum_active, active)
+        try:
+            if call_number == 1:
+                first_entered.set()
+                assert release_first.wait(timeout=2)
+            return _Response({"results": [], "unresponsive_engines": []})
+        finally:
+            with state_lock:
+                active -= 1
+
+    monkeypatch.setattr(httpx, "get", fake_get)
+    results: list[dict[str, Any]] = []
+
+    def run_search(index: int) -> None:
+        results.append(_provider().search(f"query {index}"))
+
+    threads = [threading.Thread(target=run_search, args=(i,)) for i in range(3)]
+    for thread in threads:
+        thread.start()
+    assert first_entered.wait(timeout=2)
+    release_first.set()
+    for thread in threads:
+        thread.join(timeout=2)
+        assert not thread.is_alive()
+
+    assert calls == 3
+    assert maximum_active == 1
+    assert len(results) == 3
+    assert all(result["success"] is True for result in results)
+

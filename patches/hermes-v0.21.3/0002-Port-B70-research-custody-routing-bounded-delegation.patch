+def _canonical_research_decision_ledger_enum(
+    value: Any, allowed: frozenset[str], fallback: str
+) -> str:
+    """Return only an exact built-in string owned by the closed schema."""
+
+    if type(value) is str:
+        for candidate in allowed:
+            if value == candidate:
+                return candidate
+    return fallback

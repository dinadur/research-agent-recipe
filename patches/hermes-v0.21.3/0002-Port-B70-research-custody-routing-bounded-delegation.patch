+def _travel_route_terminal_command_reason(
+    args: Mapping[str, Any] | None,
+) -> str | None:
+    """Allow only the controlled pipeline and genuinely read-only diagnostics."""
+
+    message = (
+        "Verified travel sessions allow terminal only for the exact travel "
+        "controller, receipt-only publisher, validators, vault resolver/auditor, "
+        "and the read-only pwd/ls/stat/sha256sum diagnostics. Shell chaining, "
+        "redirection, background execution, arbitrary interpreters, renderers, "
+        "and manual evidence/review scripts are blocked."
+    )
+    if not isinstance(args, Mapping):
+        return message
+    command = args.get("command")
+    if (
+        not isinstance(command, str)
+        or not command.strip()
+        or bool(args.get("background"))
+        or _TRAVEL_SHELL_CONTROL_RE.search(command)
+    ):
+        return message
+    try:
+        tokens = shlex.split(command, posix=True)
+    except ValueError:
+        return message
+    if not tokens:
+        return message
+    executable = Path(tokens[0]).name
+    if executable in _TRAVEL_READ_ONLY_COMMANDS:
+        return None
+    if executable not in {"python", "python3"} or len(tokens) < 2:
+        return message
+
+    if tokens[1:3] == ["-m", TRAVEL_RUNNER_MODULE]:
+        if (
+            len(tokens) != 4
+            or Path(tokens[3]).suffix.casefold() != ".json"
+            or not _absolute_path_under_travel_raw(tokens[3])
+        ):
+            return (
+                f"{message} The domain runner accepts exactly one absolute "
+                "schema-version-1 request JSON path under the resolved vault's "
+                "raw/travel directory."
+            )
+        return None
+
+    supplied_script = Path(tokens[1]).expanduser()
+    if not supplied_script.is_absolute():
+        return message
+    allowed_scripts = _travel_script_allowlist()
+    expected_script = allowed_scripts.get(supplied_script.name)
+    try:
+        if expected_script is None or supplied_script.resolve() != expected_script:
+            return message
+    except (OSError, RuntimeError):
+        return message
+
+    script_name = supplied_script.name
+    if script_name == "run_hermes_travel_pipeline.py":
+        if len(tokens) < 4 or not all(
+            _absolute_path_under_travel_raw(value) for value in tokens[2:4]
+        ):
+            return (
+                f"{message} The controller manifest and run directory must be "
+                "absolute paths under the resolved vault's raw/travel directory."
+            )
+        if "--prepare-only" in tokens[4:]:
+            return f"{message} Production-routed runs may not use --prepare-only."
+        option_tokens = tokens[4:]
+        index = 0
+        while index < len(option_tokens):
+            option = option_tokens[index]
+            if option in {"--reuse-valid-extraction", "--reuse-valid-review"}:
+                index += 1
+                continue
+            if option not in {"--max-turns", "--timeout", "--min-included"}:
+                return f"{message} Unsupported controller option: {option!r}."
+            if index + 1 >= len(option_tokens):
+                return f"{message} Controller option {option!r} needs a value."
+            try:
+                value = int(option_tokens[index + 1])
+            except ValueError:
+                return f"{message} Controller option {option!r} must be an integer."
+            limits = {
+                "--max-turns": (1, 4),
+                "--timeout": (1, 600),
+                "--min-included": (1, 12),
+            }
+            lower, upper = limits[option]
+            if not lower <= value <= upper:
+                return (
+                    f"{message} Controller option {option!r} must remain between "
+                    f"{lower} and {upper}."
+                )
+            index += 2
+    elif script_name == "publish_travel.py":
+        if (
+            len(tokens) != 3
+            or Path(tokens[2]).name != "publication-receipt.json"
+            or not _absolute_path_under_travel_raw(tokens[2])
+        ):
+            return (
+                f"{message} The publisher accepts exactly one absolute "
+                "raw/travel/.../publication-receipt.json path."
+            )
+    return None
+
+
+def travel_controller_foreground_timeout_allowed(
+    command: Any,
+    timeout: Any,
+) -> bool:
+    """Authorize the travel controller's narrow 900-second foreground lane.
+
+    The generic terminal cap remains 600 seconds. This is intentionally based
+    on the same exact path/argument allowlist used by travel-route admission so
+    a controller-shaped filename or arbitrary long shell command cannot gain
+    the exception.
+    """
+
+    if (
+        not isinstance(command, str)
+        or not isinstance(timeout, int)
+        or isinstance(timeout, bool)
+        or timeout <= 0
+        or timeout > TRAVEL_CONTROLLER_OUTER_TIMEOUT_SECONDS
+    ):
+        return False
+    args = {"command": command}
+    return bool(
+        _travel_route_is_controller_call(args)
+        and _travel_route_terminal_command_reason(args) is None
+    )
+

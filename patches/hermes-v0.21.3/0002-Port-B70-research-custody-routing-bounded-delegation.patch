+def _comparison_messages(agent):
+    calls = [
+        SimpleNamespace(
+            function=SimpleNamespace(
+                name="web_search",
+                arguments=json.dumps({"query": f"model query {index}", "limit": 5}),
+            )
+        )
+        for index in range(3)
+    ]
+    normalize_generic_research_search_batch(agent, calls)
+    alternatives = ("train", "flying", "driving")
+    urls = {
+        "train": (
+            "https://www.amtrak.com/acela-train",
+            "https://www.amtrak.com/northeast-regional-train",
+        ),
+        "flying": ("https://www.aa.com/booking/find-flights",),
+        "driving": ("https://www.penndot.pa.gov/travel/traffic",),
+    }
+    messages = [{"role": "user", "content": TRAVEL_PROMPT}]
+    search_tool_calls = []
+    for index, (alternative, call) in enumerate(zip(alternatives, calls), start=1):
+        call_id = f"search-{index}"
+        search_tool_calls.append(
+            {
+                "id": call_id,
+                "type": "function",
+                "function": {
+                    "name": "web_search",
+                    "arguments": call.function.arguments,
+                },
+            }
+        )
+    messages.append(
+        {"role": "assistant", "content": "", "tool_calls": search_tool_calls}
+    )
+    for index, alternative in enumerate(alternatives, start=1):
+        messages.append(
+            {
+                "role": "tool",
+                "name": "web_search",
+                "tool_call_id": f"search-{index}",
+                "content": json.dumps(
+                    {
+                        "data": {
+                            "web": [
+                                {"url": url, "title": alternative}
+                                for url in urls[alternative]
+                            ]
+                        }
+                    }
+                ),
+            }
+        )
+    return urls, messages
+
+
+def _append_extract(messages, call_id, urls, label):
+    messages.extend(
+        [
+            {
+                "role": "assistant",
+                "content": "",
+                "tool_calls": [
+                    {
+                        "id": call_id,
+                        "type": "function",
+                        "function": {
+                            "name": "web_extract",
+                            "arguments": json.dumps({"urls": list(urls)}),
+                        },
+                    }
+                ],
+            },
+            {
+                "role": "tool",
+                "name": "web_extract",
+                "tool_call_id": call_id,
+                "content": json.dumps(
+                    {
+                        "results": [
+                            {"url": url, "content": f"{label} evidence {index}"}
+                            for index, url in enumerate(urls, start=1)
+                        ]
+                    }
+                ),
+            },
+        ]
+    )

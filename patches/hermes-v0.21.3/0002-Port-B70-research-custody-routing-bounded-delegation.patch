+"""Task-local enforcement for parallel-research delegation artifacts.
+
+The parallel-research skill is model-visible guidance, but its deliverable and
+retrieval limits are controller policy.  This module deliberately keeps the
+policy independent of prompt wording: activation comes only from a successful
+canonical ``skill_view`` result, task contracts are typed data supplied to the
+existing ``delegate_task`` tool, and each child owns an isolated state machine.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import copy
+import json
+import logging
+import os
+import posixpath
+import re
+import shlex
+import subprocess
+import sys
+import tempfile
+import threading
+import time
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Any, Mapping, Sequence
+from urllib.parse import urlsplit, urlunsplit
+
+
+PARALLEL_RESEARCH_SKILL = "parallel-research"
+PARALLEL_RESEARCH_REQUIRED_VALIDATOR_FLAGS = (
+    b"--require-claim-citations",
+    b"--forbid-unverified",
+    b"--require-atomic-claims",
+)
+VALIDATOR_RELATIVE_PATH = "scripts/validate_research_notes.py"
+RESEARCH_RUN_STAMP_SOURCE = "hermes_time.now"
+LOCAL_DEFAULT_OBSIDIAN_VAULT = "/opt/research-agent/wiki"
+ASYNC_DELEGATION_BATCH_PREFIX = "[ASYNC DELEGATION BATCH COMPLETE"
+_ASYNC_DELEGATION_BATCH_HEADER_RE = re.compile(
+    r"^\[ASYNC DELEGATION BATCH COMPLETE — ([^\]\r\n]+)\]$"
+)
+logger = logging.getLogger(__name__)
+
+MAX_RETRIEVAL_ATTEMPTS = 24
+# Of MAX_RETRIEVAL_ATTEMPTS, this many are reserved for web_extract and cannot
+# be consumed by web_search. Citation provenance requires BOTH a search receipt
+# and a non-empty extract receipt per cited URL, so a single shared pool lets
+# searching starve the half that actually gates validation. Measured 2026-08-21:
+# a 24-attempt shared pool was spent 51 searches to 9 extracts (5.7:1).
+RESERVED_EXTRACT_ATTEMPTS = 8
+# When True, a URL that appeared inside content THIS CHILD already extracted
+# counts as having search provenance, so it may itself be extracted and cited.
+#
+# Default False preserves the 2026-08-03 custody rule exactly. Turning it on
+# does NOT weaken custody: a URL still has to be extracted successfully before
+# it can be cited, so "you may only cite what you actually read" is unchanged.
+# It only widens how a URL may be DISCOVERED - from "a search returned it" to
+# "a search returned it, or a page you already read linked to it".
+#
+# Why it matters: validate_research_notes.py requires >= 3 distinct sources
+# while citation provenance requires every cited URL to carry both a search and
+# an extract receipt. Under the retrieval budget those two gates are jointly
+# unsatisfiable, and children oscillate between them until all three repairs are
+# spent (observed 2026-08-21, probe p5). Link-followed provenance is what makes
+# three fully-receipted sources reachable at all.
+ALLOW_LINK_FOLLOWED_PROVENANCE = True
+# Raised from 3 on 2026-08-21. Children were observed CONVERGING and then being
+# cut off: one went 8 errors -> 1 -> 1 across its three attempts and failed with a
+# single error outstanding. The validation checks are unchanged and no less
+# strict; this only stops ending a repair loop that is visibly succeeding.
+#
+# Each attempt costs a validator run plus a rewrite, so this trades wall-clock for
+# completion. Children already run 600-1000s and the probe hold is 2400s.
+MAX_FINAL_VALIDATION_FAILURES = 6
+MAX_CONSECUTIVE_INCOMPLETE_CHECKPOINTS = 3
+MAX_CONSECUTIVE_UNUSABLE = 3
+SKELETON_TOOL_ITERATION_DEADLINE = 3
+FINAL_ITERATION_RESERVE = 7
+FINAL_WALL_RESERVE_SECONDS = 300.0
+VALIDATOR_FEEDBACK_OUTPUT_LIMIT = 4000
+VALIDATOR_FEEDBACK_MESSAGE_LIMIT = 1000
+OPERATOR_RESEARCH_REQUEST_LIMIT = 4000
+SOURCE_POLICY_UNRESTRICTED = "unrestricted"
+SOURCE_POLICY_OFFICIAL_KUBERNETES_DOCS = "official-kubernetes-docs"
+
+_ISO_DATE_RE = re.compile(r"^20\d{2}-\d{2}-\d{2}$")
+_RESEARCH_RUN_STAMP_RE = re.compile(r"^20\d{2}-\d{2}-\d{2}-\d{4}$")
+_SUBJECT_SLUG_SEPARATOR_RE = re.compile(r"[^a-z0-9]+")
+_SUBJECT_LABEL_SEPARATOR_RE = re.compile(r"[\W_]+", re.UNICODE)
+_HTTPS_CITATION_RE = re.compile(r"https://[^\s)\]>\"']+")
+_WEB_CITATION_RE = re.compile(r"https?://[^\s)\]>\"']+", re.IGNORECASE)
+_KUBERNETES_VERSIONED_DOCS_HOST_RE = re.compile(
+    r"^v\d+-\d+\.docs\.kubernetes\.io$",
+    re.IGNORECASE,
+)
+_KUBERNETES_DOCS_PATH_RE = re.compile(
+    r"^/(?:docs(?:/|$)|[a-z]{2}(?:-[a-z]{2})?/docs(?:/|$))",
+    re.IGNORECASE,
+)
+_OFFICIAL_KUBERNETES_DOCS_PHRASE = (
+    r"official\s+kubernetes\s+(?:documentation|docs)"
+)
+_OFFICIAL_KUBERNETES_DOCS_RESTRICTIVE_RE = tuple(

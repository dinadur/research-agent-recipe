+def _reset_parallel_research_predispatch_decision_ledger(agent: Any) -> None:
+    """Drop the bounded diagnostic without touching research authority."""
+
+    with _PARALLEL_RESEARCH_DECISION_LEDGER_LOCK:
+        agent._parallel_research_predispatch_decision_ledger_turn_id = None
+        agent._parallel_research_predispatch_decision_ledger_entries = []
+        agent._parallel_research_predispatch_decision_ledger_overflowed = False
+        agent._parallel_research_predispatch_decision_ledger_pending_index = None
+
+
+def _initialize_parallel_research_predispatch_decision_ledger(
+    agent: Any, turn_id: str
+) -> None:
+    """Bind an empty canary-only ledger to one exact parent turn."""
+
+    with _PARALLEL_RESEARCH_DECISION_LEDGER_LOCK:
+        _reset_parallel_research_predispatch_decision_ledger(agent)
+        if not _research_decision_ledger_enabled():
+            return
+        agent._parallel_research_predispatch_decision_ledger_turn_id = turn_id

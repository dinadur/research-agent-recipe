+from __future__ import annotations
+
+import json
+
+from agent.web_provider_telemetry import record_web_provider_call
+
+
+def test_records_content_free_request_events(tmp_path, monkeypatch):
+    path = tmp_path / "usage.jsonl"
+    monkeypatch.setenv("HERMES_WEB_PROVIDER_TELEMETRY_PATH", str(path))
+
+    record_web_provider_call("brave-free", "search")
+    record_web_provider_call("tavily", "extract")
+
+    rows = [
+        json.loads(line)
+        for line in path.read_text(encoding="utf-8").splitlines()

diff --git a/plugins/web/searxng/circuit.py b/plugins/web/searxng/circuit.py
new file mode 100644
index 000000000..7acd015ec
--- /dev/null
+++ b/plugins/web/searxng/circuit.py
@@ -0,0 +1,322 @@
+"""Serialized SearXNG requests and bounded suspension cooldown."""
+from __future__ import annotations
+import logging, math, threading
+from time import monotonic as _monotonic, sleep as _sleep
+from typing import Any, Dict
+from plugins.web._common import provider_env
+logger = logging.getLogger(__name__)
+
+# SearXNG fans one request out to several public search engines. Letting each
+# delegation worker hit it independently can turn a short upstream suspension
+# into a process-wide stampede (and SearXNG reports that condition as HTTP 200
+# with ``results=[]``). Serialize requests in this process, space request
+# starts slightly, and open a short local breaker when the JSON response gives
+# strong suspension/challenge evidence. The cooldown is deliberately shorter
+# than the upstream engine suspension: it permits an occasional recovery probe
+# without allowing every worker to probe at once.
+_SEARCH_GATE = threading.BoundedSemaphore(1)
+_SEARCH_STATE_LOCK = threading.Lock()
+_LAST_REQUEST_STARTED_AT = 0.0
+_BREAKER_OPEN_UNTIL = 0.0
+_MIN_REQUEST_INTERVAL_SECONDS = 1.0
+_BREAKER_COOLDOWN_SECONDS = 60.0
+_SEARCH_GATE_TIMEOUT_SECONDS = 17.0
+
+_SUSPENSION_REASON_MARKERS = (
+    "suspended",
+    "too many request",
+    "429",
+    "rate limit",
+    "ratelimit",
+    "captcha",
+    "challenge",
+)
+
+
+def _normalise_unresponsive_engines(value: Any) -> list[dict[str, str]]:
+    """Return SearXNG ``unresponsive_engines`` in a stable bounded shape."""
+    if not isinstance(value, list):
+        return []
+
+    normalised: list[dict[str, str]] = []
+    seen_engines: set[str] = set()
+    for item in value[:32]:
+        engine: Any = None
+        reason: Any = None
+        if isinstance(item, (list, tuple)) and len(item) >= 2:
+            engine, reason = item[0], item[1]
+        elif isinstance(item, dict):
+            engine = item.get("engine", item.get("name"))
+            reason = item.get("reason", item.get("error"))
+        if not isinstance(engine, str) or not isinstance(reason, str):
+            continue
+        engine = engine.strip()
+        reason = reason.strip()
+        engine_key = engine.casefold()
+        if engine and reason and engine_key not in seen_engines:
+            seen_engines.add(engine_key)
+            normalised.append({"engine": engine, "reason": reason})
+    return normalised
+
+
+def _broad_suspension_evidence(data: Dict[str, Any]) -> list[dict[str, str]]:
+    """Detect strong, but intentionally narrow, engine-suspension evidence.
+
+    SearXNG does not expose a per-query count of responsive engines, so an
+    empty result plus one failed engine is *not* enough to call the backend
+    unhealthy. We only trip when every reported failure is suspension-like
+    and either at least two are explicitly suspended or three independent
+    engines report suspension/challenge-class failures. Ordinary zero-result
+    queries, partial engine failures, and responses containing any result keep
+    their historical successful-empty semantics.
+    """
+    results = data.get("results", [])
+    if isinstance(results, list) and results:
+        return []
+    for auxiliary_key in ("answers", "corrections", "infoboxes", "suggestions"):
+        auxiliary_value = data.get(auxiliary_key, [])
+        if not isinstance(auxiliary_value, list) or auxiliary_value:
+            return []
+
+    failures = _normalise_unresponsive_engines(data.get("unresponsive_engines"))
+    if len(failures) < 2:
+        return []
+
+    reasons = [failure["reason"].casefold() for failure in failures]
+    if not all(
+        any(marker in reason for marker in _SUSPENSION_REASON_MARKERS)
+        for reason in reasons
+    ):
+        return []
+
+    explicitly_suspended = sum("suspended" in reason for reason in reasons)
+    if explicitly_suspended < 2 and len(failures) < 3:
+        return []
+    return failures
+
+
+def _breaker_retry_after(now: float | None = None) -> int:
+    """Return whole seconds until the local breaker permits a recovery probe."""
+    if now is None:
+        now = _monotonic()
+    with _SEARCH_STATE_LOCK:
+        remaining = _BREAKER_OPEN_UNTIL - now
+    return max(0, int(math.ceil(remaining)))
+
+
+def _open_breaker(seconds: float = _BREAKER_COOLDOWN_SECONDS) -> int:
+    """Open/extend the process-wide breaker and return its retry delay."""
+    global _BREAKER_OPEN_UNTIL
+    now = _monotonic()
+    with _SEARCH_STATE_LOCK:
+        _BREAKER_OPEN_UNTIL = max(_BREAKER_OPEN_UNTIL, now + max(1.0, seconds))
+        remaining = _BREAKER_OPEN_UNTIL - now
+    return max(1, int(math.ceil(remaining)))
+
+
+def _circuit_open_response(retry_after_seconds: int) -> Dict[str, Any]:
+    return {
+        "success": False,
+        "error": (
+            "SearXNG search is temporarily paused after broad upstream "
+            "engine suspension/challenge signals. This is terminal for the "
+            "current research leg; retry only in a later wave after the "
+            "local cooldown."
+        ),
+        "code": "searxng_circuit_open",
+        "retryable": False,
+        "retry_scope": "later_wave",
+        "retry_after_seconds": max(1, retry_after_seconds),
+    }
+
+
+def _engine_suspension_response(
+    failures: list[dict[str, str]], retry_after_seconds: int
+) -> Dict[str, Any]:
+    return {
+        "success": False,
+        "error": (
+            "SearXNG returned no results and reported broad upstream engine "
+            "suspension/challenge signals. This is terminal for the current "
+            "research leg; retry only in a later wave."
+        ),
+        "code": "searxng_engines_suspended",
+        "retryable": False,
+        "retry_scope": "later_wave",
+        # This is the local breaker delay, not a claim about an upstream
+        # engine's undisclosed suspension duration.
+        "retry_after_seconds": max(1, retry_after_seconds),
+        "details": {
+            "condition": "empty_results_with_broad_suspension_evidence",
+            "unresponsive_engines": failures,
+        },
+    }
+
+
+def _wait_for_rate_slot() -> None:
+    """Space process-wide request starts while holding ``_SEARCH_GATE``."""
+    global _LAST_REQUEST_STARTED_AT
+    with _SEARCH_STATE_LOCK:
+        wait_seconds = max(
+            0.0,
+            _LAST_REQUEST_STARTED_AT
+            + _MIN_REQUEST_INTERVAL_SECONDS
+            - _monotonic(),
+        )
+    if wait_seconds > 0:
+        _sleep(wait_seconds)
+    with _SEARCH_STATE_LOCK:
+        _LAST_REQUEST_STARTED_AT = _monotonic()
+
+
+def _reset_runtime_guard_for_tests() -> None:
+    """Reset time-based guard state; tests call this only while no search runs."""
+    global _BREAKER_OPEN_UNTIL, _LAST_REQUEST_STARTED_AT
+    with _SEARCH_STATE_LOCK:
+        _BREAKER_OPEN_UNTIL = 0.0
+        _LAST_REQUEST_STARTED_AT = 0.0
+
+
+
+
+def guarded_search(query: str, limit: int = 5) -> Dict[str, Any]:
+        """Execute a search against the configured SearXNG instance."""
+        import httpx
+
+        base_url = provider_env("SEARXNG_URL").rstrip("/")
+        if not base_url:
+            return {"success": False, "error": "SEARXNG_URL is not set"}
+
+        # Preserve the search tool's historical successful-empty behavior for
+        # a blank query without spending a rate slot or probing an open
+        # breaker. There is no useful upstream work to perform.
+        if not str(query).strip():
+            return {"success": True, "data": {"web": []}}
+
+        retry_after = _breaker_retry_after()
+        if retry_after:
+            return _circuit_open_response(retry_after)
+
+        # Wait behind the single process-wide probe. A worker that was queued
+        # while another worker discovered suspension re-checks the breaker
+        # after acquiring, so only the first request reaches SearXNG.
+        if not _SEARCH_GATE.acquire(timeout=_SEARCH_GATE_TIMEOUT_SECONDS):
+            return {
+                "success": False,
+                "error": (
+                    "SearXNG search is busy; retry instead of starting "
+                    "another concurrent request."
+                ),
+                "code": "searxng_busy",
+                "retryable": True,
+                "retry_after_seconds": 1,
+            }
+
+        params: Dict[str, Any] = {
+            "q": query,
+            "format": "json",
+            "pageno": 1,
+        }
+
+        try:
+            retry_after = _breaker_retry_after()
+            if retry_after:
+                return _circuit_open_response(retry_after)
+
+            _wait_for_rate_slot()
+
+            try:
+                resp = httpx.get(
+                    f"{base_url}/search",
+                    params=params,
+                    timeout=15,
+                    headers={"Accept": "application/json"},
+                )
+                resp.raise_for_status()
+            except httpx.HTTPStatusError as exc:
+                logger.warning("SearXNG HTTP error: %s", exc)
+                status_code = exc.response.status_code
+                if status_code == 429:
+                    retry_after = _open_breaker()
+                    return {
+                        "success": False,
+                        "error": (
+                            "SearXNG returned HTTP 429 (rate limited). This is "
+                            "terminal for the current research leg; retry only "
+                            "in a later wave."
+                        ),
+                        "code": "searxng_rate_limited",
+                        "retryable": False,
+                        "retry_scope": "later_wave",
+                        "retry_after_seconds": retry_after,
+                    }
+                return {
+                    "success": False,
+                    "error": f"SearXNG returned HTTP {status_code}",
+                }
+            except httpx.RequestError as exc:
+                logger.warning("SearXNG request error: %s", exc)
+                return {
+                    "success": False,
+                    "error": f"Could not reach SearXNG at {base_url}: {exc}",
+                }
+
+            try:
+                data = resp.json()
+            except Exception as exc:  # noqa: BLE001
+                logger.warning("SearXNG response parse error: %s", exc)
+                return {
+                    "success": False,
+                    "error": "Could not parse SearXNG response as JSON",
+                }
+
+            if not isinstance(data, dict):
+                logger.warning("SearXNG response was not a JSON object")
+                return {
+                    "success": False,
+                    "error": "SearXNG response JSON was not an object",
+                }
+
+            # Only strong multi-engine suspension evidence opens the breaker;
+            # an ordinary empty result remains a successful search.
+            suspension_evidence = _broad_suspension_evidence(data)
+            if suspension_evidence:
+                retry_after = _open_breaker()
+                logger.warning(
+                    "SearXNG broad engine suspension detected: %s",
+                    suspension_evidence,
+                )
+                return _engine_suspension_response(
+                    suspension_evidence, retry_after
+                )
+        finally:
+            _SEARCH_GATE.release()
+
+        raw_results = data.get("results", [])
+
+        # SearXNG may return a score field; sort descending and cap to limit.
+        sorted_results = sorted(
+            raw_results,
+            key=lambda r: float(r.get("score", 0)),
+            reverse=True,
+        )[:limit]
+
+        web_results = [
+            {
+                "title": str(r.get("title", "")),
+                "url": str(r.get("url", "")),
+                "description": str(r.get("content", "")),
+                "position": i + 1,
+            }
+            for i, r in enumerate(sorted_results)
+        ]
+
+        logger.info(
+            "SearXNG search '%s': %d results (from %d raw, limit %d)",
+            query,
+            len(web_results),
+            len(raw_results),
+            limit,
+        )
+
+        return {"success": True, "data": {"web": web_results}}

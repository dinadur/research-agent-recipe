+def merge_product_research_skills(existing: Any) -> list[str]:
+    """Prepend reliable-research without duplicating channel-bound skills."""
+
+    if isinstance(existing, str):
+        existing_names = [existing]
+    elif isinstance(existing, (list, tuple)):
+        existing_names = [name for name in existing if isinstance(name, str)]
+    else:
+        existing_names = []
+    merged = list(PRODUCT_RESEARCH_SKILLS)
+    for name in existing_names:
+        if name and name not in merged:
+            merged.append(name)
+    return merged
+

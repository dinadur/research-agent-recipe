+"""Code-owned reference store and row-bound research synthesis.
+
+The ordinary research agent may discover URLs, but this module owns the
+retrieval bytes, immutable source store, evidence-unit selection, synthesis
+schema, citations, and final validation.  A model receives only selected rows
+and may return only bounded prose plus exact row IDs.
+"""
+
+from __future__ import annotations
+
+import argparse
+import asyncio
+import hashlib
+import json
+import os
+import re
+from collections import Counter
+from datetime import date
+from pathlib import Path
+from typing import Any, Awaitable, Callable, Mapping, Sequence
+from urllib.parse import urlsplit, urlunsplit
+
+
+SCHEMA_VERSION = 1
+STORE_KIND = "hermes-code-owned-reference-store"
+ROWS_KIND = "hermes-controller-evidence-rows"
+RECEIPTS_KIND = "hermes-code-owned-retrieval-receipts"
+SYNTHESIS_KIND = "hermes-row-bound-synthesis"
+FACET_SYNTHESIS_KIND = "hermes-facet-row-bound-synthesis"
+EXTRACTIVE_BRIEF_KIND = "hermes-controller-extractive-brief"
+PLANNING_INPUT_KIND = "hermes-reference-store-planning-input"
+PLANNING_VALIDATION_KIND = "hermes-reference-store-planning-validation"
+CANDIDATES_KIND = "hermes-controller-evidence-candidates"
+SEMANTIC_SELECTION_KIND = "hermes-semantic-evidence-selection"
+MIN_ROWS_PER_FACET = 4
+MAX_ROWS_PER_FACET = 6
+MAX_SOURCES_PER_FACET = 2
+MAX_ROWS_PER_SOURCE = 4
+MAX_SOURCE_BYTES = 500_000
+MAX_CANDIDATES_PER_FACET = 48
+MAX_UNIT_CHARS = 420
+MIN_UNITS = 6
+MAX_UNITS = 10
+MIN_FACET_UNITS = 3
+MAX_FACET_UNITS = 4
+MIN_EXTRACTIVE_ROWS = 2
+
+_SHA256_RE = re.compile(r"[0-9a-f]{64}\Z")
+_MARKER_RE = re.compile(r"[A-Z][A-Z0-9_]{0,15}\Z")
+_ROW_ID_RE = re.compile(r"[A-Z][A-Z0-9_]{0,15}-R\d{2}\Z")
+_CANDIDATE_ID_RE = re.compile(r"[A-Z][A-Z0-9_]{0,15}-C\d{3}\Z")
+_DATE_RE = re.compile(r"20\d{2}-\d{2}-\d{2}\Z")
+_CANARY_ID_RE = re.compile(r"soak-20\d{6}-\d{6}\Z")
+_SENTENCE_SPLIT_RE = re.compile(r"(?<=[.!?])\s+")
+_INTERNAL_SENTENCE_BOUNDARY_RE = re.compile(r"[.!?]\s+[A-Z]")
+_WORD_RE = re.compile(r"[A-Za-z0-9][A-Za-z0-9_.+-]*")
+_NUMBER_RE = re.compile(r"(?<![A-Za-z0-9])\d+(?:\.\d+)*(?:%|[A-Za-z]+)?")
+_QUANTITY_RE = re.compile(
+    r"(?<![A-Za-z0-9])(?:\d+(?:\.\d+)*(?:%|[A-Za-z]+)?|"
+    r"zero|one|two|three|four|five|six|seven|eight|nine|ten|eleven|"
+    r"twelve|thirteen|fourteen|fifteen|sixteen|seventeen|eighteen|"
+    r"nineteen|twenty)(?![A-Za-z0-9])",
+    re.IGNORECASE,
+)
+_EMPTY_THINK_RE = re.compile(r"^\s*<think>\s*</think>\s*", re.IGNORECASE)
+_MD_PREFIX_RE = re.compile(
+    r"^\s*(?:#{1,6}\s+|[-*+]\s+|\d+[.)]\s+|>\s+|\|\s*)"
+)
+_BOILERPLATE_RE = re.compile(
+    r"(?:skip to content|table of contents|previous topic|next topic|"
+    r"copyright|navigation|breadcrumbs|edit this page)",
+    re.IGNORECASE,
+)
+_STOPWORDS = {
+    "a", "about", "after", "all", "also", "an", "and", "are", "as",
+    "at", "be", "because", "before", "by", "can", "do", "does", "for",
+    "from", "has", "have", "how", "in", "into", "is", "it", "its",
+    "of", "on", "or", "that", "the", "their", "this", "to", "using",

+            "condition": "https://schema.org/NewCondition",
+            "availability": "https://schema.org/InStock",
+            "fetched_at": "2026-07-20T00:00:00+00:00",
+            "document_sha256": "b" * 64,
+        }
+    return product
+
+
+def test_normalizer_preserves_only_evidenced_identity_and_offer_fields() -> None:
+    records = normalize_results(
+        {
+            "products": [
+                _product("topic_a", "P1", with_offer=True),
+                {"topic_id": "topic_a", "product_id": "P2"},
+            ]
+        }
+    )
+
+    assert len(records) == 1
+    assert records[0].identity.canonical_product_id == "topic_a:P1"
+    assert records[0].identity.gtin is None
+    assert records[0].offers[0].offer_id == "offer-P1"
+
+
+def test_provider_evaluation_separates_durable_and_buy_now_modes(
+    tmp_path,
+) -> None:
+    topics = [
+        {"topic_id": f"topic_{index}", "budget_usd": 250}
+        for index in range(5)
+    ]
+    products = []
+    for topic in topics:
+        products.extend(
+            [
+                _product(topic["topic_id"], "P1", with_offer=False),
+                _product(topic["topic_id"], "P2", with_offer=False),
+            ]
+        )
+    path = tmp_path / "results.json"
+    import json
+
+    path.write_text(json.dumps({"topics": topics, "products": products}), encoding="utf-8")
+
+    result = evaluate_provider(
+        provider="fixture",
+        results_path=path,
+        now=datetime(2026, 7, 20, tzinfo=timezone.utc),
+    )
+
+    assert result["modes"]["durable_comparison"]["passed_topics"] == 5
+    assert result["modes"]["durable_comparison"]["passed"] is True
+    assert result["modes"]["buy_now"]["passed_topics"] == 0
+    assert result["modes"]["buy_now"]["passed"] is False

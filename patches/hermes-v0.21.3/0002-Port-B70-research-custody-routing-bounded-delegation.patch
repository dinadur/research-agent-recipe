+def test_post_skill_decision_ledger_reset_waits_for_ledger_lock(monkeypatch):
+    monkeypatch.setenv("HERMES_CANARY_RESPONSE_DECISION_LEDGER", "1")
+    agent = _decision_ledger_agent()
+    started = threading.Event()
+    finished = threading.Event()
+
+    def reset():
+        started.set()
+        _reset_parallel_research_predispatch_decision_ledger(agent)
+        finished.set()
+
+    with _PARALLEL_RESEARCH_DECISION_LEDGER_LOCK:
+        thread = threading.Thread(target=reset)
+        thread.start()
+        assert started.wait(1)
+        assert not finished.wait(0.05)
+    thread.join(timeout=1)
+
+    assert finished.is_set()

+def _advance_deterministic_rejection_streak(
+    previous: Optional[tuple[tuple[str, str, str], ...]],
+    streak: int,
+    current: Optional[tuple[tuple[str, str, str], ...]],
+) -> tuple[Optional[tuple[tuple[str, str, str], ...]], int]:
+    """Advance only an adjacent identical deterministic-rejection streak."""
+
+    if current is None:
+        return None, 0
+    if current == previous:
+        return current, streak + 1
+    return current, 1

+def test_research_result_scrubs_private_reasoning_and_synthetic_history_everywhere(
+    monkeypatch,
+):
+    """Only the validated answer and legitimate prior turns may escape.
+
+    The returned message list is the TUI's live/resume history source.  The
+    same sanitized history must reach trajectory/session persistence, plugin
+    hooks, external memory, and background review without losing reasoning
+    that belongs to an earlier legitimate turn.
+    """
+    from agent.research_contract import ResearchValidationResult
+
+    post_llm_histories = []
+
+    def invoke_hook(name, **kwargs):
+        if name == "post_llm_call":
+            post_llm_histories.append(kwargs["conversation_history"])
+        return []
+
+    monkeypatch.setattr("hermes_cli.lifecycle.invoke_hook", invoke_hook)
+    monkeypatch.setattr(
+        "agent.research_synthesis.validate_parent_research_synthesis",
+        lambda *_a, **_kw: ResearchValidationResult(True, "valid"),
+    )
+    agent = FakeAgent()
+    _arm_research_result_state(agent)
+    agent._persist_user_message_idx = 2
+    messages = [
+        {"role": "user", "content": "earlier question"},
+        {
+            "role": "assistant",
+            "content": "earlier answer",
+            "reasoning": "LEGITIMATE_PRIOR_REASONING",
+        },
+        {"role": "user", "content": "trusted research completion"},
+        {
+            "role": "assistant",
+            "content": "PRIVATE_FAILED_CANDIDATE",
+            "reasoning": "PRIVATE_SYNTHETIC_REASONING",
+            "_research_synthesis_synthetic": True,
+        },
+        {
+            "role": "user",
+            "content": "PRIVATE_CONTROLLER_NUDGE",
+            "_research_synthesis_synthetic": True,
+        },
+        {
+            "role": "assistant",
+            "content": "",
+            "tool_calls": [
+                {
+                    "id": "call-1",
+                    "function": {"name": "read_file", "arguments": "{}"},
+                }
+            ],
+            "reasoning": "PRIVATE_TOOL_REASONING",
+            "reasoning_content": "PRIVATE_REASONING_CONTENT",
+            "reasoning_details": [{"text": "PRIVATE_REASONING_DETAILS"}],
+            "codex_reasoning_items": [{"encrypted_content": "PRIVATE_CODEX"}],
+            "codex_message_items": [{"type": "reasoning", "text": "PRIVATE_ITEM"}],
+            "thinking_content": "PRIVATE_THINKING",
+            "analysis_details": [{"text": "PRIVATE_ANALYSIS"}],
+        },
+        {
+            "role": "tool",
+            "tool_call_id": "call-1",
+            "name": "read_file",
+            "content": "controller-bound artifact",
+        },
+        {
+            "role": "assistant",
+            "content": "VALIDATED ANSWER",
+            "reasoning": "PRIVATE_FINAL_REASONING",
+            "reasoning_content": "PRIVATE_FINAL_REASONING_CONTENT",
+        },
+    ]
+
+    result = finalize_turn(
+        agent,
+        final_response="VALIDATED ANSWER",
+        api_call_count=3,
+        interrupted=False,
+        failed=False,
+        messages=messages,
+        conversation_history=[],
+        effective_task_id="task",
+        turn_id="result-turn",
+        user_message="trusted research completion",
+        original_user_message="trusted research completion",
+        _should_review_memory=True,
+        _turn_exit_reason="text_response(content)",
+    )
+
+    surfaces = [
+        result["messages"],
+        agent.trajectory_messages,
+        agent.persisted_messages,
+        post_llm_histories[0],
+        agent.external_memory_kwargs["messages"],
+        agent.background_review_kwargs["messages_snapshot"],
+    ]
+    for history in surfaces:
+        assert history[1]["reasoning"] == "LEGITIMATE_PRIOR_REASONING"
+        serialized = repr(history)
+        assert "PRIVATE_" not in serialized
+        assert "_research_synthesis_synthetic" not in serialized
+        current_user_idx = next(
+            index
+            for index, message in enumerate(history)
+            if message.get("content") == "trusted research completion"
+        )
+        for message in history[current_user_idx + 1 :]:
+            if message.get("role") != "assistant":
+                continue
+            assert not any(
+                "reasoning" in str(key).lower()
+                or str(key).lower().startswith(("thinking_", "analysis_"))
+                for key in message
+            )
+
+    assert result["final_response"] == "VALIDATED ANSWER"
+    assert result["last_reasoning"] is None
+    assert result["messages"][-1]["content"] == "VALIDATED ANSWER"

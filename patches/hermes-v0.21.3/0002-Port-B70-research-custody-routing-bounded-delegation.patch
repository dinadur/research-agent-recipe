+from concurrent.futures import ThreadPoolExecutor
+from types import SimpleNamespace
+from tools.research_delegation import _reserve_background_wave, _release_background_wave, attest_research_child
+from tools.process_registry_notifications import format_process_notification
+
+
+def test_wave_reservation_is_atomic_and_failure_releases_only_its_turn():
+    parent=SimpleNamespace(_current_turn_id="turn-a")
+    with ThreadPoolExecutor(max_workers=8) as pool:
+        outcomes=list(pool.map(lambda _: _reserve_background_wave(parent),range(20)))
+    assert sum(allowed for _,allowed in outcomes)==1
+    _release_background_wave(parent,"turn-a")
+    assert _reserve_background_wave(parent)==("turn-a",True)
+    parent._current_turn_id="turn-b"
+    assert _reserve_background_wave(parent)==("turn-b",True)
+    _release_background_wave(parent,"turn-a")
+    assert _reserve_background_wave(parent)==("turn-b",False)
+
+
+def test_control_plane_cancel_revokes_even_existing_completion_attestation():
+    child=SimpleNamespace(_delegate_terminal_cancellation=True)
+    result=attest_research_child(child,{"status":"completed","summary":"partial output","_research_completion_attestation":{"passed":True}})
+    assert result["status"]=="interrupted"
+    assert result["terminal"] is True and result["retryable"] is False
+    assert "_research_completion_attestation" not in result
+    text=format_process_notification(dict(type="async_delegation",delegation_id="cancelled",**result))
+    assert "Do not retry or re-dispatch" in text
+
+
+def test_private_stream_uses_unmanaged_relay_boundary():
+    from agent.chat_completion_helpers import _relay_stream_identity
+    a=SimpleNamespace(session_id="private-session",provider="local",model="local",_parallel_research_defer_candidate_text_for_turn=True)
+    assert _relay_stream_identity(a,"provider")["session_id"]==""
+    a._parallel_research_defer_candidate_text_for_turn=False
+    assert _relay_stream_identity(a,"provider")["session_id"]=="private-session"

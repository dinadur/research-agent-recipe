+
+_RESEARCH_PREFIX_RE = re.compile(r"^\s*research\b", re.IGNORECASE)
+_DURABLE_COMPARISON_MODE_RE = re.compile(
+    r"(?im)^\s*mode\s*:\s*durable_comparison\s*$"
+)
+# "Best practices" asks for procedural guidance, not a ranked product
+# candidate. A later explicit compare/recommend phrase can still select this
+# route, so "best practices ... recommend a laptop" remains product research.
+_COMPARISON_RE = re.compile(

+def _skeleton(*fields: str) -> str:
+    lines = [
+        "---",
+        "entity: Example NAS",
+        "retrieval_date: 2026-07-12",
+        "status: incomplete",
+        "---",
+    ]
+    lines.extend(f"- {field}: unverified" for field in fields)
+    return "\n".join(lines) + "\n"
+
+
+def _final(*fields: str) -> str:
+    return _skeleton(*fields).replace("status: incomplete", "status: complete", 1)
+
+
+def _land_skeleton(
+    controller: ResearchContractController,
+    *fields: str,
+    task_started_monotonic: float | None = None,
+    child_timeout_seconds: float | None = None,
+) -> None:
+    file_state.get_registry().clear()
+    controller.bind_task(
+        "research-test",
+        task_started_monotonic=task_started_monotonic,
+        child_timeout_seconds=child_timeout_seconds,
+    )
+    args = {"path": controller.contract.path, "content": _skeleton(*fields)}
+    assert controller.before_call("write_file", args, iterations_remaining=20) is None
+    content_bytes = args["content"].encode("utf-8")
+    Path(controller.contract.path).write_bytes(content_bytes)
+    file_state.note_write("research-test", controller.contract.path)
+    receipt = json.dumps(
+        {
+            "success": True,
+            "resolved_path": controller.contract.path,
+            "files_modified": [controller.contract.path],
+            "bytes_written": len(content_bytes),
+        }
+    )
+    controller.after_call("write_file", args, receipt, failed=False)
+    assert controller.skeleton_written is True
+
+
+def _successful_exact_write(
+    controller: ResearchContractController,
+    content: str,
+    *,
+    task_id: str = "research-test",
+) -> tuple[dict[str, str], str]:
+    args = {"path": controller.contract.path, "content": content}
+    assert controller.before_call("write_file", args, iterations_remaining=20) is None
+    content_bytes = content.encode("utf-8")
+    Path(controller.contract.path).write_bytes(content_bytes)
+    file_state.note_write(task_id, controller.contract.path)
+    return args, json.dumps(
+        {
+            "success": True,
+            "resolved_path": controller.contract.path,
+            "files_modified": [controller.contract.path],
+            "bytes_written": len(content_bytes),
+        }
+    )

+    r"(?:use|using|with|via|dispatch(?:ing)?|fan(?:ning)?\s+out\s+to)\s+"
+    r"(?:parallel\s+)?(?:research\s+)?(?:workers?|subagents?))\b",
+    re.IGNORECASE,
+)
+_RETRIEVAL_TOOLS = frozenset({"web_search", "web_extract"})
+_ALLOWED_CONTRACT_TOOLS = frozenset(
+    {"write_file", "read_file", "web_search", "web_extract"}
+)
+_FAILED_STATUSES = frozenset(
+    {"blocked", "cancelled", "error", "failed", "timeout", "unavailable"}
+)
+_PARALLEL_RESEARCH_DISPATCH_RESERVATION_LOCK = threading.RLock()
+_PARALLEL_RESEARCH_DECISION_LEDGER_LOCK = threading.RLock()
+RESEARCH_DECISION_LEDGER_ENV = "HERMES_CANARY_RESPONSE_DECISION_LEDGER"
+RESEARCH_DECISION_LEDGER_LOGGER = "hermes.canary.response_decision_ledger"

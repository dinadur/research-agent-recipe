+    "five": "5", "six": "6", "seven": "7", "eight": "8", "nine": "9",
+    "ten": "10", "eleven": "11", "twelve": "12", "thirteen": "13",
+    "fourteen": "14", "fifteen": "15", "sixteen": "16",
+    "seventeen": "17", "eighteen": "18", "nineteen": "19",
+    "twenty": "20",
+}
+_MEASUREMENT_UNIT_PATTERN = (
+    r"characters?|bytes?|bits?|tokens?|seconds?|minutes?|hours?|days?|"
+    r"weeks?|months?|years?|percent|percentages?|kilobytes?|megabytes?|"
+    r"gigabytes?|terabytes?"
+)
+_MEASUREMENT_OBLIGATION_PATTERNS = (
+    re.compile(
+        rf"(?:minimum|maximum|at\s+least|at\s+most|no\s+fewer\s+than|"
+        rf"no\s+more\s+than|up\s+to)\s+(?:of\s+)?(?P<quantity>"
+        rf"{_QUANTITY_RE.pattern})\s+(?:\w+\s+){{0,2}}(?:{_MEASUREMENT_UNIT_PATTERN})",
+        re.IGNORECASE,
+    ),
+    re.compile(
+        rf"(?P<quantity>{_QUANTITY_RE.pattern})\s+(?:{_MEASUREMENT_UNIT_PATTERN})",
+        re.IGNORECASE,
+    ),

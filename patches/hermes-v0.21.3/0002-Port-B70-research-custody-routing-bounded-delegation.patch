+def _configured_obsidian_vault() -> tuple[Path | None, str]:
+    """Resolve the canary override, persistent config, or local default."""
+
+    try:
+        from hermes_cli.config import get_env_value, load_config
+
+        env_value = get_env_value("OBSIDIAN_VAULT_PATH")
+        if env_value is not None:
+            if not isinstance(env_value, str) or not env_value.strip():
+                return None, "invalid-OBSIDIAN_VAULT_PATH"
+            vault_raw = env_value.strip()
+            source = "OBSIDIAN_VAULT_PATH"
+        else:
+            config = load_config()
+            paths = config.get("paths") if isinstance(config, dict) else None
+            if isinstance(paths, dict) and "obsidian_vault" in paths:
+                configured = paths["obsidian_vault"]
+                if not isinstance(configured, str) or not configured.strip():
+                    return None, "invalid-config.paths.obsidian_vault"
+                vault_raw = configured.strip()
+                source = "config.paths.obsidian_vault"
+            elif paths is not None and not isinstance(paths, dict):
+                return None, "invalid-config.paths.obsidian_vault"
+            else:
+                return Path(LOCAL_DEFAULT_OBSIDIAN_VAULT).resolve(), "local-default"
+    except Exception:  # noqa: BLE001 - config is optional in stripped installs
+        env_value = os.environ.get("OBSIDIAN_VAULT_PATH")
+        if env_value is None:
+            return Path(LOCAL_DEFAULT_OBSIDIAN_VAULT).resolve(), "local-default"
+        if not env_value.strip():
+            return None, "invalid-OBSIDIAN_VAULT_PATH"
+        vault_raw = env_value.strip()
+        source = "OBSIDIAN_VAULT_PATH"
+    vault = Path(vault_raw).expanduser()
+    if not vault.is_absolute():
+        return None, f"invalid-{source or 'vault-config'}"
+    return vault.resolve(), source or "vault-config"
+
+
+def _preferred_research_artifact_root() -> tuple[Path | None, str]:
+    """Return the exact model-visible raw-note root for this activation."""
+
+    vault, source = _configured_obsidian_vault()
+    if vault is not None:
+        return (vault / "raw" / "research").resolve(), source
+    return None, source

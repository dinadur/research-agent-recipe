+def _deterministic_nonretryable_rejection_signature(
+    tool_calls: list[Any], tool_result_messages: list[dict[str, Any]]
+) -> Optional[tuple[tuple[str, str, str], ...]]:
+    """Identify a fully rejected research tool batch without call IDs.
+
+    Tool-call IDs change on every model iteration, so they cannot identify a
+    repeated deterministic failure.  The stable signature is the tool name,
+    canonical JSON arguments, and controller rejection code.  Every call in
+    the batch must have an exact fail-closed research-contract result; mixed,
+    malformed, retryable, or executed results deliberately return ``None``.
+    """
+
+    expected: dict[str, tuple[str, str]] = {}
+    for tool_call in tool_calls:
+        tool_call_id = str(getattr(tool_call, "id", "") or "")
+        function = getattr(tool_call, "function", None)
+        tool_name = str(getattr(function, "name", "") or "")
+        raw_arguments = str(getattr(function, "arguments", "") or "")
+        if not tool_call_id or not tool_name:
+            return None
+        try:
+            parsed_arguments = json.loads(raw_arguments)
+        except (TypeError, ValueError, json.JSONDecodeError):
+            return None
+        canonical_arguments = json.dumps(
+            parsed_arguments,
+            ensure_ascii=False,
+            sort_keys=True,
+            separators=(",", ":"),
+        )
+        expected[tool_call_id] = (tool_name, canonical_arguments)
+    if not expected or len(expected) != len(tool_calls):
+        return None
+
+    rejected: list[tuple[str, str, str]] = []
+    observed_ids: set[str] = set()
+    for message in tool_result_messages:
+        if not isinstance(message, dict) or message.get("role") != "tool":
+            continue
+        tool_call_id = str(message.get("tool_call_id") or "")
+        if tool_call_id not in expected or tool_call_id in observed_ids:
+            continue
+        content = str(message.get("content") or "").strip()
+        if content.startswith("<untrusted_tool_result"):
+            opening_line_end = content.find("\n")
+            closing_marker = content.rfind("\n</untrusted_tool_result>")
+            expected_opening = (
+                f'<untrusted_tool_result source="{expected[tool_call_id][0]}">'
+            )
+            if (
+                opening_line_end < 0
+                or closing_marker <= opening_line_end
+                or content[:opening_line_end] != expected_opening
+            ):
+                return None
+            content = content[opening_line_end + 1 : closing_marker]
+            object_start = content.find("{")
+            if object_start < 0:
+                return None
+            content = content[object_start:]
+        try:
+            payload, consumed = json.JSONDecoder().raw_decode(content)
+        except (TypeError, ValueError, json.JSONDecodeError):
+            return None
+        remainder = content[consumed:].strip()
+        if remainder and not (
+            remainder.startswith(
+                "[Tool loop warning: idempotent_no_progress_warning;"
+            )
+            and remainder.endswith("]")
+            and len(remainder) <= 500
+        ):
+            return None
+        if not (
+            isinstance(payload, dict)
+            and isinstance(payload.get("code"), str)
+            and payload["code"].strip()
+            and payload.get("status") == "rejected"
+            and payload.get("executed") is False
+            and payload.get("retryable") is False
+            and payload.get("terminal_failure") is True
+            and payload.get("research_contract") is True
+        ):
+            return None
+        tool_name, canonical_arguments = expected[tool_call_id]
+        rejected.append(
+            (tool_name, canonical_arguments, payload["code"].strip())
+        )
+        observed_ids.add(tool_call_id)
+    if observed_ids != set(expected):
+        return None
+    return tuple(sorted(rejected))
+

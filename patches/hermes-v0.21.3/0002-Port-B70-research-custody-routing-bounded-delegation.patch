+def product_research_first_action_request_overrides(agent: Any) -> dict[str, Any]:
+    """Return the one-call fast-path overrides for initial product research.
+
+    Product API call #1 only needs to emit the controller-prescribed first web
+    action. Disabling template-level thinking and bounding its output prevents
+    a long pre-tool reasoning generation from consuming the full watchdog. The
+    result is computed from current turn/call state rather than stored, so API
+    call #2 and every later analysis/synthesis call automatically return to the
+    production request settings.
+
+    ``extra_body`` is intentional: the OpenAI Python SDK merges its contents
+    into the JSON request body, which is how llama.cpp receives the top-level
+    ``chat_template_kwargs`` field.
+    """
+
+    turn_id = getattr(agent, "_current_turn_id", None)
+    if not (
+        isinstance(turn_id, str)
+        and turn_id
+        and getattr(agent, "_product_research_initial_turn_id", None) == turn_id
+        and getattr(agent, "_api_call_count", 0) == 1
+    ):
+        return {}
+    return {
+        "max_tokens": PRODUCT_RESEARCH_FIRST_ACTION_MAX_TOKENS,
+        "extra_body": {
+            "chat_template_kwargs": {"enable_thinking": False},
+        },
+    }
+

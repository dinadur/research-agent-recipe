+    return bool(
+        isinstance(turn_id, str)
+        and turn_id
+        and getattr(agent, "_product_research_publication_approval_turn_id", None)
+        == turn_id
+    )
+
+
+def product_research_allowed_tools(agent: Any) -> frozenset[str]:
+    if product_research_initial_turn_active(agent):
+        allowed = set(PRODUCT_RESEARCH_ALLOWED_TOOLS)
+        turn_id = getattr(agent, "_current_turn_id", None)
+        if getattr(agent, "_product_research_receipt_turn_id", None) == turn_id:
+            return frozenset()
+        recovery_search_pending = (
+            getattr(
+                agent,
+                "_product_research_provenance_recovery_pending_turn_id",
+                None,
+            )
+            == turn_id
+        )
+        if (
+            getattr(
+                agent,
+                "_product_research_search_budget_exhausted_turn_id",
+                None,
+            )
+            == turn_id
+            and not recovery_search_pending
+        ):
+            allowed.discard("web_search")
+        if (
+            getattr(agent, "_product_research_extract_budget_exhausted_turn_id", None)
+            == turn_id
+        ):
+            allowed.discard("web_extract")
+        return frozenset(allowed)
+    if product_publication_approval_turn_active(agent):
+        return PRODUCT_RESEARCH_PUBLICATION_ALLOWED_TOOLS
+    return frozenset()
+
+
+def constrain_product_research_tool_calls(
+    agent: Any, tool_calls: Any, messages: Any
+) -> tuple[list[Any], dict[str, int]]:
+    """Trim excess retrieval calls before they enter canonical history.
+
+    The receipt helper counts persisted tool-result rows. Enforcing the same
+    budget only inside the executor is too late: a blocked fourth search would
+    still be a fourth ``web_search`` row and invalidate the receipt. Normalize
+    at the provider-response seam, retaining only calls that fit the remaining
+    current-turn budget.
+    """
+
+    calls = list(tool_calls) if isinstance(tool_calls, (list, tuple)) else []
+    if not product_research_initial_turn_active(agent) or not calls:
+        return calls, {}
+
+    # A terminal request cannot validly share a provider response with live
+    # retrieval. The initial route forbids shell work and the receipt helper
+    # can only seal evidence returned by an earlier completed batch. Drop the
+    # terminal side of a mixed response before history is persisted so the
+    # remaining search/extract call can pass through normal source planning.
+    has_retrieval = any(
+        _product_tool_call_name_arguments(call)[0] in {"web_search", "web_extract"}
+        for call in calls
+    )
+    dropped_terminal_detours = 0
+    if has_retrieval:
+        retained_nonterminal: list[Any] = []
+        for call in calls:
+            if _product_tool_call_name_arguments(call)[0] == "terminal":
+                dropped_terminal_detours += 1
+                continue
+            retained_nonterminal.append(call)
+        calls = retained_nonterminal
+
+    # Some providers emit one parallel web_extract call per product even though
+    # the controller budget is defined in batches.  Coalesce a response's
+    # compatible calls into one bounded batch. Providers sometimes emit more
+    # than three URLs across calls; keep the first three unique URLs so the
+    # persisted result remains below the runtime's outer-output spill threshold,
+    # and
+    # leave the second extraction epoch available for independent evidence.
+    extract_calls: list[tuple[int, Any, dict[str, Any], list[str]]] = []
+    extract_extras: dict[str, Any] | None = None
+    combined_urls: list[str] = []
+    combined_canonical: set[str] = set()
+    mergeable = True
+    for index, call in enumerate(calls):
+        name, arguments = _product_tool_call_name_arguments(call)
+        if name != "web_extract":
+            continue
+        requested = arguments.get("urls") if arguments is not None else None
+        if not isinstance(requested, list) or not requested:
+            mergeable = False
+            break
+        safe_urls = []
+        for value in requested:
+            url = _safe_product_https_url(value)
+            if url is None:
+                mergeable = False
+                break
+            safe_urls.append(url)
+        if not mergeable:
+            break
+        extras = {key: value for key, value in arguments.items() if key != "urls"}
+        if extract_extras is None:
+            extract_extras = extras
+        elif extras != extract_extras:
+            mergeable = False
+            break
+        extract_calls.append((index, call, arguments, safe_urls))
+        for url in safe_urls:
+            canonical = _canonical_url(url)
+            if canonical in combined_canonical:
+                continue
+            combined_canonical.add(canonical)
+            combined_urls.append(url)
+
+    coalesced_extract_calls = 0
+    dropped_extract_urls = 0
+    if mergeable and extract_calls and (
+        len(extract_calls) > 1
+        or len(combined_urls) > PRODUCT_RESEARCH_RECOVERY_MAX_URLS
+    ):
+        bounded_urls = combined_urls[:PRODUCT_RESEARCH_RECOVERY_MAX_URLS]
+        _first_index, first_call, first_arguments, _first_urls = extract_calls[0]
+        first_arguments = dict(first_arguments)
+        first_arguments["urls"] = bounded_urls
+        first_call.function.arguments = json.dumps(
+            first_arguments,
+            ensure_ascii=False,
+            separators=(",", ":"),
+        )
+        removed_indexes = {index for index, *_rest in extract_calls[1:]}
+        calls = [
+            call for index, call in enumerate(calls) if index not in removed_indexes
+        ]
+        coalesced_extract_calls = len(removed_indexes)
+        dropped_extract_urls = max(0, len(combined_urls) - len(bounded_urls))
+
+    current_turn_messages = _product_current_turn_messages(messages)
+
+    observed = {"web_search": 0, "web_extract": 0}
+    for message in current_turn_messages:
+        if message.get("role") != "tool":
+            continue
+        name = message.get("name") or message.get("tool_name")
+        if name in observed:
+            observed[str(name)] += 1
+
+    # Search and extraction are ordered state transitions, not a safe parallel
+    # batch. If both appear together, retain the transition that is valid for
+    # the current evidence state: discovery before any search result exists,
+    # otherwise extraction of already-searched URLs. This prevents a speculative
+    # fourth search from consuming the only recovery search before the first
+    # extraction has established a candidate.
+    mixed_searches_dropped = 0
+    mixed_extracts_dropped = 0
+    pending_names = [
+        _product_tool_call_name_arguments(call)[0] for call in calls
+    ]
+    if "web_search" in pending_names and "web_extract" in pending_names:
+        keep_name = "web_search" if observed["web_search"] == 0 else "web_extract"
+        normalized_mixed: list[Any] = []
+        for call in calls:
+            name = _product_tool_call_name_arguments(call)[0]
+            if name == "web_search" and keep_name != "web_search":
+                mixed_searches_dropped += 1
+                continue
+            if name == "web_extract" and keep_name != "web_extract":
+                mixed_extracts_dropped += 1
+                continue
+            normalized_mixed.append(call)
+        calls = normalized_mixed
+
+    # Keep the post-execution observer synchronized with canonical history.
+    # This matters for tests and for any in-process reconstruction where the
+    # messages predate the counters but the current turn remains active.
+    agent._product_research_search_call_count = max(
+        int(getattr(agent, "_product_research_search_call_count", 0) or 0),
+        observed["web_search"],
+    )
+    agent._product_research_extract_call_count = max(
+        int(getattr(agent, "_product_research_extract_call_count", 0) or 0),
+        observed["web_extract"],
+    )
+
+    limits = {
+        "web_search": PRODUCT_RESEARCH_MAX_SEARCH_CALLS,
+        "web_extract": PRODUCT_RESEARCH_MAX_EXTRACT_CALLS,
+    }
+    remaining = {name: max(0, limit - observed[name]) for name, limit in limits.items()}
+    retained: list[Any] = []
+    dropped: dict[str, int] = {}
+    if dropped_terminal_detours:
+        dropped["terminal_mixed_detour"] = dropped_terminal_detours
+    if mixed_searches_dropped:
+        dropped["web_search_mixed_with_extract"] = mixed_searches_dropped
+    if mixed_extracts_dropped:
+        dropped["web_extract_mixed_before_search"] = mixed_extracts_dropped
+    if coalesced_extract_calls:
+        # The caller uses a non-empty normalization report to replace the
+        # provider's original call list before canonical history is written.
+        dropped["web_extract_coalesced"] = coalesced_extract_calls
+    if dropped_extract_urls:
+        dropped["web_extract_urls_dropped"] = dropped_extract_urls
+    admitted = {"web_search": 0, "web_extract": 0}
+    for call in calls:
+        function = getattr(call, "function", None)
+        name = str(getattr(function, "name", "") or "")
+        if name not in limits:
+            retained.append(call)
+            continue
+        if remaining[name] <= 0:
+            dropped[name] = dropped.get(name, 0) + 1
+            continue
+        retained.append(call)
+        remaining[name] -= 1
+        admitted[name] += 1
+
+    return retained, dropped
+
+
+def _product_tool_call_name_arguments(
+    call: Any,
+) -> tuple[str, dict[str, Any] | None]:
+    function = getattr(call, "function", None)
+    name = str(getattr(function, "name", "") or "")
+    raw_arguments = getattr(function, "arguments", None)
+    if not isinstance(raw_arguments, str):
+        return name, None
+    try:
+        arguments = json.loads(raw_arguments)
+    except (TypeError, ValueError, json.JSONDecodeError):
+        return name, None
+    return name, arguments if isinstance(arguments, dict) else None
+
+
+def _safe_product_recovery_url(value: Any) -> str | None:
+    value = _safe_product_https_url(value)
+    if value is None:
+        return None
+    parts = urlsplit(value)
+    host = (parts.hostname or "").casefold().removeprefix("www.")
+    if any(token in host for token in _RECOVERY_FORBIDDEN_HOST_TOKENS):
+        return None
+    return value
+
+
+def _safe_product_https_url(value: Any) -> str | None:
+    if not isinstance(value, str) or not value or len(value) > 4096:
+        return None
+    try:
+        parts = urlsplit(value)
+    except ValueError:
+        return None
+    if (
+        parts.scheme.casefold() != "https"
+        or not parts.hostname
+        or parts.username
+        or parts.password
+    ):
+        return None
+    return value
+
+
+def _product_current_turn_messages(messages: Any) -> list[Mapping[str, Any]]:
+    current: list[Mapping[str, Any]] = []
+    if not isinstance(messages, (list, tuple)):
+        return current
+    for message in reversed(messages):
+        if not isinstance(message, Mapping):
+            continue
+        if message.get("role") == "user":
+            if message.get("_product_research_synthetic") is True:
+                continue
+            break
+        current.append(message)
+    current.reverse()
+    return current
+
+
+def _product_search_url_batches(
+    current_messages: list[Mapping[str, Any]],
+) -> list[list[str]]:
+    batches: list[list[str]] = []
+    for message in current_messages:
+        if message.get("role") != "tool":
+            continue
+        tool_name = message.get("name") or message.get("tool_name")
+        if tool_name != "web_search":
+            continue
+        payload = _tool_payload(message.get("content"))
+        data = payload.get("data") if isinstance(payload, Mapping) else None
+        web = data.get("web") if isinstance(data, Mapping) else None
+        if not isinstance(web, list):
+            continue
+        batch: list[str] = []
+        for result in web:
+            if not isinstance(result, Mapping):
+                continue
+            url = _safe_product_https_url(result.get("url"))
+            if url is not None:
+                batch.append(url)
+        if batch:
+            batches.append(batch)
+    return batches
+
+
+def _product_search_query_records(
+    current_messages: list[Mapping[str, Any]],
+) -> list[tuple[str, list[str]]]:
+    queries: dict[str, str] = {}
+    for message in current_messages:
+        if message.get("role") != "assistant":
+            continue
+        historical_calls = message.get("tool_calls")
+        if not isinstance(historical_calls, list):
+            continue
+        for call in historical_calls:
+            if not isinstance(call, Mapping):
+                continue
+            call_id = call.get("id") or call.get("call_id")
+            function = call.get("function")
+            if not isinstance(call_id, str) or not isinstance(function, Mapping):
+                continue
+            if function.get("name") != "web_search":
+                continue
+            raw = function.get("arguments")
+            try:
+                parsed = json.loads(raw) if isinstance(raw, str) else None
+            except (TypeError, ValueError, json.JSONDecodeError):
+                parsed = None
+            query = parsed.get("query") if isinstance(parsed, Mapping) else None
+            if isinstance(query, str) and query.strip():
+                queries[call_id] = query.strip()
+
+    records: list[tuple[str, list[str]]] = []
+    for message in current_messages:
+        if message.get("role") != "tool":
+            continue
+        tool_name = message.get("name") or message.get("tool_name")
+        call_id = message.get("tool_call_id")
+        if tool_name != "web_search" or not isinstance(call_id, str):
+            continue
+        query = queries.get(call_id)
+        if query is None:
+            continue
+        payload = _tool_payload(message.get("content"))
+        data = payload.get("data") if isinstance(payload, Mapping) else None
+        web = data.get("web") if isinstance(data, Mapping) else None
+        if not isinstance(web, list):
+            continue
+        urls: list[str] = []
+        for result in web:
+            if not isinstance(result, Mapping):
+                continue
+            url = _safe_product_https_url(result.get("url"))
+            if url is not None:
+                urls.append(url)
+        if urls:
+            records.append((query, urls))
+    return records
+
+
+def _product_successful_source_urls(
+    current_messages: list[Mapping[str, Any]],
+) -> set[str]:
+    return set(_product_successful_source_texts(current_messages))
+
+
+def _product_successful_source_texts(
+    current_messages: list[Mapping[str, Any]],
+) -> dict[str, str]:
+    successful: dict[str, str] = {}
+    for message in current_messages:
+        if message.get("role") != "tool":
+            continue
+        tool_name = message.get("name") or message.get("tool_name")
+        if tool_name != "web_extract":
+            continue
+        payload = _tool_payload(message.get("content"))
+        results = payload.get("results") if isinstance(payload, Mapping) else None
+        if not isinstance(results, list):
+            continue
+        for result in results:
+            if not isinstance(result, Mapping) or result.get("error"):
+                continue
+            url = _safe_product_https_url(result.get("url"))
+            content = result.get("content")
+            if url is not None and isinstance(content, str) and content.strip():
+                successful[_canonical_url(url)] = content
+    return successful
+
+
+def _product_successful_extract_url_batches(
+    current_messages: list[Mapping[str, Any]],
+) -> list[tuple[str, ...]]:
+    """Return successful extract URLs grouped by their historical tool batch."""
+
+    batches: list[tuple[str, ...]] = []
+    for message in current_messages:
+        if message.get("role") != "tool":
+            continue
+        tool_name = message.get("name") or message.get("tool_name")
+        if tool_name != "web_extract":
+            continue
+        payload = _tool_payload(message.get("content"))
+        results = payload.get("results") if isinstance(payload, Mapping) else None
+        if not isinstance(results, list):
+            continue
+        batch: list[str] = []
+        for result in results:
+            if not isinstance(result, Mapping) or result.get("error"):
+                continue
+            url = _safe_product_https_url(result.get("url"))
+            content = result.get("content")
+            if url is not None and isinstance(content, str) and content.strip():
+                batch.append(_canonical_url(url))
+        if batch:
+            batches.append(tuple(batch))
+    return batches
+
+
+def _product_host_identity_token(url: str) -> str:
+    labels = [
+        _normalized_token(label)
+        for label in (_host(url) or "").split(".")
+        if _normalized_token(label)
+    ]
+    if len(labels) < 2:
+        return labels[0] if labels else ""
+    if (
+        len(labels) >= 3
+        and len(labels[-1]) == 2
+        and labels[-2] in {"co", "com", "net", "org"}
+    ):
+        return labels[-3]
+    return labels[-2]
+
+
+def _product_query_targets_source_host(query: str, url: str) -> bool:
+    host = _host(url)
+    if any(token in host for token in _OFFICIAL_FORBIDDEN_HOST_TOKENS):
+        return False
+    identity = _product_host_identity_token(url)
+    # A publisher-scoped review search identifies the candidate, not its
+    # manufacturer.  Treating ``site:reviewer.example ... review`` as an
+    # official-source search lets the review family occupy the official slot.
+    if re.search(r"\b(?:independent|review|tested|testing)\b", query, re.IGNORECASE) and not re.search(
+        r"\b(?:official|manufacturer|product\s+page)\b", query, re.IGNORECASE
+    ):
+        scoped_hosts = re.findall(r"\bsite:([^\s]+)", query, re.IGNORECASE)
+        if scoped_hosts or identity not in _normalized_token(query):
+            return False
+    # Short, well-known manufacturer identities such as JBL are valid when
+    # the query contains the exact token. Prefix matching remains restricted
+    # below, so admitting three-character exact matches does not let generic
+    # query fragments establish official-source provenance.
+    if len(identity) < 3:
+        return False
+    words = {
+        _normalized_token(word)
+        for word in re.findall(r"[A-Za-z0-9]+", query)
+        if len(_normalized_token(word)) >= 3
+    }
+    compact_query = _normalized_token(query)
+    return any(
+        word == identity
+        or (len(word) >= 5 and identity.startswith(word))
+        or (len(identity) >= 5 and word.startswith(identity))
+        for word in words
+    ) or (len(identity) >= 5 and identity in compact_query)
+
+
+def _product_query_candidate_tokens(
+    query: str, target_urls: tuple[str, ...] | list[str] = ()
+) -> set[str]:
+    """Extract product/model identity from a manufacturer-focused query."""
+
+    identity_query = _PRODUCT_BUDGET_RE.sub(" ", query)
+    host_identities = {
+        _product_host_identity_token(url)
+        for url in target_urls
+        if isinstance(url, str) and _product_host_identity_token(url)
+    }
+    for host in re.findall(r"\bsite:([^\s]+)", identity_query, flags=re.IGNORECASE):
+        host_identities.add(_product_host_identity_token(f"https://{host}/"))
+    tokens: set[str] = set()
+    for raw in re.findall(
+        r"[A-Za-z0-9]+", re.sub(r"\bsite:[^\s]+", " ", identity_query)
+    ):
+        token = _normalized_token(raw)
+        if (
+            not token
+            or token in host_identities
+            or token in _PRODUCT_CANDIDATE_QUERY_STOPWORDS
+            or (token.isdigit() and len(token) == 4 and 2000 <= int(token) <= 2100)
+            # Short alphanumeric model identities such as Q5, S8, X1, and
+            # V8 are meaningful.  Dropping them collapses distinct products
+            # onto generic suffixes such as "max" or "plus" and can make a
+            # same-brand fallback page look candidate-aligned when it is not.
+            or (len(token) < 3 and not any(c.isdigit() for c in token))
+        ):
+            continue
+        tokens.add(token)
+    path_tokens = {
+        _normalized_token(token)
+        for url in target_urls
+        if isinstance(url, str)
+        for token in re.findall(r"[A-Za-z0-9]+", urlsplit(url).path)
+        if _normalized_token(token)
+    }
+    path_overlap = tokens & path_tokens
+    if path_overlap and any(any(c.isdigit() for c in token) for token in path_overlap):
+        return path_overlap
+    return tokens
+
+
+def _product_candidate_match(
+    candidate_tokens: set[str], url: str, content: str
+) -> bool:
+    """Require a model-specific identity, not just a generic brand/category hit."""
+
+    if not candidate_tokens:
+        return False
+    path = re.sub(r"[^A-Za-z0-9]+", " ", urlsplit(url).path)
+    haystack = {
+        _normalized_token(token)
+        for token in re.findall(r"[A-Za-z0-9]+", f"{path} {content}")
+        if _normalized_token(token)
+    }
+    model_tokens = {token for token in candidate_tokens if any(c.isdigit() for c in token)}
+    distinctive_model_tokens = {
+        token
+        for token in model_tokens
+        if (
+            any(c.isalpha() for c in token) and any(c.isdigit() for c in token)
+        )
+        or (token.isdigit() and len(token) >= 2)
+    }
+    name_tokens = candidate_tokens - model_tokens
+    # When an exact model token such as BE63, Q5, or WH1000XM6 exists, a
+    # category generation such as the ``7`` in "Wi-Fi 7" is not identity.
+    if distinctive_model_tokens:
+        if not (distinctive_model_tokens & haystack):
+            return False
+        return not name_tokens or bool(name_tokens & haystack)
+    if model_tokens:
+        if not (model_tokens & haystack):
+            return False
+        return not name_tokens or bool(name_tokens & haystack)
+    if len(candidate_tokens) >= 2:
+        return len(candidate_tokens & haystack) >= 2
+    token = next(iter(candidate_tokens))
+    return len(token) >= 5 and token in haystack
+
+
+def _product_candidate_budget_supported(
+    source_texts: Mapping[str, str], candidate_tokens: set[str], limit: float
+) -> bool:
+    """Find a candidate-local current price that actually satisfies the budget."""
+
+    floor = min(100.0, max(20.0, float(limit) * 0.15))
+    for url, content in source_texts.items():
+        if not isinstance(url, str) or not isinstance(content, str):
+            continue
+        for match in _PRODUCT_PRICE_RE.finditer(content):
+            line_number = content.count("\n", 0, match.start()) + 1
+            line_start = content.rfind("\n", 0, match.start()) + 1
+            line_end = content.find("\n", match.end())
+            if line_end < 0:
+                line_end = len(content)
+            raw_line = content[line_start:line_end]
+            local_start = match.start() - line_start
+            local_end = match.end() - line_start
+            url_spans = [span.span() for span in _HTTPS_URL_RE.finditer(raw_line)]
+            price_prefix = raw_line[max(0, local_start - 100) : local_start].casefold()
+            price_suffix = raw_line[local_end : local_end + 50].casefold()
+            if (
+                any(start <= local_start < end for start, end in url_spans)
+                or raw_line[:local_start].count("~~") % 2
+                or re.search(
+                    r"\b(?:discounts?|shipping|fees?|savings?|coupon|rebate)"
+                    r"(?:\s+(?:of|is))?\s*[:=-]?\s*$|"
+                    r"\b(?:range[sd]? from|between)\s*$",
+                    price_prefix,
+                )
+                or re.match(
+                    r"\s*(?:off|less|cheaper|more expensive|discount|savings?|"
+                    r"coupon|rebate|shipping|fees?)\b",
+                    price_suffix,
+                )
+            ):
+                continue
+            try:
+                amount = float(match.group("amount").replace(",", ""))
+            except (AttributeError, ValueError):
+                continue
+            if not floor <= amount <= float(limit):
+                continue
+            context_hint, _context_tokens = _product_research_budget_context(
+                content, match.group(0), line_number=line_number
+            )
+            candidate_context = context_hint or content[
+                max(0, match.start() - 350) : match.end() + 250
+            ]
+            if _product_candidate_match(candidate_tokens, url, candidate_context):
+                return True
+    return False
+
+
+def _product_source_mix_state(
+    current_messages: list[Mapping[str, Any]],
+) -> dict[str, Any]:
+    source_texts = _product_successful_source_texts(current_messages)
+    successful = set(source_texts)
+    focused_sources: set[str] = set()
+    records = _product_search_query_records(current_messages)
+    search_result_sources = {
+        _canonical_url(url)
+        for batch in _product_search_url_batches(current_messages)
+        for url in batch
+    }
+    # Collect official/manufacturer-focused sources independently of candidate
+    # selection.  The last focused review query can then select a candidate
+    # while reusing its previously extracted official page.
+    for query, urls in records:
+        for url in urls:
+            canonical = _canonical_url(url)
+            if canonical in successful and _product_query_targets_source_host(
+                query, url
+            ):
+                focused_sources.add(canonical)
+
+    candidate_packets: list[dict[str, Any]] = []
+    for query, urls in records:
+        targeted_urls = tuple(
+            url for url in urls if _product_query_targets_source_host(query, url)
+        )
+        candidate_tokens = _product_query_candidate_tokens(query, targeted_urls)
+        distinctive_candidate_tokens = {
+            token
+            for token in candidate_tokens
+            if (
+                any(c.isalpha() for c in token) and any(c.isdigit() for c in token)
+            )
+            or (token.isdigit() and len(token) >= 2)
+        }
+        if not candidate_tokens or (
+            not targeted_urls and not distinctive_candidate_tokens
+        ):
+            continue
+        product_focused_sources = {
+            url
+            for url in focused_sources
+            if _product_candidate_match(candidate_tokens, url, source_texts[url])
+        }
+        official_families = {
+            _product_source_family(url)
+            for url in product_focused_sources
+            if _product_source_family(url)
+        }
+        independent_sources = {
+            url
+            for url, content in source_texts.items()
+            if _product_source_family(url) not in official_families
+            and not any(
+                token in _normalized_token(_host(url))
+                for token in _INDEPENDENT_FORBIDDEN_HOST_TOKENS
+            )
+            and _product_candidate_match(candidate_tokens, url, content)
+        }
+        candidate_packets.append({
+            "candidate_query": query,
+            "candidate_tokens": candidate_tokens,
+            "product_focused_sources": product_focused_sources,
+            "candidate_independent_sources": independent_sources,
+            "candidate_independent_families": {
+                _product_source_family(url) for url in independent_sources
+            },
+            "candidate_official_families": official_families,
+        })
+    candidate_packet: dict[str, Any] = {}
+    if candidate_packets:
+        candidate_packet = candidate_packets[-1]
+        extract_batches = _product_successful_extract_url_batches(current_messages)
+        if extract_batches:
+            latest_batch = extract_batches[-1]
+            best_score = 0
+            # A comparison can issue several parallel candidate searches before
+            # selecting one.  Bind the receipt to the candidate represented by
+            # the final successful extraction batch, not merely to whichever
+            # parallel search result happened to be persisted last.
+            for packet in candidate_packets:
+                candidate_tokens = packet["candidate_tokens"]
+                score = sum(
+                    1
+                    for url in latest_batch
+                    if _product_candidate_match(
+                        candidate_tokens, url, source_texts.get(url, "")
+                    )
+                )
+                if score >= best_score and score > 0:
+                    best_score = score
+                    candidate_packet = packet
+    return {
+        "successful_sources": successful,
+        "successful_source_texts": source_texts,
+        "successful_hosts": {_host(url) for url in successful},
+        "successful_families": {_product_source_family(url) for url in successful},
+        "brand_focused_sources": focused_sources,
+        "search_records": records,
+        "search_result_sources": search_result_sources,
+        "candidate_query": candidate_packet.get("candidate_query", ""),
+        "candidate_tokens": candidate_packet.get("candidate_tokens", set()),
+        "product_focused_sources": candidate_packet.get(
+            "product_focused_sources", set()
+        ),
+        "candidate_independent_sources": candidate_packet.get(
+            "candidate_independent_sources", set()
+        ),
+        "candidate_independent_families": candidate_packet.get(
+            "candidate_independent_families", set()
+        ),
+        "candidate_official_families": candidate_packet.get(
+            "candidate_official_families", set()
+        ),
+        "candidate_packets": candidate_packets,
+    }
+
+
+_DURABLE_TARGET_SPLIT_RE = re.compile(r"\s+(?:and|versus|vs\.?)\s+", re.IGNORECASE)
+_DURABLE_TARGET_GENERIC_TOKENS = frozenset({
+    "exact",
+    "gen",
+    "generation",
+    "headphone",
+    "headphones",
+    "model",
+    "models",
+    "series",
+    "the",
+})
+
+
+def _durable_comparison_target_labels(original_request: str) -> tuple[str, ...]:
+    """Extract the explicitly compared model labels from a durable request."""
+
+    request_head = original_request.split("\n\n", 1)[0]
+    match = re.search(
+        r"\bcompare(?:\s+the\s+exact)?\s+(?P<labels>.+?)"
+        r"(?:\s+models?)?\s+for\b",
+        request_head,
+        re.IGNORECASE,
+    )
+    if match is None:
+        return ()
+    labels = []
+    for raw in _DURABLE_TARGET_SPLIT_RE.split(match.group("labels")):
+        label = re.sub(
+            r"^\s*(?:the\s+)?(?:exact\s+)?", "", raw, flags=re.IGNORECASE
+        )
+        label = label.strip(" \t,.;:()")
+        if label:
+            labels.append(label)
+    return tuple(labels)
+
+
+def _durable_target_signature(label: str, brand_identity: str) -> tuple[set[str], set[str]]:
+    """Return exact alphanumeric IDs and distinctive name tokens for a model."""
+
+    raw_tokens = re.findall(r"[A-Za-z0-9-]+", label)
+    compact_ids: set[str] = set()
+    for index, raw in enumerate(raw_tokens):
+        compact = _normalized_token(raw)
+        if any(char.isalpha() for char in compact) and any(
+            char.isdigit() for char in compact
+        ):
+            compact_ids.add(compact)
+            if (
+                re.fullmatch(r"\d+(?:st|nd|rd|th)", compact)
+                and index + 1 < len(raw_tokens)
+                and _normalized_token(raw_tokens[index + 1])
+                in {"gen", "generation"}
+            ):
+                compact_ids.add(compact + "gen")
+        elif compact.isdigit() and index > 0:
+            previous = _normalized_token(raw_tokens[index - 1])
+            if previous and previous not in _DURABLE_TARGET_GENERIC_TOKENS:
+                compact_ids.add(previous + compact)
+
+    names = {
+        _normalized_token(raw)
+        for raw in raw_tokens
+        if len(_normalized_token(raw)) >= 4
+        and _normalized_token(raw) != brand_identity
+        and _normalized_token(raw) not in _DURABLE_TARGET_GENERIC_TOKENS
+        and not any(char.isdigit() for char in _normalized_token(raw))
+    }
+    return compact_ids, names
+
+
+_DURABLE_GENERATION_WORDS = {
+    "1": "first",
+    "2": "second",
+    "3": "third",
+    "4": "fourth",
+    "5": "fifth",
+    "6": "sixth",
+    "7": "seventh",
+    "8": "eighth",
+    "9": "ninth",
+    "10": "tenth",
+}
+
+
+def _durable_target_matches_source(
+    label: str, brand_identity: str, url: str, content: str
+) -> bool:
+    """Match one requested durable target, including bounded generation aliases."""
+
+    haystack = _normalized_token(f"{url} {content}")
+    if not haystack or (brand_identity and brand_identity not in haystack):
+        return False
+
+    compact_ids, names = _durable_target_signature(label, brand_identity)
+    generation_ids: set[str] = set()
+    generation_numbers: set[str] = set()
+    for model_id in compact_ids:
+        generation = re.fullmatch(r"(?P<number>\d+)(?:st|nd|rd|th)(?:gen)?", model_id)
+        if generation is not None:
+            generation_ids.add(model_id)
+            generation_numbers.add(generation.group("number"))
+
+    exact_ids = compact_ids - generation_ids
+    if exact_ids and not all(model_id in haystack for model_id in exact_ids):
+        return False
+    if names and not all(name in haystack for name in names):
+        return False
+
+    if generation_ids:
+        generation_aliases = set(generation_ids)
+        for number in generation_numbers:
+            word = _DURABLE_GENERATION_WORDS.get(number)
+            generation_aliases.update({f"gen{number}", f"generation{number}"})
+            if word:
+                generation_aliases.update({f"{word}gen", f"{word}generation"})
+            for name in names:
+                generation_aliases.update({f"{name}{number}", f"{number}{name}"})
+        if not any(alias in haystack for alias in generation_aliases):
+            return False
+
+    return bool(compact_ids or names)
+
+
+def _durable_comparison_source_roles(
+    sources: Any, source_texts: Any, original_request: str
+) -> tuple[tuple[str, str], ...]:
+    """Choose one official per target and two cross-target independent sources."""
+
+    if not isinstance(sources, (list, tuple)) or not isinstance(source_texts, Mapping):
+        return ()
+    labels = _durable_comparison_target_labels(original_request)
+    if len(labels) < 2:
+        return ()
+    ordered_sources = list(dict.fromkeys(
+        _canonical_url(url)
+        for url in sources
+        if isinstance(url, str) and url.startswith("https://")
+    ))
+    canonical_texts = {
+        _canonical_url(url): content
+        for url, content in source_texts.items()
+        if isinstance(url, str) and isinstance(content, str) and content.strip()
+    }
+
+    official: list[str] = []
+    used: set[str] = set()
+    for label in labels:
+        first_word = re.search(r"[A-Za-z0-9]+", label)
+        identity = _normalized_token(first_word.group(0)) if first_word else ""
+        match = next(
+            (
+                url
+                for url in ordered_sources
+                if url not in used
+                and url in canonical_texts
+                and _official_host_matches_brand(identity, url)
+                and _durable_target_matches_source(
+                    label, identity, url, canonical_texts[url]
+                )
+            ),
+            None,
+        )
+        if match is None:
+            return ()
+        official.append(match)
+        used.add(match)
+
+    official_families = {_product_source_family(url) for url in official}
+    independent: list[str] = []
+    independent_families: set[str] = set()
+    for url in ordered_sources:
+        family = _product_source_family(url)
+        if (
+            url in used
+            or url not in canonical_texts
+            or not family
+            or family in official_families
+            or family in independent_families
+            or any(
+                token in _normalized_token(_host(url))
+                for token in _INDEPENDENT_FORBIDDEN_HOST_TOKENS
+            )
+        ):
+            continue
+        if not all(
+            _durable_target_matches_source(
+                label,
+                _normalized_token(re.search(r"[A-Za-z0-9]+", label).group(0)),
+                url,
+                canonical_texts[url],
+            )
+            for label in labels
+        ):
+            continue
+        independent.append(url)
+        independent_families.add(family)
+        if len(independent) == 2:
+            break
+    if len(independent) < 2:
+        return ()
+    return tuple(
+        [(url, "official") for url in official]
+        + [(url, "independent") for url in independent]
+    )
+
+
+def _durable_comparison_independent_families(
+    mix: Mapping[str, Any], original_request: str
+) -> set[str]:
+    """Return independent families that cover every explicitly requested target."""
+
+    labels = _durable_comparison_target_labels(original_request)
+    source_texts = mix.get("successful_source_texts", {})
+    if len(labels) < 2 or not isinstance(source_texts, Mapping):
+        return set()
+
+    available_identities = {
+        _product_host_identity_token(url)
+        for url in source_texts
+        if isinstance(url, str) and _product_host_identity_token(url)
+    }
+    targets: list[tuple[str, str]] = []
+    for label in labels:
+        label_words = {
+            _normalized_token(word)
+            for word in re.findall(r"[A-Za-z0-9]+", label)
+            if _normalized_token(word)
+        }
+        identity = next(
+            (
+                candidate
+                for candidate in available_identities
+                if candidate in label_words
+            ),
+            "",
+        )
+        if not identity:
+            first_word = re.search(r"[A-Za-z0-9]+", label)
+            identity = _normalized_token(first_word.group(0)) if first_word else ""
+        targets.append((label, identity))
+
+    families: set[str] = set()
+    brand_identities = {identity for _label, identity in targets if identity}
+    for raw_url, content in source_texts.items():
+        if not isinstance(raw_url, str) or not isinstance(content, str):
+            continue
+        family = _product_source_family(raw_url)
+        if (
+            not family
+            or any(
+                token in _normalized_token(_host(raw_url))
+                for token in _INDEPENDENT_FORBIDDEN_HOST_TOKENS
+            )
+            or any(
+                _official_host_matches_brand(identity, raw_url)
+                for identity in brand_identities
+            )
+        ):
+            continue
+        if all(
+            _durable_target_matches_source(label, identity, raw_url, content)
+            for label, identity in targets
+        ):
+            families.add(family)
+    return families
+
+
+def _product_independent_families_for_request(
+    mix: Mapping[str, Any], original_request: str
+) -> set[str]:
+    """Select the durable target matcher without changing commerce admission."""
+
+    if _product_research_durable_comparison_mode(original_request):
+        return _durable_comparison_independent_families(mix, original_request)
+    return {
+        family
+        for family in mix.get("candidate_independent_families", set())
+        if isinstance(family, str)
+    }
+
+
+def _durable_comparison_official_model_coverage(
+    mix: Mapping[str, Any], original_request: str
+) -> tuple[tuple[str, ...], tuple[str, ...]]:
+    """Require one exact extracted official page for every durable target."""
+
+    labels = _durable_comparison_target_labels(original_request)
+    if not labels:
+        return (), ()
+
+    source_texts = mix.get("successful_source_texts", {})
+    official_by_identity: dict[str, set[str]] = {}
+    if isinstance(source_texts, Mapping):
+        # Every web_extract call has already passed the current-turn searched-
+        # URL provenance guard before execution.  Reconstructing that custody a
+        # second time here from transient query/call-ID links caused live-only
+        # false negatives even though the persisted turn replayed as valid.
+        # Exact brand-host and model-signature checks remain local to each
+        # successfully extracted URL.
+        for raw_url in source_texts:
+            if not isinstance(raw_url, str):
+                continue
+            url = _safe_product_https_url(raw_url)
+            if url is None:
+                continue
+            canonical = _canonical_url(url)
+            if any(token in _host(url) for token in _OFFICIAL_FORBIDDEN_HOST_TOKENS):
+                continue
+            identity = _product_host_identity_token(url)
+            if identity:
+                official_by_identity.setdefault(identity, set()).add(canonical)
+
+    identities = tuple(sorted(official_by_identity))
+    previous_identity = ""
+    missing: list[str] = []
+    for label in labels:
+        label_words = {
+            _normalized_token(word)
+            for word in re.findall(r"[A-Za-z0-9]+", label)
+        }
+        identity = next(
+            (candidate for candidate in identities if candidate in label_words),
+            previous_identity,
+        )
+        if identity:
+            previous_identity = identity
+        compact_ids, names = _durable_target_signature(label, identity)
+        covered = False
+        for url in official_by_identity.get(identity, set()):
+            haystack = _normalized_token(f"{url} {source_texts.get(url, '')}")
+            ids_match = bool(compact_ids) and all(
+                model_id in haystack for model_id in compact_ids
+            )
+            names_match = not names or all(name in haystack for name in names)
+            if ids_match and names_match:
+                covered = True
+                break
+        if not covered:
+            missing.append(label)
+    return labels, tuple(missing)
+
+
+def _durable_comparison_draft_target_coverage(
+    text: str, original_request: str
+) -> tuple[tuple[str, ...], tuple[str, ...]]:
+    """Require every exact durable target in the authored comparison rows."""
+
+    labels = _durable_comparison_target_labels(original_request)
+    section = re.search(
+        r"(?ims)^## Compared options\s*$\s*(?P<body>.*?)(?=^##\s|\Z)", text
+    )
+    if not labels or section is None:
+        return labels, labels
+
+    # Receipt URLs and controller-expanded evidence excerpts can contain a model
+    # name even when the authored comparison does not.  Exclude both so this
+    # check proves that the draft itself names every requested target.
+    authored = _EVIDENCE_RE.sub("", section.group("body"))
+    authored = _HTTPS_URL_RE.sub("", authored)
+    missing: list[str] = []
+    for label in labels:
+        first_word = re.search(r"[A-Za-z0-9]+", label)
+        identity = _normalized_token(first_word.group(0)) if first_word else ""
+        if not _durable_target_matches_source(label, identity, "", authored):
+            missing.append(label)
+    return labels, tuple(missing)
+
+
+_QUALITY_FIRST_TARGET_GENERIC_TOKENS = frozenset({
+    "current",
+    "edition",
+    "gen",
+    "generation",
+    "model",
+    "pack",
+    "portable",
+    "pro",
+    "series",
+    "signature",
+    "the",
+    "three",
+    "two",
+})
+
+
+def _quality_first_target_coverage(
+    mix: Mapping[str, Any], original_request: str
+) -> tuple[tuple[str, ...], tuple[str, ...]]:
+    """Require at least one extracted row for every named alternative."""
+
+    from agent.quality_first_route import extract_targets
+
+    targets = tuple(extract_targets(original_request))
+    source_texts = mix.get("successful_source_texts", {})
+    if len(targets) < 2 or not isinstance(source_texts, Mapping):
+        return targets, targets
+    haystacks = [
+        _normalized_token(f"{url} {content}")
+        for url, content in source_texts.items()
+        if isinstance(url, str) and isinstance(content, str) and content.strip()
+    ]
+    missing: list[str] = []
+    for target in targets:
+        raw_tokens = [
+            _normalized_token(token)
+            for token in re.findall(r"[A-Za-z0-9-]+", target)
+        ]
+        tokens = [
+            token
+            for token in raw_tokens
+            if len(token) >= 3
+            and token not in _QUALITY_FIRST_TARGET_GENERIC_TOKENS
+            and not re.fullmatch(r"20\d{2}", token)
+        ]
+        brand = tokens[0] if tokens else ""
+        identifiers = [
+            token
+            for token in tokens[1:]
+            if any(char.isdigit() for char in token) or len(token) >= 4
+        ]
+        covered = any(
+            brand
+            and brand in haystack
+            and (not identifiers or any(token in haystack for token in identifiers))
+            for haystack in haystacks
+        )
+        if not covered:
+            missing.append(target)
+    return targets, tuple(missing)
+
+
+def _quality_first_independent_families(
+    mix: Mapping[str, Any], original_request: str
+) -> set[str]:
+    """Count independent families across the whole comparison, not one winner."""
+
+    from agent.quality_first_route import extract_targets
+
+    brand_tokens = {
+        _normalized_token(re.findall(r"[A-Za-z0-9-]+", target)[0])
+        for target in extract_targets(original_request)
+        if re.findall(r"[A-Za-z0-9-]+", target)
+    }
+    families: set[str] = set()
+    source_texts = mix.get("successful_source_texts", {})
+    if not isinstance(source_texts, Mapping):
+        return families
+    for url in source_texts:
+        if not isinstance(url, str):
+            continue
+        host = _normalized_token(_host(url))
+        family = _product_source_family(url)
+        if (
+            family
+            and not any(token in host for token in brand_tokens)
+            and not any(
+                token in host
+                for token in _QUALITY_FIRST_INDEPENDENT_FORBIDDEN_HOST_TOKENS
+            )
+        ):
+            families.add(family)
+    return families
+
+
+def _product_receipt_viability(
+    mix: Mapping[str, Any], original_request: str
+) -> tuple[bool, tuple[str, ...]]:
+    reasons: list[str] = []
+    if len(mix.get("successful_sources", set())) < 3 or len(
+        mix.get("successful_families", set())
+    ) < 3:
+        reasons.append("source_mix_incomplete")
+    quality_targets, quality_missing = _quality_first_target_coverage(
+        mix, original_request
+    ) if _product_research_quality_first_environment_enabled() else ((), ())
+    quality_multi_target = len(quality_targets) >= 2
+    candidate_tokens = {
+        token for token in mix.get("candidate_tokens", set()) if isinstance(token, str)
+    }
+    if quality_multi_target:
+        if quality_missing:
+            reasons.append("quality_first_target_evidence_missing")
+        independent_families = _quality_first_independent_families(
+            mix, original_request
+        )
+    else:
+        if not candidate_tokens or not mix.get("product_focused_sources", set()):
+            reasons.append("official_product_evidence_missing")
+        independent_families = _product_independent_families_for_request(
+            mix, original_request
+        )
+    if len(independent_families) < 2:
+        reasons.append("independent_candidate_evidence_too_thin")
+    if _product_research_durable_comparison_mode(original_request):
+        durable_targets, durable_missing = (
+            _durable_comparison_official_model_coverage(mix, original_request)
+        )
+        if len(durable_targets) < 2 or durable_missing:
+            reasons.append("durable_official_model_evidence_missing")
+    budget = next(
+        (
+            constraint
+            for constraint in _product_research_constraints(original_request)
+            if constraint.get("constraint_id") == "budget"
+        ),
+        None,
+    )
+    if not quality_multi_target and budget is not None and (
+        not candidate_tokens
+        or not _product_candidate_budget_supported(
+            mix.get("successful_source_texts", {}),
+            candidate_tokens,
+            float(budget["limit"]),
+        )
+    ):
+        reasons.append("candidate_budget_missing")
+    return not reasons, tuple(reasons)
+
+
+def _product_viability_nudge(reasons: tuple[str, ...]) -> str:
+    if "quality_first_target_evidence_missing" in reasons:
+        return (
+            "[System: Do not seal the quality-first evidence packet yet. At least "
+            "one explicitly named alternative has no successfully extracted source. "
+            "Use the remaining bounded search/extract capacity for the missing "
+            "alternative(s). Prefer exact official pages for specifications and "
+            "independent pages for limitations. Do not choose a winner or answer yet.]"
+        )
+    if "durable_official_model_evidence_missing" in reasons:
+        return (
+            "[System: Do not seal the durable product receipt yet. Every exact "
+            "model named by the operator requires its own successfully extracted "
+            "official manufacturer page. Extract the exact official URLs already "
+            "returned by search. A sibling product, another model from the same "
+            "brand, or an independent comparison cannot substitute.]"
+        )
+    if "candidate_budget_missing" in reasons:
+        return (
+            "[System: Do not seal the product receipt yet. The focused candidate "
+            "does not have extracted, candidate-matched evidence of a current price "
+            "within the operator's budget. Choose an in-budget candidate explicitly "
+            "supported by the broad evidence already returned. Use one combined "
+            "web_search for that exact model's official product page, independent "
+            "review, and current price, then web_extract exact returned URLs.]"
+        )
+    if "official_product_evidence_missing" in reasons:
+        return (
+            "[System: Do not seal the product receipt yet. Choose the leading "
+            "candidate from the extracted evidence, then use one combined web_search "
+            "for that exact model's official product page, independent review, and "
+            "current price. Extract only exact returned URLs; a generic brand page "
+            "does not establish product evidence.]"
+        )
+    return (
+        "[System: Do not seal the product receipt yet. The intended candidate is "
+        "not supported by two independent extracted source families. Use one "
+        "combined web_search for the exact model, an independent review, its official "
+        "product page, and current price, then web_extract exact returned URLs.]"
+    )
+
+
+def prepare_product_research_controller_receipt(
+    agent: Any, tool_calls: Any, messages: Any
+) -> tuple[dict[str, Any] | None, dict[str, Any] | None]:
+    """Seal a receipt-ready product source set without another model epoch.
+
+    The receipt is a deterministic transition, not a research decision. Once
+    the latest executed batch contains an extraction and the current turn has
+    one search-proven official source plus two independent source families,
+    return the exact receipt arguments for controller execution. The model
+    remains responsible for search queries, URL selection, evidence-row
+    selection, and recommendation prose; it no longer has to remember or copy
+    a privileged terminal command after retrieval is already complete.
+    """
+
+    calls = list(tool_calls) if isinstance(tool_calls, (list, tuple)) else []
+    turn_id = getattr(agent, "_current_turn_id", None)
+    if not (
+        product_research_initial_turn_active(agent)
+        and getattr(agent, "api_mode", "chat_completions") == "chat_completions"
+        and isinstance(turn_id, str)
+        and turn_id
+        and getattr(agent, "_product_research_receipt_turn_id", None) != turn_id
+        and getattr(
+            agent,
+            "_product_research_controller_receipt_turn_id",
+            None,
+        )
+        != turn_id
+        and isinstance(messages, (list, tuple))
+        and any(
+            _product_tool_call_name_arguments(call)[0] == "web_extract"
+            for call in calls
+        )
+    ):
+        return None, None
+
+    current_messages = _product_current_turn_messages(messages)
+    mix = _product_source_mix_state(current_messages)
+    successful = mix["successful_sources"]
+    original_request = _product_research_original_request(messages)
+    ready, viability_reasons = _product_receipt_viability(mix, original_request)
+    independent_families = _product_independent_families_for_request(
+        mix, original_request
+    )
+    if not ready:
+        search_count = len(mix["search_records"])
+        extract_count = sum(
+            1
+            for message in current_messages
+            if message.get("role") == "tool"
+            and (message.get("name") or message.get("tool_name")) == "web_extract"
+        )
+        nudge_count = int(
+            getattr(agent, "_product_research_source_mix_nudge_count", 0) or 0
+        )
+        if (
+            len(successful) >= 3
+            and nudge_count < PRODUCT_RESEARCH_SOURCE_MIX_NUDGE_LIMIT
+            and search_count < PRODUCT_RESEARCH_MAX_SEARCH_CALLS
+            and extract_count < PRODUCT_RESEARCH_MAX_EXTRACT_CALLS
+        ):
+            agent._product_research_source_mix_nudge_count = nudge_count + 1
+            return None, {
+                "mode": "controller_receipt_deferred",
+                "viability_reasons": list(viability_reasons),
+                "candidate_query": mix["candidate_query"],
+                "candidate_tokens": sorted(mix["candidate_tokens"]),
+                "successful_sources": len(successful),
+                "successful_families": len(mix["successful_families"]),
+                "product_focused_sources": len(mix["product_focused_sources"]),
+                "candidate_independent_families": len(independent_families),
+                "search_calls": search_count,
+                "extract_calls": extract_count,
+                "nudge": _product_viability_nudge(viability_reasons),
+            }
+        return None, None
+
+    receipt_command = bound_product_research_receipt_command(agent.session_id)
+    agent._product_research_controller_receipt_turn_id = turn_id
+    return (
+        {"command": receipt_command, "timeout": 30},
+        {
+            "mode": "controller_auto_receipt",
+            "successful_sources": len(successful),
+            "successful_hosts": len(mix["successful_hosts"]),
+            "successful_families": len(mix["successful_families"]),
+            "brand_focused_sources": len(mix["brand_focused_sources"]),
+            "product_focused_sources": len(mix["product_focused_sources"]),
+            "candidate_independent_families": len(independent_families),
+            "search_calls": len(mix["search_records"]),
+            "extract_calls": sum(
+                1
+                for message in current_messages
+                if message.get("role") == "tool"
+                and (message.get("name") or message.get("tool_name"))
+                == "web_extract"
+            ),
+        },
+    )
+
+
+def _quality_first_balance_initial_extract(
+    mix: Mapping[str, Any],
+    original_request: str,
+    requested_urls: list[str],
+    extract_count: int,
+) -> tuple[list[str], dict[str, Any] | None]:
+    """Reserve the second extraction batch for independent comparison evidence.
+
+    A three-product quality-first comparison has exactly three URLs available
+    in each extraction batch.  If the model spends the first batch on three
+    pages for one product, the remaining batch cannot both cover the other two
+    named products and establish two independent publisher families.  Balance
+    only this first batch, using one exact URL from each target-specific search.
+    No URL is invented and the bounded search/extract budgets are unchanged.
+    """
+
+    if (
+        not _product_research_quality_first_environment_enabled()
+        or extract_count != 0
+    ):
+        return requested_urls, None
+
+    from agent.quality_first_route import extract_targets
+
+    targets = tuple(extract_targets(original_request))
+    records = mix.get("search_records")
+    if (
+        len(targets) < 2
+        or len(targets) > PRODUCT_RESEARCH_RECOVERY_MAX_URLS
+        or not isinstance(records, list)
+    ):
+        return requested_urls, None
+
+    requested = {
+        _canonical_url(url)
+        for url in requested_urls
+        if _safe_product_https_url(url) is not None
+    }
+    selected: list[str] = []
+    selected_canonical: set[str] = set()
+    selected_families: set[str] = set()
+
+    for target in targets:
+        tokens = [
+            _normalized_token(token)
+            for token in re.findall(r"[A-Za-z0-9-]+", target)
+            if len(_normalized_token(token)) >= 3
+            and _normalized_token(token) not in _QUALITY_FIRST_TARGET_GENERIC_TOKENS
+            and not re.fullmatch(r"20\d{2}", _normalized_token(token))
+        ]
+        if not tokens:
+            return requested_urls, None
+        brand = tokens[0]
+        candidates: list[str] = []
+        seen: set[str] = set()
+        for record in records:
+            if not (
+                isinstance(record, tuple)
+                and len(record) == 2
+                and isinstance(record[0], str)
+                and isinstance(record[1], list)
+            ):
+                continue
+            query, urls = record
+            normalized_query = _normalized_token(query)
+            if not all(token in normalized_query for token in tokens):
+                continue
+            for value in urls:
+                url = _safe_product_recovery_url(value)
+                if url is None:
+                    continue
+                canonical = _canonical_url(url)
+                if canonical not in seen:
+                    candidates.append(url)
+                    seen.add(canonical)
+        if not candidates:
+            return requested_urls, None
+
+        candidates.sort(
+            key=lambda url: (
+                not _official_host_matches_brand(brand, url),
+                _canonical_url(url) not in requested,
+            )
+        )
+        choice = next(
+            (
+                url
+                for url in candidates
+                if _canonical_url(url) not in selected_canonical
+            ),
+            None,
+        )
+        if choice is None:
+            return requested_urls, None
+        canonical = _canonical_url(choice)
+        selected.append(choice)
+        selected_canonical.add(canonical)
+        family = _product_source_family(canonical)
+        if family:
+            selected_families.add(family)
+
+    if len(selected) < PRODUCT_RESEARCH_RECOVERY_MAX_URLS:
+        extras: list[str] = list(requested_urls)
+        extras.extend(
+            value
+            for record in records
+            if isinstance(record, tuple)
+            and len(record) == 2
+            and isinstance(record[1], list)
+            for value in record[1]
+        )
+        for value in extras:
+            url = _safe_product_recovery_url(value)
+            if url is None:
+                continue
+            canonical = _canonical_url(url)
+            family = _product_source_family(canonical)
+            if (
+                canonical in selected_canonical
+                or not family
+                or family in selected_families
+            ):
+                continue
+            selected.append(url)
+            selected_canonical.add(canonical)
+            selected_families.add(family)
+            if len(selected) == PRODUCT_RESEARCH_RECOVERY_MAX_URLS:
+                break
+
+    if [_canonical_url(url) for url in selected] == [
+        _canonical_url(url) for url in requested_urls
+    ]:
+        return requested_urls, None
+    return selected, {
+        "mode": "quality_first_initial_extract_balanced",
+        "named_targets": len(targets),
+        "rewritten_urls": len(selected),
+    }
+
+
+def _quality_first_balance_final_extract(
+    mix: Mapping[str, Any],
+    original_request: str,
+    requested_urls: list[str],
+    extract_count: int,
+) -> tuple[list[str], dict[str, Any] | None]:
+    """Fill the final batch with distinct non-brand publisher families.
+
+    The legacy candidate planner classifies a URL as independent when it was
+    not found by an official-source query.  A manufacturer's shop or forum can
+    therefore look independent when returned by a review query.  Quality-first
+    receipt admission correctly excludes every named brand host; make the
+    planner use that same rule before the last extraction budget is consumed.
+    """
+
+    if (
+        not _product_research_quality_first_environment_enabled()
+        or extract_count != PRODUCT_RESEARCH_MAX_EXTRACT_CALLS - 1
+    ):
+        return requested_urls, None
+
+    from agent.quality_first_route import extract_targets
+
+    targets = tuple(extract_targets(original_request))
+    records = mix.get("search_records")
+    if len(targets) < 2 or not isinstance(records, list):
+        return requested_urls, None
+
+    brand_tokens = {
+        _normalized_token(words[0])
+        for target in targets
+        if (words := re.findall(r"[A-Za-z0-9-]+", target))
+    }
+    successful = {
+        _canonical_url(url)
+        for url in mix.get("successful_source_texts", {})
+        if isinstance(url, str)
+    }
+    existing_families = _quality_first_independent_families(
+        mix, original_request
+    )
+
+    def independent_url(value: Any) -> str | None:
+        url = _safe_product_recovery_url(value)
+        if url is None:
+            return None
+        host = _normalized_token(_host(url))
+        if any(token in host for token in brand_tokens) or any(
+            token in host
+            for token in _QUALITY_FIRST_INDEPENDENT_FORBIDDEN_HOST_TOKENS
+        ):
+            return None
+        return url
+
+    candidates: list[str] = []
+    candidates.extend(requested_urls)
+    for record in records:
+        if not (
+            isinstance(record, tuple)
+            and len(record) == 2
+            and isinstance(record[1], list)
+        ):
+            continue
+        candidates.extend(record[1])
+
+    planned: list[str] = []
+    planned_canonical: set[str] = set()
+    planned_families: set[str] = set(existing_families)
+    for value in candidates:
+        url = independent_url(value)
+        if url is None:
+            continue
+        canonical = _canonical_url(url)
+        family = _product_source_family(canonical)
+        if (
+            canonical in successful
+            or canonical in planned_canonical
+            or not family
+            or family in planned_families
+        ):
+            continue
+        planned.append(url)
+        planned_canonical.add(canonical)
+        planned_families.add(family)
+        if len(planned) == PRODUCT_RESEARCH_RECOVERY_MAX_URLS:
+            break
+
+    if len(planned_families) < 2:
+        return requested_urls, None
+    if [_canonical_url(url) for url in planned] == [
+        _canonical_url(url) for url in requested_urls
+    ]:
+        return requested_urls, None
+    return planned, {
+        "mode": "quality_first_final_extract_independent_balanced",
+        "independent_families": len(planned_families),
+        "rewritten_urls": len(planned),
+    }
+
+
+def _top_up_product_final_extract(
+    mix: Mapping[str, Any], requested_urls: list[str], extract_count: int
+) -> tuple[list[str], dict[str, Any] | None]:
+    """Fill an under-sized final extract from exact searched URLs.
+
+    The model gets two extraction batches. If the first batch yielded only one
+    page and the model requests only one page in the final batch, a later
+    receipt retry cannot recover because no extraction call remains. Add only
+    already-searched, non-retailer, different-host URLs until the planned set
+    can contain one search-proven official source and two independent hosts.
+    When space remains, add candidate-aligned backup URLs from the same
+    manufacturer family: one inaccessible storefront page must not strand the
+    only official evidence slot. The tool-call count, search provenance, and
+    three-URL recovery cap are unchanged.
+    """
+
+    if extract_count != PRODUCT_RESEARCH_MAX_EXTRACT_CALLS - 1:
+        return requested_urls, None
+
+    successful = {
+        url for url in mix.get("successful_sources", set()) if isinstance(url, str)
+    }
+    records = mix.get("search_records")
+    if not isinstance(records, list):
+        return requested_urls, None
+
+    focused: set[str] = set()
+    candidates: list[str] = []
+    candidate_seen: set[str] = set()
+    for record in reversed(records):
+        if not (
+            isinstance(record, tuple)
+            and len(record) == 2
+            and isinstance(record[0], str)
+            and isinstance(record[1], list)
+        ):
+            continue
+        query, urls = record
+        for value in urls:
+            url = _safe_product_recovery_url(value)
+            if url is None:
+                continue
+            canonical = _canonical_url(url)
+            if _product_query_targets_source_host(query, url):
+                focused.add(canonical)
+            if canonical not in candidate_seen:
+                candidate_seen.add(canonical)
+                candidates.append(url)
+
+    selected_candidate_tokens: set[str] = set()
+    selected_candidate_query = ""
+    if records:
+        selected_candidate_query = records[-1][0]
+        selected_candidate_tokens = _product_query_candidate_tokens(
+            selected_candidate_query
+        )
+
+    def selected_candidate_url(url: str) -> bool:
+        canonical = _canonical_url(url)
+        return bool(
+            (
+                selected_candidate_tokens
+                and _product_candidate_match(selected_candidate_tokens, url, "")
+            )
+            or (
+                canonical in focused
+                and selected_candidate_query
+                and _product_query_targets_source_host(
+                    selected_candidate_query, url
+                )
+            )
+        )
+
+    requested_for_plan = list(requested_urls)
+    distinctive_selected_tokens = {
+        token
+        for token in selected_candidate_tokens
+        if (
+            any(c.isalpha() for c in token) and any(c.isdigit() for c in token)
+        )
+        or (token.isdigit() and len(token) >= 2)
+    }
+    aligned_requested = [
+        url
+        for url in requested_for_plan
+        if distinctive_selected_tokens and selected_candidate_url(url)
+    ]
+    cross_candidate_requested = bool(
+        aligned_requested and len(aligned_requested) < len(requested_for_plan)
+    )
+    if cross_candidate_requested:
+        # A final batch spanning several products cannot establish the two
+        # independent families required for the selected candidate. Preserve
+        # only URL-identifiable matches, then backfill that candidate from the
+        # already searched pool.
+        requested_for_plan = aligned_requested
+
+    planned: list[str] = []
+    planned_canonical: set[str] = set()
+    planned_families: set[str] = set()
+    for url in requested_for_plan:
+        canonical = _canonical_url(url)
+        family = _product_source_family(canonical)
+        if canonical in planned_canonical or not family or family in planned_families:
+            continue
+        planned.append(url)
+        planned_canonical.add(canonical)
+        planned_families.add(family)
+
+    anticipated = successful | planned_canonical
+    anticipated_hosts = {_host(url) for url in anticipated}
+    anticipated_families = {_product_source_family(url) for url in anticipated}
+
+    def independent_families() -> set[str]:
+        return {
+            _product_source_family(url)
+            for url in anticipated
+            if url not in focused
+            and not any(
+                token in _normalized_token(_host(url))
+                for token in _INDEPENDENT_FORBIDDEN_HOST_TOKENS
+            )
+        }
+
+    def add_candidate(url: str) -> bool:
+        if len(planned) >= PRODUCT_RESEARCH_RECOVERY_MAX_URLS:
+            return False
+        canonical = _canonical_url(url)
+        host = _host(canonical)
+        family = _product_source_family(canonical)
+        if (
+            canonical in anticipated
+            or not host
+            or not family
+            or family in anticipated_families
+        ):
+            return False
+        planned.append(url)
+        planned_canonical.add(canonical)
+        anticipated.add(canonical)
+        anticipated_hosts.add(host)
+        anticipated_families.add(family)
+        return True
+
+    def add_official_backup(url: str) -> bool:
+        """Add a distinct same-family manufacturer URL within the same batch."""
+
+        if len(planned) >= PRODUCT_RESEARCH_RECOVERY_MAX_URLS:
+            return False
+        canonical = _canonical_url(url)
+        host = _host(canonical)
+        family = _product_source_family(canonical)
+        if canonical in anticipated or not host or not family:
+            return False
+        planned.append(url)
+        planned_canonical.add(canonical)
+        anticipated.add(canonical)
+        anticipated_hosts.add(host)
+        anticipated_families.add(family)
+        return True
+
+    candidate_aligned = [
+        url
+        for url in candidates
+        if selected_candidate_tokens and selected_candidate_url(url)
+    ]
+    candidate_fallbacks = [url for url in candidates if url not in candidate_aligned]
+    # Once the model has named the selected candidate in the final batch, do
+    # not fill its evidence slots with reviews of the other comparison
+    # products.  Those pages add apparent publisher diversity but cannot
+    # satisfy the candidate-local receipt gate.
+    ordered_candidates = (
+        candidate_aligned
+        if cross_candidate_requested
+        else candidate_aligned + candidate_fallbacks
+    )
+
+    if not (anticipated & focused):
+        for url in ordered_candidates:
+            if _canonical_url(url) in focused and add_candidate(url):
+                break
+
+    for url in ordered_candidates:
+        if len(independent_families()) >= 2:
+            break
+        canonical = _canonical_url(url)
+        if canonical not in focused:
+            add_candidate(url)
+
+    for url in ordered_candidates:
+        if len(anticipated_families) >= 3:
+            break
+        add_candidate(url)
+
+    candidate_tokens = {
+        token
+        for token in mix.get("candidate_tokens", set())
+        if isinstance(token, str)
+    }
+    official_backups = 0
+    if anticipated & focused and candidate_tokens:
+        for url in ordered_candidates:
+            canonical = _canonical_url(url)
+            if (
+                canonical in focused
+                and _product_candidate_match(candidate_tokens, url, "")
+                and add_official_backup(url)
+            ):
+                official_backups += 1
+
+    retained_requested = len(
+        planned_canonical & {_canonical_url(url) for url in requested_urls}
+    )
+    removed_requested = (
+        len({_canonical_url(url) for url in requested_urls}) - retained_requested
+    )
+    added = len(planned) - retained_requested
+    if added <= 0 and removed_requested <= 0:
+        return requested_urls, None
+    details = {
+        "mode": "final_extract_top_up",
+        "successful_sources": len(successful),
+        "successful_hosts": len({_host(url) for url in successful}),
+        "requested_urls_before": len(requested_urls),
+        "requested_urls_after": len(planned),
+        "added_urls": added,
+        "planned_official_sources": len(anticipated & focused),
+        "planned_official_backups": official_backups,
+        "planned_independent_hosts": len(independent_families()),
+    }
+    if removed_requested:
+        details["removed_cross_candidate_or_duplicate_urls"] = removed_requested
+    return planned, details
+
+
+def prepare_product_research_source_mix(
+    agent: Any, tool_calls: Any, messages: Any
+) -> tuple[list[Any], str | None, dict[str, Any] | None]:
+    """Keep product retrieval open until the receipt can support its final gate.
+
+    A count-only receipt can succeed with three independent reviews, but the
+    product finalizer also requires a brand-matched official page. Suppress an
+    early receipt while a bounded focused search/extract remains, and prevent a
+    second extraction from wasting its one remaining batch on duplicate pages.
+    The model still chooses the product; the controller only enforces the
+    prerequisite ordering and exact searched-URL custody.
+    """
+
+    calls = list(tool_calls) if isinstance(tool_calls, (list, tuple)) else []
+    parallel_terminal_calls = len(calls) > 1 and all(
+        _product_tool_call_name_arguments(call)[0] == "terminal" for call in calls
+    )
+    if not (
+        product_research_initial_turn_active(agent)
+        and getattr(agent, "api_mode", "chat_completions") == "chat_completions"
+        and (len(calls) == 1 or parallel_terminal_calls)
+        and isinstance(messages, (list, tuple))
+    ):
+        return calls, None, None
+
+    name, arguments = _product_tool_call_name_arguments(calls[0])
+    current_messages = _product_current_turn_messages(messages)
+    mix = _product_source_mix_state(current_messages)
+    successful: set[str] = mix["successful_sources"]
+    original_request = _product_research_original_request(messages)
+    ready, viability_reasons = _product_receipt_viability(mix, original_request)
+    independent_families = _product_independent_families_for_request(
+        mix, original_request
+    )
+
+    search_count = len(mix["search_records"])
+    extract_count = sum(
+        1
+        for message in current_messages
+        if message.get("role") == "tool"
+        and (message.get("name") or message.get("tool_name")) == "web_extract"
+    )
+    nudge_count = int(
+        getattr(agent, "_product_research_source_mix_nudge_count", 0) or 0
+    )
+
+    if (
+        name == "terminal"
+        and arguments is not None
+        and product_research_terminal_reason(agent, arguments) is not None
+        and search_count == 0
+        and extract_count == 0
+    ):
+        # The local model occasionally spends its first action probing route
+        # environment variables even though the controller note explicitly
+        # forbids terminal use.  No research decision has been made at this
+        # point, so replace only that pre-retrieval detour with one broad search
+        # derived from the operator's own request.  This avoids persisting a
+        # rejected terminal row and still leaves product selection, focused
+        # retrieval, evidence choice, and recommendation prose to the model.
+        query = " ".join(original_request.split())[:300]
+        if query:
+            function = getattr(calls[0], "function", None)
+            function.name = "web_search"
+            function.arguments = json.dumps(
+                {"query": query},
+                ensure_ascii=False,
+                separators=(",", ":"),
+            )
+            normalized_calls = [calls[0]] if parallel_terminal_calls else calls
+            details = {
+                "mode": "initial_terminal_detour_to_search",
+                "search_calls": 0,
+                "extract_calls": 0,
+            }
+            if parallel_terminal_calls:
+                details["coalesced_terminal_detours"] = len(calls) - 1
+            return normalized_calls, None, details
+
+    proposed_query = (
+        arguments.get("query").strip()
+        if name == "web_search"
+        and arguments is not None
+        and isinstance(arguments.get("query"), str)
+        else ""
+    )
+    proposed_focused_intent = bool(
+        proposed_query
+        and re.search(
+            r"\b(?:official|product\s+page)\b|\bsite:",
+            proposed_query,

+def research_terminal_quarantine_latched(
+    agent: Any,
+    conversation_history: Any = None,
+) -> bool:
+    """Restore the session latch from memory or its persisted assistant row."""
+
+    if getattr(agent, "_parallel_research_terminal_quarantine_latched", False) is True:
+        return True
+    if isinstance(conversation_history, (list, tuple)):
+        for message in conversation_history:
+            if not isinstance(message, Mapping) or message.get("role") != "assistant":
+                continue
+            content = message.get("content")
+            if (
+                isinstance(content, str)
+                and content.strip() == RESEARCH_RESULT_QUARANTINED_RESPONSE
+            ):
+                agent._parallel_research_terminal_quarantine_latched = True
+                return True
+    return False

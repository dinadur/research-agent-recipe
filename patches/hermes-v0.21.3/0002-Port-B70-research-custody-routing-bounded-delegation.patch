+                continue
+
+            if role == "tool":
+                call_id = message.get("tool_call_id")
+                auth_token = message.pop(
+                    "_research_lifecycle_auth_token", None
+                )
+                if predispatch:
+                    try:
+                        keep_tool_result = (
+                            auth_token in pending_lifecycle_tokens
+                        )
+                    except TypeError:
+                        keep_tool_result = False
+                    if keep_tool_result:
+                        pending_lifecycle_tokens.discard(auth_token)
+                else:
+                    keep_tool_result = (
+                        isinstance(call_id, str)
+                        and call_id in retained_tool_call_ids
+                    )
+                if keep_tool_result:
+                    sanitized_tail.append(message)
+                continue
+
+            # The boundary user row is retained above.  Later user/system rows
+            # are provider-correction scaffolding, whether or not an old path
+            # remembered to mark them synthetic.
+
+        messages[boundary + 1 :] = sanitized_tail
+
+    _research_result_turn = (
+        getattr(agent, "_parallel_research_post_dispatch_turn_id", None)
+        == getattr(agent, "_current_turn_id", None)
+        and bool(getattr(agent, "_current_turn_id", None))
+    )
+    # A controller-admitted background repair dispatch is a status receipt,
+    # not the research synthesis. The post-dispatch tool gate has already
+    # required complete reads and a typed repair batch; the next consolidated
+    # child result will re-enter as a fresh result turn for final validation.
+    _research_repair_dispatch = (
+        _research_result_turn
+        and _turn_exit_reason == "background_delegation_dispatched"
+    )
+    _research_quarantine_turn = (
+        getattr(agent, "_parallel_research_quarantine_turn_id", None)
+        == getattr(agent, "_current_turn_id", None)
+        and bool(getattr(agent, "_current_turn_id", None))
+    )
+    _research_wave_conflict_turn = (
+        getattr(agent, "_parallel_research_wave_conflict_turn_id", None)
+        == getattr(agent, "_current_turn_id", None)
+        and bool(getattr(agent, "_current_turn_id", None))
+    )
+    _research_retry_block_turn = (
+        getattr(agent, "_parallel_research_retry_block_turn_id", None)
+        == getattr(agent, "_current_turn_id", None)
+        and bool(getattr(agent, "_current_turn_id", None))
+    )
+    _generic_research_turn = (
+        getattr(agent, "_generic_research_route_turn_id", None)
+        == getattr(agent, "_current_turn_id", None)
+        and bool(getattr(agent, "_current_turn_id", None))
+    )
+    _research_predispatch_active = _research_predispatch_at_entry
+    _research_parent_active = get_parallel_research_activation(agent) is not None
+    turn_id = getattr(agent, "_current_turn_id", None)
+    specialized_turn = bool(turn_id and any(getattr(agent, key, None) == turn_id for key in (
+        "_product_research_route_turn_id", "_travel_publication_route_turn_id",
+    )))
+    _research_output_immutable = bool(
+        specialized_turn
+        or
+        _research_result_turn
+        or _research_predispatch_provenance
+        or _research_quarantine_turn
+        or _research_retry_block_turn
+        or _research_wave_conflict_turn
+        or _generic_research_turn
+        or (
+            _research_parent_active
+            and _turn_exit_reason
+            in {
+                "background_delegation_dispatched",
+                "research_dispatch_binding_failed",
+            }
+        )
+    )
+    if specialized_turn:
+        receipt = getattr(agent, "_b70_research_terminal_receipt", None)
+        if not (isinstance(receipt, tuple) and len(receipt) == 4 and receipt[:2] == (turn_id, final_response)):
+            final_response = "Research response withheld: this turn ended before the evidence and delivery checks completed. No new publication was approved."
+            failed = True
+            _turn_exit_reason = "research_specialized_abnormal_exit"
+        agent._response_was_previewed = False
+        _seal_current_turn_assistant(final_response, _turn_exit_reason)
+    if _research_quarantine_turn:
+        from agent.research_contract import RESEARCH_RESULT_QUARANTINED_RESPONSE
+
+        agent._parallel_research_terminal_quarantine_latched = True
+        final_response = RESEARCH_RESULT_QUARANTINED_RESPONSE
+        failed = True
+        _turn_exit_reason = "research_result_quarantined"
+        agent._response_was_previewed = False
+        _seal_current_turn_assistant(
+            final_response, "research_result_quarantined"
+        )
+    elif _research_retry_block_turn:
+        from agent.research_contract import RESEARCH_RETRY_BLOCKED_RESPONSE
+
+        final_response = RESEARCH_RETRY_BLOCKED_RESPONSE
+        failed = True
+        _turn_exit_reason = "research_retry_blocked"
+        agent._response_was_previewed = False
+        _seal_current_turn_assistant(final_response, "research_retry_blocked")
+    elif _research_wave_conflict_turn:
+        from agent.research_contract import RESEARCH_WAVE_PENDING_RESPONSE
+
+        final_response = RESEARCH_WAVE_PENDING_RESPONSE
+        failed = False
+        _turn_exit_reason = "research_wave_pending"
+        agent._response_was_previewed = False
+        _seal_current_turn_assistant(final_response, "research_wave_pending")
+    elif _research_predispatch_active:
+        # Budget, interrupt, transport, and controlled-halt exits bypass the
+        # normal no-tool gate. Remove its private retry scaffolding first, then
+        # seal exactly the same deterministic response before persistence.
+        _sanitize_controlled_research_history(predispatch=True)
+        from agent.research_contract import (
+            active_parallel_research_validator_error,
+        )
+
+        _validator_compatibility_error = (
+            active_parallel_research_validator_error(agent)
+        )
+        final_response = (
+            _validator_compatibility_error
+            or RESEARCH_DISPATCH_WITHHELD_RESPONSE
+        )
+        failed = True
+        _turn_exit_reason = (
+            "research_validator_incompatible"
+            if _validator_compatibility_error is not None
+            else "research_dispatch_withheld"
+        )
+        agent._response_was_previewed = False
+        _seal_current_turn_assistant(
+            final_response, _turn_exit_reason
+        )
+    elif _research_result_turn and not _research_repair_dispatch:
+        try:
+            from agent.research_synthesis import (
+                SYNTHESIS_WITHHELD_RESPONSE,
+                validate_parent_research_synthesis,
+            )
+
+            if final_response == SYNTHESIS_WITHHELD_RESPONSE:
+                _research_delivery_passed = False
+            else:
+                _research_delivery_validation = (
+                    validate_parent_research_synthesis(agent, final_response)

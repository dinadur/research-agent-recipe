+def _installed_validator_bytes() -> bytes:
+    skill_path_raw = os.environ.get(
+        "PARALLEL_RESEARCH_SKILL_UNDER_TEST", ""
+    ).strip()
+    if not skill_path_raw:
+        pytest.skip("set PARALLEL_RESEARCH_SKILL_UNDER_TEST for integration test")
+    validator = Path(skill_path_raw).parent / "scripts" / "validate_research_notes.py"
+    if not validator.is_file():
+        pytest.fail(f"parallel-research validator does not exist: {validator}")
+    return validator.read_bytes()
+
+
+def _contract(
+    path: Path,
+    *,
+    validator: bytes = FAKE_VALIDATOR,
+    source_policy_id: str = "unrestricted",
+) -> ResearchArtifactContract:
+    return ResearchArtifactContract(
+        path=str(path),
+        fields=("scope", "verified findings", "open questions"),
+        validator_path="/captured/validator.py",
+        validator_bytes=validator,
+        validator_sha256=hashlib.sha256(validator).hexdigest(),
+        initial_exists=False,
+        initial_sha256=None,
+        subject="TrueNAS SCALE",
+        source_policy_id=source_policy_id,
+    )
+
+
+def _agent(contract: ResearchArtifactContract) -> SimpleNamespace:
+    agent = SimpleNamespace(
+        _current_turn_id="turn-1",
+        _parallel_research_post_dispatch_turn_id="turn-1",
+        _parallel_research_bound_artifacts=(contract,),
+        _parallel_research_bound_paths=(contract.path,),
+        _parallel_research_artifact_read_receipts={},
+    )
+    _install_completion_attestations(agent, (contract,))
+    return agent
+
+
+def _install_completion_attestations(
+    agent: SimpleNamespace,
+    contracts: tuple[ResearchArtifactContract, ...],
+    *,
+    passed: bool = True,
+) -> None:
+    attestations = {}
+    for contract in contracts:
+        path = Path(contract.path)
+        if not path.is_file():
+            continue
+        attestations[contract.path] = _completion_attestation(
+            contract, passed=passed
+        )
+    agent._parallel_research_completion_attestations = attestations
+    agent._parallel_research_completion_attestation_paths = tuple(attestations)
+    agent._parallel_research_completion_attestation_valid = (
+        len(attestations) == len(contracts)
+    )
+
+
+def _completion_attestation(
+    contract: ResearchArtifactContract, *, passed: bool = True
+) -> dict:
+    return {
+        "path": contract.path,
+        "artifact_sha256": hashlib.sha256(
+            Path(contract.path).read_bytes()
+        ).hexdigest(),
+        "validator_sha256": contract.validator_sha256,
+        "source_policy_id": contract.source_policy_id,
+        "passed": passed,
+        "terminal": False,
+        "retryable": True,
+    }
+
+
+def _completion_binding_agent(
+    contracts: tuple[ResearchArtifactContract, ...],
+    *,
+    delegation_id: str = "wave-initial",
+) -> SimpleNamespace:
+    return SimpleNamespace(
+        _parallel_research_bound_artifacts=contracts,
+        _parallel_research_bound_paths=tuple(item.path for item in contracts),
+        _parallel_research_pending_delegation_id=delegation_id,
+        _parallel_research_trusted_completion_id=delegation_id,
+        _parallel_research_trusted_completion_session_key="trusted-session",
+        _parallel_research_repair_dispatch_count=0,
+        _parallel_research_completion_attestations={},
+        _parallel_research_completion_attestation_paths=(),
+        _parallel_research_completion_attestation_valid=False,
+    )

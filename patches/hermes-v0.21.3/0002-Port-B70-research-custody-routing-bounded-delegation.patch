+def _bound_research_artifact_paths(
+    args: Mapping[str, Any] | None,
+    expected_count: int,
+) -> tuple[str, ...]:
+    tasks = args.get("tasks") if isinstance(args, Mapping) else None
+    if not isinstance(tasks, list) or len(tasks) != expected_count:
+        return ()
+    paths: list[str] = []
+    for task in tasks:
+        artifact = task.get("research_artifact") if isinstance(task, dict) else None
+        path = artifact.get("path") if isinstance(artifact, dict) else None
+        if not isinstance(path, str) or not path or not posixpath.isabs(path):
+            return ()
+        paths.append(posixpath.normpath(path))
+    if len(set(paths)) != expected_count:
+        return ()
+    return tuple(paths)
+
+
+def _bound_research_artifact_contracts(
+    args: Mapping[str, Any] | None,
+    expected_count: int,
+    activation: ParallelResearchActivation,
+) -> tuple[ResearchArtifactContract, ...]:
+    """Re-freeze the exact descriptors admitted by a successful batch."""
+
+    tasks = args.get("tasks") if isinstance(args, Mapping) else None
+    if not isinstance(tasks, list) or len(tasks) != expected_count:
+        return ()
+    contracts: list[ResearchArtifactContract] = []
+    try:
+        for task in tasks:
+            if not isinstance(task, dict):
+                return ()
+            artifact = task.get("research_artifact")
+            contract = parse_research_artifact_contract(artifact, activation)
+            if not research_goal_names_subject(task.get("goal"), contract.subject):
+                return ()
+            contracts.append(contract)
+    except (OSError, ValueError):
+        return ()
+    if len({contract.path for contract in contracts}) != expected_count:
+        return ()
+    return tuple(contracts)
+
+
+def _initial_research_dispatch_contracts(
+    args: Mapping[str, Any] | None,
+    activation: ParallelResearchActivation,
+) -> tuple[tuple[ResearchArtifactContract, ...], tuple[str, ...]]:
+    """Validate the initial batch while retaining bounded, actionable errors."""
+
+    errors: list[str] = []
+    if not isinstance(args, Mapping):
+        return (), ("arguments: expected an object with only tasks and background",)
+    if set(args) != {"tasks", "background"}:
+        errors.append(
+            "arguments: expected exactly the top-level keys tasks and background; "
+            "context, role, and other keys are not accepted"
+        )
+    if args.get("background") is not True:
+        errors.append("background: expected true")
+
+    tasks = args.get("tasks")
+    if not isinstance(tasks, list):
+        errors.append("tasks: expected an array containing exactly 3 task objects")
+        return (), tuple(errors)
+    if len(tasks) != 3:
+        errors.append(f"tasks: expected exactly 3 task objects; received {len(tasks)}")
+        return (), tuple(errors)
+
+    indexed_contracts: list[tuple[int, ResearchArtifactContract]] = []
+    for index, task in enumerate(tasks):
+        prefix = f"tasks[{index}]"
+        if not isinstance(task, dict):
+            errors.append(f"{prefix}: expected an object")
+            continue
+        if set(task) != {"goal", "role", "research_artifact"}:
+            errors.append(
+                f"{prefix}: expected exactly goal, role, and research_artifact; "
+                "context and other keys are not accepted"
+            )
+            continue
+        if task.get("role") != "leaf":
+            errors.append(f"{prefix}.role: expected 'leaf'")
+        goal = task.get("goal")
+        if not isinstance(goal, str) or not goal.strip():
+            errors.append(f"{prefix}.goal: expected a non-empty string")
+
+        try:
+            contract = parse_research_artifact_contract(
+                task.get("research_artifact"), activation
+            )
+        except OSError:
+            errors.append(
+                f"{prefix}.research_artifact.path: controller could not inspect "
+                "the requested path"
+            )
+            continue
+        except ValueError as exc:
+            errors.append(f"{prefix}.{exc}")
+            continue
+        if contract.initial_exists:
+            errors.append(
+                f"{prefix}.research_artifact.path: initial research dispatch "
+                "requires a new path; an existing candidate is admitted only by "
+                "the controller-owned repair subset"
+            )
+        if not research_goal_names_subject(
+            goal,
+            contract.subject,
+            artifact_path=contract.path,
+        ):
+            errors.append(
+                f"{prefix}.goal: expected the exact research_artifact.subject "
+                "label in goal prose"
+            )
+        indexed_contracts.append((index, contract))
+
+    first_path_index: dict[str, int] = {}
+    for index, contract in indexed_contracts:
+        prior_index = first_path_index.setdefault(contract.path, index)
+        if prior_index != index:
+            errors.append(
+                f"tasks[{index}].research_artifact.path: expected a unique path; "
+                f"duplicates tasks[{prior_index}]"
+            )
+    if errors:
+        return (), tuple(errors[:12])
+    return tuple(contract for _, contract in indexed_contracts), ()
+
+
+def _merge_research_repair_contracts(
+    existing: Any,
+    repairs: tuple[ResearchArtifactContract, ...],
+) -> tuple[ResearchArtifactContract, ...]:
+    """Replace an exact repair subset without shrinking the source corpus."""
+
+    if (
+        not isinstance(existing, tuple)
+        or not existing
+        or not all(isinstance(item, ResearchArtifactContract) for item in existing)
+        or not repairs
+    ):
+        return ()
+    existing_by_path = {item.path: item for item in existing}
+    if len(existing_by_path) != len(existing):
+        return ()
+    repair_by_path: dict[str, ResearchArtifactContract] = {}
+    for repair in repairs:
+        original = existing_by_path.get(repair.path)
+        if (
+            original is None
+            or repair.path in repair_by_path
+            or repair.subject != original.subject
+            or repair.fields != original.fields
+            or repair.operator_request != original.operator_request
+            or repair.source_policy_id != original.source_policy_id
+            or repair.validator_bytes != original.validator_bytes
+            or repair.validator_sha256 != original.validator_sha256
+        ):
+            return ()
+        repair_by_path[repair.path] = repair
+    return tuple(repair_by_path.get(item.path, item) for item in existing)
+
+
+def _repair_call_fingerprint(args: Mapping[str, Any] | None) -> str:
+    if not isinstance(args, Mapping):
+        return ""
+    try:
+        payload = json.dumps(
+            dict(args), sort_keys=True, separators=(",", ":"), ensure_ascii=False
+        ).encode("utf-8")
+    except (TypeError, ValueError):
+        return ""
+    return hashlib.sha256(payload).hexdigest()
+
+
+def _pending_parent_dispatch_decision(lane: str) -> ResearchContractDecision:
+    repair = lane == "repair"
+    return ResearchContractDecision(
+        (
+            "research_parent_repair_pending"
+            if repair
+            else "research_parent_dispatch_pending"
+        ),
+        (
+            "One repair delegate_task is already reserved for this model "
+            "response. This sibling call did not execute and cannot replace "
+            "the exact failing-path reservation. Wait for the admitted call's "
+            "result; retry in a later model iteration only if no repair wave "
+            "was dispatched."
+            if repair
+            else "One initial research delegate_task is already reserved for "
+            "this model response. This sibling call did not execute and cannot "
+            "replace the exact typed three-leg reservation. Wait for the "
+            "admitted call's result; retry in a later model iteration only if "
+            "no research wave was dispatched."
+        ),
+        status="rejected",
+        retryable=True,
+        executed=False,
+    )
+
+
+def _existing_parent_dispatch_decision(
+    agent: Any, *, requested_lane: str
+) -> ResearchContractDecision | None:
+    epoch = getattr(agent, "_current_api_request_id", None)
+    epoch = epoch if isinstance(epoch, str) and epoch else ""
+    with _PARALLEL_RESEARCH_DISPATCH_RESERVATION_LOCK:
+        pending_initial = getattr(
+            agent, "_parallel_research_pending_initial_dispatch", None
+        )
+        pending_repair = getattr(agent, "_parallel_research_pending_repair", None)
+        reserved_epoch = getattr(
+            agent, "_parallel_research_dispatch_reservation_epoch", None
+        )
+        reserved_lane = getattr(
+            agent, "_parallel_research_dispatch_reservation_lane", None
+        )
+        if pending_initial is not None or pending_repair is not None:
+            active_lane = "repair" if pending_repair is not None else "initial"
+            return _pending_parent_dispatch_decision(active_lane)
+        if epoch and reserved_epoch == epoch:
+            active_lane = (
+                reserved_lane
+                if reserved_lane in {"initial", "repair"}
+                else requested_lane
+            )
+            return _pending_parent_dispatch_decision(active_lane)
+    return None
+
+
+def _reserve_parent_dispatch(
+    agent: Any,
+    *,
+    lane: str,
+    reservation: dict[str, Any],
+) -> ResearchContractDecision | None:
+    """Atomically reserve one delegate call for one model-response epoch."""
+
+    pending_attr = (
+        "_parallel_research_pending_repair"
+        if lane == "repair"
+        else "_parallel_research_pending_initial_dispatch"
+    )
+    with _PARALLEL_RESEARCH_DISPATCH_RESERVATION_LOCK:
+        pending = _existing_parent_dispatch_decision(agent, requested_lane=lane)
+        if pending is not None:
+            return pending
+        setattr(agent, pending_attr, reservation)
+        epoch = getattr(agent, "_current_api_request_id", None)
+        epoch = epoch if isinstance(epoch, str) and epoch else ""
+        if epoch:
+            agent._parallel_research_dispatch_reservation_epoch = epoch
+            agent._parallel_research_dispatch_reservation_lane = lane
+    return None
+
+
+def _parent_research_receipt_sha256(
+    contract_paths: tuple[str, ...], receipts: Any, turn_id: Any
+) -> str:
+    """Digest one exact, complete current-turn read-observation set."""
+
+    if (
+        not contract_paths
+        or len(set(contract_paths)) != len(contract_paths)
+        or not isinstance(receipts, Mapping)
+        or not isinstance(turn_id, str)
+        or not turn_id
+    ):
+        return ""
+    rows: list[dict[str, str]] = []
+    for path in contract_paths:
+        receipt = receipts.get(path)
+        if not isinstance(receipt, Mapping) or receipt.get("turn_id") != turn_id:
+            return ""
+        status = receipt.get("status")
+        if status == "read":
+            digest = receipt.get("sha256")
+            if (
+                set(receipt) != {"turn_id", "status", "sha256"}
+                or not isinstance(digest, str)
+                or re.fullmatch(r"[0-9a-f]{64}", digest) is None
+            ):
+                return ""
+            rows.append({"path": path, "status": "read", "sha256": digest})
+        elif status == "missing":
+            if (
+                set(receipt) != {"turn_id", "status", "path_state"}
+                or receipt.get("path_state") != "absent"
+            ):
+                return ""
+            rows.append({"path": path, "status": "missing"})
+        else:
+            return ""
+    payload = json.dumps(
+        rows, sort_keys=True, separators=(",", ":"), ensure_ascii=False
+    ).encode("utf-8")
+    return hashlib.sha256(payload).hexdigest()
+
+
+def _exact_parent_raw_validation(
+    agent: Any,
+    *,
+    current_turn_id: str,
+    bound_path_tuple: tuple[str, ...],
+    receipts: Mapping[str, Any] | None,
+) -> ResearchRawValidationState | None:
+    """Return only current, receipt-bound immutable raw-validation authority."""
+
+    raw_validation = getattr(agent, "_parallel_research_raw_validation", None)
+    activation = get_parallel_research_activation(agent)
+    if (
+        not isinstance(raw_validation, ResearchRawValidationState)
+        or not isinstance(activation, ParallelResearchActivation)
+        or raw_validation.turn_id != current_turn_id
+        or raw_validation.contract_paths != bound_path_tuple
+        or raw_validation.receipt_sha256
+        != _parent_research_receipt_sha256(
+            bound_path_tuple, receipts, current_turn_id
+        )
+        or raw_validation.validator_sha256 != activation.validator_sha256
+        or raw_validation.status not in {"passed", "repair_required", "blocked"}
+        or not isinstance(raw_validation.passing_paths, tuple)
+        or not isinstance(raw_validation.failing_paths, tuple)
+        or not all(
+            isinstance(path, str)
+            for path in raw_validation.passing_paths + raw_validation.failing_paths
+        )
+    ):
+        return None
+    bound_paths = set(bound_path_tuple)
+    passing_paths = set(raw_validation.passing_paths)
+    failing_paths = set(raw_validation.failing_paths)
+    if (
+        passing_paths.intersection(failing_paths)
+        or not passing_paths.union(failing_paths).issubset(bound_paths)
+    ):
+        return None
+    if raw_validation.status == "blocked":
+        return raw_validation
+    if passing_paths.union(failing_paths) != bound_paths:
+        return None
+    if bool(failing_paths) != (raw_validation.status == "repair_required"):
+        return None
+    return raw_validation
+
+
+def parse_research_artifact_contract(
+    value: Any,
+    activation: ParallelResearchActivation,
+) -> ResearchArtifactContract:
+    """Validate and freeze one model-supplied artifact descriptor."""
+
+    if not isinstance(value, dict) or set(value) != {"subject", "path", "fields"}:
+        raise ValueError(
+            "research_artifact must be an exact object with only required "
+            "'subject', 'path', and 'fields'"
+        )
+
+    raw_subject = value.get("subject")
+    expected_slug = canonical_research_subject_slug(raw_subject)
+    subject = raw_subject.strip()
+
+    raw_path = value.get("path")
+    if (
+        not isinstance(raw_path, str)
+        or not raw_path.strip()
+        or "\x00" in raw_path
+        or "\r" in raw_path
+        or "\n" in raw_path
+    ):
+        raise ValueError("research_artifact.path must be a non-empty absolute path")
+    if "\\" in raw_path:
+        raise ValueError("research_artifact.path must use POSIX '/' separators")
+    normalized_path = posixpath.normpath(raw_path.strip())
+    if not posixpath.isabs(normalized_path) or normalized_path == "/":
+        raise ValueError("research_artifact.path must be an absolute file path")
+    if not normalized_path.casefold().endswith(".md"):
+        raise ValueError("research_artifact.path must name a Markdown (.md) file")
+    if _RESEARCH_RUN_STAMP_RE.fullmatch(activation.research_run_stamp) is None:
+        raise ValueError(
+            "parallel-research activation lacks a trusted research run stamp"
+        )
+    resolved_path, containing_root = _resolve_artifact_under_roots(
+        normalized_path,
+        activation.allowed_roots,
+    )
+    relative_parts = resolved_path.relative_to(containing_root).parts
+    if len(relative_parts) != 3 or relative_parts[1] != activation.research_run_stamp:
+        raise ValueError(
+            "research_artifact.path must use the exact trusted shape "
+            "<research_artifact_root>/<topic-or-leg>/"
+            "<research_run_stamp>/<filename>.md"
+        )
+    expected_filename = f"{expected_slug}.md"
+    if relative_parts[0] != expected_slug or relative_parts[2] != expected_filename:
+        raise ValueError(
+            "research_artifact.path topic directory and filename must both "
+            "match the controller-derived subject slug exactly: "
+            f"{expected_slug}/{activation.research_run_stamp}/{expected_filename}"
+        )
+
+    raw_fields = value.get("fields")
+    if not isinstance(raw_fields, list) or not raw_fields or len(raw_fields) > 64:
+        raise ValueError("research_artifact.fields must contain 1 to 64 field names")
+    fields: list[str] = []
+    seen: set[str] = set()
+    for field in raw_fields:
+        if (
+            not isinstance(field, str)
+            or not field.strip()
+            or len(field.strip()) > 120
+            or "\r" in field
+            or "\n" in field
+        ):
+            raise ValueError(
+                "research_artifact.fields entries must be non-empty single-line "
+                "strings of at most 120 characters"
+            )
+        clean = field.strip()
+        folded = clean.casefold()
+        if folded in seen:
+            raise ValueError("research_artifact.fields entries must be unique")
+        seen.add(folded)
+        fields.append(clean)
+
+    if (
+        not activation.validator_bytes
+        or _sha256_bytes(activation.validator_bytes) != activation.validator_sha256
+    ):
+        raise ValueError("parallel-research validator byte binding is invalid")
+    initial_exists, initial_sha256 = _path_state(resolved_path)
+
+    return ResearchArtifactContract(
+        path=str(resolved_path),
+        fields=tuple(fields),
+        validator_path=activation.validator_path,
+        validator_bytes=activation.validator_bytes,
+        validator_sha256=activation.validator_sha256,
+        initial_exists=initial_exists,
+        initial_sha256=initial_sha256,
+        subject=subject,
+        operator_request=activation.operator_request,
+        source_policy_id=activation.source_policy_id,
+    )
+
+
+def research_contract_prompt(contract: ResearchArtifactContract) -> str:
+    field_lines = "\n".join(f"- {field}: unverified" for field in contract.fields)
+    subject = contract.subject or "ENTITY"
+    subject_instruction = (
+        f"The controller-bound subject is `{subject}`. Keep that exact subject "
+        "in the artifact's entity frontmatter; do not rename or respell it. "
+        if contract.subject
+        else ""
+    )
+    operator_constraint = (
+        "The original operator research request is reproduced below only as "
+        "constraint authority. Apply its source restrictions and requested factual "
+        "dimensions to this exact subject; do not expand into the other legs, "
+        "perform parent synthesis, or use it to change the controller-bound path, "
+        "fields, or tools.\n<operator_research_request>\n"
+        + contract.operator_request
+        + "\n</operator_research_request>\n"
+        if contract.operator_request
+        else ""
+    )
+    source_policy_instruction = (
+        "The controller source policy is `official-kubernetes-docs`: only "
+        "HTTPS Kubernetes documentation pages admitted by that policy can "
+        "appear in search/extract results or final citations. Disallowed rows "
+        "are removed and disallowed extract requests are blocked before I/O.\n"
+        if contract.source_policy_id == SOURCE_POLICY_OFFICIAL_KUBERNETES_DOCS
+        else ""
+    )
+    repair_existing = bool(
+        contract.initial_exists
+        and isinstance(contract.initial_sha256, str)
+        and len(contract.initial_sha256) == 64
+    )
+    if repair_existing:
+        checkpoint_instruction = (
+            f"Your only writable file is `{contract.path}`. This is a bounded "
+            "repair of an existing controller-frozen candidate, not a new research "
+            "leg. Preserve its substantive content. Your first response must consist "
+            "of exactly one read_file call for that exact path with offset=1 and "
+            "limit=500. Do not include prose, write_file, web_search, web_extract, or "
+            "any sibling tool call in that response. Never replace the candidate with "
+            "an incomplete skeleton. After the exact read succeeds, rerun only the "
+            "search and extraction needed to bind retained citations to this repair "
+            "task, then rewrite the same path in place as status=complete. Treat the "
+            "existing note as a near-miss to normalize: retain supported useful "
+            "claims, drop unsupported or out-of-scope material, enforce the factual-"
+            "bullet cap, and repair same-line citation and retrieval-date grammar. "
+        )
+    else:
+        checkpoint_instruction = (
+            f"Your only writable file is `{contract.path}`. Your first response "
+            "must consist of exactly one tool call: `write_file` to that exact "
+            "absolute path. Do not include prose, web_search, web_extract, read_file, "
+            "or any other sibling tool call in that response. If that write is "
+            "blocked, correct it immediately; the controller fails the task after 3 "
+            "tool-emitting iterations without a skeleton. Retrieval is blocked until "
+            "that write succeeds. The first write must use this deterministic skeleton "
+            "shape (replace YYYY-MM-DD, but keep the entity and every field line):\n\n"
+            "```markdown\n"
+            "---\n"
+            f"entity: {subject}\n"
+            "retrieval_date: YYYY-MM-DD\n"
+            "status: incomplete\n"
+            "---\n"
+            f"{field_lines}\n"
+            "```\n"
+            "After the skeleton lands, update the same file after usable evidence. "
+        )
+    return (
+        "\n## Controller-enforced research artifact\n"
+        + subject_instruction
+        + operator_constraint
+        + source_policy_instruction
+        + checkpoint_instruction
+        + "This contracted child may use only write_file, read_file, web_search, "
+        "and web_extract; terminal, patch, execute_code, and browser tools are "
+        "blocked. The controller permits at most 10 web retrieval attempts, "
+        "stops them after 3 consecutive structured unusable outcomes, and "
+        "blocks new retrieval when the final 7 model iterations begin. "
+        "`read_file` and exact-path `write_file` remain available for finalization. "
+        "After initialization, each successful exact-path write receipt includes "
+        "bounded evidence-validator feedback so you can repair the same file in "
+        "turn. Every cited HTTPS URL must come from this child's successful "
+        "web_search result and a successful web_extract result with non-empty "
+        "content; remembered or merely plausible URLs fail completion. "
+        "Request extraction with the exact URL string returned by search; changing "
+        "the hostname, path, query, or fragment is controller-blocked. Describe "
+        "an inaccessible source as an unverified limitation without citing its "
+        "URL. The "
+        "controller independently reruns the immutable validator after "
+        "your return. A completed candidate must contain 1 to 12 factual "
+        "Markdown bullets total, with exactly one independently reviewable claim "
+        "per bullet and at most 1200 characters per bullet. Do not pack claims "
+        "with semicolons or multiple assertion sentences. Keep square brackets "
+        "balanced, backticks paired, and command metavariables exactly as the "
+        "official source spells them. A completed candidate may not retain "
+        "`unverified` text, and every factual line in every field must carry a "
+        "same-line HTTPS URL with successful search and non-empty extraction "
+        "receipts. Put unresolved "
+        "items under open questions as questions, not unsupported assertions. A "
+        "missing, unwritten, or failing artifact cannot complete the task."
+    )
+
+
+def _parse_frontmatter(content: str) -> tuple[dict[str, str], list[str]]:
+    lines = content.splitlines()
+    if not lines or lines[0].strip() != "---":
+        return {}, lines
+    end = None
+    for index in range(1, min(len(lines), 40)):
+        if lines[index].strip() == "---":
+            end = index
+            break
+    if end is None:
+        return {}, lines
+    metadata: dict[str, str] = {}
+    for line in lines[1:end]:
+        if ":" not in line:
+            continue
+        key, value = line.split(":", 1)
+        metadata[key.strip().casefold()] = value.strip()
+    return metadata, lines[end + 1 :]
+
+
+def _has_single_incomplete_frontmatter_status(content: Any) -> bool:
+    """Recognize an intentional checkpoint without hiding malformed finals."""
+
+    if not isinstance(content, str):
+        return False
+    lines = content.splitlines()
+    if not lines or lines[0].strip() != "---":
+        return False
+    end = None
+    for index in range(1, min(len(lines), 40)):
+        if lines[index].strip() == "---":
+            end = index
+            break
+    if end is None:
+        return False
+    statuses: list[str] = []
+    for line in lines[1:end]:
+        if ":" not in line:
+            continue
+        key, value = line.split(":", 1)
+        if key.strip().casefold() == "status":
+            statuses.append(value.strip().casefold())
+    return statuses == ["incomplete"]
+
+
+def validate_skeleton_content(
+    content: Any,
+    fields: Sequence[str],
+    subject: str = "",
+) -> tuple[bool, str]:
+    """Deterministically validate the first checkpoint skeleton."""
+
+    if not isinstance(content, str) or not content.strip():
+        return False, "the first artifact write must contain a non-empty skeleton"
+    metadata, body_lines = _parse_frontmatter(content)
+    entity = metadata.get("entity", "").strip()
+    retrieval_date = metadata.get("retrieval_date", "").strip()
+    status = metadata.get("status", "").strip().casefold()
+    if not entity or entity.casefold() in {"entity", "unverified"}:
+        return False, "the skeleton frontmatter needs a concrete non-empty entity"
+    if subject and entity != subject:
+        return (
+            False,
+            "the skeleton entity must exactly match the controller-bound subject "
+            f"{subject!r}",
+        )
+    if not _ISO_DATE_RE.fullmatch(retrieval_date):
+        return False, "the skeleton retrieval_date must be YYYY-MM-DD"
+    if status != "incomplete":
+        return False, "the skeleton status must be exactly 'incomplete'"
+
+    body = {line.strip().casefold() for line in body_lines if line.strip()}
+    missing = [
+        field for field in fields if f"- {field}: unverified".casefold() not in body
+    ]
+    if missing:
+        return False, "the skeleton must mark these fields unverified: " + ", ".join(
+            missing
+        )
+    return True, ""
+
+
+def _is_retrieval_tool(tool_name: str) -> bool:
+    return tool_name in _RETRIEVAL_TOOLS
+
+
+def _structured_retrieval_unusable(result: Any, failed: bool) -> bool:
+    if failed:
+        return True
+    if result is None:
+        return True
+    if isinstance(result, str):
+        if not result.strip():
+            return True
+        try:
+            result = json.loads(result)
+        except (TypeError, ValueError, json.JSONDecodeError):
+            # Non-empty unstructured text is not classified heuristically.
+            return False
+    if isinstance(result, list):
+        if not result:
+            return True
+        structured_failures = 0
+        for item in result:
+            if not isinstance(item, dict):
+                return False
+            status = str(item.get("status") or "").strip().casefold()
+            if (
+                item.get("success") is False
+                or item.get("error")
+                or status in _FAILED_STATUSES
+            ):
+                structured_failures += 1
+        return structured_failures == len(result)
+    if not isinstance(result, dict):
+        return False
+    status = str(result.get("status") or "").strip().casefold()
+    if (
+        result.get("success") is False
+        or result.get("error")
+        or status in _FAILED_STATUSES
+    ):
+        return True
+    for key in ("results", "data", "items"):
+        if key in result and isinstance(result[key], list) and not result[key]:
+            return True
+    data = result.get("data")
+    if (
+        isinstance(data, dict)
+        and "web" in data
+        and isinstance(data["web"], list)
+        and not data["web"]
+    ):
+        return True
+    return False
+
+
+def _structured_retrieval_terminal_reason(result: Any) -> str:
+    value = result
+    if isinstance(value, str):
+        try:
+            value = json.loads(value)
+        except (TypeError, ValueError, json.JSONDecodeError):
+            return ""
+    candidates: list[dict[str, Any]] = []
+    if isinstance(value, dict):
+        candidates.append(value)
+        for key in ("data", "result", "results"):
+            nested = value.get(key)
+            if isinstance(nested, dict):
+                candidates.append(nested)
+            elif isinstance(nested, list):
+                candidates.extend(item for item in nested if isinstance(item, dict))
+    elif isinstance(value, list):
+        candidates.extend(item for item in value if isinstance(item, dict))
+    for payload in candidates:
+        retry_scope = str(payload.get("retry_scope") or "").strip().casefold()
+        code = str(payload.get("code") or "").strip().casefold()
+        status = str(payload.get("status") or "").strip().casefold()
+        if (
+            retry_scope == "later_wave"
+            or code
+            in {
+                "backend_unavailable",
+                "search_backend_unavailable",
+                "searxng_circuit_open",
+                "searxng_engines_suspended",
+                "searxng_rate_limited",
+            }
+            or (status == "unavailable" and payload.get("retryable") is False)
+        ):
+            return (
+                "The retrieval backend returned a structured terminal current-leg "
+                f"outcome (code={code or 'unavailable'}, retry_scope="
+                f"{retry_scope or 'current_leg'}). Preserve the artifact and mark "
+                "remaining fields unverified; retry only in a later wave."
+            )
+    return ""
+
+
+def _structured_retrieval_terminal_code(result: Any) -> str:
+    value = result
+    if isinstance(value, str):
+        try:
+            value = json.loads(value)
+        except (TypeError, ValueError, json.JSONDecodeError):
+            return ""
+    candidates: list[dict[str, Any]] = []
+    if isinstance(value, dict):
+        candidates.append(value)
+        for key in ("data", "result", "results"):
+            nested = value.get(key)
+            if isinstance(nested, dict):
+                candidates.append(nested)
+            elif isinstance(nested, list):
+                candidates.extend(item for item in nested if isinstance(item, dict))
+    elif isinstance(value, list):
+        candidates.extend(item for item in value if isinstance(item, dict))
+    for payload in candidates:
+        if _structured_retrieval_terminal_reason(payload):
+            return str(payload.get("code") or "").strip().casefold()
+    return ""
+
+
+def prepare_travel_search_batch_outcome(
+    agent: Any,
+    observations: Sequence[Mapping[str, Any]],
+) -> None:
+    """Admit one isolated transient search failure after a strong turn-wide quorum.
+
+    The provider still reports the failed query as terminal and non-retryable.
+    This function changes only the aggregate travel-leg decision: it accumulates
+    current-turn search outcomes across parallel batches, and when every query in
+    the failed batch settled cleanly plus the turn-wide search set meets a
+    conservative quorum, the failed leaf is omitted and web search is closed for
+    the turn. The manifest/controller remains responsible for category and source
+    sufficiency.
+    """
+
+    try:
+        from agent.travel_route import travel_publication_route_active
+
+        if not travel_publication_route_active(agent):
+            return
+    except Exception:
+        return
+
+    searches = [
+        item
+        for item in observations
+        if isinstance(item, Mapping)
+        and item.get("tool_name") == "web_search"
+        and item.get("blocked") is not True
+    ]
+    if not searches:
+        return
+
+    turn_id = getattr(agent, "_current_turn_id", None)
+    if not isinstance(turn_id, str) or not turn_id:
+        return
+    if getattr(agent, "_travel_search_quorum_turn_id", None) != turn_id:
+        agent._travel_search_quorum_turn_id = turn_id
+        agent._travel_search_quorum_observed_ids = set()
+        agent._travel_search_quorum_success_ids = set()
+        agent._travel_search_quorum_urls = set()
+
+    observed_ids = getattr(agent, "_travel_search_quorum_observed_ids", set())
+    successful_ids = getattr(agent, "_travel_search_quorum_success_ids", set())
+    accumulated_urls = getattr(agent, "_travel_search_quorum_urls", set())
+    if not isinstance(observed_ids, set):
+        observed_ids = set()
+    if not isinstance(successful_ids, set):
+        successful_ids = set()
+    if not isinstance(accumulated_urls, set):
+        accumulated_urls = set()
+
+    terminal: list[tuple[Mapping[str, Any], str]] = []
+    successful: list[Mapping[str, Any]] = []
+    successful_urls: set[str] = set()
+    for item in searches:
+        tool_call_id = str(item.get("tool_call_id") or "").strip()
+        if tool_call_id:
+            observed_ids.add(tool_call_id)
+        result = item.get("result")
+        code = _structured_retrieval_terminal_code(result)
+        if code:
+            terminal.append((item, code))
+            continue
+        failed = item.get("failed") is True
+        args = item.get("args")
+        urls = _successful_retrieval_urls(
+            "web_search",
+            args if isinstance(args, Mapping) else {},
+            result,
+            failed=failed,
+        )
+        if urls:
+            successful.append(item)
+            successful_urls.update(urls)
+            if tool_call_id:
+                successful_ids.add(tool_call_id)
+                accumulated_urls.update(urls)
+
+    agent._travel_search_quorum_observed_ids = observed_ids
+    agent._travel_search_quorum_success_ids = successful_ids
+    agent._travel_search_quorum_urls = accumulated_urls
+
+    if len(terminal) != 1 or terminal[0][1] not in _TRAVEL_PARTIAL_SEARCH_TOLERABLE_CODES:
+        return
+    if len(successful) + len(terminal) != len(searches):
+        return
+    if len(observed_ids) < TRAVEL_PARTIAL_SEARCH_TURN_MIN_CALLS:
+        return
+    if len(successful_ids) < TRAVEL_PARTIAL_SEARCH_TURN_MIN_SUCCESSES:
+        return
+    if len(accumulated_urls) < TRAVEL_PARTIAL_SEARCH_TURN_MIN_URLS:
+        return
+    if (
+        len(successful_ids) * TRAVEL_PARTIAL_SEARCH_TURN_SUCCESS_RATIO_DENOMINATOR
+        < len(observed_ids) * TRAVEL_PARTIAL_SEARCH_TURN_SUCCESS_RATIO_NUMERATOR
+    ):
+        return
+
+    tool_call_id = str(terminal[0][0].get("tool_call_id") or "").strip()
+    if not tool_call_id:
+        return
+    agent._travel_partial_search_failure_turn_id = turn_id
+    agent._travel_partial_search_failure_ids = {tool_call_id}
+    agent._travel_search_wave_closed_turn_id = turn_id
+    agent._travel_partial_search_batch_summary = {
+        "searches": len(observed_ids),
+        "successful": len(successful_ids),
+        "failed": 1,
+        "unique_urls": len(accumulated_urls),
+        "failure_code": terminal[0][1],
+    }
+    logging.info(
+        "Travel discovery continuing after isolated %s leaf: turn-wide %d/%d "
+        "searches succeeded with %d unique URLs; web search closed for this turn",
+        terminal[0][1],
+        len(successful_ids),
+        len(observed_ids),
+        len(accumulated_urls),
+    )
+
+
+def _travel_partial_search_failure_tolerated(
+    agent: Any,
+    tool_call_id: str | None,
+) -> bool:
+    turn_id = getattr(agent, "_current_turn_id", None)
+    return bool(
+        isinstance(turn_id, str)
+        and turn_id
+        and getattr(agent, "_travel_partial_search_failure_turn_id", None) == turn_id
+        and isinstance(tool_call_id, str)
+        and tool_call_id
+        and tool_call_id
+        in getattr(agent, "_travel_partial_search_failure_ids", set())
+    )
+
+
+def _annotate_tolerated_travel_search_failure(result: Any) -> Any:
+    was_json = False
+    value = result
+    if isinstance(value, str):
+        try:
+            value = json.loads(value)
+            was_json = True
+        except (TypeError, ValueError, json.JSONDecodeError):
+            return result
+    if not isinstance(value, dict):
+        return result
+    annotated = dict(value)
+    annotated["partial_batch_recovery"] = {
+        "status": "continued_with_quorum",
+        "failed_query_omitted": True,
+        "replacement_search_allowed": False,
+        "instruction": (
+            "Use the successful sibling search results and proceed to the "
+            "manifest/controller. Do not issue another web_search in this turn."
+        ),
+    }
+    return json.dumps(annotated, ensure_ascii=False) if was_json else annotated
+
+
+class ResearchContractController:
+    """Thread-safe per-child contract state used by both executor paths."""
+
+    def __init__(self, contract: ResearchArtifactContract):
+        self.contract = contract
+        self._lock = threading.Lock()
+        # Tool workers may finish concurrently. Serialize result observation
+        # through validator feedback so each receipt is bound to one exact
+        # post-write digest rather than a later sibling call's state.
+        self._observation_lock = threading.Lock()
+        self._task_id = ""
+        self._emitted_calls = 0
+        self._skeleton_tool_iterations = 0
+        self._last_skeleton_iterations_remaining: int | None = None
+        self._pending_skeleton_writes: set[int] = set()
+        self._repair_existing = bool(
+            contract.initial_exists
+            and isinstance(contract.initial_sha256, str)
+            and len(contract.initial_sha256) == 64
+        )
+        self._repair_source_read = False
+        self._pending_repair_source_read = False
+        # A repair child inherits one frozen substantive candidate. Treat that
+        # checkpoint as initialization so the repair cannot erase it with a
+        # fresh incomplete skeleton. The first exact read is still mandatory.
+        self._skeleton_written = self._repair_existing
+        self._completion_validation_passed = False
+        self._final_validation_failures = 0
+        self._final_validation_exhausted = False
+        self._consecutive_incomplete_checkpoints = 0
+        self._incomplete_checkpoint_exhausted = False
+        self._retrieval_attempts = 0
+        self._pending_retrievals = 0
+        self._consecutive_unusable = 0
+        self._terminal_failure = ""
+        self._finalization_reason = ""
+        self._retrieval_terminal_reason = ""
+        self._successful_search_urls: set[str] = set()
+        self._successful_extract_urls: set[str] = set()
+        # https URLs seen inside content this child successfully extracted
+        self._extract_content_urls: set[str] = set()
+        self._task_started_monotonic: float | None = None
+        self._wall_deadline_monotonic: float | None = None
+        self._last_task_write_sha256: str | None = None
+
+    def bind_task(
+        self,
+        task_id: str,
+        *,
+        task_started_monotonic: float | None = None,
+        child_timeout_seconds: float | None = None,
+    ) -> None:
+        if not isinstance(task_id, str) or not task_id:
+            raise ValueError("research contract requires a stable child task id")
+        current_exists, current_sha256 = _path_state(Path(self.contract.path))
+        if (
+            current_exists != self.contract.initial_exists
+            or current_sha256 != self.contract.initial_sha256
+        ):
+            raise ValueError(
+                "research artifact changed after admission and before child start"
+            )
+        started = (
+            float(task_started_monotonic)
+            if isinstance(task_started_monotonic, (int, float))
+            else time.monotonic()
+        )
+        deadline = None
+        if (
+            isinstance(child_timeout_seconds, (int, float))
+            and not isinstance(child_timeout_seconds, bool)
+            and child_timeout_seconds > 0
+        ):
+            deadline = started + float(child_timeout_seconds)
+        with self._lock:
+            self._task_id = task_id
+            self._task_started_monotonic = started
+            self._wall_deadline_monotonic = deadline
+
+    @property
+    def skeleton_written(self) -> bool:
+        with self._lock:
+            return self._skeleton_written
+
+    @property
+    def terminal_failure(self) -> str:
+        with self._lock:
+            return self._terminal_failure
+
+    @property
+    def final_validation_failures(self) -> int:
+        with self._lock:
+            return self._final_validation_failures
+
+    @property
+    def final_validation_exhausted(self) -> bool:
+        with self._lock:
+            return self._final_validation_exhausted
+
+    @property
+    def consecutive_incomplete_checkpoints(self) -> int:
+        with self._lock:
+            return self._consecutive_incomplete_checkpoints
+
+    @property
+    def incomplete_checkpoint_exhausted(self) -> bool:
+        with self._lock:
+            return self._incomplete_checkpoint_exhausted
+
+    @property
+    def retrieval_attempts(self) -> int:
+        with self._lock:
+            return self._retrieval_attempts
+
+    @property
+    def consecutive_unusable(self) -> int:
+        with self._lock:
+            return self._consecutive_unusable
+
+    @property
+    def last_task_write_sha256(self) -> str | None:
+        with self._lock:
+            return self._last_task_write_sha256
+
+    @property
+    def repair_source_read(self) -> bool:
+        with self._lock:
+            return self._repair_source_read
+
+    def before_call(
+        self,
+        tool_name: str,
+        args: Mapping[str, Any] | None,
+        *,
+        iterations_remaining: int | None,
+    ) -> ResearchContractDecision | None:
+        args = args if isinstance(args, Mapping) else {}
+        with self._lock:
+            self._emitted_calls += 1
+            ordinal = self._emitted_calls
+            if not self._skeleton_written:
+                iteration_marker = (
+                    iterations_remaining
+                    if isinstance(iterations_remaining, int)
+                    and not isinstance(iterations_remaining, bool)
+                    else None
+                )
+                if (
+                    iteration_marker is None
+                    or iteration_marker != self._last_skeleton_iterations_remaining
+                ):
+                    self._skeleton_tool_iterations += 1
+                    self._last_skeleton_iterations_remaining = iteration_marker
+            skeleton_iteration = self._skeleton_tool_iterations
+
+            if self._terminal_failure:
+                return ResearchContractDecision(
+                    "research_contract_terminal_failure",
+                    self._terminal_failure,
+                    terminal_failure=True,
+                )
+
+            requested_write_path = (
+                args.get("path") if tool_name == "write_file" else None
+            )
+            normalized_write_path = (
+                posixpath.normpath(requested_write_path)
+                if isinstance(requested_write_path, str)
+                and posixpath.isabs(requested_write_path)
+                else ""
+            )
+            exact_skeleton_candidate = (
+                tool_name == "write_file"
+                and normalized_write_path == self.contract.path
+            )
+            if (
+                not self._skeleton_written
+                and skeleton_iteration >= SKELETON_TOOL_ITERATION_DEADLINE
+                and not self._pending_skeleton_writes
+                and not exact_skeleton_candidate
+            ):
+                self._terminal_failure = (
+                    "The exact research skeleton was not written within the "
+                    "first 3 tool-emitting model iterations."
+                )
+                return ResearchContractDecision(
+                    "research_skeleton_deadline",
+                    self._terminal_failure,
+                    terminal_failure=True,
+                )
+
+            if tool_name not in _ALLOWED_CONTRACT_TOOLS:
+                return ResearchContractDecision(
+                    "research_contract_tool_surface",
+                    f"{tool_name} is disabled for this research child. Allowed "
+                    "tools are read_file, write_file, web_search, and web_extract; "
+                    f"write_file is restricted to {self.contract.path!r}.",
+                )
+
+            if self._repair_existing and not self._repair_source_read:
+                requested_read_path = (
+                    args.get("path") if tool_name == "read_file" else None
+                )
+                normalized_read_path = (
+                    posixpath.normpath(requested_read_path)
+                    if isinstance(requested_read_path, str)
+                    and posixpath.isabs(requested_read_path)
+                    else ""
+                )
+                exact_repair_read = bool(
+                    tool_name == "read_file"
+                    and set(args).issubset({"path", "offset", "limit"})
+                    and normalized_read_path == self.contract.path
+                    and type(args.get("offset", 1)) is int
+                    and args.get("offset", 1) == 1
+                    and type(args.get("limit", 500)) is int
+                    and args.get("limit", 500) == 500
+                )
+                if not exact_repair_read:
+                    return ResearchContractDecision(
+                        "research_repair_source_read_required",
+                        "This bounded repair must first preserve and fully read the "
+                        "existing controller-frozen candidate. Call read_file once "
+                        f"for {self.contract.path!r} with offset=1 and limit=500; "
+                        "do not write a replacement skeleton, retrieve sources, or "
+                        "emit prose before that exact read succeeds.",
+                        status="rejected",
+                        retryable=True,
+                        executed=False,
+                    )
+                if self._pending_repair_source_read:
+                    return ResearchContractDecision(
+                        "research_repair_source_read_pending",
+                        "The exact preserved-candidate read is already pending. "
+                        "Wait for its structured result before another tool call.",
+                        status="rejected",
+                        retryable=True,
+                        executed=False,
+                    )
+                self._pending_repair_source_read = True
+                return None
+
+            if (
+                self._repair_existing
+                and self._repair_source_read
+                and tool_name == "read_file"
+            ):
+                return ResearchContractDecision(
+                    "research_repair_source_already_read",
+                    "The existing repair candidate already has one exact full-read "
+                    "receipt. Continue with bounded citation retrieval and the "
+                    "in-place corrected write; do not reread it.",
+                    status="rejected",
+                    retryable=True,
+                    executed=False,
+                )
+
+            if tool_name == "write_file":
+                requested = args.get("path")
+                normalized = normalized_write_path
+                if normalized != self.contract.path:
+                    if (
+                        skeleton_iteration >= SKELETON_TOOL_ITERATION_DEADLINE
+                        and not self._pending_skeleton_writes
+                    ):
+                        self._terminal_failure = (
+                            "The exact research skeleton was not written within the "
+                            "first 3 tool-emitting model iterations."
+                        )
+                    return ResearchContractDecision(
+                        "research_artifact_wrong_path",
+                        f"write_file is restricted to the exact artifact path "
+                        f"{self.contract.path!r}; requested {requested!r}.",
+                        terminal_failure=bool(self._terminal_failure),
+                    )
+                if not self._skeleton_written:
+                    if self._last_task_write_sha256 is None:
+                        try:
+                            current_exists, current_sha256 = _path_state(
+                                Path(self.contract.path)
+                            )
+                        except ValueError as exc:
+                            self._terminal_failure = str(exc)
+                            return ResearchContractDecision(
+                                "research_artifact_initial_state",
+                                self._terminal_failure,
+                                terminal_failure=True,
+                            )
+                        if (
+                            _path_contains_symlink(Path(self.contract.path))
+                            or current_exists != self.contract.initial_exists
+                            or current_sha256 != self.contract.initial_sha256
+                        ):
+                            self._terminal_failure = (
+                                "The research artifact path/state changed after "
+                                "admission and before the initial write."
+                            )
+                            return ResearchContractDecision(
+                                "research_artifact_initial_state",
+                                self._terminal_failure,
+                                terminal_failure=True,
+                            )
+                    if self._pending_skeleton_writes:
+                        return ResearchContractDecision(
+                            "research_skeleton_write_pending",
+                            "One exact-path skeleton write is already pending; "
+                            "wait for its structured result before emitting "
+                            "another write.",
+                        )
+                    self._pending_skeleton_writes.add(ordinal)
+                return None
+
+            if not self._skeleton_written:
+                if (
+                    skeleton_iteration >= SKELETON_TOOL_ITERATION_DEADLINE
+                    and not self._pending_skeleton_writes
+                ):
+                    self._terminal_failure = (
+                        "The exact research skeleton was not written within the "
+                        "first 3 tool-emitting model iterations."
+                    )
+                    return ResearchContractDecision(
+                        "research_skeleton_deadline",
+                        self._terminal_failure,
+                        terminal_failure=True,
+                    )
+                if tool_name == "read_file":
+                    return ResearchContractDecision(
+                        "research_skeleton_read_blocked",
+                        "read_file is blocked until the first exact-path skeleton "
+                        "write is positively verified.",
+                    )
+                if _is_retrieval_tool(tool_name):
+                    return ResearchContractDecision(
+                        "research_skeleton_required",
+                        f"Retrieval is blocked until write_file successfully creates "
+                        f"the skeleton at {self.contract.path!r}.",
+                        status="rejected",
+                        retryable=True,
+                        executed=False,
+                    )
+                return None
+
+            if not _is_retrieval_tool(tool_name):
+                return None
+
+            if self._retrieval_terminal_reason:
+                return ResearchContractDecision(
+                    "research_retrieval_terminal",
+                    self._retrieval_terminal_reason,
+                )
+
+            if tool_name == "web_extract":
+                raw_urls = args.get("urls")
+                values = raw_urls if isinstance(raw_urls, list) else []
+                requested_urls = {
+                    url for value in values if (url := _normalize_https_url(value))
+                }
+                if not values or len(requested_urls) != len(values):
+                    return ResearchContractDecision(
+                        "research_extract_urls_invalid",
+                        "web_extract requires a non-empty unique list of HTTPS URLs.",
+                    )
+                disallowed_sources = sorted(
+                    url
+                    for url in requested_urls
+                    if not research_source_policy_allows_url(
+                        self.contract.source_policy_id, url
+                    )
+                )
+                if disallowed_sources:
+                    return ResearchContractDecision(
+                        "research_extract_source_policy",
+                        "web_extract was blocked before network I/O because one or "
+                        "more requested URLs are outside the controller-owned "
+                        f"source policy {self.contract.source_policy_id!r}.",
+                        status="rejected",
+                        retryable=True,
+                        executed=False,
+                    )
+                discovered = set(self._successful_search_urls)
+                if ALLOW_LINK_FOLLOWED_PROVENANCE:
+                    discovered |= self._extract_content_urls
+                missing_search = sorted(requested_urls - discovered)
+                if missing_search:
+                    safe_missing = ", ".join(
+                        _provenance_feedback_url(url) for url in missing_search
+                    )
+                    safe_candidates = (
+                        ", ".join(
+                            _provenance_feedback_url(url)
+                            for url in sorted(self._successful_search_urls)
+                        )
+                        or "[none yet]"
+                    )
+                    # The receipted members of THIS batch. Naming them turns
+                    # recovery into one obvious re-request instead of a guess
+                    # against the full candidate list.
+                    receipted_subset = sorted(
+                        requested_urls & self._successful_search_urls
+                    )
+                    safe_receipted_subset = ", ".join(
+                        _provenance_feedback_url(url) for url in receipted_subset
+                    )
+                    # Report requested-vs-missing counts. The whole batch is
+                    # rejected when ANY url lacks provenance, so a mixed batch
+                    # loses its receipted urls too - and without these counts a
+                    # post-mortem cannot tell a mixed batch from a wholly
+                    # remembered one, which are different defects.
+                    return ResearchContractDecision(
+                        "research_extract_requires_search_provenance",
+                        "web_extract may request only exact URLs already returned "
+                        "by this child's successful web_search calls. "
+                        f"{len(missing_search)} of {len(requested_urls)} requested "
+                        "URL(s) have no search receipt, so the whole batch was "
+                        "rejected. "
+                        + (
+                            "Re-request exactly these and nothing else: "
+                            f"{safe_receipted_subset}. "
+                            if receipted_subset
+                            else "None of the requested URLs is receipted; search "
+                            "first, then extract only URLs the search returned. "
+                        )
+                        + "Missing: "
+                        f"{safe_missing}. Exact searched candidates: "
+                        f"{safe_candidates}.",
+                    )
+
+            if (
+                isinstance(iterations_remaining, int)
+                and not isinstance(iterations_remaining, bool)
+                and iterations_remaining <= FINAL_ITERATION_RESERVE
+            ):
+                self._finalization_reason = (
+                    "The final seven model iterations are reserved for artifact "
+                    "checkpointing, validation, and return."
+                )
+                return ResearchContractDecision(
+                    "research_final_iteration_reserve",
+                    self._finalization_reason,
+                )
+            if (
+                self._wall_deadline_monotonic is not None
+                and time.monotonic()
+                >= self._wall_deadline_monotonic - FINAL_WALL_RESERVE_SECONDS
+            ):
+                self._finalization_reason = (
+                    "The final five wall-clock minutes are reserved for artifact "
+                    "checkpointing, validation, and return."
+                )
+                return ResearchContractDecision(
+                    "research_final_wall_reserve",
+                    self._finalization_reason,
+                )
+            if (
+                tool_name == "web_search"
+                # Once final validation has failed at least once, the child is in
+                # repair and the feedback tells it to "search for the others
+                # first". Holding the search share closed then makes that repair
+                # impossible, which is how children burned all three attempts and
+                # exited research_validation_blocked. The total MAX_RETRIEVAL_
+                # ATTEMPTS budget still binds, so this widens nothing overall.
+                and self._final_validation_failures == 0
+                and self._retrieval_attempts
+                >= MAX_RETRIEVAL_ATTEMPTS - RESERVED_EXTRACT_ATTEMPTS
+            ):
+                # Deliberately does NOT set _finalization_reason: extraction is still
+                # open, so this steers the child rather than ending its retrieval.
+                return ResearchContractDecision(
+                    "research_search_share_exhausted",
+                    "The search share of the retrieval budget is spent "
+                    f"({MAX_RETRIEVAL_ATTEMPTS - RESERVED_EXTRACT_ATTEMPTS} of "
+                    f"{MAX_RETRIEVAL_ATTEMPTS} attempts). The remaining "
+                    f"{RESERVED_EXTRACT_ATTEMPTS} are reserved for web_extract, "
+                    "because every cited URL needs a non-empty web_extract receipt "
+                    "as well as a search receipt. Do not search again - extract the "
+                    "pages you have already found, then write the brief.",
+                )
+            if self._retrieval_attempts >= MAX_RETRIEVAL_ATTEMPTS:
+                self._finalization_reason = (
+                    f"The {MAX_RETRIEVAL_ATTEMPTS}-attempt retrieval budget is exhausted."
+                )
+                return ResearchContractDecision(
+                    "research_retrieval_budget_exhausted",
+                    self._finalization_reason,
+                )
+            if self._consecutive_unusable >= MAX_CONSECUTIVE_UNUSABLE:
+                self._finalization_reason = (
+                    "Three consecutive structured retrieval outcomes were unusable."
+                )
+                return ResearchContractDecision(
+                    "research_retrieval_unusable_limit",
+                    self._finalization_reason,
+                )
+            # Do not launch more concurrent retrievals than could be admitted if
+            # every pending result is unusable. This prevents batch overshoot.
+            if (
+                self._consecutive_unusable + self._pending_retrievals
+                >= MAX_CONSECUTIVE_UNUSABLE
+            ):
+                return ResearchContractDecision(
+                    "research_retrieval_outcome_pending",
+                    "Wait for the currently admitted retrieval outcomes before "
+                    "starting another retrieval.",
+                )
+
+            self._retrieval_attempts += 1
+            self._pending_retrievals += 1
+            return None
+
+    def after_call(
+        self,
+        tool_name: str,
+        args: Mapping[str, Any] | None,
+        result: Any,
+        *,
+        failed: bool,
+    ) -> ResearchWriteFeedback | None:
+        with self._observation_lock:
+            return self._after_call_serialized(
+                tool_name,
+                args,
+                result,
+                failed=failed,
+            )
+
+    def _after_call_serialized(
+        self,
+        tool_name: str,
+        args: Mapping[str, Any] | None,
+        result: Any,
+        *,
+        failed: bool,
+    ) -> ResearchWriteFeedback | None:
+        args = args if isinstance(args, Mapping) else {}
+        write_feedback: ResearchWriteFeedback | None = None
+        validation_task_id = ""
+        validation_since_monotonic: float | None = None
+        validation_content: str | None = None
+        with self._lock:
+            validate_post_skeleton_write = False
+            if (
+                tool_name == "read_file"
+                and self._repair_existing
+                and not self._repair_source_read
+            ):
+                pending = self._pending_repair_source_read
+                self._pending_repair_source_read = False
+                payload = _json_object(result)
+                read_content = (
+                    payload.get("content") if isinstance(payload, dict) else None
+                )
+                exact_read = False
+                state_changed = False
+                if pending and not failed and isinstance(read_content, str):
+                    try:
+                        artifact_path = Path(self.contract.path)
+                        if _path_contains_symlink(artifact_path):
+                            raise ValueError("repair artifact path became a symlink")
+                        raw = artifact_path.read_bytes()
+                        state_changed = (
+                            _sha256_bytes(raw) != self.contract.initial_sha256
+                        )
+                        exact_read = bool(
+                            not state_changed
+                            and payload.get("truncated") is False
+                            and isinstance(payload.get("total_lines"), int)
+                            and not isinstance(payload.get("total_lines"), bool)
+                            and _read_result_matches_bytes(read_content, raw)
+                        )
+                    except (OSError, ValueError):
+                        state_changed = True
+                if state_changed:
+                    self._terminal_failure = (
+                        "The preserved repair candidate changed after admission "
+                        "and before its mandatory exact read completed."
+                    )
+                    write_feedback = ResearchWriteFeedback(
+                        status="blocked",
+                        validator_ran=False,
+                        message=self._terminal_failure,
+                        terminal=True,
+                        retryable=False,
+                    )
+                elif exact_read:
+                    self._repair_source_read = True
+                    write_feedback = ResearchWriteFeedback(
+                        status="not_final",
+                        validator_ran=False,
+                        message=(
+                            "Existing repair candidate preserved and fully read. "
+                            "Retain its useful supported content, re-establish "
+                            "search-and-extract provenance for every cited URL you "
+                            "keep, and rewrite the same path in place. Never replace "
+                            "it with an incomplete skeleton."
+                        ),
+                    )
+                else:
+                    write_feedback = ResearchWriteFeedback(
+                        status="repair_source_read_invalid",
+                        validator_ran=False,
+                        message=(
+                            "The existing repair candidate read was incomplete or "
+                            "did not expose its exact bytes. Retry read_file once for "
+                            f"{self.contract.path!r} with offset=1 and limit=500."
+                        ),
+                    )
+            if tool_name == "write_file":
+                skeleton_was_written = self._skeleton_written
+                pending = bool(self._pending_skeleton_writes)
+                self._pending_skeleton_writes.clear()
+                requested = args.get("path")
+                normalized = (
+                    posixpath.normpath(requested)
+                    if isinstance(requested, str) and posixpath.isabs(requested)
+                    else ""
+                )
+                content = args.get("content")
+                payload = _json_object(result)
+                positive_receipt = (
+                    not failed
+                    and isinstance(content, str)
+                    and isinstance(payload, dict)
+                    and payload.get("success") is True
+                    and not payload.get("error")
+                    and str(payload.get("status") or "").casefold()
+                    not in _FAILED_STATUSES
+                    and payload.get("resolved_path") == self.contract.path
+                    and isinstance(payload.get("files_modified"), list)
+                    and self.contract.path in payload["files_modified"]
+                    and payload.get("bytes_written") == len(content.encode("utf-8"))
+                )
+                landed_digest = None
+                if positive_receipt and normalized == self.contract.path:
+                    try:
+                        from tools import file_state
+
+                        if _path_contains_symlink(Path(self.contract.path)):
+                            raise ValueError("artifact path became a symlink")
+                        expected_bytes = content.encode("utf-8")
+                        with file_state.lock_path(self.contract.path):
+                            if self._task_started_monotonic is None:
+                                raise ValueError(
+                                    "bound task ownership window is unavailable"
+                                )
+                            task_writes = {
+                                str(Path(path).resolve())
+                                for path in file_state.known_writes(
+                                    self._task_id,
+                                    since_monotonic=self._task_started_monotonic,
+                                )
+                            }
+                            if self.contract.path not in task_writes:
+                                raise ValueError(
+                                    "write receipt is not owned by this exact task"
+                                )
+                            disk_bytes = Path(self.contract.path).read_bytes()
+                            if disk_bytes != expected_bytes:
+                                raise ValueError(
+                                    "artifact disk bytes do not match requested content"
+                                )
+                            landed_digest = _sha256_bytes(disk_bytes)
+                    except (OSError, ValueError) as exc:
+                        positive_receipt = False
+                        self._terminal_failure = (
+                            "Research artifact write verification failed: " + str(exc)
+                        )
+                if failed or (
+                    isinstance(payload, dict) and payload.get("success") is False
+                ):
+                    self._terminal_failure = (
+                        self._terminal_failure
+                        or "Research artifact write returned a structured failure receipt."
+                    )
+                if positive_receipt and landed_digest:
+                    self._last_task_write_sha256 = landed_digest
+                    if not skeleton_was_written:
+                        valid, reason = validate_skeleton_content(
+                            content,
+                            self.contract.fields,
+                            self.contract.subject,
+                        )
+                        if valid:
+                            self._skeleton_written = True
+                            self._completion_validation_passed = False
+                            write_feedback = ResearchWriteFeedback(
+                                status="not_final",
+                                validator_ran=False,
+                                message=(
+                                    "Research skeleton accepted. This checkpoint is "
+                                    "intentionally incomplete; retrieve evidence and "
+                                    "write the same exact path again for validator "
+                                    "feedback."
+                                ),
+                            )
+                        elif (
+                            self._skeleton_tool_iterations
+                            >= SKELETON_TOOL_ITERATION_DEADLINE
+                        ):
+                            self._terminal_failure = reason
+                        else:
+                            write_feedback = ResearchWriteFeedback(
+                                status="skeleton_invalid",
+                                validator_ran=False,
+                                message=reason,
+                            )
+                    else:
+                        # The exact-path write was positively verified against
+                        # task ownership and disk bytes above. Only that state is
+                        # eligible to execute captured validator bytes.
+                        validate_post_skeleton_write = True
+                elif (
+                    pending
+                    and self._skeleton_tool_iterations
+                    >= SKELETON_TOOL_ITERATION_DEADLINE
+                ):
+                    self._terminal_failure = self._terminal_failure or (
+                        "The exact research skeleton write lacked a positive, "
+                        "task-owned, byte-matching receipt within the first 3 "
+                        "tool-emitting model iterations."
+                    )
+
+            if not _is_retrieval_tool(tool_name):
+                if validate_post_skeleton_write:
+                    validation_task_id = self._task_id
+                    validation_since_monotonic = self._task_started_monotonic
+                    validation_content = content if isinstance(content, str) else None
+            else:
+                if self._pending_retrievals > 0:
+                    self._pending_retrievals -= 1
+                successful_urls = _successful_retrieval_urls(
+                    tool_name, args, result, failed=failed
+                )
+                if tool_name == "web_search":
+                    self._successful_search_urls.update(successful_urls)
+                elif tool_name == "web_extract":
+                    self._successful_extract_urls.update(successful_urls)
+                    if successful_urls:
+                        self._extract_content_urls.update(
+                            _https_urls_in_text(result)
+                        )
+                if successful_urls:
+                    # A positively observed retrieval advances evidence work,
+                    # so a later incomplete checkpoint starts a fresh bounded
+                    # streak. Empty, failed, or rejected retrievals do not.
+                    self._consecutive_incomplete_checkpoints = 0
+                terminal_reason = _structured_retrieval_terminal_reason(result)
+                if terminal_reason:
+                    self._retrieval_terminal_reason = terminal_reason
+                if _structured_retrieval_unusable(result, failed):
+                    self._consecutive_unusable += 1
+                    if self._consecutive_unusable >= MAX_CONSECUTIVE_UNUSABLE:
+                        self._finalization_reason = (
+                            "Three consecutive structured retrieval outcomes were "
+                            "unusable."
+                        )
+                else:
+                    self._consecutive_unusable = 0
+
+        if validation_task_id:
+            if _has_single_incomplete_frontmatter_status(validation_content):
+                exhausted = False
+                with self._lock:
+                    self._completion_validation_passed = False
+                    self._consecutive_incomplete_checkpoints += 1
+                    if (
+                        self._consecutive_incomplete_checkpoints
+                        >= MAX_CONSECUTIVE_INCOMPLETE_CHECKPOINTS
+                    ):
+                        self._incomplete_checkpoint_exhausted = True
+                        self._terminal_failure = (
+                            "The bounded incomplete-checkpoint budget was "
+                            "exhausted after three consecutive post-skeleton "
+                            "writes without a successful retrieval or final "
+                            "candidate."
+                        )
+                        exhausted = True
+                return ResearchWriteFeedback(
+                    status="blocked" if exhausted else "not_final",
+                    validator_ran=False,
+                    message=(
+                        RESEARCH_CHILD_BLOCKED_RESPONSE
+                        if exhausted
+                        else (
+                            "Research checkpoint accepted with status=incomplete. "
+                            "Continue evidence work; the validator will run when "
+                            "the same exact path is written as a final candidate."
+                        )
+                    ),
+                    terminal=exhausted,
+                    retryable=not exhausted,
+                )
+            if validation_since_monotonic is None:
+                return ResearchWriteFeedback(
+                    status="fail",
+                    validator_ran=False,
+                    message=(
+                        "Research validator feedback was denied because the bound "
+                        "task ownership window is unavailable."
+                    ),
+                )
+            validation = self.validate_completion(
+                validation_task_id,
+                since_monotonic=validation_since_monotonic,
+            )
+            exhausted = False
+            with self._lock:
+                self._consecutive_incomplete_checkpoints = 0
+                self._completion_validation_passed = validation.passed
+                if not validation.passed:
+                    self._final_validation_failures += 1
+                    # The only place the child's actual validation reason exists.
+                    # Without it a post-mortem sees three failed repairs and a
+                    # canned blocked response, with no way to know WHICH check
+                    # rejected the artifact.
+                    logger.warning(
+                        "Research final-candidate validation FAILED (%d/%d) "
+                        "terminal=%s retryable=%s: %s%s",
+                        self._final_validation_failures,
+                        MAX_FINAL_VALIDATION_FAILURES,
+                        validation.terminal,
+                        validation.retryable,
+                        validation.message,
+                        (
+                            " | validator: " + validation.validator_output[:500]
+                            if validation.validator_output
+                            else ""
+                        ),
+                    )
+                    if (
+                        self._final_validation_failures
+                        >= MAX_FINAL_VALIDATION_FAILURES
+                    ):
+                        self._final_validation_exhausted = True
+                        self._terminal_failure = (
+                            "The bounded final-candidate validation budget was "
+                            f"exhausted after {MAX_FINAL_VALIDATION_FAILURES} failed final "
+                            "candidates."
+                        )
+                        exhausted = True
+            return ResearchWriteFeedback(
+                status=(
+                    "pass" if validation.passed else "blocked" if exhausted else "fail"
+                ),
+                validator_ran=True,
+                message=(
+                    RESEARCH_CHILD_BLOCKED_RESPONSE
+                    if exhausted
+                    else validation.message
+                ),
+                validator_output=("" if exhausted else validation.validator_output),
+                terminal=exhausted,
+                retryable=not exhausted,
+            )
+        return write_feedback
+
+    def completion_nudge(self) -> str | None:
+        """Return a bounded stop-loop instruction until validation passes."""
+
+        with self._lock:
+            if self._terminal_failure or self._completion_validation_passed:
+                return None
+            path = self.contract.path
+            if self._repair_existing and not self._repair_source_read:
+                return (
+                    "The repair task is not complete. Your next and only tool call "
+                    f"must be read_file for the preserved candidate {path!r} with "
+                    "offset=1 and limit=500. Do not replace it with a skeleton."
+                )
+            if not self._skeleton_written:
+                return (
+                    "The research task is not complete. Your next tool call must "
+                    f"be write_file for the exact skeleton path {path!r}. Do not "
+                    "return a summary before that controller-accepted write."
+                )
+            return (
+                "The research task is not complete because the exact artifact "
+                "has not passed controller validation. Process the most recent "
+                "research_validation feedback, then write_file to the same exact "
+                f"path {path!r} with status: complete. Mark unsupported fields "
+                "unverified and do not return a success summary until the write "
+                "receipt reports research_validation status=pass."
+            )
+
+    def validate_completion(
+        self,
+        task_id: str,
+        *,
+        since_monotonic: float,
+        timeout_seconds: float = 30.0,
+    ) -> ResearchValidationResult:
+        if self.terminal_failure:
+            exhausted = (
+                self.final_validation_exhausted
+                or self.incomplete_checkpoint_exhausted
+            )
+            return ResearchValidationResult(
+                False,
+                self.terminal_failure,
+                terminal=exhausted,
+                retryable=not exhausted,
+            )
+        if not self.skeleton_written:
+            return ResearchValidationResult(
+                False,
+                "The child never completed the controller-accepted artifact skeleton.",
+            )
+        if self._repair_existing and not self.repair_source_read:
+            return ResearchValidationResult(
+                False,
+                "The repair child never fully read the preserved candidate before "
+                "attempting completion.",
+            )
+        task_digest = self.last_task_write_sha256
+        if not task_digest:
+            return ResearchValidationResult(
+                False,
+                "No exact task-owned artifact digest was bound after write_file.",
+            )
+        with self._lock:
+            successful_search_urls = frozenset(self._successful_search_urls)
+            successful_extract_urls = frozenset(self._successful_extract_urls)
+
+        # Keep provenance fail-closed, but do not return before the immutable
+        # evidence validator sees the same candidate. A single repair response
+        # can then name both issue sets instead of making the child oscillate.
+        provenance_failure: ResearchValidationResult | None = None
+
+        from tools import file_state
+
+        expected_path = Path(self.contract.path)
+        expected = str(expected_path)
+        if _path_contains_symlink(expected_path):
+            return ResearchValidationResult(
+                False, "Research artifact path contains a symlink at completion."
+            )
+        if (
+            not self.contract.validator_bytes
+            or _sha256_bytes(self.contract.validator_bytes)
+            != self.contract.validator_sha256
+        ):
+            return ResearchValidationResult(
+                False, "Captured research validator bytes failed their SHA-256 binding."
+            )
+
+        try:
+            with file_state.lock_path(expected):
+                written = {
+                    str(Path(path).resolve())
+                    for path in file_state.known_writes(
+                        task_id, since_monotonic=since_monotonic
+                    )
+                }
+                if expected not in written:
+                    return ResearchValidationResult(
+                        False,
+                        "The exact artifact is not currently owned by this child task: "
+                        f"{expected}",
+                    )
+                live_before = expected_path.read_bytes()
+                live_before_sha = _sha256_bytes(live_before)
+                if live_before_sha != task_digest:
+                    return ResearchValidationResult(
+                        False,
+                        "Live artifact bytes do not match the exact task-owned "
+                        "post-write digest.",
+                    )
+                if self.contract.subject:
+                    try:
+                        live_text = live_before.decode("utf-8")
+                    except UnicodeDecodeError:
+                        return ResearchValidationResult(
+                            False,
+                            "Research artifact is not valid UTF-8 at completion.",
+                        )
+                    live_metadata, _ = _parse_frontmatter(live_text)
+                    if live_metadata.get("entity", "").strip() != self.contract.subject:
+                        return ResearchValidationResult(
+                            False,
+                            "Research artifact entity does not exactly match the "
+                            f"controller-bound subject {self.contract.subject!r}.",
+                        )
+                source_policy_violations = _cited_source_policy_violations(
+                    live_before,
+                    self.contract.source_policy_id,
+                )
+                if source_policy_violations:
+                    return ResearchValidationResult(
+                        False,
+                        "Research citation source policy failed. Final citations "
+                        "must remain inside the controller-owned source class.",
+                        validator_output=(
+                            f"{len(source_policy_violations)} citation(s) were "
+                            "outside source policy "
+                            f"{self.contract.source_policy_id!r}. Remove those "
+                            "claims/citations or retrieve an admitted source."
+                        ),
+                    )
+                cited_urls = _cited_https_urls(live_before)
+                cited_url_lines = _cited_https_url_lines(live_before)
+                discovered_urls = set(successful_search_urls)
+                if ALLOW_LINK_FOLLOWED_PROVENANCE:
+                    discovered_urls |= self._extract_content_urls
+                missing_search = sorted(cited_urls - discovered_urls)
+                missing_extract = sorted(cited_urls - successful_extract_urls)
+                if missing_search or missing_extract:
+                    details: list[str] = []
+
+                    def cited_lines(url: str) -> str:
+                        values = cited_url_lines.get(url, ())
+                        return ",".join(map(str, values)) if values else "[unknown]"
+
+                    if missing_search:
+                        details.extend(
+                            "missing successful web_search receipt at artifact "
+                            f"line(s) {cited_lines(url)}: "
+                            f"{_provenance_feedback_url(url)}"
+                            for url in missing_search
+                        )
+                    if missing_extract:
+                        details.extend(
+                            "missing successful web_extract receipt with non-empty "
+                            f"content at artifact line(s) "
+                            f"{cited_lines(url)}: {_provenance_feedback_url(url)}"
+                            for url in missing_extract
+                        )
+                    supported_exact = sorted(
+                        discovered_urls & successful_extract_urls
+                    )
+                    details.append(
+                        "Exact citation URLs with accepted discovery provenance and "
+                        "non-empty extract receipts: "
+                        + (
+                            ", ".join(
+                                _provenance_feedback_url(url) for url in supported_exact
+                            )
+                            if supported_exact
+                            else "[none]"
+                        )
+                        + ". Delete unsupported claims/citations or replace a URL "
+                        "only when that exact receipted page supports the claim."
+                    )
+                    provenance_failure = ResearchValidationResult(
+                        False,
+                        "Research citation provenance failed. Every cited HTTPS URL "
+                        "must have accepted discovery provenance and a successful "
+                        "web_extract result with non-empty content.",
+                        validator_output=_redact_and_cap(
+                            "\n".join(details), VALIDATOR_FEEDBACK_OUTPUT_LIMIT
+                        ),
+                    )
+
+                completed = None
+                run_error = None
+                with tempfile.TemporaryDirectory(
+                    prefix="hermes-research-validate-"
+                ) as tmp:
+                    private_dir = Path(tmp)
+                    snapshot_path = private_dir / "artifact.snapshot.md"
+                    validator_path = private_dir / "validator.snapshot.py"
+                    for private_path, private_bytes in (
+                        (snapshot_path, live_before),
+                        (validator_path, self.contract.validator_bytes),
+                    ):
+                        fd = os.open(
+                            private_path,
+                            os.O_WRONLY | os.O_CREAT | os.O_EXCL,
+                            0o600,
+                        )
+                        try:
+                            with os.fdopen(fd, "wb", closefd=False) as handle:
+                                handle.write(private_bytes)
+                                handle.flush()
+                                os.fsync(handle.fileno())
+                        finally:
+                            os.close(fd)
+                        os.chmod(private_path, 0o400)
+                    if _sha256_bytes(snapshot_path.read_bytes()) != task_digest:
+                        return ResearchValidationResult(
+                            False, "Private artifact snapshot digest mismatch."
+                        )
+                    if (
+                        _sha256_bytes(validator_path.read_bytes())
+                        != self.contract.validator_sha256
+                    ):
+                        return ResearchValidationResult(
+                            False, "Private validator snapshot digest mismatch."
+                        )
+                    validator_args = [
+                        sys.executable,
+                        str(validator_path),
+                        str(snapshot_path),
+                        "--min-sources",
+                        "1",
+                    ]
+                    for field in self.contract.fields:
+                        validator_args.extend(["--required-field", field])
+                    validator_args.extend(
+                        [
+                            "--require-claim-citations",
+                            "--forbid-unverified",
+                            "--require-atomic-claims",
+                        ]
+                    )
+                    try:
+                        completed = subprocess.run(
+                            validator_args,
+                            shell=False,
+                            capture_output=True,
+                            text=True,
+                            timeout=timeout_seconds,
+                            check=False,
+                            env=os.environ.copy(),
+                        )
+                    except Exception as exc:
+                        run_error = exc
+                    if _sha256_bytes(snapshot_path.read_bytes()) != task_digest:
+                        return ResearchValidationResult(
+                            False, "Validator mutated the immutable artifact snapshot."
+                        )
+
+                live_after = expected_path.read_bytes()
+                live_after_sha = _sha256_bytes(live_after)
+                owner_after = {
+                    str(Path(path).resolve())
+                    for path in file_state.known_writes(
+                        task_id, since_monotonic=since_monotonic
+                    )
+                }
+                if (
+                    live_after_sha != live_before_sha
+                    or live_after_sha != task_digest
+                    or expected not in owner_after
+                ):
+                    return ResearchValidationResult(
+                        False,
+                        "Research artifact changed or lost exact task ownership "
+                        "during validation.",
+                    )
+        except OSError as exc:
+            return ResearchValidationResult(
+                False, f"Research artifact snapshot/validation I/O failed: {exc}"
+            )
+
+        if run_error is not None:
+            return ResearchValidationResult(
+                False,
+                _redact_and_cap(
+                    "Research evidence validator could not run: "
+                    f"{type(run_error).__name__}: {run_error}",
+                    VALIDATOR_FEEDBACK_MESSAGE_LIMIT,
+                ),
+            )
+        output = _redact_and_cap(
+            "\n".join(
+                part.strip()
+                for part in (completed.stdout, completed.stderr)
+                if part.strip()
+            ),
+            VALIDATOR_FEEDBACK_OUTPUT_LIMIT,
+        )
+        evidence_failed = completed.returncode != 0
+        if provenance_failure is not None and evidence_failed:
+            combined_output = _redact_and_cap(
+                "Citation provenance issues:\n"
+                + (provenance_failure.validator_output or "[no details]")
+                + "\n\nEvidence-format and contract issues:\n"
+                + (output or "[validator returned no details]"),
+                VALIDATOR_FEEDBACK_OUTPUT_LIMIT,
+            )
+            return ResearchValidationResult(
+                False,
+                "Research artifact failed citation provenance and immutable "
+                "evidence validation. Repair both issue sets in the same candidate.",
+                validator_output=combined_output,
+            )
+        if provenance_failure is not None:
+            return provenance_failure
+        if evidence_failed:
+            return ResearchValidationResult(
+                False,
+                f"Research evidence validator failed with exit {completed.returncode}.",
+                validator_output=output,
+            )
+        return ResearchValidationResult(
+            True,
+            "Research artifact passed the immutable evidence validator snapshot.",
+            validator_output=output,
+        )
+
+
+def get_research_controller(agent) -> ResearchContractController | None:
+    controller = getattr(agent, "_research_contract_controller", None)
+    return controller if isinstance(controller, ResearchContractController) else None
+
+
+def before_agent_tool_call(
+    agent,
+    tool_name: str,
+    args: Mapping[str, Any] | None,
+) -> ResearchContractDecision | None:
+    current_turn_id = getattr(agent, "_current_turn_id", None)
+    from agent.product_route import (
+        product_research_allowed_tools,
+        product_research_route_active,
+        product_research_terminal_reason,
+    )
+    from agent.travel_route import (
+        TRAVEL_PUBLICATION_ALLOWED_TOOLS,
+        travel_publication_route_active,
+    )
+    from agent.generic_research_route import (
+        generic_research_route_active,
+        generic_research_source_budget_rejection,
+        generic_research_tool_reason,
+    )
+
+    travel_route_active = travel_publication_route_active(agent)
+    if travel_route_active:
+        if tool_name not in TRAVEL_PUBLICATION_ALLOWED_TOOLS:
+            return ResearchContractDecision(
+                "travel_publication_capability_forbidden",
+                "This verified travel session exposes only bounded web retrieval, "
+                "read-only inspection, raw/travel manifest writes, the controlled "
+                "pipeline, and its receipt-only publisher. The requested tool is "
+                "outside that session capability.",
+                terminal_failure=True,
+                status="rejected",
+                retryable=False,
+                executed=False,
+            )
+        if tool_name == "web_search":
+            if getattr(agent, "_travel_search_wave_closed_turn_id", None) == current_turn_id:
+                close_reason = str(
+                    getattr(agent, "_travel_search_wave_closed_reason", "") or ""
+                )
+                if close_reason == "query_budget":
+                    return ResearchContractDecision(
+                        "travel_search_wave_closed_at_query_budget",
+                        "Travel discovery already reached the controller-enforced "
+                        f"limit of {TRAVEL_SEARCH_QUERY_LIMIT} search queries. Web "
+                        "search is closed for this turn: use the successful results "
+                        "already returned and proceed directly to the source manifest "
+                        "and travel controller.",
+                        terminal_failure=False,
+                        status="rejected",
+                        retryable=False,
+                        executed=False,
+                    )
+                return ResearchContractDecision(
+                    "travel_search_wave_closed_after_partial_failure",
+                    "One isolated search request failed after the current batched "
+                    "travel discovery met the executor quorum. Web search is closed "
+                    "for this turn: use the successful sibling results and proceed "
+                    "directly to the source manifest and travel controller.",
+                    terminal_failure=False,
+                    status="rejected",
+                    retryable=False,
+                    executed=False,
+                )
+            admitted, count = _reserve_travel_turn_action(
+                agent,
+                turn_attribute="_travel_search_budget_turn_id",
+                count_attribute="_travel_search_query_count",
+                limit=TRAVEL_SEARCH_QUERY_LIMIT,
+            )
+            if not admitted:
+                message = (
+                    "Travel discovery reached the controller-enforced limit of "
+                    f"{TRAVEL_SEARCH_QUERY_LIMIT} search queries for this turn. "
+                    "The surplus query did not execute and web search is now closed. "
+                    "Use the successful candidates already returned and proceed "
+                    "directly to the source manifest and travel controller; do not "
+                    "invent missing venues."
+                )
+                # The query ceiling is a resource boundary, not a factual-
+                # integrity failure. Reject surplus siblings, close discovery,
+                # and return control to the model so it can use the successful
+                # results from this and earlier batches. Provider/auth failures
+                # remain terminal in observe_agent_tool_result().
+                agent._travel_search_wave_closed_turn_id = current_turn_id
+                agent._travel_search_wave_closed_reason = "query_budget"
+                logging.info(
+                    "Travel discovery reached the %d-query ceiling; surplus search "
+                    "rejected and the turn will continue with existing results",
+                    TRAVEL_SEARCH_QUERY_LIMIT,
+                )
+                return ResearchContractDecision(
+                    "travel_search_query_budget_exhausted",
+                    message,
+                    terminal_failure=False,
+                    status="rejected",
+                    retryable=False,
+                    executed=False,
+                )
+        if tool_name == "terminal":
+            command_reason = _travel_route_terminal_command_reason(args)
+            if command_reason is not None:
+                return ResearchContractDecision(
+                    "travel_publication_terminal_forbidden",
+                    command_reason,
+                    terminal_failure=True,
+                    status="rejected",
+                    retryable=False,
+                    executed=False,
+                )
+            if _travel_route_is_controller_call(args):
+                admitted, count = _reserve_travel_turn_action(
+                    agent,
+                    turn_attribute="_travel_controller_attempt_turn_id",
+                    count_attribute="_travel_controller_attempt_count",
+                    limit=TRAVEL_CONTROLLER_ATTEMPT_LIMIT,
+                )
+                if not admitted:
+                    message = (
+                        "Travel research stopped because this turn already used its "
+                        "single foreground controller attempt. Do not rerun or repair "
+                        "the pipeline in the same turn. The latest run-state.json and "
+                        "run-report.json are authoritative; retry only from a fresh "
+                        "user turn with a new sibling run directory."
+                    )
+                    _set_travel_route_halt(
+                        agent,
+                        code="travel_controller_attempt_limit",
+                        message=message,
+                        tool_name="terminal",
+                        count=count,
+                    )
+                    return ResearchContractDecision(
+                        "travel_controller_attempt_limit",
+                        message,
+                        terminal_failure=True,
+                        status="rejected",
+                        retryable=False,
+                        executed=False,
+                    )
+                if not isinstance(args, dict):
+                    return ResearchContractDecision(
+                        "travel_controller_timeout_binding_failed",
+                        "The controller arguments were not mutable, so the required "
+                        "outer timeout could not be bound.",
+                        terminal_failure=True,
+                        status="rejected",
+                        retryable=False,
+                        executed=False,
+                    )
+                # The controller now uses bounded concurrent review chunks. Keep
+                # enough outer headroom for fetch/extraction plus the slowest
+                # chunk, while each individual model request remains capped by
+                # the controller's own --timeout (600 seconds by default).
+                args["timeout"] = TRAVEL_CONTROLLER_OUTER_TIMEOUT_SECONDS
+            mutation_reason = _travel_route_terminal_mutation_reason(args)
+            if mutation_reason is not None:
+                return ResearchContractDecision(
+                    "travel_publication_vault_mutation_forbidden",
+                    mutation_reason,
+                    terminal_failure=True,
+                    status="rejected",
+                    retryable=False,
+                    executed=False,
+                )
+        if tool_name == "write_file":
+            write_reason = _travel_route_file_write_reason(args)
+            if write_reason is not None:
+                return ResearchContractDecision(
+                    "travel_publication_file_write_forbidden",
+                    write_reason,
+                    terminal_failure=True,
+                    status="rejected",
+                    retryable=False,
+                    executed=False,
+                )
+    product_route_active = product_research_route_active(agent)
+    if product_route_active:
+        allowed_product_tools = product_research_allowed_tools(agent)
+        if tool_name not in allowed_product_tools:
+            return ResearchContractDecision(
+                "product_research_capability_forbidden",
+                "This controller-selected product session exposes bounded web "
+                "discovery/extraction plus receipt only on its initial turn, "
+                "the exact CAS publisher only on explicit approval, and no "
+                "tools on other continuations.",
+                terminal_failure=True,
+                status="rejected",
+                retryable=False,
+                executed=False,
+            )
+        if tool_name == "terminal":
+            command_reason = product_research_terminal_reason(agent, args)
+            if command_reason is not None:
+                return ResearchContractDecision(
+                    "product_research_terminal_forbidden",
+                    command_reason,
+                    terminal_failure=True,
+                    status="rejected",
+                    retryable=False,
+                    executed=False,
+                )
+    if generic_research_route_active(agent):
+        source_budget_rejection = generic_research_source_budget_rejection(
+            agent, tool_name, args
+        )
+        if source_budget_rejection is not None:
+            return ResearchContractDecision(
+                source_budget_rejection.code,
+                source_budget_rejection.message,
+                terminal_failure=source_budget_rejection.terminal_failure,
+                status="rejected",
+                retryable=source_budget_rejection.retryable,
+                executed=False,
+            )
+        generic_reason = generic_research_tool_reason(agent, tool_name, args)
+        if generic_reason is not None:
+            return ResearchContractDecision(
+                "generic_research_capability_forbidden",
+                generic_reason,
+                terminal_failure=True,
+                status="rejected",
+                retryable=False,
+                executed=False,
+            )
+    if tool_name == "delegate_task":
+        if travel_route_active:
+            return ResearchContractDecision(
+                "travel_publication_delegation_forbidden",
+                "Verified travel publication is sequential; delegation is "
+                "not available on this controller-selected turn.",
+                terminal_failure=True,
+                status="rejected",
+                retryable=False,
+                executed=False,
+            )
+        if getattr(
+            agent, "_parallel_research_terminal_quarantine_latched", False
+        ) is True:
+            return ResearchContractDecision(
+                "research_terminal_quarantine_latched",
+                RESEARCH_RETRY_BLOCKED_RESPONSE,
+                terminal_failure=True,
+                status="rejected",
+                retryable=False,
+                executed=False,
+            )
+    route_required = (
+        isinstance(current_turn_id, str)
+        and bool(current_turn_id)
+        and getattr(agent, "_parallel_research_route_required_turn_id", None)
+        == current_turn_id
+    )
+    post_dispatch_turn = (
+        isinstance(current_turn_id, str)
+        and bool(current_turn_id)
+        and getattr(agent, "_parallel_research_post_dispatch_turn_id", None)
+        == current_turn_id
+    )
+    quarantine_turn = (
+        isinstance(current_turn_id, str)
+        and bool(current_turn_id)
+        and getattr(agent, "_parallel_research_quarantine_turn_id", None)
+        == current_turn_id
+    )
+    wave_conflict_turn = (
+        isinstance(current_turn_id, str)
+        and bool(current_turn_id)
+        and getattr(agent, "_parallel_research_wave_conflict_turn_id", None)
+        == current_turn_id
+    )
+    if quarantine_turn:
+        return ResearchContractDecision(
+            "research_parent_result_quarantined",
+            RESEARCH_RESULT_QUARANTINED_RESPONSE,
+            terminal_failure=True,
+            status="rejected",
+            retryable=False,
+            executed=False,
+        )
+    if wave_conflict_turn:
+        return ResearchContractDecision(
+            "research_parent_wave_pending",
+            RESEARCH_WAVE_PENDING_RESPONSE,
+            terminal_failure=True,
+            status="rejected",
+            retryable=False,
+            executed=False,
+        )
+    if tool_name == "delegate_task":
+        pending_dispatch = _existing_parent_dispatch_decision(
+            agent,
+            requested_lane="repair" if post_dispatch_turn else "initial",
+        )
+        if pending_dispatch is not None:
+            return pending_dispatch
+    pending_wave_id = getattr(agent, "_parallel_research_pending_delegation_id", None)
+    pending_wave_active = bool(
+        not post_dispatch_turn
+        and isinstance(pending_wave_id, str)
+        and pending_wave_id
+        and get_parallel_research_activation(agent) is not None
+    )
+    if pending_wave_active:
+        return ResearchContractDecision(
+            "research_parent_wave_pending",
+            "A parallel-research wave is already pending in this session. "
+            "Parent tools are unavailable until its trusted consolidated "
+            "result returns; this prevents reads, writes, shell commands, or "
+            "a second delegation from bypassing the bound artifact gate.",
+            status="rejected",
+            retryable=True,
+            executed=False,
+        )
+    if post_dispatch_turn:
+        bound_path_tuple = tuple(
+            posixpath.normpath(path)
+            for path in getattr(agent, "_parallel_research_bound_paths", ())
+            if isinstance(path, str)
+        )
+        bound_paths = set(bound_path_tuple)
+        read_args = args if isinstance(args, Mapping) else {}
+        read_path = (
+            posixpath.normpath(read_args["path"])
+            if isinstance(read_args.get("path"), str)
+            else ""
+        )
+        exact_read = (
+            tool_name == "read_file"
+            and set(read_args).issubset({"path", "offset", "limit"})
+            and read_path in bound_paths
+            and type(read_args.get("offset", 1)) is int
+            and read_args.get("offset", 1) == 1
+            and type(read_args.get("limit", 500)) is int
+            and read_args.get("limit", 500) == 500
+        )
+        if exact_read:
+            receipts = getattr(agent, "_parallel_research_artifact_read_receipts", None)
+            receipt = receipts.get(read_path) if isinstance(receipts, dict) else None
+            if (
+                isinstance(receipt, Mapping)
+                and receipt.get("turn_id") == current_turn_id
+                and receipt.get("status") in {"read", "missing"}
+            ):
+                receipt_kind = receipt.get("status")
+                receipt_detail = (
+                    "was deterministically observed missing"
+                    if receipt_kind == "missing"
+                    else "already has a complete read receipt"
+                )
+                return ResearchContractDecision(
+                    "research_parent_artifact_already_read",
+                    "This exact bound artifact "
+                    + receipt_detail
+                    + " for the current result turn. That observation persists "
+                    "across correction attempts, so do not call read_file again. "
+                    "Dispatch the typed leg-local repair if it was missing; "
+                    "otherwise rewrite the synthesis from the existing receipts "
+                    "and keep every factual line bound to a same-line source URL "
+                    "and retrieval date.",
+                    status="rejected",
+                    retryable=True,
+                    executed=False,
+                )
+            pending_reads = getattr(
+                agent, "_parallel_research_pending_artifact_reads", None
+            )
+            if not isinstance(pending_reads, dict):
+                pending_reads = {}
+                agent._parallel_research_pending_artifact_reads = pending_reads
+            if pending_reads.get(read_path) == current_turn_id:
+                return ResearchContractDecision(
+                    "research_parent_artifact_read_pending",
+                    "This exact bound artifact already has a read_file call "
+                    "pending in the current result turn. Wait for that result; "
+                    "a sibling duplicate must not execute or replace its receipt.",
+                    status="rejected",
+                    retryable=True,
+                    executed=False,
+                )
+            pending_reads[read_path] = current_turn_id
+        receipts = getattr(agent, "_parallel_research_artifact_read_receipts", None)
+        completed_read_paths = {
+            path
+            for path in bound_paths
+            if isinstance(receipts, Mapping)
+            and isinstance(receipts.get(path), Mapping)
+            and receipts[path].get("turn_id") == current_turn_id
+            and receipts[path].get("status") in {"read", "missing"}
+        }
+        missing_read_paths = sorted(bound_paths - completed_read_paths)
+        if missing_read_paths and tool_name == "delegate_task":
+            return ResearchContractDecision(
+                "research_parent_reads_required",
+                "Before dispatching any repair wave, the parent must establish "
+                "one current-turn read observation for every exact bound artifact. "
+                "A complete read receipt or a deterministic missing-path receipt "
+                "qualifies. Call read_file for the following paths in one tool-call "
+                "batch with offset=1 and limit=500, then use their validator or "
+                "missing-path results to decide whether repair is needed: "
+                + ", ".join(missing_read_paths),
+                status="rejected",
+                retryable=True,
+                executed=False,
+            )
+        if tool_name == "delegate_task":
+            repair_dispatch_count = getattr(
+                agent, "_parallel_research_repair_dispatch_count", 0
+            )
+            if (
+                not isinstance(repair_dispatch_count, int)
+                or isinstance(repair_dispatch_count, bool)
+                or repair_dispatch_count >= 1
+            ):
+                return ResearchContractDecision(
+                    "research_parent_repair_limit",
+                    "This research request has already used its one bounded "
+                    "repair wave. A second repair dispatch is not permitted; "
+                    "the controller will withhold any synthesis whose final "
+                    "three-artifact corpus still fails validation.",
+                    terminal_failure=True,
+                    status="rejected",
+                    retryable=False,
+                    executed=False,
+                )
+            raw_validation = _exact_parent_raw_validation(
+                agent,
+                current_turn_id=current_turn_id,
+                bound_path_tuple=bound_path_tuple,
+                receipts=receipts,
+            )
+            if raw_validation is None:
+                return ResearchContractDecision(
+                    "research_parent_raw_validation_unavailable",
+                    "All exact read observations exist, but the controller lacks "
+                    "their matching immutable raw-validation authority. Repair and "
+                    "synthesis are blocked for this result turn.",
+                    terminal_failure=True,
+                    status="rejected",
+                    retryable=False,
+                    executed=False,
+                )
+            if raw_validation.status == "blocked":
+                return ResearchContractDecision(
+                    "research_parent_raw_validation_blocked",
+                    "The immutable raw-artifact validation boundary failed closed. "
+                    "No repair dispatch or synthesis is permitted for this result "
+                    "turn.",
+                    terminal_failure=True,
+                    status="rejected",
+                    retryable=False,
+                    executed=False,
+                )
+            if raw_validation.status == "passed":
+                return ResearchContractDecision(
+                    "research_parent_repair_not_required",
+                    "Every exact bound artifact passed immutable validation. Do not "
+                    "dispatch a repair; synthesize only from the existing receipts.",
+                    status="rejected",
+                    retryable=True,
+                    executed=False,
+                )
+            activation = get_parallel_research_activation(agent)
+            tasks = args.get("tasks") if isinstance(args, Mapping) else None
+            exact_task_shape = bool(
+                isinstance(tasks, list)
+                and 1 <= len(tasks) <= 3
+                and all(
+                    isinstance(task, dict)
+                    and set(task) == {"goal", "role", "research_artifact"}
+                    and task.get("role") == "leaf"
+                    for task in tasks
+                )
+            )
+            repair_contracts = (
+                _bound_research_artifact_contracts(args, len(tasks), activation)
+                if exact_task_shape and activation is not None
+                else ()
+            )
+            merged_contracts = _merge_research_repair_contracts(
+                getattr(agent, "_parallel_research_bound_artifacts", None),
+                repair_contracts,
+            )
+            fingerprint = _repair_call_fingerprint(args)
+            if (
+                not isinstance(args, Mapping)
+                or set(args) != {"tasks", "background"}
+                or args.get("background") is not True
+                or not fingerprint
+                or not merged_contracts
+                or len(repair_contracts) != len(raw_validation.failing_paths)
+                or {contract.path for contract in repair_contracts}
+                != set(raw_validation.failing_paths)
+            ):
+                return ResearchContractDecision(
+                    "research_parent_repair_contract_invalid",
+                    "A result-turn repair must be one background=true typed leaf "
+                    "batch whose subjects, exact paths, and fields equal exactly the "
+                    "controller-validated failing set. It may replace those legs in "
+                    "place but may not add, rename, retain, or drop a failing leg: "
+                    + ", ".join(raw_validation.failing_paths),
+                    status="rejected",
+                    retryable=True,
+                    executed=False,
+                )
+            reservation_decision = _reserve_parent_dispatch(
+                agent,
+                lane="repair",
+                reservation={
+                    "args_sha256": fingerprint,
+                    "contracts": repair_contracts,
+                },
+            )
+            if reservation_decision is not None:
+                return reservation_decision
+        if not (exact_read or tool_name == "delegate_task"):
+            return ResearchContractDecision(
+                "research_parent_post_dispatch_tool_blocked",
+                "A parallel-research result turn may only read its exact bound "
+                "artifacts or dispatch one typed repair wave. Skill reloads, "
+                "parent browsing, extraction, and file mutation are unavailable; "
+                "synthesize only from validated child artifacts.",
+                status="rejected",
+                retryable=True,
+                executed=False,
+            )
+    activation = get_parallel_research_activation(agent)
+    skill_ready_for_turn = (
+        activation is not None
+        and getattr(agent, "_parallel_research_skill_view_turn_id", None)
+        == current_turn_id
+    )
+    if route_required and not skill_ready_for_turn:
+        exact_skill_view = (
+            tool_name == "skill_view"
+            and isinstance(args, Mapping)
+            and dict(args) == {"name": PARALLEL_RESEARCH_SKILL}
+        )
+        if not exact_skill_view:
+            return ResearchContractDecision(
+                "research_skill_required",
+                "This turn is an explicit multi-leg research request. Its first "
+                "admitted tool must be skill_view with exactly "
+                "name='parallel-research'. Parent browsing, extraction, file "
+                "mutation, and delegation remain unavailable until that "
+                "canonical skill load succeeds.",
+                status="rejected",
+                retryable=True,
+                executed=False,
+            )
+    if (
+        activation is not None
+        and _is_top_level_research_parent(agent)
+        and not post_dispatch_turn
+        and getattr(agent, "_parallel_research_dispatch_succeeded", False) is not True
+    ):
+        if tool_name != "delegate_task":
+            return ResearchContractDecision(
+                "research_parent_dispatch_required",
+                "The canonical parallel-research workflow is active, but its typed "
+                "background leaf batch has not been dispatched. Call delegate_task "
+                "with one top-level background=true tasks batch; every task must use "
+                "role='leaf' and the exact research_artifact subject/path/fields "
+                "contract. The explicit subject label must also appear in its goal. "
+                "Direct parent tools remain unavailable until that dispatch succeeds.",
+                status="rejected",
+                retryable=True,
+                executed=False,
+            )
+        contracts, contract_errors = _initial_research_dispatch_contracts(
+            args, activation
+        )
+        fingerprint = _repair_call_fingerprint(args) if not contract_errors else ""
+        if not fingerprint and not contract_errors:
+            contract_errors = ("arguments: expected a JSON-serializable object",)
+        if contract_errors or len(contracts) != 3:
+            return ResearchContractDecision(
+                "research_parent_dispatch_contract_invalid",
+                "The initial research dispatch was rejected. Correct each listed "
+                "field and retry one delegate_task call.",
+                status="rejected",
+                retryable=True,
+                executed=False,
+                details=contract_errors,
+            )
+        reservation_decision = _reserve_parent_dispatch(
+            agent,
+            lane="initial",
+            reservation={
+                "args_sha256": fingerprint,
+                "contracts": contracts,
+            },
+        )
+        if reservation_decision is not None:
+            return reservation_decision
+    controller = get_research_controller(agent)
+    if controller is None:
+        return None
+    budget = getattr(agent, "iteration_budget", None)
+    remaining = getattr(budget, "remaining", None)
+    return controller.before_call(
+        tool_name,
+        args,
+        iterations_remaining=remaining if isinstance(remaining, int) else None,
+    )

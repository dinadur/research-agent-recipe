new file mode 100644
index 000000000..48716a61a
--- /dev/null
+++ b/tools/file_custody.py
@@ -0,0 +1,524 @@
+"""Task-local exact-path/digest custody for trusted research orchestration.
+
+Reservations count attempts atomically and survive ordinary read-cache resets.
+No policy registration means ordinary Hermes file behavior.
+"""
+from __future__ import annotations
+import hashlib
+import json
+import logging
+import os
+import posixpath
+import re
+import stat
+import threading
+from pathlib import PurePosixPath
+from typing import Any
+from tools import file_state
+from tools.file_tools_paths import _expand_tilde, _resolve_path_for_task
+logger = logging.getLogger(__name__)
+
+# Optional exact-path guard registered by trusted orchestrators for narrowly
+# scoped child sessions (for example, production acceptance soaks). Absence of
+# a registration preserves normal Hermes behavior. Presence means write_file
+# is denied before any filesystem mutation unless the model supplied one of
+# the exact absolute paths registered for that task.
+_task_write_allowlists: dict[str, frozenset[str]] = {}
+_task_write_allowlists_lock = threading.Lock()
+
+# Companion read boundary for the same trusted, opt-in task scopes. A policy
+# is either an exact absolute-path sequence or per-path maximum counts. The
+# check and reservation are atomic, occur before path resolution or I/O, and
+# are intentionally independent of the normal read dedup/context-reset state.
+# Counts/sequence slots are ATTEMPT budgets, not successful-read budgets: once
+# an allowed attempt is atomically reserved, a later I/O/decoding failure does
+# not refund it. Refunding would require a rollback that can race a concurrent
+# reader and weaken the fail-closed one-use boundary. Trusted callers must size
+# generic policies for any explicitly permitted retry; digest_sequence avoids
+# pagination/retry ambiguity by requiring one whole-file verified attempt.
+_task_read_policies: dict[str, dict[str, Any]] = {}
+_task_read_policies_lock = threading.Lock()
+_task_verified_read_digests: dict[tuple[str, str], str] = {}
+_task_verified_read_records: dict[tuple[str, str], dict[str, Any]] = {}
+_SHA256_RE = re.compile(r"^[0-9a-f]{64}$")
+_task_policy_violation_callbacks: dict[str, Any] = {}
+_task_policy_violation_callbacks_lock = threading.Lock()
+
+
+def register_task_policy_violation_callback(task_id: str, callback) -> None:
+    with _task_policy_violation_callbacks_lock:
+        _task_policy_violation_callbacks[str(task_id)] = callback
+
+
+def unregister_task_policy_violation_callback(task_id: str) -> None:
+    with _task_policy_violation_callbacks_lock:
+        _task_policy_violation_callbacks.pop(str(task_id), None)
+
+
+def _notify_task_policy_violation(task_id: str, reason: str) -> None:
+    with _task_policy_violation_callbacks_lock:
+        callback = _task_policy_violation_callbacks.get(str(task_id))
+    if callback is None:
+        return
+    try:
+        callback(reason)
+    except Exception:
+        logger.debug("Task policy violation callback failed", exc_info=True)
+
+
+def notify_task_policy_violation(task_id: str, reason: str) -> None:
+    """Public fail-closed hook for other task-scoped side-effect tools."""
+    _notify_task_policy_violation(task_id, reason)
+
+
+def _deny_all_read_policy() -> dict[str, Any]:
+    return {"mode": "counts", "max_counts": {}, "used": {}}
+
+
+def _normalize_task_read_policy(
+    policy: Any, *, trusted_digest_sequence: bool = False
+) -> dict[str, Any]:
+    # Backward-compatible shorthand: a list grants one read per occurrence.
+    if isinstance(policy, list):
+        counts: dict[str, int] = {}
+        for path in policy:
+            if not isinstance(path, str) or not posixpath.isabs(path):
+                return _deny_all_read_policy()
+            normalized = posixpath.normpath(path)
+            counts[normalized] = counts.get(normalized, 0) + 1
+        return {"mode": "counts", "max_counts": counts, "used": {}}
+    if not isinstance(policy, dict):
+        return _deny_all_read_policy()
+    if set(policy) not in ({"sequence"}, {"max_counts"}):
+        return _deny_all_read_policy()
+    has_sequence = "sequence" in policy
+    has_counts = "max_counts" in policy
+    if has_sequence == has_counts:
+        return _deny_all_read_policy()
+    if has_sequence:
+        raw_sequence = policy.get("sequence")
+        if not isinstance(raw_sequence, list):
+            return _deny_all_read_policy()
+        if raw_sequence and any(isinstance(item, dict) for item in raw_sequence):
+            # Digest-bound reads are a narrow control-plane capability, not an
+            # alternative model-visible allowlist shape. Exactly one packet is
+            # authorized and only the trusted delegate registration path may
+            # enable it.
+            if (
+                not trusted_digest_sequence
+                or len(raw_sequence) != 1
+                or not all(isinstance(item, dict) for item in raw_sequence)
+            ):
+                return _deny_all_read_policy()
+            digest_sequence: list[tuple[str, str]] = []
+            for item in raw_sequence:
+                if set(item) != {"path", "sha256"}:
+                    return _deny_all_read_policy()
+                path = item.get("path")
+                digest = item.get("sha256")
+                if (
+                    not isinstance(path, str)
+                    or not posixpath.isabs(path)
+                    or not isinstance(digest, str)
+                    or _SHA256_RE.fullmatch(digest) is None
+                ):
+                    return _deny_all_read_policy()
+                digest_sequence.append((posixpath.normpath(path), digest))
+            return {
+                "mode": "digest_sequence",
+                "sequence": tuple(digest_sequence),
+                "index": 0,
+            }
+        sequence: list[str] = []
+        for path in raw_sequence:
+            if not isinstance(path, str) or not posixpath.isabs(path):
+                return _deny_all_read_policy()
+            sequence.append(posixpath.normpath(path))
+        return {"mode": "sequence", "sequence": tuple(sequence), "index": 0}
+    raw_counts = policy.get("max_counts")
+    if not isinstance(raw_counts, dict):
+        return _deny_all_read_policy()
+    counts: dict[str, int] = {}
+    for path, count in raw_counts.items():
+        if (
+            not isinstance(path, str)
+            or not posixpath.isabs(path)
+            or not isinstance(count, int)
+            or isinstance(count, bool)
+            or count <= 0
+        ):
+            return _deny_all_read_policy()
+        counts[posixpath.normpath(path)] = count
+    return {"mode": "counts", "max_counts": counts, "used": {}}
+
+
+def register_task_read_policy(
+    task_id: str, policy: Any, *, trusted_digest_sequence: bool = False
+) -> None:
+    with _task_read_policies_lock:
+        _task_read_policies[str(task_id)] = _normalize_task_read_policy(
+            policy, trusted_digest_sequence=trusted_digest_sequence
+        )
+
+
+def register_task_read_allowlist(task_id: str, paths: list[str]) -> None:
+    register_task_read_policy(task_id, paths)
+
+
+def unregister_task_read_policy(task_id: str) -> None:
+    key = str(task_id)
+    with _task_read_policies_lock:
+        _task_read_policies.pop(key, None)
+        for digest_key in [item for item in _task_verified_read_digests if item[0] == key]:
+            _task_verified_read_digests.pop(digest_key, None)
+        for record_key in [item for item in _task_verified_read_records if item[0] == key]:
+            _task_verified_read_records.pop(record_key, None)
+
+
+def unregister_task_read_allowlist(task_id: str) -> None:
+    unregister_task_read_policy(task_id)
+
+
+def task_verified_read_digest(task_id: str, path: str) -> str | None:
+    key = (str(task_id), posixpath.normpath(str(path or "")))
+    with _task_read_policies_lock:
+        return _task_verified_read_digests.get(key)
+
+
+def task_verified_read_record(task_id: str, path: str) -> dict[str, Any] | None:
+    """Return a copy of the exact full-read attestation for a trusted packet."""
+    key = (str(task_id), posixpath.normpath(str(path or "")))
+    with _task_read_policies_lock:
+        record = _task_verified_read_records.get(key)
+        return dict(record) if isinstance(record, dict) else None
+
+
+def _reserve_task_read_policy(
+    path: str, task_id: str
+) -> tuple[str | None, str | None]:
+    """Reserve one read and return its frozen expected digest, if any."""
+    key = str(task_id)
+    candidate = posixpath.normpath(str(path or ""))
+    with _task_read_policies_lock:
+        policy = _task_read_policies.get(key)
+        if policy is None:
+            return None, None
+        if not posixpath.isabs(candidate):
+            return (
+                "read_file denied by the task's exact absolute-path policy before "
+                f"content was returned. Requested: {path!r}.",
+                None,
+            )
+        if policy.get("mode") == "digest_sequence":
+            sequence = policy.get("sequence", ())
+            index = int(policy.get("index", 0))
+            expected = sequence[index] if index < len(sequence) else None
+            expected_path = expected[0] if expected is not None else None
+            if candidate != expected_path:
+                return (
+                    "read_file denied by the task's exact digest-bound sequence "
+                    f"before content was returned. Requested: {path!r}. "
+                    f"Next expected: {expected_path!r}.",
+                    None,
+                )
+            policy["index"] = index + 1
+            return None, expected[1]
+        if policy.get("mode") == "sequence":
+            sequence = policy.get("sequence", ())
+            index = int(policy.get("index", 0))
+            expected = sequence[index] if index < len(sequence) else None
+            if candidate != expected:
+                return (
+                    "read_file denied by the task's exact read sequence before content "
+                    f"was returned. Requested: {path!r}. Next expected: {expected!r}.",
+                    None,
+                )
+            policy["index"] = index + 1
+            return None, None
+        counts = policy.get("max_counts", {})
+        budget = counts.get(candidate, 0)
+        used_map = policy.setdefault("used", {})
+        used = used_map.get(candidate, 0)
+        if budget <= 0:
+            return (
+                "read_file denied by the task's exact-path allowlist before content "
+                f"was returned. Requested: {path!r}. Allowed: {sorted(counts)!r}.",
+                None,
+            )
+        if used >= budget:
+            return (
+                "read_file denied by the task's per-path read budget before content "
+                f"was returned. Requested: {path!r}. Used: {used}; budget: {budget}.",
+                None,
+            )
+        used_map[candidate] = used + 1
+    return None, None
+
+
+def _reserve_task_read_allowlist(path: str, task_id: str) -> str | None:
+    """Backward-compatible policy reservation probe used by existing tests."""
+    error, _digest = _reserve_task_read_policy(path, task_id)
+    return error
+
+
+def _read_digest_bound_file(
+    path: str,
+    *,
+    offset: int,
+    limit: int,
+    task_id: str,
+    expected_sha256: str,
+) -> str:
+    """Return full UTF-8 bytes from one safe-open, digest-bound packet fd."""
+    if offset != 1:
+        raise ValueError("digest-bound read_file requires offset=1")
+    normalized = posixpath.normpath(str(path or ""))
+    if not posixpath.isabs(normalized) or normalized != path:
+        raise ValueError("digest-bound read_file requires its exact absolute path")
+    parent = posixpath.dirname(normalized) or "/"
+    directory_flags = (
+        os.O_RDONLY
+        | getattr(os, "O_CLOEXEC", 0)
+        | getattr(os, "O_DIRECTORY", 0)
+        | getattr(os, "O_NOFOLLOW", 0)
+    )
+    parent_fd = os.open("/", directory_flags)
+    parent_chain: list[tuple[int, int]] = []
+    try:
+        root_stat = os.fstat(parent_fd)
+        parent_chain.append((int(root_stat.st_dev), int(root_stat.st_ino)))
+        for component in PurePosixPath(parent).parts[1:]:
+            next_fd = os.open(component, directory_flags, dir_fd=parent_fd)
+            os.close(parent_fd)
+            parent_fd = next_fd
+            component_stat = os.fstat(parent_fd)
+            parent_chain.append(
+                (int(component_stat.st_dev), int(component_stat.st_ino))
+            )
+    except BaseException:
+        os.close(parent_fd)
+        raise
+    flags = os.O_RDONLY | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NOFOLLOW", 0)
+    try:
+        parent_stat = os.fstat(parent_fd)
+        fd = os.open(posixpath.basename(normalized), flags, dir_fd=parent_fd)
+    except BaseException:
+        os.close(parent_fd)
+        raise
+    try:
+        opened = os.fstat(fd)
+        if (
+            not stat.S_ISREG(opened.st_mode)
+            or opened.st_nlink != 1
+        ):
+            raise ValueError("digest-bound packet must be a single-link regular file")
+        max_bytes = 512 * 1024
+        if opened.st_size <= 0 or opened.st_size > max_bytes:
+            raise ValueError("digest-bound packet exceeds its size bound")
+        chunks: list[bytes] = []
+        remaining = max_bytes + 1
+        while remaining > 0:
+            chunk = os.read(fd, min(65536, remaining))
+            if not chunk:
+                break
+            chunks.append(chunk)
+            remaining -= len(chunk)
+        raw = b"".join(chunks)
+        after = os.fstat(fd)
+        if (
+            len(raw) > max_bytes
+            or len(raw) != opened.st_size
+            or (after.st_dev, after.st_ino, after.st_size)
+            != (opened.st_dev, opened.st_ino, opened.st_size)
+        ):
+            raise ValueError("digest-bound packet changed while reading")
+        digest = hashlib.sha256(raw).hexdigest()
+        if digest != expected_sha256:
+            raise ValueError("digest-bound packet SHA-256 mismatch")
+        try:
+            text = raw.decode("utf-8")
+        except UnicodeDecodeError as exc:
+            raise ValueError("digest-bound packet must be strict UTF-8") from exc
+        # splitlines() is applied to the same strict-UTF8 buffer whose digest
+        # was checked above. No path-based second read can alter the rendered
+        # content or its attestation.
+        lines = text.splitlines()
+        if len(lines) > limit:
+            raise ValueError(
+                "digest-bound packet cannot be truncated; increase the exact read limit"
+            )
+        content = "\n".join(
+            f"{line_number}|{line}" for line_number, line in enumerate(lines, 1)
+        )
+        # Reopen the complete parent chain and require the absolute namespace
+        # to still resolve to the exact directory used for openat().
+        fresh_parent_fd = os.open("/", directory_flags)
+        fresh_chain: list[tuple[int, int]] = []
+        try:
+            fresh_root = os.fstat(fresh_parent_fd)
+            fresh_chain.append((int(fresh_root.st_dev), int(fresh_root.st_ino)))
+            for component in PurePosixPath(parent).parts[1:]:
+                next_fd = os.open(component, directory_flags, dir_fd=fresh_parent_fd)
+                os.close(fresh_parent_fd)
+                fresh_parent_fd = next_fd
+                fresh_component = os.fstat(fresh_parent_fd)
+                fresh_chain.append(
+                    (int(fresh_component.st_dev), int(fresh_component.st_ino))
+                )
+            fresh_parent = os.fstat(fresh_parent_fd)
+            if (fresh_parent.st_dev, fresh_parent.st_ino) != (
+                parent_stat.st_dev,
+                parent_stat.st_ino,
+            ) or fresh_chain != parent_chain:
+                raise ValueError("digest-bound packet parent identity changed")
+            named = os.stat(
+                posixpath.basename(normalized),
+                dir_fd=parent_fd,
+                follow_symlinks=False,
+            )
+            if (
+                not stat.S_ISREG(named.st_mode)
+                or named.st_nlink != 1
+                or (named.st_dev, named.st_ino, named.st_size)
+                != (opened.st_dev, opened.st_ino, opened.st_size)
+            ):
+                raise ValueError("digest-bound packet identity changed")
+        finally:
+            os.close(fresh_parent_fd)
+        record = {
+            "path": normalized,
+            "sha256": digest,
+            "file_size": len(raw),
+            "line_count": len(lines),
+            "offset": 1,
+            "truncated": False,
+            "format": "line_number_pipe_v1",
+            "file_dev": int(opened.st_dev),
+            "file_ino": int(opened.st_ino),
+            "parent_dev": int(parent_stat.st_dev),
+            "parent_ino": int(parent_stat.st_ino),
+            "parent_chain": tuple(parent_chain),
+        }
+        with _task_read_policies_lock:
+            key = (str(task_id), normalized)
+            _task_verified_read_digests[key] = digest
+            _task_verified_read_records[key] = record
+        try:
+            file_state.get_registry().record_read(
+                str(task_id),
+                normalized,
+                partial=False,
+                mtime=float(opened.st_mtime),
+            )
+        except Exception:
+            logger.debug("Trusted packet file-state note failed", exc_info=True)
+        return json.dumps(
+            {
+                "content": content,
+                "total_lines": len(lines),
+                "file_size": len(raw),
+                "truncated": False,
+                "sha256": digest,
+            },
+            ensure_ascii=False,
+        )
+    finally:
+        os.close(fd)
+        os.close(parent_fd)
+
+
+def register_task_write_allowlist(task_id: str, paths: list[str]) -> None:
+    normalized = frozenset(
+        posixpath.normpath(str(path))
+        for path in paths
+        if isinstance(path, str) and posixpath.isabs(path)
+    )
+    with _task_write_allowlists_lock:
+        _task_write_allowlists[str(task_id)] = normalized
+
+
+def unregister_task_write_allowlist(task_id: str) -> None:
+    with _task_write_allowlists_lock:
+        _task_write_allowlists.pop(str(task_id), None)
+
+
+def _task_write_allowlist_error(path: str, task_id: str) -> str | None:
+    with _task_write_allowlists_lock:
+        allowed = _task_write_allowlists.get(str(task_id))
+    if allowed is None:
+        return None
+    candidate = posixpath.normpath(str(path or ""))
+    if not posixpath.isabs(candidate) or candidate not in allowed:
+        return (
+            "write_file denied by the task's exact-path allowlist before mutation. "
+            f"Requested: {path!r}. Allowed: {sorted(allowed)!r}."
+        )
+    return None
+
+
+_CANONICAL_TRAVEL_SUBDIRS = ("travel/destinations", "travel/active")
+
+
+def _check_canonical_travel_write(filepath: str, task_id: str = "default") -> str | None:
+    """Fail closed on direct agent writes to canonical travel vault pages.
+
+    Canonical pages under <vault>/travel/destinations/ and <vault>/travel/active/
+    may only be produced by the receipt-only travel publisher
+    (publish_travel.py), which writes through its own atomic
+    publisher, not through agent file tools. Skill-level policy alone did not
+    stop a live 2026-07-08 run from writing a fabricated page directly, so
+    this guard enforces the 2026-06-28 policy at the tool layer.
+    """
+    vault = os.environ.get("OBSIDIAN_VAULT_PATH", "").strip()
+    if not vault:
+        return None
+    try:
+        resolved = str(_resolve_path_for_task(filepath, task_id))
+    except (OSError, ValueError):
+        resolved = filepath
+    candidates = {
+        os.path.normpath(resolved).replace("\\", "/").lower(),
+        os.path.normpath(_expand_tilde(filepath)).replace("\\", "/").lower(),
+    }
+    vault_norm = os.path.normpath(vault).replace("\\", "/").lower()
+    for sub in _CANONICAL_TRAVEL_SUBDIRS:
+        prefix = f"{vault_norm}/{sub}/"
+        if any(c.startswith(prefix) for c in candidates):
+            return (
+                f"Refusing direct write to canonical travel page: {filepath}\n"
+                "Canonical pages under travel/destinations/ and travel/active/ "
+                "must be produced by the receipt-only travel publisher "
+                "(~/.hermes/skills/travel-planning/scripts/publish_travel.py). "
+                "Draft research belongs under raw/travel/ until it passes the "
+                "pipeline's evidence, review, and validation gates."
+            )
+    return None
+
+
+_BACKSLASH_PATH_CHARS = ("\\", "\uf05c")
+
+
+def _check_backslash_path_component(filepath: str) -> str | None:
+    """Reject writes whose path contains backslash (or NTFS U+F05C) characters.
+
+    Two local models (NexN2 2026-06-28, Agents-A1 2026-07-07/08) took
+    shell-escaped task paths like ``./\\.dir/file.md`` literally and created
+    directories named ``\\.dir`` (stored as U+F05C on NTFS via WSL). A
+    standing-instruction fix was A/B tested on 2026-07-08 and does not hold,
+    so this enforces path normalization at the tool layer, mirroring the
+    canonical-travel guard. The error text teaches the resolution so the
+    model can self-correct on retry.
+    """
+    if not any(ch in filepath for ch in _BACKSLASH_PATH_CHARS):
+        return None
+    return (
+        f"Refusing write: path contains backslash characters: {filepath!r}\n"
+        "On this system a backslash in a path is a shell escape or a Windows "
+        "separator, never part of a file or directory name. Normalize before "
+        "retrying: '\\.' means a literal dot ('.'), so './\\.cache/x.md' is "
+        "'./.cache/x.md'; use forward slashes as separators "
+        "('.\\a\\b.md' -> './a/b.md'); write Windows drive paths as WSL "
+        "mounts ('C:\\x\\y' -> '/mnt/c/x/y'). Retry with the normalized path."
+    )
+
+

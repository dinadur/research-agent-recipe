+def research_retry_requested(user_message: Any) -> bool:
+    """Whether the operator is asking to re-enter a failed research wave."""
+
+    return bool(
+        isinstance(user_message, str)
+        and _RESEARCH_RETRY_INTENT_RE.search(" ".join(user_message.split()))

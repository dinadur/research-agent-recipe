+def _spend_search_share(controller):
+    """Consume exactly the search share, leaving the extract reserve intact."""
+    share = MAX_RETRIEVAL_ATTEMPTS - RESERVED_EXTRACT_ATTEMPTS
+    for index in range(share):
+        args = {"query": f"nas {index}"}
+        assert (
+            controller.before_call("web_search", args, iterations_remaining=20) is None
+        )
+        controller.after_call(
+            "web_search",
+            args,
+            json.dumps(
+                {
+                    "success": True,
+                    "data": {
+                        "web": [{"url": f"https://e/{index}", "title": "Official"}]
+                    },
+                }
+            ),
+            failed=False,
+        )
+    return share
+

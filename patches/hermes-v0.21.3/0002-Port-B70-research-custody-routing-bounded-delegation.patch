+        # No later callback or serializer needs research authority. Clear it
+        # immediately after the authenticated-history snapshot so every
+        # subsequent fault leaves the next user turn clean. The outer
+        # run_conversation guard remains separate until this call returns.
+        from agent.research_contract import clear_parallel_research_state
+
+        clear_parallel_research_state(agent)
+
+    clear_state = bool(
+        (_research_result_turn and not _research_repair_dispatch)
+        or _turn_exit_reason in {"research_dispatch_binding_failed", "research_dispatch_withheld"}
+        or (_research_quarantine_turn and getattr(agent, "_parallel_research_quarantine_clear_state", False) is True)
+    )
+    return final_response, failed, _turn_exit_reason, ResearchFinalization(_research_output_immutable, clear_state)

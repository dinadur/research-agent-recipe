+        turn_id = getattr(agent, "_current_turn_id", None)
+        agent._product_research_receipt_viability_failure_turn_id = turn_id
+        agent._product_research_receipt_viability_failure_reasons = tuple(
+            viability_reasons
+        )
+        return (
+            calls,
+            None,
+            {
+                "mode": "receipt_viability_exhausted",
+                "viability_reasons": list(viability_reasons),
+                "successful_sources": len(successful),
+                "successful_families": len(mix["successful_families"]),
+                "search_calls": search_count,
+                "extract_calls": extract_count,
+            },
+        )
+
+    if (
+        name == "terminal"
+        and arguments is not None
+        and product_research_terminal_reason(agent, arguments) is None
+        and not ready
+        and nudge_count < PRODUCT_RESEARCH_SOURCE_MIX_NUDGE_LIMIT
+        and search_count < PRODUCT_RESEARCH_MAX_SEARCH_CALLS
+        and extract_count < PRODUCT_RESEARCH_MAX_EXTRACT_CALLS
+    ):
+        agent._product_research_source_mix_nudge_count = nudge_count + 1
+        return (
+            [],
+            (
+                "[System: The product receipt is not ready. The extracted set lacks "
+                "a search-proven manufacturer page for the product you intend to "
+                "recommend. Choose the leading candidate from the evidence already "
+                "returned, use one remaining web_search for that manufacturer's "

+"""Mutually exclusive gateway research-route regressions."""
+
+from __future__ import annotations
+
+from gateway.platforms.base import MessageEvent
+from gateway.product_routing import product_research_event_is_armed
+from gateway.research_routing import (
+    arm_research_route_event,
+    explicit_minimal_skill_name_from_text,
+    explicit_minimal_skill_event_is_armed,
+    isolate_explicit_minimal_skill_toolsets,
+)
+from gateway.travel_routing import travel_publication_event_is_armed
+
+
+BLUETOOTH_PROMPT = (
+    "Research the best portable Bluetooth speaker under $150 for travel and "
+    "outdoor use, compare the strongest current options, and prepare a cited "
+    "recommendation for my wiki."
+)
+PORTSMOUTH_PROMPT = (
+    "Research Portsmouth, New Hampshire for a weekend visit, including "
+    "verified attractions and restaurants, and add the results to my travel wiki."
+)
+
+
+def test_gateway_prefers_product_when_travel_is_only_a_use_case():
+    event = MessageEvent(text=BLUETOOTH_PROMPT)
+
+    product, travel = arm_research_route_event(event)
+
+    assert (product, travel) == (True, False)
+    assert product_research_event_is_armed(event) is True
+    assert travel_publication_event_is_armed(event) is False
+    assert event.auto_skill == ["reliable-research"]
+
+
+def test_gateway_preserves_explicit_trip_publication_route():
+    event = MessageEvent(text=PORTSMOUTH_PROMPT)
+
+    product, travel = arm_research_route_event(event)
+
+    assert (product, travel) == (False, True)
+    assert product_research_event_is_armed(event) is False
+    assert travel_publication_event_is_armed(event) is True
+    assert event.auto_skill == [
+        "travel-planning",
+        "destination-wiki-pages",
+        "obsidian",
+    ]
+
+
+def test_gateway_leaves_generic_research_unarmed():
+    event = MessageEvent(
+        text="Research SQLite WAL and give me a practical cited brief."
+    )
+
+    assert arm_research_route_event(event) == (False, False)
+    assert product_research_event_is_armed(event) is False
+    assert travel_publication_event_is_armed(event) is False
+    assert event.auto_skill is None
+
+
+def test_explicit_research_lite_replaces_product_binding_before_routing():
+    event = MessageEvent(
+        text=(
+            "Use research-lite. Compare the Sony WH-1000XM6, Bose QC Ultra, "
+            "and Sennheiser Momentum 4 for calls and travel."
+        ),
+        auto_skill=["reliable-research"],
+    )
+
+    assert arm_research_route_event(event) == (False, False)
+    assert explicit_minimal_skill_event_is_armed(event) is True
+    assert product_research_event_is_armed(event) is False
+    assert travel_publication_event_is_armed(event) is False
+    assert event.auto_skill == "research-lite"
+
+
+def test_explicit_wiki_save_stays_separate_from_research_routes():
+    event = MessageEvent(
+        text="Use wiki-save to propose this product comparison for my travel wiki.",
+        auto_skill="reliable-research",
+    )
+
+    assert arm_research_route_event(event) == (False, False)
+    assert explicit_minimal_skill_event_is_armed(event) is True
+    assert product_research_event_is_armed(event) is False
+    assert travel_publication_event_is_armed(event) is False
+    assert event.auto_skill == "wiki-save"
+
+
+def test_minimal_skill_near_miss_does_not_activate_explicit_route():
+    event = MessageEvent(text="Use research-lite-v2 for this request.")
+
+    assert arm_research_route_event(event) == (False, False)
+    assert explicit_minimal_skill_event_is_armed(event) is False
+    assert event.auto_skill is None
+
+
+def test_explicit_minimal_skill_hides_only_the_skill_catalog():
+    toolsets, selected = isolate_explicit_minimal_skill_toolsets(
+        ["web", "skills", "terminal", "memory"],
+        "Use research-lite. Compare these products.",
+    )
+
+    assert selected == "research-lite"
+    assert toolsets == ["web", "terminal", "memory"]
+
+
+def test_ordinary_prompt_preserves_the_complete_toolset():
+    original = ["web", "skills", "terminal"]
+    toolsets, selected = isolate_explicit_minimal_skill_toolsets(
+        original,
+        "Compare these products.",
+    )
+
+    assert selected is None
+    assert toolsets == original
+    assert toolsets is not original
+
+
+def test_raw_text_match_is_boundary_aware_and_rejects_slash_commands():
+    assert explicit_minimal_skill_name_from_text("Use WIKI-SAVE now") == "wiki-save"
+    assert explicit_minimal_skill_name_from_text("Use research-lite-v2") is None
+    assert explicit_minimal_skill_name_from_text("/research-lite compare these") is None

+"""Gateway binding tests for controller-selected product research."""
+
+from __future__ import annotations
+
+from gateway.platforms.base import MessageEvent
+from gateway.product_routing import (
+    arm_product_research_event,
+    product_research_event_is_armed,
+    product_research_original_text,
+)
+
+
+PROMPT = (
+    "Research the best Wi-Fi 7 mesh system under $500 for a roughly "
+    "3,000-square-foot home, compare the strongest options, and prepare a "
+    "cited recommendation in my wiki."
+)
+
+TECHNICAL_BEST_PRACTICES_PROMPT = (
+    "Research current best practices for running llama.cpp with Intel Arc GPUs "
+    "on Ubuntu using SYCL. Use primary sources, give me a concise cited "
+    "checklist, and do not modify my server or vault."
+)
+
+
+def test_gateway_arms_product_skill_and_preserves_raw_text():
+    event = MessageEvent(text=PROMPT, auto_skill="topic-skill")
+    assert arm_product_research_event(event) is True
+    assert event.auto_skill == ["reliable-research", "topic-skill"]
+    assert product_research_event_is_armed(event) is True
+    assert product_research_original_text(event) == PROMPT
+
+
+def test_gateway_does_not_arm_unrelated_internal_or_command_events():
+    technical = MessageEvent(
+        text=TECHNICAL_BEST_PRACTICES_PROMPT,
+        auto_skill="reliable-research",
+    )
+    assert arm_product_research_event(technical) is False
+    assert product_research_event_is_armed(technical) is False
+    ordinary = MessageEvent(text="Research SQLite WAL and give me a cited brief.")
+    assert arm_product_research_event(ordinary) is False
+    internal = MessageEvent(text=PROMPT, internal=True)
+    assert arm_product_research_event(internal) is False
+    command = MessageEvent(text="/new Research the best Wi-Fi system")
+    assert arm_product_research_event(command) is False

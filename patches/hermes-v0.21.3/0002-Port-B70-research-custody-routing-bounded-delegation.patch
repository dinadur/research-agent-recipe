+    for pattern in (
+        rf"\b(?:only|solely|exclusively)\b(?:\s+\w+){{0,5}}\s+"
+        rf"(?:the\s+)?{_OFFICIAL_KUBERNETES_DOCS_PHRASE}\b",
+        rf"\b(?:limit|limited|restrict|restricted)\b(?:\s+\w+){{0,5}}\s+to\s+"
+        rf"(?:the\s+)?{_OFFICIAL_KUBERNETES_DOCS_PHRASE}\b",

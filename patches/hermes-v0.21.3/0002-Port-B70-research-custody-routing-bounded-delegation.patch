index 000000000..85629b1ce
--- /dev/null
+++ b/tests/hermes_state/test_b70_v19_migration.py
@@ -0,0 +1,47 @@
+"""Real v19 DDL -> release schema, transcript/lineage preservation and rollback."""
+import json
+from pathlib import Path
+import shutil
+import sqlite3
+
+from hermes_state import SessionDB
+from hermes_state_common import SCHEMA_VERSION
+
+
+def test_v19_migration_preserves_messages_routing_and_rollback(tmp_path):
+    path=tmp_path/'state.db'
+    schema=(Path(__file__).parents[1]/'fixtures/b70-schema-v19.sql').read_text()
+    with sqlite3.connect(path) as c:
+        c.executescript(schema)
+        c.execute('INSERT INTO schema_version VALUES (19)')
+        c.execute("INSERT INTO sessions(id,source,model,started_at,ended_at,end_reason,input_tokens,output_tokens) VALUES ('before','telegram','frozen-model',1,2,'compression',50,20)")
+        c.execute("INSERT INTO sessions(id,source,model,parent_session_id,started_at) VALUES ('tip','telegram','frozen-model','before',2)")
+        c.execute("INSERT INTO messages(session_id,role,content,timestamp,finish_reason) VALUES ('tip','user',?,3,NULL)",('What is the price, including the regional condition?',))
+        c.execute("INSERT INTO messages(session_id,role,content,timestamp,finish_reason) VALUES ('tip','assistant',?,4,'generic_research_verified')",('€99 in Germany, as of 2026-09-01; tax included.',))
+        entry=json.dumps({'session_id':'tip','session_key':'agent:main:telegram:dm:synthetic','source':{'platform':'telegram','chat_id':'synthetic','chat_type':'dm'}})
+        c.execute('INSERT INTO gateway_routing VALUES (?,?,?,?)',('', 'agent:main:telegram:dm:synthetic',entry,4))
+    backup=tmp_path/'pre-upgrade.db'
+    shutil.copy2(path,backup)
+    db=SessionDB(path)
+    try:
+        assert db.resolve_resume_session_id('before') == 'tip'
+        rows=db.get_messages_as_conversation('tip')
+        assert [r['content'] for r in rows] == ['What is the price, including the regional condition?','€99 in Germany, as of 2026-09-01; tax included.']
+        assert rows[-1]['finish_reason']=='generic_research_verified'
+        db.append_message('tip','user','Continue from that evidence.')
+        with sqlite3.connect(path) as c:
+            assert c.execute('SELECT version FROM schema_version').fetchone()[0]==SCHEMA_VERSION
+            assert c.execute('SELECT entry_json FROM gateway_routing').fetchone()[0]==entry
+            assert c.execute('PRAGMA integrity_check').fetchone()[0]=='ok'
+            assert not c.execute('PRAGMA foreign_key_check').fetchall()
+    finally:
+        db.close()
+    # Old executable rollback needs the old database too; demonstrate it by
+    # restoring the pristine snapshot after closing all new-version handles.
+    for suffix in ('-wal','-shm'):
+        Path(str(path)+suffix).unlink(missing_ok=True)
+    shutil.copy2(backup,path)
+    assert path.read_bytes()==backup.read_bytes()
+    with sqlite3.connect(path) as c:
+        assert c.execute('SELECT version FROM schema_version').fetchone()[0]==19
+        assert c.execute('SELECT count(*) FROM messages').fetchone()[0]==2
diff --git a/tests/plugins/web/test_searxng_provider_circuit_breaker.py b/tests/plugins/web/test_searxng_provider_circuit_breaker.py

+def product_research_discovery_request_overrides(agent: Any) -> dict[str, Any]:
+    """Bound every pre-receipt product discovery/recovery model action."""
+
+    turn_id = getattr(agent, "_current_turn_id", None)
+    if not (
+        isinstance(turn_id, str)
+        and turn_id
+        and getattr(agent, "_product_research_initial_turn_id", None) == turn_id
+        and getattr(agent, "_api_call_count", 0) > 1
+        and getattr(agent, "_product_research_receipt_turn_id", None) != turn_id
+    ):
+        return {}
+    return {
+        "max_tokens": PRODUCT_RESEARCH_DISCOVERY_MAX_TOKENS,

+
+class ReferenceStoreError(ValueError):
+    """Retrieval, custody, synthesis, or rendering failed closed."""
+
+
+def canonical_json_bytes(value: Any) -> bytes:
+    try:
+        return (
+            json.dumps(
+                value,
+                ensure_ascii=False,
+                sort_keys=True,
+                separators=(",", ":"),
+                allow_nan=False,
+            )
+            + "\n"
+        ).encode("utf-8")
+    except (TypeError, ValueError, OverflowError, RecursionError) as exc:
+        raise ReferenceStoreError("value is not canonical JSON") from exc
+
+
+def sha256_bytes(value: bytes) -> str:
+    return hashlib.sha256(value).hexdigest()
+
+
+def sha256_file(path: Path) -> str:
+    return sha256_bytes(path.read_bytes())
+
+
+def _json_no_duplicates(text: str, *, label: str) -> Any:
+    def pairs(values: list[tuple[str, Any]]) -> dict[str, Any]:
+        result: dict[str, Any] = {}
+        for key, value in values:
+            if key in result:
+                raise ReferenceStoreError(f"{label} contains duplicate key {key!r}")
+            result[key] = value
+        return result
+
+    try:
+        return json.loads(text, object_pairs_hook=pairs)
+    except ReferenceStoreError:
+        raise
+    except (TypeError, ValueError, json.JSONDecodeError) as exc:
+        raise ReferenceStoreError(f"{label} is not valid JSON") from exc
+
+
+def _write_new(path: Path, content: bytes) -> None:
+    path.parent.mkdir(parents=True, exist_ok=True)
+    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL
+    fd = os.open(path, flags, 0o600)
+    try:
+        with os.fdopen(fd, "wb", closefd=False) as handle:
+            handle.write(content)
+            handle.flush()
+            os.fsync(handle.fileno())
+    finally:
+        os.close(fd)
+    os.chmod(path, 0o400)
+
+
+def write_new_json(path: Path, value: Mapping[str, Any]) -> None:
+    _write_new(path, canonical_json_bytes(value))
+
+
+def _canonical_url(value: Any) -> str:
+    if not isinstance(value, str) or not value or value != value.strip():
+        raise ReferenceStoreError("URL is missing or not canonical text")
+    try:
+        parsed = urlsplit(value)
+        port = parsed.port
+    except ValueError as exc:
+        raise ReferenceStoreError("URL is malformed") from exc
+    if parsed.scheme.lower() != "https" or not parsed.hostname:
+        raise ReferenceStoreError("reference-store URL must be absolute HTTPS")
+    if parsed.username is not None or parsed.password is not None:
+        raise ReferenceStoreError("reference-store URL contains credentials")
+    host = parsed.hostname.lower()
+    default_port = port in {None, 443}
+    netloc = host if default_port else f"{host}:{port}"
+    return urlunsplit(("https", netloc, parsed.path or "/", parsed.query, ""))
+
+
+def _host_allowed(url: str, allowed_hosts: Sequence[str]) -> bool:
+    host = (urlsplit(url).hostname or "").lower()
+    return any(host == allowed or host.endswith("." + allowed) for allowed in allowed_hosts)
+
+
+def _url_allowed_by_site_query(url: str, query: str) -> bool:
+    """Honor an optional path in the leading site: search boundary."""
+
+    token = query.split(maxsplit=1)[0]
+    if not token.casefold().startswith("site:"):
+        return False
+    scope = token[5:]
+    parsed_scope = urlsplit("https://" + scope)
+    parsed_url = urlsplit(url)
+    if not parsed_scope.hostname or not parsed_url.hostname:
+        return False
+    scope_host = parsed_scope.hostname.casefold()
+    url_host = parsed_url.hostname.casefold()
+    if url_host != scope_host and not url_host.endswith("." + scope_host):
+        return False
+    scope_path = parsed_scope.path or "/"
+    if scope_path == "/":
+        return True
+    normalized_scope = scope_path.rstrip("/") + "/"
+    normalized_url = (parsed_url.path or "/").rstrip("/") + "/"
+    return normalized_url.startswith(normalized_scope)
+
+
+def validate_spec(value: Any) -> dict[str, Any]:
+    if not isinstance(value, dict) or set(value) != _SPEC_KEYS:
+        raise ReferenceStoreError("reference-store spec keys are not exact")
+    if value.get("schema_version") != SCHEMA_VERSION or value.get("kind") != STORE_KIND:
+        raise ReferenceStoreError("reference-store spec header is invalid")
+    title = value.get("title")
+    request = value.get("request")
+    retrieval_date = value.get("retrieval_date")
+    hosts = value.get("allowed_hosts")
+    facets = value.get("facets")
+    date_valid = False
+    if isinstance(retrieval_date, str) and _DATE_RE.fullmatch(retrieval_date):
+        try:
+            date_valid = date.fromisoformat(retrieval_date).isoformat() == retrieval_date
+        except ValueError:
+            date_valid = False
+    if (
+        not isinstance(title, str) or not 4 <= len(title.strip()) <= 160
+        or not isinstance(request, str) or not 20 <= len(request.strip()) <= 1000
+        or not date_valid
+        or not isinstance(hosts, list) or not hosts
+        or not all(isinstance(host, str) and re.fullmatch(r"[a-z0-9.-]+", host) for host in hosts)
+        or len(set(hosts)) != len(hosts)
+        or not isinstance(facets, list) or len(facets) != 3
+    ):
+        raise ReferenceStoreError("reference-store spec values are invalid")
+    markers: set[str] = set()
+    normalized_facets: list[dict[str, Any]] = []
+    for facet in facets:
+        if not isinstance(facet, dict) or set(facet) != _FACET_KEYS:
+            raise ReferenceStoreError("facet keys are not exact")
+        marker = facet.get("marker")
+        label = facet.get("label")
+        queries = facet.get("queries")
+        anchors = facet.get("anchors")
+        if (
+            not isinstance(marker, str) or _MARKER_RE.fullmatch(marker) is None
+            or marker in markers
+            or not isinstance(label, str) or not 3 <= len(label.strip()) <= 120
+            or not isinstance(queries, list) or not 1 <= len(queries) <= 3
+            or not all(isinstance(query, str) and 8 <= len(query.strip()) <= 240 for query in queries)
+            or len(set(queries)) != len(queries)
+            or not isinstance(anchors, list) or not 1 <= len(anchors) <= 5
+            or not all(
+                isinstance(anchor, str) and 3 <= len(anchor.strip()) <= 120
+                for anchor in anchors
+            )
+            or len({anchor.casefold() for anchor in anchors}) != len(anchors)
+        ):
+            raise ReferenceStoreError("facet values are invalid")
+        markers.add(marker)
+        normalized_facets.append(
+            {
+                "marker": marker,
+                "label": label.strip(),
+                "queries": list(queries),
+                "anchors": [anchor.strip() for anchor in anchors],
+            }
+        )
+    return {
+        "schema_version": SCHEMA_VERSION,
+        "kind": STORE_KIND,
+        "title": title.strip(),
+        "request": request.strip(),
+        "retrieval_date": retrieval_date,
+        "allowed_hosts": list(hosts),
+        "facets": normalized_facets,
+    }
+
+
+def validate_planning_input(value: Any) -> dict[str, Any]:
+    """Validate the controller-owned boundary for a concise research request."""
+
+    if not isinstance(value, dict) or set(value) != _PLANNING_INPUT_KEYS:
+        raise ReferenceStoreError("planning input keys are not exact")
+    request = value.get("request")
+    retrieval_date = value.get("retrieval_date")
+    hosts = value.get("allowed_hosts")
+    date_valid = False
+    if isinstance(retrieval_date, str) and _DATE_RE.fullmatch(retrieval_date):
+        try:
+            date_valid = date.fromisoformat(retrieval_date).isoformat() == retrieval_date
+        except ValueError:
+            date_valid = False
+    if (
+        type(value.get("schema_version")) is not int
+        or value.get("schema_version") != SCHEMA_VERSION
+        or value.get("kind") != PLANNING_INPUT_KIND
+        or not isinstance(request, str)
+        or request != request.strip()
+        or not 20 <= len(request) <= 1000
+        or "\n" in request
+        or "\r" in request
+        or not date_valid
+        or not isinstance(hosts, list)
+        or not 1 <= len(hosts) <= 4
+        or not all(
+            isinstance(host, str)
+            and host == host.strip().casefold()
+            and re.fullmatch(
+                r"(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\.)+"
+                r"[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?",
+                host,
+            )
+            for host in hosts
+        )
+        or len(set(hosts)) != len(hosts)
+    ):
+        raise ReferenceStoreError("planning input values are invalid")
+    return {
+        "schema_version": SCHEMA_VERSION,
+        "kind": PLANNING_INPUT_KIND,
+        "request": request,
+        "retrieval_date": retrieval_date,
+        "allowed_hosts": list(hosts),
+    }
+
+
+def build_planning_prompt(planning_input_value: Mapping[str, Any]) -> str:
+    planning_input = validate_planning_input(dict(planning_input_value))
+    return (
+        "Compile the controller-owned research request into a retrieval plan. "
+        "Return one JSON object and no other text. The object must have exactly "
+        "schema_version=1, title, and facets. Facets must be an array of exactly "
+        "three objects in order, with markers F1, F2, and F3. Each facet must have "
+        "exactly marker, label, queries, and anchors. Give each facet one or two "
+        "concise search queries and three to five concise relevance anchors. Anchors "
+        "must be likely literal source phrases, including alternate source terminology "
+        "for the user's wording and concrete mechanisms rather than broad context. At "
+        "least two anchors per facet must be facet-specific and not repeated in another "
+        "facet. Every "
+        "query must begin with site:<allowed_host> and may optionally include a path. "
+        "If the controller request names a documentation path, preserve that path in "
+        "every query's leading site: scope. Use only the allowed hosts and do not "
+        "write URLs. At least two anchors per "
+        "facet must share a concrete subject term with that facet's label or queries. "
+        "Facets are evidence "
+        "subjects, never answer sections or downstream tasks such as recommendations, "
+        "implementation advice, summaries, comparisons, or limitations. If the request "
+        "names three focus areas, map F1, F2, and F3 to them one for one; keep verbs "
+        "such as give, explain, compare, and recommend for later synthesis. Every query "
+        "set must repeat its concrete facet subject, and at least one query per facet "
+        "must include a concrete term from the full controller request, even when that "
+        "context also appears in the site hostname. "
+        "Make the three facets distinct, collectively cover "
+        "the request, and do not add facts or answer the request.\n\n"
+        "<controller_planning_input>\n"
+        + json.dumps(planning_input, ensure_ascii=False, indent=2)
+        + "\n</controller_planning_input>\n"
+    )
+
+
+def build_planning_request(
+    prompt: str,
+    *,
+    model: str,
+    max_tokens: int = 1024,
+    canary_id: str | None = None,
+) -> dict[str, Any]:
+    if (
+        not isinstance(prompt, str)
+        or not prompt
+        or not isinstance(model, str)
+        or not model
+        or not 256 <= max_tokens <= 2048
+        or (
+            canary_id is not None
+            and (
+                not isinstance(canary_id, str)
+                or _CANARY_ID_RE.fullmatch(canary_id) is None
+            )
+        )
+    ):
+        raise ReferenceStoreError("planning request parameters are invalid")
+    system = (
+        "Produce only the bounded research-plan JSON requested by the controller. "
+        "The controller owns the request, host policy, retrieval, and validation."
+    )
+    if canary_id is not None:
+        system += (
+            f" Canary audit marker: {canary_id}. This marker is metadata and must "
+            "not appear in the plan."
+        )
+    return {
+        "model": model,
+        "messages": [
+            {"role": "system", "content": system},
+            {"role": "user", "content": prompt},
+        ],
+        "temperature": 0,
+        "max_tokens": max_tokens,
+        "stream": False,
+        "chat_template_kwargs": {"enable_thinking": False},
+    }
+
+
+def _site_scoped_query(query: str, allowed_hosts: Sequence[str]) -> bool:
+    folded = query.casefold()
+    for host in allowed_hosts:
+        prefix = f"site:{host}"
+        if folded.startswith(prefix) and len(folded) > len(prefix):
+            if folded[len(prefix)] in {"/", " "}:
+                return True
+    return False
+
+
+_PLANNING_GENERIC_WORDS = {
+    "best", "compare", "comparison", "current", "documentation", "explain",
+    "focus", "focusing", "give", "guidance", "implementation", "official",
+    "overview", "practical", "practice", "practices", "provide", "recommend",
+    "recommendation", "recommendations", "requirement", "requirements", "research",
+    "rule", "rules", "summary", "summarize", "using",
+}
+
+
+def _planning_signal_tokens(value: str) -> set[str]:
+    signals: set[str] = set()
+    for raw in re.findall(r"[A-Za-z0-9]+", value):
+        token = raw.casefold()
+        if len(token) < 3 or token in _STOPWORDS or token in _PLANNING_GENERIC_WORDS:
+            continue
+        if len(token) > 4 and token.endswith("s"):
+            token = token[:-1]
+        if len(token) >= 6:
+            token = token[:6]
+        signals.add(token)
+    return signals
+
+
+def _candidate_signal_tokens(value: str) -> set[str]:
+    """Collapse common inflections for bounded candidate-recall scoring only."""
+
+    signals: set[str] = set()
+    for raw in _tokens(value):
+        token = raw.casefold()
+        if len(token) > 4 and token.endswith("s"):
+            token = token[:-1]
+        signals.add(token[:6] if len(token) >= 6 else token)
+    return signals
+
+
+def _synthesis_signal_sequence(value: str) -> list[str]:
+    """Return ordered, lightly normalized content signals for support checks."""
+
+    signals: list[str] = []
+    for raw in re.findall(r"[A-Za-z0-9]+", value):
+        token = raw.casefold()
+        if (
+            len(token) < 3
+            or token in _STOPWORDS
+            or token in _SYNTHESIS_BRIDGE_WORDS
+        ):
+            continue
+        if token.endswith("ies") and len(token) > 6:
+            token = token[:-3] + "y"
+        elif token.endswith("ing") and len(token) > 7:
+            token = token[:-3]
+        elif token.endswith("ed") and len(token) > 6:
+            token = token[:-2]
+        elif token.endswith("es") and len(token) > 6:
+            token = token[:-2]
+        elif token.endswith("s") and len(token) > 4:
+            token = token[:-1]
+        signals.append(token[:7] if len(token) >= 7 else token)
+    return signals
+
+
+def _maximum_unsupported_signal_run(text: str, support: str) -> int:
+    support_signals = set(_synthesis_signal_sequence(support))
+    maximum = 0
+    current = 0
+    for signal in _synthesis_signal_sequence(text):
+        if signal in support_signals:
+            current = 0
+            continue
+        current += 1
+        maximum = max(maximum, current)
+    return maximum
+
+
+def _cited_row_signal_overlap(text: str, row_text: str) -> int:
+    return len(
+        set(_synthesis_signal_sequence(text))
+        & set(_synthesis_signal_sequence(row_text))
+    )
+
+
+def _normalized_quantity_tokens(value: str) -> set[str]:
+    normalized: set[str] = set()
+    for match in _QUANTITY_RE.finditer(value):
+        token = match.group(0).casefold()
+        normalized.add(_NUMBER_WORD_VALUES.get(token, token))
+    return normalized
+
+
+def _measurement_obligations(value: str) -> set[str]:
+    obligations: set[str] = set()
+    for pattern in _MEASUREMENT_OBLIGATION_PATTERNS:
+        for match in pattern.finditer(value):
+            token = match.group("quantity").casefold()
+            obligations.add(_NUMBER_WORD_VALUES.get(token, token))
+    return obligations
+
+
+def _query_subject_text(query: str) -> str:
+    return re.sub(r"^site:\S+\s+", "", query, count=1, flags=re.IGNORECASE)
+
+
+def validate_planning_response(
+    http_response: Mapping[str, Any],
+    planning_input_value: Mapping[str, Any],
+) -> dict[str, Any]:
+    """Post-validate model-authored facets without transferring controller custody."""
+
+    planning_input = validate_planning_input(dict(planning_input_value))
+    raw_content = _response_content(http_response)
+    normalized = _EMPTY_THINK_RE.sub("", raw_content, count=1)
+    if "<think" in normalized.casefold() or "</think" in normalized.casefold():
+        raise ReferenceStoreError("nonempty or repeated reasoning wrapper is forbidden")
+    packet = _json_no_duplicates(normalized, label="planning response")
+    if not isinstance(packet, dict) or set(packet) != _PLANNING_PACKET_KEYS:
+        raise ReferenceStoreError("planning response keys are not exact")
+    title = packet.get("title")
+    facets = packet.get("facets")
+    if (
+        type(packet.get("schema_version")) is not int
+        or packet.get("schema_version") != SCHEMA_VERSION
+        or not isinstance(title, str)
+        or title != title.strip()
+        or not 4 <= len(title) <= 160
+        or "\n" in title
+        or "\r" in title
+        or "http://" in title.casefold()
+        or "https://" in title.casefold()
+        or not isinstance(facets, list)
+        or len(facets) != 3
+    ):
+        raise ReferenceStoreError("planning response header is invalid")
+    canonical_facets: list[dict[str, Any]] = []
+    seen_labels: set[str] = set()
+    seen_queries: set[str] = set()
+    request_signals = _planning_signal_tokens(planning_input["request"])
+    if len(request_signals) < 4:
+        raise ReferenceStoreError("planning request lacks a bounded subject signal")
+    for index, facet in enumerate(facets, start=1):
+        if not isinstance(facet, dict) or set(facet) != _FACET_KEYS:
+            raise ReferenceStoreError("planning facet keys are not exact")
+        marker = facet.get("marker")
+        label = facet.get("label")
+        queries = facet.get("queries")
+        anchors = facet.get("anchors")
+        text_values = [label] if isinstance(label, str) else []
+        if isinstance(queries, list):
+            text_values.extend(value for value in queries if isinstance(value, str))
+        joined = " ".join(text_values).casefold()
+        facet_signals = _planning_signal_tokens(joined)
+        if (
+            marker != f"F{index}"
+            or not isinstance(label, str)
+            or label != label.strip()
+            or not 3 <= len(label) <= 120
+            or "\n" in label
+            or "\r" in label
+            or "http://" in label.casefold()
+            or "https://" in label.casefold()
+            or label.casefold() in seen_labels
+            or not isinstance(queries, list)
+            or not 1 <= len(queries) <= 2
+            or not all(
+                isinstance(query, str)
+                and query == query.strip()
+                and 8 <= len(query) <= 240
+                and "\n" not in query
+                and "\r" not in query
+                and "http://" not in query.casefold()
+                and "https://" not in query.casefold()
+                and _site_scoped_query(query, planning_input["allowed_hosts"])
+                for query in queries
+            )
+            or len({query.casefold() for query in queries}) != len(queries)
+            or any(query.casefold() in seen_queries for query in queries)
+            or len(facet_signals & request_signals) < 2
+            or not any(
+                _planning_signal_tokens(_query_subject_text(query))
+                & request_signals
+                for query in queries
+            )
+            or not isinstance(anchors, list)
+            or not 3 <= len(anchors) <= 5
+            or not all(
+                isinstance(anchor, str)
+                and anchor == anchor.strip()
+                and 3 <= len(anchor) <= 120
+                and "\n" not in anchor
+                and "\r" not in anchor
+                and "http://" not in anchor.casefold()
+                and "https://" not in anchor.casefold()
+                for anchor in anchors
+            )
+            or len({anchor.casefold() for anchor in anchors}) != len(anchors)
+            or sum(
+                bool(_planning_signal_tokens(anchor) & facet_signals)
+                for anchor in anchors
+            )
+            < 2
+        ):
+            raise ReferenceStoreError(f"planning facet F{index} is invalid")
+        seen_labels.add(label.casefold())
+        seen_queries.update(query.casefold() for query in queries)
+        canonical_facets.append(
+            {
+                "marker": marker,
+                "label": label,
+                "queries": list(queries),
+                "anchors": list(anchors),
+            }
+        )
+    anchor_counts: Counter[str] = Counter(
+        _anchor_key(anchor)
+        for facet in canonical_facets
+        for anchor in facet["anchors"]
+    )
+    if any(
+        sum(anchor_counts[_anchor_key(anchor)] == 1 for anchor in facet["anchors"])
+        < 2
+        for facet in canonical_facets
+    ):
+        raise ReferenceStoreError(
+            "planning facets lack two distinctive anchors each"
+        )
+    return {
+        "schema_version": SCHEMA_VERSION,
+        "kind": PLANNING_VALIDATION_KIND,
+        "empty_think_wrapper_removed": normalized != raw_content,
+        "planner_output": {
+            "schema_version": SCHEMA_VERSION,
+            "title": title,
+            "facets": canonical_facets,
+        },
+    }
+
+
+def build_spec_from_planning(
+    planning_input_value: Mapping[str, Any],
+    planning_validation: Mapping[str, Any],
+) -> dict[str, Any]:
+    planning_input = validate_planning_input(dict(planning_input_value))
+    if (
+        not isinstance(planning_validation, Mapping)
+        or set(planning_validation)
+        != {
+            "schema_version", "kind", "empty_think_wrapper_removed", "planner_output",
+        }
+        or type(planning_validation.get("schema_version")) is not int
+        or planning_validation.get("schema_version") != SCHEMA_VERSION
+        or planning_validation.get("kind") != PLANNING_VALIDATION_KIND
+        or type(planning_validation.get("empty_think_wrapper_removed")) is not bool
+    ):
+        raise ReferenceStoreError("planning validation packet is invalid")
+    planner_output = planning_validation.get("planner_output")
+    if not isinstance(planner_output, Mapping):
+        raise ReferenceStoreError("planning validation output is invalid")
+    return validate_spec(
+        {
+            "schema_version": SCHEMA_VERSION,
+            "kind": STORE_KIND,
+            "title": planner_output.get("title"),
+            "request": planning_input["request"],
+            "retrieval_date": planning_input["retrieval_date"],
+            "allowed_hosts": planning_input["allowed_hosts"],
+            "facets": planner_output.get("facets"),
+        }
+    )
+
+
+def _tokens(value: str) -> set[str]:
+    return {
+        token.casefold()
+        for token in _WORD_RE.findall(value)
+        if len(token) >= 3 and token.casefold() not in _STOPWORDS
+    }
+
+
+def _candidate_sentences(content: str) -> list[tuple[int, str]]:
+    rows: list[tuple[int, str]] = []
+    in_fence = False
+    for line_number, raw in enumerate(content.splitlines(), start=1):
+        stripped = raw.strip()
+        if stripped.startswith(("```", "~~~")):
+            in_fence = not in_fence
+            continue
+        if in_fence or not stripped or _BOILERPLATE_RE.search(stripped):
+            continue
+        start = _MD_PREFIX_RE.match(raw)
+        body = raw[start.end():] if start else stripped
+        body = body.strip(" |\t")
+        if len(body) < 40 or body.startswith(("http://", "https://")):
+            continue
+        for sentence in _SENTENCE_SPLIT_RE.split(body):
+            sentence = sentence.strip()
+            if (
+                40 <= len(sentence) <= 700
+                and len(_tokens(sentence)) >= 5
+                and sentence in content
+                and not _BOILERPLATE_RE.search(sentence)
+            ):
+                rows.append((line_number, sentence))
+    return rows
+
+
+def _anchor_key(anchor: str) -> str:
+    return " ".join(anchor.casefold().split())
+
+
+def _distinctive_anchor_map(
+    facets: Sequence[Mapping[str, Any]],
+) -> dict[str, list[str]]:
+    counts: Counter[str] = Counter(
+        _anchor_key(anchor)
+        for facet in facets
+        for anchor in facet["anchors"]
+    )
+    result: dict[str, list[str]] = {}
+    for facet in facets:
+        distinctive = [
+            anchor for anchor in facet["anchors"]
+            if counts[_anchor_key(anchor)] == 1
+        ]
+        result[str(facet["marker"])] = distinctive or list(facet["anchors"])
+    return result
+
+
+def _anchor_matches_sentence(anchor: str, sentence: str) -> bool:
+    if anchor.casefold() in sentence.casefold():
+        return True
+    anchor_signals = _planning_signal_tokens(anchor)
+    if not anchor_signals:
+        return False
+    sentence_signals = _planning_signal_tokens(sentence)
+    return len(anchor_signals & sentence_signals) >= min(2, len(anchor_signals))
+
+
+def _score_sentence(
+    sentence: str,
+    facet: Mapping[str, Any],
+    request: str,
+    anchors: Sequence[str] | None = None,
+) -> float:
+    sentence_tokens = _tokens(sentence)
+    label_tokens = _tokens(str(facet["label"]))
+    query_tokens = _tokens(" ".join(facet["queries"]))
+    request_tokens = _tokens(request)
+    score = 4.0 * len(sentence_tokens & label_tokens)
+    score += 2.0 * len(sentence_tokens & query_tokens)
+    score += 0.5 * len(sentence_tokens & request_tokens)
+    active_anchors = list(anchors) if anchors is not None else list(facet["anchors"])
+    score += 8.0 * sum(
+        _anchor_matches_sentence(anchor, sentence) for anchor in active_anchors
+    )
+    if sentence.endswith((".", "!", "?")):
+        score += 0.5
+    if 80 <= len(sentence) <= 360:
+        score += 0.5
+    return score
+
+
+def select_evidence_rows(
+    spec: Mapping[str, Any], pages: Sequence[Mapping[str, Any]]
+) -> list[dict[str, Any]]:
+    facets = spec["facets"]
+    distinctive_by_marker = _distinctive_anchor_map(facets)
+    rows: list[dict[str, Any]] = []
+    for facet in facets:
+        marker = facet["marker"]
+        active_anchors = distinctive_by_marker[marker]
+        candidates: list[
+            tuple[float, str, int, str, Mapping[str, Any], frozenset[str]]
+        ] = []
+        for page in pages:
+            if marker not in page["facets"]:
+                continue
+            for line, sentence in _candidate_sentences(page["content"]):
+                matched = frozenset(
+                    _anchor_key(anchor)
+                    for anchor in active_anchors
+                    if _anchor_matches_sentence(anchor, sentence)
+                )
+                if not matched:
+                    continue
+                score = _score_sentence(
+                    sentence, facet, spec["request"], active_anchors
+                )
+                candidates.append(
+                    (-score, page["source_id"], line, sentence, page, matched)
+                )
+        candidates.sort(key=lambda row: (row[0], row[1], row[2], row[3]))
+        available_anchors = set().union(
+            *(candidate[5] for candidate in candidates)
+        ) if candidates else set()
+        required_anchor_coverage = min(2, len(active_anchors))
+        if len(available_anchors) < required_anchor_coverage:
+            raise ReferenceStoreError(
+                f"facet {marker} covered only {len(available_anchors)} distinctive anchors"
+            )
+        selected: list[
+            tuple[int, str, Mapping[str, Any], frozenset[str]]
+        ] = []
+        per_source: Counter[str] = Counter()
+        seen_text: set[str] = set()
+
+        def admit(
+            candidate: tuple[
+                float, str, int, str, Mapping[str, Any], frozenset[str]
+            ]
+        ) -> bool:
+            _neg_score, source_id, line, sentence, page, matched = candidate
+            normalized = " ".join(sentence.casefold().split())
+            if normalized in seen_text or per_source[source_id] >= MAX_ROWS_PER_SOURCE:
+                return False
+            seen_text.add(normalized)
+            per_source[source_id] += 1
+            selected.append((line, sentence, page, matched))
+            return True
+
+        uncovered = set(available_anchors)
+        while uncovered and len(selected) < MAX_ROWS_PER_FACET:
+            ranked = sorted(
+                candidates,
+                key=lambda row: (
+                    -len(row[5] & uncovered), row[0], row[1], row[2], row[3]
+                ),
+            )
+            chosen = next(
+                (row for row in ranked if row[5] & uncovered and admit(row)),
+                None,
+            )
+            if chosen is None:
+                break
+            uncovered.difference_update(chosen[5])
+        for candidate in candidates:
+            if len(selected) == MAX_ROWS_PER_FACET:
+                break
+            admit(candidate)
+        if len(selected) < MIN_ROWS_PER_FACET:
+            raise ReferenceStoreError(
+                f"facet {marker} produced only {len(selected)} usable evidence rows"
+            )
+        covered_anchors = set().union(*(row[3] for row in selected))
+        if len(covered_anchors) < required_anchor_coverage:
+            raise ReferenceStoreError(
+                f"facet {marker} selected insufficient distinctive-anchor coverage"
+            )
+        for ordinal, (line, sentence, page, _matched) in enumerate(selected, start=1):
+            rows.append(
+                {
+                    "row_id": f"{marker}-R{ordinal:02d}",
+                    "facet": marker,
+                    "source_id": page["source_id"],
+                    "url": page["url"],
+                    "retrieval_date": spec["retrieval_date"],
+                    "source_line": line,
+                    "text": sentence,
+                    "text_sha256": sha256_bytes(sentence.encode("utf-8")),
+                    "source_sha256": page["content_sha256"],
+                }
+            )
+    return rows
+
+
+def build_evidence_candidates(
+    spec_value: Mapping[str, Any],
+    pages: Sequence[Mapping[str, Any]],
+    reference_store: Mapping[str, Any],
+) -> dict[str, Any]:
+    """Build a bounded controller-owned sentence pool for semantic ID selection."""
+
+    spec = validate_spec(dict(spec_value))
+    distinctive_by_marker = _distinctive_anchor_map(spec["facets"])
+    label_signals = {
+        str(facet["marker"]): _candidate_signal_tokens(str(facet["label"]))
+        for facet in spec["facets"]
+    }
+    label_signal_counts: Counter[str] = Counter(
+        signal for signals in label_signals.values() for signal in signals
+    )
+    candidates: list[dict[str, Any]] = []
+    for facet in spec["facets"]:
+        marker = facet["marker"]
+        active_anchors = distinctive_by_marker[marker]
+        distinctive_focus_signals = {
+            signal
+            for signal in label_signals[marker]
+            if label_signal_counts[signal] == 1
+        }
+        focus_signals = label_signals[marker]
+        rows: list[
+            tuple[
+                float,
+                str,
+                int,
+                str,
+                Mapping[str, Any],
+                bool,
+                bool,
+                int | None,
+                int,
+                int,
+            ]
+        ] = []
+        for page in pages:
+            sentences = _candidate_sentences(str(page["content"]))
+            sentence_signals = [
+                _candidate_signal_tokens(sentence) for _line, sentence in sentences
+            ]
+            sentence_focus = []
+            sentence_focus_position = []
+            common_focus_signals = focus_signals - distinctive_focus_signals
+            for signals in sentence_signals:
+                distinctive_overlap = len(distinctive_focus_signals & signals)
+                common_overlap = len(common_focus_signals & signals)
+                sentence_focus.append(
+                    common_overlap + (2 * distinctive_overlap)
+                )
+                sentence_focus_position.append(
+                    distinctive_overlap > 0 or common_overlap >= 2
+                )
+            facet_focus_positions: set[int] = set()
+            for position, (line, sentence) in enumerate(sentences):
+                if sentence_focus_position[position] or any(
+                    _anchor_matches_sentence(anchor, sentence)
+                    for anchor in active_anchors
+                ):
+                    facet_focus_positions.add(position)
+            for position, (line, sentence) in enumerate(sentences):
+                anchored = any(
+                    _anchor_matches_sentence(anchor, sentence)
+                    for anchor in active_anchors
+                )
+                normative = bool(
+                    re.search(
+                        r"\b(?:shall|should|must|may|required|recommend(?:ed)?)\b|"
+                        r"\bdo not\b|\bshall not\b",
+                        sentence,
+                        re.IGNORECASE,
+                    )
+                )
+                negative_requirement = bool(
+                    re.search(
+                        r"\b(?:shall|should|must)\s+(?:\*\*)?not\b|\bdo not\b",
+                        sentence,
+                        re.IGNORECASE,
+                    )
+                )
+                requirement_priority = (
+                    (2 if negative_requirement else 0)
+                    + (2 if _NUMBER_RE.search(sentence) else 0)
+                    + (1 if normative else 0)
+                )
+                anchor_distance = (
+                    min(abs(position - anchor) for anchor in facet_focus_positions)
+                    if facet_focus_positions
+                    else None
+                )
+                if anchor_distance is not None and anchor_distance > 8:
+                    anchor_distance = None
+                score = _score_sentence(
+                    sentence, facet, spec["request"], active_anchors
+                )
+                rows.append(
+                    (
+                        -score,
+                        str(page["source_id"]),
+                        line,
+                        sentence,
+                        page,
+                        anchored,
+                        normative,
+                        anchor_distance,
+                        requirement_priority,
+                        sentence_focus[position],
+                    )
+                )
+        rows.sort(key=lambda row: (row[0], row[1], row[2], row[3]))
+        chosen: list[
+            tuple[
+                float,
+                str,
+                int,
+                str,
+                Mapping[str, Any],
+                bool,
+                bool,
+                int | None,
+                int,
+                int,
+            ]
+        ] = []
+        seen_text: set[str] = set()
+
+        def source_diverse(pool: Sequence[tuple[Any, ...]]) -> list[tuple[Any, ...]]:
+            buckets: dict[str, list[tuple[Any, ...]]] = {}
+            source_order: list[str] = []
+            for row in pool:
+                source_id = str(row[1])
+                if source_id not in buckets:
+                    buckets[source_id] = []
+                    source_order.append(source_id)
+                buckets[source_id].append(row)
+            diverse: list[tuple[Any, ...]] = []
+            while any(buckets[source_id] for source_id in source_order):
+                for source_id in source_order:
+                    if buckets[source_id]:
+                        diverse.append(buckets[source_id].pop(0))
+            return diverse
+
+        def admit(pool: Sequence[tuple[Any, ...]], limit: int) -> None:
+            if len(chosen) >= MAX_CANDIDATES_PER_FACET:
+                return
+            admitted = 0
+            for raw in pool:
+                row = raw  # type: ignore[assignment]
+                normalized = " ".join(str(row[3]).casefold().split())
+                if normalized in seen_text:
+                    continue
+                seen_text.add(normalized)
+                chosen.append(row)  # type: ignore[arg-type]
+                admitted += 1
+                if admitted == limit or len(chosen) >= MAX_CANDIDATES_PER_FACET:
+                    break
+
+        anchored_rows = sorted(
+            [row for row in rows if row[5]],
+            key=lambda row: (row[0], row[1], row[2], row[3]),
+        )
+        requirement_neighbors = sorted(
+            [row for row in rows if row[7] is not None and not row[5]],
+            key=lambda row: (
+                -row[8],
+                int(row[7]),
+                -row[9],
+                row[0],
+                row[1],
+                row[2],
+                row[3],
+            ),
+        )
+        focused_normative = sorted(
+            [row for row in rows if row[6]],
+            key=lambda row: (
+                -row[9],
+                -row[8],
+                row[0],
+                row[1],
+                row[2],
+                row[3],
+            ),
+        )
+        admit(source_diverse(anchored_rows), 8)
+        admit(
+            source_diverse(requirement_neighbors),
+            30,
+        )
+        admit(source_diverse(focused_normative), 10)
+        admit(rows, MAX_CANDIDATES_PER_FACET)
+        if len(chosen) < MIN_ROWS_PER_FACET:
+            raise ReferenceStoreError(
+                f"facet {marker} produced only {len(chosen)} semantic candidates"
+            )
+        for ordinal, row in enumerate(chosen, start=1):
+            (
+                _neg_score,
+                source_id,
+                line,
+                sentence,
+                page,
+                _anchored,
+                _normative,
+                _anchor_distance,
+                _requirement_priority,
+                _focus_overlap,
+            ) = row
+            candidates.append(
+                {
+                    "candidate_id": f"{marker}-C{ordinal:03d}",
+                    "facet": marker,
+                    "source_id": source_id,
+                    "url": page["url"],
+                    "retrieval_date": spec["retrieval_date"],
+                    "source_line": line,
+                    "text": sentence,
+                    "text_sha256": sha256_bytes(sentence.encode("utf-8")),
+                    "source_sha256": page["content_sha256"],
+                }
+            )
+    return {
+        "schema_version": SCHEMA_VERSION,
+        "kind": CANDIDATES_KIND,
+        "reference_store_sha256": sha256_bytes(
+            canonical_json_bytes(dict(reference_store))
+        ),
+        "candidates": candidates,
+    }
+
+
+def build_semantic_selection_prompt(
+    spec_value: Mapping[str, Any], candidate_store: Mapping[str, Any]
+) -> str:
+    spec = validate_spec(dict(spec_value))
+    candidates = candidate_store.get("candidates")
+    if (
+        candidate_store.get("schema_version") != SCHEMA_VERSION
+        or candidate_store.get("kind") != CANDIDATES_KIND
+        or not isinstance(candidates, list)
+        or not candidates
+    ):
+        raise ReferenceStoreError("semantic candidate store is invalid")
+    visible = [
+        {
+            "candidate_id": row["candidate_id"],
+            "facet": row["facet"],
+            "source_url": row["url"],
+            "verified_text": row["text"],
+        }
+        for row in candidates
+    ]
+    facet_contract = [
+        {
+            "marker": facet["marker"],
+            "label": facet["label"],
+            "queries": facet["queries"],
+            "anchors": facet["anchors"],
+        }
+        for facet in spec["facets"]
+    ]
+    return (
+        "Select the most useful verified evidence sentences for the research request. "
+        "Return one JSON object and no other text, with exactly schema_version=1 and "
+        "facets. Facets must contain exactly three objects in the supplied order, each "
+        "with exactly marker and candidate_ids. Preserve each marker and select 4-6 "
+        "distinct candidate IDs belonging to that facet. Select evidence, not prose. "
+        "Every selected sentence must be self-contained and ready to display without "
+        "adjacent page context: reject unfinished examples, relative-link fragments, "
+        "table-field definitions, and sentences referring to 'this', 'just created', "
+        "or an 'above case'. Do not select the same finding for two facets. "
+        "Cover the facet's distinct requirements, mechanisms, limitations, and alternate "
+        "source terminology; use source URLs to prefer the current authoritative version "
+        "when versions conflict, prefer normative statements, and avoid generic, "
+        "duplicative, historical, or off-scope sentences. Interpret semantic equivalents "
+        "such as user wording versus different official-source terminology, but never "
+        "invent an ID or fact.\n\n"
+        f"Research request: {spec['request']}\n\n"
+        "<controller_facets>\n"
+        + json.dumps(facet_contract, ensure_ascii=False, indent=2)
+        + "\n</controller_facets>\n\n<controller_evidence_candidates>\n"
+        + json.dumps(visible, ensure_ascii=False, indent=2)
+        + "\n</controller_evidence_candidates>\n"
+    )
+
+
+def build_semantic_selection_request(
+    prompt: str,
+    *,
+    model: str,
+    max_tokens: int = 1024,
+    canary_id: str | None = None,
+) -> dict[str, Any]:
+    if (
+        not isinstance(prompt, str)
+        or not prompt
+        or not isinstance(model, str)
+        or not model
+        or not 256 <= max_tokens <= 2048
+        or (
+            canary_id is not None
+            and (
+                not isinstance(canary_id, str)
+                or _CANARY_ID_RE.fullmatch(canary_id) is None
+            )
+        )
+    ):
+        raise ReferenceStoreError("semantic selection request parameters are invalid")
+    system = (
+        "Select only controller-listed evidence candidate IDs. Return only the exact "
+        "JSON object; do not write research prose or use outside knowledge."
+    )
+    if canary_id is not None:
+        system += (
+            f" Canary audit marker: {canary_id}. This marker is metadata and must "
+            "not appear in the selection."
+        )
+    return {
+        "model": model,
+        "messages": [
+            {"role": "system", "content": system},
+            {"role": "user", "content": prompt},
+        ],
+        "temperature": 0,
+        "max_tokens": max_tokens,
+        "stream": False,
+        "chat_template_kwargs": {"enable_thinking": False},
+    }
+
+
+def validate_semantic_selection_response(
+    http_response: Mapping[str, Any],
+    spec_value: Mapping[str, Any],
+    candidate_store: Mapping[str, Any],
+) -> dict[str, Any]:
+    spec = validate_spec(dict(spec_value))
+    candidates = candidate_store.get("candidates")
+    if (
+        candidate_store.get("schema_version") != SCHEMA_VERSION
+        or candidate_store.get("kind") != CANDIDATES_KIND
+        or not isinstance(candidates, list)
+        or not candidates
+    ):
+        raise ReferenceStoreError("semantic candidate store is invalid")
+    by_id: dict[str, Mapping[str, Any]] = {}
+    for candidate in candidates:
+        candidate_id = str(candidate.get("candidate_id") or "") if isinstance(candidate, Mapping) else ""
+        if (
+            not isinstance(candidate, Mapping)
+            or _CANDIDATE_ID_RE.fullmatch(candidate_id) is None
+            or candidate_id in by_id
+        ):
+            raise ReferenceStoreError("semantic candidate record is invalid")
+        by_id[candidate_id] = candidate
+    raw_content = _response_content(http_response)
+    normalized = _EMPTY_THINK_RE.sub("", raw_content, count=1)
+    if "<think" in normalized.casefold() or "</think" in normalized.casefold():
+        raise ReferenceStoreError("nonempty or repeated reasoning wrapper is forbidden")
+    packet = _json_no_duplicates(normalized, label="semantic selection response")
+    if not isinstance(packet, dict) or set(packet) != _SELECTION_PACKET_KEYS:
+        raise ReferenceStoreError("semantic selection response keys are not exact")
+    facets = packet.get("facets")
+    if (
+        type(packet.get("schema_version")) is not int
+        or packet.get("schema_version") != SCHEMA_VERSION
+        or not isinstance(facets, list)
+        or len(facets) != 3
+    ):
+        raise ReferenceStoreError("semantic selection response header is invalid")
+    selected_facets: list[dict[str, Any]] = []
+    seen_ids: set[str] = set()
+    for index, (facet, expected) in enumerate(zip(facets, spec["facets"]), start=1):
+        if not isinstance(facet, dict) or set(facet) != _SELECTION_FACET_KEYS:
+            raise ReferenceStoreError("semantic selection facet keys are not exact")
+        marker = facet.get("marker")
+        candidate_ids = facet.get("candidate_ids")
+        if (
+            marker != expected["marker"]
+            or not isinstance(candidate_ids, list)
+            or not MIN_ROWS_PER_FACET <= len(candidate_ids) <= MAX_ROWS_PER_FACET
+            or not all(
+                isinstance(candidate_id, str)
+                and candidate_id in by_id
+                and by_id[candidate_id].get("facet") == marker
+                for candidate_id in candidate_ids
+            )
+            or len(set(candidate_ids)) != len(candidate_ids)
+            or any(candidate_id in seen_ids for candidate_id in candidate_ids)
+        ):
+            raise ReferenceStoreError(f"semantic selection facet {index} is invalid")
+        seen_ids.update(candidate_ids)
+        selected_facets.append(
+            {"marker": marker, "candidate_ids": list(candidate_ids)}
+        )
+    return {
+        "schema_version": SCHEMA_VERSION,
+        "kind": SEMANTIC_SELECTION_KIND,
+        "empty_think_wrapper_removed": normalized != raw_content,
+        "candidate_store_sha256": sha256_bytes(
+            canonical_json_bytes(dict(candidate_store))
+        ),
+        "facets": selected_facets,
+    }
+
+
+def build_rows_from_semantic_selection(
+    reference_store: Mapping[str, Any],
+    candidate_store: Mapping[str, Any],
+    selection: Mapping[str, Any],
+) -> dict[str, Any]:
+    if selection.get("kind") != SEMANTIC_SELECTION_KIND:
+        raise ReferenceStoreError("semantic selection validation is invalid")
+    candidates = candidate_store.get("candidates")
+    if not isinstance(candidates, list):
+        raise ReferenceStoreError("semantic candidate store is invalid")
+    by_id = {str(row["candidate_id"]): row for row in candidates}
+    rows: list[dict[str, Any]] = []
+    facets = selection.get("facets")
+    if not isinstance(facets, list):
+        raise ReferenceStoreError("semantic selection facets are invalid")
+    for facet in facets:
+        marker = facet["marker"]
+        for ordinal, candidate_id in enumerate(facet["candidate_ids"], start=1):
+            candidate = by_id[candidate_id]
+            rows.append(
+                {
+                    "row_id": f"{marker}-R{ordinal:02d}",
+                    "facet": marker,
+                    "source_id": candidate["source_id"],
+                    "url": candidate["url"],
+                    "retrieval_date": candidate["retrieval_date"],
+                    "source_line": candidate["source_line"],
+                    "text": candidate["text"],
+                    "text_sha256": candidate["text_sha256"],
+                    "source_sha256": candidate["source_sha256"],
+                    "selected_candidate_id": candidate_id,
+                }
+            )
+    return {
+        "schema_version": SCHEMA_VERSION,
+        "kind": ROWS_KIND,
+        "reference_store_sha256": sha256_bytes(
+            canonical_json_bytes(dict(reference_store))
+        ),
+        "rows": rows,
+    }
+
+
+def _parse_search_result(raw: str) -> list[str]:
+    value = _json_no_duplicates(raw, label="web search result")
+    web = ((value.get("data") or {}).get("web") if isinstance(value, dict) else None)
+    if value.get("success") is not True or not isinstance(web, list):
+        raise ReferenceStoreError("web search did not return a successful result list")
+    urls: list[str] = []
+    for row in web:
+        if not isinstance(row, dict) or not isinstance(row.get("url"), str):
+            continue
+        try:
+            url = _canonical_url(row["url"])
+        except ReferenceStoreError:
+            continue
+        if url not in urls:
+            urls.append(url)
+    return urls
+
+
+def _parse_extract_result(raw: str) -> dict[str, dict[str, str]]:
+    value = _json_no_duplicates(raw, label="web extract result")
+    results = value.get("results") if isinstance(value, dict) else None
+    if not isinstance(results, list):
+        raise ReferenceStoreError("web extract did not return a result list")
+    parsed: dict[str, dict[str, str]] = {}
+    for row in results:
+        if not isinstance(row, dict) or row.get("error"):
+            continue
+        try:
+            url = _canonical_url(row.get("url"))
+        except ReferenceStoreError:
+            continue
+        content = row.get("content")
+        title = row.get("title") or ""
+        if (
+            isinstance(content, str)
+            and content.strip()
+            and len(content.encode("utf-8")) <= MAX_SOURCE_BYTES
+            and "[Full text stored at " not in content
+        ):
+            parsed[url] = {"title": str(title).strip(), "content": content.strip()}
+    return parsed
+
+
+SearchFn = Callable[[str, int], str]
+ExtractFn = Callable[[list[str]], Awaitable[str]]
+
+
+def _source_relevance(
+    content: str,
+    facet: Mapping[str, Any],
+    request: str,
+    anchors: Sequence[str],
+) -> tuple[int, int, float]:
+    scores: list[float] = []
+    covered: set[str] = set()
+    for _line, sentence in _candidate_sentences(content):
+        matched = {
+            _anchor_key(anchor)
+            for anchor in anchors
+            if _anchor_matches_sentence(anchor, sentence)
+        }
+        if not matched:
+            continue
+        covered.update(matched)
+        scores.append(_score_sentence(sentence, facet, request, anchors))
+    scores.sort(reverse=True)
+    return len(covered), min(len(scores), MAX_ROWS_PER_FACET), sum(
+        scores[:MAX_ROWS_PER_FACET]
+    )
+
+
+async def build_reference_store(
+    spec_value: Mapping[str, Any],
+    output_root: Path,
+    *,
+    search_fn: SearchFn,
+    extract_fn: ExtractFn,
+    semantic_selection: bool = False,
+) -> dict[str, Any]:
+    spec = validate_spec(dict(spec_value))
+    output_root = Path(output_root)
+    if output_root.exists() or output_root.is_symlink():
+        raise ReferenceStoreError("reference-store output root already exists")
+    output_root.mkdir(parents=True)
+    search_receipts: list[dict[str, Any]] = []
+    discovered_by_marker: dict[str, list[str]] = {}
+    for facet in spec["facets"]:
+        discovered: list[str] = []
+        for query in facet["queries"]:
+            raw = search_fn(query, 5)
+            urls = _parse_search_result(raw)
+            allowed = [
+                url for url in urls
+                if _host_allowed(url, spec["allowed_hosts"])
+                and _url_allowed_by_site_query(url, query)
+            ]
+            search_receipts.append(
+                {
+                    "marker": facet["marker"],
+                    "query": query,
+                    "response_sha256": sha256_bytes(raw.encode("utf-8")),
+                    "admitted_urls": allowed,
+                }
+            )
+            for url in allowed:
+                if url not in discovered:
+                    discovered.append(url)
+                if len(discovered) == 5:
+                    break
+            if len(discovered) == 5:
+                break
+        if not discovered:
+            raise ReferenceStoreError(f"facet {facet['marker']} found no allowed URL")
+        discovered_by_marker[facet["marker"]] = discovered
+
+    discovery_urls = sorted(
+        {url for urls in discovered_by_marker.values() for url in urls}
+    )
+    extracted: dict[str, dict[str, str]] = {}
+    extract_receipts: list[dict[str, Any]] = []
+    for offset in range(0, len(discovery_urls), 5):
+        batch = discovery_urls[offset : offset + 5]
+        raw = await extract_fn(batch)
+        parsed = _parse_extract_result(raw)
+        extracted.update(parsed)
+        extract_receipts.append(
+            {
+                "requested_urls": batch,
+                "response_sha256": sha256_bytes(raw.encode("utf-8")),
+                "successful_urls": sorted(parsed),
+            }
+        )
+    distinctive_by_marker = _distinctive_anchor_map(spec["facets"])
+    url_facets: dict[str, set[str]] = {}
+    selection_receipts: list[dict[str, Any]] = []
+    for facet in spec["facets"]:
+        marker = facet["marker"]
+        ranked: list[tuple[int, int, float, str]] = []
+        for url in discovered_by_marker[marker]:
+            value = extracted.get(url)
+            if value is None:
+                continue
+            covered, usable, score = _source_relevance(
+                value["content"],
+                facet,
+                spec["request"],
+                distinctive_by_marker[marker],
+            )
+            if usable:
+                ranked.append((-covered, -usable, -score, url))
+        ranked.sort()
+        selected_for_facet = [
+            row[3] for row in ranked[:MAX_SOURCES_PER_FACET]
+        ]
+        if not selected_for_facet:
+            raise ReferenceStoreError(
+                f"facet {marker} found no content-relevant extracted source"
+            )
+        for url in selected_for_facet:
+            url_facets.setdefault(url, set()).add(marker)
+        selection_receipts.append(
+            {
+                "marker": marker,
+                "discovered_url_count": len(discovered_by_marker[marker]),
+                "extracted_url_count": sum(
+                    url in extracted for url in discovered_by_marker[marker]
+                ),
+                "selected_urls": selected_for_facet,
+                "distinctive_anchors": distinctive_by_marker[marker],
+            }
+        )
+
+    selected_urls = sorted(url_facets)
+    pages: list[dict[str, Any]] = []
+    sources_root = output_root / "sources"
+    sources_root.mkdir()
+    for url in selected_urls:
+        value = extracted.get(url)
+        if value is None:
+            continue
+        content_bytes = (value["content"] + "\n").encode("utf-8")
+        content_sha = sha256_bytes(content_bytes)
+        source_id = "source-" + sha256_bytes(url.encode("utf-8"))[:16]
+        source_path = sources_root / f"{source_id}.md"
+        _write_new(source_path, content_bytes)
+        pages.append(
+            {
+                "source_id": source_id,
+                "url": url,
+                "title": value["title"],
+                "retrieval_date": spec["retrieval_date"],
+                "facets": sorted(url_facets[url]),
+                "relative_path": source_path.relative_to(output_root).as_posix(),
+                "content_sha256": content_sha,
+                "content_bytes": len(content_bytes),
+                "content": value["content"] + "\n",
+            }
+        )
+    for facet in spec["facets"]:
+        if not any(facet["marker"] in page["facets"] for page in pages):
+            raise ReferenceStoreError(f"facet {facet['marker']} has no extracted source")
+
+    persisted_pages = [
+        {key: page[key] for key in page if key != "content"} for page in pages
+    ]
+    store = {
+        "schema_version": SCHEMA_VERSION,
+        "kind": STORE_KIND,
+        "spec_sha256": sha256_bytes(canonical_json_bytes(spec)),
+        "title": spec["title"],
+        "request": spec["request"],
+        "retrieval_date": spec["retrieval_date"],
+        "allowed_hosts": spec["allowed_hosts"],
+        "facets": spec["facets"],
+        "pages": persisted_pages,
+    }
+    receipts = {
+        "schema_version": SCHEMA_VERSION,
+        "kind": RECEIPTS_KIND,
+        "searches": search_receipts,
+        "extracts": extract_receipts,
+        "source_selections": selection_receipts,
+    }
+    write_new_json(output_root / "reference-store.json", store)
+    write_new_json(output_root / "retrieval-receipts.json", receipts)
+    if semantic_selection:
+        candidate_store = build_evidence_candidates(spec, pages, store)
+        write_new_json(output_root / "evidence-candidates.json", candidate_store)
+        return {
+            "spec": spec,
+            "store": store,
+            "candidate_store": candidate_store,
+            "receipts": receipts,
+        }
+    rows = select_evidence_rows(spec, pages)
+    row_store = {
+        "schema_version": SCHEMA_VERSION,
+        "kind": ROWS_KIND,
+        "reference_store_sha256": sha256_bytes(canonical_json_bytes(store)),
+        "rows": rows,
+    }
+    write_new_json(output_root / "evidence-rows.json", row_store)
+    prompt = build_synthesis_prompt(spec, rows)
+    _write_new(output_root / "synthesis-prompt.txt", prompt.encode("utf-8"))
+    return {
+        "spec": spec,
+        "store": store,
+        "row_store": row_store,
+        "receipts": receipts,
+        "prompt": prompt,
+    }
+

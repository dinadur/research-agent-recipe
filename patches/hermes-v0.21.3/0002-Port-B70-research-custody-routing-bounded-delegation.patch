+def _set_travel_route_halt(
+    agent: Any,
+    *,
+    code: str,
+    message: str,
+    tool_name: str,
+    count: int,
+) -> None:
+    from agent.tool_guardrails import ToolGuardrailDecision
+
+    decision = ToolGuardrailDecision(
+        action="halt",
+        code=code,
+        message=message,
+        tool_name=tool_name,
+        count=count,
+    )
+    set_halt = getattr(agent, "_set_tool_guardrail_halt", None)
+    if callable(set_halt):
+        set_halt(decision)
+    elif getattr(agent, "_tool_guardrail_halt_decision", None) is None:
+        agent._tool_guardrail_halt_decision = decision
+

+def _travel_route_file_write_reason(
+    args: Mapping[str, Any] | None,
+) -> str | None:
+    if isinstance(args, Mapping) and _absolute_path_under_travel_raw(args.get("path")):
+        return None
+    return (
+        "Verified travel sessions may use write_file only with an absolute path "
+        "inside the resolved vault's raw/travel directory. Canonical pages are "
+        "created only by publish_travel.py from a controller-issued receipt."
+    )
+
+
+def _travel_route_terminal_mutation_reason(
+    args: Mapping[str, Any] | None,
+) -> str | None:
+    """Reject travel-route shell mutation outside the raw/travel work area.
+
+    The controller deliberately leaves read-only shell diagnostics available.
+    The pipeline and receipt publisher remain ordinary terminal commands, but
+    a command may not rearrange unrelated vault roots to make an audit pass.
+    """
+
+    if not isinstance(args, Mapping):
+        return None
+    command = args.get("command")
+    if not isinstance(command, str) or not _TRAVEL_VAULT_MUTATION_RE.search(command):
+        return None
+    normalized = command.replace("\\", "/").casefold()
+    workdir_value = args.get("workdir")
+    workdir = (
+        workdir_value.replace("\\", "/").rstrip("/").casefold()
+        if isinstance(workdir_value, str)
+        else ""
+    )
+    vault = (
+        os.environ.get("OBSIDIAN_VAULT_PATH") or LOCAL_DEFAULT_OBSIDIAN_VAULT
+    ).replace("\\", "/").rstrip("/").casefold()
+    raw_travel = f"{vault}/raw/travel"
+    env_vault = "$obsidian_vault_path"
+    env_raw_travel = f"{env_vault}/raw/travel"
+    references_vault = (
+        vault in normalized
+        or env_vault in normalized
+        or bool(workdir and (workdir == vault or workdir.startswith(f"{vault}/")))
+    )
+    if not references_vault:
+        return None
+
+    # Relative scratch mutation is allowed only when the declared workdir is
+    # already inside raw/travel and the command cannot climb out of it.
+    if (
+        workdir.startswith(f"{raw_travel}/") or workdir == raw_travel
+    ) and vault not in normalized and env_vault not in normalized:
+        if not re.search(r"(?:^|/)\.\.(?:/|$)", normalized):
+            return None
+
+    # Absolute raw/travel-only commands are allowed.  Remove those prefixes;
+    # any remaining vault reference proves that another root is involved.
+    remainder = normalized.replace(raw_travel, "").replace(env_raw_travel, "")
+    if vault not in remainder and env_vault not in remainder and (
+        raw_travel in normalized or env_raw_travel in normalized
+    ):
+        return None
+    return (
+        "Verified travel runs may mutate only the vault's raw/travel work area "
+        "through terminal commands. Unrelated roots such as products/, "
+        "research/, and raw/research/ are immutable for this routed turn. "
+        "Do not move trees to satisfy the audit; use the controller pipeline, "
+        "then publish its controller-issued publication-receipt.json."
+    )
+

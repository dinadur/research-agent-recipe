+def _path_contains_symlink(path: Path) -> bool:
+    if not path.is_absolute():
+        return True
+    current = Path(path.anchor)
+    for part in path.parts[1:]:
+        current = current / part
+        try:
+            if current.is_symlink():
+                return True
+        except OSError:
+            return True
+    return False
+
+
+def _path_state(path: Path) -> tuple[bool, str | None]:
+    if not path.exists():
+        return False, None
+    if not path.is_file():
+        raise ValueError(f"research artifact path is not a regular file: {path}")
+    try:
+        raw = path.read_bytes()
+    except OSError as exc:
+        raise ValueError(f"could not bind research artifact bytes: {exc}") from exc
+    return True, _sha256_bytes(raw)
+
+
+def _resolve_artifact_under_roots(
+    raw_path: str,
+    allowed_roots: Sequence[str],
+) -> tuple[Path, Path]:
+    lexical = Path(raw_path).expanduser()
+    if _path_contains_symlink(lexical):
+        raise ValueError("research_artifact.path may not contain symlink components")
+    resolved = lexical.resolve(strict=False)
+    roots = [Path(root).resolve() for root in allowed_roots]
+    if not roots:
+        raise ValueError(
+            "parallel-research has no trusted research artifact root; configure "
+            "paths.obsidian_vault or OBSIDIAN_VAULT_PATH as an absolute path"
+        )
+    containing_root: Path | None = None
+    for root in roots:
+        try:
+            resolved.relative_to(root)
+        except ValueError:
+            continue
+        if resolved != root:
+            containing_root = root
+            break
+    if containing_root is None:
+        raise ValueError(
+            "research_artifact.path must resolve under the trusted raw-note root; "
+            "use the exact "
+            "runtime_context.research_artifact_root returned by the canonical "
+            "parallel-research skill_view"
+        )
+    return resolved, containing_root
+
+
+def observe_parallel_research_skill_view(
+    agent,
+    tool_name: str,
+    args: Mapping[str, Any] | None,
+    result: Any,
+    *,
+    failed: bool = False,
+) -> bool:
+    """Persist canonical parallel-research activation on this agent instance.
+
+    A new ``AIAgent`` starts without the private attribute, so a fresh ``/new``
+    session naturally resets activation.  No process-global usage telemetry or
+    prompt text participates in the decision.
+    """
+
+    if failed or tool_name != "skill_view" or not _is_top_level_research_parent(agent):
+        return False
+    if not isinstance(args, Mapping) or set(args) != {"name"}:
+        return False
+    payload = _json_object(result)
+    if not payload or payload.get("success") is not True:
+        return False
+    if payload.get("name") != PARALLEL_RESEARCH_SKILL:
+        return False
+    requested_name = (args or {}).get("name")
+    if requested_name != PARALLEL_RESEARCH_SKILL:
+        return False
+
+    skill_dir_raw = payload.get("skill_dir")
+    if not isinstance(skill_dir_raw, str) or not skill_dir_raw.strip():
+        return False
+    skill_dir = Path(skill_dir_raw).expanduser().resolve()
+    if skill_dir != _canonical_parallel_research_dir():
+        return False
+    validator = (skill_dir / VALIDATOR_RELATIVE_PATH).resolve()
+    try:
+        validator.relative_to(skill_dir)
+    except ValueError:
+        return False
+    if not validator.is_file():
+        return False
+    try:
+        validator_bytes = validator.read_bytes()
+    except OSError:
+        return False
+    if not validator_bytes or len(validator_bytes) > 2_000_000:
+        return False
+    current_turn_id = getattr(agent, "_current_turn_id", None)
+    if (
+        isinstance(current_turn_id, str)
+        and current_turn_id
+        and getattr(agent, "_parallel_research_route_required_turn_id", None)
+        == current_turn_id
+    ):
+        missing_flags = tuple(
+            flag.decode("ascii")
+            for flag in PARALLEL_RESEARCH_REQUIRED_VALIDATOR_FLAGS
+            if flag not in validator_bytes
+        )
+        if missing_flags:
+            agent._parallel_research_validator_compatibility_error_turn_id = (
+                current_turn_id
+            )
+            agent._parallel_research_validator_compatibility_error = (
+                "Research setup failed before dispatch: the installed "
+                "parallel-research validator is incompatible with the runtime "
+                "contract (missing "
+                + ", ".join(missing_flags)
+                + "). No research wave was started."
+            )
+            return False
+
+    from hermes_time import now as _hermes_now
+
+    research_run_stamp = _hermes_now().strftime("%Y-%m-%d-%H%M")
+    if _RESEARCH_RUN_STAMP_RE.fullmatch(research_run_stamp) is None:
+        return False
+
+    (
+        research_artifact_root,
+        research_artifact_root_source,
+    ) = _preferred_research_artifact_root()
+    operator_request = _bounded_operator_research_request(
+        getattr(agent, "_parallel_research_operator_request", "")
+    )
+    agent._parallel_research_activation = ParallelResearchActivation(
+        name=PARALLEL_RESEARCH_SKILL,
+        skill_dir=str(skill_dir),
+        validator_path=str(validator),
+        validator_bytes=validator_bytes,
+        validator_sha256=_sha256_bytes(validator_bytes),
+        allowed_roots=(
+            (str(research_artifact_root),) if research_artifact_root is not None else ()
+        ),
+        research_run_stamp=research_run_stamp,
+        research_run_stamp_source=RESEARCH_RUN_STAMP_SOURCE,
+        research_artifact_root=(
+            str(research_artifact_root) if research_artifact_root is not None else ""
+        ),
+        research_artifact_root_source=research_artifact_root_source,
+        operator_request=operator_request,
+        source_policy_id=research_source_policy_id(operator_request),
+    )
+    return True
+
+
+def get_parallel_research_activation(agent) -> ParallelResearchActivation | None:
+    activation = getattr(agent, "_parallel_research_activation", None)
+    return activation if isinstance(activation, ParallelResearchActivation) else None

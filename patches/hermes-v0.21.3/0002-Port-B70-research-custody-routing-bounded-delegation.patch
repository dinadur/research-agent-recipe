+def _absolute_path_under_travel_raw(value: Any) -> bool:
+    if not isinstance(value, str) or not value.strip():
+        return False
+    candidate = Path(value).expanduser()
+    if not candidate.is_absolute():
+        return False
+    try:
+        candidate.resolve().relative_to(_travel_raw_root())
+    except (OSError, RuntimeError, ValueError):
+        return False
+    return True
+

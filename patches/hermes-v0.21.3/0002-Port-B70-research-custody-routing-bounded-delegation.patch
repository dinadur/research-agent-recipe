+"""Provider-boundary invariants for controller-owned research and bounded children."""
+from __future__ import annotations
+import copy
+from typing import Any
+
+class ResearchProviderMixin:
+    def _apply_trusted_output_cap(self, api_kwargs: dict) -> dict:
+        """Apply the child output ceiling at the last provider boundary.
+
+        The input may be a fresh provider kwargs mapping or a replacement
+        returned by request/execution middleware. Mutate a shallow copy so an
+        observer retaining the middleware payload cannot later change the
+        already-validated request object.
+        """
+        api_kwargs = dict(api_kwargs or {})
+        # Delegate children may carry a trusted process-level output cap.
+        # Apply it after all profile, fallback, request-override, and ephemeral
+        # continuation logic has prepared the provider-specific kwargs. This is
+        # the final common boundary before any request is sent, including text
+        # and truncated-tool-call continuations that intentionally increase the
+        # ordinary per-request max_tokens budget.
+        trusted_cap = getattr(self, "_trusted_max_output_tokens_cap", None)
+        if not isinstance(trusted_cap, bool):
+            try:
+                trusted_cap = int(trusted_cap)
+            except (TypeError, ValueError, OverflowError):
+                trusted_cap = None
+        else:
+            trusted_cap = None
+
+        if trusted_cap is not None and trusted_cap > 0:
+            output_keys = (
+                "max_output_tokens",
+                "max_completion_tokens",
+                "max_tokens",
+            )
+
+            # ``extra_body`` is merged into the serialized request *after* the
+            # SDK's typed top-level kwargs (OpenAI Python's second mapping wins
+            # on duplicate keys). A middleware/request override could therefore
+            # hide a larger output limit here and escape an otherwise-capped
+            # top-level value. Clone and clamp the nested mapping as part of the
+            # same terminal boundary; invalid nested limit values are removed so
+            # they cannot replace the provider-native cap restored below.
+            extra_body = api_kwargs.get("extra_body")
+            if isinstance(extra_body, dict):
+                extra_body = dict(extra_body)
+                for key in output_keys:
+                    if key not in extra_body:
+                        continue
+                    nested_requested = extra_body.get(key)
+                    if isinstance(nested_requested, bool):
+                        extra_body.pop(key, None)
+                        continue
+                    try:
+                        nested_requested = int(nested_requested)
+                    except (TypeError, ValueError, OverflowError):
+                        extra_body.pop(key, None)
+                        continue
+                    if nested_requested <= 0:
+                        extra_body.pop(key, None)
+                        continue
+                    extra_body[key] = min(nested_requested, trusted_cap)
+                api_kwargs["extra_body"] = extra_body
+
+            for key in output_keys:
+                if key not in api_kwargs:
+                    continue
+                requested = api_kwargs.get(key)
+                if isinstance(requested, bool):
+                    api_kwargs.pop(key, None)
+                    continue
+                try:
+                    requested = int(requested)
+                except (TypeError, ValueError, OverflowError):
+                    api_kwargs.pop(key, None)
+                    continue
+                if requested <= 0:
+                    api_kwargs.pop(key, None)
+                    continue
+                api_kwargs[key] = min(requested, trusted_cap)
+
+            # Replacement middleware may omit the output-limit field entirely.
+            # A trusted cap is a ceiling, not merely a request-default clamp, so
+            # restore the provider-native field before the request can leave the
+            # process. Bedrock Converse carries the value in inferenceConfig;
+            # the other transports use one of the top-level keys above.
+            if self.api_mode == "bedrock_converse":
+                inference_config = api_kwargs.get("inferenceConfig")
+                inference_config = (
+                    dict(inference_config) if isinstance(inference_config, dict) else {}
+                )
+                bedrock_requested = inference_config.get("maxTokens")
+                if isinstance(bedrock_requested, bool):
+                    bedrock_requested = None
+                try:
+                    bedrock_requested = int(bedrock_requested)
+                except (TypeError, ValueError, OverflowError):
+                    bedrock_requested = None
+                if bedrock_requested is None or bedrock_requested <= 0:
+                    inference_config["maxTokens"] = trusted_cap
+                else:
+                    inference_config["maxTokens"] = min(bedrock_requested, trusted_cap)
+                api_kwargs["inferenceConfig"] = inference_config
+            else:
+                # Always restore the field native to the active transport. A
+                # different recognized key cannot stand in for it: e.g. the
+                # native Gemini shim accepts ``max_completion_tokens`` via
+                # ``**kwargs`` but ignores it, then defaults to 65,535 output
+                # tokens unless ``max_tokens`` is also present.
+                if self.api_mode == "codex_responses":
+                    native_output_param = {"max_output_tokens": trusted_cap}
+                elif self.api_mode == "anthropic_messages":
+                    native_output_param = {"max_tokens": trusted_cap}
+                else:
+                    native_output_param = self._max_tokens_param(trusted_cap)
+
+                for key, cap_value in native_output_param.items():
+                    requested = api_kwargs.get(key)
+                    if isinstance(requested, bool):
+                        requested = None
+                    try:
+                        requested = int(requested)
+                    except (TypeError, ValueError, OverflowError):
+                        requested = None
+                    if requested is None or requested <= 0:
+                        effective_output_cap = cap_value
+                    else:
+                        effective_output_cap = min(requested, cap_value)
+
+                    # The SDK gives extra_body precedence on the serialized
+                    # wire payload. Honor a lower nested native limit and mirror
+                    # it top-level so downstream structural checks (notably
+                    # Anthropic manual-thinking budget validation) reason about
+                    # the value the provider will actually receive.
+                    if isinstance(extra_body, dict) and key in extra_body:
+                        effective_output_cap = min(
+                            effective_output_cap, extra_body[key]
+                        )
+                        extra_body[key] = effective_output_cap
+                    api_kwargs[key] = effective_output_cap
+
+            # Anthropic's SDK also merges ``extra_body`` after typed kwargs.
+            # Canonicalize the two fields coupled by manual-thinking validation
+            # so a middleware cannot hide a larger thinking budget (or required
+            # temperature) in the later, wire-precedence mapping.
+            if self.api_mode == "anthropic_messages" and isinstance(extra_body, dict):
+                for key in ("thinking", "temperature"):
+                    if key in extra_body:
+                        api_kwargs[key] = extra_body.pop(key)
+
+            # Manual Anthropic thinking requires budget_tokens < max_tokens.
+            # The provider adapter may have expanded a 4K request to 20K for a
+            # 16K thinking budget before this final trusted clamp. Clamping
+            # max_tokens alone then creates an invalid 16K-thinking/4K-output
+            # request. Preserve at least 1K for visible output and shrink the
+            # manual budget; if the cap is too small for Anthropic's 1K
+            # thinking minimum plus that reserve, disable manual thinking for
+            # this bounded child request. Adaptive thinking has no numeric
+            # budget and is unaffected.
+            _thinking = api_kwargs.get("thinking")
+            _manual_budget = None
+            _effective_max = None
+            if isinstance(_thinking, dict) and _thinking.get("type") == "enabled":
+                _thinking = dict(_thinking)
+                api_kwargs["thinking"] = _thinking
+                _manual_budget = _thinking.get("budget_tokens")
+                _effective_max = api_kwargs.get("max_tokens")
+                if isinstance(_manual_budget, bool):
+                    _manual_budget = None
+                if isinstance(_effective_max, bool):
+                    _effective_max = None
+                try:
+                    _manual_budget = int(_manual_budget)
+                    _effective_max = int(_effective_max)
+                except (TypeError, ValueError, OverflowError):
+                    _manual_budget = None
+                    _effective_max = None
+
+            if (
+                isinstance(_manual_budget, int)
+                and _manual_budget >= 1_024
+                and isinstance(_effective_max, int)
+                and _effective_max > 0
+            ):
+                _visible_reserve = max(1_024, _effective_max // 4)
+                _thinking_ceiling = _effective_max - _visible_reserve
+                if _thinking_ceiling >= 1_024:
+                    _thinking["budget_tokens"] = min(_manual_budget, _thinking_ceiling)
+                else:
+                    api_kwargs.pop("thinking", None)
+                    api_kwargs.pop("temperature", None)
+            elif isinstance(_thinking, dict) and _thinking.get("type") == "enabled":
+                # An unparseable or sub-minimum manual budget cannot be proven
+                # valid after a middleware rewrite; fail safe to ordinary output.
+                api_kwargs.pop("thinking", None)
+                api_kwargs.pop("temperature", None)
+
+        return api_kwargs
+
+    def _apply_parallel_research_provider_boundary(self, api_kwargs: dict) -> dict:
+        """Reassert the controller-owned research tool at the wire boundary.
+
+        Provider builders intentionally honor user request overrides and both
+        LLM middleware layers may replace the whole request mapping.  Those
+        are useful ordinary extension points, but they cannot own admission
+        for an explicit multi-leg research route.  Rebuild the one legal tool
+        from the immutable agent registry and convert it for the active
+        transport every time this boundary is crossed.
+        """
+        from agent.research_contract import (
+            filter_parallel_research_api_tools,
+            parallel_research_provider_phase,
+            parallel_research_provider_tool_name,
+        )
+
+        phase = parallel_research_provider_phase(self)
+        result = dict(api_kwargs or {})
+        if phase is None:
+            return result
+        tool_alias_keys = (
+            "tools",
+            "toolConfig",
+            "tool_config",
+            "tool_choice",
+            "toolChoice",
+            "parallel_tool_calls",
+            "parallelToolCalls",
+            "functions",
+            "function_call",
+            "functionCall",
+        )
+        extra_body = result.get("extra_body")
+        if isinstance(extra_body, dict):
+            extra_body = dict(extra_body)
+            for key in tool_alias_keys:
+                extra_body.pop(key, None)
+            result["extra_body"] = extra_body
+        for key in tool_alias_keys:
+            result.pop(key, None)
+        if phase == "result_no_tools":
+            return result
+        tool_name = parallel_research_provider_tool_name(phase)
+        if tool_name is None:
+            raise RuntimeError("parallel-research provider phase has no tool")
+
+        snapshots = getattr(self, "_parallel_research_canonical_tool_schemas", None)
+        if not isinstance(snapshots, dict) or tool_name not in snapshots:
+            raise RuntimeError(
+                "parallel-research provider boundary has no canonical schema"
+            )
+        canonical = filter_parallel_research_api_tools(
+            self, [copy.deepcopy(snapshots[tool_name])]
+        )
+
+        def _openai_name(schema: Any) -> str:
+            if not isinstance(schema, dict):
+                return ""
+            function = schema.get("function")
+            if not isinstance(function, dict):
+                return ""
+            name = function.get("name")
+            return name if isinstance(name, str) else ""
+
+        if len(canonical) != 1 or _openai_name(canonical[0]) != tool_name:
+            raise RuntimeError(
+                "parallel-research provider boundary rejected absent, "
+                "duplicate, or wrong-phase canonical schema"
+            )
+
+        if self.api_mode == "anthropic_messages":
+            from agent.anthropic_adapter import convert_tools_to_anthropic
+
+            wire_tools = convert_tools_to_anthropic(canonical)
+            if getattr(self, "_is_anthropic_oauth", False):
+                for schema in wire_tools:
+                    name = schema.get("name", "")
+                    if name.startswith("mcp__"):
+                        continue
+                    if name.startswith("mcp_"):
+                        schema["name"] = "mcp__" + name[len("mcp_") :]
+                    else:
+                        schema["name"] = "mcp__" + name
+            expected_wire_name = (
+                "mcp__" + tool_name
+                if getattr(self, "_is_anthropic_oauth", False)
+                else tool_name
+            )
+            wire_names = [
+                schema.get("name") for schema in wire_tools if isinstance(schema, dict)
+            ]
+        elif self.api_mode == "codex_responses":
+            wire_tools = self._get_transport().convert_tools(canonical)
+            expected_wire_name = tool_name
+            wire_names = [
+                schema.get("name") for schema in wire_tools if isinstance(schema, dict)
+            ]
+        elif self.api_mode == "bedrock_converse":
+            wire_tools = self._get_transport().convert_tools(canonical)
+            expected_wire_name = tool_name
+            wire_names = [
+                schema.get("toolSpec", {}).get("name")
+                for schema in wire_tools
+                if isinstance(schema, dict)
+            ]
+        else:
+            wire_tools = canonical
+            expected_wire_name = tool_name
+            wire_names = [_openai_name(schema) for schema in wire_tools]
+
+        if len(wire_tools) != 1 or wire_names != [expected_wire_name]:
+            raise RuntimeError(
+                "parallel-research provider boundary could not prove the "
+                "single canonical wire schema"
+            )
+
+        if self.api_mode == "bedrock_converse":
+            result["toolConfig"] = {"tools": wire_tools}
+        else:
+            result["tools"] = wire_tools
+            if self.api_mode in {"chat_completions", "codex_responses"}:
+                result["parallel_tool_calls"] = phase == "result_read_file"
+            if self.api_mode == "chat_completions":
+                # The active llama.cpp/OAI route accepts the string choices
+                # auto/none/required. With one canonical phase tool on the
+                # wire, ``required`` is an exact controller-owned choice and
+                # closes the remaining prose-only predispatch escape.
+                result["tool_choice"] = "required"
+        return result
+
+    def _apply_terminal_provider_boundaries(self, api_kwargs: dict) -> dict:
+        """Apply all controller-owned request invariants to a fresh copy."""
+        bounded = self._apply_trusted_output_cap(api_kwargs)
+        return self._apply_parallel_research_provider_boundary(bounded)
+
+
+def research_request_overrides(agent, request_overrides):
+    _request_overrides = dict(request_overrides or {})
+    from agent.product_route import (
+        product_research_discovery_request_overrides,
+        product_research_finalization_request_overrides,
+        product_research_first_action_request_overrides,
+    )
+    from agent.generic_research_route import (
+        generic_research_finalization_request_overrides,
+    )
+
+    _product_first_action_overrides = (
+        product_research_first_action_request_overrides(agent)
+    )
+    _product_finalization_overrides = (
+        product_research_finalization_request_overrides(agent)
+    )
+    _product_discovery_overrides = (
+        product_research_discovery_request_overrides(agent)
+    )
+    _product_request_overrides = (
+        _product_first_action_overrides
+        or _product_finalization_overrides
+        or _product_discovery_overrides
+    )
+    _generic_finalization_overrides = (
+        generic_research_finalization_request_overrides(agent)
+    )
+    _route_request_overrides = (
+        _product_request_overrides or _generic_finalization_overrides
+    )
+    if _route_request_overrides:
+        _route_extra = dict(_route_request_overrides.get("extra_body") or {})
+        _merged_extra = dict(_request_overrides.get("extra_body") or {})
+        _route_template = dict(_route_extra.get("chat_template_kwargs") or {})
+        if _route_template:
+            _merged_template = dict(
+                _merged_extra.get("chat_template_kwargs") or {}
+            )
+            _merged_template.update(_route_template)
+            _merged_extra["chat_template_kwargs"] = _merged_template
+            _route_extra.pop("chat_template_kwargs", None)
+        _merged_extra.update(_route_extra)
+        if _merged_extra:
+            _request_overrides["extra_body"] = _merged_extra
+        _request_overrides.update(
+            {
+                key: value
+                for key, value in _route_request_overrides.items()
+                if key != "extra_body"
+            }
+        )
+    return _request_overrides
+
+
+def enforce_request_boundaries(agent, api_kwargs):
+    bounded = ResearchProviderMixin._apply_trusted_output_cap(agent, api_kwargs)
+    return ResearchProviderMixin._apply_parallel_research_provider_boundary(agent, bounded)

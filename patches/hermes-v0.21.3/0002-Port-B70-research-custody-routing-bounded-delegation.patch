index 000000000..416977af1
--- /dev/null
+++ b/agent/research_synthesis.py
@@ -0,0 +1,1436 @@
+"""Fail-closed validation for top-level parallel-research synthesis.
+
+The child research contract protects each raw note.  This module closes the
+next boundary: a parent may only deliver prose after it has fully read every
+bound note, those exact bytes still pass the captured validator, and every
+factual line in the proposed synthesis cites a URL present in that raw corpus.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+import posixpath
+import subprocess
+import sys
+import tempfile
+from pathlib import Path
+from typing import Any, Mapping, Sequence
+
+from agent.research_contract import (
+    ResearchArtifactContract,
+    ResearchRawValidationState,
+    ResearchValidationResult,
+    _cited_source_policy_violations,
+    _parent_research_receipt_sha256,
+    _path_contains_symlink,
+    _redact_and_cap,
+    get_parallel_research_activation,
+)
+
+
+SYNTHESIS_VALIDATOR_OUTPUT_LIMIT = 16_384
+SYNTHESIS_MAX_BYTES = 512_000
+_CANARY_INITIAL_CANDIDATE_DIR_ENV = "HERMES_CANARY_INITIAL_CANDIDATE_DIR"
+_CANARY_INITIAL_WAVE_ONLY_ENV = "HERMES_CANARY_INITIAL_WAVE_ONLY"
+_CANARY_INITIAL_SNAPSHOT_KIND = "hermes-initial-candidate-snapshot"
+MISSING_PARENT_READS_PREFIX = (
+    "The parent must fully read every exact bound artifact in this result turn "
+    "before synthesis: "
+)
+SYNTHESIS_WITHHELD_RESPONSE = (
+    "Research synthesis withheld: the controller could not verify that every "
+    "retained claim came from the validated child artifacts. No research "
+    "recommendation was delivered. Repair or rerun the failed research legs "
+    "and try the synthesis again."
+)
+_RESEARCH_COMPLETION_ATTESTATION_KEYS = frozenset(
+    {
+        "path",
+        "artifact_sha256",
+        "validator_sha256",
+        "source_policy_id",
+        "passed",
+        "terminal",
+        "retryable",
+    }
+)
+
+
+def _sha256(value: bytes) -> str:
+    return hashlib.sha256(value).hexdigest()
+
+
+def _json_object(value: Any) -> dict[str, Any] | None:
+    if isinstance(value, dict):
+        return value
+    if not isinstance(value, str):
+        return None
+    try:
+        parsed = json.loads(value)
+    except (TypeError, ValueError, json.JSONDecodeError):
+        return None
+    return parsed if isinstance(parsed, dict) else None
+
+
+def _strict_completion_attestation(value: Any) -> dict[str, Any] | None:
+    if not isinstance(value, dict) or set(value) != _RESEARCH_COMPLETION_ATTESTATION_KEYS:
+        return None
+    path = value.get("path")
+    artifact_sha256 = value.get("artifact_sha256")
+    validator_sha256 = value.get("validator_sha256")
+    source_policy_id = value.get("source_policy_id")
+    if (
+        not isinstance(path, str)
+        or not path
+        or "\x00" in path
+        or "\r" in path
+        or "\n" in path
+        or not isinstance(artifact_sha256, str)
+        or len(artifact_sha256) != 64
+        or any(char not in "0123456789abcdef" for char in artifact_sha256)
+        or not isinstance(validator_sha256, str)
+        or len(validator_sha256) != 64
+        or any(char not in "0123456789abcdef" for char in validator_sha256)
+        or not isinstance(source_policy_id, str)
+        or not source_policy_id
+        or type(value.get("passed")) is not bool
+        or type(value.get("terminal")) is not bool
+        or type(value.get("retryable")) is not bool
+    ):
+        return None
+    return {key: value[key] for key in _RESEARCH_COMPLETION_ATTESTATION_KEYS}
+
+
+def clear_parent_research_completion_attestations(agent: Any) -> None:
+    """Clear one-shot completion authority without disturbing the bound wave."""
+
+    agent._parallel_research_completion_attestations = {}
+    agent._parallel_research_completion_attestation_paths = ()
+    agent._parallel_research_completion_attestation_valid = False
+
+
+def _bound_completion_contracts(
+    agent: Any,
+) -> tuple[ResearchArtifactContract, ...] | None:
+    contracts = getattr(agent, "_parallel_research_bound_artifacts", None)
+    bound_paths = getattr(agent, "_parallel_research_bound_paths", None)
+    if (
+        not isinstance(contracts, tuple)
+        or len(contracts) != 3
+        or not all(isinstance(item, ResearchArtifactContract) for item in contracts)
+        or not isinstance(bound_paths, tuple)
+        or tuple(item.path for item in contracts) != bound_paths
+        or len(set(bound_paths)) != len(bound_paths)
+    ):
+        return None
+    return contracts
+
+
+def _expected_completion_attestation_paths(
+    agent: Any, contracts: tuple[ResearchArtifactContract, ...]
+) -> tuple[str, ...]:
+    contract_paths = tuple(contract.path for contract in contracts)
+    repair_count = getattr(agent, "_parallel_research_repair_dispatch_count", 0)
+    if repair_count == 0:
+        return contract_paths
+    if repair_count != 1:
+        return ()
+    prior = getattr(agent, "_parallel_research_raw_validation", None)
+    if (
+        not isinstance(prior, ResearchRawValidationState)
+        or prior.status != "repair_required"
+        or prior.contract_paths != contract_paths
+        or not prior.failing_paths
+        or len(set(prior.failing_paths)) != len(prior.failing_paths)
+        or not set(prior.failing_paths).issubset(contract_paths)
+    ):
+        return ()
+    return tuple(path for path in contract_paths if path in set(prior.failing_paths))
+
+
+def _attestation_matches_contract_and_disk(
+    attestation: Mapping[str, Any], contract: ResearchArtifactContract
+) -> bool:
+    if (
+        attestation.get("path") != contract.path
+        or attestation.get("validator_sha256") != contract.validator_sha256
+        or attestation.get("source_policy_id") != contract.source_policy_id
+    ):
+        return False
+    path = Path(contract.path)
+    try:
+        if _path_contains_symlink(path):
+            return False
+        artifact_sha256 = _sha256(path.read_bytes())
+    except OSError:
+        return False
+    return artifact_sha256 == attestation.get("artifact_sha256")
+
+
+def bind_parent_research_completion_attestations(
+    agent: Any,
+    delegation_id: Any,
+    raw_attestations: Any,
+) -> bool:
+    """Bind a trusted completion's exact wave subset to frozen contracts.
+
+    The gateway/TUI must first establish completion ID and session ownership.
+    Initial attestations replace the corpus; a repair completion may update only
+    the immutable prior failing subset while retaining positive attestations for
+    untouched legs.
+    """
+
+    prior_attestations = getattr(
+        agent, "_parallel_research_completion_attestations", None
+    )
+    clear_parent_research_completion_attestations(agent)
+    if (
+        not isinstance(delegation_id, str)
+        or not delegation_id
+        or getattr(agent, "_parallel_research_trusted_completion_id", None)
+        != delegation_id
+        or not getattr(
+            agent, "_parallel_research_trusted_completion_session_key", None
+        )
+        or getattr(agent, "_parallel_research_pending_delegation_id", None)
+        != delegation_id
+        or not isinstance(raw_attestations, list)
+    ):
+        return False
+    contracts = _bound_completion_contracts(agent)
+    if contracts is None:
+        return False
+    expected_paths = _expected_completion_attestation_paths(agent, contracts)
+    if not expected_paths or len(raw_attestations) != len(expected_paths):
+        return False
+    incoming: dict[str, dict[str, Any]] = {}
+    contracts_by_path = {contract.path: contract for contract in contracts}
+    for raw in raw_attestations:
+        attestation = _strict_completion_attestation(raw)
+        if attestation is None:
+            return False
+        path = attestation["path"]
+        contract = contracts_by_path.get(path)
+        if (
+            contract is None
+            or path in incoming
+            or not _attestation_matches_contract_and_disk(attestation, contract)
+        ):
+            return False
+        incoming[path] = attestation
+    if set(incoming) != set(expected_paths):
+        return False
+
+    repair_count = getattr(agent, "_parallel_research_repair_dispatch_count", 0)
+    if repair_count == 0:
+        cumulative = incoming
+    else:
+        if not isinstance(prior_attestations, dict):
+            return False
+        cumulative = {}
+        for contract in contracts:
+            if contract.path in expected_paths:
+                # Repaired legs are expected to have new bytes; their incoming
+                # attestations replace, rather than validate against, the stale
+                # pre-repair digest below.
+                continue
+            prior = _strict_completion_attestation(
+                prior_attestations.get(contract.path)
+            )
+            if prior is None:
+                return False
+            if prior.get("passed") is not True:
+                return False
+            if not _attestation_matches_contract_and_disk(prior, contract):
+                return False
+            cumulative[contract.path] = prior
+        cumulative.update(incoming)
+    if set(cumulative) != set(contracts_by_path):
+        return False
+    agent._parallel_research_completion_attestations = cumulative
+    agent._parallel_research_completion_attestation_paths = expected_paths
+    agent._parallel_research_completion_attestation_valid = True
+    return True
+
+
+def _read_result_matches_bytes(content: str, raw: bytes) -> bool:
+    """Prove the model-visible gutter contains every exact UTF-8 source line."""
+    try:
+        text = raw.decode("utf-8")
+    except UnicodeDecodeError:
+        return False
+    if text.startswith("\ufeff"):
+        text = text[1:]
+    source_lines = text.splitlines()
+    # Shell-backed read_file numbers ``content.split("\n")``. A source file
+    # ending in a newline therefore has one additional, numbered terminal
+    # blank line. Admit exactly that representation and no other surplus row.
+    if raw.endswith(b"\n"):
+        source_lines.append("")
+    visible_lines = content.splitlines()
+    # v0.21 native reads omit only the formatting row for a single terminal
+    # newline. Disk identity and the attested SHA-256 are independently checked
+    # by the caller; never remove substantive or additional blank source lines.
+    if raw.endswith(b"\n") and len(visible_lines) == len(source_lines) - 1:
+        source_lines = source_lines[:-1]
+    if len(visible_lines) != len(source_lines):
+        return False
+    for line_number, (visible, source) in enumerate(
+        zip(visible_lines, source_lines), start=1
+    ):
+        prefix = f"{line_number}|"
+        if not visible.startswith(prefix) or visible[len(prefix) :] != source:
+            return False
+    return True
+
+
+def _active_contracts(agent: Any) -> tuple[ResearchArtifactContract, ...] | None:
+    turn_id = getattr(agent, "_current_turn_id", None)
+    if (
+        not isinstance(turn_id, str)
+        or not turn_id
+        or getattr(agent, "_parallel_research_post_dispatch_turn_id", None)
+        != turn_id
+    ):
+        return None
+    contracts = getattr(agent, "_parallel_research_bound_artifacts", None)
+    if (
+        not isinstance(contracts, tuple)
+        or not contracts
+        or not all(isinstance(item, ResearchArtifactContract) for item in contracts)
+    ):
+        return ()
+    return contracts
+
+
+def authenticated_parent_raw_validation(
+    agent: Any,
+) -> ResearchRawValidationState | None:
+    """Return only exact receipt-, corpus-, and validator-bound raw authority."""
+
+    contracts = _active_contracts(agent)
+    if not contracts:
+        return None
+    turn_id = getattr(agent, "_current_turn_id", None)
+    contract_paths = tuple(contract.path for contract in contracts)
+    receipts = getattr(agent, "_parallel_research_artifact_read_receipts", None)
+    receipt_sha256 = _parent_research_receipt_sha256(
+        contract_paths, receipts, turn_id
+    )
+    state = getattr(agent, "_parallel_research_raw_validation", None)
+    if (
+        not receipt_sha256
+        or not isinstance(state, ResearchRawValidationState)
+        or state.turn_id != turn_id
+        or state.contract_paths != contract_paths
+        or state.receipt_sha256 != receipt_sha256
+        or state.status not in {"passed", "repair_required", "blocked", "exhausted"}
+    ):
+        return None
+    validator_bytes = contracts[0].validator_bytes
+    validator_sha256 = contracts[0].validator_sha256
+    if (
+        not validator_bytes
+        or _sha256(validator_bytes) != validator_sha256
+        or state.validator_sha256 != validator_sha256
+        or any(
+            item.validator_bytes != validator_bytes
+            or item.validator_sha256 != validator_sha256
+            for item in contracts[1:]
+        )
+    ):
+        return None
+    activation = get_parallel_research_activation(agent)
+    if activation is not None and (
+        activation.validator_bytes != validator_bytes
+        or activation.validator_sha256 != validator_sha256
+    ):
+        return None
+    failing_set = set(state.failing_paths)
+    passing_set = set(state.passing_paths)
+    bound_set = set(contract_paths)
+    if (
+        len(failing_set) != len(state.failing_paths)
+        or len(passing_set) != len(state.passing_paths)
+        or failing_set.intersection(passing_set)
+        or not failing_set.union(passing_set).issubset(bound_set)
+    ):
+        return None
+    ordered_failing = tuple(path for path in contract_paths if path in failing_set)
+    ordered_passing = tuple(path for path in contract_paths if path in passing_set)
+    if (
+        ordered_failing != state.failing_paths
+        or ordered_passing != state.passing_paths
+        or any(receipts[path].get("status") != "read" for path in passing_set)
+    ):
+        return None
+    if state.status == "blocked":
+        return state if not state.failing_paths and not state.passing_paths else None
+    attestations = getattr(
+        agent, "_parallel_research_completion_attestations", None
+    )
+    if (
+        getattr(agent, "_parallel_research_completion_attestation_valid", False)
+        is not True
+        or not isinstance(attestations, dict)
+        or set(attestations) != bound_set
+    ):
+        return None
+    negative_paths: set[str] = set()
+    for contract in contracts:
+        attestation = _strict_completion_attestation(
+            attestations.get(contract.path)
+        )
+        receipt = receipts.get(contract.path) if isinstance(receipts, Mapping) else None
+        if (
+            attestation is None
+            or not isinstance(receipt, Mapping)
+            or receipt.get("status") != "read"
+            or attestation.get("path") != contract.path
+            or attestation.get("artifact_sha256") != receipt.get("sha256")
+            or attestation.get("validator_sha256") != contract.validator_sha256
+            or attestation.get("source_policy_id") != contract.source_policy_id
+        ):
+            return None
+        if attestation["passed"] is not True:
+            negative_paths.add(contract.path)
+    if not negative_paths.issubset(failing_set):
+        return None
+    if failing_set.union(passing_set) != bound_set:
+        return None
+    if state.status == "passed":
+        return state if state.passing_paths == contract_paths and not failing_set else None
+    return state if failing_set else None
+
+
+def record_parent_research_artifact_read(
+    agent: Any,
+    tool_name: str,
+    args: Mapping[str, Any] | None,
+    result: Any,
+    *,
+    failed: bool,
+) -> Any:
+    """Bind one exact read observation to the current result turn.
+
+    A successful receipt proves that the model saw every current byte.  A
+    narrowly-scoped ``missing`` receipt proves only that the exact bound path
+    was absent when its deterministic read failed; it can unlock the one
+    typed repair wave but can never satisfy synthesis validation.
+    """
+
+    contracts = _active_contracts(agent)
+    if contracts is None or not contracts or tool_name != "read_file":
+        return result
+    read_args = args if isinstance(args, Mapping) else {}
+    path_value = read_args.get("path")
+    offset = read_args.get("offset", 1)
+    limit = read_args.get("limit", 500)
+    if (
+        not set(read_args).issubset({"path", "offset", "limit"})
+        or not isinstance(path_value, str)
+        or not isinstance(offset, int)
+        or isinstance(offset, bool)
+        or offset != 1
+        or not isinstance(limit, int)
+        or isinstance(limit, bool)
+        or limit != 500
+    ):
+        return result
+    normalized = posixpath.normpath(path_value)
+    contract = next((item for item in contracts if item.path == normalized), None)
+    if contract is None:
+        return result
+    payload = _json_object(result)
+
+    path = Path(contract.path)
+    error = payload.get("error") if isinstance(payload, dict) else None
+    deterministic_missing_error = f"File not found: {contract.path}"
+    if (
+        (failed or isinstance(error, str))
+        and error == deterministic_missing_error
+    ):
+        try:
+            absent = not path.exists()
+            safe_path = not path.is_symlink() and not _path_contains_symlink(path)
+        except OSError:
+            return result
+        if absent and safe_path:
+            receipts = getattr(
+                agent, "_parallel_research_artifact_read_receipts", None
+            )
+            if not isinstance(receipts, dict):
+                receipts = {}
+                agent._parallel_research_artifact_read_receipts = receipts
+            receipts[contract.path] = {
+                "turn_id": getattr(agent, "_current_turn_id", None),
+                "status": "missing",
+                "path_state": "absent",
+            }
+            return _finish_parent_raw_read_batch(agent, contracts, result)
+        return result
+
+    if (
+        failed
+        or payload is None
+        or payload.get("truncated") is not False
+        or not isinstance(payload.get("content"), str)
+        or payload.get("content_returned") is False
+        or payload.get("error")
+    ):
+        return result
+    total_lines = payload.get("total_lines")
+    if (
+        not isinstance(total_lines, int)
+        or isinstance(total_lines, bool)
+        or total_lines > limit
+    ):
+        return result
+
+    try:
+        if _path_contains_symlink(path):
+            return result
+        raw = path.read_bytes()
+    except OSError:
+        return result
+    if not _read_result_matches_bytes(payload["content"], raw):
+        return result
+    digest = _sha256(raw)
+    receipts = getattr(agent, "_parallel_research_artifact_read_receipts", None)
+    if not isinstance(receipts, dict):
+        receipts = {}
+        agent._parallel_research_artifact_read_receipts = receipts
+    receipts[contract.path] = {
+        "turn_id": getattr(agent, "_current_turn_id", None),
+        "status": "read",
+        "sha256": digest,
+    }
+    return _finish_parent_raw_read_batch(agent, contracts, result)
+
+
+def _write_immutable(path: Path, content: bytes) -> None:
+    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
+    try:
+        with os.fdopen(fd, "wb", closefd=False) as handle:
+            handle.write(content)
+            handle.flush()
+            os.fsync(handle.fileno())
+    finally:
+        os.close(fd)
+    os.chmod(path, 0o400)
+
+
+def _canonical_json_bytes(value: Mapping[str, Any]) -> bytes:
+    return (
+        json.dumps(
+            value,
+            ensure_ascii=False,
+            sort_keys=True,
+            separators=(",", ":"),
+        )
+        + "\n"
+    ).encode("utf-8")
+
+
+def _canary_initial_candidate_root(
+    agent: Any,
+    contracts: tuple[ResearchArtifactContract, ...],
+) -> tuple[Path | None, str | None]:
+    """Resolve the canary-only snapshot root or return a fail-closed error.
+
+    The two environment variables are an exact pair.  Production and ordinary
+    research runs set neither and retain their existing behavior.  A canary
+    root must be a new empty sibling of the staged vault, never a path inside
+    the model-writable stage.
+    """
+
+    raw_root = os.environ.get(_CANARY_INITIAL_CANDIDATE_DIR_ENV)
+    raw_initial_only = os.environ.get(_CANARY_INITIAL_WAVE_ONLY_ENV)
+    if raw_root is None and raw_initial_only is None:
+        return None, None
+    if (
+        not isinstance(raw_root, str)
+        or not raw_root
+        or any(character in raw_root for character in ("\x00", "\r", "\n"))
+        or raw_initial_only != "1"
+    ):
+        return None, (
+            "Initial-candidate canary configuration is malformed; the snapshot "
+            "directory and initial-wave-only flag must be set together exactly."
+        )
+    root = Path(raw_root)
+    if not root.is_absolute():
+        return None, "Initial-candidate canary snapshot directory is not absolute."
+    try:
+        if _path_contains_symlink(root):
+            return None, (
+                "Initial-candidate canary snapshot directory contains a symlink."
+            )
+        resolved_root = root.resolve(strict=True)
+    except OSError as exc:
+        return None, (
+            "Initial-candidate canary snapshot directory could not be resolved: "
+            f"{type(exc).__name__}."
+        )
+    if resolved_root != root or not resolved_root.is_dir():
+        return None, (
+            "Initial-candidate canary snapshot directory is not a canonical directory."
+        )
+
+    activation = get_parallel_research_activation(agent)
+    artifact_root_raw = (
+        activation.research_artifact_root if activation is not None else ""
+    )
+    if not isinstance(artifact_root_raw, str) or not artifact_root_raw:
+        return None, (
+            "Initial-candidate canary lacks a trusted staged research root."
+        )
+    artifact_root = Path(artifact_root_raw)
+    try:
+        if _path_contains_symlink(artifact_root):
+            return None, "The staged research root contains a symlink."
+        resolved_artifact_root = artifact_root.resolve(strict=True)
+    except OSError as exc:
+        return None, (
+            "The staged research root could not be resolved for canary custody: "
+            f"{type(exc).__name__}."
+        )
+    if (
+        resolved_artifact_root != artifact_root
+        or resolved_artifact_root.name != "research"
+        or resolved_artifact_root.parent.name != "raw"
+    ):
+        return None, "The staged research root is not canonical for canary custody."
+    stage_root = resolved_artifact_root.parent.parent
+    if resolved_root.parent != stage_root.parent:
+        return None, (
+            "Initial-candidate snapshots must be outside and adjacent to the staged vault."
+        )
+    try:
+        for contract in contracts:
+            Path(contract.path).resolve(strict=True).relative_to(
+                resolved_artifact_root
+            )
+        entries = list(resolved_root.iterdir())
+    except (OSError, ValueError) as exc:
+        return None, (
+            "Initial-candidate canary path custody failed: "
+            f"{type(exc).__name__}."
+        )
+    if entries:
+        return None, "Initial-candidate canary snapshot directory is not empty."
+    return resolved_root, None
+
+
+def _persist_canary_initial_candidates(
+    root: Path,
+    contracts: tuple[ResearchArtifactContract, ...],
+    live_bytes: Mapping[str, bytes],
+    completion_attestations: Mapping[str, Mapping[str, Any]],
+    *,
+    receipt_sha256: str,
+    validator_sha256: str,
+    passing_paths: Sequence[str],
+) -> None:
+    """Create exactly three immutable candidates, then their manifest last."""
+
+    if (
+        len(contracts) != 3
+        or len(live_bytes) != 3
+        or len({contract.path for contract in contracts}) != 3
+        or set(live_bytes) != {contract.path for contract in contracts}
+    ):
+        raise OSError("initial candidate corpus is not exactly three bound files")
+    passing = set(passing_paths)
+    manifest_candidates: list[dict[str, Any]] = []
+    for ordinal, contract in enumerate(contracts, start=1):
+        filename = f"candidate-{ordinal:02d}.md"
+        content = live_bytes[contract.path]
+        attestation = completion_attestations.get(contract.path)
+        if not isinstance(attestation, Mapping):
+            raise OSError("initial candidate completion attestation is missing")
+        artifact_sha256 = _sha256(content)
+        if artifact_sha256 != attestation.get("artifact_sha256"):
+            raise OSError("initial candidate bytes do not match their attestation")
+        _write_immutable(root / filename, content)
+        manifest_candidates.append(
+            {
+                "ordinal": ordinal,
+                "filename": filename,
+                "path": contract.path,
+                "subject": contract.subject,
+                "fields": list(contract.fields),
+                "artifact_sha256": artifact_sha256,
+                "validator_sha256": contract.validator_sha256,
+                "source_policy_id": contract.source_policy_id,
+                "completion_passed": attestation.get("passed"),
+                "completion_terminal": attestation.get("terminal"),
+                "completion_retryable": attestation.get("retryable"),
+                "validator_passed": contract.path in passing,
+            }
+        )
+    for row in manifest_candidates:
+        candidate_path = root / str(row["filename"])
+        if _path_contains_symlink(candidate_path) or _sha256(
+            candidate_path.read_bytes()
+        ) != row["artifact_sha256"]:
+            raise OSError("initial candidate snapshot changed before manifest commit")
+    manifest = {
+        "schema_version": 1,
+        "kind": _CANARY_INITIAL_SNAPSHOT_KIND,
+        "candidate_count": 3,
+        "receipt_sha256": receipt_sha256,
+        "validator_sha256": validator_sha256,
+        "candidates": manifest_candidates,
+    }
+    manifest_bytes = _canonical_json_bytes(manifest)
+    manifest_path = root / "manifest.json"
+    _write_immutable(manifest_path, manifest_bytes)
+    if _path_contains_symlink(manifest_path) or manifest_path.read_bytes() != manifest_bytes:
+        raise OSError("initial candidate manifest changed after commit")
+
+
+def _run_validator(
+    validator_path: Path,
+    args: Sequence[str],
+    *,
+    timeout_seconds: float,
+) -> tuple[bool, str]:
+    try:
+        completed = subprocess.run(
+            [sys.executable, str(validator_path), *args],
+            shell=False,
+            capture_output=True,
+            text=True,
+            timeout=timeout_seconds,
+            check=False,
+            env=os.environ.copy(),
+        )
+    except Exception as exc:
+        return False, f"validator execution failed: {type(exc).__name__}: {exc}"
+    output = "\n".join(
+        part.strip()
+        for part in (completed.stdout, completed.stderr)
+        if part.strip()
+    )
+    if completed.returncode != 0:
+        return False, output or f"validator exited {completed.returncode}"
+    return True, output
+
+
+def _attach_parent_raw_validation(
+    result: Any, state: ResearchRawValidationState
+) -> Any:
+    """Attach bounded controller feedback to only the batch-closing read."""
+
+    payload = _json_object(result)
+    if payload is None:
+        return result
+    if state.status == "passed":
+        message = (
+            "All exact current-turn raw artifacts passed immutable validation. "
+            "Do not reread them; synthesize only from these receipts."
+        )
+    elif state.status == "repair_required":
+        message = (
+            "Immutable raw validation requires exactly one typed background repair "
+            "batch for every and only the failing paths below. Do not reread any "
+            "artifact or emit prose before that repair: "
+            + ", ".join(state.failing_paths)
+        )
+    elif state.status == "exhausted":
+        message = (
+            "Immutable raw validation still fails after the one permitted repair "
+            "wave. No second repair, reread, or synthesis attempt is allowed; the "
+            "controller will immediately withhold the research synthesis."
+        )
+    else:
+        message = (
+            "The immutable raw-validation boundary failed closed. Do not reread, "
+            "repair, or synthesize in this result turn."
+        )
+    augmented = dict(payload)
+    augmented["research_validation"] = {
+        "status": state.status,
+        "validator_ran": state.validator_ran,
+        "message": _redact_and_cap(message, 4_096),
+        "failing_paths": list(state.failing_paths),
+        "receipt_sha256": state.receipt_sha256,
+        "validator_sha256": state.validator_sha256,
+        "validator_output": state.feedback,
+    }
+    if isinstance(result, dict):
+        return augmented
+    return json.dumps(augmented, ensure_ascii=False)
+
+
+def _blocked_raw_validation_state(
+    contracts: tuple[ResearchArtifactContract, ...],
+    turn_id: str,
+    receipt_sha256: str,
+    message: Any,
+    *,
+    validator_ran: bool,
+) -> ResearchRawValidationState:
+    return ResearchRawValidationState(
+        turn_id=turn_id,
+        contract_paths=tuple(contract.path for contract in contracts),
+        receipt_sha256=receipt_sha256,
+        validator_sha256=(contracts[0].validator_sha256 if contracts else ""),
+        passing_paths=(),
+        failing_paths=(),
+        status="blocked",
+        validator_ran=validator_ran,
+        feedback=_redact_and_cap(message, SYNTHESIS_VALIDATOR_OUTPUT_LIMIT),
+    )
+
+
+def _validate_complete_parent_raw_batch(
+    agent: Any,
+    contracts: tuple[ResearchArtifactContract, ...],
+    *,
+    timeout_seconds: float = 30.0,
+) -> ResearchRawValidationState | None:
+    """Validate one complete receipt set against immutable raw snapshots."""
+
+    turn_id = getattr(agent, "_current_turn_id", None)
+    if not isinstance(turn_id, str) or not turn_id:
+        return None
+    contract_paths = tuple(contract.path for contract in contracts)
+    receipts = getattr(agent, "_parallel_research_artifact_read_receipts", None)
+    receipt_sha256 = _parent_research_receipt_sha256(
+        contract_paths, receipts, turn_id
+    )
+    if not receipt_sha256:
+        return None
+    prior = getattr(agent, "_parallel_research_raw_validation", None)
+    if (
+        isinstance(prior, ResearchRawValidationState)
+        and prior.turn_id == turn_id
+        and prior.contract_paths == contract_paths
+        and prior.receipt_sha256 == receipt_sha256
+    ):
+        return prior
+
+    snapshot_root, snapshot_configuration_error = _canary_initial_candidate_root(
+        agent, contracts
+    )
+    if snapshot_configuration_error is not None:
+        return _blocked_raw_validation_state(
+            contracts,
+            turn_id,
+            receipt_sha256,
+            snapshot_configuration_error,
+            validator_ran=False,
+        )
+    repair_count = getattr(agent, "_parallel_research_repair_dispatch_count", 0)
+    if snapshot_root is not None and repair_count != 0:
+        return _blocked_raw_validation_state(
+            contracts,
+            turn_id,
+            receipt_sha256,
+            "Initial-candidate canary custody was requested after a repair wave.",
+            validator_ran=False,
+        )
+
+    validator_bytes = contracts[0].validator_bytes
+    validator_sha256 = contracts[0].validator_sha256
+    if not validator_bytes or _sha256(validator_bytes) != validator_sha256:
+        return _blocked_raw_validation_state(
+            contracts,
+            turn_id,
+            receipt_sha256,
+            "The captured research validator failed its SHA-256 binding.",
+            validator_ran=False,
+        )
+    if any(
+        item.validator_bytes != validator_bytes
+        or item.validator_sha256 != validator_sha256
+        for item in contracts[1:]
+    ):
+        return _blocked_raw_validation_state(
+            contracts,
+            turn_id,
+            receipt_sha256,
+            "Bound research artifacts disagree on the validator snapshot.",
+            validator_ran=False,
+        )
+
+    raw_attestations = getattr(
+        agent, "_parallel_research_completion_attestations", None
+    )
+    if (
+        getattr(agent, "_parallel_research_completion_attestation_valid", False)
+        is not True
+        or not isinstance(raw_attestations, dict)
+        or set(raw_attestations) != set(contract_paths)
+    ):
+        return _blocked_raw_validation_state(
+            contracts,
+            turn_id,
+            receipt_sha256,
+            "Trusted research completion attestations are missing or corrupt.",
+            validator_ran=False,
+        )
+    completion_attestations: dict[str, dict[str, Any]] = {}
+    for contract in contracts:
+        attestation = _strict_completion_attestation(
+            raw_attestations.get(contract.path)
+        )
+        if (
+            attestation is None
+            or attestation.get("path") != contract.path
+            or attestation.get("validator_sha256") != contract.validator_sha256
+            or attestation.get("source_policy_id") != contract.source_policy_id
+        ):
+            return _blocked_raw_validation_state(
+                contracts,
+                turn_id,
+                receipt_sha256,
+                "A trusted research completion attestation does not match its "
+                "frozen path, validator, or source policy.",
+                validator_ran=False,
+            )
+        completion_attestations[contract.path] = attestation
+
+    live_bytes: dict[str, bytes] = {}
+    failing_paths: list[str] = []
+    diagnostics: list[str] = []
+    for contract in contracts:
+        receipt = receipts[contract.path]
+        if receipt["status"] == "missing":
+            return _blocked_raw_validation_state(
+                contracts,
+                turn_id,
+                receipt_sha256,
+                "An attested research artifact is missing at its exact bound path: "
+                + contract.path,
+                validator_ran=False,
+            )
+        path = Path(contract.path)
+        try:
+            if _path_contains_symlink(path):
+                raise OSError("bound path contains a symlink")
+            content = path.read_bytes()
+        except OSError as exc:
+            return _blocked_raw_validation_state(
+                contracts,
+                turn_id,
+                receipt_sha256,
+                f"A bound raw artifact could not be snapshotted safely: {type(exc).__name__}.",
+                validator_ran=False,
+            )
+        live_sha256 = _sha256(content)
+        if (
+            receipt.get("sha256") != live_sha256
+            or completion_attestations[contract.path].get("artifact_sha256")
+            != live_sha256
+        ):
+            return _blocked_raw_validation_state(
+                contracts,
+                turn_id,
+                receipt_sha256,
+                "A bound raw artifact does not match both its completion "
+                "attestation and model-visible read receipt: "
+                + contract.path,
+                validator_ran=False,
+            )
+        live_bytes[contract.path] = content
+        if completion_attestations[contract.path]["passed"] is not True:
+            failing_paths.append(contract.path)
+            diagnostics.append(
+                "The exact child completion attestation is a valid negative for "
+                "the bound artifact path: "
+                + contract.path
+            )
+        source_policy_violations = _cited_source_policy_violations(
+            content, contract.source_policy_id
+        )
+        if source_policy_violations:
+            failing_paths.append(contract.path)
+            diagnostics.append(
+                "Raw artifact citation admission failed frozen source policy "
+                f"{contract.source_policy_id!r} for exact bound path "
+                f"{contract.path}: {len(source_policy_violations)} disallowed "
+                "citation(s)."
+            )
+
+    passing_paths: list[str] = []
+    validator_ran = False
+    try:
+        with tempfile.TemporaryDirectory(prefix="hermes-research-raw-") as tmp:
+            private_dir = Path(tmp)
+            validator_path = private_dir / "validator.snapshot.py"
+            _write_immutable(validator_path, validator_bytes)
+            snapshots: dict[str, Path] = {}
+            for index, contract in enumerate(contracts, start=1):
+                content = live_bytes.get(contract.path)
+                if content is None:
+                    continue
+                snapshot = private_dir / f"raw-{index}.snapshot.md"
+                _write_immutable(snapshot, content)
+                snapshots[contract.path] = snapshot
+                args = [str(snapshot), "--min-sources", "1"]
+                for field in contract.fields:
+                    args.extend(["--required-field", field])
+                args.extend(
+                    [
+                        "--require-claim-citations",
+                        "--forbid-unverified",
+                        "--require-atomic-claims",
+                    ]
+                )
+                validator_ran = True
+                passed, output = _run_validator(
+                    validator_path, args, timeout_seconds=timeout_seconds
+                )
+                safe_output = output.replace(str(snapshot), contract.path)
+                if passed:
+                    passing_paths.append(contract.path)
+                else:
+                    failing_paths.append(contract.path)
+                    diagnostics.append(
+                        "Raw artifact failed validation for exact bound path "
+                        f"{contract.path}:\n{safe_output}"
+                    )
+            if _sha256(validator_path.read_bytes()) != validator_sha256:
+                return _blocked_raw_validation_state(
+                    contracts,
+                    turn_id,
+                    receipt_sha256,
+                    "The validator snapshot changed during raw-artifact validation.",
+                    validator_ran=validator_ran,
+                )
+            for path, snapshot in snapshots.items():
+                if _sha256(snapshot.read_bytes()) != _sha256(live_bytes[path]):
+                    return _blocked_raw_validation_state(
+                        contracts,
+                        turn_id,
+                        receipt_sha256,
+                        "A raw artifact snapshot changed during validation.",
+                        validator_ran=validator_ran,
+                    )
+    except OSError as exc:
+        return _blocked_raw_validation_state(
+            contracts,
+            turn_id,
+            receipt_sha256,
+            f"Raw-artifact snapshot validation failed closed: {type(exc).__name__}.",
+            validator_ran=validator_ran,
+        )
+
+    for path, content in live_bytes.items():
+        try:
+            if _path_contains_symlink(Path(path)) or _sha256(
+                Path(path).read_bytes()
+            ) != _sha256(content):
+                return _blocked_raw_validation_state(
+                    contracts,
+                    turn_id,
+                    receipt_sha256,
+                    "A bound raw artifact changed during immutable validation: "
+                    + path,
+                    validator_ran=validator_ran,
+                )
+        except OSError as exc:
+            return _blocked_raw_validation_state(
+                contracts,
+                turn_id,
+                receipt_sha256,
+                f"A bound raw artifact disappeared during validation: {type(exc).__name__}.",
+                validator_ran=validator_ran,
+            )
+
+    failing_set = set(failing_paths)
+    passing_paths = [
+        contract.path
+        for contract in contracts
+        if contract.path not in failing_set
+    ]
+    ordered_failing = tuple(
+        contract.path for contract in contracts if contract.path in failing_set
+    )
+    repair_exhausted = bool(
+        ordered_failing
+        and isinstance(repair_count, int)
+        and not isinstance(repair_count, bool)
+        and repair_count >= 1
+    )
+    status = (
+        "exhausted"
+        if repair_exhausted
+        else "repair_required"
+        if ordered_failing
+        else "passed"
+    )
+    feedback = (
+        "\n\n".join(diagnostics)
+        if diagnostics
+        else "All exact current-turn raw artifacts passed immutable validation."
+    )
+    if snapshot_root is not None:
+        try:
+            _persist_canary_initial_candidates(
+                snapshot_root,
+                contracts,
+                live_bytes,
+                completion_attestations,
+                receipt_sha256=receipt_sha256,
+                validator_sha256=validator_sha256,
+                passing_paths=passing_paths,
+            )
+        except Exception as exc:
+            return _blocked_raw_validation_state(
+                contracts,
+                turn_id,
+                receipt_sha256,
+                "Initial-candidate canary snapshot persistence failed closed: "
+                f"{type(exc).__name__}.",
+                validator_ran=validator_ran,
+            )
+        return _blocked_raw_validation_state(
+            contracts,
+            turn_id,
+            receipt_sha256,
+            "Initial-wave-only canary captured three immutable candidates; "
+            "repair and synthesis are terminally withheld.",
+            validator_ran=validator_ran,
+        )
+    return ResearchRawValidationState(
+        turn_id=turn_id,
+        contract_paths=contract_paths,
+        receipt_sha256=receipt_sha256,
+        validator_sha256=validator_sha256,
+        passing_paths=tuple(passing_paths),
+        failing_paths=ordered_failing,
+        status=status,
+        validator_ran=validator_ran,
+        feedback=_redact_and_cap(feedback, SYNTHESIS_VALIDATOR_OUTPUT_LIMIT),
+    )
+
+
+def _finish_parent_raw_read_batch(
+    agent: Any,
+    contracts: tuple[ResearchArtifactContract, ...],
+    result: Any,
+) -> Any:
+    """Finalize validation only when this result completed the exact batch."""
+
+    try:
+        state = _validate_complete_parent_raw_batch(agent, contracts)
+    except Exception as exc:
+        turn_id = getattr(agent, "_current_turn_id", "")
+        contract_paths = tuple(contract.path for contract in contracts)
+        receipt_sha256 = _parent_research_receipt_sha256(
+            contract_paths,
+            getattr(agent, "_parallel_research_artifact_read_receipts", None),
+            turn_id,
+        )
+        if not receipt_sha256 or not isinstance(turn_id, str) or not turn_id:
+            return result
+        state = _blocked_raw_validation_state(
+            contracts,
+            turn_id,
+            receipt_sha256,
+            f"Raw-artifact validation raised {type(exc).__name__} and failed closed.",
+            validator_ran=False,
+        )
+    if state is None:
+        return result
+    agent._parallel_research_raw_validation = state
+    return _attach_parent_raw_validation(result, state)
+
+
+def validate_parent_research_synthesis(
+    agent: Any,
+    synthesis: Any,
+    *,
+    timeout_seconds: float = 30.0,
+) -> ResearchValidationResult | None:
+    """Validate a proposed parent answer, or return ``None`` off this lane."""
+
+    contracts = _active_contracts(agent)
+    if contracts is None:
+        return None
+    if not contracts:
+        return ResearchValidationResult(
+            False,
+            "The result turn has no controller-bound research artifact descriptors.",
+            terminal=True,
+            retryable=False,
+        )
+    turn_id = getattr(agent, "_current_turn_id", None)
+    receipts = getattr(agent, "_parallel_research_artifact_read_receipts", None)
+    if not isinstance(receipts, dict):
+        receipts = {}
+    live_bytes: dict[str, bytes] = {}
+    missing_reads: list[str] = []
+    for contract in contracts:
+        receipt = receipts.get(contract.path)
+        if not isinstance(receipt, dict) or receipt.get("turn_id") != turn_id:
+            missing_reads.append(contract.path)
+            continue
+        if receipt.get("status") == "missing":
+            # A deterministic absence is part of the exact receipt set.  Let
+            # the persisted raw-validation state name the complete failing
+            # set so the controller can admit one exact repair batch.
+            continue
+        if receipt.get("status") != "read":
+            missing_reads.append(contract.path)
+            continue
+        path = Path(contract.path)
+        try:
+            if _path_contains_symlink(path):
+                return ResearchValidationResult(
+                    False,
+                    f"A bound research artifact path contains a symlink: {path}",
+                    terminal=True,
+                    retryable=False,
+                )
+            content = path.read_bytes()
+        except OSError as exc:
+            return ResearchValidationResult(
+                False,
+                f"A bound research artifact could not be read: {exc}",
+                terminal=True,
+                retryable=False,
+            )
+        if receipt.get("sha256") != _sha256(content):
+            return ResearchValidationResult(
+                False,
+                f"A bound research artifact changed after the parent read it: {path}",
+                terminal=True,
+                retryable=False,
+            )
+        live_bytes[contract.path] = content
+    if missing_reads:
+        return ResearchValidationResult(
+            False,
+            MISSING_PARENT_READS_PREFIX + ", ".join(missing_reads),
+        )
+
+    contract_paths = tuple(contract.path for contract in contracts)
+    raw_validation = authenticated_parent_raw_validation(agent)
+    if raw_validation is None:
+        return ResearchValidationResult(
+            False,
+            "The controller lacks immutable raw-validation authority for the "
+            "complete current-turn receipt set.",
+            terminal=True,
+            retryable=False,
+        )
+    if raw_validation.status == "blocked":
+        return ResearchValidationResult(
+            False,
+            "The immutable raw-artifact validation boundary failed closed.",
+            validator_output=raw_validation.feedback,
+            terminal=True,
+            retryable=False,
+        )
+    if raw_validation.status == "exhausted":
+        return ResearchValidationResult(
+            False,
+            "The one permitted repair wave was exhausted and the fresh exact "
+            "raw-artifact corpus still fails immutable validation.",
+            validator_output=raw_validation.feedback,
+            terminal=True,
+            retryable=False,
+        )
+    if raw_validation.status == "repair_required":
+        return ResearchValidationResult(
+            False,
+            "One typed leg-local repair batch is required before synthesis for "
+            "every and only these exact bound paths: "
+            + ", ".join(raw_validation.failing_paths),
+            validator_output=raw_validation.feedback,
+            repair_paths=raw_validation.failing_paths,
+        )
+    if not (
+        raw_validation.status == "passed"
+        and not raw_validation.failing_paths
+        and raw_validation.passing_paths == contract_paths
+    ):
+        return ResearchValidationResult(
+            False,
+            "The immutable raw-validation state is internally inconsistent.",
+            terminal=True,
+            retryable=False,
+        )
+
+    if not isinstance(synthesis, str) or not synthesis.strip():
+        return ResearchValidationResult(False, "The proposed synthesis is empty.")
+    synthesis_bytes = synthesis.encode("utf-8")
+    if len(synthesis_bytes) > SYNTHESIS_MAX_BYTES:
+        return ResearchValidationResult(
+            False,
+            f"The proposed synthesis exceeds {SYNTHESIS_MAX_BYTES} UTF-8 bytes.",
+        )
+
+    validator_bytes = contracts[0].validator_bytes
+    validator_sha256 = contracts[0].validator_sha256
+    if not validator_bytes or _sha256(validator_bytes) != validator_sha256:
+        return ResearchValidationResult(
+            False,
+            "The captured research validator failed its SHA-256 binding.",
+            terminal=True,
+            retryable=False,
+        )
+    if any(
+        item.validator_bytes != validator_bytes
+        or item.validator_sha256 != validator_sha256
+        for item in contracts[1:]
+    ):
+        return ResearchValidationResult(
+            False,
+            "Bound research artifacts disagree on the validator snapshot.",
+            terminal=True,
+            retryable=False,
+        )
+
+    diagnostics: list[str] = []
+    try:
+        with tempfile.TemporaryDirectory(prefix="hermes-research-synthesis-") as tmp:
+            private_dir = Path(tmp)
+            validator_path = private_dir / "validator.snapshot.py"
+            _write_immutable(validator_path, validator_bytes)
+            raw_snapshots: list[Path] = []
+            for index, contract in enumerate(contracts, start=1):
+                snapshot = private_dir / f"raw-{index}.snapshot.md"
+                content = live_bytes[contract.path]
+                _write_immutable(snapshot, content)
+                raw_snapshots.append(snapshot)
+            synthesis_path = private_dir / "synthesis.snapshot.md"
+            _write_immutable(synthesis_path, synthesis_bytes)
+            args = [
+                str(synthesis_path),
+                "--min-sources",
+                "1",
+                "--require-claim-citations",
+                "--forbid-unverified",
+                "--require-atomic-claims",
+            ]
+            for source in raw_snapshots:
+                args.extend(["--source-corpus", str(source)])
+            passed, output = _run_validator(
+                validator_path, args, timeout_seconds=timeout_seconds
+            )
+            if not passed:
+                diagnostics.append(f"parent synthesis failed validation:\n{output}")
+
+            if _sha256(validator_path.read_bytes()) != validator_sha256:
+                return ResearchValidationResult(
+                    False,
+                    "The validator snapshot changed during synthesis validation.",
+                    terminal=True,
+                    retryable=False,
+                )
+            for contract, snapshot in zip(contracts, raw_snapshots):
+                if _sha256(snapshot.read_bytes()) != _sha256(live_bytes[contract.path]):
+                    return ResearchValidationResult(
+                        False,
+                        "A raw artifact snapshot changed during validation.",
+                        terminal=True,
+                        retryable=False,
+                    )
+    except OSError as exc:
+        return ResearchValidationResult(
+            False,
+            f"Research synthesis snapshot I/O failed: {exc}",
+            terminal=True,
+            retryable=False,
+        )
+
+    for contract in contracts:
+        try:
+            if _sha256(Path(contract.path).read_bytes()) != _sha256(
+                live_bytes[contract.path]
+            ):
+                return ResearchValidationResult(
+                    False,
+                    "A bound research artifact changed during synthesis validation: "
+                    + contract.path,
+                    terminal=True,
+                    retryable=False,
+                )
+        except OSError as exc:
+            return ResearchValidationResult(
+                False,
+                f"A bound research artifact disappeared during validation: {exc}",
+                terminal=True,
+                retryable=False,
+            )
+
+    if diagnostics:
+        return ResearchValidationResult(
+            False,
+            "Research synthesis validation failed.",
+            validator_output=_redact_and_cap(
+                "\n\n".join(diagnostics), SYNTHESIS_VALIDATOR_OUTPUT_LIMIT
+            ),
+        )
+    return ResearchValidationResult(
+        True,
+        "Research synthesis passed raw-artifact and source-corpus validation.",
+    )
+
+
+def build_research_synthesis_nudge(result: ResearchValidationResult) -> str:
+    details = result.validator_output or result.message
+    if result.terminal or not result.retryable:
+        return (
+            "The research controller marked this result turn terminal and will "
+            "withhold synthesis immediately. Do not reread, delegate, browse, or "
+            "attempt a synthesis correction. Controller feedback:\n"
+            + _redact_and_cap(details, SYNTHESIS_VALIDATOR_OUTPUT_LIMIT)
+        )
+    if result.message.startswith(MISSING_PARENT_READS_PREFIX):
+        return (
+            "Your proposed research synthesis was withheld because the required "
+            "parent read receipts do not exist yet. Your next response must be one "
+            "tool-call batch containing exactly one read_file call for each exact "
+            "bound path listed in the controller feedback, with offset=1 and "
+            "limit=500. Emit no prose and do not delegate, browse, extract, mutate "
+            "files, reload a skill, or attempt synthesis until all of those reads "
+            "return complete, non-truncated receipts. Controller feedback:\n"
+            + _redact_and_cap(details, SYNTHESIS_VALIDATOR_OUTPUT_LIMIT)
+        )
+    if result.repair_paths:
+        return (
+            "Your proposed research synthesis was withheld because immutable raw "
+            "validation requires repair. All current-turn read observations already "
+            "exist: DO NOT call read_file again and do not emit prose. Your next "
+            "response must be exactly one delegate_task call with background=true "
+            "and one typed leaf task for every and only these exact failing paths: "
+            + ", ".join(result.repair_paths)
+            + ". Preserve each original subject, path, and fields descriptor; a "
+            "subset, superset, rename, or second repair wave is controller-blocked. "
+            "Controller feedback:\n"
+            + _redact_and_cap(details, SYNTHESIS_VALIDATOR_OUTPUT_LIMIT)
+        )
+    return (
+        "Your proposed research synthesis was withheld by the controller. "
+        "All exact raw artifacts already passed immutable validation, and their "
+        "current-turn read receipts persist across synthesis correction attempts. "
+        "DO NOT call read_file again and do not delegate. Rewrite only the answer "
+        "as at most 12 one-claim Markdown bullets so "
+        "every factual line carries both a same-line "
+        "HTTPS URL already present in the passing raw artifacts and a same-line "
+        "date formatted '(retrieved YYYY-MM-DD)'; omit uncited introduction, "
+        "conclusion, status, and path lines as well as unverified claims, "
+        "invented ratings, and unsupported "
+        "superlatives. Controller feedback:\n"
+        + _redact_and_cap(details, SYNTHESIS_VALIDATOR_OUTPUT_LIMIT)
+    )
+
+
+__all__ = [
+    "SYNTHESIS_WITHHELD_RESPONSE",
+    "authenticated_parent_raw_validation",
+    "bind_parent_research_completion_attestations",
+    "build_research_synthesis_nudge",
+    "clear_parent_research_completion_attestations",
+    "record_parent_research_artifact_read",
+    "validate_parent_research_synthesis",
+]

+            "fetched_at": "2026-07-20T00:00:00+00:00",
+            "document_sha256": "a" * 64,
+        },
+    }
+    if with_offer:
+        product["selected_offer"] = {
+            "offer_id": f"offer-{product_id}",
+            "purchase_url": f"https://shop.example/products/{product_id}",
+            "matched_alias": f"MODEL-{product_id}",
+            "price": 99.0,

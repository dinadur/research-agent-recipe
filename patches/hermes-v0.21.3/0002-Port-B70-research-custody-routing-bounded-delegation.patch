+def seal_research_final(agent, *, final_response, failed, messages, _turn_exit_reason):
+    from agent.conversation_loop import logger
+    from agent.research_contract import (
+        RESEARCH_DISPATCH_WITHHELD_RESPONSE,
+        emit_parallel_research_predispatch_decision_ledger,
+        get_parallel_research_activation,
+        parallel_research_predispatch_phase,
+    )
+
+    try:
+        emit_parallel_research_predispatch_decision_ledger(agent)
+    except BaseException:
+        pass
+
+    _research_predispatch_at_entry = (
+        parallel_research_predispatch_phase(agent) is not None
+    )
+    _research_current_turn_id = getattr(agent, "_current_turn_id", None)
+    _research_predispatch_provenance = bool(
+        _research_predispatch_at_entry
+        or (
+            isinstance(_research_current_turn_id, str)
+            and _research_current_turn_id
+            and (
+                getattr(
+                    agent, "_parallel_research_route_required_turn_id", None
+                )
+                == _research_current_turn_id
+                or getattr(
+                    agent, "_parallel_research_exception_guard_turn_id", None
+                )
+                == _research_current_turn_id
+            )
+        )
+    )
+
+    def _seal_current_turn_assistant(
+        response_text: str,
+        finish_reason: str,
+    ) -> None:
+        boundary = getattr(agent, "_persist_user_message_idx", None)
+        if not isinstance(boundary, int) or not (0 <= boundary < len(messages)):
+            boundary = -1
+            for index in range(len(messages) - 1, -1, -1):
+                message = messages[index]
+                if isinstance(message, dict) and message.get("role") == "user":
+                    boundary = index
+                    break
+        for index in range(len(messages) - 1, boundary, -1):
+            message = messages[index]
+            if not isinstance(message, dict):
+                continue
+            if message.get("role") != "assistant" or message.get("tool_calls"):
+                continue
+            if message.get("_research_synthesis_synthetic"):
+                continue
+            message["content"] = response_text
+            message["finish_reason"] = finish_reason
+            return
+        messages.append(
+            {
+                "role": "assistant",
+                "content": response_text,
+                "finish_reason": finish_reason,
+            }
+        )
+
+    def _sanitize_controlled_research_history(
+        *, predispatch: bool = False
+    ) -> None:
+        """Remove private synthesis state before any output-side callback.
+
+        Parallel-research result turns defer streaming until the answer has
+        passed the controller's delivery gate.  Failed synthesis candidates,
+        retry nudges, and provider reasoning state are equally private: none of
+        them may escape through trajectory/session persistence, plugin hooks,
+        live gateway history, or the returned result object.
+
+        Synthetic messages are controller-owned scaffolding at every position,
+        so remove every marked row.  Reasoning is stripped only from assistant
+        rows in the current turn; legitimate reasoning from earlier user turns
+        remains available in durable history.
+        """
+
+        boundary_message = None
+        boundary = getattr(agent, "_persist_user_message_idx", None)
+        if isinstance(boundary, int) and 0 <= boundary < len(messages):
+            candidate = messages[boundary]
+            if (
+                isinstance(candidate, dict)
+                and candidate.get("role") == "user"
+                and not candidate.get("_research_synthesis_synthetic")
+            ):
+                boundary_message = candidate
+
+        messages[:] = [
+            message
+            for message in messages
+            if not (
+                isinstance(message, dict)
+                and (
+                    message.get("_research_synthesis_synthetic")
+                    or message.get("_research_dispatch_synthetic")
+                    or message.get("_generic_research_synthetic")
+                )
+            )
+        ]
+
+        boundary = -1
+        if boundary_message is not None:
+            for index, message in enumerate(messages):
+                if message is boundary_message:
+                    boundary = index

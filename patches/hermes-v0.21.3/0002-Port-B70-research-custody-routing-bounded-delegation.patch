+"""Normalize request-copy system roles for strict local chat templates."""
+def normalize_system_roles(messages):
+    rows = [dict(row) for row in messages]
+    for row in rows:
+        if row.get("role") == "system" and row.get("_product_research_synthetic") is True:
+            row["role"] = "user"
+    indexes = [i for i, row in enumerate(rows) if row.get("role") == "system"]
+    if not indexes:
+        return rows
+    first = rows.pop(indexes[0])
+    normalized = [first]
+    for row in rows:
+        if row.get("role") == "system":
+            if isinstance(first.get("content"), str) and isinstance(row.get("content"), str):
+                first["content"] = first["content"].rstrip() + "\n\n" + row["content"].lstrip()
+                continue
+            row["role"] = "user"
+        normalized.append(row)
+    return normalized

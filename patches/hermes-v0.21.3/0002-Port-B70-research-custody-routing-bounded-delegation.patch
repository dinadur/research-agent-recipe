@@ -0,0 +1,577 @@
+"""Narrow code-owned delivery for a verified reliable-research wrapper result."""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import re
+import shlex
+from pathlib import Path
+from typing import Any, Mapping, Sequence
+
+from agent.research_contract import TRAVEL_CONTROLLER_OUTER_TIMEOUT_SECONDS
+
+
+RELIABLE_RESEARCH_COMMAND = (
+    "python3 ~/.hermes/skills/reliable-research/scripts/run_research.py "
+    "postgresql-logical-replication"
+)
+GENERIC_RESEARCH_RECEIPT_COMMANDS = frozenset(
+    {
+        "python3 ${HERMES_SKILL_DIR}/scripts/capture_receipt.py",
+        "python3 ~/.hermes/skills/reliable-research/scripts/capture_receipt.py",
+        "python3 ~/.hermes/skills/reliable-research/scripts/capture_receipt.py",
+    }
+)
+GENERIC_RESEARCH_RECEIPT_ABSOLUTE_COMMAND = (
+    "python3 ~/.hermes/skills/reliable-research/scripts/capture_receipt.py"
+)
+_RECEIPT_SESSION_ID_RE = re.compile(r"[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}")
+_PRODUCT_RESEARCH_RECEIPT_ROUTE_ENV = "HERMES_PRODUCT_RESEARCH_ROUTE=1"
+
+
+def bound_generic_research_receipt_command(session_id: str) -> str:
+    """Return the controller-only receipt command bound to one safe session."""
+
+    if not isinstance(session_id, str) or not _RECEIPT_SESSION_ID_RE.fullmatch(
+        session_id
+    ):
+        raise ValueError("invalid Hermes session id for receipt binding")
+    return (
+        f"HERMES_SESSION_ID={session_id} "
+        f"{GENERIC_RESEARCH_RECEIPT_ABSOLUTE_COMMAND}"
+    )
+
+
+def bound_product_research_receipt_command(session_id: str) -> str:
+    """Return the product-controller receipt command bound to one safe session."""
+
+    if not isinstance(session_id, str) or not _RECEIPT_SESSION_ID_RE.fullmatch(
+        session_id
+    ):
+        raise ValueError("invalid Hermes session id for receipt binding")
+    return (
+        f"HERMES_SESSION_ID={session_id} "
+        f"{_PRODUCT_RESEARCH_RECEIPT_ROUTE_ENV} "
+        f"{GENERIC_RESEARCH_RECEIPT_ABSOLUTE_COMMAND}"
+    )
+
+
+def generic_research_receipt_command_allowed(
+    command: Any, *, expected_session_id: str | None = None
+) -> bool:
+    """Recognize exact legacy commands or one controller-bound command."""
+
+    if command in GENERIC_RESEARCH_RECEIPT_COMMANDS:
+        return True
+    if not isinstance(command, str) or not command.startswith("HERMES_SESSION_ID="):
+        return False
+    prefix, separator, base = command.partition(" ")
+    if not separator or base != GENERIC_RESEARCH_RECEIPT_ABSOLUTE_COMMAND:
+        return False
+    session_id = prefix.removeprefix("HERMES_SESSION_ID=")
+    if not _RECEIPT_SESSION_ID_RE.fullmatch(session_id):
+        return False
+    return expected_session_id is None or session_id == expected_session_id
+
+
+def product_research_receipt_command_allowed(
+    command: Any, *, expected_session_id: str | None = None
+) -> bool:
+    """Recognize only the controller-authenticated product receipt command."""
+
+    if not isinstance(command, str) or not command.startswith("HERMES_SESSION_ID="):
+        return False
+    prefix, separator, remainder = command.partition(" ")
+    if not separator:
+        return False
+    route_env, separator, base = remainder.partition(" ")
+    if (
+        not separator
+        or route_env != _PRODUCT_RESEARCH_RECEIPT_ROUTE_ENV
+        or base != GENERIC_RESEARCH_RECEIPT_ABSOLUTE_COMMAND
+    ):
+        return False
+    session_id = prefix.removeprefix("HERMES_SESSION_ID=")
+    if not _RECEIPT_SESSION_ID_RE.fullmatch(session_id):
+        return False
+    return expected_session_id is None or session_id == expected_session_id
+
+
+def research_receipt_command_allowed(command: Any) -> bool:
+    """Recognize either exact receipt command for result-envelope parsing."""
+
+    return generic_research_receipt_command_allowed(
+        command
+    ) or product_research_receipt_command_allowed(command)
+
+
+def is_generic_research_receipt_command(command: Any) -> bool:
+    """Compatibility predicate for generic-route controller/tests."""
+
+    return generic_research_receipt_command_allowed(command)
+PRODUCT_RESEARCH_PUBLISH_COMMAND = (
+    "python3 -m agent.product_publisher --mode durable_comparison"
+)
+TRAVEL_RESEARCH_CONTROLLER_SCRIPTS = frozenset(
+    {
+        "~/.hermes/skills/travel-planning/scripts/run_hermes_travel_pipeline.py",
+        "~/.hermes/skills/travel-planning/scripts/run_hermes_travel_pipeline.py",
+    }
+)
+TRAVEL_RESEARCH_RUNNER_MODULE = "agent.research_harness.travel_runner"
+_PASS_RE = re.compile(
+    r"^RESEARCH_PASS topic=postgresql-logical-replication "
+    r"elapsed_seconds=[0-9]+(?:\.[0-9]+)? result=\S.* "
+    r"delivery_sha256=(?P<digest>[0-9a-f]{64})$"
+)
+_ERROR_RE = re.compile(r"^RESEARCH_ERROR: [^\r\n]{1,500}$")
+_RECEIPT_ERROR_RE = re.compile(r"^RESEARCH_RECEIPT_ERROR [^\r\n]{1,500}$")
+_RECEIPT_OK_RE = re.compile(
+    r"^RESEARCH_RECEIPT_OK receipt_sha256=[0-9a-f]{64} "
+    r"source_count=(?P<count>[0-9]+)$"
+)
+_RECEIPT_SOURCE_RE = re.compile(r"^SOURCE (?P<url>https://\S+)$")
+_PRODUCT_PUBLICATION_PASS_RE = re.compile(
+    r"^PRODUCT_PUBLICATION_OK path=products/[a-z0-9][a-z0-9-]*\.md "
+    r"page_sha256=[0-9a-f]{64} publication_receipt_sha256=[0-9a-f]{64}$"
+)
+_PRODUCT_PUBLICATION_ERROR_RE = re.compile(
+    r"^PRODUCT_PUBLICATION_ERROR [^\r\n]{1,500}$"
+)
+_TRAVEL_APPROVAL_RE = re.compile(
+    r"^TRAVEL_RESEARCH_READY receipt_sha256=[0-9a-f]{64} "
+    r"approval_sha256=(?P<digest>[0-9a-f]{64})$"
+)
+_BEGIN = "BEGIN_VERIFIED_RESEARCH"
+_END = "END_VERIFIED_RESEARCH"
+_TRAVEL_BEGIN = "BEGIN_TRAVEL_APPROVAL"
+_TRAVEL_END = "END_TRAVEL_APPROVAL"
+
+
+def _tool_name_and_arguments(tool_call: Any) -> tuple[str, str]:
+    function = getattr(tool_call, "function", None)
+    if function is not None:
+        return str(getattr(function, "name", "")), str(
+            getattr(function, "arguments", "")
+        )
+    if isinstance(tool_call, Mapping):
+        function = tool_call.get("function")
+        if isinstance(function, Mapping):
+            return str(function.get("name") or ""), str(
+                function.get("arguments") or ""
+            )
+    return "", ""
+
+
+def _tool_call_id(tool_call: Any) -> str:
+    if isinstance(tool_call, Mapping):
+        return str(
+            tool_call.get("id")
+            or tool_call.get("call_id")
+            or tool_call.get("tool_call_id")
+            or ""
+        )
+    return str(
+        getattr(tool_call, "id", None)
+        or getattr(tool_call, "call_id", None)
+        or ""
+    )
+
+
+def _travel_controller_invocation(
+    tool_calls: Sequence[Any],
+) -> tuple[Any, dict[str, Any], list[str]] | None:
+    """Return one exact travel controller/runner invocation, independent of output."""
+
+    if len(tool_calls) != 1:
+        return None
+    tool_call = tool_calls[0]
+    name, raw_arguments = _tool_name_and_arguments(tool_call)
+    if name != "terminal":
+        return None
+    try:
+        arguments = json.loads(raw_arguments)
+    except (TypeError, ValueError, json.JSONDecodeError):
+        return None
+    if not isinstance(arguments, dict) or arguments.get("background") not in {None, False}:
+        return None
+    try:
+        command_tokens = shlex.split(str(arguments.get("command") or ""))
+    except ValueError:
+        return None
+    python_name = Path(command_tokens[0]).name if command_tokens else ""
+    legacy_controller = bool(
+        len(command_tokens) == 4
+        and python_name in {"python", "python3"}
+        and command_tokens[1] in TRAVEL_RESEARCH_CONTROLLER_SCRIPTS
+        and command_tokens[2].startswith("/")
+        and "/raw/travel/" in command_tokens[2]
+        and command_tokens[2].endswith(".json")
+        and command_tokens[3].startswith("/")
+        and "/raw/travel/" in command_tokens[3] + "/"
+    )
+    versioned_runner = bool(
+        len(command_tokens) == 4
+        and python_name in {"python", "python3"}
+        and command_tokens[1:3] == ["-m", TRAVEL_RESEARCH_RUNNER_MODULE]
+        and command_tokens[3].startswith("/")
+        and "/raw/travel/" in command_tokens[3]
+        and command_tokens[3].endswith(".json")
+    )
+    if not (legacy_controller or versioned_runner):
+        return None
+    return tool_call, arguments, command_tokens
+
+
+def travel_research_controller_boundary(
+    tool_calls: Sequence[Any], tool_result_messages: Sequence[Mapping[str, Any]]
+) -> bool:
+    """Whether this result belongs to one exact travel controller boundary.
+
+    This deliberately does not validate success output. The conversation loop
+    uses it to fail-stop a controller-shaped call whose result cannot pass the
+    stricter hash-bound approval parser below.
+    """
+
+    invocation = _travel_controller_invocation(tool_calls)
+    if invocation is None or len(tool_result_messages) != 1:
+        return False
+    tool_call, _arguments, _tokens = invocation
+    message = tool_result_messages[0]
+    call_id = _tool_call_id(tool_call)
+    return bool(
+        isinstance(message, Mapping)
+        and message.get("role") == "tool"
+        and call_id
+        and str(message.get("tool_call_id") or "") == call_id
+    )
+
+
+def verified_research_delivery(
+    tool_calls: Sequence[Any], tool_result_messages: Sequence[Mapping[str, Any]]
+) -> tuple[str, bool] | None:
+    """Return (exact response, failed) only for the pinned trusted wrapper."""
+
+    if len(tool_calls) != 1 or len(tool_result_messages) != 1:
+        return None
+    name, raw_arguments = _tool_name_and_arguments(tool_calls[0])
+    if name != "terminal":
+        return None
+    try:
+        arguments = json.loads(raw_arguments)
+    except (TypeError, ValueError, json.JSONDecodeError):
+        return None
+    if (
+        not isinstance(arguments, dict)
+        or arguments.get("command") != RELIABLE_RESEARCH_COMMAND
+        or arguments.get("timeout") != 600
+        or arguments.get("background") not in {None, False}
+    ):
+        return None
+
+    message = tool_result_messages[0]
+    call_id = _tool_call_id(tool_calls[0])
+    if (
+        not isinstance(message, Mapping)
+        or message.get("role") != "tool"
+        or not call_id
+        or str(message.get("tool_call_id") or "") != call_id
+    ):
+        return None
+    try:
+        result = json.loads(str(message.get("content") or ""))
+    except (TypeError, ValueError, json.JSONDecodeError):
+        return None
+    if not isinstance(result, dict):
+        return None
+    output = result.get("output")
+    exit_code = result.get("exit_code")
+    error = result.get("error")
+    if not isinstance(output, str):
+        return None
+    normalized = output.rstrip("\r\n")
+    if exit_code != 0:
+        if error not in {None, ""} or _ERROR_RE.fullmatch(normalized) is None:
+            return None
+        return normalized, True
+    if error not in {None, ""}:
+        return None
+
+    lines = normalized.splitlines()
+    if len(lines) < 5:
+        return None
+    pass_match = _PASS_RE.fullmatch(lines[0])
+    if (
+        pass_match is None
+        or lines.count(_BEGIN) != 1
+        or lines.count(_END) != 1
+        or lines[1] != _BEGIN
+        or lines[-1] != _END
+    ):
+        return None
+    delivery = "\n".join(lines[2:-1]).rstrip()
+    if (
+        not delivery.startswith("# PostgreSQL Logical Replication:")
+        or delivery.count("\n## ") != 3
+        or delivery.count("\n- ") < 6
+        or "https://www.postgresql.org/docs/current/" not in delivery
+        or "[evidence:" in delivery
+        or "status: experimental" in delivery
+        or hashlib.sha256(delivery.encode("utf-8")).hexdigest()
+        != pass_match.group("digest")
+    ):
+        return None
+    return delivery, False
+
+
+def generic_research_receipt_failure(
+    tool_calls: Sequence[Any], tool_result_messages: Sequence[Mapping[str, Any]]
+) -> str | None:
+    """Fail-stop the exact generic receipt boundary before another model turn."""
+
+    if len(tool_calls) != 1 or len(tool_result_messages) != 1:
+        return None
+    name, raw_arguments = _tool_name_and_arguments(tool_calls[0])
+    if name != "terminal":
+        return None
+    try:
+        arguments = json.loads(raw_arguments)
+    except (TypeError, ValueError, json.JSONDecodeError):
+        return None
+    if (
+        not isinstance(arguments, dict)
+        or not research_receipt_command_allowed(arguments.get("command"))
+        or arguments.get("timeout") != 30
+        or arguments.get("background") not in {None, False}
+    ):
+        return None
+
+    message = tool_result_messages[0]
+    call_id = _tool_call_id(tool_calls[0])
+    if (
+        not isinstance(message, Mapping)
+        or message.get("role") != "tool"
+        or not call_id
+        or str(message.get("tool_call_id") or "") != call_id
+    ):
+        return None
+    try:
+        result = json.loads(str(message.get("content") or ""))
+    except (TypeError, ValueError, json.JSONDecodeError):
+        return None
+    if not isinstance(result, dict):
+        return None
+    exit_code = result.get("exit_code")
+    error = result.get("error")
+    if exit_code == 0 and error in {None, ""}:
+        return None
+
+    output = result.get("output")
+    normalized = output.rstrip("\r\n") if isinstance(output, str) else ""
+    if _RECEIPT_ERROR_RE.fullmatch(normalized):
+        return normalized
+    return (
+        "RESEARCH_RECEIPT_ERROR receipt capture failed; "
+        "no cited brief was produced."
+    )
+
+
+def generic_research_receipt_success(
+    tool_calls: Sequence[Any], tool_result_messages: Sequence[Mapping[str, Any]]
+) -> tuple[str, ...] | None:
+    """Return the exact successful-source allowlist for the pinned receipt."""
+
+    if len(tool_calls) != 1 or len(tool_result_messages) != 1:
+        return None
+    name, raw_arguments = _tool_name_and_arguments(tool_calls[0])
+    if name != "terminal":
+        return None
+    try:
+        arguments = json.loads(raw_arguments)
+    except (TypeError, ValueError, json.JSONDecodeError):
+        return None
+    if (
+        not isinstance(arguments, dict)
+        or not research_receipt_command_allowed(arguments.get("command"))
+        or arguments.get("timeout") != 30
+        or arguments.get("background") not in {None, False}
+    ):
+        return None
+
+    message = tool_result_messages[0]
+    call_id = _tool_call_id(tool_calls[0])
+    if (
+        not isinstance(message, Mapping)
+        or message.get("role") != "tool"
+        or not call_id
+        or str(message.get("tool_call_id") or "") != call_id
+    ):
+        return None
+    try:
+        result = json.loads(str(message.get("content") or ""))
+    except (TypeError, ValueError, json.JSONDecodeError):
+        return None
+    if (
+        not isinstance(result, dict)
+        or result.get("exit_code") != 0
+        or result.get("error") not in {None, ""}
+        or not isinstance(result.get("output"), str)
+    ):
+        return None
+
+    lines = result["output"].rstrip("\r\n").splitlines()
+    if not lines:
+        return None
+    header = _RECEIPT_OK_RE.fullmatch(lines[0])
+    if header is None:
+        return None
+    sources = tuple(
+        match.group("url")
+        for line in lines[1:]
+        if (match := _RECEIPT_SOURCE_RE.fullmatch(line)) is not None
+    )
+    if (
+        int(header.group("count")) != len(sources)
+        or len(sources) < 2
+        or len(set(sources)) != len(sources)
+    ):
+        return None
+    return sources
+
+
+def product_research_publication_delivery(
+    tool_calls: Sequence[Any], tool_result_messages: Sequence[Mapping[str, Any]]
+) -> tuple[str, bool] | None:
+    """Deliver the exact approval-bound product publisher result."""
+
+    if len(tool_calls) != 1 or len(tool_result_messages) != 1:
+        return None
+    name, raw_arguments = _tool_name_and_arguments(tool_calls[0])
+    if name != "terminal":
+        return None
+    try:
+        arguments = json.loads(raw_arguments)
+    except (TypeError, ValueError, json.JSONDecodeError):
+        return None
+    if (
+        not isinstance(arguments, dict)
+        or arguments.get("command") != PRODUCT_RESEARCH_PUBLISH_COMMAND
+        or arguments.get("timeout") != 30
+        or arguments.get("background") not in {None, False}
+    ):
+        return None
+
+    message = tool_result_messages[0]
+    call_id = _tool_call_id(tool_calls[0])
+    if (
+        not isinstance(message, Mapping)
+        or message.get("role") != "tool"
+        or not call_id
+        or str(message.get("tool_call_id") or "") != call_id
+    ):
+        return None
+    try:
+        result = json.loads(str(message.get("content") or ""))
+    except (TypeError, ValueError, json.JSONDecodeError):
+        return None
+    if not isinstance(result, dict) or not isinstance(result.get("output"), str):
+        return None
+    normalized = result["output"].rstrip("\r\n")
+    exit_code = result.get("exit_code")
+    error = result.get("error")
+    if exit_code == 0 and error in {None, ""}:
+        return (
+            (normalized, False)
+            if _PRODUCT_PUBLICATION_PASS_RE.fullmatch(normalized)
+            else None
+        )
+    if error not in {None, ""}:
+        return None
+    return (
+        (normalized, True)
+        if _PRODUCT_PUBLICATION_ERROR_RE.fullmatch(normalized)
+        else None
+    )
+
+
+def travel_research_approval_delivery(
+    tool_calls: Sequence[Any], tool_result_messages: Sequence[Mapping[str, Any]]
+) -> tuple[str, bool] | None:
+    """Deliver only the controller's hash-bound travel approval preview.
+
+    The controller has already constructed this summary from the verified
+    receipt. Returning it at the tool boundary prevents a final model turn
+    from adding unverified venues, changing the target, or misstating status.
+    """
+
+    invocation = _travel_controller_invocation(tool_calls)
+    if invocation is None or len(tool_result_messages) != 1:
+        return None
+    tool_call, arguments, _command_tokens = invocation
+    if arguments.get("timeout") != TRAVEL_CONTROLLER_OUTER_TIMEOUT_SECONDS:
+        return None
+
+    message = tool_result_messages[0]
+    call_id = _tool_call_id(tool_call)
+    if (
+        not isinstance(message, Mapping)
+        or message.get("role") != "tool"
+        or not call_id
+        or str(message.get("tool_call_id") or "") != call_id
+    ):
+        return None
+    try:
+        result = json.loads(str(message.get("content") or ""))
+    except (TypeError, ValueError, json.JSONDecodeError):
+        return None
+    if (
+        not isinstance(result, dict)
+        or result.get("exit_code") != 0
+        or result.get("error") not in {None, ""}
+        or not isinstance(result.get("output"), str)
+    ):
+        return None
+
+    lines = result["output"].rstrip("\r\n").splitlines()
+    if lines.count(_TRAVEL_BEGIN) != 1 or lines.count(_TRAVEL_END) != 1:
+        return None
+    begin_index = lines.index(_TRAVEL_BEGIN)
+    end_index = lines.index(_TRAVEL_END)
+    if begin_index < 1 or end_index != len(lines) - 1 or end_index <= begin_index + 1:
+        return None
+    header = _TRAVEL_APPROVAL_RE.fullmatch(lines[begin_index - 1])
+    if header is None:
+        return None
+    approval = "\n".join(lines[begin_index + 1 : end_index]).rstrip()
+    if (
+        not approval.startswith("Research is ready for review:")
+        or "\nNo page has been published.\n" not in approval
+        or not approval.endswith("with status `working`.")
+        or hashlib.sha256(approval.encode("utf-8")).hexdigest()
+        != header.group("digest")
+    ):
+        return None
+    return approval, False
+
+
+__all__ = [
+    "GENERIC_RESEARCH_RECEIPT_COMMANDS",
+    "GENERIC_RESEARCH_RECEIPT_ABSOLUTE_COMMAND",
+    "PRODUCT_RESEARCH_PUBLISH_COMMAND",
+    "RELIABLE_RESEARCH_COMMAND",
+    "TRAVEL_RESEARCH_CONTROLLER_SCRIPTS",
+    "TRAVEL_RESEARCH_RUNNER_MODULE",
+    "generic_research_receipt_failure",
+    "bound_generic_research_receipt_command",
+    "bound_product_research_receipt_command",
+    "generic_research_receipt_command_allowed",
+    "product_research_receipt_command_allowed",
+    "research_receipt_command_allowed",
+    "is_generic_research_receipt_command",
+    "generic_research_receipt_success",
+    "product_research_publication_delivery",
+    "travel_research_controller_boundary",
+    "travel_research_approval_delivery",
+    "verified_research_delivery",
+]
diff --git a/agent/web_provider_telemetry.py b/agent/web_provider_telemetry.py
new file mode 100644
index 000000000..8f12702b1
--- /dev/null
+++ b/agent/web_provider_telemetry.py
@@ -0,0 +1,50 @@
+"""Fail-open, content-free accounting for outbound web-provider requests."""
+
+from __future__ import annotations
+
+import json
+import os
+from datetime import datetime, timezone
+from pathlib import Path
+
+
+def _usage_path() -> Path:
+    override = os.getenv("HERMES_WEB_PROVIDER_TELEMETRY_PATH", "").strip()
+    if override:
+        return Path(override)
+    return Path.home() / ".hermes" / "telemetry" / "web-provider-usage.jsonl"
+
+
+def record_web_provider_call(provider: str, capability: str) -> None:
+    """Append one quota-bearing request event without query, URL, or secrets."""
+
+    try:
+        import fcntl
+
+        path = _usage_path()
+        path.parent.mkdir(mode=0o770, parents=True, exist_ok=True)
+        record = {
+            "schema_version": 1,
+            "event": "request",
+            "timestamp_utc": datetime.now(timezone.utc).isoformat(),
+            "provider": str(provider),
+            "capability": str(capability),
+            "pid": os.getpid(),
+        }
+        payload = (
+            json.dumps(record, separators=(",", ":"), sort_keys=True) + "\n"
+        ).encode("utf-8")
+        descriptor = os.open(
+            path,
+            os.O_APPEND | os.O_CREAT | os.O_WRONLY,
+            0o660,
+        )
+        try:
+            fcntl.flock(descriptor, fcntl.LOCK_EX)
+            os.write(descriptor, payload)
+            fcntl.flock(descriptor, fcntl.LOCK_UN)
+        finally:
+            os.close(descriptor)
+    except Exception:
+        # Telemetry must never make a research provider unavailable.
+        return
diff --git a/gateway/iteration_barrier.py b/gateway/iteration_barrier.py
new file mode 100644
index 000000000..495685864
--- /dev/null
+++ b/gateway/iteration_barrier.py
@@ -0,0 +1,117 @@
+"""Prevent internal completions from reopening an exhausted model turn."""
+import logging
+import time
+logger = logging.getLogger(__name__)
+
+
+def barrier_reason(runner, key):
+    return getattr(runner, "_iteration_resume_barriers", {}).get(key)
+
+
+def record_barrier(runner, key, result):
+    reason = str((result or {}).get("turn_exit_reason") or "")
+    if key and reason.startswith("max_iterations_reached"):
+        if not hasattr(runner, "_iteration_resume_barriers"):
+            runner._iteration_resume_barriers = {}
+        runner._iteration_resume_barriers[key] = reason
+
+
+def clear_barrier(runner, key):
+    getattr(runner, "_iteration_resume_barriers", {}).pop(key, None)
+
+
+def requeue_research_event(event):
+    from gateway.research_completion import trusted_event_metadata
+    trusted = trusted_event_metadata(event)
+    if not trusted or trusted.get("delivery_kind") != "parallel_research":
+        return False
+    from tools.process_registry import process_registry
+    source = event.source
+    queued = dict(trusted, type="async_delegation", is_batch=True, results=[], status="completed")
+    queued.update({key: getattr(source, key, "") or "" for key in ("chat_type", "chat_id", "thread_id", "user_id", "user_name")})
+    queued["platform"] = getattr(source.platform, "value", source.platform)
+    process_registry.completion_queue.put(queued)
+    return True
+
+async def deliver_barred_notification(
+    self,
+    synth_text: str,
+    *,
+    source,
+    adapter,
+    session_key: str,
+    pinned_session_id: str = "",
+    barrier_reason: str = "",
+) -> None:
+    """Persist and deliver an internal result without starting the model."""
+    from gateway.run import _non_conversational_metadata
+    deferred_content = (
+        "[SYSTEM: Background result deferred after iteration-limit "
+        "exhaustion; use it only when the user explicitly continues.]\n"
+        f"{synth_text}"
+    )
+    try:
+        entry = self.session_store.get_or_create_session(source)
+        if (
+            not pinned_session_id
+            or pinned_session_id == getattr(entry, "session_id", None)
+        ):
+            self.session_store.append_to_transcript(
+                entry.session_id,
+                {
+                    "role": "user",
+                    "content": deferred_content,
+                    "timestamp": time.time(),
+                    "_internal_deferred_after_iteration_limit": True,
+                },
+            )
+        else:
+            logger.warning(
+                "Did not passively persist barred notification for %s: "
+                "pinned session %s != active session %s",
+                session_key,
+                pinned_session_id,
+                getattr(entry, "session_id", None),
+            )
+    except Exception:
+        logger.warning(
+            "Failed to passively persist barred notification for %s",
+            session_key,
+            exc_info=True,
+        )
+    notice = (
+        f"{synth_text}\n\n"
+        "⚠️ The preceding agent turn exhausted its iteration budget. "
+        "This background result was delivered without starting another "
+        "model turn. Send an explicit message to continue."
+    )
+    platform_name = (
+        source.platform.value
+        if hasattr(source.platform, "value")
+        else str(source.platform)
+    )
+    try:
+        metadata = (
+            {"thread_id": source.thread_id}
+            if getattr(source, "thread_id", None)
+            else None
+        )
+        await adapter.send(
+            str(source.chat_id),
+            notice,
+            metadata=_non_conversational_metadata(
+                metadata, platform=platform_name
+            ),
+        )
+        logger.info(
+            "Delivered internal notification without model re-entry for "
+            "iteration-barred session %s (%s)",
+            session_key,
+            barrier_reason,
+        )
+    except Exception as exc:
+        logger.error(
+            "Barred internal notification delivery failed for %s: %s",
+            session_key,
+            exc,
+        )

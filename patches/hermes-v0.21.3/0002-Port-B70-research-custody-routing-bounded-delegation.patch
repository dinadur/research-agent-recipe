@@ -0,0 +1,61 @@
+"""Gateway binding for the deterministic product-research route."""
+
+from __future__ import annotations
+
+from typing import Any
+
+from agent.product_route import (
+    merge_product_research_skills,
+    requires_product_research_route,
+)
+
+
+PRODUCT_ROUTE_METADATA_KEY = "verified_product_research_route"
+PRODUCT_ORIGINAL_TEXT_METADATA_KEY = "verified_product_original_text"
+
+
+def arm_product_research_event(event: Any) -> bool:
+    """Bind one real user event to reliable-research before model routing."""
+
+    if event is None or getattr(event, "internal", False) is True:
+        return False
+    text = getattr(event, "text", None)
+    if not isinstance(text, str) or text.startswith("/"):
+        return False
+    if not requires_product_research_route(text):
+        return False
+    metadata = getattr(event, "metadata", None)
+    if not isinstance(metadata, dict):
+        metadata = {}
+        event.metadata = metadata
+    metadata.setdefault(PRODUCT_ORIGINAL_TEXT_METADATA_KEY, text)
+    metadata[PRODUCT_ROUTE_METADATA_KEY] = True
+    event.auto_skill = merge_product_research_skills(
+        getattr(event, "auto_skill", None)
+    )
+    return True
+
+
+def product_research_event_is_armed(event: Any) -> bool:
+    metadata = getattr(event, "metadata", None)
+    return bool(
+        isinstance(metadata, dict)
+        and metadata.get(PRODUCT_ROUTE_METADATA_KEY) is True
+    )
+
+
+def product_research_original_text(event: Any) -> str | None:
+    metadata = getattr(event, "metadata", None)
+    if not isinstance(metadata, dict):
+        return None
+    value = metadata.get(PRODUCT_ORIGINAL_TEXT_METADATA_KEY)
+    return value if isinstance(value, str) else None
+
+
+__all__ = [
+    "PRODUCT_ORIGINAL_TEXT_METADATA_KEY",
+    "PRODUCT_ROUTE_METADATA_KEY",
+    "arm_product_research_event",
+    "product_research_event_is_armed",
+    "product_research_original_text",
+]
diff --git a/gateway/research_completion.py b/gateway/research_completion.py
new file mode 100644
index 000000000..c814d8c13
--- /dev/null
+++ b/gateway/research_completion.py
@@ -0,0 +1,140 @@
+"""Gateway-only binding of internal research completion identity and file attestations."""
+import copy
+import logging
+logger = logging.getLogger(__name__)
+
+def parent_matches_lineage(
+        self,
+        parent_session_id: str,
+        current_session_id: str,
+    ) -> bool:
+        """Return whether a trusted async event belongs to this conversation.
+
+        Compression rotates the live session id while preserving one logical
+        conversation.  Exact ids are therefore sufficient, while differing
+        ids are accepted only when the gateway's synchronous session database
+        resolves both to the same resume/compression tip.  Any inability to
+        prove that relationship is a hard rejection: async completion identity
+        must never be inferred from text or from a shared gateway session key.
+        """
+        parent_id = str(parent_session_id or "").strip()
+        current_id = str(current_session_id or "").strip()
+        if not parent_id or not current_id:
+            return False
+        if parent_id == current_id:
+            return True
+
+        session_db = getattr(self, "_session_db", None)
+        sync_db = getattr(session_db, "_db", session_db)
+        resolver = getattr(sync_db, "resolve_resume_session_id", None)
+        if not callable(resolver):
+            return False
+
+        try:
+            parent_tip = str(resolver(parent_id) or "").strip()
+            current_tip = str(resolver(current_id) or "").strip()
+        except Exception:
+            logger.warning(
+                "Rejected trusted async completion: session lineage lookup failed",
+                exc_info=True,
+            )
+            return False
+
+        return bool(parent_tip and current_tip and parent_tip == current_tip)
+
+def bind_completion(runner, agent, *, trusted_async_event, session_key, session_id):
+    _trusted_completion_id = None
+    _trusted_completion_session = None
+    if (
+        isinstance(trusted_async_event, dict)
+        and trusted_async_event.get("delivery_kind")
+        == "parallel_research"
+    ):
+        _event_session_key = str(
+            trusted_async_event.get("session_key") or ""
+        ).strip()
+        _event_parent_session = str(
+            trusted_async_event.get("parent_session_id") or ""
+        ).strip()
+        if (
+            _event_session_key == str(session_key or "").strip()
+            and any(
+                parent_matches_lineage(runner,
+                    _event_parent_session,
+                    candidate_session_id,
+                )
+                for candidate_session_id in {
+                    str(session_id or "").strip(),
+                    str(getattr(agent, "session_id", "") or "").strip(),
+                }
+                if candidate_session_id
+            )
+        ):
+            _trusted_completion_id = str(
+                trusted_async_event.get("delegation_id") or ""
+            ).strip() or None
+            _trusted_completion_session = _event_session_key or None
+    agent._parallel_research_trusted_completion_id = (
+        _trusted_completion_id
+    )
+    agent._parallel_research_trusted_completion_session_key = (
+        _trusted_completion_session
+    )
+    try:
+        from agent.research_synthesis import (
+            bind_parent_research_completion_attestations,
+            clear_parent_research_completion_attestations,
+        )
+
+        if _trusted_completion_id is not None:
+            bind_parent_research_completion_attestations(
+                agent,
+                _trusted_completion_id,
+                trusted_async_event.get(
+                    "_research_completion_attestations"
+                ),
+            )
+        elif not (
+            getattr(
+                agent, "_parallel_research_pending_delegation_id", None
+            )
+            and getattr(
+                agent, "_parallel_research_bound_artifacts", None
+            )
+        ):
+            clear_parent_research_completion_attestations(agent)
+    except Exception:
+        # Completion identity may still be consumed so the result turn
+        # quarantines instead of falling through as ordinary text.
+        agent._parallel_research_completion_attestations = {}
+        agent._parallel_research_completion_attestation_paths = ()
+        agent._parallel_research_completion_attestation_valid = False
+
+
+
+def trusted_event_metadata(event):
+    if getattr(event, "internal", False) is not True:
+        return None
+    metadata = getattr(event, "metadata", None) or {}
+    candidate = metadata.get("trusted_async_event")
+    return copy.deepcopy(candidate) if isinstance(candidate, dict) else None
+
+
+def completion_metadata(evt):
+    if evt.get("type") != "async_delegation" or evt.get("delivery_kind") != "parallel_research":
+        return {}
+    return {"trusted_async_event": copy.deepcopy({
+        key: evt.get(key) for key in ("delivery_kind", "session_key", "parent_session_id", "delegation_id", "_research_completion_attestations")
+    })}
+
+
+def bind_owned_surface_completion(agent, event, session_db=None):
+    """CLI/TUI call only after their ordinary notification owner check."""
+    from types import SimpleNamespace
+    runner = SimpleNamespace(_session_db=session_db or getattr(agent, "_session_db", None))
+    current_id = str(getattr(agent, "session_id", "") or "")
+    key = str(getattr(agent, "_gateway_session_key", "") or current_id)
+    candidate = completion_metadata(event or {}).get("trusted_async_event")
+    if candidate and parent_matches_lineage(runner, candidate.get("parent_session_id"), current_id):
+        candidate["session_key"] = key
+    bind_completion(runner, agent, trusted_async_event=candidate, session_key=key, session_id=current_id)
diff --git a/gateway/research_routing.py b/gateway/research_routing.py
new file mode 100644
index 000000000..f0b685e53
--- /dev/null
+++ b/gateway/research_routing.py
@@ -0,0 +1,94 @@
+"""Mutually exclusive gateway routing for ordinary research requests."""
+
+from __future__ import annotations
+
+import re
+from typing import Any
+
+from gateway.product_routing import arm_product_research_event
+from gateway.travel_routing import arm_travel_publication_event
+
+
+EXPLICIT_MINIMAL_SKILL_METADATA_KEY = "explicit_minimal_skill_route"
+_EXPLICIT_MINIMAL_SKILL_RE = re.compile(
+    r"(?<![\w-])(research-lite|wiki-save)(?![\w-])",
+    re.IGNORECASE,
+)
+
+
+def _explicit_minimal_skill_name(event: Any) -> str | None:
+    """Return one explicitly named minimal skill from a real user event."""
+
+    if event is None or getattr(event, "internal", False) is True:
+        return None
+    return explicit_minimal_skill_name_from_text(getattr(event, "text", None))
+
+
+def explicit_minimal_skill_name_from_text(text: object) -> str | None:
+    """Return the explicitly named minimal skill in raw operator text."""
+
+    if not isinstance(text, str) or text.startswith("/"):
+        return None
+    match = _EXPLICIT_MINIMAL_SKILL_RE.search(text)
+    return match.group(1).casefold() if match else None
+
+
+def isolate_explicit_minimal_skill_toolsets(
+    enabled_toolsets: list[str], raw_operator_text: object
+) -> tuple[list[str], str | None]:
+    """Hide the skill catalog after a minimal skill is explicitly selected.
+
+    The selected skill payload is already preloaded by the gateway.  Removing
+    only the ``skills`` toolset prevents a model from loading a competing
+    controller skill while leaving research and ordinary execution tools
+    unchanged.
+    """
+
+    selected = explicit_minimal_skill_name_from_text(raw_operator_text)
+    if selected is None:
+        return list(enabled_toolsets), None
+    return [name for name in enabled_toolsets if name != "skills"], selected
+
+
+def explicit_minimal_skill_event_is_armed(event: Any) -> bool:
+    metadata = getattr(event, "metadata", None)
+    return bool(
+        isinstance(metadata, dict)
+        and metadata.get(EXPLICIT_MINIMAL_SKILL_METADATA_KEY)
+        in {"research-lite", "wiki-save"}
+    )
+
+
+def arm_research_route_event(event: Any) -> tuple[bool, bool]:
+    """Arm exactly one specialized research route.
+
+    Product comparison intent is evaluated first so incidental use-case words
+    such as ``travel`` cannot activate the travel publication capability.  The
+    product classifier itself still defers to explicit trip, itinerary,
+    destination, and travel-wiki intent, preserving the dedicated travel lane.
+    """
+
+    explicit_skill = _explicit_minimal_skill_name(event)
+    if explicit_skill:
+        metadata = getattr(event, "metadata", None)
+        if not isinstance(metadata, dict):
+            metadata = {}
+            event.metadata = metadata
+        metadata[EXPLICIT_MINIMAL_SKILL_METADATA_KEY] = explicit_skill
+        # Explicit minimal routing is exclusive.  Replace any topic/channel
+        # binding so reliable-research cannot leak into the model-visible turn.
+        event.auto_skill = explicit_skill
+        return False, False
+
+    product = arm_product_research_event(event)
+    travel = False if product else arm_travel_publication_event(event)
+    return product, travel
+
+
+__all__ = [
+    "EXPLICIT_MINIMAL_SKILL_METADATA_KEY",
+    "arm_research_route_event",
+    "explicit_minimal_skill_name_from_text",
+    "explicit_minimal_skill_event_is_armed",
+    "isolate_explicit_minimal_skill_toolsets",
+]

+def _cli_facet_synthesis_review(
+    spec_path: Path,
+    row_root: Path,
+    response_root: Path,
+    output_root: Path,
+    model: str,
+    canary_id: str | None,
+) -> int:
+    """Freeze valid facets and prepare at most one retry for each invalid one."""
+
+    if output_root.exists() or output_root.is_symlink():
+        raise ReferenceStoreError("facet synthesis review output root already exists")
+    spec = validate_spec(
+        _json_no_duplicates(spec_path.read_text(encoding="utf-8"), label="spec")
+    )
+    row_path = row_root / "evidence-rows.json"
+    row_store = _json_no_duplicates(
+        row_path.read_text(encoding="utf-8"), label="row store"
+    )
+    records: list[dict[str, Any]] = []
+    payloads: list[tuple[str, dict[str, Any] | None, str | None, dict[str, Any] | None]] = []
+    for facet in spec["facets"]:
+        marker = facet["marker"]
+        response_path = response_root / f"{marker}.json"
+        if not response_path.is_file() or response_path.is_symlink():
+            raise ReferenceStoreError(f"initial facet HTTP response {marker} is missing")
+        response = _json_no_duplicates(
+            response_path.read_text(encoding="utf-8"),
+            label=f"initial facet {marker} HTTP response",
+        )
+        try:
+            validation = validate_facet_synthesis_response(
+                response, spec, row_store, marker
+            )
+            payloads.append((marker, validation, None, None))
+        except ReferenceStoreError as exc:
+            error = str(exc)
+            facet_rows = [row for row in row_store["rows"] if row.get("facet") == marker]
+            original_prompt = build_facet_synthesis_prompt(spec, facet_rows, marker)
+            repair_prompt = build_facet_synthesis_repair_prompt(
+                original_prompt, error
+            )
+            repair_request = build_facet_synthesis_request(
+                repair_prompt, model=model, canary_id=canary_id
+            )
+            payloads.append((marker, None, error, repair_request))
+    output_root.mkdir(parents=True)
+    for marker, validation, error, repair_request in payloads:
+        facet_root = output_root / marker
+        facet_root.mkdir()
+        response_path = response_root / f"{marker}.json"
+        if validation is not None:
+            validation_path = facet_root / "initial-validation.json"
+            write_new_json(validation_path, validation)
+            records.append(
+                {
+                    "facet": marker,
+                    "status": "pass",
+                    "initial_response_sha256": sha256_file(response_path),
+                    "initial_validation_sha256": sha256_file(validation_path),
+                }
+            )
+            continue
+        assert error is not None and repair_request is not None
+        prompt = repair_request["messages"][1]["content"]
+        prompt_path = facet_root / "repair-prompt.txt"
+        request_path = facet_root / "repair-request.json"
+        _write_new(prompt_path, prompt.encode("utf-8"))
+        write_new_json(request_path, repair_request)
+        records.append(
+            {
+                "facet": marker,
+                "status": "repair_required",
+                "validation_error": error,
+                "initial_response_sha256": sha256_file(response_path),
+                "repair_prompt_sha256": sha256_file(prompt_path),
+                "repair_request_sha256": sha256_file(request_path),
+            }
+        )
+    repair_count = sum(record["status"] == "repair_required" for record in records)
+    write_new_json(
+        output_root / "facet-synthesis-review.json",
+        {
+            "schema_version": SCHEMA_VERSION,
+            "kind": "hermes-reference-store-facet-synthesis-review",
+            "spec_sha256": sha256_file(spec_path),
+            "row_store_sha256": sha256_file(row_path),
+            "facets": records,
+            "initial_synthesis_calls": len(records),
+            "repair_calls_required": repair_count,
+            "maximum_repair_calls_per_facet": 1,
+            "accepted_facets_are_frozen": True,
+            "production_promotion_authorized": False,
+        },
+    )
+    return 0
+
+
+def _cli_facet_synthesis_finalize(
+    spec_path: Path,
+    store_root: Path,
+    row_root: Path,
+    response_root: Path,
+    output_root: Path,
+    review_root: Path | None = None,
+    repair_response_root: Path | None = None,
+) -> int:
+    """Validate every facet and merge them with no model-owned final pass."""
+
+    if output_root.exists() or output_root.is_symlink():
+        raise ReferenceStoreError("facet synthesis finalization output root already exists")
+    spec = _json_no_duplicates(spec_path.read_text(encoding="utf-8"), label="spec")
+    row_path = row_root / "evidence-rows.json"
+    row_store = _json_no_duplicates(
+        row_path.read_text(encoding="utf-8"), label="row store"
+    )
+    review_records: dict[str, Mapping[str, Any]] = {}
+    if review_root is not None:
+        review = _json_no_duplicates(
+            (review_root / "facet-synthesis-review.json").read_text(encoding="utf-8"),
+            label="facet synthesis review",
+        )
+        review_facets = review.get("facets") if isinstance(review, Mapping) else None
+        if (
+            review.get("schema_version") != SCHEMA_VERSION
+            or review.get("kind") != "hermes-reference-store-facet-synthesis-review"
+            or review.get("spec_sha256") != sha256_file(spec_path)
+            or review.get("row_store_sha256") != sha256_file(row_path)
+            or review.get("maximum_repair_calls_per_facet") != 1
+            or not isinstance(review_facets, list)
+        ):
+            raise ReferenceStoreError("facet synthesis review is invalid")
+        review_records = {
+            str(record.get("facet")): record
+            for record in review_facets
+            if isinstance(record, Mapping)
+        }
+    syntheses: dict[str, dict[str, Any]] = {}
+    response_paths: dict[str, Path] = {}
+    response_rounds: dict[str, str] = {}
+    for facet in validate_spec(dict(spec))["facets"]:
+        marker = facet["marker"]
+        review_record = review_records.get(marker)
+        if review_root is None:
+            response_path = response_root / f"{marker}.json"
+            response_round = "initial"
+        elif review_record is None:
+            raise ReferenceStoreError(f"facet synthesis review omits {marker}")
+        elif review_record.get("status") == "pass":
+            response_path = response_root / f"{marker}.json"
+            response_round = "initial"
+            if review_record.get("initial_response_sha256") != sha256_file(response_path):
+                raise ReferenceStoreError(f"initial facet response {marker} changed after review")
+        elif review_record.get("status") == "repair_required":
+            if repair_response_root is None:
+                raise ReferenceStoreError(f"facet repair response {marker} is missing")
+            response_path = repair_response_root / f"{marker}.json"
+            response_round = "repair"
+        else:
+            raise ReferenceStoreError(f"facet synthesis review status {marker} is invalid")
+        if not response_path.is_file() or response_path.is_symlink():
+            raise ReferenceStoreError(f"facet HTTP response {marker} is missing")
+        response = _json_no_duplicates(
+            response_path.read_text(encoding="utf-8"),
+            label=f"facet {marker} HTTP response",
+        )
+        syntheses[marker] = validate_facet_synthesis_response(
+            response, spec, row_store, marker
+        )
+        response_paths[marker] = response_path
+        response_rounds[marker] = response_round
+    candidate = render_facet_candidate(spec, row_store, syntheses)
+    output_root.mkdir(parents=True)
+    validation_root = output_root / "facet-validations"
+    validation_root.mkdir()
+    validation_hashes: dict[str, str] = {}
+    for marker, synthesis in syntheses.items():
+        validation_path = validation_root / f"{marker}.json"
+        write_new_json(validation_path, synthesis)
+        validation_hashes[marker] = sha256_file(validation_path)
+    _write_new(output_root / "candidate.md", candidate.encode("utf-8"))
+    manifest = {
+        "schema_version": SCHEMA_VERSION,
+        "kind": "hermes-reference-store-facet-synthesis-finalization",
+        "spec_sha256": sha256_file(spec_path),
+        "reference_store_sha256": sha256_file(store_root / "reference-store.json"),
+        "row_store_sha256": sha256_file(row_path),
+        "response_sha256": {
+            marker: sha256_file(path) for marker, path in response_paths.items()
+        },
+        "response_round": response_rounds,
+        "facet_validation_sha256": validation_hashes,
+        "candidate_sha256": sha256_file(output_root / "candidate.md"),
+        "synthesis_calls": len(syntheses),
+        "repair_calls": sum(round_name == "repair" for round_name in response_rounds.values()),
+        "controller_merge": True,
+        "cross_facet_model_call": False,
+        "production_promotion_authorized": False,
+    }
+    write_new_json(output_root / "facet-finalization.json", manifest)
+    return 0
+

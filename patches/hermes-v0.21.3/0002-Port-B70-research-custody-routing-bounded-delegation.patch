+def _travel_controller_result_failed(result: Any, failed: bool) -> bool:
+    if failed:
+        return True
+    value = result
+    if isinstance(value, str):
+        lowered = value.casefold()
+        if (
+            "command timed out" in lowered
+            or "timed out after" in lowered
+            or re.search(r"command failed.*exit (?:code )?[1-9]", lowered)
+        ):
+            return True
+        try:
+            value = json.loads(value)
+        except (TypeError, ValueError, json.JSONDecodeError):
+            return False
+    if not isinstance(value, dict):
+        return False
+    status = str(value.get("status") or "").strip().casefold()
+    return bool(
+        value.get("success") is False
+        or value.get("failed") is True
+        or value.get("error")
+        or status in _FAILED_STATUSES
+        or (
+            isinstance(value.get("exit_code"), int)
+            and value.get("exit_code") != 0
+        )
+        or (
+            isinstance(value.get("returncode"), int)
+            and value.get("returncode") != 0
+        )
+    )
+

+"""Deterministic admission and delivery rules for product comparisons."""
+
+from __future__ import annotations
+
+import json
+import logging
+import os
+import re
+from typing import Any, Mapping
+from urllib.parse import urlsplit, urlunsplit
+
+from agent.verified_tool_delivery import (
+    GENERIC_RESEARCH_RECEIPT_COMMANDS,
+    PRODUCT_RESEARCH_PUBLISH_COMMAND,
+    bound_product_research_receipt_command,
+    product_research_receipt_command_allowed,
+)
+
+
+logger = logging.getLogger(__name__)
+
+
+PRODUCT_RESEARCH_ROUTE_MARKER = "HERMES_PRODUCT_RESEARCH_ROUTE_V1"
+PRODUCT_RESEARCH_SKILLS = ("reliable-research",)
+PRODUCT_RESEARCH_ALLOWED_TOOLS = frozenset({"web_search", "web_extract", "terminal"})
+PRODUCT_RESEARCH_PUBLICATION_ALLOWED_TOOLS = frozenset({"terminal"})
+PRODUCT_RESEARCH_WITHHELD_RESPONSE = (
+    "Product research withheld: Hermes did not complete the bounded current-turn "
+    "source receipt and citation checks, so no recommendation was delivered."
+)
+PRODUCT_RESEARCH_CANDIDATE_PLACEHOLDER = (
+    "[Product research candidate withheld by controller.]"
+)
+PRODUCT_RESEARCH_PUBLICATION_FOOTER = (
+    "Publication status: Draft only—nothing was written to the wiki. "
+    "Publication requires a separate controlled step."
+)
+PRODUCT_RESEARCH_FIRST_RESPONSE_TIMEOUT_ENV = (
+    "HERMES_PRODUCT_RESEARCH_FIRST_RESPONSE_TIMEOUT_SECONDS"
+)
+PRODUCT_RESEARCH_FIRST_RESPONSE_TIMEOUT_DEFAULT = 180.0
+PRODUCT_RESEARCH_FIRST_ACTION_MAX_TOKENS = 1024
+PRODUCT_RESEARCH_DISCOVERY_MAX_TOKENS = 1536
+PRODUCT_RESEARCH_FINALIZATION_MAX_TOKENS = 3072
+PRODUCT_RESEARCH_QUALITY_FIRST_ENV = "HERMES_PRODUCT_RESEARCH_QUALITY_FIRST"
+PRODUCT_RESEARCH_MAX_SEARCH_CALLS = 4
+PRODUCT_RESEARCH_MAX_EXTRACT_CALLS = 2
+PRODUCT_RESEARCH_RECOVERY_MAX_URLS = 3
+PRODUCT_RESEARCH_SOURCE_MIX_NUDGE_LIMIT = 2
+PRODUCT_RESEARCH_FINALIZATION_NUDGE_LIMIT = 3
+PRODUCT_RESEARCH_DURABLE_FINALIZATION_NUDGE_LIMIT = 1
+PRODUCT_RESEARCH_EVIDENCE_ROWS_PER_SOURCE = 6
+PRODUCT_RESEARCH_DURABLE_EVIDENCE_ROWS_PER_SOURCE = 4
+PRODUCT_RESEARCH_MIN_EVIDENCE_ROWS = 12
+PRODUCT_RESEARCH_DURABLE_MATERIAL_LINE_TARGET = 10
+PRODUCT_RESEARCH_RETRY_CANDIDATE_MAX_CHARS = 8000
+PRODUCT_RESEARCH_COMPACTED_TOOL_CONTENT = (
+    "[Controller compacted this retrieved source payload after binding the "
+    "current-turn receipt. Use only the controller_product_evidence catalog "
+    "appended to this request.]"
+)
+_PRODUCT_CANDIDATE_QUERY_STOPWORDS = frozenset({
+    "best",
+    "buy",
+    "current",
+    "for",
+    "from",
+    "independent",
+    "official",
+    "page",
+    "price",
+    "product",
+    "products",
+    "review",
+    "reviews",
+    "site",
+    "test",
+    "tests",
+    "the",
+    "under",
+    "with",
+})
+PRODUCT_RESEARCH_FIRST_RESPONSE_TIMEOUT_RESPONSE = (
+    "Product research stopped safely: the initial model response did not arrive "
+    "within {seconds} seconds, so no research tools ran and nothing was written "
+    "to the wiki. Start a fresh session to retry."
+)
+PRODUCT_RESEARCH_RESTART_RESUME_RESPONSE = (
+    "Product research was interrupted before a verified draft completed. "
+    "Nothing was published. Start a fresh session with `/new`, then resend "
+    "the research request."
+)
+PRODUCT_RESEARCH_ROUTE_NOTE = (
+    f"[System: {PRODUCT_RESEARCH_ROUTE_MARKER} is controller-selected. "
+    "The reliable-research skill is already loaded. Use one parent, at most "
+    "three searches, and at most two extraction batches; never delegate, run "
+    "terminal commands, write files, or mutate the vault. For a neutral exact-"
+    "product comparison, obtain one official page per target plus hands-on "
+    "coverage from two independent publishers. For a commerce recommendation, "
+    "obtain the selected product's official page, two independent sources, and "
+    "any requested current budget evidence. The controller seals the receipt "

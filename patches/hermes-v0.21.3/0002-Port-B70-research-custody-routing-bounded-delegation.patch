+def _search_messages(query: str, urls: list[str], suffix: str) -> list[dict]:
+    return [
+        {
+            "role": "assistant",
+            "tool_calls": [
+                {
+                    "id": f"search-{suffix}",
+                    "function": {
+                        "name": "web_search",
+                        "arguments": json.dumps({"query": query}),
+                    },
+                }
+            ],
+        },
+        {
+            "role": "tool",
+            "name": "web_search",
+            "tool_call_id": f"search-{suffix}",
+            "content": json.dumps({"data": {"web": [{"url": url} for url in urls]}}),
+        },
+    ]
+
+
+def _extract_messages(
+    urls: list[str], suffix: str, content_by_url: dict[str, str] | None = None
+) -> list[dict]:
+    return [
+        {
+            "role": "assistant",
+            "tool_calls": [
+                {
+                    "id": f"extract-{suffix}",
+                    "function": {
+                        "name": "web_extract",
+                        "arguments": json.dumps({"urls": urls}),
+                    },
+                }
+            ],
+        },
+        {
+            "role": "tool",
+            "name": "web_extract",
+            "tool_call_id": f"extract-{suffix}",
+            "content": json.dumps({
+                "results": [
+                    {
+                        "url": url,
+                        "content": (
+                            content_by_url.get(url, f"Evidence for {url}")
+                            if content_by_url is not None
+                            else f"Evidence for {url}"
+                        ),
+                    }
+                    for url in urls
+                ]
+            }),
+        },
+    ]
+

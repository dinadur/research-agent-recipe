+def observe_agent_tool_result(
+    agent,
+    tool_name: str,
+    args: Mapping[str, Any] | None,
+    result: Any,
+    *,
+    failed: bool,
+    tool_call_id: str | None = None,
+) -> Any:
+    # Travel discovery is a parent-owned route rather than a contracted child,
+    # so its search failures do not pass through ResearchContractController.
+    # Promote the same structured terminal outcome to the turn-level halt latch
+    # immediately after the tool result. The conversation loop sees this latch
+    # before asking the model for another response, eliminating a redundant
+    # retry wave when the configured search service is unavailable/exhausted.
+    try:
+        from agent.travel_route import travel_publication_route_active
+
+        travel_active = travel_publication_route_active(agent)
+        if (
+            tool_name == "web_search"
+            and travel_active
+            and getattr(agent, "_tool_guardrail_halt_decision", None) is None
+        ):
+            terminal_reason = _structured_retrieval_terminal_reason(result)
+            if terminal_reason:
+                if _travel_partial_search_failure_tolerated(agent, tool_call_id):
+                    result = _annotate_tolerated_travel_search_failure(result)
+                else:
+                    _set_travel_route_halt(
+                        agent,
+                        code="travel_search_backend_terminal",
+                        message=(
+                            "Travel discovery stopped because web search returned a "
+                            "terminal current-leg failure. No additional search wave "
+                            "will be attempted in this turn. Preserve any completed "
+                            "tool results, do not invent or publish missing venue "
+                            "details, and retry in a fresh turn after search capacity "
+                            "is available."
+                        ),
+                        tool_name="web_search",
+                        count=1,
+                    )
+        if (
+            tool_name == "terminal"
+            and travel_active
+            and _travel_route_is_controller_call(args)
+            and _travel_controller_result_failed(result, failed)
+            and getattr(agent, "_tool_guardrail_halt_decision", None) is None
+        ):
+            _set_travel_route_halt(
+                agent,
+                code="travel_controller_terminal_failure",
+                message=(
+                    "The foreground travel controller failed or timed out, so this "
+                    "turn has stopped without publication. Do not rerun the "
+                    "controller, edit its evidence artifacts, or continue with "
+                    "model-led repair. The current run directory's run-state.json "
+                    "shows the last live stage and run-report.json contains the "
+                    "controller error when one was written. Retry only in a fresh "
+                    "user turn with a new sibling run directory."
+                ),
+                tool_name="terminal",
+                count=1,
+            )
+    except Exception as exc:
+        logging.debug("travel search terminal observation failed: %s", exc)
+    try:
+        from agent.product_route import observe_product_research_tool_result
+
+        observe_product_research_tool_result(agent, tool_name)
+    except Exception as exc:
+        logging.debug(
+            "product-research retrieval observation failed: %s", exc
+        )
+    lifecycle_authenticated = False
+    if tool_name == "read_file":
+        read_args = args if isinstance(args, Mapping) else {}
+        read_path = (
+            posixpath.normpath(read_args["path"])
+            if isinstance(read_args.get("path"), str)
+            else ""
+        )
+        pending_reads = getattr(
+            agent, "_parallel_research_pending_artifact_reads", None
+        )
+        current_turn_id = getattr(agent, "_current_turn_id", None)
+        if (
+            read_path
+            and isinstance(pending_reads, dict)
+            and pending_reads.get(read_path) == current_turn_id
+        ):
+            pending_reads.pop(read_path, None)
+    pending_initial = None
+    pending_repair = None
+    if tool_name == "delegate_task":
+        with _PARALLEL_RESEARCH_DISPATCH_RESERVATION_LOCK:
+            initial_candidate = getattr(
+                agent, "_parallel_research_pending_initial_dispatch", None
+            )
+            if isinstance(initial_candidate, dict):
+                pending_initial = initial_candidate
+            agent._parallel_research_pending_initial_dispatch = None
+            candidate = getattr(agent, "_parallel_research_pending_repair", None)
+            if isinstance(candidate, dict):
+                pending_repair = candidate
+            agent._parallel_research_pending_repair = None
+        # A newly admitted dispatch attempt supersedes the completed wave's
+        # identity.  Invalidate that old binding before interpreting the new
+        # receipt, then restore authority only after the pending fingerprint,
+        # exact task count, and corpus merge all succeed below.  Otherwise a
+        # malformed repair receipt that accidentally/repeatedly carries the old
+        # delegation ID could appear bound to stale state.
+        if pending_initial is not None or pending_repair is not None:
+            agent._parallel_research_dispatch_succeeded = False
+            agent._parallel_research_pending_delegation_id = None
+    activated = observe_parallel_research_skill_view(
+        agent,
+        tool_name,
+        args,
+        result,
+        failed=failed,
+    )
+    if activated:
+        lifecycle_authenticated = True
+        activation = get_parallel_research_activation(agent)
+        if activation is not None:
+            agent._parallel_research_dispatch_succeeded = False
+            current_turn_id = getattr(agent, "_current_turn_id", None)
+            if (
+                isinstance(current_turn_id, str)
+                and current_turn_id
+                and getattr(agent, "_parallel_research_route_required_turn_id", None)
+                == current_turn_id
+            ):
+                agent._parallel_research_skill_view_turn_id = current_turn_id
+            result = _attach_research_runtime_context(result, activation)
+    elif (
+        not failed
+        and tool_name == "delegate_task"
+        and get_parallel_research_activation(agent) is not None
+        and _is_top_level_research_parent(agent)
+    ):
+        payload = _json_object(result)
+        if (
+            payload is not None
+            and payload.get("status") == "dispatched"
+            and payload.get("mode") == "background"
+            and isinstance(payload.get("count"), int)
+            and not isinstance(payload.get("count"), bool)
+            and payload["count"] > 0
+            and isinstance(payload.get("delegation_id"), str)
+            and bool(payload["delegation_id"].strip())
+        ):
+            activation = get_parallel_research_activation(agent)
+            current_turn_id = getattr(agent, "_current_turn_id", None)
+            post_dispatch_turn = (
+                isinstance(current_turn_id, str)
+                and bool(current_turn_id)
+                and getattr(agent, "_parallel_research_post_dispatch_turn_id", None)
+                == current_turn_id
+            )
+            pending_contracts = (
+                pending_repair.get("contracts")
+                if isinstance(pending_repair, dict)
+                and pending_repair.get("args_sha256") == _repair_call_fingerprint(args)
+                else None
+            )
+            if not post_dispatch_turn:
+                pending_contracts = (
+                    pending_initial.get("contracts")
+                    if isinstance(pending_initial, dict)
+                    and pending_initial.get("args_sha256")
+                    == _repair_call_fingerprint(args)
+                    else None
+                )
+            bound_contracts = (
+                pending_contracts
+                if isinstance(pending_contracts, tuple)
+                and payload["count"] == len(pending_contracts)
+                else ()
+            )
+            if bound_contracts and post_dispatch_turn:
+                bound_contracts = _merge_research_repair_contracts(
+                    getattr(agent, "_parallel_research_bound_artifacts", None),
+                    bound_contracts,
+                )
+            if bound_contracts:
+                agent._parallel_research_bound_artifacts = bound_contracts
+                agent._parallel_research_bound_paths = tuple(
+                    contract.path for contract in bound_contracts
+                )
+                agent._parallel_research_dispatch_succeeded = True
+                agent._parallel_research_pending_delegation_id = str(
+                    payload["delegation_id"]
+                ).strip()
+                if post_dispatch_turn:
+                    agent._parallel_research_repair_dispatch_count = 1
+                lifecycle_authenticated = True
+    if lifecycle_authenticated and isinstance(tool_call_id, str) and tool_call_id:
+        authenticated_ids = getattr(
+            agent, "_parallel_research_authenticated_lifecycle_ids", None
+        )
+        if not isinstance(authenticated_ids, set):
+            authenticated_ids = set()
+            agent._parallel_research_authenticated_lifecycle_ids = authenticated_ids
+        authenticated_ids.add(tool_call_id)
+        auth_token = object()
+        authenticated_tokens = getattr(
+            agent,
+            "_parallel_research_authenticated_lifecycle_tokens",
+            None,
+        )
+        if not isinstance(authenticated_tokens, set):
+            authenticated_tokens = set()
+            agent._parallel_research_authenticated_lifecycle_tokens = (
+                authenticated_tokens
+            )
+        authenticated_tokens.add(auth_token)
+        pending_auth = getattr(agent, "_parallel_research_pending_lifecycle_auth", None)
+        if not isinstance(pending_auth, list):
+            pending_auth = []
+            agent._parallel_research_pending_lifecycle_auth = pending_auth
+        pending_auth.append(
+            {
+                "tool_call_id": tool_call_id,
+                "name": tool_name,
+                "args_sha256": _repair_call_fingerprint(args),
+                "args": copy.deepcopy(dict(args)) if isinstance(args, Mapping) else {},
+                "result": copy.deepcopy(result),
+                "token": auth_token,
+            }
+        )
+    controller = get_research_controller(agent)
+    if controller is not None and _is_retrieval_tool(tool_name):
+        result = _filter_retrieval_result_for_source_policy(
+            tool_name,
+            result,
+            controller.contract.source_policy_id,
+        )
+    try:
+        from agent.research_synthesis import record_parent_research_artifact_read
+
+        result = record_parent_research_artifact_read(
+            agent, tool_name, args, result, failed=failed
+        )
+    except Exception:
+        # Read accounting is a delivery gate, not a tool-execution dependency.
+        # Any accounting failure remains fail-closed at synthesis validation.
+        pass
+    if controller is not None:
+        feedback = controller.after_call(tool_name, args, result, failed=failed)
+        if feedback is not None:
+            return _attach_write_feedback(result, feedback)
+        if tool_name == "web_extract":
+            return _sanitize_contracted_extract_cache_hints(result)
+    return result
+

+"""Controller-owned research sealing, separate from ordinary turn finalization.
+
+Ported from the deployed B70 research contracts. Required validation precedes
+persistence and delivery; observer hooks receive copies and cannot approve output.
+"""
+from __future__ import annotations
+import copy
+import json
+import os
+from dataclasses import dataclass
+
+@dataclass(frozen=True)
+class ResearchFinalization:
+    immutable: bool
+    clear_state: bool
+
+    def finish(self, agent):
+        from agent.conversation_loop import logger
+        if self.clear_state:
+            try:
+                from agent.research_contract import clear_parallel_research_state
+
+                clear_parallel_research_state(agent)
+            except Exception:
+                logger.warning(
+                    "failed to clear terminal parallel-research state",
+                    exc_info=True,
+                )
+        else:
+            agent._parallel_research_quarantine_turn_id = None
+            agent._parallel_research_quarantine_delegation_id = None
+            agent._parallel_research_quarantine_clear_state = False
+            agent._parallel_research_wave_conflict_turn_id = None
+
+        agent._parallel_research_retry_block_turn_id = None
+        agent._travel_publication_route_turn_id = None
+        agent._product_research_route_turn_id = None
+        agent._product_research_restart_resume_turn_id = None
+        agent._product_research_receipt_turn_id = None
+        agent._product_research_receipt_sources = ()

+def _cli_facet_synthesis_prepare(
+    spec_path: Path,
+    row_root: Path,
+    output_root: Path,
+    model: str,
+    canary_id: str | None,
+) -> int:
+    """Prepare three isolated synthesis requests over one immutable row store."""
+
+    if output_root.exists() or output_root.is_symlink():
+        raise ReferenceStoreError("facet synthesis preparation output root already exists")
+    spec = validate_spec(
+        _json_no_duplicates(spec_path.read_text(encoding="utf-8"), label="spec")
+    )
+    row_path = row_root / "evidence-rows.json"
+    row_store = _json_no_duplicates(
+        row_path.read_text(encoding="utf-8"), label="row store"
+    )
+    rows = row_store.get("rows") if isinstance(row_store, Mapping) else None
+    if (
+        row_store.get("schema_version") != SCHEMA_VERSION
+        or row_store.get("kind") != ROWS_KIND
+        or not isinstance(rows, list)
+        or not rows
+    ):
+        raise ReferenceStoreError("facet synthesis preparation row store is invalid")
+    prepared: list[dict[str, Any]] = []
+    payloads: list[tuple[str, str, dict[str, Any]]] = []
+    for facet in spec["facets"]:
+        marker = facet["marker"]
+        facet_rows = [row for row in rows if row.get("facet") == marker]
+        prompt = build_facet_synthesis_prompt(spec, facet_rows, marker)
+        request = build_facet_synthesis_request(
+            prompt, model=model, canary_id=canary_id
+        )
+        payloads.append((marker, prompt, request))
+    output_root.mkdir(parents=True)
+    for marker, prompt, request in payloads:
+        facet_root = output_root / marker
+        facet_root.mkdir()
+        _write_new(facet_root / "synthesis-prompt.txt", prompt.encode("utf-8"))
+        write_new_json(facet_root / "synthesis-request.json", request)
+        prepared.append(
+            {
+                "facet": marker,
+                "prompt_sha256": sha256_file(facet_root / "synthesis-prompt.txt"),
+                "request_sha256": sha256_file(facet_root / "synthesis-request.json"),
+            }
+        )
+    write_new_json(
+        output_root / "facet-synthesis-preparation.json",
+        {
+            "schema_version": SCHEMA_VERSION,
+            "kind": "hermes-reference-store-facet-synthesis-preparation",
+            "spec_sha256": sha256_file(spec_path),
+            "row_store_sha256": sha256_file(row_path),
+            "facets": prepared,

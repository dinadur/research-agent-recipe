+def build_facet_synthesis_repair_prompt(
+    original_prompt: str,
+    validation_error: str,
+) -> str:
+    """Bind one retry to a controller-produced validation failure."""
+
+    if (
+        not isinstance(original_prompt, str)
+        or len(original_prompt) < 300
+        or not isinstance(validation_error, str)
+        or not 1 <= len(validation_error) <= 500
+        or any(ord(character) < 32 for character in validation_error)
+    ):
+        raise ReferenceStoreError("facet repair prompt inputs are invalid")
+    return (
+        original_prompt
+        + "\n<controller_validation_feedback>\n"
+        + "The prior answer was rejected by the deterministic controller: "
+        + validation_error
+        + " Return a fresh, complete JSON object that corrects this exact failure "
+        + "while preserving every original requirement. This is the only repair "
+        + "attempt, so omit a risky sentence rather than weakening its evidence "
+        + "binding.\n</controller_validation_feedback>\n"
+    )
+
+
+def build_synthesis_request(
+    prompt: str,
+    *,
+    model: str,
+    max_tokens: int = 2048,
+    canary_id: str | None = None,
+) -> dict[str, Any]:
+    if (
+        not isinstance(model, str)
+        or not model
+        or not 256 <= max_tokens <= 4096
+        or (
+            canary_id is not None
+            and (
+                not isinstance(canary_id, str)
+                or _CANARY_ID_RE.fullmatch(canary_id) is None
+            )
+        )
+    ):
+        raise ReferenceStoreError("synthesis request parameters are invalid")
+    system = (
+        "Produce concise evidence-bound research synthesis. Use only supplied "
+        "rows and return only the required JSON object."
+    )
+    if canary_id is not None:
+        system += (
+            f" Canary audit marker: {canary_id}. This marker is metadata, not evidence, "
+            "and must not appear in the answer."
+        )
+    return {
+        "model": model,
+        "messages": [
+            {
+                "role": "system",
+                "content": system,
+            },
+            {"role": "user", "content": prompt},
+        ],
+        "temperature": 0,
+        "max_tokens": max_tokens,
+        "stream": False,
+        "chat_template_kwargs": {"enable_thinking": False},
+    }
+
+
+def build_facet_synthesis_request(
+    prompt: str,
+    *,
+    model: str,
+    max_tokens: int = 1024,
+    canary_id: str | None = None,
+) -> dict[str, Any]:
+    """Use the same tool-free request boundary with a smaller output budget."""
+
+    return build_synthesis_request(
+        prompt,
+        model=model,
+        max_tokens=max_tokens,
+        canary_id=canary_id,
+    )

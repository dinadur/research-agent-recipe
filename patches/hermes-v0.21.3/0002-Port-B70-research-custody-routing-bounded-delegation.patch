+
+    repaired = candidate.replace("substantive near miss", "normalized content")
+    args, receipt = _successful_exact_write(
+        controller, repaired, task_id="repair-test"
+    )
+    feedback = controller.after_call("write_file", args, receipt, failed=False)
+    assert feedback is not None
+    assert feedback.status == "pass"
+    assert path.read_text(encoding="utf-8") == repaired

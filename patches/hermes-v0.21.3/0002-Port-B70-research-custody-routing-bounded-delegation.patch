+from __future__ import annotations
+
+import json
+from pathlib import Path
+
+import pytest
+
+from agent.research_harness.protocol import TravelRunRequest
+
+
+def _write_request_tree(tmp_path: Path) -> tuple[Path, Path, Path]:
+    raw_root = tmp_path / "vault" / "raw" / "travel"
+    raw_root.mkdir(parents=True)
+    manifest = raw_root / "topic-manifest.json"
+    manifest.write_text(
+        json.dumps(
+            {
+                "publication": {
+                    "owner": "destination",
+                    "slug": "topic",
+                    "page": "travel/destinations/topic.md",
+                    "title": "Topic",
+                    "page_type": "destination",
+                },
+                "records": [],
+            }
+        ),
+        encoding="utf-8",
+    )
+    run_dir = raw_root / "topic-run"
+    request_path = raw_root / "topic-request.json"
+    request_path.write_text(
+        json.dumps(
+            {
+                "schema_version": 1,
+                "domain": "travel",
+                "request_id": "telegram-20260720-topic",
+                "original_request": "Research Topic attractions and restaurants.",
+                "manifest_path": str(manifest),
+                "run_dir": str(run_dir),
+            }
+        ),
+        encoding="utf-8",
+    )
+    return raw_root, request_path, run_dir
+
+
+def test_request_file_resolves_only_controlled_paths(tmp_path: Path) -> None:
+    raw_root, request_path, run_dir = _write_request_tree(tmp_path)
+
+    request = TravelRunRequest.from_file(request_path, raw_root=raw_root)
+
+    assert request.domain == "travel"
+    assert request.manifest_path == raw_root / "topic-manifest.json"
+    assert request.run_dir == run_dir
+
+
+def test_request_rejects_unknown_fields(tmp_path: Path) -> None:
+    raw_root, request_path, _ = _write_request_tree(tmp_path)
+    value = json.loads(request_path.read_text(encoding="utf-8"))
+    value["controller_path"] = "/tmp/untrusted.py"
+    request_path.write_text(json.dumps(value), encoding="utf-8")
+
+    with pytest.raises(ValueError, match="unsupported field"):
+        TravelRunRequest.from_file(request_path, raw_root=raw_root)
+
+
+def test_request_rejects_manifest_outside_raw_root(tmp_path: Path) -> None:
+    raw_root, request_path, _ = _write_request_tree(tmp_path)
+    outside = tmp_path / "outside.json"
+    outside.write_text(json.dumps({"publication": {"owner": "x"}}), encoding="utf-8")
+    value = json.loads(request_path.read_text(encoding="utf-8"))
+    value["manifest_path"] = str(outside)
+    request_path.write_text(json.dumps(value), encoding="utf-8")
+
+    with pytest.raises(ValueError, match="must remain under"):
+        TravelRunRequest.from_file(request_path, raw_root=raw_root)
+
+
+def test_request_rejects_manifest_inside_output_directory(tmp_path: Path) -> None:
+    raw_root, request_path, run_dir = _write_request_tree(tmp_path)
+    run_dir.mkdir()
+    nested_manifest = run_dir / "manifest.json"
+    nested_manifest.write_text(
+        json.dumps({"publication": {"owner": "destination"}}),
+        encoding="utf-8",
+    )
+    value = json.loads(request_path.read_text(encoding="utf-8"))
+    value["manifest_path"] = str(nested_manifest)
+    request_path.write_text(json.dumps(value), encoding="utf-8")
+
+    with pytest.raises(ValueError, match="immutable input outside run_dir"):
+        TravelRunRequest.from_file(request_path, raw_root=raw_root)
+
+
+def test_request_rejects_nonempty_run_directory(tmp_path: Path) -> None:
+    raw_root, request_path, run_dir = _write_request_tree(tmp_path)
+    run_dir.mkdir()
+    (run_dir / "stale-receipt.json").write_text("{}\n", encoding="utf-8")
+
+    with pytest.raises(ValueError, match="new or empty"):
+        TravelRunRequest.from_file(request_path, raw_root=raw_root)
+
+
+def test_request_binds_explicit_canonical_target_from_full_page_path(
+    tmp_path: Path,
+) -> None:
+    raw_root, request_path, _ = _write_request_tree(tmp_path)
+    manifest_path = raw_root / "topic-manifest.json"
+    manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
+    manifest["publication"] = {
+        "owner": "operator-name",
+        "slug": "bar-harbor-july-2026",
+        "page": "travel/active/bar-harbor-july-2026/overview.md",
+        "title": "Bar Harbor July 2026 Trip Overview",
+        "page_type": "destination",
+        "category": "travel",
+    }
+    manifest_path.write_text(json.dumps(manifest), encoding="utf-8")
+    request = json.loads(request_path.read_text(encoding="utf-8"))
+    request["original_request"] = (
+        "Replace travel/active/bar-harbor-july-2026/overview.md with current "
+        "attractions and restaurants."
+    )
+    request_path.write_text(json.dumps(request), encoding="utf-8")
+
+    parsed = TravelRunRequest.from_file(request_path, raw_root=raw_root)
+
+    assert parsed.manifest_path == manifest_path
+
+
+def test_request_rejects_manifest_target_drift_from_explicit_path(
+    tmp_path: Path,
+) -> None:
+    raw_root, request_path, _ = _write_request_tree(tmp_path)
+    manifest_path = raw_root / "topic-manifest.json"
+    manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
+    manifest["publication"] = {
+        "owner": "destinations",
+        "slug": "bar-harbor-july-2026",
+        "page": "overview",
+        "title": "Bar Harbor July 2026",
+        "page_type": "destination",
+        "category": None,
+    }
+    manifest_path.write_text(json.dumps(manifest), encoding="utf-8")
+    request = json.loads(request_path.read_text(encoding="utf-8"))
+    request["original_request"] = (
+        "Replace travel/active/bar-harbor-july-2026/overview.md with current "
+        "attractions and restaurants."
+    )
+    request_path.write_text(json.dumps(request), encoding="utf-8")
+
+    with pytest.raises(ValueError, match="does not match explicit canonical target"):
+        TravelRunRequest.from_file(request_path, raw_root=raw_root)

diff --git a/plugins/web/tavily/direct_extract.py b/plugins/web/tavily/direct_extract.py
new file mode 100644
index 000000000..43d41ceee
--- /dev/null
+++ b/plugins/web/tavily/direct_extract.py
@@ -0,0 +1,302 @@
+"""Bounded direct text fallback and recency-page extraction for Tavily."""
+from __future__ import annotations
+import logging
+import re
+from html.parser import HTMLParser
+from typing import Any, Dict, List
+from urllib.parse import unquote, urlsplit
+from tools.url_safety import is_safe_url, redirect_target_from_response
+from tools.website_policy import check_website_access
+logger = logging.getLogger(__name__)
+
+_DIRECT_EXTRACT_MAX_BYTES = 5 * 1024 * 1024
+_DIRECT_EXTRACT_CONTENT_TYPES = frozenset(
+    {
+        "application/json",
+        "application/xhtml+xml",
+        "text/html",
+        "text/markdown",
+        "text/plain",
+        "text/x-markdown",
+    }
+)
+_HTML_BLOCK_TAGS = frozenset(
+    {
+        "article",
+        "blockquote",
+        "br",
+        "dd",
+        "div",
+        "dl",
+        "dt",
+        "figcaption",
+        "footer",
+        "h1",
+        "h2",
+        "h3",
+        "h4",
+        "h5",
+        "h6",
+        "header",
+        "li",
+        "main",
+        "nav",
+        "ol",
+        "p",
+        "pre",
+        "section",
+        "table",
+        "td",
+        "th",
+        "tr",
+        "ul",
+    }
+)
+_HTML_IGNORED_TAGS = frozenset({"script", "style", "noscript", "svg"})
+
+
+class _ReadableHTMLParser(HTMLParser):
+    def __init__(self) -> None:
+        super().__init__(convert_charrefs=True)
+        self.parts: list[str] = []
+        self.title_parts: list[str] = []
+        self._ignored_depth = 0
+        self._title_depth = 0
+
+    def handle_starttag(
+        self, tag: str, attrs: list[tuple[str, str | None]]
+    ) -> None:
+        normalized = tag.casefold()
+        if normalized in _HTML_IGNORED_TAGS:
+            self._ignored_depth += 1
+            return
+        if self._ignored_depth:
+            return
+        if normalized == "title":
+            self._title_depth += 1
+        if normalized in _HTML_BLOCK_TAGS:
+            self.parts.append("\n")
+
+    def handle_endtag(self, tag: str) -> None:
+        normalized = tag.casefold()
+        if normalized in _HTML_IGNORED_TAGS:
+            self._ignored_depth = max(0, self._ignored_depth - 1)
+            return
+        if self._ignored_depth:
+            return
+        if normalized == "title":
+            self._title_depth = max(0, self._title_depth - 1)
+        if normalized in _HTML_BLOCK_TAGS:
+            self.parts.append("\n")
+
+    def handle_data(self, data: str) -> None:
+        if self._ignored_depth or not data:
+            return
+        self.parts.append(data)
+        if self._title_depth:
+            self.title_parts.append(data)
+
+    def document(self) -> tuple[str, str]:
+        raw = "".join(self.parts)
+        lines = [
+            re.sub(r"[^\S\r\n]+", " ", line).strip()
+            for line in raw.splitlines()
+        ]
+        content = "\n".join(line for line in lines if line)
+        title = " ".join("".join(self.title_parts).split())
+        return title, content
+
+
+def _github_raw_url(url: str) -> str:
+    """Use GitHub's exact raw file endpoint for blob URLs."""
+
+    try:
+        parts = urlsplit(url)
+    except ValueError:
+        return url
+    if parts.hostname not in {"github.com", "www.github.com"}:
+        return url
+    segments = parts.path.split("/")
+    if len(segments) < 6 or segments[3] != "blob":
+        return url
+    owner, repository, revision = segments[1], segments[2], segments[4]
+    path = "/".join(segments[5:])
+    if not all((owner, repository, revision, path)):
+        return url
+    return (
+        f"https://raw.githubusercontent.com/{owner}/{repository}/"
+        f"{revision}/{path}"
+    )
+
+
+# Route recency-sensitive URLs around the provider cache.
+#
+# Measured 2026-08-21, same URL and same moment: Tavily's /extract returned
+# llama.cpp release tags b10456/b10455 - four days stale - while a direct fetch
+# of the same page returned b10549/b10545. Hermes reported the stale tag with a
+# perfect citation, because every custody check passed: the URL was right and
+# the quote was exact. The receipt system proves a URL was RETRIEVED, never that
+# its content was CURRENT.
+#
+# Tavily cannot help: /extract has no cache or freshness parameter and returns
+# no timestamp, cache-age or crawl-date field, so staleness cannot be detected,
+# only avoided.
+#
+# This is deliberately NARROW. Direct extraction returned 26,587 chars against
+# Tavily's 135,115 on the same page, so Tavily extracts more thoroughly and
+# routing everything direct would trade coverage for freshness everywhere. The
+# failure mode is specifically "what is the current version of X", and those
+# pages live at predictable path shapes.
+DIRECT_EXTRACT_FOR_RECENCY_URLS = True
+
+_RECENCY_SENSITIVE_PATH_MARKERS = (
+    "/releases",
+    "/release-notes",
+    "/changelog",
+    "/changelogs",
+    "/tags",
+    "/whatsnew",
+    "/what-s-new",
+    "/news",
+)
+
+
+def _is_recency_sensitive_url(url: str) -> bool:
+    """True when a page's whole value is being current.
+
+    Matches on the path only, so a query string or a host that merely contains
+    one of these words does not trigger it.
+    """
+    if not isinstance(url, str) or not url:
+        return False
+    try:
+        from urllib.parse import urlparse
+
+        path = (urlparse(url).path or "").lower().rstrip("/")
+    except Exception:
+        return False
+    if not path:
+        return False
+    return any(
+        path == marker or path.startswith(marker + "/") or path.endswith(marker)
+        or marker + "/" in path
+        for marker in _RECENCY_SENSITIVE_PATH_MARKERS
+    )
+
+
+def _direct_extract_document(url: str) -> Dict[str, Any]:
+    """Fetch one public text page when Tavily's extract capacity is exhausted."""
+
+    import httpx
+
+    fetch_url = _github_raw_url(url)
+    for candidate in (url, fetch_url):
+        if not is_safe_url(candidate):
+            raise ValueError("Blocked: URL targets a private or internal address")
+        blocked = check_website_access(candidate)
+        if blocked:
+            raise ValueError(blocked["message"])
+
+    def _redirect_guard(response: Any) -> None:
+        redirect_url = redirect_target_from_response(response)
+        if not redirect_url:
+            return
+        if not is_safe_url(redirect_url):
+            raise ValueError(
+                f"Blocked redirect to private/internal address: {redirect_url}"
+            )
+        blocked = check_website_access(redirect_url)
+        if blocked:
+            raise ValueError(blocked["message"])
+
+    headers = {
+        "Accept": (
+            "text/html,application/xhtml+xml,text/plain,text/markdown,"
+            "application/json;q=0.8"
+        ),
+        # httpx's optional brotlicffi streaming decoder can fail on otherwise
+        # valid Brotli responses. Match the existing Skills Hub mitigation and
+        # ask the origin for gzip (or an uncompressed response) instead.
+        "Accept-Encoding": "gzip",
+        "User-Agent": "Hermes-Agent/1.0 direct-extract-fallback",
+    }
+    with httpx.Client(
+        follow_redirects=True,
+        timeout=30,
+        headers=headers,
+        event_hooks={"response": [_redirect_guard]},
+    ) as client:
+        with client.stream("GET", fetch_url) as response:
+            response.raise_for_status()
+            final_url = str(response.url)
+            if not is_safe_url(final_url):
+                raise ValueError(
+                    "Blocked: final URL targets a private or internal address"
+                )
+            final_blocked = check_website_access(final_url)
+            if final_blocked:
+                raise ValueError(final_blocked["message"])
+            content_type = response.headers.get("content-type", "")
+            media_type = content_type.split(";", 1)[0].strip().casefold()
+            if media_type not in _DIRECT_EXTRACT_CONTENT_TYPES:
+                raise ValueError(
+                    f"Unsupported direct-extract content type: {media_type or 'unknown'}"
+                )
+            chunks: list[bytes] = []
+            size = 0
+            for chunk in response.iter_bytes():
+                size += len(chunk)
+                if size > _DIRECT_EXTRACT_MAX_BYTES:
+                    raise ValueError("Direct-extract response exceeded 5 MiB")
+                chunks.append(chunk)
+            encoding = response.encoding or "utf-8"
+            decoded = b"".join(chunks).decode(encoding, errors="replace")
+
+    title = ""
+    if media_type in {"text/html", "application/xhtml+xml"}:
+        parser = _ReadableHTMLParser()
+        parser.feed(decoded)
+        parser.close()
+        title, content = parser.document()
+    else:
+        content = decoded.strip()
+        title = unquote(urlsplit(url).path.rsplit("/", 1)[-1])
+    if not content:
+        raise ValueError("Direct-extract returned no readable text")
+    return {
+        "url": url,
+        "title": title,
+        "content": content,
+        "raw_content": content,
+        "metadata": {
+            "sourceURL": url,
+            "fetchedURL": final_url,
+            "title": title,
+            "extractor": "direct-http-fallback",
+        },
+    }
+
+
+def _direct_extract_documents(urls: List[str]) -> List[Dict[str, Any]]:
+    documents: List[Dict[str, Any]] = []
+    for url in urls:
+        try:
+            documents.append(_direct_extract_document(url))
+        except Exception as exc:  # noqa: BLE001 - per-URL typed failure
+            logger.warning("Direct extract fallback failed for %s: %s", url, exc)
+            documents.append(
+                {
+                    "url": url,
+                    "title": "",
+                    "content": "",
+                    "raw_content": "",
+                    "error": (
+                        "Tavily extract capacity unavailable (HTTP 432); "
+                        f"direct fallback failed: {exc}"
+                    ),
+                    "metadata": {"sourceURL": url},
+                }
+            )
+    return documents
+
+

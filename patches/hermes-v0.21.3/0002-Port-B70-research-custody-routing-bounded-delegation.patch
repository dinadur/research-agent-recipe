+def _cli_plan(
+    input_path: Path,
+    output_root: Path,
+    model: str,
+    canary_id: str | None,
+) -> int:
+    if output_root.exists() or output_root.is_symlink():
+        raise ReferenceStoreError("planning output root already exists")
+    planning_input = _json_no_duplicates(
+        input_path.read_text(encoding="utf-8"), label="planning input"
+    )
+    prompt = build_planning_prompt(planning_input)
+    request = build_planning_request(
+        prompt,
+        model=model,
+        canary_id=canary_id,
+    )
+    output_root.mkdir(parents=True)
+    _write_new(output_root / "planning-prompt.txt", prompt.encode("utf-8"))
+    write_new_json(output_root / "planning-request.json", request)
+    return 0
+
+
+def _cli_plan_finalize(
+    input_path: Path,
+    response_path: Path,
+    output_root: Path,
+) -> int:
+    if output_root.exists() or output_root.is_symlink():
+        raise ReferenceStoreError("planning finalization output root already exists")
+    planning_input = _json_no_duplicates(
+        input_path.read_text(encoding="utf-8"), label="planning input"
+    )
+    response = _json_no_duplicates(
+        response_path.read_text(encoding="utf-8"), label="planning HTTP response"
+    )
+    validation = validate_planning_response(response, planning_input)
+    spec = build_spec_from_planning(planning_input, validation)
+    output_root.mkdir(parents=True)
+    write_new_json(output_root / "planning-validation.json", validation)
+    write_new_json(output_root / "reference-store-spec.json", spec)
+    manifest = {
+        "schema_version": SCHEMA_VERSION,
+        "kind": "hermes-reference-store-planning-finalization",
+        "planning_input_sha256": sha256_file(input_path),
+        "response_sha256": sha256_file(response_path),
+        "planning_validation_sha256": sha256_file(
+            output_root / "planning-validation.json"
+        ),
+        "spec_sha256": sha256_file(output_root / "reference-store-spec.json"),
+        "production_promotion_authorized": False,
+    }
+    write_new_json(output_root / "planning-finalization.json", manifest)
+    return 0

+"""Bounded independent groundedness-judge regressions."""
+
+from __future__ import annotations
+
+from types import SimpleNamespace
+
+from agent import product_groundedness
+
+
+def _agent() -> SimpleNamespace:
+    return SimpleNamespace(
+        _product_research_groundedness_config={
+            "enabled": True,
+            "base_url": "http://127.0.0.1:8318/v1",
+            "model": "granite-guardian-4.1-8b-q4km-sycl",
+            "api_key": "local-judge",
+            "timeout": 4,
+            "max_retries": 1,
+            "max_claims": 12,
+        }
+    )
+
+
+def _claims():
+    return ({
+        "line": 4,
+        "claim": "The unit includes app control.",
+        "evidence": ({
+            "url": "https://vendor.example/product",
+            "quote": "Control the unit from the Vendor mobile app.",
+        },),
+    },)
+
+
+def _body(score: str) -> dict:
+    return {"choices": [{"message": {"content": f"<score>{score}</score>"}}]}
+
+
+def test_guardian_yes_passes_and_uses_byoc_no_think_protocol(monkeypatch):
+    seen = []
+
+    def post(url, payload, headers, timeout):
+        seen.append((url, payload, headers, timeout))
+        return _body("yes")
+
+    monkeypatch.setattr(product_groundedness, "_post_guardian", post)
+
+    passed, reason, failures = product_groundedness.evaluate_product_claims(
+        _agent(), _claims()
+    )
+
+    assert (passed, reason, failures) == (True, "passed", ())
+    assert seen[0][0] == "http://127.0.0.1:8318/v1/chat/completions"
+    assert "<guardian><no-think>" in seen[0][1]["messages"][-1]["content"]
+    assert seen[0][1]["temperature"] == 0
+
+
+def test_guardian_no_returns_exact_failed_claim_without_retry(monkeypatch):
+    calls = 0
+
+    def post(*_args):
+        nonlocal calls
+        calls += 1
+        return _body("no")
+
+    monkeypatch.setattr(product_groundedness, "_post_guardian", post)
+    agent = _agent()
+
+    passed, reason, failures = product_groundedness.evaluate_product_claims(
+        agent, _claims()
+    )
+
+    assert passed is False
+    assert reason == "claim_evidence_ungrounded"
+    assert failures[0]["claim"] == "The unit includes app control."
+    assert calls == 1
+    assert agent._product_research_groundedness_judge_status["failures"] == 1
+
+
+def test_guardian_transport_error_retries_once_then_fails_closed(monkeypatch):
+    calls = 0
+
+    def post(*_args):
+        nonlocal calls
+        calls += 1
+        raise TimeoutError("judge stalled")
+
+    monkeypatch.setattr(product_groundedness, "_post_guardian", post)
+
+    passed, reason, failures = product_groundedness.evaluate_product_claims(
+        _agent(), _claims()
+    )
+
+    assert (passed, reason, failures) == (
+        False,
+        "semantic_judge_unavailable",
+        (),
+    )
+    assert calls == 2
+
+
+def test_guardian_malformed_score_retries_once_then_fails_closed(monkeypatch):
+    responses = [
+        {"choices": [{"message": {"content": "maybe"}}]},
+        {"choices": [{"message": {"content": "<score>yes</score>"}}]},
+    ]
+
+    monkeypatch.setattr(
+        product_groundedness,
+        "_post_guardian",
+        lambda *_args: responses.pop(0),
+    )
+
+    assert product_groundedness.evaluate_product_claims(
+        _agent(), _claims()
+    ) == (True, "passed", ())
+
+
+def test_disabled_judge_is_a_noop(monkeypatch):
+    agent = _agent()
+    agent._product_research_groundedness_config["enabled"] = False
+    monkeypatch.setattr(
+        product_groundedness,
+        "_post_guardian",
+        lambda *_args: (_ for _ in ()).throw(AssertionError("must not call")),
+    )
+
+    assert product_groundedness.evaluate_product_claims(agent, _claims()) == (
+        True,
+        "groundedness_judge_disabled",
+        (),
+    )
+
+
+def test_claim_set_size_has_a_distinct_bounded_reason(monkeypatch):
+    monkeypatch.setattr(
+        product_groundedness,
+        "_post_guardian",
+        lambda *_args: (_ for _ in ()).throw(AssertionError("must not call")),
+    )
+    agent = _agent()
+    claims = _claims() * 13
+
+    assert product_groundedness.evaluate_product_claims(agent, claims) == (
+        False,
+        "semantic_claim_set_too_large",
+        (),
+    )
+    assert agent._product_research_groundedness_judge_status == {
+        "reason": "semantic_claim_set_too_large",
+        "claims_checked": 13,
+        "max_claims": 12,
+        "model_judged": 0,
+        "request_attempts": 0,
+    }
+    assert product_groundedness.evaluate_product_claims(agent, ()) == (
+        False,
+        "semantic_claim_set_invalid",
+        (),
+    )
+
+
+def test_verbatim_entity_label_uses_deterministic_short_circuit(monkeypatch):
+    agent = _agent()
+    monkeypatch.setattr(
+        product_groundedness,
+        "_post_guardian",
+        lambda *_args: (_ for _ in ()).throw(AssertionError("must not call")),
+    )
+    claims = ({
+        "line": 8,
+        "claim": "Shark PowerDetect Clean & Empty System",
+        "evidence": ({
+            "url": "https://review.example/vacuum",
+            "quote": (
+                "Shark's Cordless PowerDetect Clean & Empty System is a "
+                "versatile vacuum."
+            ),
+        },),
+    },)
+
+    assert product_groundedness.evaluate_product_claims(agent, claims) == (
+        True,
+        "passed",
+        (),
+    )
+    assert agent._product_research_groundedness_judge_status["model_judged"] == 0

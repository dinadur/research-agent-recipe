@@ -0,0 +1,153 @@
+from __future__ import annotations
+
+import json
+from pathlib import Path
+
+from agent.research_harness.artifacts import load_json_object, sha256_file
+from agent.research_harness.protocol import TRAVEL_RUN_RESULT_NAME, TravelRunRequest
+from agent.research_harness.travel_runner import (
+    ACCEPTED_TRAVEL_SKILL_VERSION,
+    accepted_controller_status,
+    run_travel_request,
+)
+
+
+def _request(tmp_path: Path) -> TravelRunRequest:
+    raw_root = tmp_path / "vault" / "raw" / "travel"
+    raw_root.mkdir(parents=True)
+    manifest = raw_root / "manifest.json"
+    manifest.write_text(
+        json.dumps({"publication": {"owner": "destination"}}),
+        encoding="utf-8",
+    )
+    return TravelRunRequest.from_mapping(
+        {
+            "schema_version": 1,
+            "domain": "travel",
+            "request_id": "runner-test",
+            "original_request": "Research a destination.",
+            "manifest_path": str(manifest),
+            "run_dir": str(raw_root / "run"),
+        },
+        raw_root=raw_root,
+    )
+
+
+def _fake_controller(
+    tmp_path: Path,
+    body: str,
+    *,
+    version: str = ACCEPTED_TRAVEL_SKILL_VERSION,
+) -> Path:
+    skill = tmp_path / "travel-planning"
+    scripts = skill / "scripts"
+    scripts.mkdir(parents=True)
+    (skill / "SKILL.md").write_text(
+        f"---\nname: travel-planning\nversion: {version}\n---\n",
+        encoding="utf-8",
+    )
+    controller = scripts / "run_hermes_travel_pipeline.py"
+    controller.write_text(body, encoding="utf-8")
+    return controller
+
+
+def test_runner_executes_real_child_and_writes_ready_result(tmp_path: Path) -> None:
+    request = _request(tmp_path)
+    controller = _fake_controller(
+        tmp_path,
+        """from pathlib import Path
+import json, sys
+run_dir = Path(sys.argv[2])
+run_dir.mkdir(parents=True, exist_ok=True)
+(run_dir / 'run-report.json').write_text(json.dumps({'pass': True, 'included_records': 2}))
+(run_dir / 'publication-receipt.json').write_text(json.dumps({'receipt_version': 3}))
+print('TRAVEL_RESEARCH_READY receipt_sha256=' + '0' * 64 + ' approval_sha256=' + '1' * 64)
+""",
+    )
+
+    result, completed = run_travel_request(
+        request,
+        controller=controller,
+        expected_controller_sha256=sha256_file(controller),
+    )
+
+    assert completed.returncode == 0
+    assert result.status == "ready_for_approval"
+    persisted = load_json_object(request.run_dir / TRAVEL_RUN_RESULT_NAME)
+    assert persisted["request_id"] == request.request_id
+    assert persisted["receipt_path"].endswith("publication-receipt.json")
+    assert len(persisted["controller_sha256"]) == 64
+
+
+def test_runner_classifies_integrity_rejection_as_withheld(tmp_path: Path) -> None:
+    request = _request(tmp_path)
+    controller = _fake_controller(
+        tmp_path,
+        """from pathlib import Path
+import json, sys
+run_dir = Path(sys.argv[2])
+run_dir.mkdir(parents=True, exist_ok=True)
+(run_dir / 'run-report.json').write_text(json.dumps({'pass': False, 'errors': ['unsafe']}))
+raise SystemExit(3)
+""",
+    )
+
+    result, completed = run_travel_request(
+        request,
+        controller=controller,
+        expected_controller_sha256=sha256_file(controller),
+    )
+
+    assert completed.returncode == 3
+    assert result.status == "withheld"
+    assert result.receipt_path is None
+
+
+def test_runner_fails_closed_on_unaccepted_skill_version(tmp_path: Path) -> None:
+    request = _request(tmp_path)
+    controller = _fake_controller(
+        tmp_path,
+        "raise AssertionError('must not execute')\n",
+        version="9.9.9",
+    )
+
+    result, completed = run_travel_request(
+        request,
+        controller=controller,
+        expected_controller_sha256=sha256_file(controller),
+    )
+
+    assert completed.returncode == 2
+    assert result.status == "failed"
+    assert result.error is not None
+    assert "version mismatch" in result.error
+
+
+def test_runner_fails_closed_on_unaccepted_controller_hash(tmp_path: Path) -> None:
+    request = _request(tmp_path)
+    controller = _fake_controller(
+        tmp_path,
+        "raise AssertionError('must not execute')\n",
+    )
+
+    result, completed = run_travel_request(request, controller=controller)
+
+    assert completed.returncode == 2
+    assert result.status == "failed"
+    assert result.error is not None
+    assert "hash mismatch" in result.error
+
+
+def test_installed_controller_matches_accepted_pin() -> None:
+    import os
+    # Maintenance copies only these two pinned public skill files into the
+    # isolated environment; tests never need access to private Hermes state.
+    pin_root = os.environ.get("B70_MIGRATION_TRAVEL_PIN") or str(Path(__file__).resolve().parents[3] / "travel-pin")
+    controller = (Path(pin_root) if pin_root else Path.home() / ".hermes" / "skills" / "travel-planning") / "scripts" / "run_hermes_travel_pipeline.py"
+    status = accepted_controller_status(controller=controller)
+
+    assert status["pass"] is True
+    assert status["actual_skill_version"] == ACCEPTED_TRAVEL_SKILL_VERSION
+    assert status["actual_controller_sha256"] == status[
+        "expected_controller_sha256"
+    ]

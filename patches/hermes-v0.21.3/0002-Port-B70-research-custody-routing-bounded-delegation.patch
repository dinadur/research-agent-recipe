+def _product_research_durable_comparison_mode(original_request: Any) -> bool:
+    """Classify a neutral exact-product comparison from clean operator prose."""
+
+    if not isinstance(original_request, str) or not original_request.strip():
+        return False
+    if _DURABLE_COMPARISON_MODE_RE.search(original_request):
+        return True
+    if _PRODUCT_COMMERCE_INTENT_RE.search(original_request):
+        return False
+    return bool(
+        len(_durable_comparison_target_labels(original_request)) >= 2
+        and _DURABLE_PRODUCT_SIGNAL_RE.search(original_request)
+    )
+

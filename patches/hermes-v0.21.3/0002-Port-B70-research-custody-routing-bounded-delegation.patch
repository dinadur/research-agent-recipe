+
+def _product_site_recovery_query(url: str) -> str | None:
+    parts = urlsplit(url)
+    host = (parts.hostname or "").casefold().removeprefix("www.")
+    if not host:
+        return None
+    path_terms = re.sub(r"[^a-z0-9]+", " ", parts.path.casefold()).strip()
+    if not path_terms:
+        path_terms = host.split(".", 1)[0]
+    return f"site:{host} {path_terms}"[:240]
+
+
+def apply_product_research_extract_provenance_recovery(
+    agent: Any, tool_calls: Any, messages: Any
+) -> tuple[list[Any], dict[str, Any] | None]:
+    """Repair one model-invented extraction call before it is persisted.
+
+    Product receipts deliberately require exact search-to-extract provenance.
+    Small local models occasionally remember a plausible first-party path
+    instead of copying the URL returned by search. The model may also batch that
+    bad call beside a valid extraction call. When exactly one extraction call
+    in an otherwise valid extraction batch contains an unsupported URL, replace
+    only that call with one site-scoped search. The normal three-search schema
+    remains closed; only this one controller-owned repair may execute a fourth
+    search. A later receipt-recovery pass can then extract the exact returned
+    official URL.
+
+    After the one-shot repair is consumed, any further unsupported URL is
+    replaced with eligible URLs actually returned by search. This prevents a
+    bad path from poisoning an otherwise valid receipt without weakening the
+    receipt's provenance rule. Ambiguous batches with more than one unsupported
+    extraction call remain unchanged and fail closed at the receipt.
+    """
+
+    calls = list(tool_calls) if isinstance(tool_calls, (list, tuple)) else []
+    turn_id = getattr(agent, "_current_turn_id", None)
+    if not (
+        product_research_initial_turn_active(agent)
+        and getattr(agent, "api_mode", "chat_completions") == "chat_completions"
+        and calls
+        and isinstance(messages, (list, tuple))
+    ):
+        return calls, None
+
+    current_messages = _product_current_turn_messages(messages)
+    batches = _product_search_url_batches(current_messages)
+    discovered: dict[str, str] = {}
+    for batch in batches:
+        for url in batch:
+            discovered.setdefault(_canonical_url(url), url)
+    if not discovered:
+        return calls, None
+
+    unsupported_calls: list[tuple[int, list[str], list[str]]] = []
+    for index, call in enumerate(calls):
+        name, arguments = _product_tool_call_name_arguments(call)
+        requested = arguments.get("urls") if arguments is not None else None
+        if name != "web_extract" or not isinstance(requested, list) or not requested:
+            # A multi-call recovery is deliberately limited to a homogeneous
+            # extraction batch. Do not rewrite around terminal or other tools.
+            return calls, None
+
+        valid: list[str] = []
+        unsupported: list[str] = []
+        for value in requested:
+            url = _safe_product_https_url(value)
+            if url is None or _canonical_url(url) not in discovered:
+                if isinstance(value, str):
+                    unsupported.append(value)
+                continue
+            valid.append(discovered[_canonical_url(url)])
+        if unsupported:
+            unsupported_calls.append((index, valid, unsupported))
+
+    if len(unsupported_calls) != 1:
+        return calls, None
+    target_index, valid, unsupported = unsupported_calls[0]
+
+    successful = _product_successful_source_urls(current_messages)
+    recovery_already_used = (
+        getattr(agent, "_product_research_provenance_recovery_turn_id", None) == turn_id
+    )
+    safe_unsupported = next(
+        (
+            url
+            for value in unsupported
+            if (url := _safe_product_recovery_url(value)) is not None
+        ),
+        None,
+    )
+    if (
+        not recovery_already_used
+        and safe_unsupported is not None
+        and (len(successful) >= 2 or not valid)
+    ):
+        query = _product_site_recovery_query(safe_unsupported)
+        if query is not None:
+            function = getattr(calls[target_index], "function", None)
+            function.name = "web_search"
+            function.arguments = json.dumps(
+                {"query": query, "limit": 5},
+                ensure_ascii=False,
+                separators=(",", ":"),
+            )
+            agent._product_research_provenance_recovery_turn_id = turn_id
+            agent._product_research_provenance_recovery_pending_turn_id = turn_id
+            return calls, {
+                "mode": "site_search",
+                "unsupported_urls": len(unsupported),
+                "successful_sources": len(successful),
+            }
+
+    replacements = list(valid)
+    seen = {_canonical_url(url) for url in replacements} | successful
+    for batch in reversed(batches):
+        for value in batch:
+            url = _safe_product_recovery_url(value)
+            if url is None:
+                continue
+            canonical = _canonical_url(url)
+            if canonical in seen:
+                continue
+            replacements.append(url)
+            seen.add(canonical)
+            if len(replacements) >= PRODUCT_RESEARCH_RECOVERY_MAX_URLS:
+                break
+        if len(replacements) >= PRODUCT_RESEARCH_RECOVERY_MAX_URLS:
+            break
+    if not replacements:
+        return calls, None
+
+    function = getattr(calls[target_index], "function", None)
+    function.arguments = json.dumps(
+        {"urls": replacements}, ensure_ascii=False, separators=(",", ":")
+    )
+    return calls, {
+        "mode": "searched_url_substitution",
+        "unsupported_urls": len(unsupported),
+        "replacement_urls": len(replacements),
+        "successful_sources": len(successful),
+    }
+
+
+def apply_product_research_receipt_recovery(
+    agent: Any, tool_calls: Any, messages: Any
+) -> tuple[list[Any], dict[str, Any] | None]:
+    """Replace one premature terminal call with its missing final extraction.
+
+    This is deliberately narrower than a generic model retry. It activates only
+    for the live-proven state: exactly one completed extraction batch, a search
+    found additional eligible URLs including a search-proven manufacturer
+    candidate, and one extraction batch remains. The terminal call may be the
+    exact receipt or a malformed local detour; either is rewritten before
+    persistence, so it cannot consume or contaminate the one-shot receipt. If
+    no official candidate is available, leave the call untouched so source-mix
+    recovery can request the missing focused search instead of spending the
+    final extraction on more review pages.
+    """
+
+    calls = list(tool_calls) if isinstance(tool_calls, (list, tuple)) else []
+    turn_id = getattr(agent, "_current_turn_id", None)
+    if not (
+        product_research_initial_turn_active(agent)
+        and getattr(agent, "api_mode", "chat_completions") == "chat_completions"
+        and len(calls) == 1
+        and getattr(agent, "_product_research_receipt_recovery_turn_id", None)
+        != turn_id
+        and isinstance(messages, (list, tuple))
+    ):
+        return calls, None
+
+    name, arguments = _product_tool_call_name_arguments(calls[0])
+    if name != "terminal" or arguments is None:
+        return calls, None
+    terminal_reason = product_research_terminal_reason(agent, arguments)
+    unbound_receipt_command = (
+        arguments.get("command") in GENERIC_RESEARCH_RECEIPT_COMMANDS
+        and arguments.get("timeout") == 30
+        and arguments.get("background") in {None, False}
+        and not (set(arguments) - {"command", "timeout", "background"})
+    )
+
+    current_messages = _product_current_turn_messages(messages)
+
+    requested_urls: set[str] = set()
+    for message in current_messages:
+        if message.get("role") != "assistant":
+            continue
+        historical_calls = message.get("tool_calls")
+        if not isinstance(historical_calls, list):
+            continue
+        for historical_call in historical_calls:
+            if not isinstance(historical_call, Mapping):
+                continue
+            function = historical_call.get("function")
+            if (
+                not isinstance(function, Mapping)
+                or function.get("name") != "web_extract"
+            ):
+                continue
+            raw = function.get("arguments")
+            try:
+                parsed = json.loads(raw) if isinstance(raw, str) else None
+            except (TypeError, ValueError, json.JSONDecodeError):
+                parsed = None
+            urls = parsed.get("urls") if isinstance(parsed, Mapping) else None
+            if not isinstance(urls, list):
+                continue
+            for url in urls:
+                safe = _safe_product_recovery_url(url)
+                if safe is not None:
+                    requested_urls.add(_canonical_url(safe))
+
+    extract_count = 0
+    successful_sources: set[str] = set()
+    latest_extract_index = -1
+    for index, message in enumerate(current_messages):
+        if message.get("role") != "tool":
+            continue
+        tool_name = message.get("name") or message.get("tool_name")
+        if tool_name != "web_extract":
+            continue
+        extract_count += 1
+        latest_extract_index = index
+        payload = _tool_payload(message.get("content"))
+        results = payload.get("results") if isinstance(payload, Mapping) else None
+        if not isinstance(results, list):
+            continue
+        for result in results:
+            if not isinstance(result, Mapping) or result.get("error"):
+                continue
+            url = _safe_product_recovery_url(result.get("url"))
+            content = result.get("content")
+            if url is not None and isinstance(content, str) and content.strip():
+                successful_sources.add(_canonical_url(url))
+
+    if extract_count >= PRODUCT_RESEARCH_MAX_EXTRACT_CALLS and unbound_receipt_command:
+        function = getattr(calls[0], "function", None)
+        function.arguments = json.dumps(
+            {
+                "command": bound_product_research_receipt_command(
+                    str(getattr(agent, "session_id", "") or "")
+                ),
+                "timeout": 30,
+            },
+            ensure_ascii=False,
+            separators=(",", ":"),
+        )
+        return calls, {
+            "mode": "receipt_command_session_binding",
+            "extract_calls_before": extract_count,
+        }
+
+    if extract_count != 1:
+        return calls, None
+
+    post_extract_batches: list[list[str]] = []
+    for index, message in enumerate(current_messages):
+        if index <= latest_extract_index or message.get("role") != "tool":
+            continue
+        tool_name = message.get("name") or message.get("tool_name")
+        if tool_name != "web_search":
+            continue
+        payload = _tool_payload(message.get("content"))
+        data = payload.get("data") if isinstance(payload, Mapping) else None
+        web = data.get("web") if isinstance(data, Mapping) else None
+        if not isinstance(web, list):
+            continue
+        batch: list[str] = []
+        for result in web:
+            if not isinstance(result, Mapping):
+                continue
+            url = _safe_product_recovery_url(result.get("url"))
+            if url is not None:
+                batch.append(url)
+        if batch:
+            post_extract_batches.append(batch)
+
+    search_records = _product_search_query_records(current_messages)
+    focused_sources: set[str] = set()
+    focused_families: set[str] = set()
+    for query, urls in search_records:
+        for value in urls:
+            url = _safe_product_recovery_url(value)
+            if url is None or not _product_query_targets_source_host(query, url):
+                continue
+            focused_sources.add(_canonical_url(url))
+            focused_families.add(_product_source_family(url))
+
+    candidates: list[str] = []
+    seen = set(requested_urls) | successful_sources
+    seen_families = {_product_source_family(url) for url in successful_sources}
+    all_batches = _product_search_url_batches(current_messages)
+    ordered_batches = list(reversed(post_extract_batches)) + list(reversed(all_batches))
+    for batch in ordered_batches:
+        for value in batch:
+            url = _safe_product_recovery_url(value)
+            if url is None:
+                continue
+            canonical = _canonical_url(url)
+            family = _product_source_family(canonical)
+            if canonical in seen or not family or family in seen_families:
+                continue
+            candidates.append(url)
+            seen.add(canonical)
+            seen_families.add(family)
+    if not candidates:
+        return calls, None
+
+    mix = _product_source_mix_state(current_messages)
+    if not mix["brand_focused_sources"]:
+        official_index = next(
+            (
+                index
+                for index, url in enumerate(candidates)
+                if _canonical_url(url) in focused_sources
+                or _product_source_family(url) in focused_families
+            ),
+            None,
+        )
+        if official_index is None:
+            return calls, None
+        official = candidates.pop(official_index)
+        candidates.insert(0, official)
+    candidates = candidates[:PRODUCT_RESEARCH_RECOVERY_MAX_URLS]
+
+    function = getattr(calls[0], "function", None)
+    function.name = "web_extract"
+    function.arguments = json.dumps(
+        {"urls": candidates}, ensure_ascii=False, separators=(",", ":")
+    )
+    agent._product_research_receipt_recovery_turn_id = turn_id
+    details = {
+        "successful_sources": len(successful_sources),
+        "recovery_urls": len(candidates),
+        "extract_calls_before": extract_count,
+    }
+    if terminal_reason is not None:
+        details["replaced_terminal_detour"] = True
+    return calls, details
+
+
+def observe_product_research_tool_result(agent: Any, tool_name: str) -> None:
+    """Hide a retrieval tool after its final admitted call has executed.
+
+    Normalization happens before execution so an excess parallel sibling never
+    enters canonical history.  Exhaustion must happen after execution: hiding
+    the tool while the boundary call is still pending would make the executor
+    reject the valid third search or second extraction.
+    """
+
+    if not product_research_initial_turn_active(agent):
+        return
+    turn_id = getattr(agent, "_current_turn_id", None)
+    if tool_name == "web_search":
+        count = int(getattr(agent, "_product_research_search_call_count", 0) or 0) + 1
+        agent._product_research_search_call_count = count
+        if count >= PRODUCT_RESEARCH_MAX_SEARCH_CALLS:
+            agent._product_research_search_budget_exhausted_turn_id = turn_id
+        if (
+            getattr(
+                agent,
+                "_product_research_provenance_recovery_pending_turn_id",
+                None,
+            )
+            == turn_id
+        ):
+            agent._product_research_provenance_recovery_pending_turn_id = None
+    elif tool_name == "web_extract":
+        count = int(getattr(agent, "_product_research_extract_call_count", 0) or 0) + 1
+        agent._product_research_extract_call_count = count
+        if count >= PRODUCT_RESEARCH_MAX_EXTRACT_CALLS:
+            agent._product_research_extract_budget_exhausted_turn_id = turn_id
+
+
+def product_research_terminal_reason(
+    agent: Any, args: Mapping[str, Any] | None
+) -> str | None:
+    """Allow receipt on research turns or the exact publisher on approval."""
+
+    if not isinstance(args, Mapping):
+        return "Product research terminal arguments must be a JSON object."
+    if set(args) - {"command", "timeout", "background"}:
+        return (
+            "Product research terminal accepts only command, timeout, and background."
+        )
+    command = args.get("command")
+    if product_research_initial_turn_active(agent):
+        turn_id = getattr(agent, "_current_turn_id", None)
+        if (
+            getattr(
+                agent,
+                "_product_research_receipt_viability_failure_turn_id",
+                None,
+            )
+            == turn_id
+        ):
+            reasons = getattr(
+                agent,
+                "_product_research_receipt_viability_failure_reasons",
+                (),
+            )
+            reason_text = ", ".join(
+                str(reason) for reason in reasons if isinstance(reason, str)
+            )
+            return (
+                "The current-turn product source packet is not receipt-ready"
+                + (f" ({reason_text})." if reason_text else ".")
+            )
+        if not product_research_receipt_command_allowed(
+            command,
+            expected_session_id=str(getattr(agent, "session_id", "") or ""),
+        ):
+            return (
+                "The initial product turn permits only the current-turn receipt helper."
+            )
+    elif product_publication_approval_turn_active(agent):
+        if command != PRODUCT_RESEARCH_PUBLISH_COMMAND:
+            return "The approval turn permits only the exact product publisher."
+    else:
+        return "Product continuation turns expose no terminal capability without explicit publication approval."
+    if args.get("timeout") != 30 or args.get("background") not in {None, False}:
+        return "The product controller command must run once in the foreground at 30 seconds."
+    return None
+
+
+def _canonical_url(value: str) -> str:
+    # Inline-code wrapping is common in model-authored Markdown. A closing
+    # backtick is presentation punctuation, never part of a receipt URL.
+    parts = urlsplit(value.strip().rstrip("`.,;:!?"))
+    path = parts.path.rstrip("/") or "/"
+    return urlunsplit((
+        parts.scheme.lower(),
+        parts.netloc.lower(),
+        path,
+        parts.query,
+        "",
+    ))
+
+
+def _host(value: str) -> str:
+    return (urlsplit(value).hostname or "").lower().removeprefix("www.")
+
+
+def _product_source_family(value: str) -> str:
+    """Collapse subdomains to the independently controlled source family."""
+
+    labels = [label for label in _host(value).split(".") if label]
+    if len(labels) <= 2:
+        return ".".join(labels)
+    if labels[-2:] in (
+        ["co", "uk"],
+        ["com", "au"],
+        ["com", "br"],
+        ["com", "sg"],
+        ["com", "mx"],
+        ["co", "jp"],
+        ["co", "nz"],
+        ["co", "za"],
+    ):
+        return ".".join(labels[-3:])
+    return ".".join(labels[-2:])
+
+
+def _normalized_token(value: str) -> str:
+    return re.sub(r"[^a-z0-9]", "", value.casefold())
+
+
+def _official_host_matches_brand(brand: str, official_url: str) -> bool:
+    host = _normalized_token(_host(official_url))
+    if any(token in host for token in _OFFICIAL_FORBIDDEN_HOST_TOKENS):
+        return False
+    if not host:
+        return False
+
+    # The line may continue with a model description (the live failure was
+    # ``Winix 5510 - ... air purifier ...``).  Only the leading identity can
+    # establish ownership; generic category words must never turn a review
+    # host such as airpurifierfirst.com into the manufacturer's official site.
+    identity = _BRAND_DESCRIPTION_SPLIT_RE.split(str(brand or "").strip(), 1)[0]
+    raw_tokens = re.findall(r"[A-Za-z0-9]+", identity)
+    meaningful = [
+        _normalized_token(token)
+        for token in raw_tokens
+        if _normalized_token(token)
+        and _normalized_token(token) not in _GENERIC_BRAND_TOKENS
+        and not _normalized_token(token).isdigit()
+        and not re.fullmatch(r"[a-z]*\d+[a-z0-9]*", _normalized_token(token))
+    ]
+    candidates: list[str] = []
+    first_word = re.match(r"[A-Za-z0-9]+(?:[-+&.'][A-Za-z0-9]+)+", identity)
+    if first_word is not None:
+        candidates.append(_normalized_token(first_word.group(0)))
+    if meaningful:
+        candidates.append(meaningful[0])
+        if len(meaningful) >= 2:
+            candidates.append("".join(meaningful[:2]))
+    return any(len(candidate) >= 3 and candidate in host for candidate in candidates)
+
+
+def product_research_groundedness_claims(text: str) -> tuple[dict[str, Any], ...]:
+    """Project material claims and their already-verified frozen excerpts."""
+
+    claims: list[dict[str, Any]] = []
+    in_source_roles = False
+    lines = str(text or "").splitlines()
+    for index, raw_line in enumerate(lines):
+        line = raw_line.strip()
+        if line.casefold() == "## source roles":
+            in_source_roles = True
+            continue
+        if in_source_roles and line.startswith("## "):
+            in_source_roles = False
+        if (
+            not line
+            or in_source_roles
+            or line == PRODUCT_RESEARCH_PUBLICATION_FOOTER
+            or line.startswith("#")
+            or line in {"---", "***"}
+            or _TABLE_SEPARATOR_RE.fullmatch(line)
+            or _markdown_table_header(lines, index)
+        ):
+            continue
+        annotations = list(_EVIDENCE_RE.finditer(line))
+        if not annotations:
+            continue
+        claim = _EVIDENCE_RE.sub("", line)
+        claim = re.sub(r"\s*(?:--+|[-\u2013\u2014])?\s*$", "", claim).strip()
+        claim = re.sub(r"^(?:[-*]|\d+[.)])\s+", "", claim)
+        claim = re.sub(
+            r"^\*\*(?:Recommended brand|Recommended product):\*\*\s*",
+            "",
+            claim,
+            flags=re.IGNORECASE,
+        )
+        claim = re.sub(r"^\*\*([^*]{1,100}):\*\*\s*", r"\1: ", claim)
+        if not claim:
+            continue
+        claims.append({
+            "line": index + 1,
+            "claim": claim,
+            "evidence": tuple(
+                {
+                    "url": _canonical_url(match.group("url")),
+                    "quote": match.group("quote").strip(),
+                }
+                for match in annotations
+            ),
+        })
+    return tuple(claims)
+
+
+def product_research_title(response: Any) -> str | None:
+    match = _TITLE_RE.search(str(response or ""))
+    return match.group(1).strip() if match is not None else None
+
+
+def _compared_option_count(text: str) -> int:
+    match = re.search(
+        r"(?ims)^## Compared options\s*$\s*(?P<body>.*?)(?=^##\s|\Z)", text
+    )
+    if match is None:
+        return 0
+    return sum(
+        1
+        for line in match.group("body").splitlines()
+        if _HTTPS_URL_RE.search(line)
+        and (
+            re.match(r"^\s*(?:[-*]|\d+[.)])\s+", line)
+            or (
+                line.lstrip().startswith("|")
+                and not _TABLE_SEPARATOR_RE.fullmatch(line)
+            )
+        )
+    )
+
+
+def _markdown_table_header(lines: list[str], index: int) -> bool:
+    """Return whether a material-looking row is followed by a table separator."""
+
+    return bool(
+        index + 1 < len(lines)
+        and "|" in lines[index]
+        and _TABLE_SEPARATOR_RE.fullmatch(lines[index + 1].strip())
+    )
+
+
+def _uncited_product_material_line(lines: list[str], index: int) -> bool:
+    line = lines[index].strip()
+    if not line or line == PRODUCT_RESEARCH_PUBLICATION_FOOTER:
+        return False
+    if _ABSTENTION_LINE_RE.fullmatch(line):
+        return False
+    if line.startswith("#") or line in {"---", "***"}:
+        return False
+    if _TABLE_SEPARATOR_RE.fullmatch(line):
+        return False
+    if _markdown_table_header(lines, index):
+        return False
+    if not re.search(r"[A-Za-z0-9]", line):
+        return False
+    return _HTTPS_URL_RE.search(line) is None
+
+
+def _uncited_material_lines(text: str) -> list[int]:
+    lines = text.splitlines()
+    return [
+        index + 1
+        for index in range(len(lines))
+        if _uncited_product_material_line(lines, index)
+    ]
+
+
+def _project_product_research_evidence_rows(
+    response: str,
+) -> tuple[str, tuple[int, ...]]:
+    """Drop only uncited prose before strict final validation.
+
+    This is a constrained renderer, not claim repair. It preserves headings,
+    table structure, URL-bearing rows, exact evidence annotations, risky
+    consensus language, and publication claims. The unchanged validator still
+    rejects outside URLs, excerpt mismatches, unsupported consensus,
+    publication claims, missing required structure, and thin supported output.
+    Removing an uncited row can therefore never turn unsupported text into a
+    supported claim; it only prevents extra free-form prose from poisoning an
+    otherwise evidence-row-complete draft.
+    """
+
+    lines = response.splitlines()
+    dropped: list[int] = []
+    projected: list[str] = []
+    for index, raw_line in enumerate(lines):
+        line = raw_line.strip()
+        preserve_hard_failure = bool(
+            _RISKY_CONSENSUS_RE.search(line)
+            or (
+                _POSITIVE_PUBLICATION_RE.search(line)
+                and not _NEGATED_PUBLICATION_RE.search(line)
+            )
+        )
+        if _uncited_product_material_line(lines, index) and not preserve_hard_failure:
+            dropped.append(index + 1)
+            continue
+        projected.append(raw_line)
+    return "\n".join(projected).strip(), tuple(dropped)
+
+
+def _project_product_research_supported_rows(
+    response: str, raw_sources: Any, source_texts: Any
+) -> tuple[str, tuple[int, ...], tuple[str, ...]]:
+    """Build a strict subset containing only exactly supported material rows.
+
+    This projection never edits a claim, URL, or evidence quote. It drops a
+    whole material row when the row lacks an evidence annotation, cites outside
+    the immutable receipt, or contains a quote absent from that source's frozen
+    extract. The caller commits the subset only if the unchanged validator
+    accepts the complete result; otherwise it validates the unprojected draft
+    so the original failure reason remains available for a bounded retry.
+    """
+
+    if not isinstance(raw_sources, (list, tuple)) or not isinstance(
+        source_texts, Mapping
+    ):
+        return response, (), ()
+    allowlist = {
+        _canonical_url(url)
+        for url in raw_sources
+        if isinstance(url, str) and url.startswith("https://")
+    }
+    normalized_sources = {
+        _canonical_url(url): _normalized_evidence_text(content)
+        for url, content in source_texts.items()
+        if isinstance(url, str) and isinstance(content, str) and content.strip()
+    }
+    if not allowlist or not allowlist.issubset(normalized_sources):
+        return response, (), ()
+
+    lines = response.splitlines()
+    dropped: list[int] = []
+    reasons: set[str] = set()
+    projected: list[str] = []
+    in_source_roles = False
+    for index, raw_line in enumerate(lines):
+        line = raw_line.strip()
+        if line.casefold() == "## source roles":
+            in_source_roles = True
+            projected.append(raw_line)
+            continue
+        if in_source_roles and line.startswith("## "):
+            in_source_roles = False
+        skip_material_check = bool(
+            not line
+            or line == PRODUCT_RESEARCH_PUBLICATION_FOOTER
+            or _ABSTENTION_LINE_RE.fullmatch(line)
+            or line.startswith("#")
+            or line in {"---", "***"}
+            or _TABLE_SEPARATOR_RE.fullmatch(line)
+            or _markdown_table_header(lines, index)
+            or in_source_roles
+            or not re.search(r"[A-Za-z0-9]", line)
+        )
+        if skip_material_check:
+            projected.append(raw_line)
+            continue
+
+        annotations = list(_EVIDENCE_RE.finditer(line))
+        reason: str | None = None
+        if not annotations:
+            reason = "evidence_annotation_missing"
+        else:
+            for annotation in annotations:
+                url = _canonical_url(annotation.group("url"))
+                quote = _normalized_evidence_text(annotation.group("quote"))
+                if url not in allowlist:
+                    reason = "evidence_url_outside_receipt"
+                    break
+                if quote not in normalized_sources.get(url, ""):
+                    reason = "evidence_excerpt_mismatch"
+                    break
+
+        preserve_hard_failure = bool(
+            _RISKY_CONSENSUS_RE.search(line)
+            or (
+                _POSITIVE_PUBLICATION_RE.search(line)
+                and not _NEGATED_PUBLICATION_RE.search(line)
+            )
+        )
+        if reason is not None and not preserve_hard_failure:
+            dropped.append(index + 1)
+            reasons.add(reason)
+            continue
+        projected.append(raw_line)
+    return (
+        "\n".join(projected).strip(),
+        tuple(dropped),
+        tuple(sorted(reasons)),
+    )
+
+
+def _project_product_research_receipt_rows(
+    response: str, raw_sources: Any
+) -> tuple[str, tuple[int, ...], tuple[str, ...]]:
+    """Drop whole rows containing URLs outside the immutable receipt.
+
+    This is a fail-safe subset projection, not citation repair.  It never
+    substitutes a URL, moves an evidence annotation, or edits a claim.  The
+    unchanged validator must still accept the surviving rows, including exact
+    excerpt custody, source roles, comparison depth, and minimum supported
+    material.  Publication claims and risky consensus language are preserved
+    even when they contain a foreign URL so those policy failures cannot be
+    hidden by projection.
+    """
+
+    if not isinstance(raw_sources, (list, tuple)):
+        return response, (), ()
+    allowlist = {
+        _canonical_url(url)
+        for url in raw_sources
+        if isinstance(url, str) and url.startswith("https://")
+    }
+    lines = response.splitlines()
+    dropped: list[int] = []
+    outside_urls: set[str] = set()
+    projected: list[str] = []
+    for index, raw_line in enumerate(lines):
+        line = raw_line.strip()
+        line_urls = {_canonical_url(url) for url in _HTTPS_URL_RE.findall(line)}
+        foreign = line_urls - allowlist
+        preserve_hard_failure = bool(
+            _RISKY_CONSENSUS_RE.search(line)
+            or (
+                _POSITIVE_PUBLICATION_RE.search(line)
+                and not _NEGATED_PUBLICATION_RE.search(line)
+            )
+        )
+        if foreign and not preserve_hard_failure:
+            dropped.append(index + 1)
+            outside_urls.update(foreign)
+            continue
+        projected.append(raw_line)
+    return (
+        "\n".join(projected).strip(),
+        tuple(dropped),
+        tuple(sorted(outside_urls)),
+    )
+
+
+def _insert_product_source_role_lines(text: str, lines: list[str]) -> str:
+    """Insert controller-owned provenance labels without authoring claims."""
+
+    if not lines:
+        return text
+    heading = re.search(r"(?im)^## Source roles\s*$", text)
+    block = "\n".join(lines)
+    if heading is None:
+        return f"{text.rstrip()}\n\n## Source roles\n{block}"
+
+    next_heading = re.search(r"(?im)^##\s+", text[heading.end() :])
+    section_end = (
+        heading.end() + next_heading.start() if next_heading is not None else len(text)
+    )
+    footer_at = text.find(PRODUCT_RESEARCH_PUBLICATION_FOOTER, heading.end())
+    if footer_at >= 0:
+        section_end = min(section_end, footer_at)
+    before = text[:section_end].rstrip()
+    after = text[section_end:].lstrip()
+    return f"{before}\n{block}" + (f"\n\n{after}" if after else "")
+
+
+def _replace_durable_product_source_roles(
+    text: str, catalog: Mapping[str, Any] | None
+) -> tuple[str, tuple[str, ...]]:
+    """Render durable provenance roles from the controller-owned source map."""
+
+    if not isinstance(catalog, Mapping) or catalog.get("research_mode") != (
+        "durable_comparison"
+    ):
+        return text, ()
+    raw_sources = catalog.get("sources")
+    if not isinstance(raw_sources, list):
+        return text, ()
+    role_lines: list[str] = []
+    role_counts = {"official": 0, "independent": 0}
+    for source in raw_sources:
+        if not isinstance(source, Mapping):
+            continue
+        url = source.get("url")
+        role = source.get("source_role")
+        if (
+            not isinstance(url, str)
+            or not url.startswith("https://")
+            or role not in role_counts
+        ):
+            continue
+        role_counts[str(role)] += 1
+        label = "Official" if role == "official" else "Independent"
+        role_lines.append(f"- **{label}:** {url}")
+    if role_counts["official"] < 2 or role_counts["independent"] < 2:
+        return text, ()
+
+    heading = re.search(r"(?im)^## Source roles\s*$", text)
+    block = "## Source roles\n" + "\n".join(role_lines)
+    if heading is None:
+        return f"{text.rstrip()}\n\n{block}", ("durable_source_roles",)
+    next_heading = re.search(r"(?im)^##\s+", text[heading.end() :])
+    section_end = (
+        heading.end() + next_heading.start() if next_heading is not None else len(text)
+    )
+    footer_at = text.find(PRODUCT_RESEARCH_PUBLICATION_FOOTER, heading.end())
+    if footer_at >= 0:
+        section_end = min(section_end, footer_at)
+    before = text[: heading.start()].rstrip()
+    after = text[section_end:].lstrip()
+    rendered = f"{before}\n\n{block}" if before else block
+    if after:
+        rendered += f"\n\n{after}"
+    return rendered, ("durable_source_roles",)

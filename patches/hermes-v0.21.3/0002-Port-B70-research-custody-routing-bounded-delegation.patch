+def test_rate_slot_spaces_request_starts(monkeypatch: pytest.MonkeyPatch) -> None:
+    clock = [10.0]
+    sleeps: list[float] = []
+
+    monkeypatch.setattr(searxng, "_MIN_REQUEST_INTERVAL_SECONDS", 1.0)
+    monkeypatch.setattr(searxng, "_monotonic", lambda: clock[0])
+
+    def fake_sleep(seconds: float) -> None:
+        sleeps.append(seconds)
+        clock[0] += seconds
+
+    monkeypatch.setattr(searxng, "_sleep", fake_sleep)
+    searxng._reset_runtime_guard_for_tests()
+
+    searxng._wait_for_rate_slot()
+    clock[0] += 0.25
+    searxng._wait_for_rate_slot()

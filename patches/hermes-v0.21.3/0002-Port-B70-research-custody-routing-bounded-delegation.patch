+def _travel_raw_root() -> Path:
+    vault = os.environ.get("OBSIDIAN_VAULT_PATH") or LOCAL_DEFAULT_OBSIDIAN_VAULT
+    return (Path(vault).expanduser() / "raw" / "travel").resolve()
+

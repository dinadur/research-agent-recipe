+def build_synthesis_prompt(spec: Mapping[str, Any], rows: Sequence[Mapping[str, Any]]) -> str:
+    visible = [
+        {"row_id": row["row_id"], "facet": row["facet"], "verified_text": row["text"]}
+        for row in rows
+    ]
+    semantic_rows = bool(rows) and all(
+        isinstance(row.get("selected_candidate_id"), str)
+        for row in rows
+    )
+    coverage_contract = (
+        " Use at least three distinct selected evidence rows from each facet across "
+        "the units, or every row when a facet has fewer than three. Preserve every "
+        "explicit measured threshold from the selected rows with its number and "
+        "citation. Each cited row must directly contribute wording to that unit; "
+        "never pad citations."
+        if semantic_rows
+        else ""
+    )
+    return (
+        "Answer the research request using only the controller-owned evidence rows. "
+        "Return one JSON object and no other text. The object must have exactly "
+        "schema_version=1 and units. Each unit must have exactly unit_id, kind, text, "
+        "and evidence_row_ids. "
+        "Write 6-10 units in document order with unit_id u1, u2, and so on. "
+        "Use at least two findings, one interaction, two recommendations, and one limitation. "
+        "Each unit must be one atomic sentence ending in a period, contain no URL, quotation, "
+        "semicolon, question, or row ID in its text, and cite 1-3 exact evidence_row_ids. "
+        "Use every facet at least once. Recommendations may draw a cautious operational "
+        "inference, but every factual premise must be present in the cited rows. Do not add "
+        "numbers, defaults, guarantees, mechanisms, or effects absent from those rows. "
+        "Prefer the evidence vocabulary and avoid unsupported multi-word phrases."
+        + coverage_contract
+        + "\n\n"
+        f"Research request: {spec['request']}\n\n"
+        "<controller_evidence_rows>\n"
+        + json.dumps(visible, ensure_ascii=False, indent=2)
+        + "\n</controller_evidence_rows>\n"
+    )
+
+
+def build_facet_synthesis_prompt(
+    spec_value: Mapping[str, Any],
+    rows: Sequence[Mapping[str, Any]],
+    facet_marker: str,
+) -> str:
+    """Build one small synthesis task over exactly one selected facet."""
+
+    spec = validate_spec(dict(spec_value))
+    facets = {facet["marker"]: facet for facet in spec["facets"]}
+    facet = facets.get(facet_marker)
+    if facet is None:
+        raise ReferenceStoreError("facet synthesis marker is not in the spec")
+    facet_rows = [row for row in rows if row.get("facet") == facet_marker]
+    if (
+        not MIN_ROWS_PER_FACET <= len(facet_rows) <= MAX_ROWS_PER_FACET
+        or len(facet_rows) != len(rows)
+        or not all(
+            isinstance(row.get("row_id"), str)
+            and _ROW_ID_RE.fullmatch(row["row_id"]) is not None
+            and isinstance(row.get("selected_candidate_id"), str)
+            and _CANDIDATE_ID_RE.fullmatch(row["selected_candidate_id"])
+            is not None
+            and isinstance(row.get("text"), str)
+            and row["text"].strip()
+            for row in facet_rows
+        )
+        or len({row["row_id"] for row in facet_rows}) != len(facet_rows)
+    ):
+        raise ReferenceStoreError("facet synthesis rows are invalid")
+    visible = [
+        {"row_id": row["row_id"], "verified_text": row["text"]}
+        for row in facet_rows
+    ]
+    return (
+        "Answer only the named facet of the research request using only the "
+        "controller-owned evidence rows below. Return one JSON object and no "
+        "other text. The object must have exactly schema_version=1 and units. "
+        "Each unit must have exactly unit_id, kind, text, and evidence_row_ids. "
+        f"Write {MIN_FACET_UNITS}-{MAX_FACET_UNITS} units in useful document "
+        "order with unit_id u1, u2, and so on. Kind must be finding, "
+        "recommendation, or limitation, with at least one finding. Use "
+        "recommendation only when a cited row directly states an action, and "
+        "use limitation only when a cited row directly states a constraint or "
+        "failure mode; otherwise write a finding. Each unit must be one atomic "
+        "sentence ending in a period, contain no URL, quotation, semicolon, "
+        "question, or row ID in its text, and cite 1-3 exact evidence_row_ids. "
+        "Use at least three distinct evidence rows across the units. Prefer one "
+        "row per unit; cite multiple rows only when each directly contributes "
+        "wording to the same sentence. Preserve every explicit measured "
+        "threshold in the supplied rows with its number and citation. Select "
+        "central, non-duplicative content for this facet. Do not discuss another "
+        "facet, add cross-facet interactions, pad citations, or add numbers, "
+        "defaults, guarantees, mechanisms, or effects absent from the cited "
+        "rows. Prefer the evidence vocabulary and avoid unsupported multi-word "
+        "phrases.\n\n"
+        f"Research request: {spec['request']}\n"
+        f"Facet: {facet_marker} - {facet['label']}\n\n"
+        "<controller_facet_evidence_rows>\n"
+        + json.dumps(visible, ensure_ascii=False, indent=2)
+        + "\n</controller_facet_evidence_rows>\n"
+    )
+

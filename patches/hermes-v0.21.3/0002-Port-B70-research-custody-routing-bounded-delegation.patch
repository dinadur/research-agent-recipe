+def product_research_finalization_request_overrides(agent: Any) -> dict[str, Any]:
+    """Bound only model retries that revise a rejected product draft.
+
+    A validation nudge carries the prior private candidate into the next
+    provider request.  Those calls are edit passes, not another research
+    report, so an unbounded replacement can only add more opportunities for
+    uncited prose and foreign URLs.  Keep normal thinking enabled but cap the
+    replacement size.  The receipt-bound catalog is already controller-owned;
+    template reasoning can only consume the entire output cap before visible
+    prose, as the v6 live canary demonstrated.  Disable thinking for every
+    receipt-bound finalization call so the full bound is available to the
+    draft. Initial research and retrieval analysis retain their own settings.
+    """
+
+    turn_id = getattr(agent, "_current_turn_id", None)
+    if not (
+        isinstance(turn_id, str)
+        and turn_id
+        and getattr(agent, "_product_research_initial_turn_id", None) == turn_id
+        and (
+            getattr(agent, "_product_research_receipt_turn_id", None) == turn_id
+            or (
+                getattr(agent, "_product_research_retry_candidate_turn_id", None)
+                == turn_id
+                and isinstance(
+                    getattr(agent, "_product_research_retry_candidate", None), str
+                )
+            )
+        )
+    ):
+        return {}
+    if product_research_quality_first_active(agent):
+        from agent.quality_first_route import (
+            QUALITY_FIRST_MAX_TOKENS,
+            QUALITY_FIRST_REASONING_BUDGET,
+        )
+
+        return {
+            "max_tokens": QUALITY_FIRST_MAX_TOKENS,
+            "extra_body": {
+                "chat_template_kwargs": {"enable_thinking": True},
+                "include_reasoning": True,
+                "reasoning_effort": "xhigh",
+                "reasoning_budget_tokens": QUALITY_FIRST_REASONING_BUDGET,
+            },
+        }
+    return {
+        "max_tokens": PRODUCT_RESEARCH_FINALIZATION_MAX_TOKENS,
+        "extra_body": {
+            "chat_template_kwargs": {"enable_thinking": False},
+        },
+    }

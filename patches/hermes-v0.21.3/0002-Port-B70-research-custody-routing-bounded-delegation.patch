diff --git a/agent/travel_route.py b/agent/travel_route.py
new file mode 100644
index 000000000..98119fb0b
--- /dev/null
+++ b/agent/travel_route.py
@@ -0,0 +1,297 @@
+"""Deterministic admission helpers for verified travel/wiki research."""
+
+from __future__ import annotations
+
+import logging
+import re
+from typing import Any, Mapping
+
+
+logger = logging.getLogger(__name__)
+
+
+TRAVEL_PUBLICATION_ROUTE_MARKER = "HERMES_TRAVEL_PUBLICATION_ROUTE_V1"
+TRAVEL_PUBLICATION_SKILLS = (
+    "travel-planning",
+    "destination-wiki-pages",
+    "obsidian",
+)
+TRAVEL_PUBLICATION_ALLOWED_TOOLS = frozenset(
+    {
+        "clarify",
+        "read_file",
+        "search_files",
+        "skill_view",
+        "terminal",
+        "web_extract",
+        "web_search",
+        "write_file",
+    }
+)
+TRAVEL_PUBLICATION_ROUTE_NOTE = (
+    f"[System: {TRAVEL_PUBLICATION_ROUTE_MARKER} is controller-selected. "
+    "The verified travel, destination-page, and Obsidian skills are auto-loaded "
+    "below; do not reload them. Fast-start a natural destination request: when "
+    "the destination and categories are already explicit, do not ask for dates "
+    "or preferences and do not inspect schema, taxonomy, index, peer, or target "
+    "pages. Resolve the vault once. A structured terminal web_search failure "
+    "normally ends the current turn. The executor may omit exactly one isolated "
+    "serpapi_unavailable leaf only when the current turn has at least four "
+    "searches, at least three successes, at least 75 percent usable results, and "
+    "eight unique URLs; "
+    "that closes web search for the turn, so use the survivors and do not issue "
+    "a replacement query. Otherwise, do not issue another query wave. Use no "
+    "more than three parent retrieval waves and 12 individual queries. Start "
+    "with broad multi-candidate category searches, use the second wave only to "
+    "replace directory leads with direct official pages, and reserve the third "
+    "for a category that is still short. Stop as soon as eight direct official "
+    "venue records per requested category are available (16 total for attractions "
+    "and dining); batch independent searches in the same response instead of "
+    "spending one query or turn per venue. Copy each venue name exactly as its "
+    "official page presents it; do "
+    "not append a city or destination suffix unless it is part of that official "
+    "name. Directory and tourism results may identify candidates only and must "
+    "be replaced by direct official venue URLs before the manifest. Attach at "
+    "most two direct official pages per venue when separate operations and "
+    "experience pages are needed. Write only "
+    "the source manifest and one schema-version-1 domain request under "
+    "raw/travel, and immediately run `python3 -m "
+    "agent.research_harness.travel_runner "
+    "/ABSOLUTE/VAULT/raw/travel/REQUEST.json` in the foreground. "
+    "When the user supplies an exact travel/active or travel/destinations page "
+    "path, derive owner, slug, leaf page, and page_type exactly from it; use "
+    "category null for a mixed attraction/dining overview. The runner rejects "
+    "any manifest scope that disagrees with that explicit canonical target. "
+    "Do not parent-extract "
+    "evidence or draft prose: the controller owns fetch, extraction, quarantine, "
+    "review, rendering, audit, and receipt creation; its terminal tool timeout "
+    "is controller-bound to 900 seconds. The executor closes discovery at "
+    "12 queries without ending a strong turn: surplus calls are rejected and the "
+    "parent must use the successful results already returned. It admits exactly "
+    "one runner/controller call per user turn. The "
+    "controller applies one conservative manifest-shape normalization pass, "
+    "then records its live stage in run-state.json. A nonzero or timed-out "
+    "runner/controller result is terminal for the turn: do not repair or rerun it; "
+    "report the blocker and stop. After a query-ceiling stop, a continuation "
+    "must reuse the successful search results persisted in the transcript and "
+    "must not repeat those queries; search only for a genuinely missing category. "
+    "On any other continuation or retry "
+    "inside an already-latched travel session, do not repeat vault resolution, "
+    "discovery, extraction, or drafting when the persisted transcript already "
+    "names a balanced source manifest. Reuse that manifest as immutable input, "
+    "choose a new sibling run directory, write one new request that binds that "
+    "manifest and directory, and immediately make the single runner call. "
+    "When the receipt-owned approval preview says category coverage is short, "
+    "a later reply of `more`, `more results`, or `second wave` authorizes one "
+    "fresh deficit-only recovery continuation before publication. Do not publish "
+    "the old receipt. Reuse its manifest and included inventory only to exclude "
+    "already attempted venue identities and URLs, search only categories below "
+    "target, then write a new combined manifest plus sibling run request and make "
+    "the single controller call. The new controller must re-fetch and re-review "
+    "the complete combined manifest and issue a new approval receipt. Never use "
+    "a receipt from a diagnostic/replay directory "
+    "or an earlier run. The successful controller emits a receipt-bound approval "
+    "preview which is delivered directly; do not add venues or paraphrase it. "
+    "Ask for approval only when the current continuation's publication-receipt.json "
+    "exists, then use the receipt-only publisher once. "
+    "parallel-research, delegation, code execution, arbitrary shell commands, "
+    "and direct canonical writes are unavailable for this session.]"
+)
+
+_RESEARCH_RE = re.compile(
+    r"\b(?:research|investigate|verify|compare|find|recommend|suggest|plan)\b|"
+    r"\bwhat\s+should\s+(?:i|we)\b",
+    re.IGNORECASE,
+)
+_TRAVEL_WIKI_RE = re.compile(r"\btravel\s+(?:wiki|vault|note|page)s?\b", re.IGNORECASE)
+_WIKI_MUTATION_RE = re.compile(
+    r"\b(?:add|save|write|publish|create|update|put)\b.{0,80}"
+    r"\b(?:wiki|vault|note|page)s?\b",
+    re.IGNORECASE,
+)
+_EXPLICIT_NO_PUBLICATION_RE = re.compile(
+    r"\b(?:do\s+not|don't|never)\b.{0,120}"
+    r"\b(?:save|publish|write|create|update)\b",
+    re.IGNORECASE,
+)
+_STRONG_TRAVEL_RE = re.compile(
+    r"\b(?:trip|itinerar(?:y|ies)|weekend\s+visit|vacation|"
+    r"travel\s+(?:to|in|around|through|planning|plans?)|"
+    r"destination\s+(?:guide|page|research)|sightseeing)\b",
+    re.IGNORECASE,
+)
+_TRAVEL_CATEGORY_RES = (
+    re.compile(r"\b(?:attraction|museum|historic\s+site|point\s+of\s+interest)s?\b", re.IGNORECASE),
+    re.compile(r"\b(?:restaurant|dining|cafe|food|cuisine)s?\b", re.IGNORECASE),
+    re.compile(r"\b(?:hotel|lodging|accommodation)s?\b", re.IGNORECASE),
+    re.compile(r"\b(?:activity|activities|tour|trail|park)s?\b", re.IGNORECASE),
+    re.compile(r"\b(?:transit|transportation|parking|admission|logistics)\b", re.IGNORECASE),
+)
+_DESTINATION_CONTEXT_RE = re.compile(
+    r"\b(?:in|around|near|visiting|visit\s+to|trip\s+to|travel\s+to)\s+"
+    r"(?!(?:me|us|my|our|home|work|tonight|the\s+area|this\s+area|"
+    r"the\s+wiki|my\s+wiki)\b)"
+    r"[A-Za-z][A-Za-z.'\u2019-]*(?:\s+[A-Za-z][A-Za-z.'\u2019-]*){0,3}\b",
+    re.IGNORECASE,
+)
+_NATURAL_SEE_EAT_RE = re.compile(
+    r"(?:\b(?:see|visit|do)\b.{0,80}\b(?:eat|dining|restaurants?)\b|"
+    r"\b(?:eat|dining|restaurants?)\b.{0,80}\b(?:see|visit|do)\b)",
+    re.IGNORECASE,
+)
+_TRAVEL_CONTINUATION_RE = re.compile(
+    r"\b(?:yes|approve|publish|proceed|continue|resume|retry|rerun|"
+    r"try\s+again|fix\s+it|more(?:\s+results?)?|second\s+wave)\b",
+    re.IGNORECASE,
+)
+
+
+def requires_travel_publication_route(user_message: Any) -> bool:
+    """Return True only for explicit travel research/publication intent.
+
+    The classifier deliberately avoids treating a lone restaurant, hotel,
+    destination-shaped word, or product-use adjective such as "for travel" as
+    travel planning. A strong trip cue, an explicit travel wiki target, or at
+    least two independent travel categories are required.
+    """
+
+    if not isinstance(user_message, str):
+        return False
+    text = " ".join(user_message.split())
+    if not text:
+        return False
+    if TRAVEL_PUBLICATION_ROUTE_MARKER in text:
+        return True
+    # Respect an explicit in-chat/no-publication boundary. Transport and trip
+    # comparisons still need web evidence, but they must not be admitted to
+    # the destination-wiki writer when the operator expressly forbids writes.
+    # The generic research route can then provide receipt-bound synthesis.
+    if _EXPLICIT_NO_PUBLICATION_RE.search(text):
+        return False
+    if _TRAVEL_WIKI_RE.search(text):
+        return True
+    research = _RESEARCH_RE.search(text) is not None
+    wiki_mutation = _WIKI_MUTATION_RE.search(text) is not None
+    if _STRONG_TRAVEL_RE.search(text) and (research or wiki_mutation):
+        return True
+    destination_context = _DESTINATION_CONTEXT_RE.search(text) is not None
+    if destination_context and _NATURAL_SEE_EAT_RE.search(text):
+        return True
+    category_count = sum(1 for pattern in _TRAVEL_CATEGORY_RES if pattern.search(text))
+    return category_count >= 2 and destination_context and (research or wiki_mutation)
+
+
+def merge_travel_publication_skills(existing: Any) -> list[str]:
+    """Prepend the required ordered travel skills without duplicates."""
+
+    if isinstance(existing, str):
+        existing_names = [existing]
+    elif isinstance(existing, (list, tuple)):
+        existing_names = [name for name in existing if isinstance(name, str)]
+    else:
+        existing_names = []
+    merged = list(TRAVEL_PUBLICATION_SKILLS)
+    for name in existing_names:
+        if name and name not in merged:
+            merged.append(name)
+    return merged
+
+
+def _history_requests_travel_publication(conversation_history: Any) -> bool:
+    if not isinstance(conversation_history, (list, tuple)):
+        return False
+    for message in conversation_history:
+        if not isinstance(message, Mapping) or message.get("role") != "user":
+            continue
+        content = message.get("content")
+        if requires_travel_publication_route(content):
+            return True
+    return False
+
+
+def arm_travel_publication_session(
+    agent: Any,
+    current_message: Any,
+    conversation_history: Any = None,
+    *,
+    route_requested: bool | None = None,
+) -> bool:
+    """Latch verified-travel authority for the life of one session.
+
+    Approval and repair messages rarely repeat the original travel request.
+    Recover the latch from the persisted user transcript so a fresh agent after
+    a gateway restart receives the same capability boundary. ``/new`` changes
+    the session id and ``reset_session_state`` clears the in-memory latch.
+    """
+
+    session_id = str(getattr(agent, "session_id", "") or "")
+    latched = (
+        getattr(agent, "_travel_publication_route_session_latched", False)
+        is True
+    )
+    latched_session_id = str(
+        getattr(agent, "_travel_publication_route_session_id", "") or ""
+    )
+    if latched and latched_session_id == session_id:
+        return True
+    if latched and latched_session_id != session_id:
+        agent._travel_publication_route_session_latched = False
+        agent._travel_publication_route_session_id = None
+
+    requested = (
+        route_requested
+        if isinstance(route_requested, bool)
+        else requires_travel_publication_route(current_message)
+    )
+    continuation = bool(
+        isinstance(current_message, str)
+        and _TRAVEL_CONTINUATION_RE.search(current_message)
+    )
+    recovered = bool(
+        not requested
+        and continuation
+        and _history_requests_travel_publication(conversation_history)
+    )
+    if requested or recovered:
+        agent._travel_publication_route_session_latched = True
+        agent._travel_publication_route_session_id = session_id
+        logger.info(
+            "travel publication route armed session=%s reason=%s",
+            session_id or "none",
+            "current_turn" if requested else "persisted_continuation",
+        )
+        return True
+    return False
+
+
+def travel_publication_route_active(agent: Any) -> bool:
+    """Whether the current session owns the deterministic travel route."""
+
+    turn_id = getattr(agent, "_current_turn_id", None)
+    turn_active = bool(
+        isinstance(turn_id, str)
+        and turn_id
+        and getattr(agent, "_travel_publication_route_turn_id", None) == turn_id
+    )
+    session_id = str(getattr(agent, "session_id", "") or "")
+    session_active = bool(
+        getattr(agent, "_travel_publication_route_session_latched", False)
+        is True
+        and str(
+            getattr(agent, "_travel_publication_route_session_id", "") or ""
+        )
+        == session_id
+    )
+    return turn_active or session_active
+
+
+__all__ = [
+    "TRAVEL_PUBLICATION_ROUTE_MARKER",
+    "TRAVEL_PUBLICATION_ROUTE_NOTE",
+    "TRAVEL_PUBLICATION_SKILLS",
+    "TRAVEL_PUBLICATION_ALLOWED_TOOLS",
+    "arm_travel_publication_session",
+    "merge_travel_publication_skills",
+    "requires_travel_publication_route",
+    "travel_publication_route_active",
+]

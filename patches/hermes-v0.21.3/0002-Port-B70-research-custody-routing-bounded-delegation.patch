diff --git a/gateway/travel_routing.py b/gateway/travel_routing.py
new file mode 100644
index 000000000..5070d4603
--- /dev/null
+++ b/gateway/travel_routing.py
@@ -0,0 +1,65 @@
+"""Gateway-only binding for the deterministic verified-travel route."""
+
+from __future__ import annotations
+
+import logging
+from typing import Any
+
+from agent.travel_route import (
+    merge_travel_publication_skills,
+    requires_travel_publication_route,
+)
+
+
+logger = logging.getLogger(__name__)
+
+
+TRAVEL_ROUTE_METADATA_KEY = "verified_travel_publication_route"
+TRAVEL_ORIGINAL_TEXT_METADATA_KEY = "verified_travel_original_text"
+
+
+def arm_travel_publication_event(event: Any) -> bool:
+    """Bind one real user event to the travel skills before model routing."""
+
+    if event is None or getattr(event, "internal", False) is True:
+        return False
+    text = getattr(event, "text", None)
+    if not isinstance(text, str) or text.startswith("/"):
+        return False
+    if not requires_travel_publication_route(text):
+        return False
+    metadata = getattr(event, "metadata", None)
+    if not isinstance(metadata, dict):
+        metadata = {}
+        event.metadata = metadata
+    metadata.setdefault(TRAVEL_ORIGINAL_TEXT_METADATA_KEY, text)
+    metadata[TRAVEL_ROUTE_METADATA_KEY] = True
+    event.auto_skill = merge_travel_publication_skills(
+        getattr(event, "auto_skill", None)
+    )
+    logger.info(
+        "[Gateway] Armed verified travel route for explicit current event"
+    )
+    return True
+
+
+def travel_publication_event_is_armed(event: Any) -> bool:
+    metadata = getattr(event, "metadata", None)
+    return bool(isinstance(metadata, dict) and metadata.get(TRAVEL_ROUTE_METADATA_KEY) is True)
+
+
+def travel_publication_original_text(event: Any) -> str | None:
+    metadata = getattr(event, "metadata", None)
+    if not isinstance(metadata, dict):
+        return None
+    value = metadata.get(TRAVEL_ORIGINAL_TEXT_METADATA_KEY)
+    return value if isinstance(value, str) else None
+
+
+__all__ = [
+    "TRAVEL_ORIGINAL_TEXT_METADATA_KEY",
+    "TRAVEL_ROUTE_METADATA_KEY",
+    "arm_travel_publication_event",
+    "travel_publication_event_is_armed",
+    "travel_publication_original_text",
+]

+                    "candidate_tokens": sorted(candidate_tokens),
+                    "candidate_independent_families": len(
+                        anticipated_candidate_families
+                    ),
+                    "removed_cross_candidate_urls": len(misaligned_requested),
+                    "search_calls": search_count,
+                    "extract_calls": extract_count,
+                    "nudge": nudge_count + 1,
+                },
+            )
+    if duplicate_count == 0:

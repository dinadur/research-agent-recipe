+class TestReadFileHandler:
+    def test_task_read_allowlist_denies_wrong_path_before_content(self, tmp_path):
+        from tools.file_tools import read_file_tool
+        from tools.file_custody import register_task_read_allowlist, register_task_policy_violation_callback, unregister_task_read_allowlist, unregister_task_policy_violation_callback
+
+        task_id = "soak-child-read-deny"
+        allowed = tmp_path / "evidence.md"
+        wrong = tmp_path / "validator.py"
+        wrong.write_text("secret validator source", encoding="utf-8")
+        violations = []
+        register_task_read_allowlist(task_id, [str(allowed)])
+        register_task_policy_violation_callback(task_id, violations.append)
+        try:
+            with patch("tools.file_tools._resolve_path_for_task") as mock_resolve:
+                result = json.loads(read_file_tool(str(wrong), task_id=task_id))
+            mock_resolve.assert_not_called()
+        finally:
+            unregister_task_read_allowlist(task_id)
+            unregister_task_policy_violation_callback(task_id)
+
+        assert "exact-path allowlist" in result["error"]
+        assert "secret validator source" not in json.dumps(result)
+        assert len(violations) == 1
+        assert "exact-path allowlist" in violations[0]
+
+    def test_task_read_allowlist_enforces_per_path_budget(self, tmp_path):
+        from tools.file_tools import read_file_tool
+        from tools.file_custody import register_task_read_allowlist, unregister_task_read_allowlist
+
+        task_id = "soak-child-read-budget"
+        allowed = tmp_path / "evidence.md"
+        allowed.write_text("grounded evidence", encoding="utf-8")
+        register_task_read_allowlist(task_id, [str(allowed)])
+        try:
+            first = json.loads(read_file_tool(str(allowed), task_id=task_id))
+            second = json.loads(read_file_tool(str(allowed), task_id=task_id))
+        finally:
+            unregister_task_read_allowlist(task_id)
+
+        assert "grounded evidence" in first["content"]
+        assert "per-path read budget" in second["error"]
+
+    def test_task_read_sequence_wrong_attempt_does_not_advance(self, tmp_path):
+        from tools.file_custody import _reserve_task_read_allowlist, register_task_read_policy, unregister_task_read_policy
+
+        task_id = "soak-child-read-sequence"
+        first = str(tmp_path / "first.md")
+        second = str(tmp_path / "second.md")
+        register_task_read_policy(task_id, {"sequence": [first, second]})
+        try:
+            assert _reserve_task_read_allowlist(second, task_id)
+            assert _reserve_task_read_allowlist(first, task_id) is None
+            assert _reserve_task_read_allowlist(first, task_id)
+            assert _reserve_task_read_allowlist(second, task_id) is None
+            assert _reserve_task_read_allowlist(second, task_id)
+        finally:
+            unregister_task_read_policy(task_id)
+
+    def test_task_read_budget_reservation_is_atomic(self, tmp_path):
+        import threading
+
+        from tools.file_custody import _reserve_task_read_allowlist, register_task_read_policy, unregister_task_read_policy
+
+        task_id = "soak-child-read-concurrent"
+        allowed = str(tmp_path / "evidence.md")
+        register_task_read_policy(task_id, {"max_counts": {allowed: 1}})
+        barrier = threading.Barrier(3)
+        results = []
+
+        def reserve():
+            barrier.wait(timeout=2)
+            results.append(_reserve_task_read_allowlist(allowed, task_id))
+
+        threads = [threading.Thread(target=reserve) for _ in range(2)]
+        for thread in threads:
+            thread.start()
+        barrier.wait(timeout=2)
+        for thread in threads:
+            thread.join(timeout=2)
+        try:
+            assert sum(result is None for result in results) == 1
+            assert sum(isinstance(result, str) for result in results) == 1
+        finally:
+            unregister_task_read_policy(task_id)

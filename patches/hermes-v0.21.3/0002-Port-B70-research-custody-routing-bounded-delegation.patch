diff --git a/tools/research_delegation.py b/tools/research_delegation.py
new file mode 100644
index 000000000..02c48f3a5
--- /dev/null
+++ b/tools/research_delegation.py
@@ -0,0 +1,315 @@
+"""Typed research-child admission and disk-bound completion on upstream delegation."""
+from __future__ import annotations
+import hashlib
+import logging
+from typing import Any, Optional
+from tools.delegate_tool import _normalize_role
+from tools.registry import tool_error
+logger = logging.getLogger(__name__)
+_RESEARCH_CHILD_TOOL_NAMES = frozenset({"read_file", "write_file", "web_search", "web_extract"})
+
+def _register_research_contract(
+    child,
+    task_id: str,
+    *,
+    task_started_monotonic: float,
+    child_timeout_seconds: Optional[float],
+) -> None:
+    """Bind a frozen research controller and exact write path to this task."""
+
+    from agent.research_contract import get_research_controller
+
+    controller = get_research_controller(child)
+    if controller is None:
+        return
+    if not isinstance(task_id, str) or not task_id:
+        raise ValueError("research contract requires a stable child task id")
+    controller.bind_task(
+        task_id,
+        task_started_monotonic=task_started_monotonic,
+        child_timeout_seconds=child_timeout_seconds,
+    )
+    from tools.file_custody import register_task_write_allowlist
+
+    register_task_write_allowlist(task_id, [controller.contract.path])
+    child._research_write_allowlist_task_id = task_id
+
+
+def _research_completion_attestation(controller: Any, validation: Any) -> dict | None:
+    """Build one private, disk-bound research completion attestation.
+
+    The async control plane may carry this object out of band, but it must never
+    infer completion from a conversational summary. Bind only the exact frozen
+    child contract, the controller's final validation result, and bytes that
+    still match the controller-owned post-write digest.
+    """
+
+    contract = getattr(controller, "contract", None)
+    path = getattr(contract, "path", None)
+    validator_sha256 = getattr(contract, "validator_sha256", None)
+    source_policy_id = getattr(contract, "source_policy_id", None)
+    task_digest = getattr(controller, "last_task_write_sha256", None)
+    passed = getattr(validation, "passed", None)
+    terminal = getattr(validation, "terminal", None)
+    retryable = getattr(validation, "retryable", None)
+    if (
+        not isinstance(path, str)
+        or not path
+        or not isinstance(validator_sha256, str)
+        or len(validator_sha256) != 64
+        or any(char not in "0123456789abcdef" for char in validator_sha256)
+        or not isinstance(source_policy_id, str)
+        or not source_policy_id
+        or not isinstance(task_digest, str)
+        or len(task_digest) != 64
+        or any(char not in "0123456789abcdef" for char in task_digest)
+        or type(passed) is not bool
+        or type(terminal) is not bool
+        or type(retryable) is not bool
+    ):
+        return None
+    try:
+        with open(path, "rb") as handle:
+            artifact_sha256 = hashlib.sha256(handle.read()).hexdigest()
+    except OSError:
+        return None
+    if artifact_sha256 != task_digest:
+        return None
+    return {
+        "path": path,
+        "artifact_sha256": artifact_sha256,
+        "validator_sha256": validator_sha256,
+        "source_policy_id": source_policy_id,
+        "passed": passed,
+        "terminal": terminal,
+        "retryable": retryable,
+    }
+
+
+def _restrict_research_child_tool_surface(child) -> None:
+    """Expose exactly the four controller-owned tools to a research child."""
+
+    child.tools = [
+        definition
+        for definition in child.tools
+        if definition.get("function", {}).get("name")
+        in _RESEARCH_CHILD_TOOL_NAMES
+    ]
+    child.valid_tool_names = {
+        definition["function"]["name"] for definition in child.tools
+    }
+    if child.valid_tool_names != _RESEARCH_CHILD_TOOL_NAMES:
+        missing = sorted(_RESEARCH_CHILD_TOOL_NAMES - child.valid_tool_names)
+        raise RuntimeError(
+            "parallel-research child is missing required model-visible "
+            f"tools: {', '.join(missing)}"
+        )
+
+
+def admit_research_tasks(parent_agent, task_list, top_role):
+    from agent.research_contract import get_parallel_research_activation, parse_research_artifact_contract, research_goal_names_subject
+    research_activation = get_parallel_research_activation(parent_agent)
+    task_research_contracts: list[Any] = []
+    seen_research_paths: set[str] = set()
+    for i, task in enumerate(task_list):
+        requested_role = _normalize_role(task.get('role') or top_role)
+        effective_role = 'leaf' if research_activation is not None else requested_role
+        descriptor = task.get('research_artifact')
+        if research_activation is not None and (requested_role != 'leaf' or effective_role != 'leaf'):
+            return (None, tool_error(f'Task {i} requests or resolves to a non-leaf role while the parallel-research controller is active.', status='rejected', code='research_leaf_required', retryable=True, executed=False))
+        if effective_role != 'leaf':
+            if descriptor is not None:
+                return (None, tool_error(f'Task {i} supplies research_artifact but is not a leaf.'))
+            task_research_contracts.append(None)
+            continue
+        if research_activation is None:
+            if descriptor is not None:
+                return (None, tool_error(f'Task {i} supplies research_artifact, but the canonical parallel-research skill is not active in this session.', status='rejected', code='research_skill_required', retryable=True, executed=False))
+            task_research_contracts.append(None)
+            continue
+        if descriptor is None:
+            return (None, tool_error(f'Task {i} is a leaf under active parallel-research policy and must include research_artifact with exact subject, path, and fields.', status='rejected', code='research_artifact_required', retryable=True, executed=False))
+        try:
+            contract = parse_research_artifact_contract(descriptor, research_activation)
+            if not research_goal_names_subject(task.get('goal'), contract.subject, artifact_path=contract.path):
+                return (None, tool_error(f'Task {i} goal must name the exact research_artifact.subject label {contract.subject!r}; do not use a slug, alias, or respelling in either field.', status='rejected', code='research_subject_goal_mismatch', retryable=True, executed=False))
+            if contract.path in seen_research_paths:
+                return (None, tool_error(f'Task {i} resolves to duplicate research_artifact path {contract.path!r}.', status='rejected', code='research_artifact_duplicate_path', retryable=True, executed=False))
+            seen_research_paths.add(contract.path)
+            task_research_contracts.append(contract)
+        except ValueError as exc:
+            return (None, tool_error(f'Task {i} research_artifact is invalid: {exc}', status='rejected', code='research_artifact_invalid', retryable=True, executed=False))
+    return (task_research_contracts, None)
+
+def attach_research_child(child, contract):
+    if contract is None:
+        return
+    from agent.research_contract import ResearchContractController
+    _restrict_research_child_tool_surface(child)
+    child._research_contract_controller = ResearchContractController(contract)
+
+
+def bind_research_child(child, task_id, started_monotonic, timeout_seconds):
+    child._research_execution_task_id = task_id
+    child._research_execution_started_monotonic = started_monotonic
+    _register_research_contract(child, task_id, task_started_monotonic=started_monotonic, child_timeout_seconds=timeout_seconds)
+
+
+def clear_research_child(child):
+    from tools.file_custody import unregister_task_write_allowlist
+    task_id = getattr(child, "_research_write_allowlist_task_id", None)
+    if isinstance(task_id, str) and task_id:
+        unregister_task_write_allowlist(task_id)
+        child._research_write_allowlist_task_id = None
+
+
+def attest_research_child(child, entry):
+    from agent.research_contract import get_research_controller, ResearchValidationResult
+    controller = get_research_controller(child)
+    if getattr(child, "_delegate_terminal_cancellation", False) is True:
+        entry.update(status="interrupted", exit_reason="interrupted", terminal=True, retryable=False,
+            cancellation_source="control_plane", cancellation_reason="Explicit subagent stop requested.")
+        entry.pop("_research_completion_attestation", None)
+        return entry
+    if controller is None:
+        return entry
+    try:
+        validation = controller.validate_completion(
+            child._research_execution_task_id,
+            since_monotonic=child._research_execution_started_monotonic,
+        )
+    except Exception as exc:
+        validation = ResearchValidationResult(False, "Research completion validation raised " + type(exc).__name__)
+    entry["research_artifact"] = {
+        "path":controller.contract.path, "valid":validation.passed,
+        "message":validation.message, "repair_paths":list(validation.repair_paths),
+        "terminal":validation.terminal, "retryable":validation.retryable,
+    }
+    if not validation.passed:
+        entry["status"] = "failed"
+        entry["error"] = validation.message
+        if validation.validator_output:
+            entry["error"] += "\n" + validation.validator_output
+    attestation = _research_completion_attestation(controller, validation)
+    if attestation is not None:
+        entry["_research_completion_attestation"] = attestation
+    return entry
+
+
+_RESEARCH_COMPLETION_ATTESTATION_KEYS = frozenset(
+    {
+        "path",
+        "artifact_sha256",
+        "validator_sha256",
+        "source_policy_id",
+        "passed",
+        "terminal",
+        "retryable",
+    }
+)
+
+
+
+def _sanitize_research_completion_attestation(value: Any) -> dict[str, Any] | None:
+    """Return the exact hidden attestation shape or fail closed."""
+
+    if not isinstance(value, dict) or set(value) != _RESEARCH_COMPLETION_ATTESTATION_KEYS:
+        return None
+    path = value.get("path")
+    artifact_sha256 = value.get("artifact_sha256")
+    validator_sha256 = value.get("validator_sha256")
+    source_policy_id = value.get("source_policy_id")
+    if (
+        not isinstance(path, str)
+        or not path
+        or "\x00" in path
+        or "\r" in path
+        or "\n" in path
+        or not isinstance(artifact_sha256, str)
+        or len(artifact_sha256) != 64
+        or any(char not in "0123456789abcdef" for char in artifact_sha256)
+        or not isinstance(validator_sha256, str)
+        or len(validator_sha256) != 64
+        or any(char not in "0123456789abcdef" for char in validator_sha256)
+        or not isinstance(source_policy_id, str)
+        or not source_policy_id
+        or type(value.get("passed")) is not bool
+        or type(value.get("terminal")) is not bool
+        or type(value.get("retryable")) is not bool
+    ):
+        return None
+    return {key: value[key] for key in _RESEARCH_COMPLETION_ATTESTATION_KEYS}
+
+
+def research_completion_payload(record, result):
+    public = dict(result)
+    public_results, attestations = [], []
+    raw_results = result.get("results") or []
+    valid = bool(raw_results)
+    for raw in raw_results:
+        if not isinstance(raw, dict):
+            valid = False
+            public_results.append(raw)
+            continue
+        entry = dict(raw)
+        attestation = _sanitize_research_completion_attestation(entry.pop("_research_completion_attestation", None))
+        public_results.append(entry)
+        if attestation is None:
+            valid = False
+        else:
+            attestations.append(attestation)
+    if "results" in result:
+        public["results"] = public_results
+    hidden = {}
+    if record.get("delivery_kind") == "parallel_research":
+        hidden = {"delivery_kind":"parallel_research", "_research_completion_attestations":attestations if valid and len(attestations) == len(raw_results) else []}
+    return public, hidden
+
+
+def reject_research_inline_fallback(batch, reason):
+    from agent.research_contract import get_research_controller
+    if not any(get_research_controller(child) is not None for _, _, child in batch.children):
+        return None
+    from tools.delegate_tool_child_run import _detach_child, _close_child
+    for _, _, child in batch.children:
+        clear_research_child(child)
+        _detach_child(batch.parent_agent, child)
+        _close_child(child, "Research dispatch could not start")
+    return tool_error("The controlled research wave requires background delivery: " + reason,
+                      status="rejected", code="research_background_unavailable", retryable=True, executed=False)
+
+
+import contextlib
+import threading
+from typing import Optional
+_BACKGROUND_WAVE_TURN_ATTR = "_delegate_background_wave_turn_id"
+_background_wave_admission_lock = threading.Lock()
+
+def _reserve_background_wave(parent_agent: Any) -> tuple[Optional[str], bool]:
+    """Reserve this persistent parent turn for one background wave.
+
+    The July 12 incident issued multiple singleton calls from one model turn,
+    bypassing the intended bounded-wave shape even though process capacity was
+    capped.  Reserve before child construction so concurrent/re-entrant calls
+    cannot both pass admission or emit phantom child lifecycle events.
+
+    Parents without a stable turn id retain legacy behavior; the runtime gives
+    every real model turn a non-empty ``_current_turn_id``.
+    """
+    turn_id = getattr(parent_agent, "_current_turn_id", "")
+    if not isinstance(turn_id, str) or not turn_id:
+        return None, True
+    with _background_wave_admission_lock:
+        if getattr(parent_agent, _BACKGROUND_WAVE_TURN_ATTR, None) == turn_id:
+            return turn_id, False
+        setattr(parent_agent, _BACKGROUND_WAVE_TURN_ATTR, turn_id)
+    return turn_id, True
+
+def _release_background_wave(parent_agent: Any, turn_id: Optional[str]) -> None:
+    """Release an unaccepted reservation without clearing a newer turn."""
+    if not turn_id:
+        return
+    with _background_wave_admission_lock:
+        if getattr(parent_agent, _BACKGROUND_WAVE_TURN_ATTR, None) == turn_id:
+            with contextlib.suppress(AttributeError):
+                delattr(parent_agent, _BACKGROUND_WAVE_TURN_ATTR)

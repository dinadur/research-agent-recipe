+    facet_synthesis_finalize.add_argument("--output-root", type=Path, required=True)
+    facet_synthesis_finalize.add_argument("--review-root", type=Path)
+    facet_synthesis_finalize.add_argument("--repair-response-root", type=Path)
+    extractive_finalize = subparsers.add_parser("extractive-finalize")
+    extractive_finalize.add_argument("--spec", type=Path, required=True)
+    extractive_finalize.add_argument("--store-root", type=Path, required=True)
+    extractive_finalize.add_argument("--row-root", type=Path, required=True)
+    extractive_finalize.add_argument("--output-root", type=Path, required=True)
+    finalize = subparsers.add_parser("finalize")
+    finalize.add_argument("--spec", type=Path, required=True)
+    finalize.add_argument("--store-root", type=Path, required=True)
+    finalize.add_argument("--response", type=Path, required=True)
+    finalize.add_argument("--output-root", type=Path, required=True)
+    finalize.add_argument("--row-root", type=Path)
+    args = parser.parse_args()
+    if args.command == "plan":
+        return _cli_plan(
+            args.input,
+            args.output_root,
+            args.model,
+            args.canary_id,
+        )
+    if args.command == "plan-finalize":
+        return _cli_plan_finalize(
+            args.input,
+            args.response,
+            args.output_root,
+        )
+    if args.command == "build":
+        return asyncio.run(
+            _live_build(
+                args.spec,
+                args.output_root,
+                args.model,
+                args.canary_id,
+                args.semantic_selection,
+            )
+        )
+    if args.command == "select-finalize":
+        return _cli_select_finalize(
+            args.spec,
+            args.store_root,
+            args.response,
+            args.output_root,
+            args.model,
+            args.canary_id,
+            args.extractive,
+        )
+    if args.command == "synthesis-prepare":
+        return _cli_synthesis_prepare(
+            args.spec,
+            args.row_root,
+            args.output_root,
+            args.model,
+            args.canary_id,
+        )
+    if args.command == "facet-synthesis-prepare":
+        return _cli_facet_synthesis_prepare(
+            args.spec,
+            args.row_root,
+            args.output_root,
+            args.model,
+            args.canary_id,
+        )
+    if args.command == "facet-synthesis-review":
+        return _cli_facet_synthesis_review(
+            args.spec,
+            args.row_root,
+            args.response_root,
+            args.output_root,
+            args.model,
+            args.canary_id,
+        )
+    if args.command == "facet-synthesis-finalize":
+        return _cli_facet_synthesis_finalize(
+            args.spec,
+            args.store_root,
+            args.row_root,
+            args.response_root,
+            args.output_root,
+            args.review_root,
+            args.repair_response_root,
+        )
+    if args.command == "extractive-finalize":
+        return _cli_extractive_finalize(
+            args.spec,
+            args.store_root,
+            args.row_root,
+            args.output_root,
+        )
+    return _cli_finalize(
+        args.spec,
+        args.store_root,
+        args.response,
+        args.output_root,
+        args.row_root,
+    )
+
+
+__all__ = [
+    "ReferenceStoreError",
+    "build_planning_prompt",

+    validate_facet_synthesis_response,
+    validate_synthesis_response,
+)
+
+
+def spec() -> dict:
+    return {
+        "schema_version": 1,
+        "kind": "hermes-code-owned-reference-store",
+        "title": "Python asyncio cancellation",
+        "request": (
+            "Research how Python asyncio cancellation, TaskGroup, and timeout "
+            "interact and give practical operating recommendations."
+        ),
+        "retrieval_date": "2026-07-16",
+        "allowed_hosts": ["docs.python.org"],
+        "facets": [
+            {
+                "marker": "CANCEL",
+                "label": "asyncio task cancellation",
+                "queries": ["site:docs.python.org asyncio task cancellation"],
+                "anchors": ["cancel", "CancelledError", "uncancel"],
+            },
+            {
+                "marker": "GROUP",
+                "label": "asyncio TaskGroup structured concurrency",
+                "queries": ["site:docs.python.org asyncio TaskGroup structured concurrency"],
+                "anchors": ["TaskGroup", "task group", "structured concurrency"],
+            },
+            {
+                "marker": "TIMEOUT",
+                "label": "asyncio timeout context manager",
+                "queries": ["site:docs.python.org asyncio timeout context manager"],
+                "anchors": ["timeout", "reschedule"],
+            },
+        ],
+    }
+
+
+def planning_input() -> dict:
+    return {
+        "schema_version": 1,
+        "kind": "hermes-reference-store-planning-input",
+        "request": (
+            "Research Python asyncio cancellation, TaskGroup, and timeout using "
+            "official documentation and give practical recommendations."
+        ),
+        "retrieval_date": "2026-07-16",
+        "allowed_hosts": ["docs.python.org"],
+    }
+
+
+def valid_planning_http_response(*, wrapper: bool = False) -> dict:
+    packet = {
+        "schema_version": 1,
+        "title": "Python asyncio cancellation controls",
+        "facets": [
+            {
+                "marker": "F1",
+                "label": "Task cancellation and cleanup",
+                "queries": [
+                    "site:docs.python.org asyncio task cancellation CancelledError cleanup"
+                ],
+                "anchors": ["cancellation", "CancelledError", "cleanup"],
+            },
+            {
+                "marker": "F2",
+                "label": "TaskGroup structured concurrency",
+                "queries": [
+                    "site:docs.python.org asyncio TaskGroup structured concurrency"
+                ],
+                "anchors": ["TaskGroup", "structured concurrency", "exception group"],
+            },
+            {
+                "marker": "F3",
+                "label": "Timeout context management",
+                "queries": [
+                    "site:docs.python.org asyncio timeout context manager reschedule"
+                ],
+                "anchors": ["timeout", "context manager", "reschedule"],
+            },
+        ],
+    }
+    content = json.dumps(packet)
+    if wrapper:
+        content = "<think>\n</think>\n" + content
+    return {"choices": [{"message": {"content": content}}]}
+
+
+def valid_semantic_selection_http_response(
+    candidate_store: dict, *, wrapper: bool = False
+) -> dict:
+    by_facet: dict[str, list[str]] = {}
+    for row in candidate_store["candidates"]:
+        by_facet.setdefault(row["facet"], []).append(row["candidate_id"])
+    packet = {
+        "schema_version": 1,
+        "facets": [
+            {"marker": marker, "candidate_ids": by_facet[marker][:4]}
+            for marker in by_facet
+        ],
+    }
+    content = json.dumps(packet)
+    if wrapper:
+        content = "<think>\n</think>\n" + content
+    return {"choices": [{"message": {"content": content}}]}

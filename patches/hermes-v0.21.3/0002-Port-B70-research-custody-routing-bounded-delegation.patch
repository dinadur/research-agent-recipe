new file mode 100644
index 000000000..df8288a40
--- /dev/null
+++ b/agent/research_harness/travel_runner.py
@@ -0,0 +1,240 @@
+"""Versioned façade over the accepted travel-planning controller."""
+
+from __future__ import annotations
+
+import argparse
+import json
+import re
+import subprocess
+import sys
+from pathlib import Path
+from typing import Sequence
+
+from agent.research_harness.artifacts import (
+    atomic_write_json,
+    load_json_object,
+    sha256_file,
+)
+from agent.research_harness.protocol import (
+    DOMAIN_RUNNER_SCHEMA_VERSION,
+    DomainRunResult,
+    TRAVEL_DOMAIN,
+    TRAVEL_RUN_RESULT_NAME,
+    TravelRunRequest,
+    travel_raw_root,
+)
+from hermes_constants import get_hermes_home
+
+
+ACCEPTED_TRAVEL_SKILL_VERSION = "2.9.0"
+ACCEPTED_TRAVEL_CONTROLLER_SHA256 = (
+    "5e30169a3888529d645adf281d8d40392473f417bdecdc3fc38e1ea63b8b4b58"
+)
+RUNNER_CONTROLLER_TIMEOUT_SECONDS = 870
+_VERSION_RE = re.compile(r"^version:\s*([^\s#]+)\s*$", re.MULTILINE)
+
+
+def _controller_path() -> Path:
+    return (
+        get_hermes_home()
+        / "skills"
+        / "travel-planning"
+        / "scripts"
+        / "run_hermes_travel_pipeline.py"
+    ).resolve()
+
+
+def _skill_version(controller: Path) -> str | None:
+    skill_file = controller.parent.parent / "SKILL.md"
+    try:
+        text = skill_file.read_text(encoding="utf-8")
+    except (OSError, UnicodeError):
+        return None
+    match = _VERSION_RE.search(text)
+    return match.group(1) if match else None
+
+
+def _artifact_path(run_dir: Path, name: str) -> str | None:
+    path = run_dir / name
+    return str(path) if path.is_file() else None
+
+
+def accepted_controller_status(
+    *,
+    controller: Path | None = None,
+    expected_controller_sha256: str = ACCEPTED_TRAVEL_CONTROLLER_SHA256,
+) -> dict[str, object]:
+    """Return one machine-readable predeploy check for the installed pin."""
+
+    controller_path = (controller or _controller_path()).resolve()
+    exists = controller_path.is_file()
+    version = _skill_version(controller_path) if exists else None
+    digest = sha256_file(controller_path) if exists else None
+    return {
+        "pass": bool(
+            exists
+            and version == ACCEPTED_TRAVEL_SKILL_VERSION
+            and digest == expected_controller_sha256
+        ),
+        "controller": str(controller_path),
+        "exists": exists,
+        "expected_skill_version": ACCEPTED_TRAVEL_SKILL_VERSION,
+        "actual_skill_version": version,
+        "expected_controller_sha256": expected_controller_sha256,
+        "actual_controller_sha256": digest,
+    }
+
+
+def _result_status(run_dir: Path, returncode: int) -> tuple[str, str | None]:
+    publication_result = run_dir / "publication-result.json"
+    receipt = run_dir / "publication-receipt.json"
+    report = run_dir / "run-report.json"
+    if publication_result.is_file():
+        return "already_published", None
+    if returncode == 0 and receipt.is_file():
+        return "ready_for_approval", None
+    if returncode == 0:
+        return "failed", "controller exited successfully without a publication receipt"
+    if report.is_file():
+        try:
+            report_value = load_json_object(report)
+        except ValueError:
+            report_value = {}
+        if report_value.get("pass") is False:
+            return "withheld", "controller rejected the run at an integrity gate"
+    return "failed", f"controller exited with status {returncode}"
+
+
+def run_travel_request(
+    request: TravelRunRequest,
+    *,
+    controller: Path | None = None,
+    expected_controller_sha256: str = ACCEPTED_TRAVEL_CONTROLLER_SHA256,
+    timeout_seconds: int = RUNNER_CONTROLLER_TIMEOUT_SECONDS,
+) -> tuple[DomainRunResult, subprocess.CompletedProcess[str]]:
+    """Run the pinned controller and persist one stable domain result."""
+
+    controller_path = (controller or _controller_path()).resolve()
+    version = _skill_version(controller_path)
+    digest = sha256_file(controller_path) if controller_path.is_file() else None
+    request.run_dir.mkdir(parents=True, exist_ok=True)
+
+    if not controller_path.is_file():
+        completed = subprocess.CompletedProcess([], 2, "", "travel controller is missing")
+        status, error = "failed", "travel controller is missing"
+    elif version != ACCEPTED_TRAVEL_SKILL_VERSION:
+        completed = subprocess.CompletedProcess([], 2, "", "travel skill version mismatch")
+        status, error = (
+            "failed",
+            "travel skill version mismatch: "
+            f"expected {ACCEPTED_TRAVEL_SKILL_VERSION}, found {version or 'unknown'}",
+        )
+    elif digest != expected_controller_sha256:
+        completed = subprocess.CompletedProcess([], 2, "", "travel controller hash mismatch")
+        status, error = (
+            "failed",
+            "travel controller hash mismatch: "
+            f"expected {expected_controller_sha256}, found {digest or 'unknown'}",
+        )
+    else:
+        command = [
+            sys.executable,
+            str(controller_path),
+            str(request.manifest_path),
+            str(request.run_dir),
+        ]
+        try:
+            completed = subprocess.run(
+                command,
+                check=False,
+                capture_output=True,
+                text=True,
+                timeout=timeout_seconds,
+            )
+            status, error = _result_status(request.run_dir, completed.returncode)
+        except subprocess.TimeoutExpired as exc:
+            stdout = exc.stdout.decode() if isinstance(exc.stdout, bytes) else (exc.stdout or "")
+            stderr = exc.stderr.decode() if isinstance(exc.stderr, bytes) else (exc.stderr or "")
+            completed = subprocess.CompletedProcess(command, 124, stdout, stderr)
+            status, error = "failed", f"controller exceeded {timeout_seconds} seconds"
+
+    result = DomainRunResult(
+        schema_version=DOMAIN_RUNNER_SCHEMA_VERSION,
+        domain=TRAVEL_DOMAIN,
+        request_id=request.request_id,
+        status=status,  # type: ignore[arg-type]
+        manifest_path=str(request.manifest_path),
+        run_dir=str(request.run_dir),
+        controller_exit_code=completed.returncode,
+        receipt_path=_artifact_path(request.run_dir, "publication-receipt.json"),
+        report_path=_artifact_path(request.run_dir, "run-report.json"),
+        state_path=_artifact_path(request.run_dir, "run-state.json"),
+        publication_result_path=_artifact_path(
+            request.run_dir, "publication-result.json"
+        ),
+        controller_skill_version=version,
+        controller_sha256=digest,
+        error=error,
+    )
+    atomic_write_json(request.run_dir / TRAVEL_RUN_RESULT_NAME, result.to_dict())
+    return result, completed
+
+
+def build_parser() -> argparse.ArgumentParser:
+    parser = argparse.ArgumentParser(
+        description="Run a versioned travel research request through the accepted controller."
+    )
+    parser.add_argument(
+        "request",
+        nargs="?",
+        type=Path,
+        help="Absolute raw/travel path to a schema-version-1 request JSON file.",
+    )
+    parser.add_argument(
+        "--verify-pin",
+        action="store_true",
+        help="Verify the installed travel skill version and controller hash, then exit.",
+    )
+    return parser
+
+
+def main(argv: Sequence[str] | None = None) -> int:
+    parser = build_parser()
+    args = parser.parse_args(argv)
+    if args.verify_pin:
+        status = accepted_controller_status()
+        print(json.dumps(status, indent=2))
+        return 0 if status["pass"] is True else 2
+    if args.request is None:
+        parser.error("request is required unless --verify-pin is used")
+    try:
+        request = TravelRunRequest.from_file(args.request, raw_root=travel_raw_root())
+        result, completed = run_travel_request(request)
+    except ValueError as exc:
+        print(f"TRAVEL_RESEARCH_RUNNER_ERROR {exc}", file=sys.stderr)
+        return 2
+
+    if completed.stdout:
+        print(completed.stdout, end="" if completed.stdout.endswith("\n") else "\n")
+    if completed.stderr:
+        print(completed.stderr, file=sys.stderr, end="" if completed.stderr.endswith("\n") else "\n")
+    if result.status in {"ready_for_approval", "already_published"}:
+        return 0
+    if result.error:
+        print(f"TRAVEL_RESEARCH_RUNNER_ERROR {result.error}", file=sys.stderr)
+    return completed.returncode or 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
+
+
+__all__ = [
+    "ACCEPTED_TRAVEL_SKILL_VERSION",
+    "ACCEPTED_TRAVEL_CONTROLLER_SHA256",
+    "RUNNER_CONTROLLER_TIMEOUT_SECONDS",
+    "accepted_controller_status",
+    "build_parser",
+    "main",
+    "run_travel_request",
+]
diff --git a/agent/research_loop.py b/agent/research_loop.py
new file mode 100644
index 000000000..79e33b308
--- /dev/null
+++ b/agent/research_loop.py
@@ -0,0 +1,855 @@
+"""Bounded B70 research phases on the upstream loop-state interface.
+
+These phases own research transitions only. Provider retries, tool cancellation,
+ordinary conversations, token accounting and persistence remain upstream.
+"""
+from __future__ import annotations
+import json
+import logging
+import uuid
+from typing import Any, Optional
+logger = logging.getLogger(__name__)
+
+def _background_delegation_dispatch_payload(
+    tool_calls: list[Any], tool_result_messages: list[dict[str, Any]]
+) -> Optional[dict[str, Any]]:
+    """Return a syntactic background-dispatch payload for this tool batch."""
+    delegate_ids = {
+        str(getattr(tc, "id", "") or "")
+        for tc in tool_calls
+        if getattr(getattr(tc, "function", None), "name", None)
+        == "delegate_task"
+    }
+    delegate_ids.discard("")
+    if not delegate_ids:
+        return None
+
+    for message in tool_result_messages:
+        if (
+            not isinstance(message, dict)
+            or message.get("role") != "tool"
+            or str(message.get("tool_call_id") or "") not in delegate_ids
+        ):
+            continue
+        try:
+            payload = json.loads(str(message.get("content") or ""))
+        except (TypeError, ValueError, json.JSONDecodeError):
+            continue
+        if (
+            isinstance(payload, dict)
+            and payload.get("status") == "dispatched"
+        ):
+            return payload
+    return None
+
+
+def _successful_background_delegation_receipt(
+    tool_calls: list[Any], tool_result_messages: list[dict[str, Any]]
+) -> Optional[dict[str, Any]]:
+    """Return the exact successful persistent-dispatch receipt, if any."""
+
+    payload = _background_delegation_dispatch_payload(
+        tool_calls, tool_result_messages
+    )
+    if (
+        isinstance(payload, dict)
+        and payload.get("mode") == "background"
+        and isinstance(payload.get("count"), int)
+        and not isinstance(payload.get("count"), bool)
+        and payload["count"] > 0
+        and isinstance(payload.get("delegation_id"), str)
+        and payload["delegation_id"].strip()
+    ):
+        return payload
+    return None
+
+
+def _authenticated_terminal_research_response(
+    agent: Any,
+) -> Optional[str]:
+    """Return the controller-owned stop text for exact terminal raw state.
+
+    Empty-response recovery runs before ordinary final-answer validation. An
+    authenticated blocked or exhausted raw corpus is already terminal, so a
+    provider retry cannot improve it and must not create another API epoch.
+    """
+
+    try:
+        from agent.research_synthesis import (
+            SYNTHESIS_WITHHELD_RESPONSE,
+            authenticated_parent_raw_validation,
+        )
+
+        raw_validation = authenticated_parent_raw_validation(agent)
+    except Exception:
+        logger.debug(
+            "research raw-state pre-empty check failed",
+            exc_info=True,
+        )
+        return None
+    if (
+        raw_validation is not None
+        and raw_validation.status in {"blocked", "exhausted"}
+    ):
+        return SYNTHESIS_WITHHELD_RESPONSE
+    return None
+
+
+def _background_delegation_terminal_text(receipt: dict[str, Any]) -> str:
+    """Build the concise assistant receipt that closes the parent turn."""
+    count = int(receipt["count"])
+    noun = "task" if count == 1 else "tasks"
+    delegation_id = str(receipt.get("delegation_id") or "").strip()
+    return (
+        f"Dispatched {count} background {noun} as one bounded wave "
+        f"({delegation_id}). This turn is closed; the consolidated result "
+        "will return here automatically."

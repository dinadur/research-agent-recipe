+
+def _research_decision_ledger_entry_coherent(entry: Mapping[str, Any]) -> bool:
+    """Accept only field combinations reachable from the response pipeline."""
+
+    finish_reason = entry["finish_reason"]
+    count = entry["tool_call_count"]
+    name_match = entry["current_phase_name_match"]
+    provider_valid = entry["provider_ids_valid"]
+    arguments_valid = entry["arguments_json_valid"]
+    decision = entry["controller_decision_code"]
+    category = entry["failure_category"]
+
+    if name_match is True and count != 1:
+        return False
+    if count == 1 and type(name_match) is not bool:
+        return False
+    if count == 0 and name_match is not None:
+        return False
+    if type(count) is int and count >= 2 and name_match is not False:
+        return False
+    if arguments_valid is not None and provider_valid is not True:
+        return False
+    if provider_valid is False and arguments_valid is not None:
+        return False
+    if category not in {"content_filter", "length_or_incomplete"} and finish_reason in {
+        "content_filter",
+        "length",
+        "incomplete",
+    }:
+        return False
+
+    if category == "other" or decision == "other":
+        return True
+    if category == "no_tool_call":
+        return bool(
+            count in {0, None}
+            and name_match is None
+            and provider_valid is None
+            and arguments_valid is None
+            and decision == "not_evaluated"
+            and finish_reason not in {"content_filter", "length", "incomplete"}
+        )
+    if category == "length_or_incomplete":
+        return bool(
+            finish_reason in {"length", "incomplete"}
+            and provider_valid is None
+            and arguments_valid is None
+            and decision == "not_evaluated"
+        )
+    if category == "content_filter":
+        return bool(
+            finish_reason == "content_filter"
+            and provider_valid is None
+            and arguments_valid is None
+            and decision == "not_evaluated"
+        )
+    if category == "provider_id_invalid":
+        return bool(
+            count != 0
+            and provider_valid is False
+            and arguments_valid is None
+            and decision == "not_evaluated"
+        )
+    if category == "tool_name_invalid":
+        return bool(
+            count != 0
+            and name_match is False
+            and provider_valid is True
+            and arguments_valid is None
+            and decision == "not_evaluated"
+        )
+    if category == "arguments_json_invalid":
+        return bool(
+            count != 0
+            and provider_valid is True
+            and arguments_valid is False
+            and decision == "not_evaluated"
+        )
+    if category == "tool_call_count_invalid":
+        return bool(
+            count not in {0, 1}
+            and name_match is False
+            and provider_valid is True
+            and arguments_valid is True
+            and decision == "research_predispatch_single_call_required"
+        )
+    if category == "phase_name_mismatch":
+        return bool(
+            count == 1
+            and name_match is False
+            and provider_valid is True
+            and arguments_valid is True
+            and decision == "research_predispatch_phase_mismatch"
+        )
+    if category == "none":
+        return bool(
+            count == 1
+            and type(name_match) is bool
+            and provider_valid is True
+            and arguments_valid is True
+            and decision == "admitted"
+        )
+    if category == "contract_rejected":
+        return bool(
+            count == 1
+            and type(name_match) is bool
+            and provider_valid is True
+            and arguments_valid is True
+            and decision
+            in {
+                "research_parent_dispatch_contract_invalid",
+                "research_parent_dispatch_pending",
+                "research_parent_dispatch_required",
+                "research_parent_wave_pending",
+                "research_skill_required",
+            }
+        )
+    if category == "admission_failed":
+        return bool(
+            count == 1
+            and type(name_match) is bool
+            and provider_valid is True
+            and arguments_valid is True
+            and decision == "research_predispatch_admission_failed"
+        )
+    if category in {"pending", "abnormal_exit"}:
+        return bool(
+            count != 0
+            and provider_valid is not False
+            and arguments_valid is not False
+            and decision == "not_evaluated"
+        )
+    return False
+
+
+def sanitize_parallel_research_predispatch_decision_ledger(
+    value: Any,
+) -> dict[str, Any] | None:
+    """Return a strict fresh projection or reject the entire envelope."""
+
+    if not isinstance(value, Mapping) or set(value) != {
+        "schema_version",
+        "entries",
+        "overflowed",
+    }:
+        return None
+    if (
+        type(value.get("schema_version")) is not int
+        or value.get("schema_version") != 1
+        or type(value.get("overflowed")) is not bool
+    ):
+        return None
+    entries = value.get("entries")
+    if (
+        not isinstance(entries, list)
+        or len(entries) > _RESEARCH_DECISION_LEDGER_MAX_ENTRIES
+    ):
+        return None
+
+    safe_entries: list[dict[str, Any]] = []
+    for entry in entries:
+        if (
+            not isinstance(entry, Mapping)
+            or set(entry) != _RESEARCH_DECISION_LEDGER_ENTRY_KEYS
+        ):
+            return None
+        finish_reason = entry.get("finish_reason")
+        tool_call_count = entry.get("tool_call_count")
+        phase_name_match = entry.get("current_phase_name_match")
+        provider_ids_valid = entry.get("provider_ids_valid")
+        arguments_json_valid = entry.get("arguments_json_valid")
+        controller_code = entry.get("controller_decision_code")
+        failure_category = entry.get("failure_category")
+        if (
+            type(finish_reason) is not str
+            or finish_reason not in _RESEARCH_DECISION_LEDGER_FINISH_REASONS
+        ):
+            return None
+        if not (
+            tool_call_count is None
+            or (
+                type(tool_call_count) is int
+                and 0 <= tool_call_count <= _RESEARCH_DECISION_LEDGER_MAX_TOOL_CALLS
+            )
+        ):
+            return None
+        if any(
+            item is not None and type(item) is not bool
+            for item in (
+                phase_name_match,
+                provider_ids_valid,
+                arguments_json_valid,
+            )
+        ):
+            return None
+        if (
+            type(controller_code) is not str
+            or controller_code not in _RESEARCH_DECISION_LEDGER_CONTROLLER_CODES
+        ):
+            return None
+        if (
+            type(failure_category) is not str
+            or failure_category not in _RESEARCH_DECISION_LEDGER_FAILURE_CATEGORIES
+        ):
+            return None
+        if not _research_decision_ledger_entry_coherent(entry):
+            return None
+        safe_entries.append(
+            {
+                "finish_reason": finish_reason,
+                "tool_call_count": tool_call_count,
+                "current_phase_name_match": phase_name_match,
+                "provider_ids_valid": provider_ids_valid,
+                "arguments_json_valid": arguments_json_valid,
+                "controller_decision_code": controller_code,
+                "failure_category": failure_category,
+            }
+        )
+
+    safe = {
+        "schema_version": 1,
+        "entries": safe_entries,
+        "overflowed": value["overflowed"],
+    }
+    encoded = json.dumps(
+        safe,
+        ensure_ascii=True,
+        sort_keys=True,
+        separators=(",", ":"),
+    ).encode("utf-8")
+    return safe if len(encoded) <= _RESEARCH_DECISION_LEDGER_MAX_BYTES else None
+
+
+def emit_parallel_research_predispatch_decision_ledger(
+    agent: Any,
+) -> dict[str, Any] | None:
+    """Consume and optionally log one strict canary-only ledger envelope."""
+
+    with _PARALLEL_RESEARCH_DECISION_LEDGER_LOCK:
+        current_turn_id = getattr(agent, "_current_turn_id", None)
+        ledger_turn_id = getattr(
+            agent,
+            "_parallel_research_predispatch_decision_ledger_turn_id",
+            None,
+        )
+        entries = getattr(
+            agent,
+            "_parallel_research_predispatch_decision_ledger_entries",
+            None,
+        )
+        if (
+            not _research_decision_ledger_enabled()
+            or not isinstance(current_turn_id, str)
+            or current_turn_id != ledger_turn_id
+            or not isinstance(entries, list)
+        ):
+            _reset_parallel_research_predispatch_decision_ledger(agent)
+            return None
+        pending_index = getattr(
+            agent,
+            "_parallel_research_predispatch_decision_ledger_pending_index",
+            None,
+        )
+        if (
+            type(pending_index) is int
+            and 0 <= pending_index < len(entries)
+            and isinstance(entries[pending_index], dict)
+            and entries[pending_index].get("failure_category") == "pending"
+        ):
+            entries[pending_index]["failure_category"] = "abnormal_exit"
+        candidate = {
+            "schema_version": 1,
+            "entries": copy.deepcopy(entries),
+            "overflowed": bool(
+                getattr(
+                    agent,
+                    "_parallel_research_predispatch_decision_ledger_overflowed",
+                    False,
+                )
+                is True
+            ),
+        }
+        _reset_parallel_research_predispatch_decision_ledger(agent)
+
+    safe = sanitize_parallel_research_predispatch_decision_ledger(candidate)
+    if safe is None:
+        return None
+    encoded = json.dumps(
+        safe,
+        ensure_ascii=True,
+        sort_keys=True,
+        separators=(",", ":"),
+    )
+    try:
+        logging.getLogger(RESEARCH_DECISION_LEDGER_LOGGER).info(
+            "%s%s", RESEARCH_DECISION_LEDGER_LOG_PREFIX, encoded
+        )
+    except BaseException:
+        # Diagnostics may never break or replace the research turn result.
+        pass
+    return safe
+
+
+def _json_object(value: Any) -> dict[str, Any] | None:
+    if isinstance(value, dict):
+        return value
+    if not isinstance(value, str):
+        return None
+    try:
+        parsed = json.loads(value)
+    except (TypeError, ValueError, json.JSONDecodeError):
+        return None
+    return parsed if isinstance(parsed, dict) else None
+
+
+def _read_result_matches_bytes(content: str, raw: bytes) -> bool:
+    """Prove a complete read_file gutter exposes the exact UTF-8 bytes."""
+
+    try:
+        text = raw.decode("utf-8")
+    except UnicodeDecodeError:
+        return False
+    if text.startswith("\ufeff"):
+        text = text[1:]
+    source_lines = text.splitlines()
+    if raw.endswith(b"\n"):
+        source_lines.append("")
+    visible_lines = content.splitlines()
+    if len(visible_lines) != len(source_lines):
+        return False
+    return all(
+        visible == f"{line_number}|{source}"
+        for line_number, (visible, source) in enumerate(
+            zip(visible_lines, source_lines), start=1
+        )
+    )
+
+
+def _sha256_bytes(value: bytes) -> str:
+    return hashlib.sha256(value).hexdigest()
+
+
+def canonical_research_subject_slug(value: Any) -> str:
+    """Return the one controller-owned slug for an explicit typed subject.
+
+    This intentionally mirrors the skill's ASCII slug contract rather than
+    attempting transliteration or inferring an entity from prose. A subject
+    that cannot produce one complete, bounded slug is rejected before I/O.
+    """
+
+    if (
+        not isinstance(value, str)
+        or not value.strip()
+        or len(value.strip()) > 160
+        or "\x00" in value
+        or "\r" in value
+        or "\n" in value
+    ):
+        raise ValueError(
+            "research_artifact.subject must be a non-empty single-line "
+            "explicit subject label of at most 160 characters"
+        )
+    slug = _SUBJECT_SLUG_SEPARATOR_RE.sub("-", value.strip().lower()).strip("-")
+    if not slug:
+        raise ValueError(
+            "research_artifact.subject must produce a non-empty ASCII slug"
+        )
+    if len(slug) > 64:
+        raise ValueError("research_artifact.subject slug must be at most 64 characters")
+    return slug
+
+
+def research_goal_names_subject(
+    goal: Any,
+    subject: Any,
+    *,
+    artifact_path: Any = "",
+) -> bool:
+    """Whether goal prose contains the normalized typed-subject token span.
+
+    The typed artifact path is removed first so repeating a misspelled slug in
+    an output-path instruction cannot ratify a subject that disagrees with the
+    human-readable entity named by the goal.
+    """
+
+    if not isinstance(goal, str) or not isinstance(subject, str):
+        return False
+    normalized_subject = " ".join(
+        part
+        for part in _SUBJECT_LABEL_SEPARATOR_RE.split(subject.casefold().strip())
+        if part
+    )
+    goal_without_artifact_path = goal.casefold()
+    if isinstance(artifact_path, str) and artifact_path:
+        goal_without_artifact_path = goal_without_artifact_path.replace(
+            artifact_path.casefold(), " "
+        )
+    normalized_goal = " ".join(
+        part
+        for part in _SUBJECT_LABEL_SEPARATOR_RE.split(
+            goal_without_artifact_path.strip()
+        )
+        if part
+    )
+    if not normalized_subject or not normalized_goal:
+        return False
+    return f" {normalized_subject} " in f" {normalized_goal} "
+
+
+def _https_urls_in_text(value: Any) -> set[str]:
+    """Normalized https URLs appearing anywhere in a retrieval result.
+
+    Deliberately regex-free: split on whitespace and strip the punctuation that
+    commonly abuts a URL in prose or JSON. A character class for this is easy to
+    get subtly wrong, and a wrong one here would silently widen provenance.
+    """
+    if value is None:
+        return set()
+    text = value if isinstance(value, str) else str(value)
+    found: set[str] = set()
+    for token in text.replace(",", " ").replace("\n", " ").split():
+        idx = token.find("https://")
+        if idx < 0:
+            continue
+        candidate = token[idx:]
+        # Strip until stable: trailing ").", "]," etc. need more than one pass,
+        # and a malformed URL here would grant provenance to something that was
+        # never actually linked.
+        while True:
+            stripped = candidate.strip("\"'<>()[]{}\\").strip(".,;:!?")
+            if stripped == candidate:
+                break
+            candidate = stripped
+        if len(candidate) <= len("https://"):
+            continue
+        normalized = _normalize_https_url(candidate)
+        if normalized:
+            found.add(normalized)
+    return found
+
+
+def _normalize_https_url(value: Any) -> str:
+    """Match the immutable validator's harmless URL canonicalization."""
+
+    if not isinstance(value, str):
+        return ""
+    candidate = value.strip().rstrip(".,;:!?")
+    try:
+        parts = urlsplit(candidate)
+    except ValueError:
+        return ""
+    if parts.scheme.casefold() != "https" or not parts.netloc:
+        return ""
+    path = parts.path.rstrip("/") or "/"
+    return urlunsplit(
+        (parts.scheme.lower(), parts.netloc.lower(), path, parts.query, parts.fragment)
+    )
+
+
+def research_source_policy_allows_url(policy_id: Any, value: Any) -> bool:
+    """Apply the shared HTTPS admission matcher for a frozen source policy."""
+
+    normalized = _normalize_https_url(value)
+    if not normalized:
+        return False
+    if policy_id == SOURCE_POLICY_UNRESTRICTED:
+        return True
+    if policy_id != SOURCE_POLICY_OFFICIAL_KUBERNETES_DOCS:
+        return False
+    try:
+        parts = urlsplit(normalized)
+        port = parts.port
+    except ValueError:
+        return False
+    if parts.username is not None or parts.password is not None:
+        return False
+    if port not in (None, 443):
+        return False
+    hostname = (parts.hostname or "").casefold()
+    if not (
+        hostname == "kubernetes.io"
+        or _KUBERNETES_VERSIONED_DOCS_HOST_RE.fullmatch(hostname) is not None
+    ):
+        return False
+    return _KUBERNETES_DOCS_PATH_RE.match(parts.path or "/") is not None
+
+
+def _filter_retrieval_result_for_source_policy(
+    tool_name: str,
+    result: Any,
+    policy_id: str,
+) -> Any:
+    """Remove disallowed structured retrieval rows before child observation."""
+
+    if policy_id == SOURCE_POLICY_UNRESTRICTED:
+        return result
+
+    def unusable_shape() -> Any:
+        sanitized = {
+            "success": False,
+            "status": "unusable",
+            "code": "research_source_policy_result_shape",
+            "retryable": True,
+            "error": (
+                f"{tool_name} result was withheld because it did not match the "
+                "controller-required structured retrieval shape."
+            ),
+            "research_source_policy": {
+                "id": policy_id,
+                "result_shape_valid": False,
+            },
+        }
+        return (
+            sanitized
+            if isinstance(result, dict)
+            else json.dumps(sanitized, ensure_ascii=False)
+        )
+
+    payload = _json_object(result)
+    if payload is None:
+        return unusable_shape()
+    augmented = dict(payload)
+    removed = 0
+    if tool_name == "web_search":
+        data = payload.get("data")
+        rows = data.get("web") if isinstance(data, dict) else None
+        if not isinstance(rows, list):
+            return unusable_shape()
+        admitted = [
+            row
+            for row in rows
+            if isinstance(row, dict)
+            and research_source_policy_allows_url(policy_id, row.get("url"))
+        ]
+        removed = len(rows) - len(admitted)
+        augmented["data"] = {**data, "web": admitted}
+    elif tool_name == "web_extract":
+        rows = payload.get("results")
+        if not isinstance(rows, list):
+            return unusable_shape()
+        admitted = [
+            row
+            for row in rows
+            if isinstance(row, dict)
+            and research_source_policy_allows_url(policy_id, row.get("url"))
+        ]
+        removed = len(rows) - len(admitted)
+        augmented["results"] = admitted
+    else:
+        return result
+    if removed:
+        augmented["research_source_policy"] = {
+            "id": policy_id,
+            "filtered_rows": removed,
+        }
+    return (
+        augmented
+        if isinstance(result, dict)
+        else json.dumps(augmented, ensure_ascii=False)
+    )
+
+
+def _cited_source_policy_violations(content: bytes, policy_id: str) -> set[str]:
+    if policy_id == SOURCE_POLICY_UNRESTRICTED:
+        return set()
+    try:
+        text = content.decode("utf-8")
+    except UnicodeDecodeError:
+        return {"[artifact is not valid UTF-8]"}
+    violations: set[str] = set()
+    for match in _WEB_CITATION_RE.finditer(text):
+        candidate = match.group(0).strip().rstrip(".,;:!?")
+        if not research_source_policy_allows_url(policy_id, candidate):
+            violations.add(candidate)
+    return violations
+
+
+def _cited_https_urls(content: bytes) -> set[str]:
+    """Extract Markdown/plain-text HTTPS citations from immutable artifact bytes."""
+
+    try:
+        text = content.decode("utf-8")
+    except UnicodeDecodeError:
+        return set()
+    return {
+        _normalize_https_url(match.group(0))
+        for match in _HTTPS_CITATION_RE.finditer(text)
+        if _normalize_https_url(match.group(0))
+    }
+
+
+def _cited_https_url_lines(content: bytes) -> dict[str, tuple[int, ...]]:
+    """Map normalized cited URLs to exact one-based artifact line numbers."""
+
+    try:
+        text = content.decode("utf-8")
+    except UnicodeDecodeError:
+        return {}
+    by_url: dict[str, list[int]] = {}
+    for line_number, line in enumerate(text.splitlines(), start=1):
+        for match in _HTTPS_CITATION_RE.finditer(line):
+            url = _normalize_https_url(match.group(0))
+            if url:
+                by_url.setdefault(url, []).append(line_number)
+    return {
+        url: tuple(dict.fromkeys(line_numbers)) for url, line_numbers in by_url.items()
+    }
+
+
+def _successful_retrieval_urls(
+    tool_name: str,
+    args: Mapping[str, Any],
+    result: Any,
+    *,
+    failed: bool,
+) -> set[str]:
+    """Extract only URLs proven successful by a structured web-tool receipt."""
+
+    if failed:
+        return set()
+    payload = _json_object(result)
+    if not isinstance(payload, dict):
+        return set()
+    status = str(payload.get("status") or "").strip().casefold()
+    if (
+        payload.get("success") is False
+        or payload.get("error")
+        or status in _FAILED_STATUSES
+    ):
+        return set()
+
+    rows: Any
+    if tool_name == "web_search":
+        if payload.get("success") is not True:
+            return set()
+        data = payload.get("data")
+        rows = data.get("web") if isinstance(data, dict) else None
+        if not isinstance(rows, list):
+            return set()
+        return {
+            url
+            for row in rows
+            if isinstance(row, dict)
+            and not row.get("error")
+            and row.get("success") is not False
+            and str(row.get("status") or "").strip().casefold() not in _FAILED_STATUSES
+            and (url := _normalize_https_url(row.get("url")))
+        }
+
+    if tool_name != "web_extract":
+        return set()
+    rows = payload.get("results")
+    if not isinstance(rows, list):
+        return set()
+    raw_requested = args.get("urls")
+    requested_urls = {
+        url
+        for value in (
+            raw_requested if isinstance(raw_requested, list) else [raw_requested]
+        )
+        if (url := _normalize_https_url(value))
+    }
+    successful: set[str] = set()
+    for row in rows:
+        if not isinstance(row, dict):
+            continue
+        row_status = str(row.get("status") or "").strip().casefold()
+        content = row.get("content")
+        url = _normalize_https_url(row.get("url"))
+        if (
+            url
+            and url in requested_urls
+            and not row.get("error")
+            and row.get("success") is not False
+            and row_status not in _FAILED_STATUSES
+            and isinstance(content, str)
+            and bool(content.strip())
+        ):
+            successful.add(url)
+    return successful
+
+
+def _provenance_feedback_url(url: str) -> str:
+    """Render a repair hint without reflecting query or fragment secrets."""
+
+    try:
+        parts = urlsplit(url)
+    except ValueError:
+        return "[malformed HTTPS URL]"
+    safe = urlunsplit((parts.scheme, parts.netloc, parts.path, "", ""))
+    if parts.query or parts.fragment:
+        safe += " [query/fragment omitted]"
+    return safe
+
+
+def _redact_and_cap(value: Any, limit: int) -> str:
+    """Force-redact validator text and enforce an exact deterministic cap."""
+
+    try:
+        from agent.redact import redact_sensitive_text
+
+        safe = redact_sensitive_text(
+            "" if value is None else str(value),
+            force=True,
+            file_read=True,
+        )
+    except Exception:
+        safe = "[validator text suppressed: redaction failed]"
+    if len(safe) <= limit:
+        return safe
+    suffix = "\n[validator text truncated]"
+    return safe[: max(0, limit - len(suffix))] + suffix
+
+
+def _attach_write_feedback(result: Any, feedback: ResearchWriteFeedback) -> Any:
+    """Add contract feedback without changing the write's top-level success."""
+
+    payload = _json_object(result)
+    if payload is None:
+        return result
+    augmented = dict(payload)
+    augmented["research_validation"] = {
+        "status": feedback.status,
+        "validator_ran": feedback.validator_ran,
+        "terminal": feedback.terminal,
+        "retryable": feedback.retryable,
+        "message": _redact_and_cap(feedback.message, VALIDATOR_FEEDBACK_MESSAGE_LIMIT),
+        "validator_output": _redact_and_cap(
+            feedback.validator_output, VALIDATOR_FEEDBACK_OUTPUT_LIMIT
+        ),
+    }
+    if isinstance(result, dict):
+        return augmented
+    return json.dumps(augmented, ensure_ascii=False)
+
+
+def _sanitize_contracted_extract_cache_hints(result: Any) -> Any:
+    """Remove cache read instructions unavailable to exact-path research leaves."""
+
+    payload = _json_object(result)
+    if payload is None or not isinstance(payload.get("results"), list):
+        return result
+    changed = False
+    sanitized_rows: list[Any] = []
+    for row in payload["results"]:
+        if not isinstance(row, dict) or not isinstance(row.get("content"), str):
+            sanitized_rows.append(row)
+            continue
+        content = row["content"]
+        kept_lines = [
+            line
+            for line in content.splitlines()
+            if not line.startswith("Full text saved to:")
+            and not line.startswith("To read the omitted middle:")
+            and not line.startswith("Full text could not be stored;")
+        ]
+        sanitized = "\n".join(kept_lines)
+        if sanitized != content:
+            changed = True
+            sanitized += (
+                "\nContracted research note: use only the inline extracted "
+                "content above; cache-path reads are unavailable."
+            )
+            sanitized_rows.append({**row, "content": sanitized})
+        else:
+            sanitized_rows.append(row)
+    if not changed:
+        return result
+    augmented = {**payload, "results": sanitized_rows}
+    return (
+        augmented
+        if isinstance(result, dict)
+        else json.dumps(augmented, ensure_ascii=False)
+    )
+

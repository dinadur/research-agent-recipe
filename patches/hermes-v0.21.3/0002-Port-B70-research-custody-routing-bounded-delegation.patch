@@ -0,0 +1,54 @@
+"""Internal-event and compressed-session ownership boundaries."""
+from types import SimpleNamespace
+from unittest.mock import AsyncMock
+import pytest
+from gateway.research_completion import bind_completion, trusted_event_metadata, completion_metadata, parent_matches_lineage
+from gateway.iteration_barrier import record_barrier, clear_barrier, barrier_reason, deliver_barred_notification
+
+
+def test_external_metadata_cannot_mint_completion_authority():
+    event=SimpleNamespace(internal=False,metadata={"trusted_async_event":{"delegation_id":"spoof"}})
+    assert trusted_event_metadata(event) is None
+    event.internal=True
+    clone=trusted_event_metadata(event)
+    clone["delegation_id"]="changed"
+    assert event.metadata["trusted_async_event"]["delegation_id"]=="spoof"
+
+
+@pytest.mark.parametrize("key,parent",[("foreign-route","parent"),("owned-route","foreign-parent")])
+def test_foreign_completion_revokes_trust(key,parent):
+    a=SimpleNamespace(session_id="parent",_parallel_research_trusted_completion_id="old")
+    runner=SimpleNamespace(_session_db=None)
+    bind_completion(runner,a,trusted_async_event={"delivery_kind":"parallel_research","session_key":key,"parent_session_id":parent,"delegation_id":"wave"},session_key="owned-route",session_id="parent")
+    assert a._parallel_research_trusted_completion_id is None
+
+
+def test_compression_lineage_requires_equal_nonempty_resolved_tips():
+    runner=SimpleNamespace(_session_db=SimpleNamespace(resolve_resume_session_id=lambda sid:{"old":"tip","new":"tip","other":"different"}.get(sid)))
+    assert parent_matches_lineage(runner,"old","new")
+    assert not parent_matches_lineage(runner,"old","other")
+    assert not parent_matches_lineage(runner,"missing","also-missing")
+
+
+def test_completion_metadata_preserves_only_trusted_control_fields():
+    event=dict(type="async_delegation",delivery_kind="parallel_research",delegation_id="d",session_key="k",parent_session_id="s",_research_completion_attestations=[{"passed":False}],summary="PRIVATE CHILD")
+    out=completion_metadata(event)
+    assert "PRIVATE CHILD" not in str(out)
+    event["_research_completion_attestations"][0]["passed"]=True
+    assert out["trusted_async_event"]["_research_completion_attestations"][0]["passed"] is False
+
+
+@pytest.mark.asyncio
+async def test_exhausted_turn_notification_is_passive():
+    from unittest.mock import Mock
+    runner=SimpleNamespace(session_store=SimpleNamespace(get_or_create_session=Mock(return_value=SimpleNamespace(session_id="s")),append_to_transcript=Mock()))
+    record_barrier(runner,"k",{"turn_exit_reason":"max_iterations_reached(4/4)"})
+    assert barrier_reason(runner,"k")
+    adapter=SimpleNamespace(send=AsyncMock())
+    source=SimpleNamespace(platform="telegram",chat_id="fake",thread_id=None)
+    await deliver_barred_notification(runner,"Background task completed",source=source,adapter=adapter,session_key="k",pinned_session_id="s")
+    adapter.send.assert_awaited_once()
+    assert "without starting another" in adapter.send.call_args.args[1]
+    runner.session_store.append_to_transcript.assert_called_once()
+    clear_barrier(runner,"k")
+    assert not barrier_reason(runner,"k")

+
+def close_parallel_research_predispatch_decision_abnormally(agent: Any) -> None:
+    """Close an otherwise-unclassified response without retaining an error."""
+
+    update_parallel_research_predispatch_decision(
+        agent,
+        failure_category="abnormal_exit",
+        terminal=True,
+    )

+def _response_content(http_response: Mapping[str, Any]) -> str:
+    try:
+        content = http_response["choices"][0]["message"]["content"]
+    except (KeyError, IndexError, TypeError) as exc:
+        raise ReferenceStoreError("HTTP response lacks assistant content") from exc
+    if not isinstance(content, str) or not content.strip():
+        raise ReferenceStoreError("assistant content is empty")
+    return content
+
+
+def validate_synthesis_response(
+    http_response: Mapping[str, Any],
+    spec_value: Mapping[str, Any],
+    row_store: Mapping[str, Any],
+) -> dict[str, Any]:
+    spec = validate_spec(dict(spec_value))
+    if not isinstance(row_store, Mapping):
+        raise ReferenceStoreError("evidence-row store is not an object")
+    rows = row_store.get("rows")
+    if row_store.get("schema_version") != SCHEMA_VERSION or row_store.get("kind") != ROWS_KIND:
+        raise ReferenceStoreError("evidence-row store header is invalid")
+    if not isinstance(rows, list) or not rows:
+        raise ReferenceStoreError("evidence-row store is empty")
+    rows_by_id: dict[str, Mapping[str, Any]] = {}
+    semantic_row_ids: set[str] = set()
+    semantic_rows_by_facet: dict[str, set[str]] = {}
+    measurement_obligations: dict[str, set[str]] = {}
+    for row in rows:
+        if not isinstance(row, Mapping) or _ROW_ID_RE.fullmatch(str(row.get("row_id") or "")) is None:
+            raise ReferenceStoreError("evidence-row record is invalid")
+        if row["row_id"] in rows_by_id:
+            raise ReferenceStoreError("evidence-row ID is duplicated")
+        selected_candidate_id = row.get("selected_candidate_id")
+        if selected_candidate_id is not None:
+            if (
+                not isinstance(selected_candidate_id, str)
+                or _CANDIDATE_ID_RE.fullmatch(selected_candidate_id) is None
+            ):
+                raise ReferenceStoreError("selected evidence candidate ID is invalid")
+            semantic_row_ids.add(row["row_id"])
+            semantic_rows_by_facet.setdefault(str(row.get("facet") or ""), set()).add(
+                row["row_id"]
+            )
+            obligations = _measurement_obligations(str(row.get("text") or ""))
+            if obligations:
+                measurement_obligations[row["row_id"]] = obligations
+        rows_by_id[row["row_id"]] = row
+    if semantic_row_ids and semantic_row_ids != set(rows_by_id):
+        raise ReferenceStoreError("semantic evidence-row custody is incomplete")
+    raw_content = _response_content(http_response)
+    normalized = _EMPTY_THINK_RE.sub("", raw_content, count=1)
+    if "<think" in normalized.casefold() or "</think" in normalized.casefold():
+        raise ReferenceStoreError("nonempty or repeated reasoning wrapper is forbidden")
+    packet = _json_no_duplicates(normalized, label="synthesis response")
+    if not isinstance(packet, dict) or set(packet) != {"schema_version", "units"}:
+        raise ReferenceStoreError("synthesis response keys are not exact")
+    units = packet.get("units")
+    if packet.get("schema_version") != SCHEMA_VERSION or not isinstance(units, list):
+        raise ReferenceStoreError("synthesis response header is invalid")
+    if not MIN_UNITS <= len(units) <= MAX_UNITS:
+        raise ReferenceStoreError("synthesis response unit count is outside 6-10")
+    kind_counts: Counter[str] = Counter()
+    used_facets: set[str] = set()
+    canonical_units: list[dict[str, Any]] = []
+    seen_text: set[str] = set()
+    used_row_ids: set[str] = set()
+    covered_measurement_rows: set[str] = set()
+    maximum_unsupported_run = 0
+    for index, unit in enumerate(units, start=1):
+        if not isinstance(unit, dict) or set(unit) != _UNIT_KEYS:
+            raise ReferenceStoreError("synthesis unit keys are not exact")
+        unit_id = unit.get("unit_id")
+        kind = unit.get("kind")
+        text = unit.get("text")
+        evidence_ids = unit.get("evidence_row_ids")
+        if (
+            unit_id != f"u{index}"
+            or kind not in _UNIT_KINDS
+            or not isinstance(text, str)
+            or not 30 <= len(text) <= MAX_UNIT_CHARS
+            or not text.endswith(".")
+            or any(token in text for token in (";", "?", "\"", "http://", "https://"))
+            or "!" in text
+            or _INTERNAL_SENTENCE_BOUNDARY_RE.search(text[:-1]) is not None
+            or _ROW_ID_RE.search(text) is not None
+            or not isinstance(evidence_ids, list)
+            or not 1 <= len(evidence_ids) <= 3
+            or not all(isinstance(row_id, str) and row_id in rows_by_id for row_id in evidence_ids)
+            or len(set(evidence_ids)) != len(evidence_ids)
+        ):
+            raise ReferenceStoreError(f"synthesis unit {index} is invalid")
+        normalized_text = " ".join(text.casefold().split())
+        if normalized_text in seen_text:
+            raise ReferenceStoreError("synthesis response repeats a prose unit")
+        seen_text.add(normalized_text)
+        support = " ".join(rows_by_id[row_id]["text"] for row_id in evidence_ids)
+        unsupported_numbers = sorted(
+            _normalized_quantity_tokens(text)
+            - _normalized_quantity_tokens(support)
+        )
+        if unsupported_numbers:
+            raise ReferenceStoreError(
+                f"synthesis unit {index} adds unsupported number(s): {unsupported_numbers}"
+            )
+        if semantic_row_ids:
+            unsupported_run = _maximum_unsupported_signal_run(text, support)
+            maximum_unsupported_run = max(maximum_unsupported_run, unsupported_run)
+            if unsupported_run > MAX_UNSUPPORTED_SIGNAL_RUN:
+                raise ReferenceStoreError(
+                    f"synthesis unit {index} contains an unsupported multi-word claim"
+                )
+            for row_id in evidence_ids:
+                row_signal_count = len(
+                    set(_synthesis_signal_sequence(str(rows_by_id[row_id]["text"])))
+                )
+                minimum_overlap = min(MIN_CITED_ROW_SIGNAL_OVERLAP, row_signal_count)
+                if _cited_row_signal_overlap(text, str(rows_by_id[row_id]["text"])) < minimum_overlap:
+                    raise ReferenceStoreError(
+                        f"synthesis unit {index} cites irrelevant evidence row {row_id}"
+                    )
+                obligations = measurement_obligations.get(row_id)
+                if obligations and obligations.issubset(
+                    _normalized_quantity_tokens(text)
+                ):
+                    covered_measurement_rows.add(row_id)
+        kind_counts[kind] += 1
+        used_facets.update(str(rows_by_id[row_id]["facet"]) for row_id in evidence_ids)
+        used_row_ids.update(evidence_ids)
+        canonical_units.append(
+            {
+                "unit_id": unit_id,
+                "kind": kind,
+                "text": text,
+                "evidence_row_ids": list(evidence_ids),
+            }
+        )
+    if (
+        kind_counts["finding"] < 2
+        or kind_counts["interaction"] < 1
+        or kind_counts["recommendation"] < 2
+        or kind_counts["limitation"] < 1
+    ):
+        raise ReferenceStoreError("synthesis response lacks required unit-kind coverage")
+    required_facets = {facet["marker"] for facet in spec["facets"]}
+    if used_facets != required_facets:
+        raise ReferenceStoreError("synthesis response does not use every facet")
+    used_rows_by_facet = {
+        marker: sorted(row_ids & used_row_ids)
+        for marker, row_ids in sorted(semantic_rows_by_facet.items())
+    }
+    if semantic_row_ids and any(
+        len(used_rows_by_facet[marker])
+        < min(MIN_SELECTED_ROWS_PER_FACET, len(row_ids))
+        for marker, row_ids in semantic_rows_by_facet.items()
+    ):
+        raise ReferenceStoreError(
+            "synthesis response has insufficient selected-row facet coverage"
+        )
+    missing_measurement_rows = sorted(
+        set(measurement_obligations) - covered_measurement_rows
+    )
+    if missing_measurement_rows:
+        raise ReferenceStoreError(
+            "synthesis response omits measured threshold row(s): "
+            f"{missing_measurement_rows}"
+        )
+    return {
+        "schema_version": SCHEMA_VERSION,
+        "kind": SYNTHESIS_KIND,
+        "empty_think_wrapper_removed": normalized != raw_content,
+        "units": canonical_units,
+        "used_facets": sorted(used_facets),
+        "coverage_gate": {
+            "enabled": bool(semantic_row_ids),
+            "minimum_selected_rows_per_facet": MIN_SELECTED_ROWS_PER_FACET,
+            "used_row_ids": sorted(used_row_ids),
+            "used_rows_by_facet": used_rows_by_facet,
+            "required_measurement_row_ids": sorted(measurement_obligations),
+            "covered_measurement_row_ids": sorted(covered_measurement_rows),
+            "passed": True,
+        },
+        "claim_support_gate": {
+            "enabled": bool(semantic_row_ids),
+            "method": "bounded-lexical-support-v1",
+            "maximum_unsupported_signal_run": maximum_unsupported_run,
+            "allowed_unsupported_signal_run": MAX_UNSUPPORTED_SIGNAL_RUN,
+            "minimum_cited_row_signal_overlap": MIN_CITED_ROW_SIGNAL_OVERLAP,
+            "passed": True,
+        },
+        "row_store_sha256": sha256_bytes(canonical_json_bytes(dict(row_store))),
+    }
+
+

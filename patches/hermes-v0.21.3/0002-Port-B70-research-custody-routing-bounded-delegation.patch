+"""Real provider wrapper behavior with HTTP replaced by a local mock transport."""
+import httpx
+import pytest
+from plugins.web.tavily import provider as p, direct_extract as d
+
+
+def test_capacity_fallback_keeps_source_and_bearer_boundary(monkeypatch):
+    calls=[]
+    def post(url, **kwargs):
+        calls.append(kwargs)
+        return httpx.Response(432, request=httpx.Request("POST", url))
+    monkeypatch.setattr(p.httpx, "post", post)
+    monkeypatch.setattr(p, "provider_env", lambda key: "private-test-token" if key=="TAVILY_API_KEY" else "")
+    monkeypatch.setattr(p, "use_keyless", lambda *a: False)
+    doc={"url":"https://example.com/product", "content":"EU 2 L: €49 excluding tax, September 2026."}
+    monkeypatch.setattr(d, "_direct_extract_documents", lambda urls: [doc] if urls==[doc["url"]] else [])
+    assert p.TavilyWebSearchProvider().extract([doc["url"]]) == [doc]
+    assert calls[0]["headers"]["Authorization"] == "Bearer private-test-token"
+    assert "api_key" not in calls[0]["json"]
+
+
+def test_direct_html_keeps_qualifiers_and_checks_redirects(monkeypatch):
+    client=httpx.Client
+    seen=[]
+    def handler(req):
+        seen.append(str(req.url))
+        if req.url.path == "/start":
+            return httpx.Response(302, headers={"Location":"https://example.com/final"})
+        return httpx.Response(200, headers={"content-type":"text/html"}, text="<title>Price</title><p>EU: €49 excluding tax; 2 L.</p><script>untrusted script</script>")
+    monkeypatch.setattr(httpx,"Client",lambda **kw:client(transport=httpx.MockTransport(handler),**kw))
+    monkeypatch.setattr(d,"is_safe_url",lambda url: str(url).startswith("https://example.com/"))
+    monkeypatch.setattr(d,"check_website_access",lambda url:None)
+    doc=d._direct_extract_document("https://example.com/start")
+    assert doc["url"]=="https://example.com/start"
+    assert doc["metadata"]["fetchedURL"]=="https://example.com/final"
+    assert "€49 excluding tax; 2 L." in doc["content"]
+    assert "untrusted script" not in doc["content"]
+    assert len(seen)==2
+
+
+def test_direct_redirect_to_private_origin_never_fetches_it(monkeypatch):
+    client=httpx.Client
+    seen=[]
+    def handler(req):
+        seen.append(str(req.url))
+        return httpx.Response(302,headers={"Location":"http://127.0.0.1/private"})
+    monkeypatch.setattr(httpx,"Client",lambda **kw:client(transport=httpx.MockTransport(handler),**kw))
+    monkeypatch.setattr(d,"is_safe_url",lambda url:str(url).startswith("https://example.com/"))
+    monkeypatch.setattr(d,"check_website_access",lambda url:None)
+    with pytest.raises(ValueError,match="Blocked redirect"):
+        d._direct_extract_document("https://example.com/start")
+    assert seen==["https://example.com/start"]
+
+
+def test_recency_path_uses_fresh_direct_text(monkeypatch):
+    url="https://github.com/NousResearch/hermes-agent/releases"
+    assert d._is_recency_sensitive_url(url)
+    monkeypatch.setattr(d,"_direct_extract_documents",lambda urls:[{"url":url,"content":"fresh release"}])
+    monkeypatch.setattr(p,"_tavily_request",lambda *a,**k:pytest.fail("recency page used cached extraction"))
+    assert p.TavilyWebSearchProvider().extract([url])[0]["content"]=="fresh release"

+def mark_authenticated_parallel_research_lifecycle(
+    agent: Any,
+    messages: list[Any],
+    tool_name: str,
+    args: Mapping[str, Any] | None,
+    tool_call_id: str,
+) -> bool:
+    """Bind one authenticated execution to its exact in-memory row pair.
+
+    The opaque token cannot be supplied by a provider and is removed before
+    persistence/return.  Binding both the assistant call occurrence and its
+    matching result prevents reused IDs or cross-field aliases from reviving a
+    rejected payload.
+    """
+    if not isinstance(messages, list) or not isinstance(tool_call_id, str):
+        return False
+    fingerprint = _repair_call_fingerprint(args)
+    pending = getattr(agent, "_parallel_research_pending_lifecycle_auth", None)
+    if not isinstance(pending, list):
+        return False
+    descriptor_index = None
+    descriptor = None
+    for index in range(len(pending) - 1, -1, -1):
+        candidate = pending[index]
+        if (
+            isinstance(candidate, dict)
+            and candidate.get("tool_call_id") == tool_call_id
+            and candidate.get("name") == tool_name
+            and candidate.get("args_sha256") == fingerprint
+        ):
+            descriptor_index = index
+            descriptor = candidate
+            break
+    if descriptor is None or descriptor_index is None:
+        return False
+    token = descriptor.get("token")
+    registered = getattr(
+        agent, "_parallel_research_authenticated_lifecycle_tokens", None
+    )
+    if not isinstance(registered, set) or token not in registered:
+        return False
+
+    result_message = messages[-1] if messages else None
+    if (
+        not isinstance(result_message, dict)
+        or result_message.get("role") != "tool"
+        or result_message.get("tool_call_id") != tool_call_id
+    ):
+        return False
+
+    matched_call = None
+    for message in reversed(messages[:-1]):
+        if not isinstance(message, dict) or message.get("role") != "assistant":
+            continue
+        calls = message.get("tool_calls")
+        if not isinstance(calls, list):
+            continue
+        for call in reversed(calls):
+            function = call.get("function") if isinstance(call, dict) else None
+            call_ids = (
+                [
+                    call.get(key)
+                    for key in ("id", "call_id", "tool_call_id")
+                    if isinstance(call.get(key), str) and call.get(key)
+                ]
+                if isinstance(call, dict)
+                else []
+            )
+            call_args = (
+                _json_object(function.get("arguments"))
+                if isinstance(function, Mapping)
+                else None
+            )
+            if (
+                tool_call_id in call_ids
+                and isinstance(function, Mapping)
+                and function.get("name") == tool_name
+                and _repair_call_fingerprint(call_args) == fingerprint
+                and "_research_lifecycle_auth_token" not in call
+            ):
+                matched_call = call
+                break
+        if matched_call is not None:
+            break
+    if matched_call is None:
+        return False
+    matched_call["_research_lifecycle_auth_token"] = token
+    result_message["_research_lifecycle_auth_token"] = token
+    pending.pop(descriptor_index)
+    return True
+

+
+def minimal_predispatch_failure_result(
+    agent,
+    messages,
+    *,
+    conversation_history=None,
+    api_call_count=0,
+    preserve_bound_dispatch=False,
+):
+    """Fail closed when normal finalization itself raises.
+
+    This seam deliberately avoids model/provider properties, plugin hooks,
+    trajectory writers, and cleanup callbacks.  It retains only the current
+    user boundary plus controller-authenticated lifecycle rows, clears all
+    research authority before best-effort persistence, and returns one fixed
+    response shape.
+    """
+    from agent.research_contract import (
+        RESEARCH_DISPATCH_WITHHELD_RESPONSE,
+        clear_parallel_research_state,
+        emit_parallel_research_predispatch_decision_ledger,
+    )
+
+    try:
+        emit_parallel_research_predispatch_decision_ledger(agent)
+    except BaseException:
+        pass
+
+    final_text = RESEARCH_DISPATCH_WITHHELD_RESPONSE
+    final_reason = "research_dispatch_withheld"
+    completed = False
+    failed = True
+    if preserve_bound_dispatch:
+        delegation_id = getattr(
+            agent, "_parallel_research_pending_delegation_id", None
+        )
+        contracts = getattr(agent, "_parallel_research_bound_artifacts", ())
+        if (
+            isinstance(delegation_id, str)
+            and delegation_id
+            and isinstance(contracts, tuple)
+            and contracts
+        ):
+            count = len(contracts)
+            noun = "task" if count == 1 else "tasks"
+            final_text = (
+                f"Dispatched {count} background {noun} as one bounded wave "
+                f"({delegation_id}). This turn is closed; the consolidated "
+                "result will return here automatically."
+            )
+            final_reason = "background_delegation_dispatched"
+            completed = True
+            failed = False
+        else:
+            preserve_bound_dispatch = False
+
+    if not isinstance(messages, list):
+        messages = []
+    boundary = getattr(agent, "_persist_user_message_idx", None)
+    if not isinstance(boundary, int) or not (0 <= boundary < len(messages)):
+        boundary = -1
+        for index in range(len(messages) - 1, -1, -1):
+            message = messages[index]
+            if isinstance(message, dict) and message.get("role") == "user":
+                boundary = index
+                break
+
+    authenticated_tokens = set(
+        getattr(
+            agent,
+            "_parallel_research_authenticated_lifecycle_tokens",
+            set(),
+        )
+    )
+    result_tokens = set()
+    for candidate in messages[boundary + 1 :]:
+        if isinstance(candidate, dict) and candidate.get("role") == "tool":
+            token = candidate.get("_research_lifecycle_auth_token")
+            try:
+                if token in authenticated_tokens:
+                    result_tokens.add(token)
+            except TypeError:
+                pass
+    safe_messages = list(messages[: boundary + 1])
+    pending_tokens = set()
+    for message in messages[boundary + 1 :]:
+        if not isinstance(message, dict):
+            continue
+        if message.get("role") == "assistant":
+            calls = message.get("tool_calls")
+            if not isinstance(calls, list) or not calls:
+                continue
+            safe_calls = []
+            valid_row = True
+            for call in calls:
+                function = call.get("function") if isinstance(call, dict) else None
+                name = function.get("name") if isinstance(function, dict) else None
+                token = (
+                    call.get("_research_lifecycle_auth_token")
+                    if isinstance(call, dict)
+                    else None
+                )
+                try:
+                    authenticated = (
+                        token in authenticated_tokens
+                        and token in result_tokens
+                    )
+                except TypeError:
+                    authenticated = False
+                if (
+                    name not in {"skill_view", "delegate_task"}
+                    or not authenticated
+                ):
+                    valid_row = False
+                    break
+                safe_call = {
+                    key: call[key]
+                    for key in ("id", "call_id", "tool_call_id", "type")
+                    if key in call
+                }
+                safe_call["function"] = {
+                    "name": name,
+                    "arguments": function.get("arguments", "{}"),
+                }
+                safe_calls.append(safe_call)
+                pending_tokens.add(token)
+            if valid_row:
+                safe_messages.append(
+                    {
+                        "role": "assistant",
+                        "content": "",
+                        "tool_calls": safe_calls,
+                    }
+                )
+        elif message.get("role") == "tool":
+            token = message.get("_research_lifecycle_auth_token")
+            try:
+                authenticated = token in pending_tokens
+            except TypeError:
+                authenticated = False
+            if authenticated:
+                pending_tokens.discard(token)
+                safe_messages.append(
+                    {
+                        "role": "tool",
+                        "name": message.get("name", ""),
+                        "tool_call_id": message.get("tool_call_id", ""),
+                        "content": message.get("content", ""),
+                    }
+                )
+    pending_auth = getattr(
+        agent, "_parallel_research_pending_lifecycle_auth", None
+    )
+    if isinstance(pending_auth, list):
+        for descriptor in pending_auth:
+            if not isinstance(descriptor, dict):
+                continue
+            token = descriptor.get("token")
+            try:
+                reconstruct = (
+                    token in authenticated_tokens
+                    and token not in result_tokens
+                )
+            except TypeError:
+                reconstruct = False
+            name = descriptor.get("name")
+            call_id = descriptor.get("tool_call_id")
+            args = descriptor.get("args")
+            if (
+                not reconstruct
+                or name not in {"skill_view", "delegate_task"}
+                or not isinstance(call_id, str)
+                or not call_id
+                or not isinstance(args, dict)
+            ):
+                continue
+            raw_result = descriptor.get("result", "")
+            result_content = (
+                raw_result
+                if isinstance(raw_result, str)
+                else json.dumps(raw_result, ensure_ascii=False)
+            )
+            safe_messages.extend(
+                [
+                    {
+                        "role": "assistant",
+                        "content": "",
+                        "tool_calls": [
+                            {
+                                "id": call_id,
+                                "type": "function",
+                                "function": {
+                                    "name": name,
+                                    "arguments": json.dumps(
+                                        args,
+                                        sort_keys=True,
+                                        ensure_ascii=False,
+                                        separators=(",", ":"),
+                                    ),
+                                },
+                            }
+                        ],
+                    },
+                    {
+                        "role": "tool",
+                        "name": name,
+                        "tool_call_id": call_id,
+                        "content": result_content,
+                    },
+                ]
+            )
+    safe_messages.append(
+        {
+            "role": "assistant",
+            "content": final_text,
+            "finish_reason": final_reason,
+        }
+    )
+    messages[:] = safe_messages
+
+    try:
+        if not preserve_bound_dispatch:
+            clear_parallel_research_state(agent)
+    except BaseException:
+        # Direct attribute fallback keeps the next turn clean even for test
+        # doubles whose state-clear hook is intentionally fault-injected.
+        for name, value in (
+            ("_parallel_research_route_required_turn_id", None),
+            ("_parallel_research_skill_view_turn_id", None),
+            ("_parallel_research_activation", None),
+            ("_parallel_research_dispatch_succeeded", False),
+            ("_parallel_research_defer_streaming_for_turn", False),
+            ("_parallel_research_defer_candidate_text_for_turn", False),
+            ("_parallel_research_canonical_tool_schemas", None),
+            ("_parallel_research_authenticated_lifecycle_ids", set()),
+            ("_parallel_research_authenticated_lifecycle_tokens", set()),
+            ("_parallel_research_pending_lifecycle_auth", []),
+            (
+                "_parallel_research_predispatch_decision_ledger_turn_id",
+                None,
+            ),
+            (
+                "_parallel_research_predispatch_decision_ledger_entries",
+                [],
+            ),
+            (
+                "_parallel_research_predispatch_decision_ledger_overflowed",
+                False,
+            ),
+            (
+                "_parallel_research_predispatch_decision_ledger_pending_index",
+                None,
+            ),
+        ):
+            try:
+                setattr(agent, name, value)
+            except BaseException:
+                pass
+    try:
+        agent._persist_session(messages, conversation_history)
+    except BaseException:
+        pass
+    try:
+        agent._retry_status_buffer = []
+        agent._current_streamed_assistant_text = ""
+        agent._stream_needs_break = False
+    except BaseException:
+        pass
+    return {
+        "final_response": final_text,
+        "last_reasoning": None,
+        "messages": messages,
+        "api_calls": api_call_count if isinstance(api_call_count, int) else 0,
+        "completed": completed,
+        "failed": failed,
+        "partial": False,
+        "interrupted": False,
+        "turn_exit_reason": final_reason,
+    }
+

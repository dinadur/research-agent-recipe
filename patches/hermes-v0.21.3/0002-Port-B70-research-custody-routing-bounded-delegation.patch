+def _history_requests_product_research(conversation_history: Any) -> bool:
+    if not isinstance(conversation_history, (list, tuple)):
+        return False
+    for message in conversation_history:
+        if not isinstance(message, Mapping) or message.get("role") != "user":
+            continue
+        if requires_product_research_route(message.get("content")):
+            return True
+    return False
+

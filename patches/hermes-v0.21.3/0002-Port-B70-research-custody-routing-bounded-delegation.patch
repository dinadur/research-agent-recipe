+from __future__ import annotations
+
+import json
+from types import SimpleNamespace
+
+from agent.research_loop import (
+    _advance_deterministic_rejection_streak,
+    _deterministic_nonretryable_rejection_signature,
+)
+
+
+def _call(call_id: str, query: str = "same query") -> SimpleNamespace:
+    return SimpleNamespace(
+        id=call_id,
+        function=SimpleNamespace(
+            name="web_search",
+            arguments=json.dumps({"query": query}),
+        ),
+    )
+
+
+def _result(
+    call_id: str,
+    *,
+    retryable: bool = False,
+    terminal_failure: bool = True,
+    executed: bool = False,
+    wrapped: bool = False,
+    repeated_warning: bool = False,
+) -> dict[str, str]:
+    payload = json.dumps(
+        {
+            "code": "generic_research_capability_forbidden",
+            "status": "rejected",
+            "executed": executed,
+            "retryable": retryable,
+            "terminal_failure": terminal_failure,
+            "research_contract": True,
+        }
+    )
+    if wrapped:
+        warning = (
+            "\n\n[Tool loop warning: idempotent_no_progress_warning; "
+            "count=2; web_search returned the same result 2 times.]"
+            if repeated_warning
+            else ""
+        )
+        payload = (
+            '<untrusted_tool_result source="web_search">\n'
+            "External data boundary.\n\n"
+            f"{payload}{warning}\n"
+            "</untrusted_tool_result>"
+        )
+    return {
+        "role": "tool",
+        "tool_call_id": call_id,
+        "content": payload,
+    }
+
+
+def test_signature_ignores_rotating_call_ids_and_canonicalizes_arguments():
+    first = _deterministic_nonretryable_rejection_signature(
+        [_call("call-1")], [_result("call-1")]
+    )
+    second = _deterministic_nonretryable_rejection_signature(
+        [_call("call-2")], [_result("call-2")]
+    )
+
+    assert first == second
+    assert first == (
+        (
+            "web_search",
+            '{"query":"same query"}',
+            "generic_research_capability_forbidden",
+        ),
+    )
+
+
+def test_signature_changes_when_the_model_corrects_the_request():
+    first = _deterministic_nonretryable_rejection_signature(
+        [_call("call-1", "first query")], [_result("call-1")]
+    )
+    corrected = _deterministic_nonretryable_rejection_signature(
+        [_call("call-2", "corrected query")], [_result("call-2")]
+    )
+
+    assert first != corrected
+
+
+def test_signature_accepts_the_tool_executor_trust_wrapper_and_loop_warning():
+    direct = _deterministic_nonretryable_rejection_signature(
+        [_call("call-1")], [_result("call-1")]
+    )
+    wrapped = _deterministic_nonretryable_rejection_signature(
+        [_call("call-2")],
+        [_result("call-2", wrapped=True, repeated_warning=True)],
+    )
+
+    assert wrapped == direct
+
+
+def test_signature_rejects_retryable_executed_or_ambiguous_results():
+    call = _call("call-1")
+
+    assert _deterministic_nonretryable_rejection_signature(
+        [call], [_result("call-1", retryable=True)]
+    ) is None
+    assert _deterministic_nonretryable_rejection_signature(
+        [call], [_result("call-1", executed=True)]
+    ) is None
+    assert _deterministic_nonretryable_rejection_signature(
+        [call], [_result("call-1", terminal_failure=False)]
+    ) is None
+
+
+def test_streak_stops_on_second_adjacent_identical_rejection_and_resets():
+    signature = _deterministic_nonretryable_rejection_signature(
+        [_call("call-1")], [_result("call-1")]
+    )
+
+    previous, streak = _advance_deterministic_rejection_streak(None, 0, signature)
+    assert streak == 1
+    previous, streak = _advance_deterministic_rejection_streak(
+        previous, streak, signature
+    )
+    assert streak == 2
+    previous, streak = _advance_deterministic_rejection_streak(
+        previous, streak, None
+    )
+    assert previous is None
+    assert streak == 0

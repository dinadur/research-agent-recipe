+"""Natural phrasings and the research route each should select (2026-10-08 sweep).
+
+Before this corpus only 1 of 12 natural product phrasings, 3 of 10 generic and 3 of 5 travel phrasings reached a
+research route, so everyday requests skipped the evidence controls.
+"""
+
+from __future__ import annotations
+
+import pytest
+
+from agent.generic_research_route import requires_generic_research_route
+from agent.product_route import requires_product_research_route
+from agent.travel_route import requires_travel_publication_route
+
+
+def _route(message: str) -> str:
+    if requires_travel_publication_route(message):
+        return "travel"
+    if requires_product_research_route(message):
+        return "product"
+    if requires_generic_research_route(message):
+        return "generic"
+    return "none"
+

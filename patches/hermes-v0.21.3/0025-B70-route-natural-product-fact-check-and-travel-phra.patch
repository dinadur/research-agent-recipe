+
+def generic_research_fact_check_requested(user_message: Any) -> bool:
+    """A fact-check or look-into ask ("is it true ...", "look into whether ...")."""
+
+    if not isinstance(user_message, str):
+        return False
+    text = " ".join(user_message.split())
+    return bool(
+        re.search(
+            r"\b(?:is\s+it\s+true|verify|fact[-\s]?check|(?:look\s+into|find\s+out|check)\s+"
+            r"(?:whether|if|what(?:'s|\u2019s)?\s+new))\b",
+            text,
+            re.IGNORECASE,
+        )

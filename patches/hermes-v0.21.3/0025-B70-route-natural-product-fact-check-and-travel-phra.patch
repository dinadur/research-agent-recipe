diff --git a/agent/product_route.py b/agent/product_route.py
index 9cfdbcf..285d00b 100644
--- a/agent/product_route.py
+++ b/agent/product_route.py
@@ -134,6 +134,94 @@ _RESEARCH_PREFIX_RE = re.compile(
     r"research\b",
     re.IGNORECASE,
 )
+# Natural shopping requests that do not start with "research" (2026-10-08
+# routing sweep: 1 of 12 natural product phrasings reached this route).
+_POLITE_LEAD = (
+    r"^\s*(?:(?:hey|hi)\b[\s,!]*)?"
+    r"(?:(?:can|could|would|will)\s+you\s+(?:please\s+)?|please\s+"
+    r"|i(?:'|\u2019)?d\s+like\s+you\s+to\s+|i\s+would\s+like\s+you\s+to\s+|help\s+me\s+)?"
+)
+_SHOPPING_ASK_RE = re.compile(
+    _POLITE_LEAD
+    + r"(?:research|find(?:\s+me)?|recommend|suggest|compare|look\s+(?:into|for|up)(?!\s+(?:my|this|that|these|your)\b)|pick|choose)\b"
+    r"|^\s*(?:what(?:'s|\u2019s|\s+is|\s+are|\s+would\s+be)|which|should\s+i|any\s+(?:recommendations?|suggestions?)|(?:is|are)\s+the\b)\b"
+    r"|\b(?:i\s+need\s+(?:a|an|some|new)|i(?:'m|\u2019m|\s+am)\s+looking\s+for|looking\s+for\s+(?:a|an))\b",
+    re.IGNORECASE,
+)
+_SHOPPING_WANT_RE = re.compile(
+    r"\b(?:best(?!\s+practices?\b)|good|decent|reliable|top|recommend(?:ation)?s?|suggestions?|"
+    r"should\s+i\s+(?:get|buy)|(?:pick|choose)\s+(?:between|a|an)|\bor\b.{1,60}\bbetter)\b",
+    re.IGNORECASE,
+)
+_COMPARE_ONLY_RE = re.compile(r"\b(?:compare|comparison|vs\.?|versus)\b", re.IGNORECASE)
+# A model-like token: a capitalised name and a number ("Pixel 10", "Forerunner 265"),
+# "iPhone 17", or letters and digits run together ("XM5", "R6", "WH-1000XM5").
+_MODEL_TOKEN_RE = re.compile(
+    r"\b(?:[A-Z][A-Za-z-]*|i[A-Z][A-Za-z]*)\s\d{1,4}[A-Za-z]*\b|\b[A-Za-z]+-?\d+[A-Za-z0-9]*\b"
+)
+# Common consumer product categories, for asks that name no price or model.
+_PRODUCT_NOUN_RE = re.compile(
+    r"\b(?:tvs?|televisions?|laptops?|notebooks?|chromebooks?|phones?|smartphones?|tablets?|headphones|"
+    r"earbuds|speakers?|soundbars?|monitors?|keyboards?|mice|mouse|cameras?|lens(?:es)?|printers?|"
+    r"routers?|mesh\s+wi-?fi|wi-?fi\s+(?:system|router)s?|smartwatch(?:es)?|watch(?:es)?|"
+    r"fitness\s+trackers?|e-?readers?|consoles?|"
+    r"vacuums?|robot\s+vacuums?|mowers?|drills?|saws?|tools?\s+kits?|dishwashers?|washers?|dryers?|"
+    r"fridges?|refrigerators?|ovens?|microwaves?|air\s+fryers?|fryers?|blenders?|mixers?|"
+    r"espresso\s+machines?|coffee\s+(?:makers?|machines?|grinders?)|grinders?|kettles?|toothbrush(?:es)?|"
+    r"purifiers?|humidifiers?|dehumidifiers?|heaters?|fans?|thermostats?|mattress(?:es)?|pillows?|"
+    r"desks?|chairs?|bikes?|e-?bikes?|scooters?|helmets?|shoes|sneakers|boots|jackets?|backpacks?|"
+    r"luggage|suitcases?|tents?|sleeping\s+bags?|power\s+stations?|generators?|batter(?:y|ies)|"
+    r"chargers?|power\s+banks?|tires?|car\s+seats?|strollers?|grills?|griddles?|smokers?|"
+    r"gpus?|graphics\s+cards?|ssds?|hard\s+drives?|nas)\b",
+    re.IGNORECASE,
+)
+_BUY_RE = re.compile(r"\b(?:buy|get|purchase)\b", re.IGNORECASE)
+# Superlatives about things that are not products.
+_NON_PRODUCT_RE = re.compile(
+    r"\b(?:best|good|top)\s+(?:\w+\s+){0,2}?(?:way|ways|time|times|day|days|month|season|practices?|"
+    r"places?|restaurants?|bars?|cafes?|hotels?|neighbou?rhoods?|things?\s+to\s+do|spots?|"
+    r"trails?|hikes?|beaches|parks?|museums?|cities|destinations?|approach(?:es)?|methods?|"
+    r"strateg(?:y|ies)|answer|name|idea|ideas)\b|\bways?\s+to\b"
+    r"|\b(?:these|this|those|my)\s+(?:two\s+)?(?:paragraphs?|sentences?|texts?|drafts?|files?|"
+    r"functions?|code|versions?|approaches|ideas|plans?)\b",
+    re.IGNORECASE,
+)
+
+
+_NOT_SHOPPING_RE = re.compile(
+    r"\bnot\s+(?:a\s+)?product\b|\b(?:do\s+not|don't)\s+use\s+(?:any\s+)?tools\b|\btools\s+are\s+disabled\b",
+    re.IGNORECASE,
+)
+
+
+def _natural_shopping_request(text: str) -> bool:
+    """A shopping ask ("what's the best X", "find me a good X", "X vs Y") about a product."""
+
+    if _NON_PRODUCT_RE.search(text) or _NOT_SHOPPING_RE.search(text):
+        return False
+    if _COMPARE_ONLY_RE.search(text):
+        # "A vs B" alone needs a model-like token; "compare A and B" also accepts
+        # a price, budget or buying word.
+        if _MODEL_TOKEN_RE.search(text) and re.search(r"\b(?:vs\.?|versus)\b", text, re.IGNORECASE):
+            return True
+        if _SHOPPING_ASK_RE.search(text) and (
+            _MODEL_TOKEN_RE.search(text)
+            or _BUY_RE.search(text)
+            or re.search(r"\$\s*\d|\bunder\s+\$?\d|\bbudget\b|\bprice\b", text, re.IGNORECASE)
+        ):
+            return True
+    return bool(_SHOPPING_ASK_RE.search(text) and _SHOPPING_WANT_RE.search(text) and _product_signal(text))
+
+
+def _product_signal(text: str) -> bool:
+    return bool(
+        _PRODUCT_OR_CONSTRAINT_RE.search(text)
+        or _BUY_RE.search(text)
+        or _MODEL_TOKEN_RE.search(text)
+        or _PRODUCT_NOUN_RE.search(text)
+    )
+
+
 _DURABLE_COMPARISON_MODE_RE = re.compile(
     r"(?im)^\s*mode\s*:\s*durable_comparison\s*$"
 )
@@ -675,11 +763,17 @@ def requires_product_research_route(user_message: Any) -> bool:
 
     if requires_travel_publication_route(text):
         return False
-    return bool(
+    if (
         _RESEARCH_PREFIX_RE.search(text)
         and _COMPARISON_RE.search(text)
         and _PRODUCT_OR_CONSTRAINT_RE.search(text)
-    )
+    ):
+        return True
+    from agent.generic_research_route import generic_research_fact_check_requested
+
+    if generic_research_fact_check_requested(text):
+        return False
+    return _natural_shopping_request(text)
 
 

@@ -85,7 +85,20 @@ GENERIC_RESEARCH_ALLOWED_TOOLS = frozenset(
 
 _RESEARCH_INTENT_RE = re.compile(
     r"\b(?:research|investigate|look\s+up|find\s+(?:current|recent|official)|"
-    r"current\s+best\s+practices?)\b",

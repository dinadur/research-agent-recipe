+
+
+_LIST_ANSWER = """Conclusion: the Dell S2722QC is the best verified choice for photo editing and office work.
+
+The Dell official page confirms USB-C power delivery up to 65 W and height, pivot, swivel and tilt adjustability.
+The LG page lacks the required colour-gamut and price details.
+
+Citations: [Dell page](https://www.dell.example/s2722qc), [LG page](https://www.lg.example/27up850n), [Tracker](https://tracker.example/dell)
+"""
+
+
+def test_shadow_uses_trailing_citation_list_for_uncited_sentences():
+    claims = product_groundedness.shadow_linked_claims(_LIST_ANSWER)
+
+    assert [c["mode"] for c in claims] == ["list", "list", "list"]
+    assert claims[1]["claim"].startswith("The Dell official page confirms USB-C power delivery")
+    assert claims[1]["urls"] == ("https://www.dell.example/s2722qc", "https://www.lg.example/27up850n",
+                                 "https://tracker.example/dell")
+    assert not any(c["claim"].startswith("Citations") for c in claims)
+
+
+def test_shadow_sources_section_and_inline_links_coexist():
+    answer = ("The X1 costs $299 ([Acme](https://acme.example/x1)).\n"
+              "It also ships with a carrying case and a two-year limited warranty in the box.\n\n"
+              "## Sources\n- [Acme](https://acme.example/x1)\n- [Guide](https://guide.example/best)\n")
+    claims = product_groundedness.shadow_linked_claims(answer)
+
+    assert claims[0] == {"line": 1, "claim": "The X1 costs $299", "urls": ("https://acme.example/x1",), "mode": "inline"}
+    assert claims[1]["mode"] == "list" and claims[1]["urls"] == ("https://acme.example/x1", "https://guide.example/best")
+    assert len(claims) == 2
+
+
+def test_shadow_list_mode_picks_best_windows_across_pages(monkeypatch, tmp_path):
+    monkeypatch.setenv("HERMES_PRODUCT_GROUNDEDNESS_SHADOW_LOG", str(tmp_path / "s.jsonl"))
+    seen = []
+    monkeypatch.setattr(product_groundedness, "_post_guardian",
+                        lambda url, payload, headers, timeout: seen.append(payload) or _body("yes"))
+    pages = {
+        "https://www.dell.example/s2722qc": ("menu " * 400) + "USB-C power delivery up to 65 W. Height, pivot, swivel and tilt adjustability.",
+        "https://www.lg.example/27up850n": "LG 27UP850N page text without gamut figures.",
+        "https://tracker.example/dell": "Price history for the Dell monitor.",
+    }
+    product_groundedness.run_groundedness_shadow(_LIST_ANSWER, pages, _agent()._product_research_groundedness_config, "s")
+
+    import json as _json
+    rows = [_json.loads(l) for l in (tmp_path / "s.jsonl").read_text().splitlines()]
+    dell = next(r for r in rows if r.get("claim", "").startswith("The Dell official page"))
+    assert dell["mode"] == "list" and dell["excerpts"][0]["url"] == "https://www.dell.example/s2722qc"
+    assert "65 W" in dell["excerpts"][0]["quote"] and len(dell["excerpts"]) <= 3
+
+
+def test_shadow_claim_drops_empty_parentheses_left_by_links():
+    claims = product_groundedness.shadow_linked_claims(
+        "PCMag lists the eero 6+ as Wi-Fi 6 with 4,500 sq ft coverage ([PCMag](https://pcmag.example/eero)).")
+    assert claims[0]["claim"] == "PCMag lists the eero 6+ as Wi-Fi 6 with 4,500 sq ft coverage"
+
+
+def test_shadow_splits_after_bold_full_stop_and_skips_tables_in_list_mode():
+    answer = ("**Pick the Dell S2722QC, conditionally.** It is the strongest verified match for office work today.\n"
+              "| Model | USB-C |\n|---|---|\n| Dell | 65 W |\n\n"
+              "Sources: [Dell](https://www.dell.example/s2722qc)\n")
+    claims = product_groundedness.shadow_linked_claims(answer)
+
+    assert [c["claim"] for c in claims] == ["It is the strongest verified match for office work today"]
+
+
+def test_shadow_excerpts_fit_clef_batch_budget(monkeypatch, tmp_path):
+    monkeypatch.setenv("HERMES_PRODUCT_GROUNDEDNESS_SHADOW_LOG", str(tmp_path / "s.jsonl"))
+    monkeypatch.setattr(product_groundedness, "_post_guardian", lambda *a: _body("yes"))
+    page = "spec " * 2000
+    answer = "The model has USB-C and HDMI ([A](https://a.example/p), [B](https://b.example/p), [C](https://c.example/p))."
+    product_groundedness.run_groundedness_shadow(
+        answer, {"https://a.example/p": page, "https://b.example/p": page, "https://c.example/p": page},
+        _agent()._product_research_groundedness_config, "s")
+
+    import json as _json
+    row = _json.loads((tmp_path / "s.jsonl").read_text().splitlines()[0])
+    assert sum(len(e["quote"]) for e in row["excerpts"]) <= product_groundedness._SHADOW_EXCERPT_BUDGET_CHARS

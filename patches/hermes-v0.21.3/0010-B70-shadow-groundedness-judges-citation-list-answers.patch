+    for line_no, raw in enumerate(lines, 1):
+        line = raw.strip()
+        heading = re.sub(r"^#+\s*", "", line)
+        if line.startswith("#"):
+            in_list_section = heading.strip("*: ").casefold() in {
+                "citations", "sources", "references", "cited pages"}
+            if in_list_section:
+                list_lines.add(line_no)
+            continue
+        if in_list_section or _CITATION_LIST_RE.match(line):
+            if _MARKDOWN_LINK_RE.search(line) or not line:
+                list_lines.add(line_no)
+                for match in _MARKDOWN_LINK_RE.finditer(line):
+                    canonical = _shadow_canonical(match.group(2))
+                    if canonical not in list_urls:
+                        list_urls.append(canonical)
 
     claims: list[dict[str, Any]] = []
-    for line_no, raw in enumerate(str(text or "").splitlines(), 1):

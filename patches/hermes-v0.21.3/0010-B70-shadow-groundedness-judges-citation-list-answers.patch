+def _shadow_clean_claim(sentence: str) -> str:
+    claim = _MARKDOWN_LINK_RE.sub("", sentence)
+    claim = _EMPTY_PARENS_RE.sub("", claim)
+    claim = re.sub(r"\s+([,.;:])", r"\1", claim)
+    claim = re.sub(r"[\s,.]+$", "", claim.replace("**", "")).strip()
+    return re.sub(r"\s{2,}", " ", claim)
+
+
 def shadow_linked_claims(text: str) -> tuple[dict[str, Any], ...]:
-    """Sentences that cite at least one https link, with the cited URLs."""
+    """Claims to judge, each with the URLs that should support it.
+
+    A sentence with inline links cites those links ("inline").  When the answer
+    also carries a citations list (a "Citations:"/"Sources:" line or section),
+    each substantive sentence without an inline link is judged against every
+    URL in that list ("list").
+    """
+
+    lines = str(text or "").splitlines()
+    list_urls: list[str] = []
+    list_lines: set[int] = set()

     assert "exactly as written" in text and "Fully Jarvis" in text
     assert "[label](url)" in text and "https://a.example/x" in text
+
+
+def test_strip_outside_citations_keeps_evidence_links_only():
+    from agent.quality_first_route import strip_outside_citations
+
+    text = ("The T9 supports remote sensors [Honeywell](https://www.honeywellhome.com/t9) and costs $199 "
+            "([Best Buy](https://www.bestbuy.com/t9)), per a forum (https://reddit.com/r/x).")
+    out, removed = strip_outside_citations(text, ["https://www.honeywellhome.com/t9"])
+
+    assert "[Honeywell](https://www.honeywellhome.com/t9)" in out
+    assert "bestbuy" not in out and "reddit" not in out and "Best Buy" in out
+    assert "()" not in out and removed == ["https://www.bestbuy.com/t9", "https://reddit.com/r/x"]
+
+
+def test_bare_evidence_urls_count_as_citations():
+    from agent.quality_first_route import response_diagnostics
+
+    d = response_diagnostics("The Level.2 has a 60-mile range (https://www.aventon.com/level2).",
+                             "Research the best e-bike under $2000.", ["https://www.aventon.com/level2"])
+    assert "citations_missing" not in d["defects"]
+
+
+def test_quality_first_validation_unlinks_outside_citation_instead_of_withholding(monkeypatch):
+    from agent import product_route
+
+    monkeypatch.setattr(product_route, "product_research_route_active", lambda a: True)
+    monkeypatch.setattr(product_route, "product_research_quality_first_active", lambda a: True)
+    monkeypatch.setattr(product_route, "start_groundedness_shadow", lambda *a: None, raising=False)
+    agent = SimpleNamespace(
+        _current_turn_id="t1", _product_research_receipt_turn_id="t1",
+        _product_research_receipt_sources=("https://www.honeywellhome.com/t9",),
+        _product_research_receipt_source_texts={}, _product_research_operator_prompt="Research the best thermostat under $250.",
+    )
+    passed, text, reason = product_route.validate_product_research_response(
+        agent, "Buy the T9 under $250 [Honeywell](https://www.honeywellhome.com/t9), see [deal](https://deals.example/t9).")
+
+    assert passed and reason == "quality_first_passed"
+    assert "deals.example" not in text and "deal" in text

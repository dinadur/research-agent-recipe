     return [token for token in re.findall(r"[A-Za-z0-9]+", core) if len(token) >= 2]
 
 
+def strip_outside_citations(text: str, allowed_urls: Sequence[str]) -> tuple[str, list[str]]:
+    """Unlink citations to URLs outside the frozen evidence.
+
+    ``[label](https://outside)`` keeps its label; a bare outside URL is removed
+    (with the parentheses around it).  Every citation left points at frozen
+    evidence, which is what the outside-citation check exists to guarantee.
+    """
+
+    allowlist = {canonical_url(url) for url in allowed_urls if canonical_url(url)}
+    removed: list[str] = []
+
+    def unlink(match: re.Match) -> str:
+        url = match.group(2)
+        if canonical_url(url) in allowlist:
+            return match.group(0)
+        removed.append(url)
+        return match.group(1)
+
+    out = re.sub(r"\[([^\]]+)\]\((https://[^)\s]+)\)", unlink, str(text or ""))
+
+    def drop(match: re.Match) -> str:
+        url = match.group(0)
+        if canonical_url(url) in allowlist:
+            return url
+        removed.append(url)
+        return ""
+
+    out = _URL_RE.sub(drop, out)
+    out = re.sub(r"\(\s*[,;]?\s*\)", "", out)
+    out = re.sub(r"[ \t]+([.,;:])", r"\1", out)
+    return out, removed
+
+
 def response_diagnostics(
     response: Any,
     prompt: str,
@@ -292,8 +325,12 @@ def response_diagnostics(
 
     text = str(response or "").strip()
     allowlist = {canonical_url(url) for url in allowed_urls if canonical_url(url)}
-    cited = [canonical_url(url) for url in _MARKDOWN_URL_RE.findall(text)]
     all_https = [canonical_url(url) for url in _URL_RE.findall(text)]
+    # Markdown links and bare URLs from the frozen evidence both count as
+    # citations ("... (https://vendor.example/p)" is a common local-model style).
+    cited = [canonical_url(url) for url in _MARKDOWN_URL_RE.findall(text)] + [
+        url for url in all_https if url in allowlist
+    ]
     outside = sorted({url for url in all_https if url and url not in allowlist})
     target_missing = [
         target

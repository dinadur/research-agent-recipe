+
+# --- log-only shadow check for quality-first answers -------------------------
+
+_SHADOW_ANSWER = """## Conclusion
+
+**Buy the Acme X1** for long flights [Acme page](https://acme.example/x1/).
+
+## Model fit
+
+The Acme page lists **$299.99** and up to 30-hour battery life [Acme page](https://acme.example/x1). It is great value. The guide says it does not fold [Guide](https://guide.example/best), [Acme page](https://acme.example/x1).
+- Plain uncited bullet with no link at all.
+
+Publication status: Draft only—nothing was written to the wiki. Publication requires a separate controlled step.
+"""
+
+
+def test_shadow_extracts_only_linked_sentences_with_canonical_urls():
+    claims = product_groundedness.shadow_linked_claims(_SHADOW_ANSWER)
+
+    assert [c["claim"] for c in claims] == [
+        "Buy the Acme X1 for long flights",
+        "The Acme page lists $299.99 and up to 30-hour battery life",
+        "The guide says it does not fold",
+    ]
+    assert claims[0]["urls"] == ("https://acme.example/x1",)
+    assert claims[2]["urls"] == ("https://guide.example/best", "https://acme.example/x1")
+
+
+def test_shadow_passage_prefers_window_with_numbers():
+    page = ("filler words about shipping and returns. " * 60
+            + "Battery: up to 30-hour battery life. Price $299.99. "
+            + "more filler about warranty terms. " * 60)
+    passage, overlap = product_groundedness.shadow_best_passage(
+        "lists $299.99 and up to 30-hour battery life", page)
+
+    assert "$299.99" in passage and "30-hour" in passage
+    assert len(passage) <= 800 and overlap > 0.5
+
+
+def test_shadow_run_logs_verdicts_and_never_needs_agent(monkeypatch, tmp_path):
+    log = tmp_path / "shadow.jsonl"
+    monkeypatch.setenv("HERMES_PRODUCT_GROUNDEDNESS_SHADOW_LOG", str(log))
+    seen = []
+
+    def post(url, payload, headers, timeout):
+        seen.append(payload)
+        body = _body("no" if "great value" in payload["messages"][1]["content"] else "yes")
+        body["clef"] = {"p_yes": 0.9, "threshold": 0.85}
+        return body
+
+    monkeypatch.setattr(product_groundedness, "_post_guardian", post)
+    summary = product_groundedness.run_groundedness_shadow(
+        _SHADOW_ANSWER,
+        {"https://acme.example/x1/": "Acme X1. $299.99. Up to 30-hour battery life.",
+         "https://guide.example/best": "The Acme X1 does not fold flat."},
+        _agent()._product_research_groundedness_config,
+        "sess-1",
+    )
+
+    rows = [__import__("json").loads(l) for l in log.read_text().splitlines()]
+    assert summary["claims"] == 3 and summary["errors"] == 0
+    assert rows[-1]["status"] == "summary" and rows[-1]["session_id"] == "sess-1"
+    judged = [r for r in rows if r.get("status") == "judged"]
+    assert judged and all(r["p_yes"] == 0.9 for r in judged)
+    assert all(len(p["messages"]) == 3 for p in seen)
+
+
+def test_shadow_start_is_noop_without_env_and_swallows_errors(monkeypatch):
+    monkeypatch.delenv("HERMES_PRODUCT_GROUNDEDNESS_SHADOW", raising=False)
+    started = []
+    monkeypatch.setattr(product_groundedness.threading, "Thread",
+                        lambda **kw: started.append(kw))
+    product_groundedness.start_groundedness_shadow(_agent(), _SHADOW_ANSWER, {})
+    assert started == []
+
+    monkeypatch.setenv("HERMES_PRODUCT_GROUNDEDNESS_SHADOW", "1")
+    monkeypatch.setattr(product_groundedness, "_judge_config",
+                        lambda agent: (_ for _ in ()).throw(RuntimeError("boom")))
+    product_groundedness.start_groundedness_shadow(_agent(), _SHADOW_ANSWER, {})
+    assert started == []
+
+
+def test_shadow_start_does_not_touch_agent_state(monkeypatch, tmp_path):
+    monkeypatch.setenv("HERMES_PRODUCT_GROUNDEDNESS_SHADOW", "1")
+    monkeypatch.setenv("HERMES_PRODUCT_GROUNDEDNESS_SHADOW_LOG", str(tmp_path / "s.jsonl"))
+    monkeypatch.setattr(product_groundedness, "_post_guardian",
+                        lambda *a: _body("yes"))
+    agent = _agent()
+    before = dict(vars(agent))
+    product_groundedness.start_groundedness_shadow(agent, _SHADOW_ANSWER, {
+        "https://acme.example/x1": "Acme X1 page text."})
+    for thread in product_groundedness.threading.enumerate():
+        if thread.name == "groundedness-shadow":
+            thread.join(5)
+    assert vars(agent) == before
+    assert (tmp_path / "s.jsonl").exists()
+
+
+def test_quality_first_pass_starts_shadow_and_ignores_its_failure(monkeypatch):
+    from agent import product_route, quality_first_route
+
+    monkeypatch.setattr(product_route, "product_research_route_active", lambda a: True)
+    monkeypatch.setattr(product_route, "product_research_quality_first_active", lambda a: True)
+    monkeypatch.setattr(quality_first_route, "response_diagnostics",
+                        lambda *a: {"passed": True})
+    agent = SimpleNamespace(
+        _current_turn_id="t1", _product_research_receipt_turn_id="t1",
+        _product_research_receipt_sources=("https://acme.example/x1",),
+        _product_research_receipt_source_texts={"https://acme.example/x1": "page"},
+        _product_research_operator_prompt="Research the best headphones",
+    )
+    calls = []
+    monkeypatch.setattr(product_groundedness, "start_groundedness_shadow",
+                        lambda a, text, sources: calls.append((text, sources)))
+
+    passed, text, reason = product_route.validate_product_research_response(agent, "Answer [A](https://acme.example/x1).")
+
+    assert (passed, reason) == (True, "quality_first_passed")
+    assert calls == [(text, {"https://acme.example/x1": "page"})]
+
+    def boom(*a):
+        raise RuntimeError("shadow broke")
+
+    monkeypatch.setattr(product_groundedness, "start_groundedness_shadow", boom)
+    assert product_route.validate_product_research_response(agent, "Answer [A](https://acme.example/x1).") == (passed, text, reason)

From d73362e93ce4860ae7b5c0579c3b2293862bc6b5 Mon Sep 17 00:00:00 2001
From: dinadur <59811564+dinadur@users.noreply.github.com>
Date: Thu, 8 Oct 2026 03:18:08 +0000
Subject: [PATCH 19/20] B70: travel previews sent once; travel search ceiling
 24

- The travel approval delivery path pushed the preview through
  stream_delta_callback and left _response_was_previewed False, so the
  gateway also did its normal final send: 6/6 Telegram travel runs on
  2026-10-08 showed the preview twice ('final-send NOT suppressed ...
  possible duplicate send'). The preview is now delivered once, by the
  normal final send.
- TRAVEL_SEARCH_QUERY_LIMIT 12 -> 24 (and the route note). With one direct
  official lookup per venue, 12 queries could not reach the route's own
  16-candidate target: all 6 runs hit the ceiling at 8-15 candidates.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 agent/research_contract.py       |  6 +++++-
 agent/research_loop.py           | 10 ++++------
 agent/travel_route.py            |  4 ++--
 tests/agent/test_travel_route.py | 16 +++++++++-------
 4 files changed, 20 insertions(+), 16 deletions(-)

diff --git a/agent/research_contract.py b/agent/research_contract.py
index a675199..a89c5b3 100644
--- a/agent/research_contract.py
+++ b/agent/research_contract.py
@@ -248,7 +248,11 @@ _TRAVEL_VAULT_MUTATION_RE = re.compile(
 _TRAVEL_SHELL_CONTROL_RE = re.compile(r"&&|\|\||[;&|<>`]|\r|\n|\$\(")
 _TRAVEL_READ_ONLY_COMMANDS = frozenset({"ls", "pwd", "sha256sum", "stat"})
 _TRAVEL_ROUTE_RESERVATION_LOCK = threading.RLock()
-TRAVEL_SEARCH_QUERY_LIMIT = 12
+# One broad wave (~4 queries) plus one direct-official lookup per venue for the
+# 8-per-category target (16 for attractions and dining) plus a short deficit
+# wave.  At 12 the target was unreachable: 2026-10-08 runs spent 4 broad + 8
+# lookups and stopped at 8-15 candidates against the 16 target.
+TRAVEL_SEARCH_QUERY_LIMIT = 24
 TRAVEL_PARTIAL_SEARCH_TURN_MIN_CALLS = 4
 TRAVEL_PARTIAL_SEARCH_TURN_MIN_SUCCESSES = 3
 TRAVEL_PARTIAL_SEARCH_TURN_MIN_URLS = 8
diff --git a/agent/research_loop.py b/agent/research_loop.py
index 79e33b3..7a3c02c 100644
--- a/agent/research_loop.py
+++ b/agent/research_loop.py
@@ -464,13 +464,11 @@ def after_research_tools(agent, s):
         agent._session_messages = s.messages
         agent._response_was_previewed = False
         if s.final_response:
+            # Delivered once, by the gateway's normal final send.  Also pushing
+            # it through stream_delta_callback made Telegram show every approval
+            # preview twice (2026-10-08: 6/6 travel runs; the gateway logged
+            # "final-send NOT suppressed ... possible duplicate send").
             agent._safe_print(f'\n{s.final_response}\n')
-            if agent.stream_delta_callback:
-                try:
-                    agent.stream_delta_callback(s.final_response)
-                    agent.stream_delta_callback(None)
-                except Exception:
-                    pass
         return 'break'
     if _verified_delivery is not None:
         s.final_response, _verified_failed = _verified_delivery

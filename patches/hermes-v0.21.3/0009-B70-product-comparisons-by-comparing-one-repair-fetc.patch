index 000000000..d39a2c901
--- /dev/null
+++ b/tests/agent/test_product_repair_fetch.py
@@ -0,0 +1,130 @@
+"""One controller-granted repair fetch before an unready product receipt is withheld."""
+
+from __future__ import annotations
+
+import json
+from types import SimpleNamespace
+
+from agent.product_route import (
+    PRODUCT_RESEARCH_MAX_EXTRACT_CALLS,
+    PRODUCT_RESEARCH_REPAIR_FETCH_ENV,
+    PRODUCT_RESEARCH_SOURCE_MIX_NUDGE_LIMIT,
+    bound_product_research_receipt_command,
+    constrain_product_research_tool_calls,
+    observe_product_research_tool_result,
+    prepare_product_research_source_mix,
+    product_research_terminal_reason,
+)
+from agent.quality_first_route import extract_targets
+from tests.agent.test_product_route import _agent, _extract_messages, _search_messages
+
+
+def _exhausted_scenario():
+    agent = _agent()
+    agent.api_mode = "chat_completions"
+    agent._product_research_source_mix_nudge_count = PRODUCT_RESEARCH_SOURCE_MIX_NUDGE_LIMIT
+    reviews = [
+        "https://www.forbes.com/home/best-robot-vacuum",
+        "https://www.techgearlab.com/reviews/roborock-q5-max-plus",
+        "https://www.thesmarthomehookup.com/budget-robot-vacuum",
+    ]
+    missing_official = "https://global.roborock.com/pages/roborock-q5-max-plus"
+    messages = [{"role": "user", "content": "Research the best robot vacuum under $400 for pet hair and rugs."}]
+    messages += _search_messages("best robot vacuum under 400", reviews, "1")
+    messages += _extract_messages(reviews, "1", {
+        reviews[0]: "Roborock Q5 Max+ is a contender at $399.",
+        reviews[1]: "Roborock Q5 Max+ costs under $400 and tested well.",
+        reviews[2]: "Roborock Q5 Max+ costs $360 and led pickup testing.",
+    })
+    messages += _search_messages("site:roborock.com q5 max plus", [missing_official], "2")
+    messages += [{
+        "role": "assistant", "content": "",
+        "tool_calls": [{"id": "extract-2", "type": "function", "function": {
+            "name": "web_extract", "arguments": json.dumps({"urls": [missing_official]})}}],
+    }, {
+        "role": "tool", "tool_call_id": "extract-2", "name": "web_extract",
+        "content": json.dumps({"results": [{"url": missing_official, "title": "", "content": "",
+                                            "error": "Failed to fetch url"}]}),
+    }]
+    receipt = SimpleNamespace(id="receipt-1", function=SimpleNamespace(
+        name="terminal",
+        arguments=json.dumps({"command": bound_product_research_receipt_command(agent.session_id), "timeout": 30}),
+    ))
+    agent._product_research_extract_call_count = PRODUCT_RESEARCH_MAX_EXTRACT_CALLS
+    agent._product_research_extract_budget_exhausted_turn_id = "turn-1"
+    return agent, messages, receipt
+
+
+def test_unready_receipt_after_exhaustion_gets_one_repair_fetch(monkeypatch):
+    monkeypatch.setenv(PRODUCT_RESEARCH_REPAIR_FETCH_ENV, "1")
+    agent, messages, receipt = _exhausted_scenario()
+
+    calls, nudge, details = prepare_product_research_source_mix(agent, [receipt], messages)
+
+    assert calls == []
+    assert details["mode"] == "receipt_repair_fetch_granted"
+    assert details["viability_reasons"] == ["official_product_evidence_missing"]
+    assert "official manufacturer product page" in nudge and "exactly one more web_search" in nudge
+    assert agent._product_research_repair_grant_turn_id == "turn-1"
+    assert agent._product_research_extract_budget_exhausted_turn_id is None
+    assert getattr(agent, "_product_research_receipt_viability_failure_turn_id", None) is None
+    assert product_research_terminal_reason(agent, json.loads(receipt.function.arguments)) is None
+
+
+def test_second_unready_receipt_in_the_same_turn_is_withheld(monkeypatch):
+    monkeypatch.setenv(PRODUCT_RESEARCH_REPAIR_FETCH_ENV, "1")
+    agent, messages, receipt = _exhausted_scenario()
+    prepare_product_research_source_mix(agent, [receipt], messages)
+
+    calls, nudge, details = prepare_product_research_source_mix(agent, [receipt], messages)
+
+    assert calls == [receipt] and nudge is None
+    assert details["mode"] == "receipt_viability_exhausted"
+    assert agent._product_research_receipt_viability_failure_turn_id == "turn-1"
+    assert "not receipt-ready" in product_research_terminal_reason(agent, json.loads(receipt.function.arguments))
+
+
+def test_repair_fetch_is_off_without_the_environment_switch(monkeypatch):
+    monkeypatch.delenv(PRODUCT_RESEARCH_REPAIR_FETCH_ENV, raising=False)
+    agent, messages, receipt = _exhausted_scenario()
+
+    calls, nudge, details = prepare_product_research_source_mix(agent, [receipt], messages)
+
+    assert details["mode"] == "receipt_viability_exhausted"
+    assert getattr(agent, "_product_research_repair_grant_turn_id", None) is None
+
+
+def test_granted_turn_admits_and_counts_exactly_one_more_extract(monkeypatch):
+    monkeypatch.setenv(PRODUCT_RESEARCH_REPAIR_FETCH_ENV, "1")
+    agent, messages, receipt = _exhausted_scenario()
+    extra = SimpleNamespace(id="extract-3", function=SimpleNamespace(
+        name="web_extract", arguments=json.dumps({"urls": ["https://www.rtings.com/vacuum/reviews/roborock/q5"]})))
+
+    before, dropped_before = constrain_product_research_tool_calls(agent, [extra], messages)
+    assert before == [] and dropped_before.get("web_extract") == 1
+
+    prepare_product_research_source_mix(agent, [receipt], messages)
+    after, dropped_after = constrain_product_research_tool_calls(agent, [extra], messages)
+    assert after == [extra] and "web_extract" not in dropped_after
+
+    observe_product_research_tool_result(agent, "web_extract")
+    assert agent._product_research_extract_budget_exhausted_turn_id == "turn-1"
+
+
+def test_targets_named_after_comparing_are_extracted():
+    prompt = ("Research the best 27-inch 4K monitor under $400 for photo editing and office work, "
+              "comparing the Dell S2722QC, LG 27UP850N-W and ASUS ProArt PA279CRV. Use each "
+              "manufacturer's official product page for color gamut.")
+    assert extract_targets(prompt) == ["Dell S2722QC", "LG 27UP850N-W", "ASUS ProArt PA279CRV"]
+
+
+def test_broad_research_clause_does_not_shadow_a_later_named_list():
+    prompt = ("Research the best mesh Wi-Fi system under $300 for a two-story home, comparing the "
+              "TP-Link Deco X55 (3-pack), eero 6+ (3-pack) and Google Nest Wifi Pro (2-pack).")
+    assert extract_targets(prompt) == ["TP-Link Deco X55 (3-pack)", "eero 6+ (3-pack)", "Google Nest Wifi Pro (2-pack)"]
+
+
+def test_compare_for_phrasing_is_unchanged():
+    assert extract_targets("Compare the Kindle Paperwhite and Kobo Clara BW for reading at night.") == [
+        "Kindle Paperwhite", "Kobo Clara BW"]
+    assert extract_targets("Research the best robot vacuum under $400 for pet hair.") == []

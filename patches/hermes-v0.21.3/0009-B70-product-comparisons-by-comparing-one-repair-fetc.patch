+
+
+def _product_repair_fetch_nudge(reasons: Any) -> str:
+    missing = [
+        _REPAIR_REASON_TEXT[reason]
+        for reason in reasons
+        if isinstance(reason, str) and reason in _REPAIR_REASON_TEXT
+    ] or ["the evidence the receipt check reported as missing"]
+    return (
+        "[System: The product receipt is not ready yet. Missing: "

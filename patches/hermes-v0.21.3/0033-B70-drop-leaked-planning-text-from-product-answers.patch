diff --git a/agent/quality_first_route.py b/agent/quality_first_route.py
index 700b97a..e4004b8 100644
--- a/agent/quality_first_route.py
+++ b/agent/quality_first_route.py
@@ -227,6 +227,33 @@ more than 1,200, with one short paragraph or bullet list per option and no repea
 caveats."""
 
 
+# The local model sometimes ends its thinking early and keeps planning in the
+# visible answer ("Need maybe ...", "Let's craft final ...", several drafts);
+# 3 of 288 Telegram answers on 2026-10-07/09. The real answer is the last draft.
+_PLANNING_LINE_RE = re.compile(
+    r"(?m)^\s*(?:\]\s*$|Let's (?:write|produce|draft|craft)\b|"
+    r"Need (?:to |maybe |ensure |check |be |physical |include |\")|"
+    r"Check every\b|Double-check\b|Potential final\b|We need to\b|"
+    r"I need to (?:write|check|make|ensure)\b|Now (?:write|produce) the final\b|"
+    r"Draft:|Final answer:|But citation\b|Then sections:)"
+)
+_ANSWER_OPENER_RE = re.compile(
+    r"(?m)^(?:\*\*)?(?:Bottom line|Conclusion|Recommendation|Best pick|Best overall|Short answer|Answer)\b"
+)
+
+
+def strip_leaked_planning(text: str) -> tuple[str | None, bool]:
+    """Return (clean answer or None, whether planning text leaked)."""
+
+    if not _PLANNING_LINE_RE.search(text):
+        return text, False
+    for match in reversed(list(_ANSWER_OPENER_RE.finditer(text))):
+        tail = text[match.start():]
+        if not _PLANNING_LINE_RE.search(tail):
+            return tail.strip(), True
+    return None, True
+
+
 def synthesis_messages(
     prompt: str,
     sources: Sequence[str],

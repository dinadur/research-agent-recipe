     return str(path) if path.is_file() else None
 
 
+def _fresh_sibling_run_dir(run_dir: Path) -> Path:
+    """Return the first unused ``<name>-rerun-N`` sibling of a used run directory."""
+
+    for number in range(2, 100):
+        candidate = run_dir.with_name(f"{run_dir.name}-rerun-{number}")
+        if not candidate.exists():
+            return candidate
+    raise ValueError("run_dir must be new or empty")
+
+
+def load_request_with_fresh_run_dir(
+    path: Path,
+    *,
+    raw_root: Path,
+) -> tuple[TravelRunRequest, Path | None]:
+    """Load a request; a reused, non-empty run_dir moves to a new sibling.
+
+    Re-researching a destination often names the previous attempt's run
+    directory, and the turn's single controller attempt was then spent on
+    "run_dir must be new or empty" (2026-10-08: Sedona and Portland reruns).
+    The used directory is left untouched; the run gets a new, empty sibling
+    and the second value names the directory that was skipped.
+    """
+
+    try:
+        return TravelRunRequest.from_file(path, raw_root=raw_root), None
+    except ValueError as exc:
+        if str(exc) != "run_dir must be new or empty":
+            raise
+    value = dict(load_json_object(path))
+    used = Path(str(value["run_dir"])).expanduser().resolve()
+    value["run_dir"] = str(_fresh_sibling_run_dir(used))
+    request = TravelRunRequest.from_mapping(value, raw_root=raw_root)
+    return request, used
+
+
 def accepted_controller_status(
     *,
     controller: Path | None = None,
@@ -208,7 +244,16 @@ def main(argv: Sequence[str] | None = None) -> int:
     if args.request is None:
         parser.error("request is required unless --verify-pin is used")
     try:
-        request = TravelRunRequest.from_file(args.request, raw_root=travel_raw_root())
+        request, used_run_dir = load_request_with_fresh_run_dir(
+            args.request, raw_root=travel_raw_root()
+        )
+        if used_run_dir is not None:
+            # Printed first: the approval block must stay the last output lines.
+            print(
+                f"TRAVEL_RESEARCH_RUNNER_NOTE run_dir {used_run_dir} was not empty; "
+                f"this run uses the new directory {request.run_dir}",
+                flush=True,
+            )
         result, completed = run_travel_request(request)
     except ValueError as exc:
         print(f"TRAVEL_RESEARCH_RUNNER_ERROR {exc}", file=sys.stderr)
@@ -235,6 +280,7 @@ __all__ = [
     "RUNNER_CONTROLLER_TIMEOUT_SECONDS",
     "accepted_controller_status",
     "build_parser",
+    "load_request_with_fresh_run_dir",
     "main",
     "run_travel_request",
 ]

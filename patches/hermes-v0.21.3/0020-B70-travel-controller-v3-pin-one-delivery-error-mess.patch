diff --git a/tests/agent/test_research_harness_travel_runner.py b/tests/agent/test_research_harness_travel_runner.py
index e65cfb8..d3ab6f5 100644
--- a/tests/agent/test_research_harness_travel_runner.py
+++ b/tests/agent/test_research_harness_travel_runner.py
@@ -151,3 +151,98 @@ def test_installed_controller_matches_accepted_pin() -> None:
     assert status["actual_controller_sha256"] == status[
         "expected_controller_sha256"
     ]
+
+
+def _request_file(tmp_path: Path) -> tuple[Path, Path, Path]:
+    raw_root = tmp_path / "vault" / "raw" / "travel"
+    raw_root.mkdir(parents=True)
+    manifest = raw_root / "manifest.json"
+    manifest.write_text(json.dumps({"publication": {"owner": "destination"}}), encoding="utf-8")
+    run_dir = raw_root / "sedona-run"
+    request_path = raw_root / "sedona-request.json"
+    request_path.write_text(
+        json.dumps(
+            {
+                "schema_version": 1,
+                "domain": "travel",
+                "request_id": "runner-rerun",
+                "original_request": "Research a destination.",
+                "manifest_path": str(manifest),
+                "run_dir": str(run_dir),
+            }
+        ),
+        encoding="utf-8",
+    )
+    return raw_root, request_path, run_dir
+
+
+def test_reused_run_dir_moves_to_new_sibling(tmp_path: Path) -> None:
+    from agent.research_harness.travel_runner import load_request_with_fresh_run_dir
+
+    raw_root, request_path, run_dir = _request_file(tmp_path)
+    run_dir.mkdir()
+    (run_dir / "run-state.json").write_text("{}\n", encoding="utf-8")
+
+    request, used = load_request_with_fresh_run_dir(request_path, raw_root=raw_root)
+
+    assert used == run_dir
+    assert request.run_dir == raw_root / "sedona-run-rerun-2"
+    assert not request.run_dir.exists()
+    assert (run_dir / "run-state.json").read_text(encoding="utf-8") == "{}\n"
+
+    request.run_dir.mkdir()
+    (request.run_dir / "run-state.json").write_text("{}\n", encoding="utf-8")
+    again, _ = load_request_with_fresh_run_dir(request_path, raw_root=raw_root)
+    assert again.run_dir == raw_root / "sedona-run-rerun-3"
+
+
+def test_new_run_dir_is_used_as_requested(tmp_path: Path) -> None:
+    from agent.research_harness.travel_runner import load_request_with_fresh_run_dir
+
+    raw_root, request_path, run_dir = _request_file(tmp_path)
+
+    request, used = load_request_with_fresh_run_dir(request_path, raw_root=raw_root)
+
+    assert used is None
+    assert request.run_dir == run_dir
+
+
+def test_other_request_errors_still_fail(tmp_path: Path) -> None:
+    import pytest
+
+    from agent.research_harness.travel_runner import load_request_with_fresh_run_dir
+
+    raw_root, request_path, _ = _request_file(tmp_path)
+    value = json.loads(request_path.read_text(encoding="utf-8"))
+    value["manifest_path"] = str(tmp_path / "outside.json")
+    request_path.write_text(json.dumps(value), encoding="utf-8")
+
+    with pytest.raises(ValueError):
+        load_request_with_fresh_run_dir(request_path, raw_root=raw_root)
+
+
+def test_runner_notice_precedes_controller_output(tmp_path: Path, monkeypatch, capsys) -> None:
+    import subprocess
+
+    from agent.research_harness import travel_runner
+
+    raw_root, request_path, run_dir = _request_file(tmp_path)
+    run_dir.mkdir()
+    (run_dir / "run-state.json").write_text("{}\n", encoding="utf-8")
+    seen = {}
+
+    def fake_run(request):
+        seen["run_dir"] = request.run_dir
+        result = type("R", (), {"status": "ready_for_approval", "error": None})()
+        out = "TRAVEL_RESEARCH_READY x\nBEGIN_TRAVEL_APPROVAL\npreview\nEND_TRAVEL_APPROVAL\n"
+        return result, subprocess.CompletedProcess([], 0, out, "")
+
+    monkeypatch.setattr(travel_runner, "travel_raw_root", lambda: raw_root)
+    monkeypatch.setattr(travel_runner, "run_travel_request", fake_run)
+
+    assert travel_runner.main([str(request_path)]) == 0
+    lines = capsys.readouterr().out.splitlines()
+    assert lines[0].startswith("TRAVEL_RESEARCH_RUNNER_NOTE run_dir ")
+    assert str(raw_root / "sedona-run-rerun-2") in lines[0]
+    assert lines[-1] == "END_TRAVEL_APPROVAL"
+    assert seen["run_dir"] == raw_root / "sedona-run-rerun-2"

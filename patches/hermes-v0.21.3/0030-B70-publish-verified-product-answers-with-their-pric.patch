diff --git a/agent/research_contract.py b/agent/research_contract.py
index 860481e..a2f905e 100644
--- a/agent/research_contract.py
+++ b/agent/research_contract.py
@@ -5366,6 +5366,17 @@ def before_agent_tool_call(
                     retryable=False,
                     executed=False,
                 )
+            from agent.verified_tool_delivery import (
+                PRODUCT_RESEARCH_PUBLISH_COMMAND,
+                bound_product_publish_command,
+            )
+
+            if isinstance(args, dict) and args.get("command") == PRODUCT_RESEARCH_PUBLISH_COMMAND:
+                # The publisher reads the session from HERMES_SESSION_ID and is a
+                # module of this checkout: bind both (2026-10-09: every publish

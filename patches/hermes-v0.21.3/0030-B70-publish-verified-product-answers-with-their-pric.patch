diff --git a/agent/product_publisher.py b/agent/product_publisher.py
index 2c7cdda..127047b 100644
--- a/agent/product_publisher.py
+++ b/agent/product_publisher.py
@@ -27,6 +27,10 @@ from agent.product_route import (
 SESSION_ID_RE = re.compile(r"^[A-Za-z0-9_-]{8,128}$")
 DURABLE_MODE = "durable_comparison"
 LEGACY_MODE = "legacy_product_research"
+# Ordinary product recommendations (prices, offers). Published with the date the
+# prices were researched; re-checked with the quality-first gate that delivered them.
+COMMERCE_MODE = "commerce"
+AUTO_MODE = "auto"
 _DURABLE_REQUEST_RE = re.compile(
     r"(?im)^\s*mode:\s*durable_comparison\s*$"
 )
@@ -217,11 +221,55 @@ def _validate_durable_boundary(original_request: str, draft: str) -> None:
         )
 
 
-def _render_page(title: str, draft: str, source_digest: str, draft_digest: str) -> bytes:
+_REQUEST_LEAD_RE = re.compile(
+    r"^\s*(?:(?:hey|hi)\b[\s,!]*)?"
+    r"(?:(?:can|could|would|will)\s+you\s+(?:please\s+)?|please\s+|i(?:'|\u2019)?d\s+like\s+you\s+to\s+"
+    r"|i\s+would\s+like\s+you\s+to\s+|help\s+me\s+)?"
+    r"(?:research(?:\s+and\s+compare)?|find(?:\s+me)?|recommend|suggest|look\s+(?:into|for|up)|compare"
+    r"|what(?:'s|\u2019s|\s+is|\s+are|\s+would\s+be)|which\s+(?:is|are)|i\s+need|i(?:'m|\u2019m|\s+am)\s+looking\s+for)?"
+    r"\s*(?:the\s+|a\s+|an\s+)?",
+    re.IGNORECASE,
+)
+
+
+def _request_title(original_request: str) -> str | None:
+    """A page title from the operator's request ("What's the best X?" -> "Best X")."""
+
+    first = " ".join(str(original_request or "").split("\n", 1)[0].split())
+    text = _REQUEST_LEAD_RE.sub("", first, count=1).strip().rstrip("?.!").strip()
+    if len(text) < 8:
+        return None
+    return (text[0].upper() + text[1:])[:100].rstrip()
+
+
+def _draft_date(draft_row: Any) -> str:
+    """UTC date the draft (and its prices) was researched."""
+
+    try:
+        value = draft_row["timestamp"]
+    except (KeyError, IndexError, TypeError):
+        value = None
+    try:
+        return dt.datetime.fromtimestamp(float(value), dt.timezone.utc).date().isoformat()
+    except (TypeError, ValueError, OverflowError, OSError):
+        try:
+            return dt.date.fromisoformat(str(value)[:10]).isoformat()
+        except ValueError:
+            return dt.datetime.now(dt.timezone.utc).date().isoformat()
+
+
+def _render_page(
+    title: str, draft: str, source_digest: str, draft_digest: str, *, prices_as_of: str | None = None
+) -> bytes:
     stripped = draft.strip()
     if not stripped.endswith(PRODUCT_RESEARCH_PUBLICATION_FOOTER):
         raise PublicationError("verified draft is missing the draft-only boundary")
     body = stripped[: -len(PRODUCT_RESEARCH_PUBLICATION_FOOTER)].rstrip()
+    if prices_as_of:
+        body = (
+            f"> Prices and availability as of {prices_as_of}. They change often: check current "
+            "offers before buying.\n\n" + body
+        )
     today = dt.datetime.now(dt.timezone.utc).date().isoformat()
     rendered = (
         "---\n"
@@ -232,7 +280,8 @@ def _render_page(title: str, draft: str, source_digest: str, draft_digest: str)
         "  - product-research\n"
         f"source_receipt_sha256: {source_digest}\n"
         f"verified_draft_sha256: {draft_digest}\n"
-        "---\n\n"
+        + (f"prices_as_of: {prices_as_of}\n" if prices_as_of else "")
+        + "---\n\n"
         f"{body}\n"
     )
     return rendered.encode("utf-8")
@@ -302,28 +351,48 @@ def publish_product_research(
     original_request = _load_original_request(
         resolved_home, session_id, turn_user_message_id
     )
+    if mode == AUTO_MODE:
+        mode = DURABLE_MODE if _DURABLE_REQUEST_RE.search(original_request) else COMMERCE_MODE
     if mode == DURABLE_MODE:
         _validate_durable_boundary(original_request, draft)
-    elif mode != LEGACY_MODE:
+    elif mode not in (LEGACY_MODE, COMMERCE_MODE):
         raise PublicationError("unsupported product publication mode")
-    source_texts = _load_source_texts(
-        resolved_home,
-        session_id,
-        turn_user_message_id,
-        int(draft_row["id"]),
-        source_urls,
-    )
-    passed, validated_draft, reason = validate_product_research_text(
-        draft, source_urls, source_texts, original_request
-    )
-    if not passed or validated_draft.strip() != draft:
-        raise PublicationError(f"verified draft failed current publication gate: {reason}")
+    prices_as_of: str | None = None
+    if mode == COMMERCE_MODE:
+        from agent.quality_first_route import response_diagnostics
+
+        body = draft
+        if body.endswith(PRODUCT_RESEARCH_PUBLICATION_FOOTER):
+            body = body[: -len(PRODUCT_RESEARCH_PUBLICATION_FOOTER)].rstrip()
+        diagnostics = response_diagnostics(body, original_request, source_urls)
+        if not diagnostics.get("passed"):
+            defects = ",".join(str(d) for d in diagnostics.get("defects") or []) or "validation_failed"
+            raise PublicationError(f"verified draft failed current publication gate: {defects}")
+        prices_as_of = _draft_date(draft_row)
+    else:
+        source_texts = _load_source_texts(
+            resolved_home,
+            session_id,
+            turn_user_message_id,
+            int(draft_row["id"]),
+            source_urls,
+        )
+        passed, validated_draft, reason = validate_product_research_text(
+            draft, source_urls, source_texts, original_request
+        )
+        if not passed or validated_draft.strip() != draft:
+            raise PublicationError(f"verified draft failed current publication gate: {reason}")
     title = product_research_title(draft)
+    if title is None and mode == COMMERCE_MODE:
+        title = _request_title(original_request)
     if title is None:
         raise PublicationError("verified draft title is missing")
     slug = _slugify(title)
+    if mode == COMMERCE_MODE and prices_as_of:
+        # Prices date a commerce page; a later re-research gets its own page.
+        slug = f"{slug[:89].rstrip('-')}-{prices_as_of}"
     draft_digest = hashlib.sha256(draft.encode("utf-8")).hexdigest()
-    page_payload = _render_page(title, draft, source_digest, draft_digest)
+    page_payload = _render_page(title, draft, source_digest, draft_digest, prices_as_of=prices_as_of)
     page_digest = _sha256_bytes(page_payload)
 
     products = resolved_vault / "products"
@@ -405,7 +474,7 @@ def publish_product_research(
 
 def main() -> int:
     parser = argparse.ArgumentParser(description=__doc__)
-    parser.add_argument("--mode", choices=[DURABLE_MODE], required=True)
+    parser.add_argument("--mode", choices=[DURABLE_MODE, AUTO_MODE], required=True)
     args = parser.parse_args()
     home_text = os.environ.get("HERMES_HOME", "").strip()
     vault_text = os.environ.get("OBSIDIAN_VAULT_PATH", "").strip()

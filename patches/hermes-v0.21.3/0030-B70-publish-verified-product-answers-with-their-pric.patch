diff --git a/tests/agent/test_product_publisher.py b/tests/agent/test_product_publisher.py
index d8a1a4d..5621eba 100644
--- a/tests/agent/test_product_publisher.py
+++ b/tests/agent/test_product_publisher.py
@@ -312,3 +312,67 @@ def test_durable_publisher_rejects_commerce_claims(tmp_path):
             audit_vault=False,
             mode=DURABLE_MODE,
         )
+
+
+COMMERCE_REQUEST = "What's the best cordless vacuum under $600 for hardwood floors?"
+
+
+def _commerce_draft() -> str:
+    body = (
+        f"**Best pick: Vendor A.** It had strong pickup on hardwood floors in [Review One's test]({REVIEW_ONE}), "
+        f"and [the vendor's product page]({OFFICIAL}) notes that runtime varies by mode and floor type.\n\n"
+        f"- **Vendor A:** strong pickup and a higher price ([Review One]({REVIEW_ONE})).\n"
+        f"- **Vendor B:** lower price with shorter runtime ([Review Two]({REVIEW_TWO})).\n\n"
+        f"Caveat: runtime varies by mode and floor type ([vendor page]({OFFICIAL}))."
+    )
+    return f"{body}\n\n{PRODUCT_RESEARCH_PUBLICATION_FOOTER}"
+
+
+def test_auto_mode_publishes_a_commerce_answer_with_its_price_date(tmp_path):
+    from agent.product_publisher import AUTO_MODE
+
+    home = tmp_path / "home"
+    vault = tmp_path / "vault"
+    vault.mkdir()
+    _setup(home, draft=_commerce_draft(), approval="publish it", request=COMMERCE_REQUEST)
+
+    target, _receipt, _page_digest, _publication_digest = publish_product_research(
+        home=home, vault=vault, session_id=SESSION_ID, audit_vault=False, mode=AUTO_MODE,
+    )
+
+    assert target == vault / "products" / "best-cordless-vacuum-under-600-for-hardwood-floors-1970-01-01.md"
+    page = target.read_text(encoding="utf-8")
+    assert 'title: "Best cordless vacuum under $600 for hardwood floors"' in page
+    assert "prices_as_of: 1970-01-01" in page
+    assert "> Prices and availability as of 1970-01-01." in page
+    assert PRODUCT_RESEARCH_PUBLICATION_FOOTER not in page
+
+
+def test_auto_mode_rejects_a_commerce_draft_that_fails_the_quality_first_gate(tmp_path):
+    from agent.product_publisher import AUTO_MODE
+
+    home = tmp_path / "home"
+    vault = tmp_path / "vault"
+    vault.mkdir()
+    uncited = f"Best pick: Vendor A. It is great.\n\n{PRODUCT_RESEARCH_PUBLICATION_FOOTER}"
+    _setup(home, draft=uncited, approval="publish it", request=COMMERCE_REQUEST)
+
+    with pytest.raises(PublicationError, match="current publication gate"):
+        publish_product_research(
+            home=home, vault=vault, session_id=SESSION_ID, audit_vault=False, mode=AUTO_MODE,
+        )
+    assert not (vault / "products").exists()
+
+
+def test_auto_mode_keeps_durable_rules_for_durable_requests(tmp_path):
+    from agent.product_publisher import AUTO_MODE
+
+    home = tmp_path / "home"
+    vault = tmp_path / "vault"
+    vault.mkdir()
+    _setup(home, draft=_commerce_draft(), approval="publish it", request=DURABLE_REQUEST)
+
+    with pytest.raises(PublicationError):
+        publish_product_research(
+            home=home, vault=vault, session_id=SESSION_ID, audit_vault=False, mode=AUTO_MODE,
+        )

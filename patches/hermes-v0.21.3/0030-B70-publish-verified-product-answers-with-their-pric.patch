+                args["command"] = bound_product_publish_command(str(getattr(agent, "session_id", "") or ""))
+                args["workdir"] = str(DEPLOYED_HERMES_ROOT)
     if generic_research_route_active(agent):
         source_budget_rejection = generic_research_source_budget_rejection(
             agent, tool_name, args
diff --git a/agent/verified_tool_delivery.py b/agent/verified_tool_delivery.py
index 1380e16..1a1997d 100644
--- a/agent/verified_tool_delivery.py
+++ b/agent/verified_tool_delivery.py
@@ -43,6 +43,15 @@ def bound_generic_research_receipt_command(session_id: str) -> str:
     )
 
 
+def bound_product_publish_command(session_id: str) -> str:
+    """The product publisher command bound to one safe session (the terminal tool
+    does not export HERMES_SESSION_ID, so the unbound command always failed)."""
+
+    if not isinstance(session_id, str) or not _RECEIPT_SESSION_ID_RE.fullmatch(session_id):
+        raise ValueError("invalid Hermes session id for publisher binding")
+    return f"HERMES_SESSION_ID={session_id} {PRODUCT_RESEARCH_PUBLISH_COMMAND}"
+
+
 def bound_product_research_receipt_command(session_id: str) -> str:
     """Return the product-controller receipt command bound to one safe session."""
 
@@ -111,7 +120,7 @@ def is_generic_research_receipt_command(command: Any) -> bool:
 
     return generic_research_receipt_command_allowed(command)
 PRODUCT_RESEARCH_PUBLISH_COMMAND = (
-    "python3 -m agent.product_publisher --mode durable_comparison"
+    "python3 -m agent.product_publisher --mode auto"
 )
 TRAVEL_RESEARCH_CONTROLLER_SCRIPTS = frozenset(
     {
@@ -598,6 +607,7 @@ __all__ = [
     "GENERIC_RESEARCH_RECEIPT_COMMANDS",
     "GENERIC_RESEARCH_RECEIPT_ABSOLUTE_COMMAND",
     "PRODUCT_RESEARCH_PUBLISH_COMMAND",
+    "bound_product_publish_command",
     "RELIABLE_RESEARCH_COMMAND",
     "TRAVEL_RESEARCH_CONTROLLER_SCRIPTS",
     "TRAVEL_RESEARCH_RUNNER_MODULE",

 3 files changed, 67 insertions(+), 6 deletions(-)

diff --git a/agent/generic_research_publisher.py b/agent/generic_research_publisher.py
index 42b112ac0..819e602ca 100644
--- a/agent/generic_research_publisher.py
+++ b/agent/generic_research_publisher.py
@@ -21,8 +21,27 @@ from typing import Any, Sequence
 
 RESEARCH_DIRECTORY = "research"
 MAX_SAME_DAY_NOTES = 20
-_LEADING_VERB_RE = re.compile(r"^\s*(?:please\s+)?(?:research|investigate|look\s+up)\s+(?:the\s+|a\s+|an\s+)?", re.IGNORECASE)
+MAX_TITLE_WORDS = 10
+# Conversational lead-ins ("I'd like to", "Can you", "please") before the research verb (2026-09-27).
+_LEAD_IN_RE = re.compile(
+    r"^\s*(?:(?:hi|hey|hello)\b[,!.]?\s*)?(?:please\s+)?"
+    r"(?:(?:i['’]?d|i\s+would)\s+like\s+(?:you\s+)?to|i\s+(?:want|need)\s+(?:you\s+)?to|"
+    r"(?:can|could|would|will)\s+you(?:\s+please)?|help\s+me)\s+",
+    re.IGNORECASE,
+)
+_LEADING_VERB_RE = re.compile(
+    r"^\s*(?:please\s+)?(?:research|investigate|look\s+(?:up|into)|find\s+out\s+about)\s+(?:the\s+|a\s+|an\s+)?",
+    re.IGNORECASE,
+)
+_PURCHASE_RE = re.compile(r"^(?:the\s+)?(?:purchase|buying|choice)\s+of\s+(?:the\s+|a\s+|an\s+)?", re.IGNORECASE)
 _SAVE_CLAUSE_RE = re.compile(r"[.;,]?\s*(?:and\s+)?(?:then\s+)?(?:save|add|write|publish|store|put)\b.*$", re.IGNORECASE | re.DOTALL)
+_FIRST_SENTENCE_RE = re.compile(r"(?<=[.?!])\s+")
+# A short model preamble before the article body ("Receipt bound - 2 sources admitted. Here's the brief:").
+_CHATTER_RE = re.compile(
+    r"^\s*(?:receipt[\s-]*(?:bound|sealed|captured|ready)\b|here['’]?s\b|here\s+is\b|below\s+is\b|"
+    r"(?:ok(?:ay)?|sure|alright|great|done)\b[,!.:]|sources?\s+(?:admitted|bound)\b)",
+    re.IGNORECASE,
+)
 
 
 class GenericResearchPublicationError(RuntimeError):
@@ -36,9 +55,15 @@ def _slugify(value: str) -> str:
 
 
 def research_note_title(operator_prompt: str, response: str) -> str:
-    """The research subject from the request (before any colon or save clause); else the answer's first heading."""
+    """The research subject from the request's first sentence (lead-ins, research verb, colon detail and save clause
+    removed; at most MAX_TITLE_WORDS words); else the answer's first heading."""
     text = " ".join(str(operator_prompt or "").split())
-    subject = _SAVE_CLAUSE_RE.sub("", _LEADING_VERB_RE.sub("", text, count=1)).split(":", 1)[0].strip(" .")
+    text = _LEADING_VERB_RE.sub("", _LEAD_IN_RE.sub("", text, count=1), count=1)
+    text = _FIRST_SENTENCE_RE.split(text, maxsplit=1)[0]
+    subject = _PURCHASE_RE.sub("", _SAVE_CLAUSE_RE.sub("", text).split(":", 1)[0]).strip(" .?!,")
+    words = subject.split()
+    if len(words) > MAX_TITLE_WORDS:
+        subject = " ".join(words[:MAX_TITLE_WORDS]).rstrip(",;:")
     if len(_slugify(subject)) >= 4:
         return subject[:120].strip()
     for line in str(response or "").splitlines():
@@ -48,6 +73,16 @@ def research_note_title(operator_prompt: str, response: str) -> str:
     return "Research note"
 
 
+def strip_leading_chatter(response: str) -> str:
+    """Drop short model-preamble lines before the article body (saved note only; the chat reply keeps them)."""
+    lines = str(response or "").strip().splitlines()
+    while lines and len(lines[0]) <= 200 and _CHATTER_RE.search(lines[0]) and not lines[0].lstrip().startswith(("#", "-", "*", "|")):
+        lines.pop(0)
+        while lines and not lines[0].strip():
+            lines.pop(0)
+    return "\n".join(lines) if lines else str(response or "").strip()
+
+
 def render_research_note(*, title: str, operator_prompt: str, response: str, sources: Sequence[str], session_id: str,
                          today: dt.date) -> bytes:
     source_list = [str(url) for url in sources]
@@ -56,7 +91,7 @@ def render_research_note(*, title: str, operator_prompt: str, response: str, sou
              f"request: {json.dumps(' '.join(str(operator_prompt).split()), ensure_ascii=False)}", "sources:"]
     lines += [f"  - {json.dumps(url, ensure_ascii=False)}" for url in source_list]
     lines += [f"receipt_sources_sha256: {hashlib.sha256(json.dumps(source_list).encode()).hexdigest()}", "---", "",
-              f"# {title}", "", str(response).strip(), "",
+              f"# {title}", "", strip_leading_chatter(response), "",
               f"*Saved by Hermes research on {today.isoformat()} from receipt-verified sources; unreviewed.*", ""]
     return "\n".join(lines).encode("utf-8")
 
